load("@komira//tools/build/mojo:archive.bzl", "archive_files")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/native:defs.bzl", "checked_cxx_library", "prefix_header", "prefixed_archive_check")

# google/brotli 1.1.0, MIT (LICENSE in the archive). Nothing of it is
# committed here: the archive is fetched at build time, checked against its
# sha256, and the files below extracted from it.
pinned_file(
    name = "brotli-1.1.0.tar.gz",
    url = "https://github.com/google/brotli/archive/refs/tags/v1.1.0.tar.gz",
    sha256 = "e720a6ca29428b803f4ad165371771f5398faba397edf6778837a18599ea13ff",
    size_bytes = 511969,
)

_COMMON = [
    "constants",
    "context",
    "dictionary",
    "platform",
    "shared_dictionary",
    "transform",
]

_DEC = [
    "bit_reader",
    "decode",
    "huffman",
    "state",
]

_PRIVATE_HEADERS = [
    "c/common/constants.h",
    "c/common/context.h",
    "c/common/dictionary.h",
    "c/common/platform.h",
    "c/common/shared_dictionary_internal.h",
    "c/common/transform.h",
    "c/common/version.h",
    "c/dec/bit_reader.h",
    "c/dec/huffman.h",
    "c/dec/prefix.h",
    "c/dec/state.h",
]

_PUBLIC_HEADERS = [
    "decode.h",
    "port.h",
    "shared_dictionary.h",
    "types.h",
]

_SRCS = ["c/common/{}.c".format(s) for s in _COMMON] + ["c/dec/{}.c".format(s) for s in _DEC]

archive_files(
    name = "src",
    exec_compatible_with = LINUX_X86_64,
    archive = ":brotli-1.1.0.tar.gz",
    one_tree = True,
    files = ["LICENSE"] + _SRCS + _PRIVATE_HEADERS +
            ["c/include/brotli/{}".format(h) for h in _PUBLIC_HEADERS],
    strip_prefix = "brotli-1.1.0",
)

# Every argument of the Brotli decoder's compile but the prefix (below): the
# decoder (libbrotlidec and the libbrotlicommon it needs), static, with its C
# API <brotli/decode.h>. The sources include each other by their path from
# the including source ("../common/constants.h"), found at their real paths
# in :src (one_tree, raw_headers).
_BROTLIDEC = dict(
    srcs = [":src[{}]".format(s) for s in _SRCS],
    raw_headers = [":src[{}]".format(h) for h in _PRIVATE_HEADERS],
    compiler_flags = [
        "-O2",
        "-DNDEBUG",
    ],
    exported_headers = {
        "brotli/" + h: ":src[c/include/brotli/{}]".format(h)
        for h in _PUBLIC_HEADERS
    },
    header_namespace = "",
)

# The decoder with upstream's names. Nothing links it: its archive's symbol
# table is the list of names :prefix_symbols renames.
cxx_library(
    name = "brotlidec_unprefixed",
    **_BROTLIDEC
)

# Every global symbol renamed komira_brotli_*: BrotliX becomes
# komira_brotli_X (BrotliDecoderDecompress is komira_brotli_DecoderDecompress),
# any other global X komira_brotli__X (the decoder's tables, such as
# _kBrotliPrefixCodeRanges). An unprefixed exported BrotliDecoder* would
# interpose on a system libbrotlidec in the same process.
prefix_header(
    name = "prefix_symbols",
    archive = ":brotlidec_unprefixed[static-pic]",
    exec_compatible_with = LINUX_X86_64,
    header = "brotli_prefix_symbols.h",
    min_symbols = 20,
    prefix = "komira_brotli_",
    strip = "Brotli",
    style = "strip",
)

cxx_library(
    name = "brotlidec_prefixed",
    exported_preprocessor_flags = ["-include", "$(location :prefix_symbols)"],
    **_BROTLIDEC
)

# Every symbol :brotlidec_prefixed defines is komira_brotli_*, and it
# references none of the decoder's unprefixed names.
prefixed_archive_check(
    name = "brotlidec_symbols",
    archive = ":brotlidec_prefixed[static-pic]",
    exec_compatible_with = LINUX_X86_64,
    min_defined = 20,
    original_names = [":prefix_symbols[symbols]"],
    prefix = "komira_brotli_",
)

# The decoder as its users take it: its C API is
# komira_brotli_DecoderDecompress, ... (C callers that include
# <brotli/decode.h> get the renamed names), and :brotlidec_symbols gates
# every build holding it.
checked_cxx_library(
    name = "brotlidec",
    checks = [":brotlidec_symbols"],
    lib = ":brotlidec_prefixed",
    visibility = ["PUBLIC"],
)

# Test data of //src/komira_parquet_codec (tests/test_compression_brotli.mojo):
# the release's decoder test vectors, each a Brotli stream next to the text
# it decodes to.
archive_files(
    name = "testdata",
    exec_compatible_with = LINUX_X86_64,
    archive = ":brotli-1.1.0.tar.gz",
    one_tree = True,
    files = [
        "LICENSE",
        "tests/testdata/empty",
        "tests/testdata/empty.compressed",
        "tests/testdata/ukkonooa",
        "tests/testdata/ukkonooa.compressed",
    ],
    strip_prefix = "brotli-1.1.0",
    visibility = ["PUBLIC"],
)
