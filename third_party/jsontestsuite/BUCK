load("@komira//tools/build/mojo:archive.bzl", "archive_files")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":test_parsing.bzl", "TEST_PARSING")

# JSONTestSuite (github.com/nst/JSONTestSuite), MIT licensed (LICENSE in the
# archive, extracted below), at one pinned commit of its default branch: the
# test_parsing/ corpus of RFC 8259 parsing cases, each one JSON text in a file
# whose name says what a parser must do with it (y_ accept, n_ reject, i_
# either). Nothing of it is committed here: the archive is fetched at build
# time, checked against its sha256, and the files below extracted from it.
#
# Test data of //src/tests/conformance/komira_json_conformance only, which feeds every file to
# every JSON parser komira ships. No library or binary depends on it.
#
# The archive is 60 MB (most of it is the upstream repository's own copies of
# other parsers, which nothing here reads); pinning the 318 files one by one,
# as third_party/pierrec-lz4 pins its three, would be 318 pins. The download
# is a pinned input like any other: fetched once, then a cache hit.
#
# A newer pin is `_COMMIT`, `_SHA256` and `_SIZE` here, the list in
# test_parsing.bzl (its names and counts), the counts in
# src/tests/conformance/komira_json_conformance/suite.mojo, and a re-read of that package's
# allowlists against the new files.
_COMMIT = "1ef36fa01286573e846ac449e8683f8833c5b26a"
_SHA256 = "32ab2fb37cc26679dbd9164dbb7053bcef10134643d53cb0cef45de7680dcdcc"
_SIZE = 63179698

pinned_file(
    name = "JSONTestSuite.tar.gz",
    url = "https://github.com/nst/JSONTestSuite/archive/{}.tar.gz".format(_COMMIT),
    sha256 = _SHA256,
    size_bytes = _SIZE,
)

# One directory: LICENSE and test_parsing/<name> for every name in
# test_parsing.bzl. A listed file missing from the archive fails the
# extraction.
archive_files(
    name = "files",
    exec_compatible_with = LINUX_X86_64,
    archive = ":JSONTestSuite.tar.gz",
    one_tree = True,
    files = ["LICENSE"] + ["test_parsing/" + f for f in TEST_PARSING],
    tree_dirs = ["test_parsing"],
    strip_prefix = "JSONTestSuite-" + _COMMIT,
    visibility = ["//src/tests/conformance/komira_json_conformance/..."],
)
