load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/mojo:archive.bzl", "archive_files")
load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/native:defs.bzl", "checked_cxx_library", "prefix_header", "prefixed_archive_check")
load("@komira//tools/build/third_party_srcs:defs.bzl", "third_party_srcs")
load(
    ":srcs.bzl",
    "BCM_ASM_X86_64",
    "BCM_SRCS",
    "CRYPTO_ASM_X86_64",
    "CRYPTO_SRCS",
    "PRIVATE_HEADERS",
    "PUBLIC_HEADERS",
    "S2N_BIGNUM_ASM_X86_64",
)

# aws/aws-lc 1.39.0, Apache-2.0 OR ISC (LICENSE in the archive).
#
# libcrypto, built the way aws-lc's CMake build builds it with
#   BUILD_LIBSSL=OFF BUILD_TOOL=OFF DISABLE_PERL=ON DISABLE_GO=ON
#   CMAKE_BUILD_TYPE=Release BUILD_SHARED_LIBS=OFF (and FIPS off)
# for linux x86_64, without CMake: the source lists are srcs.bzl, generated
# from the archive's CMakeLists.txt by :srcs_gen (and held to it by the test
# :srcs_drift, below). Without Perl and Go the build uses the assembly and
# err_data.c the archive ships under generated-src/, so nothing is generated
# here. Every global symbol is renamed komira_awslc_X (:crypto, below), so
# this copy of aws-lc can share a process with any other libcrypto.
pinned_file(
    name = "aws-lc-1.39.0.tar.gz",
    url = "https://github.com/aws/aws-lc/archive/refs/tags/v1.39.0.tar.gz",
    sha256 = "37f5a379081b97adba3e1316017e09484d6c4ed6dc336d57fae6f0b7b27472fc",
    size_bytes = 114622205,
)

# srcs.bzl against the archive: :srcs_gen writes it, :srcs_drift (a test)
# fails when the committed file differs.
third_party_srcs(
    name = "srcs",
    library = "aws-lc",
    archive = ":aws-lc-1.39.0.tar.gz",
    committed = "srcs.bzl",
)

_SRCS = CRYPTO_SRCS + CRYPTO_ASM_X86_64 + BCM_SRCS + BCM_ASM_X86_64 + S2N_BIGNUM_ASM_X86_64

# Every source and header, in one directory tree: aws-lc includes its own
# headers (and bcm.c its module's .c files) by relative path, so they keep
# their places in the archive.
archive_files(
    name = "src",
    exec_compatible_with = LINUX_X86_64,
    archive = ":aws-lc-1.39.0.tar.gz",
    files = ["LICENSE"] + _SRCS + PUBLIC_HEADERS + sorted(PRIVATE_HEADERS.values()),
    strip_prefix = "aws-lc-1.39.0",
    one_tree = True,
    tree_dirs = ["include"],
)

# What the CMake build adds to every compile of these sources: its Release
# flags, C11, hidden visibility (nothing is exported from a binary linking
# this), the positive results of its two compiler probes on clang
# (stdalign_check.c, builtin_swap_check.c), _XOPEN_SOURCE on Linux, and
# BORINGSSL_IMPLEMENTATION on the library's own objects.
_C_FLAGS = [
    "-std=c11",
    "-O3",
    "-fvisibility=hidden",
    "-fno-common",
]

_DEFINES = [
    # CMake's -I include, which three sources need: they include
    # "../crypto/<dir>/internal.h" from the include directory.
    "-I$(location :src[include])",
    "-DNDEBUG",
    "-DBORINGSSL_IMPLEMENTATION",
    "-DBORINGSSL_RELEASE_BUILD",
    "-DAWS_LC_STDALIGN_AVAILABLE",
    "-DAWS_LC_BUILTIN_SWAP_SUPPORTED",
    "-D_XOPEN_SOURCE=700",
]

# s2n-bignum's assembly, as CMake's s2n_asm_cpreprocess passes it.
_S2N_BIGNUM_FLAGS = ["-DS2N_BN_HIDE_SYMBOLS"]

# Not part of aws-lc: the one compiler builtin libcrypto needs, so that
# zig's compiler_rt stays out of the link (see the file).
staged_files(
    name = "builtins",
    srcs = ["umodti3.c"],
)

# Every argument of the libcrypto compile but the prefix (below).
_CRYPTO = dict(
    srcs = [":src[{}]".format(f) for f in CRYPTO_SRCS + CRYPTO_ASM_X86_64 + BCM_SRCS + BCM_ASM_X86_64] +
           [(":src[{}]".format(f), _S2N_BIGNUM_FLAGS) for f in S2N_BIGNUM_ASM_X86_64] +
           [":builtins[umodti3.c]"],
    # The sources include their own headers by relative path, which the
    # compiler resolves from the source's own directory: every header is an
    # input at its path in :src (raw_headers, and one_tree above); the few
    # included through an -I directory are also in a header tree.
    raw_headers = [":src[{}]".format(v) for v in sorted(PRIVATE_HEADERS.values())],
    headers = {k: ":src[{}]".format(v) for k, v in PRIVATE_HEADERS.items() if k != v},
    # Warnings off: this is upstream code, built as upstream builds it.
    compiler_flags = ["-w"],
    lang_compiler_flags = {"c_cpp_output": _C_FLAGS},
    preprocessor_flags = _DEFINES,
    exported_headers = {h[len("include/"):]: ":src[{}]".format(h) for h in PUBLIC_HEADERS},
    header_namespace = "",
    # The assembly above is x86_64 ELF; see srcs.bzl for the aarch64 lists.
    target_compatible_with = ["prelude//cpu/constraints:x86_64", "prelude//os/constraints:linux"],  # komira-limit:aws-lc-x86-64-linux
)

# libcrypto with aws-lc's own symbol names. Nothing links it: its archive's
# symbol table is the list of names :prefix_symbols renames.
cxx_library(
    name = "crypto_unprefixed",
    **_CRYPTO
)

# aws-lc's symbol prefix, komira_awslc_, as its own prefix build applies it
# without Go or CMake. aws-lc ships empty
# include/openssl/boringssl_prefix_symbols{,_asm}.h, which base.h and
# asm_base.h include; a prefix build fills them with `#define X
# komira_awslc_X` for every global symbol of the library. This header is that
# fill, made from :crypto_unprefixed's symbol table (as aws-lc's
# util/read_symbols.go makes it), and :crypto_prefixed force-includes it into
# every C and assembly compile, its own and its users'. The four
# OPENSSL_memory_* hooks are weak references aws-lc makes but never defines
# (a program may define them to take over aws-lc's allocator), so the symbol
# table does not name them: they are renamed too, so that no other object of
# a process can take over this copy's allocator by defining them.
prefix_header(
    name = "prefix_symbols",
    archive = ":crypto_unprefixed[static-pic]",
    exec_compatible_with = LINUX_X86_64,
    extra_symbols = [
        "OPENSSL_memory_alloc",
        "OPENSSL_memory_free",
        "OPENSSL_memory_get_size",
        "OPENSSL_memory_realloc",
    ],
    header = "boringssl_prefix_symbols.h",
    min_symbols = 1000,
    prefix = "komira_awslc",
    style = "boringssl",
    visibility = ["//third_party/s2n-tls:"],
)

cxx_library(
    name = "crypto_prefixed",
    exported_preprocessor_flags = ["-include", "$(location :prefix_symbols)"],
    **_CRYPTO
)

# Every symbol :crypto_prefixed defines, and every weak hook it references,
# is komira_awslc_*, and it references none of aws-lc's unprefixed names.
# Two names stay, as aws-lc's own prefix build leaves them (read_symbols.go):
# __umodti3, the compiler builtin :builtins adds, which the compiler calls by
# that name; and sdallocx, jemalloc's sized free, a weak reference aws-lc
# calls only on memory it got from malloc. jemalloc defines it only when it
# is the process's malloc, so it pairs with the unprefixed malloc and free.
prefixed_archive_check(
    name = "crypto_symbols",
    allow = [
        "__umodti3",
        "sdallocx",
    ],
    archive = ":crypto_prefixed[static-pic]",
    exec_compatible_with = LINUX_X86_64,
    min_defined = 1000,
    original_names = [":prefix_symbols[symbols]"],
    prefix = "komira_awslc_",
)

# libcrypto as its users take it: every global symbol is komira_awslc_X
# (C callers that include its headers get the renamed names), and
# :crypto_symbols gates every build holding it.
checked_cxx_library(
    name = "crypto",
    checks = [":crypto_symbols"],
    lib = ":crypto_prefixed",
    visibility = ["PUBLIC"],
)
