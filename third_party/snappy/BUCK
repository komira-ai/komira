load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/mojo:archive.bzl", "archive_files")
load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")

# google/snappy 1.2.2, BSD-3-Clause (COPYING in the archive).
pinned_file(
    name = "snappy-1.2.2.tar.gz",
    url = "https://github.com/google/snappy/archive/refs/tags/1.2.2.tar.gz",
    sha256 = "90f74bc1fbf78a6c56b3c4a082a05103b3a56bb17bca1a27e052ea11723292dc",
    size_bytes = 1108618,
)

archive_files(
    name = "src",
    exec_compatible_with = LINUX_X86_64,
    archive = ":snappy-1.2.2.tar.gz",
    files = [
        "COPYING",
        "snappy-c.cc",
        "snappy-c.h",
        "snappy-internal.h",
        "snappy-sinksource.cc",
        "snappy-sinksource.h",
        "snappy-stubs-internal.cc",
        "snappy-stubs-internal.h",
        "snappy.cc",
        "snappy.h",
    ],
    strip_prefix = "snappy-1.2.2",
    # What CMake's configure_file writes for this platform.
    substitutions = {
        "${HAVE_SYS_UIO_H_01}": "1",
        "${PROJECT_VERSION_MAJOR}": "1",
        "${PROJECT_VERSION_MINOR}": "2",
        "${PROJECT_VERSION_PATCH}": "2",
    },
    templates = {"snappy-stubs-public.h": "snappy-stubs-public.h.in"},
)

# Test data of //src/komira_parquet_codec (tests/test_snappy_corpus.mojo): the
# snappy correctness corpus (the files snappy_unittest compresses and
# decompresses) and the three corrupt blobs a decoder must refuse, out of the
# same pinned archive, as one tree.
archive_files(
    name = "testdata",
    exec_compatible_with = LINUX_X86_64,
    archive = ":snappy-1.2.2.tar.gz",
    one_tree = True,
    files = [
        "COPYING",
        "testdata/alice29.txt",
        "testdata/asyoulik.txt",
        "testdata/baddata1.snappy",
        "testdata/baddata2.snappy",
        "testdata/baddata3.snappy",
        "testdata/fireworks.jpeg",
        "testdata/geo.protodata",
        "testdata/html",
        "testdata/html_x_4",
        "testdata/kppkn.gtb",
        "testdata/lcet10.txt",
        "testdata/paper-100k.pdf",
        "testdata/plrabn12.txt",
        "testdata/urls.10K",
    ],
    strip_prefix = "snappy-1.2.2",
    visibility = ["PUBLIC"],
)

# The library and its C API (snappy-c.h). C++, so it carries zig's libc++
# (komira//tools/build/toolchains:libcxx) into every link that includes it.
# config.h, copied into buck-out so that the compiles including it have one
# digest wherever komira is mounted (see staged_files). config.h hardcodes the one
# target it compiles for, x86_64 Linux at x86-64-v3. komira-limit:snappy-x86-64-v3
staged_files(
    name = "config",
    srcs = ["config.h"],
)

cxx_library(
    name = "snappy",
    srcs = [
        ":src[snappy-c.cc]",
        ":src[snappy-sinksource.cc]",
        ":src[snappy-stubs-internal.cc]",
        ":src[snappy.cc]",
    ],
    headers = {
        "config.h": ":config[config.h]",
        "snappy-internal.h": ":src[snappy-internal.h]",
        "snappy-stubs-internal.h": ":src[snappy-stubs-internal.h]",
    },
    compiler_flags = [
        "-O2",
        "-DNDEBUG",
        "-fno-exceptions",
        "-fno-rtti",
        "-Wno-sign-compare",
    ],
    exported_deps = ["komira//tools/build/toolchains:libcxx"],
    exported_headers = {
        "snappy-c.h": ":src[snappy-c.h]",
        "snappy-sinksource.h": ":src[snappy-sinksource.h]",
        "snappy-stubs-public.h": ":src[snappy-stubs-public.h]",
        "snappy.h": ":src[snappy.h]",
    },
    header_namespace = "",
    preprocessor_flags = ["-DHAVE_CONFIG_H"],
    visibility = ["PUBLIC"],
)
