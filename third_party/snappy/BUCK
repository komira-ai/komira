    visibility = ["PUBLIC"],
)

# The library and its C API (snappy-c.h). C++, so it carries zig's libc++
# (komira//tools/build/toolchains:libcxx) into every link that includes it.
# config.h, copied into buck-out so that the compiles including it have one
# digest wherever komira is mounted (see staged_files). There is one config.h
# per cpu, each staged by a target of its own so that a platform's graph holds
# only the one it compiles with. Each is what CMake writes for the CPU the
# platform compiles for, and each assumes that CPU:
#   config_x86_64.h  x86-64-v3 (SSSE3, SSE4.2 CRC32, BMI2; no NEON): the
#                    target_cpu of the linux-x86_64 row of the platform table;
#   config_arm64.h   zig's generic arm64 CPU (NEON; no CRC32 extension; no x86
#                    intrinsic header): the linux-arm64 row (target_cpu
#                    generic) and macOS arm64. The darwin-arm64 row names
#                    target_cpu apple-m1; it compiles generic only because
#                    tools/build/mojo/cxx.bzl passes -mcpu=generic for macOS.
# Compressed bytes differ between x86_64 (CRC32C hash) and arm64
# (multiplicative hash): both are valid snappy streams that decode
# identically, so no golden of compressed bytes may be shared across cpus.
# Linux and macOS write the same macros for one cpu (the sys/ header checks
# and the compiler builtins answer alike), so the select is by cpu alone. A
# platform of another cpu fails to configure: none gets x86 intrinsics by
# default.
staged_files(
    name = "config_x86_64",
    srcs = ["config_x86_64.h"],
)

staged_files(
    name = "config_arm64",
    srcs = ["config_arm64.h"],
)

# The list of macros CMake writes for snappy, out of the pinned archive: what
# :config_cases holds both headers to.
archive_files(
    name = "config_template",
    exec_compatible_with = LINUX_X86_64,
    archive = ":snappy-1.2.2.tar.gz",
    files = ["cmake/config.h.in"],
    strip_prefix = "snappy-1.2.2",
)

# The two headers read as text (config_test.zig says what it catches). The
# macOS arm64 build is not in the pull request check, so this is the check
# that an arm64 config switches no x86 intrinsic on.
zig_test(
    name = "config_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "config_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    data = {
        "BUCK": "BUCK",
        "config.h.in": ":config_template[cmake/config.h.in]",
        "config_arm64.h": "config_arm64.h",
        "config_x86_64.h": "config_x86_64.h",
    },
    zig = "komira//tools/build/toolchains:zig_next",
)

_COMMON_HEADERS = {
    "snappy-internal.h": ":src[snappy-internal.h]",
    "snappy-stubs-internal.h": ":src[snappy-stubs-internal.h]",
}

# Every argument of the snappy compile but the prefix (below).
_SNAPPY = dict(
    srcs = [
        ":src[snappy-c.cc]",
        ":src[snappy-sinksource.cc]",
        ":src[snappy-stubs-internal.cc]",
        ":src[snappy.cc]",
    ],
    headers = select({
        "prelude//cpu/constraints:arm64": dict(_COMMON_HEADERS, **{"config.h": ":config_arm64[config_arm64.h]"}),
        "prelude//cpu/constraints:x86_64": dict(_COMMON_HEADERS, **{"config.h": ":config_x86_64[config_x86_64.h]"}),
    }),
    compiler_flags = [
        "-O2",
        "-DNDEBUG",
        "-fno-exceptions",
        "-fno-rtti",
        "-Wno-sign-compare",
    ],
    exported_deps = ["komira//tools/build/toolchains:libcxx"],
    exported_headers = {
        "snappy-c.h": ":src[snappy-c.h]",
        "snappy-sinksource.h": ":src[snappy-sinksource.h]",
        "snappy-stubs-public.h": ":src[snappy-stubs-public.h]",
        "snappy.h": ":src[snappy.h]",
    },
    header_namespace = "",
    preprocessor_flags = ["-DHAVE_CONFIG_H"],
)

# snappy with its own C API names. Nothing links it: its archive's symbol
# table is the list of names :prefix_symbols renames.
cxx_library(
    name = "snappy_unprefixed",
    **_SNAPPY
)

# The C API (snappy-c.h) renamed komira_snappy_*: snappy_X becomes
# komira_snappy_X. The C++ names (_Z...) are left alone: they are in
# namespace snappy, and no Mojo code calls them.
prefix_header(
    name = "prefix_symbols",
    archive = ":snappy_unprefixed[static-pic]",
    exec_compatible_with = LINUX_X86_64,
    header = "snappy_prefix_symbols.h",
    min_symbols = 5,
    prefix = "komira_snappy_",
    strip = "snappy_",
    style = "strip",
)

cxx_library(
    name = "snappy_prefixed",
    exported_preprocessor_flags = ["-include", "$(location :prefix_symbols)"],
    **_SNAPPY
)

# Every symbol :snappy_prefixed defines outside C++ (_Z...) is
# komira_snappy_*, and it references none of the C API's unprefixed names.
prefixed_archive_check(
    name = "snappy_symbols",
    allow = ["_Z*"],
    archive = ":snappy_prefixed[static-pic]",
    exec_compatible_with = LINUX_X86_64,
    min_defined = 5,
    original_names = [":prefix_symbols[symbols]"],
    prefix = THIRD_PARTY_OWNERS["third_party/snappy"].prefix,
)

# snappy as its users take it: the C API is komira_snappy_compress,
# komira_snappy_uncompress, ... (C callers that include snappy-c.h get the
# renamed names), and :snappy_symbols gates every build holding it.
checked_cxx_library(
    name = "snappy",
    checks = [":snappy_symbols"],
    lib = ":snappy_prefixed",
    visibility = ["PUBLIC"],
)

# The template of snappy-stubs-public.h, out of the pinned archive: what :stubs_cases holds the committed
# header to.
archive_files(
    name = "stubs_template",
    exec_compatible_with = LINUX_X86_64,
    archive = ":snappy-1.2.2.tar.gz",
    files = ["snappy-stubs-public.h.in"],
    strip_prefix = "snappy-1.2.2",
)

# snappy-stubs-public.h is committed (what CMake writes from the template, the substitutions of :src), because
# native_library takes the headers of the package as files of the package. This holds it to the template.
zig_test(
    name = "stubs_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "stubs_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    data = {
        "BUCK": "BUCK",
        "snappy-stubs-public.h": "snappy-stubs-public.h",
        "snappy-stubs-public.h.in": ":stubs_template[snappy-stubs-public.h.in]",
    },
    zig = "komira//tools/build/toolchains:zig_next",
)

# The files of the pinned archive the library below stages; nothing else of the archive is an input.
_NATIVE_FILES = [
    "COPYING",
    "snappy-c.cc",
    "snappy-c.h",
    "snappy-internal.h",
    "snappy-sinksource.cc",
    "snappy-sinksource.h",
    "snappy-stubs-internal.cc",
    "snappy-stubs-internal.h",
    "snappy.cc",
    "snappy.h",
]

# snappy as buildrules' native_library builds it, for the mopm package komira_compression
# (`natives = {"libsnappy.a": ...}`): `libsnappy.a`, C++17, the flags of the compile above, the same two config.h
# (by cpu, and macOS and Linux write the same macros for one cpu) and the same renaming: the C API (snappy-c.h)
# is komira_snappy_*, and the C++ names of namespace snappy (_ZN6snappy...) stay, which the prefix's `cxx_namespaces` allows. It carries zig's libc++
# into the link of a program that includes it (`cxx_runtime`, derived from the .cc files). :snappy above is unchanged: it is what
# the packages still on the older rules link.
native_library(
    name = "snappy_native",
    upstream = {
        "url": "https://github.com/google/snappy/archive/refs/tags/1.2.2.tar.gz",
        "sha256": "90f74bc1fbf78a6c56b3c4a082a05103b3a56bb17bca1a27e052ea11723292dc",
        "size": 1108618,
        "strip": "snappy-1.2.2",
        "files": _NATIVE_FILES,
    },
    srcs = [
        "snappy-c.cc",
        "snappy-sinksource.cc",
        "snappy-stubs-internal.cc",
        "snappy.cc",
    ],
    hdrs = by_os_cpu({
        "linux_aarch64": {"config.h": "config_arm64.h"},
        "linux_x86_64": {"config.h": "config_x86_64.h"},
        "macos_aarch64": {"config.h": "config_arm64.h"},
    }),
    exported_headers = {"snappy-stubs-public.h": "snappy-stubs-public.h"},
    includes = ["."],
    exported_includes = ["."],
    cxxflags = [
        "-DHAVE_CONFIG_H",
        "-DNDEBUG",
        "-fno-exceptions",
        "-fno-rtti",
        "-Wno-sign-compare",
        # With -fno-exceptions libc++'s length and allocation errors (std::vector, std::allocator) call its verbose abort
        # through out-of-line weak functions, and those are `std` names this archive would define: the renaming check
        # holds a library to defining only its own names and a `cxx_namespaces` entry may not be `std`. A trap in their
        # place leaves them inlined, so the archive defines none (the same fatal stop for the same impossible case).
        "-D_LIBCPP_VERBOSE_ABORT(...)=__builtin_trap()",
    ] + by_os_cpu({
        "linux_aarch64": [],
        # config_x86_64.h is what CMake writes at x86-64-v3, the target_cpu of the linux-x86_64 row of the
        # platform table (the zig spelling of ISA_LEVELS["x86-64-v3"]).
        "linux_x86_64": ["-mcpu=x86_64_v3"],
        "macos_aarch64": [],
    }),
    cxx_runtime = True,
    prefix = {"name": "komira_snappy_", "strip": "snappy_", "min": 5, "cxx_namespaces": ["snappy"]},
    soname = "libsnappy.a",
)
