load("@komira//tools/build/mojo:archive.bzl", "archive_files")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/mojo:toolchain.bzl", "conda_libs")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/platforms:table.bzl", "pinned_kwargs")
load("@komira//tools/build/sql:defs.bzl", "duckdb_dist")

# The DuckDB CLI (github.com/duckdb/duckdb), MIT licensed (LICENSE below), at
# its release v1.5.6: the linux amd64 CLI archive the release publishes. It is
# the SQL engine of `sql_oracle` (tools/build/sql), which runs it as a build
# action; test data only. Nothing ships it. README.md says how to bump it.
#
# The release publishes no checksum file, so the sha256 below is of the
# archive as downloaded, twice, from the release URL.
_VERSION = "1.5.6"
_COMMIT = "069cc9f9b5be802405797faecc284961b07c70ef"
_SHA256 = "6e89deac1ebbc36eed0291caf8b567b030c7b86ac35998f71854e22b3c5d5e2f"
_SIZE = 21294383
_LICENSE_SHA256 = "7e17fd31249fa875cb3b1c5e05c6c3e99b75509f6a2804ca176c217834de1dcb"
_LICENSE_SIZE = 1072

# Who may use the pinned DuckDB: the test-only packages of src/tests that
# declare a sql_oracle, the Q6 phase probe's rule (it runs the benchmark's
# TPC-H staging, which starts this binary), and the fixtures of the rule's own tests in the `tests` cell. That cell exists only
# in komira's own checkout; a label naming it would fail to load in a
# repository that uses komira as a cell, so it is named only when it exists.
_USERS = ["komira//src/tests/...", "komira//src/komira_bench_q6_phases:"] + ([
    "tests//functional/sql_oracle:",
    "tests//negative/sql_oracle:",
] if read_root_config("cells", "tests") else [])

pinned_file(
    name = "duckdb_cli-linux-amd64.zip",
    url = "https://github.com/duckdb/duckdb/releases/download/v{}/duckdb_cli-linux-amd64.zip".format(_VERSION),
    sha256 = _SHA256,
    size_bytes = _SIZE,
)

# The archive holds the one file `duckdb`, mode 0755.
archive_files(
    name = "duckdb_cli",
    exec_compatible_with = LINUX_X86_64,
    archive = ":duckdb_cli-linux-amd64.zip",
    files = ["duckdb"],
)

# The C++ runtime the binary links beyond glibc (libstdc++.so.6,
# libgcc_s.so.1), from the conda-forge packages the platform table pins (the
# same files the toolchains, the hermetic Python and Node.js take). Every
# sql_oracle action names this directory's lib/ in LD_LIBRARY_PATH.
pinned_file(**pinned_kwargs("linux-x86_64", "libgcc"))

pinned_file(**pinned_kwargs("linux-x86_64", "libstdcxx"))

conda_libs(
    name = "native_libs",
    exec_compatible_with = LINUX_X86_64,
    libs = {
        "lib/libgcc_s.so.1": ":" + pinned_kwargs("linux-x86_64", "libgcc")["name"],
        "lib/libstdc++.so.6": ":" + pinned_kwargs("linux-x86_64", "libstdcxx")["name"],
    },
    unpacker = "komira//tools/build/toolchains:conda_unpack",
)

# sql_oracle's default `_duckdb`. Every action checks that the binary reports
# v<version> before it runs any SQL.
duckdb_dist(
    name = "duckdb",
    binary = ":duckdb_cli[duckdb]",
    native_libs = ":native_libs",
    version = _VERSION,
    visibility = _USERS,
)

# The release archive carries no license text; this is the LICENSE of the
# repository at the tag's commit, pinned by commit as third_party/h2spec pins
# its own, so a moved tag cannot change it.
pinned_file(
    name = "LICENSE",
    url = "https://raw.githubusercontent.com/duckdb/duckdb/{}/LICENSE".format(_COMMIT),
    sha256 = _LICENSE_SHA256,
    size_bytes = _LICENSE_SIZE,
    visibility = ["PUBLIC"],
)

# The tpch extension of this DuckDB release for linux amd64, gzip as the
# extension repository serves it, which the benchmark's staging
# (komira_bench_data, `tpch_extension_pins`) unpacks and loads to generate TPC-H.
# The sha256 and size are that pin; the staging refuses any other file.
pinned_file(
    name = "tpch.duckdb_extension.gz",
    url = "https://extensions.duckdb.org/v{}/linux_amd64/tpch.duckdb_extension.gz".format(_VERSION),
    sha256 = "51959cc795f6ea8c95cf8cc6cc4065358998ce959bf863e21ff1aa471c06bc41",
    size_bytes = 5649100,
    visibility = ["komira//src/komira_bench_q6_phases:"],
)
