load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/mojo:toolchain.bzl", "conda_libs")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/platforms:table.bzl", "pinned_kwargs")
load("@komira//tools/build/python:defs.bzl", "python_dist", "python_wheel")
load(":pins.bzl", "PYTHON", "WHEELS")

# The hermetic Python of the tests (README.md): CPython from a
# python-build-standalone archive and a closure of binary wheels, every file
# pinned by sha256 and size in pins.bzl and fetched like any other pinned
# download. Nothing here is shipped: the interpreter and the wheels are
# visible only to the test-only packages listed in _TEST_ONLY, and a py_test
# hands its dependents nothing but its pass marker (README.md, Never shipped).
# A new consumer is a new line here.
_TEST_ONLY = [
    "komira//src/tests/e2e/komira_tls_interop_e2e/...",
    "komira//src/tests/helpers/komira_test_python/...",
    # The embedded Python UDF runtime of the UDF runtime spike.
    "komira//src/tests/helpers/komira_udf_spike_python/...",
    # The Python UDF runtime of the UDF runtime spike behind its worker transport.
    "komira//src/tests/helpers/komira_udf_spike_python_worker/...",
    # The tests of the CI scripts under release/ci (a py_test alone).
    "komira//release/ci/tests:",
]

pinned_file(
    name = PYTHON["archive"],
    url = PYTHON["url"],
    sha256 = PYTHON["sha256"],
    size_bytes = PYTHON["size"],
)

# The shared libraries the wheels' extension modules link beyond glibc, from
# the conda-forge packages the platform table pins (the same files the Mojo
# and Rust toolchains take them from): the C++ runtime (pyarrow, duckdb,
# grpcio, numpy's bundled libgfortran) and zlib (NEEDED by numpy's bundled
# libraries). py_test loads them by path, in `preload` order, before a
# script runs; test `isolation` fails if any library is mapped from the worker.
pinned_file(**pinned_kwargs("linux-x86_64", "libgcc"))

pinned_file(**pinned_kwargs("linux-x86_64", "libstdcxx"))

pinned_file(**pinned_kwargs("linux-x86_64", "libzlib"))

conda_libs(
    name = "native_libs",
    exec_compatible_with = LINUX_X86_64,
    libs = {
        "lib/libgcc_s.so.1": ":" + pinned_kwargs("linux-x86_64", "libgcc")["name"],
        "lib/libstdc++.so.6": ":" + pinned_kwargs("linux-x86_64", "libstdcxx")["name"],
        "lib/libz.so.1": ":" + pinned_kwargs("linux-x86_64", "libzlib")["name"],
    },
    unpacker = "komira//tools/build/toolchains:conda_unpack",
)

python_dist(
    name = PYTHON["name"],
    archive = ":" + PYTHON["archive"],
    native_libs = ":native_libs",
    preload = [
        "lib/libgcc_s.so.1",
        "lib/libstdc++.so.6",
        "lib/libz.so.1",
    ],
    version = PYTHON["version"],
    visibility = _TEST_ONLY,
)

[pinned_file(
    name = w["file"],
    url = w["url"],
    sha256 = w["sha256"],
    size_bytes = w["size"],
) for w in WHEELS]

# One target per distribution, named by it (`:pyarrow`), with its deps.
[python_wheel(
    name = w["name"],
    distribution = w["name"],
    version = w["version"],
    wheel = ":" + w["file"],
    python = ":" + PYTHON["name"],
    deps = [":" + d for d in w["deps"]],
    visibility = _TEST_ONLY,
) for w in WHEELS]
