# The `(google.api.http)` method option alone, for a REST client of a proto
# that imports nothing else of googleapis: annotations.proto and its import
# closure, google/protobuf/* excepted. :api_http refuses this list unless it
# is exactly that closure.
_API_HTTP_ROOTS = [
    "google/api/annotations.proto",
]

_API_HTTP_CLOSURE = _API_HTTP_ROOTS + [
    "google/api/http.proto",
]

# Every client's closure; a new client appends its list here, and :googleapis
# extracts the union.
_ALL_CLOSURES = (
    _LOGGING_V2_CLOSURE +
    _STORAGE_V2_CLOSURE +
    _COMPUTE_V1_CLOSURE +
    _ARTIFACTREGISTRY_V1_CLOSURE +
    _APIGATEWAY_V1_CLOSURE +
    _API_HTTP_CLOSURE
)

# The files out of the archive, each a sub-target named by its path:
# :googleapis[LICENSE] is googleapis's license file at the pin. A file several
# closures share is extracted once.
archive_files(
    name = "googleapis",
    exec_compatible_with = LINUX_X86_64,
    archive = ":googleapis.tar.gz",
    files = ["LICENSE"] + sorted({f: None for f in _ALL_CLOSURES}.keys()),
    strip_prefix = "googleapis-" + _COMMIT,
    visibility = ["PUBLIC"],
)

# The Cloud Logging v2 protos, for a consumer: name
# //tools/vendor/googleapis:logging_v2 in a mojo_proto_library's proto_deps
# (its ProtoSrcsInfo is the checked tree), or :logging_v2[tree] for the
# directory. The default output is the descriptor set (--include_imports).
proto_check(
    name = "logging_v2",
    roots = _LOGGING_V2_ROOTS,
    srcs = [":googleapis[{}]".format(f) for f in sorted(_LOGGING_V2_CLOSURE)],
    strip_prefix = "files",
    visibility = ["PUBLIC"],
)

# The Cloud Storage v2 protos, for a consumer, as :logging_v2 above.
proto_check(
    name = "storage_v2",
    roots = _STORAGE_V2_ROOTS,
    srcs = [":googleapis[{}]".format(f) for f in sorted(_STORAGE_V2_CLOSURE)],
    strip_prefix = "files",
    visibility = ["PUBLIC"],
)

# The Compute Engine v1 protos, for a consumer, as :logging_v2 above.
proto_check(
    name = "compute_v1",
    roots = _COMPUTE_V1_ROOTS,
    srcs = [":googleapis[{}]".format(f) for f in sorted(_COMPUTE_V1_CLOSURE)],
    strip_prefix = "files",
    visibility = ["PUBLIC"],
)

# The Artifact Registry v1 protos, for a consumer, as :logging_v2 above.
proto_check(
    name = "artifactregistry_v1",
    roots = _ARTIFACTREGISTRY_V1_ROOTS,
    srcs = [":googleapis[{}]".format(f) for f in sorted(_ARTIFACTREGISTRY_V1_CLOSURE)],
    strip_prefix = "files",
    visibility = ["PUBLIC"],
)

# The API Gateway v1 protos, for a consumer, as :logging_v2 above.
proto_check(
    name = "apigateway_v1",
    roots = _APIGATEWAY_V1_ROOTS,
    srcs = [":googleapis[{}]".format(f) for f in sorted(_APIGATEWAY_V1_CLOSURE)],
    strip_prefix = "files",
    visibility = ["PUBLIC"],
)

# The `(google.api.http)` option's protos, for a consumer, as :logging_v2
# above.
proto_check(
    name = "api_http",
    roots = _API_HTTP_ROOTS,
    srcs = [":googleapis[{}]".format(f) for f in sorted(_API_HTTP_CLOSURE)],
    strip_prefix = "files",
    visibility = ["PUBLIC"],
)

# A validation of every proto_check target (proto_check.bzl, `_script_lint`).
shell_lint(
    name = "shell_lint",
    srcs = [
        "proto_check.sh",
        "upstream_version.sh",
    ],
)

# The check proto_check runs (proto_check.bzl, `_script`).
export_file(name = "proto_check.sh")

# The self-test of proto_check's check, over the fixtures in testdata/: one
# tree it must accept, and one change per case that it must refuse, each with
# the message it must give. Every proto_check target depends on it, so the
# check cannot stop refusing while any checked tree builds.
_OK = ["testdata/ok/fix/dep.proto", "testdata/ok/fix/root.proto"]

_CASES = {
    # The control: the fixture every refusal below varies in one place.
    "accepts": {},
    "refuses_missing_import": {
        "expect": "fix/dep.proto: File not found",
        "srcs": ["testdata/missing/fix/root.proto"],
        "strip_prefix": "testdata/missing",
    },
    "refuses_unused_file": {
        "expect": "fix/unused.proto is in the tree but not in the import closure of the roots",
        "srcs": ["testdata/extra/fix/dep.proto", "testdata/extra/fix/root.proto", "testdata/extra/fix/unused.proto"],
        "strip_prefix": "testdata/extra",
    },
    "refuses_vendored_wkt": {
        "expect": "google/protobuf/timestamp.proto is in the tree, but google/protobuf/ is protoc's own",
        "srcs": ["testdata/wkt/fix/dep.proto", "testdata/wkt/fix/root.proto", "testdata/wkt/google/protobuf/timestamp.proto"],
        "strip_prefix": "testdata/wkt",
    },
}

[proto_check_case(
    name = "proto_check_" + name,
    roots = case.get("roots", ["fix/root.proto"]),
    srcs = case.get("srcs", _OK),
    strip_prefix = case.get("strip_prefix", "testdata/ok"),
    expect = case.get("expect", ""),
) for name, case in _CASES.items()]

filegroup(
    name = "proto_check_selftest",
    srcs = [":proto_check_" + name for name in _CASES],
)
