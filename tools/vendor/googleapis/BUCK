# A validation of every proto_check target (proto_check.bzl, `_script_lint`).
shell_lint(
    name = "shell_lint",
    srcs = [
        "proto_check.sh",
        "upstream_version.sh",
    ],
)

# The check proto_check runs (proto_check.bzl, `_script`).
export_file(name = "proto_check.sh")

# The self-test of proto_check's check, over the fixtures in testdata/: one
# tree it must accept, and one change per case that it must refuse, each with
# the message it must give. Every proto_check target depends on it, so the
# check cannot stop refusing while any checked tree builds.
_OK = ["testdata/ok/fix/dep.proto", "testdata/ok/fix/root.proto"]

_CASES = {
    # The control: the fixture every refusal below varies in one place.
    "accepts": {},
    "refuses_missing_import": {
        "expect": "fix/dep.proto: File not found",
        "srcs": ["testdata/missing/fix/root.proto"],
        "strip_prefix": "testdata/missing",
    },
    "refuses_unused_file": {
        "expect": "fix/unused.proto is in the tree but not in the import closure of the roots",
        "srcs": ["testdata/extra/fix/dep.proto", "testdata/extra/fix/root.proto", "testdata/extra/fix/unused.proto"],
        "strip_prefix": "testdata/extra",
    },
    "refuses_vendored_wkt": {
        "expect": "google/protobuf/timestamp.proto is in the tree, but google/protobuf/ is protoc's own",
        "srcs": ["testdata/wkt/fix/dep.proto", "testdata/wkt/fix/root.proto", "testdata/wkt/google/protobuf/timestamp.proto"],
        "strip_prefix": "testdata/wkt",
    },
}

[proto_check_case(
    name = "proto_check_" + name,
    roots = case.get("roots", ["fix/root.proto"]),
    srcs = case.get("srcs", _OK),
    strip_prefix = case.get("strip_prefix", "testdata/ok"),
    expect = case.get("expect", ""),
) for name, case in _CASES.items()]

filegroup(
    name = "proto_check_selftest",
    srcs = [":proto_check_" + name for name in _CASES],
)
