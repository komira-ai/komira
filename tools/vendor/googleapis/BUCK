# Every client's closure; a new client appends its list here, and :googleapis
# extracts the union.
_ALL_CLOSURES = (
    _LOGGING_V2_CLOSURE +
    _STORAGE_V2_CLOSURE +
    _COMPUTE_V1_CLOSURE +
    _ARTIFACTREGISTRY_V1_CLOSURE +
    _APIGATEWAY_V1_CLOSURE +
    _FIRESTORE_V1_CLOSURE +
    _API_HTTP_CLOSURE +
    _API_CLIENT_CLOSURE +
    _IAM_ADMIN_V1_CLOSURE +
    _RESOURCEMANAGER_V3_CLOSURE +
    _SERVICEUSAGE_V1_CLOSURE +
    _RUN_V2_CLOSURE +
    _RUN_V2_SERVICE_CONFIG +
    _CLOUDSCHEDULER_V1_CLOSURE +
    _SECRETMANAGER_V1_CLOSURE +
    _MONITORING_V3_CLOSURE
)

# The files out of the archive, each a sub-target named by its path:
# :googleapis[LICENSE] is googleapis's license file at the pin. A file several
# closures share is extracted once.
archive_files(
    name = "googleapis",
    exec_compatible_with = LINUX_X86_64,
    archive = ":googleapis.tar.gz",
    files = ["LICENSE"] + sorted({f: None for f in _ALL_CLOSURES}.keys()),
    strip_prefix = "googleapis-" + _COMMIT,
    visibility = ["PUBLIC"],
)

# The Cloud Logging v2 protos, for a consumer: name
# //tools/vendor/googleapis:logging_v2 in a mojo_proto_library's proto_deps
# (its ProtoSrcsInfo is the checked tree), or :logging_v2[tree] for the
# directory. The default output is the descriptor set (--include_imports).
proto_check(
    name = "logging_v2",
    roots = _LOGGING_V2_ROOTS,
    srcs = [":googleapis[{}]".format(f) for f in sorted(_LOGGING_V2_CLOSURE)],
    strip_prefix = "files",
    visibility = ["PUBLIC"],
)

