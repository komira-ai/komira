load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/mojo:archive.bzl", "archive_files")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load(":proto_check.bzl", "proto_check", "proto_check_case")

# googleapis, Apache-2.0 (LICENSE in the archive), at one pinned commit of its
# default branch. Nothing of it is committed here: the archive is fetched at
# build time, checked against its sha256, and the files below extracted from
# it. Bumping is these two lines (README.md); upstream_version.sh reports how
# far the pin is behind upstream.
_COMMIT = "b29d17037e889281b718bfffdeea534aed00d36f"
_SHA256 = "737d608b0666e083fa8301bf7524875508addc13c929e592ed0ce47c2d692f58"

pinned_file(
    name = "googleapis.tar.gz",
    url = "https://github.com/googleapis/googleapis/archive/{}.tar.gz".format(_COMMIT),
    sha256 = _SHA256,
)

# Cloud Logging v2 (ListLogEntries, for the generated komira_gcp_logging): the
# roots and their import closure, google/protobuf/* excepted (protoc's own).
# :logging_v2 refuses this list unless it is exactly that closure, so a bump
# that changes the imports fails the build until the list follows.
_LOGGING_V2_ROOTS = [
    "google/logging/v2/log_entry.proto",
    "google/logging/v2/logging.proto",
]

_LOGGING_V2_CLOSURE = _LOGGING_V2_ROOTS + [
    "google/api/annotations.proto",
    "google/api/client.proto",
    "google/api/field_behavior.proto",
    "google/api/http.proto",
    "google/api/label.proto",
    "google/api/launch_stage.proto",
    "google/api/monitored_resource.proto",
    "google/api/resource.proto",
    "google/logging/type/http_request.proto",
    "google/logging/type/log_severity.proto",
    "google/rpc/status.proto",
]

# Cloud Storage v2 (the gRPC storage API, for the generated GCS client): the
