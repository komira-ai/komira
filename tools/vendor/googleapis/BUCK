# API Gateway v1 (for the generated komira_gcp_apigateway client): the root
# and its import closure, google/protobuf/* excepted, as :compute_v1 above.
_APIGATEWAY_V1_ROOTS = [
    "google/cloud/apigateway/v1/apigateway_service.proto",
]

_APIGATEWAY_V1_CLOSURE = _APIGATEWAY_V1_ROOTS + [
    "google/api/annotations.proto",
    "google/api/client.proto",
    "google/api/field_behavior.proto",
    "google/api/http.proto",
