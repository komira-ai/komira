load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("//functional/coverage:defs.bzl", "cov_report_check")

# Test 46: a test-only package. Its directory, relative to the tests cell's
# root, is under src/tests, one of COVERAGE_INFO_ONLY_DIRS
# (tools/build/coverage/policy.bzl), so its coverage gate measures it and
# reports what it finds as info: no finding, whatever the mode.
#
# covinfo is covlow (tests//negative/coverage) in this package: its test
# covers 3 of 6 lines and 1 of 4 arms, below the target. GREEN:
# tests//src/tests/coverage:covinfo[coverage][gate] (enforce), whose
# result.json (:covinfo_result) has no finding and its BelowTarget, line and
# branch, as info; the same library in tests//negative/coverage (covlow) is
# RED in enforce mode.
mojo_library(
    name = "covinfo",
    srcs = [
        "covinfo/__init__.mojo",
        "covinfo/word.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_gate = "komira//tools/build/coverage:cov_gate",
    coverage_mode = "enforce",
    import_name = "covinfo",
    test_srcs = ["tests/test_word.mojo"],
)

_PKG = "tools/build/tests/src/tests/coverage"

cov_report_check(
    name = "covinfo_result",
    expect = [
        '"conclusion":"success","mode":"enforce","target_bp":10000,',
        '"package":{"package":"' + _PKG + '","files":1,"unmeasured_files":0,"line_hit":3,"line_found":6,"line_bp":5000,"branch_hit":1,"branch_found":4,"branch_bp":2500,',
        '"findings":[],"exemptions"',
        '"info_packages":["' + _PKG + '"],',
        '"info_findings":[{"kind":"BelowTarget","package":"' + _PKG + '","metric":"branch","measured_bp":2500,"bound_bp":10000,"path":"","line":0,"message":"branch 25.00% is below the target 100.00%","count":null},{"kind":"BelowTarget","package":"' + _PKG + '","metric":"line","measured_bp":5000,"bound_bp":10000,',
    ],
    mode = "result",
    reports = [":covinfo[coverage][gate][result]"],
    script = "//functional/coverage:report.sh",
)
