load("@komira//third_party/botocore:models.bzl", "botocore_model")
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")
load("//functional/mojo_gcp_client:defs.bzl", "gen_check")

# mojo_aws_client in client mode, checked at GENERATION only. run_tests.sh (test
# 35) builds :komira_aws_logs_client_send_surface by name, never this
# package's pattern. What is pinned is that `mode = "client"` reaches the
# generator without `--pure-only`: the generated module carries the
# signed-send surface, its komira_http_core import, the send over injected
# seams (`send_with`) with its komira_retry import, and the error builder
# that reads an error's code and message through komira_aws_core's
# aws_json_error_info. (Pure mode leaving all of that out is the `absent`
# of ../mojo_aws_client's gen_check.) The client library itself is not
# compiled here: client-mode code imports komira_http_core and the
# transport half of komira_aws_core, and this cell neither depends on the
# komira cell's (each cell's MojoPkgTSet is a different type) nor stubs
# them, since a stub would be a second copy of the send signature to keep
# in step. It is compiled against the REAL core, with its welded tests, in
# the komira cell: komira//src/komira_aws_s3 (restXml) and
# komira//src/komira_aws_sqs (awsJson) are client mode.

_LOGS = botocore_model("logs")

mojo_aws_client(
    name = "komira_aws_logs_client",
    mode = "client",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    deps = [
        "//functional/mojo_aws_client:komira_aws_core",
        "//functional/mojo_aws_client:komira_json",
    ],
)

gen_check(
    name = "komira_aws_logs_client_send_surface",
    absent = ["mode         : pure (no transport)"],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "komira_aws_logs_client.mojo",
    ],
    gen = ":komira_aws_logs_client[gen]",
    present = [
        "mode         : client",
        "from komira_http_core.transport.io_stream import Connector",
        "send_sigv4_signed_request,",
        "[C: Connector, T: AwsCredsSource](Movable, Deinitable):",
        "var info = aws_json_error_info(res.to_response())",
        "var code = info.code.copy()",
        "var msg = info.message.copy()",
        "from komira_retry import (",
        "    RetryLoop,",
        "def send_with[",
        "return send_sigv4_signed_request_with(",
    ],
)
