load("@komira//third_party/botocore:models.bzl", "botocore_model")
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")
load("//functional/mojo_gcp_client:defs.bzl", "gen_check", "tests_check")

# mojo_aws_client in client mode. `buck2 build tests//functional/aws_client_mode:`
# builds the client, which runs its welded tests (the generated layout probe,
# then test_logs_client_send), and the checks below; run_tests.sh (test 35)
# builds this package.
#
# The runtime is ../mojo_aws_client's stubs (a library of this cell cannot
# depend on a mojo_library of the komira cell; see that BUCK):
# komira_aws_core with its client half, whose `send_sigv4_signed_request`
# and `send_sigv4_signed_request_with` are test doubles that answer with the
# arguments they were given, komira_http_core's Connector trait,
# komira_http_client's HttpClientConfig, and komira_retry's seams and loop.
# Compiling the generated module against
# them is what keeps the stubs in step with the import block the generator
# writes from emit_aws/mod.rs AWS_IMPORTS, for the rows that apply to an
# awsJson module: a client-mode row for every protocol or for awsJson that
# the stub lacks fails this build. The client-mode rows of the other
# protocols (restJson, restXml, S3, endpoint rules) are compiled by no
# target of this cell.
#
# What is pinned besides: `mode = "client"` reaches the generator without
# `--pure-only`, so the generated module carries the signed-send surface, its
# komira_http_core and komira_http_client imports, the constructor's
# HttpClientConfig argument, the send over injected seams (`send_with`) with
# its komira_retry import, and the error builder that reads an error's code
# and message through komira_aws_core. (Pure mode leaving all of that out is
# the `absent` of ../mojo_aws_client's gen_check.)

_LOGS = botocore_model("logs")

mojo_aws_client(
    name = "komira_aws_logs_client",
    mode = "client",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    test_srcs = ["test_logs_client_send.mojo"],
    deps = [
        "//functional/mojo_aws_client:komira_aws_core",
        "//functional/mojo_aws_client:komira_http_client",
        "//functional/mojo_aws_client:komira_http_core",
        "//functional/mojo_aws_client:komira_json",
        "//functional/mojo_aws_client:komira_retry",
    ],
)

gen_check(
    name = "komira_aws_logs_client_send_surface",
    absent = ["mode         : pure (no transport)"],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "komira_aws_logs_client.mojo",
    ],
    gen = ":komira_aws_logs_client[gen]",
    present = [
        "mode         : client",
        "from komira_http_client.client import HttpClientConfig",
        "from komira_http_core.transport.io_stream import Connector",
        "send_sigv4_signed_request,",
        "http_config: HttpClientConfig,",
        "[C: Connector, T: AwsCredsSource](Movable, Deinitable):",
        "var info = aws_json_error_info(res.to_response())",
        "var code = info.code.copy()",
        "var msg = info.message.copy()",
        "from komira_retry import (",
        "    RetryLoop,",
        "def send_with[",
        "return send_sigv4_signed_request_with(",
    ],
)

# The client ran exactly these tests, and each passed.
tests_check(
    name = "komira_aws_logs_client_tests",
    expect = [
        "_layout_probe",
        "_no_env_reads",
        "test_logs_client_send",
    ],
    markers = ":komira_aws_logs_client[tests]",
)
