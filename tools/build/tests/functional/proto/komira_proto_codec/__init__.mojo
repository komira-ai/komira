"""A minimal runtime for the Mojo generated by protoc-gen-mojo.

The traits the generated message structs conform to, restricted to the
field kinds the fixtures in this package use (string, int64, message), and one
protobuf-binary encoder and decoder for them.
"""


@fieldwise_init
struct FieldKey(Copyable, ImplicitlyCopyable, Movable):
    var field_no: Int
    var json_name: String
    var end: Bool


trait WireEncoder(Movable):
    # Whether a generated `encode` skips a plain proto3 field at its default
    # (komira_proto_codec's own `WireEncoder` says more).
    comptime OMITS_IMPLICIT_DEFAULTS: Bool

    def write_string_field(
        mut self, field_no: Int, json_name: StringSlice, v: String
    ) raises:
        ...

    def write_i64_field(
        mut self, field_no: Int, json_name: StringSlice, v: Int64
    ) raises:
        ...

    def write_message_field[
        M: Serializable
    ](mut self, field_no: Int, json_name: StringSlice, v: M) raises:
        ...


trait WireDecoder(Copyable, Movable):
    def next_field(mut self) raises -> FieldKey:
        ...

    def read_string(mut self) raises -> String:
        ...

    def read_i64(mut self) raises -> Int64:
        ...

    def read_message[M: Serializable](mut self) raises -> M:
        ...

    def skip(mut self) raises:
        ...

    def expect_fields(
        mut self, message_name: StringSlice, accepted: StringSlice
    ) raises:
        ...


trait Serializable(Copyable, Movable):
    def encode[E: WireEncoder](self, mut enc: E) raises:
        ...

    @staticmethod
    def decode[D: WireDecoder](mut dec: D) raises -> Self:
        ...


struct PbEncoder(WireEncoder):
    """Protobuf binary. Like proto3, omits fields holding their default."""

    # This encoder omits the defaults itself, below.
    comptime OMITS_IMPLICIT_DEFAULTS = False

    var buf: List[UInt8]

    def __init__(out self):
        self.buf = List[UInt8]()

    def _varint(mut self, v: UInt64):
        var x = v
        while x >= 0x80:
            self.buf.append(UInt8(Int((x & 0x7F) | 0x80)))
            x >>= 7
        self.buf.append(UInt8(Int(x)))

    def write_string_field(
        mut self, field_no: Int, json_name: StringSlice, v: String
    ) raises:
        if v.byte_length() == 0:
            return
        self._varint(UInt64(field_no * 8 + 2))
        var b = v.as_bytes()
        self._varint(UInt64(len(b)))
        for i in range(len(b)):
            self.buf.append(b[i])

    def write_i64_field(
        mut self, field_no: Int, json_name: StringSlice, v: Int64
    ) raises:
        if v == 0:
            return
        self._varint(UInt64(field_no * 8))
        self._varint(v.cast[DType.uint64]())

    def write_message_field[
        M: Serializable
    ](mut self, field_no: Int, json_name: StringSlice, v: M) raises:
        var child = PbEncoder()
        v.encode(child)
        self._varint(UInt64(field_no * 8 + 2))
        self._varint(UInt64(len(child.buf)))
        for i in range(len(child.buf)):
            self.buf.append(child.buf[i])

    def hex(self) -> String:
        var out = String()
        for i in range(len(self.buf)):
            if i > 0:
                out += " "
            var b = Int(self.buf[i])
            out += _hex_digit(b // 16)
            out += _hex_digit(b % 16)
        return out


def _hex_digit(d: Int) -> String:
    if d < 10:
        return chr(48 + d)
    return chr(87 + d)


struct PbDecoder(WireDecoder):
    var buf: List[UInt8]
    var pos: Int
    var wire_type: Int

    def __init__(out self, buf: List[UInt8]):
        self.buf = buf.copy()
        self.pos = 0
        self.wire_type = 0

    def _varint(mut self) raises -> UInt64:
        var result: UInt64 = 0
        var shift: UInt64 = 0
        while True:
            if self.pos >= len(self.buf):
                raise Error("truncated varint")
            var b = self.buf[self.pos]
            self.pos += 1
            result |= (UInt64(Int(b)) & 0x7F) << shift
            if b < 0x80:
                break
            shift += 7
        return result

    def next_field(mut self) raises -> FieldKey:
        if self.pos >= len(self.buf):
            return FieldKey(0, String(""), True)
        var key = self._varint()
        self.wire_type = Int(key & 7)
        return FieldKey(Int(key >> 3), String(""), False)

    def read_string(mut self) raises -> String:
        var n = Int(self._varint())
        if self.pos + n > len(self.buf):
            raise Error("truncated string")
        var s = String()
        for i in range(self.pos, self.pos + n):
            s += chr(Int(self.buf[i]))
        self.pos += n
        return s

    def read_i64(mut self) raises -> Int64:
        return self._varint().cast[DType.int64]()

    def read_message[M: Serializable](mut self) raises -> M:
        var n = Int(self._varint())
        if self.pos + n > len(self.buf):
            raise Error("truncated message")
        var sub = List[UInt8]()
        for i in range(self.pos, self.pos + n):
            sub.append(self.buf[i])
        self.pos += n
        var dec = PbDecoder(sub)
        return M.decode(dec)

    def skip(mut self) raises:
        if self.wire_type == 0:
            _ = self._varint()
        elif self.wire_type == 1:
            self.pos += 8
        elif self.wire_type == 2:
            self.pos += Int(self._varint())
        elif self.wire_type == 5:
            self.pos += 4
        else:
            raise Error("unsupported wire type")

    def expect_fields(
        mut self, message_name: StringSlice, accepted: StringSlice
    ) raises:
        pass
