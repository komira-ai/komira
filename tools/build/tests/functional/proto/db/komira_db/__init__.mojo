"""A minimal runtime for the Mojo generated by protoc-gen-mojo-db.

The names the generated DbStorable code imports, restricted to what the
fixtures in this package use: a value is carried as text, and a row is the
list of values `to_row` produced.
"""

comptime LOGICAL_UUID = 1
comptime LOGICAL_TEXT = 2
comptime LOGICAL_INT4 = 3
comptime LOGICAL_INT8 = 4
comptime LOGICAL_FLOAT8 = 5
comptime LOGICAL_FLOAT4 = 6
comptime LOGICAL_BOOL = 7
comptime LOGICAL_BYTES = 8
comptime LOGICAL_TIMESTAMPTZ = 9
comptime LOGICAL_JSONB = 10
comptime LOGICAL_TEXT_ARRAY = 11


@fieldwise_init
struct Uuid(Copyable, ImplicitlyCopyable, Movable):
    var text: String

    def bytes(self) -> String:
        return self.text


@fieldwise_init
struct Timestamptz(Copyable, ImplicitlyCopyable, Movable):
    var micros: Int64


@fieldwise_init
struct DbColumn(Copyable, Movable):
    var name: String
    var field_no: Int
    var logical: Int
    var nullable: Bool


@fieldwise_init
struct DbValue(Copyable, Movable):
    var logical: Int
    var data: String

    @staticmethod
    def uuid(v: String) -> DbValue:
        return DbValue(LOGICAL_UUID, v)

    @staticmethod
    def text(v: String) -> DbValue:
        return DbValue(LOGICAL_TEXT, v)

    @staticmethod
    def int8(v: Int64) -> DbValue:
        return DbValue(LOGICAL_INT8, String(v))

    @staticmethod
    def bool_val(v: Bool) -> DbValue:
        return DbValue(LOGICAL_BOOL, String("true") if v else String("false"))


@fieldwise_init
struct DbRow(Copyable, Movable):
    var values: List[DbValue]

    def get_text(self, col: Int) raises -> String:
        return self.values[col].data

    def get_uuid(self, col: Int) raises -> String:
        return self.values[col].data

    def get_int8(self, col: Int) raises -> Int64:
        return Int64(atol(self.values[col].data))


trait SqlDatabase:
    @staticmethod
    def placeholder(i: Int) -> String:
        ...


trait DbStorable(Movable):
    @staticmethod
    def column_names() -> List[String]:
        ...

    @staticmethod
    def column_types() -> List[DbColumn]:
        ...

    @staticmethod
    def create_table_ddl() -> String:
        ...

    def to_row(self) -> List[DbValue]:
        ...

    @staticmethod
    def from_row(row: DbRow, col_index: List[Int]) raises -> Self:
        ...


trait DbSchema:
    @staticmethod
    def create_table_ddl() -> String:
        ...
