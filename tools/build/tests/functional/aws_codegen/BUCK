# The client-mode module of the tiny awsQuery model as a text golden, as for
# logs_client and tiny_rest_json_client: the caller's HttpClientConfig
# reaches the signed send, and the anonymous operations go through the
# unsigned one.
aws_codegen_golden(
    name = "query_client",
    gen_args = [
        "--model-sha256",
        TINY_QUERY.sha256,
        "--service",
        "tiny",
        "--operations",
        ",".join(_TINY_QUERY_CLIENT_OPERATIONS),
        "--probe-import",
        "komira_aws_tiny_query.komira_aws_tiny_query",
    ],
    golden = "golden/query_client.mojo",
    golden_probe = "golden/query_client_probe.mojo",
    model = TINY_QUERY.model,
    module = "komira_aws_tiny_query",
    must_contain = _CONFIG_PINS,
)

# An ec2Query client of a tiny model, pure mode: queryName and capitalized
# locationName parameter names, a plain member name kept, a list of
# structures holding a list (never wrapped), an empty list writing nothing;
# the response read from the root, with wrapped `item` lists of structures;
# an operation with no input and no output. The model is
# komira//tools/build/proto-codegen/aws_query's, where the same module is
# compiled against the real runtime and tested.
_TINY_EC2_OPERATIONS = ["DescribeThings", "Ping"]

aws_codegen_golden(
