load("@komira//third_party/botocore:models.bzl", "botocore_model")
load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/proto-codegen/aws_rest_json:model.bzl", "TINY_REST_JSON")
load("@komira//tools/build/proto-codegen/aws_rest_xml:model.bzl", "TINY_REST_XML")
load("//functional/mojo_gcp_client:defs.bzl", "gen_check", "tests_check")
load(":defs.bzl", "aws_codegen_golden", "aws_codegen_refusal")

# Text goldens and refusals of komira//tools/build/proto-codegen:aws-client-gen,
# as check actions: `buck2 build tests//functional/aws_codegen:` runs them all
# (run_tests.sh, test 34).
#
# The CloudWatch Logs model is the pinned botocore one
# (komira//third_party/botocore, models.bzl), read from the archive at build
# time. model/ holds only this package's own inputs: a zero-byte model, tiny
# restXml models (a non-S3 one for the customization refusals, one per
# restXml refusal), a tiny Smithy RPC v2 CBOR model and a tiny awsJson model
# that declares SigV2. The tiny restJson1 and S3-shaped restXml models come
# from komira//tools/build/proto-codegen/aws_rest_json and aws_rest_xml
# (model and digest in each one's model.bzl), where their pure-mode clients
# are compiled against the real runtime, which only the komira cell can
# depend on; this package holds those clients' generated files and welded
# tests to exact sets.

_LOGS_SHA256 = botocore_model("logs").sha256

# The non-S3 tiny restXml model, for the customization refusals.
_TINY_RESTXML_SHA256 = "47dc951fe9a3275e5621a62760272d6bb58fb18a56de58f0c179f793882cba05"
_LOGS_MODEL = botocore_model("logs").model
_LOGS = [
    "--model-sha256",
    _LOGS_SHA256,
    "--service",
    "logs",
]

# The module kci_logs needs first: GetLogEvents, without transport.
aws_codegen_golden(
    name = "logs_pure",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--pure-only",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    golden = "golden/logs_pure.mojo",
    golden_probe = "golden/logs_pure_probe.mojo",
    model = _LOGS_MODEL,
    module = "komira_aws_logs",
)

# The same operation as a client: it adds the komira_aws_core transport names
# and komira_http_core.transport.io_stream.Connector.
aws_codegen_golden(
    name = "logs_client",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    golden = "golden/logs_client.mojo",
    golden_probe = "golden/logs_client_probe.mojo",
    model = _LOGS_MODEL,
    module = "komira_aws_logs",
)

# A restJson1 client of a tiny model, client mode: URI labels (one greedy)
# after a literal query, query members (a list and a map), headers (a
# timestamp, a list and a prefix map), a JSON body, a structure payload, the
# status, a streaming blob output payload (`parse_get_thing_head`), and the
# restJson1 error builder. The model is
# komira//tools/build/proto-codegen/aws_rest_json's, where the pure-mode
# module is compiled against the real runtime and tested.
aws_codegen_golden(
    name = "tiny_rest_json_client",
    gen_args = [
        "--model-sha256",
        TINY_REST_JSON.sha256,
        "--service",
        "tiny",
        "--operations",
        "GetThing,PutThing,SetConfig",
        "--probe-import",
        "komira_aws_tiny_rest.komira_aws_tiny_rest",
    ],
    golden = "golden/tiny_rest_json_client.mojo",
    golden_probe = "golden/tiny_rest_json_client_probe.mojo",
    model = TINY_REST_JSON.model,
    module = "komira_aws_tiny_rest",
)

# The pure-mode client of the same model, built in the komira cell: exactly
# the package's three files were generated, with no transport.
gen_check(
    name = "tiny_rest_json_pure_scoped",
    absent = ["komira_http"],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "komira_aws_tiny_rest.mojo",
    ],
    gen = "komira//tools/build/proto-codegen/aws_rest_json:komira_aws_tiny_rest[gen]",
    present = [
        "protocol     : rest-json (restJson1)",
        "mode         : pure (no transport)",
        "operations   : GetThing, PutThing, SetConfig",
        "model sha256 : " + TINY_REST_JSON.sha256,
        "def build_get_thing_request(",
        "def parse_get_thing_head(",
    ],
)

# Its layout probe and its caller test are welded into it, and each ran and
# passed.
tests_check(
    name = "tiny_rest_json_pure_tests",
    expect = [
        "_layout_probe",
        "test_tiny_rest_json",
    ],
    markers = "komira//tools/build/proto-codegen/aws_rest_json:komira_aws_tiny_rest[tests]",
)

aws_codegen_refusal(
    name = "refuse_empty_operations",
    expect = "--operations is MANDATORY and may not be empty",
    gen_args = _LOGS + [
        "--operations",
        "",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_no_operations",
    expect = "--operations is MANDATORY and may not be empty",
    gen_args = _LOGS,
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_unknown_operation",
    expect = "GetLogEvent",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvent",
    ],
    model = _LOGS_MODEL,
)

# A restXml client of a tiny S3-shaped model, pure mode, with the `s3`
# customization: a label after a literal query, a header, the input's root
# element in its namespace holding a scalar, a timestamp, a wrapped list
# with renamed items and a flattened list of structures, a structure payload
# in its namespace, blob (streaming and not) and string output payloads, an
# operation with no output, the response side of each, and the two `s3`
# response behaviors. The model is
# komira//tools/build/proto-codegen/aws_rest_xml's, where the same module is
# compiled against the real runtime and tested.
_TINY_XML_OPERATIONS = ["GetBlob", "GetBytes", "GetPolicy", "PutThing", "SetConfig"]

aws_codegen_golden(
    name = "restxml_pure",
    gen_args = [
        "--model-sha256",
        TINY_REST_XML.sha256,
        "--service",
        "tiny",
        "--operations",
        ",".join(_TINY_XML_OPERATIONS),
        "--pure-only",
        "--customization",
        "s3",
        "--probe-import",
        "komira_aws_tiny_xml.komira_aws_tiny_xml",
    ],
    golden = "golden/restxml_pure.mojo",
    golden_probe = "golden/restxml_pure_probe.mojo",
    model = TINY_REST_XML.model,
    module = "komira_aws_tiny_xml",
)

# The same module, built in the komira cell: exactly the package's three
# files were generated, with no transport and no JSON runtime.
gen_check(
    name = "tiny_rest_xml_pure_scoped",
    absent = [
        "komira_http",
        "komira_json",
    ],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "komira_aws_tiny_xml.mojo",
    ],
    gen = "komira//tools/build/proto-codegen/aws_rest_xml:komira_aws_tiny_xml[gen]",
    present = [
        "protocol     : rest-xml (restXml)",
        "mode         : pure (no transport)",
        "operations   : " + ", ".join(_TINY_XML_OPERATIONS),
        "model sha256 : " + TINY_REST_XML.sha256,
        "customize    : s3 (",
        "def parse_get_blob_head(",
        "if aws_xml_body_is_error(resp):",
    ],
)

# Its layout probe and its caller test are welded into it, and each ran and
# passed.
tests_check(
    name = "tiny_rest_xml_pure_tests",
    expect = [
        "_layout_probe",
        "test_tiny_rest_xml",
    ],
    markers = "komira//tools/build/proto-codegen/aws_rest_xml:komira_aws_tiny_xml[tests]",
)

aws_codegen_refusal(
    name = "refuse_unsupported_protocol",
    expect = "declares protocol `smithy-rpc-v2-cbor`",
    gen_args = [
        "--model-sha256",
        "fb3a13255e2b76eafa4fe45685528f9f63bbfd5327badab0387e9c0fdbfe6b4a",
        "--service",
        "tiny",
        "--operations",
        "Ping",
    ],
    model = "model/tiny_rpcv2cbor.json",
)

# The `s3` customization is for S3's model only, and no other customization
# exists.
aws_codegen_refusal(
    name = "refuse_s3_customization_on_another_service",
    expect = "customization is refused unless the model's serviceId is `S3` and its protocol is restXml",
    gen_args = [
        "--model-sha256",
        _TINY_RESTXML_SHA256,
        "--service",
        "tiny",
        "--operations",
        "Ping",
        "--customization",
        "s3",
    ],
    model = "model/tiny_restxml.json",
)

aws_codegen_refusal(
    name = "refuse_unknown_customization",
    expect = "--customization `s4` is not one this generator has",
    gen_args = [
        "--model-sha256",
        _TINY_RESTXML_SHA256,
        "--service",
        "tiny",
        "--operations",
        "Ping",
        "--customization",
        "s4",
    ],
    model = "model/tiny_restxml.json",
)

# Each restXml refusal, by name: a model that reaches the feature is refused
# before any file is written.
[aws_codegen_refusal(
    name = "refuse_restxml_" + kind,
    expect = "REFUSED {}:".format(name),
    gen_args = [
        "--model-sha256",
        sha256,
        "--service",
        "tiny",
        "--operations",
        "Ping",
    ],
    model = "model/tiny_restxml_{}.json".format(kind),
) for kind, name, sha256 in [
    ("attribute", "xml-attribute", "cab4c41d5f96e7099cdbbb22dc4ae0b5a3fc907325658a215af22b791db21672"),
    ("map", "xml-map", "2c7c8b8cf092b522757e750b413d3b763156665502f36819789afca4a9780022"),
    ("union", "union", "68021473fc6663bdfe2b6591199a2fe7822dd82b46b580c488606713db69dc3f"),
]]

# The generated client signs with SigV4 only: a supported protocol whose
# model declares another signatureVersion is refused, naming the value.
aws_codegen_refusal(
    name = "refuse_unsupported_signature_version",
    expect = "declares signatureVersion `v2`",
    gen_args = [
        "--model-sha256",
        "56681d4dc86cab752222bdb3f4111c0f706d83937a2f128c19c35de10a1c4fe2",
        "--service",
        "tiny",
        "--operations",
        "Ping",
    ],
    model = "model/tiny_json_sigv2.json",
)

# The digest is checked against the bytes: the right model with another
# model's digest is refused.
aws_codegen_refusal(
    name = "refuse_wrong_sha256",
    expect = "The model is not the pinned one",
    gen_args = [
        "--model-sha256",
        "5f457c555302b8e12a8b7def55eaf4e94510d3c19731c57325f10e4a91cad9ab",
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_no_sha256",
    expect = "--model-sha256 is required",
    gen_args = [
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

# A zero-byte model, under its own (correct) digest: it passes the digest
# check and is refused as EMPTY before the JSON parser sees it.
aws_codegen_refusal(
    name = "refuse_empty_model",
    expect = "is EMPTY. A zero-byte model",
    gen_args = [
        "--model-sha256",
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = "model/empty.json",
)

# The digest is 64 LOWERCASE hex digits: the right digest in upper case, and
# one digit short, are both refused before the model is read.
aws_codegen_refusal(
    name = "refuse_uppercase_sha256",
    expect = "is not 64 lowercase hex digits",
    gen_args = [
        "--model-sha256",
        _LOGS_SHA256.upper(),
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_short_sha256",
    expect = "is not 64 lowercase hex digits",
    gen_args = [
        "--model-sha256",
        _LOGS_SHA256[:-1],
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

# --probe-import names the probe's import, so without --probe-out it is refused.
aws_codegen_refusal(
    name = "refuse_probe_import_without_probe_out",
    expect = "--probe-import names the probe's import, so it needs --probe-out",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    model = _LOGS_MODEL,
    probe_out = False,
)

# Not checked here: emit_layout_probe's refusal of a module with no struct.
# The CLI cannot reach it: --operations may not be empty, and the front-end
# gives every operation a Request and a Response struct (synthesising an
# empty one where the model declares no input or output), so every module
# the CLI emits has at least two structs to probe.

export_file(
    name = "aws_codegen.sh",
    visibility = ["//negative/aws_codegen:"],
)

shell_lint(
    name = "shell_lint",
    srcs = ["aws_codegen.sh"],
    visibility = ["komira//:tests_lints"],
)

# For tests//negative/aws_codegen, which plants a golden that differs.
export_file(
    name = "logs_client_golden",
    src = "golden/logs_client.mojo",
    visibility = ["//negative/aws_codegen:"],
)
