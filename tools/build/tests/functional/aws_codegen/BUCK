load("@komira//third_party/botocore:models.bzl", "botocore_model")
load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/proto-codegen/aws_rest_json:model.bzl", "TINY_REST_JSON")
load("//functional/gcp_client:defs.bzl", "gen_check", "tests_check")
load(":defs.bzl", "aws_codegen_golden", "aws_codegen_refusal")

# Text goldens and refusals of komira//tools/build/proto-codegen:aws-client-gen,
# as check actions: `buck2 build tests//functional/aws_codegen:` runs them all
# (run_tests.sh, test 34).
#
# The CloudWatch Logs model is the pinned botocore one
# (komira//third_party/botocore, models.bzl), read from the archive at build
# time. model/ holds only this package's own inputs: a zero-byte model, a
# tiny restXml model and a tiny awsJson model that declares SigV2. The tiny
# restJson1 model comes from komira//tools/build/proto-codegen/aws_rest_json
# (model and digest in its model.bzl), where its pure-mode client is compiled
# against the real runtime, which only the komira cell can depend on; this
# package holds that client's generated files and welded tests to exact sets.

_LOGS_SHA256 = botocore_model("logs").sha256
_LOGS_MODEL = botocore_model("logs").model
_LOGS = [
    "--model-sha256",
    _LOGS_SHA256,
    "--service",
    "logs",
]

# The caller's HttpClientConfig reaches the signed send of a generated client.
# The client builds its HttpClient inside the core, so a serving process can
# bound its outbound budget (HttpClientConfig.for_serving_ceiling) only through
# this argument. Three links, each pinned as a whole line: the constructor
# takes it with no default (`= ...` cannot match the trailing comma), stores
# the caller's value rather than one of its own, and the send passes that
# field as its second argument. send_sigv4_signed_request is the transport
# half of komira_aws_core/signed_request.mojo, whose header states the
# signature these pins assume; revisit them when that function lands.
_CONFIG_PINS = [
    "http_config: HttpClientConfig,",
    "self._http_config = http_config.copy()",
    "\n".join([
        "return send_sigv4_signed_request[Self.C](",
        "self._mk_connector,",
        "self._http_config.copy(),",
    ]),
]

# The module kci_logs needs first: GetLogEvents, without transport.
aws_codegen_golden(
    name = "logs_pure",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--pure-only",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    golden = "golden/logs_pure.mojo",
    golden_probe = "golden/logs_pure_probe.mojo",
    model = _LOGS_MODEL,
    module = "komira_aws_logs",
)

# The same operation as a client: it adds the komira_aws_core transport names,
# komira_http_client.client.HttpClientConfig and
# komira_http_core.transport.io_stream.Connector.
aws_codegen_golden(
    name = "logs_client",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    golden = "golden/logs_client.mojo",
    golden_probe = "golden/logs_client_probe.mojo",
    model = _LOGS_MODEL,
    module = "komira_aws_logs",
    must_contain = _CONFIG_PINS,
)

# A restJson1 client of a tiny model, client mode: URI labels (one greedy)
# after a literal query, query members (a list and a map), headers (a
# timestamp, a list and a prefix map), a JSON body, a structure payload, the
# status, a streaming blob output payload (`parse_get_thing_head`), and the
# restJson1 error builder. The model is
# komira//tools/build/proto-codegen/aws_rest_json's, where the pure-mode
# module is compiled against the real runtime and tested.
aws_codegen_golden(
    name = "tiny_rest_json_client",
    gen_args = [
        "--model-sha256",
        TINY_REST_JSON.sha256,
        "--service",
        "tiny",
        "--operations",
        "GetThing,PutThing,SetConfig",
        "--probe-import",
        "komira_aws_tiny_rest.komira_aws_tiny_rest",
    ],
    golden = "golden/tiny_rest_json_client.mojo",
    golden_probe = "golden/tiny_rest_json_client_probe.mojo",
    model = TINY_REST_JSON.model,
    module = "komira_aws_tiny_rest",
    must_contain = _CONFIG_PINS,
)

# The pure-mode client of the same model, built in the komira cell: exactly
# the package's three files were generated, with no transport.
gen_check(
    name = "tiny_rest_json_pure_scoped",
    absent = ["komira_http"],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "komira_aws_tiny_rest.mojo",
    ],
    gen = "komira//tools/build/proto-codegen/aws_rest_json:komira_aws_tiny_rest[gen]",
    present = [
        "protocol     : rest-json (restJson1)",
        "mode         : pure (no transport)",
        "operations   : GetThing, PutThing, SetConfig",
        "model sha256 : " + TINY_REST_JSON.sha256,
        "def build_get_thing_request(",
        "def parse_get_thing_head(",
    ],
)

# Its layout probe and its caller test are welded into it, and each ran and
# passed.
tests_check(
    name = "tiny_rest_json_pure_tests",
    expect = [
        "_layout_probe",
        "test_tiny_rest_json",
    ],
    markers = "komira//tools/build/proto-codegen/aws_rest_json:komira_aws_tiny_rest[tests]",
)

aws_codegen_refusal(
    name = "refuse_empty_operations",
    expect = "--operations is MANDATORY and may not be empty",
    gen_args = _LOGS + [
        "--operations",
        "",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_no_operations",
    expect = "--operations is MANDATORY and may not be empty",
    gen_args = _LOGS,
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_unknown_operation",
    expect = "GetLogEvent",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvent",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_unsupported_protocol",
    expect = "rest-xml",
    gen_args = [
        "--model-sha256",
        "5f457c555302b8e12a8b7def55eaf4e94510d3c19731c57325f10e4a91cad9ab",
        "--service",
        "tiny",
        "--operations",
        "Ping",
    ],
    model = "model/tiny_restxml.json",
)

# The generated client signs with SigV4 only: a supported protocol whose
# model declares another signatureVersion is refused, naming the value.
aws_codegen_refusal(
    name = "refuse_unsupported_signature_version",
    expect = "declares signatureVersion `v2`",
    gen_args = [
        "--model-sha256",
        "56681d4dc86cab752222bdb3f4111c0f706d83937a2f128c19c35de10a1c4fe2",
        "--service",
        "tiny",
        "--operations",
        "Ping",
    ],
    model = "model/tiny_json_sigv2.json",
)

# The digest is checked against the bytes: the right model with another
# model's digest is refused.
aws_codegen_refusal(
    name = "refuse_wrong_sha256",
    expect = "The model is not the pinned one",
    gen_args = [
        "--model-sha256",
        "5f457c555302b8e12a8b7def55eaf4e94510d3c19731c57325f10e4a91cad9ab",
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_no_sha256",
    expect = "--model-sha256 is required",
    gen_args = [
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

# A zero-byte model, under its own (correct) digest: it passes the digest
# check and is refused as EMPTY before the JSON parser sees it.
aws_codegen_refusal(
    name = "refuse_empty_model",
    expect = "is EMPTY. A zero-byte model",
    gen_args = [
        "--model-sha256",
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = "model/empty.json",
)

# The digest is 64 LOWERCASE hex digits: the right digest in upper case, and
# one digit short, are both refused before the model is read.
aws_codegen_refusal(
    name = "refuse_uppercase_sha256",
    expect = "is not 64 lowercase hex digits",
    gen_args = [
        "--model-sha256",
        _LOGS_SHA256.upper(),
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_short_sha256",
    expect = "is not 64 lowercase hex digits",
    gen_args = [
        "--model-sha256",
        _LOGS_SHA256[:-1],
        "--service",
        "logs",
        "--operations",
        "GetLogEvents",
    ],
    model = _LOGS_MODEL,
)

# --probe-import names the probe's import, so without --probe-out it is refused.
aws_codegen_refusal(
    name = "refuse_probe_import_without_probe_out",
    expect = "--probe-import names the probe's import, so it needs --probe-out",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    model = _LOGS_MODEL,
    probe_out = False,
)

# Not checked here: emit_layout_probe's refusal of a module with no struct.
# The CLI cannot reach it: --operations may not be empty, and the front-end
# gives every operation a Request and a Response struct (synthesising an
# empty one where the model declares no input or output), so every module
# the CLI emits has at least two structs to probe.

export_file(
    name = "aws_codegen.sh",
    visibility = ["//negative/aws_codegen:"],
)

shell_lint(
    name = "shell_lint",
    srcs = ["aws_codegen.sh"],
    visibility = ["komira//:tests_lints"],
)

# For tests//negative/aws_codegen, which plants a golden that differs, and
# must_contain strings the module holds only non-adjacently or as the tail of
# a longer line, over a module otherwise equal to its goldens.
export_file(
    name = "logs_client_golden",
    src = "golden/logs_client.mojo",
    visibility = ["//negative/aws_codegen:"],
)

export_file(
    name = "logs_client_probe_golden",
    src = "golden/logs_client_probe.mojo",
    visibility = ["//negative/aws_codegen:"],
)
