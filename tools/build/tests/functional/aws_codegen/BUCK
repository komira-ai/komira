# Text goldens and refusals of komira//tools/build/proto-codegen:aws-client-gen,
# as check actions: `buck2 build tests//functional/aws_codegen:` runs them all
# (run_tests.sh, test 34).
#
# The CloudWatch Logs model is the pinned botocore one
# (komira//third_party/botocore, models.bzl), read from the archive at build
# time. model/ holds only this package's own inputs: a zero-byte model, tiny
# restXml models (a non-S3 one for the customization refusals, one per
# restXml refusal, one that requires a request checksum), a tiny Smithy RPC
# v2 CBOR model and a tiny awsJson model that declares SigV2. The tiny
# restJson1, S3-shaped restXml, awsQuery and ec2Query models come from
# komira//tools/build/proto-codegen/aws_rest_json, aws_rest_xml and
# aws_query (model and digest in each one's model.bzl), where their
# clients are compiled against the real runtime, which only the
# komira cell can depend on; this package holds those clients' generated
# files and welded tests to exact sets.

_LOGS_SHA256 = botocore_model("logs").sha256

# The non-S3 tiny restXml model, for the customization refusals.
_TINY_RESTXML_SHA256 = "47dc951fe9a3275e5621a62760272d6bb58fb18a56de58f0c179f793882cba05"
_LOGS_MODEL = botocore_model("logs").model
_LOGS = [
    "--model-sha256",
    _LOGS_SHA256,
    "--service",
    "logs",
]

# The caller's HttpClientConfig reaches the signed send of a generated client.
# The client builds its HttpClient inside the core, so a serving process can
# bound its outbound budget (HttpClientConfig.for_serving_ceiling) only through
# this argument. Three links, each pinned as a whole line: the constructor
# takes it with no default (`= ...` cannot match the trailing comma), stores
# the caller's value rather than one of its own, and the send passes that
# field as its second argument. send_sigv4_signed_request is in
# komira//src/komira_aws_core/aws_send.mojo; signed_request.mojo's header
# states the signature these pins assume, which the tests cell's stub
# (../mojo_aws_client/stub/komira_aws_core) keeps; all three change together.
_CONFIG_PINS = [
    "http_config: HttpClientConfig,",
    "self._http_config = http_config.copy()",
    "\n".join([
        "return send_sigv4_signed_request[Self.C](",
        "self._mk_connector,",
        "self._http_config.copy(),",
    ]),
]

# The module kci_logs needs first: GetLogEvents, without transport.
aws_codegen_golden(
    name = "logs_pure",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--pure-only",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    golden = "golden/logs_pure.mojo",
    golden_probe = "golden/logs_pure_probe.mojo",
    model = _LOGS_MODEL,
    module = "komira_aws_logs",
)

# The same operation as a client: it adds the komira_aws_core transport names,
# komira_http_client.client.HttpClientConfig and
# komira_http_core.transport.io_stream.Connector.
aws_codegen_golden(
    name = "logs_client",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvents",
        "--probe-import",
        "komira_aws_logs.komira_aws_logs",
    ],
    golden = "golden/logs_client.mojo",
    golden_probe = "golden/logs_client_probe.mojo",
    model = _LOGS_MODEL,
    module = "komira_aws_logs",
    must_contain = _CONFIG_PINS,
)

# A restJson1 client of a tiny model, client mode: URI labels (one greedy)
# after a literal query, query members (a list and a map), headers (a
# timestamp, a list and a prefix map), a JSON body, a structure payload, the
# status, a streaming blob output payload (`parse_get_thing_head`), and the
# restJson1 error builder. The model is
# komira//tools/build/proto-codegen/aws_rest_json's, where the pure-mode
# module is compiled against the real runtime and tested.
aws_codegen_golden(
    name = "tiny_rest_json_client",
    gen_args = [
        "--model-sha256",
        TINY_REST_JSON.sha256,
        "--service",
        "tiny",
        "--operations",
        "GetThing,PutThing,SetConfig",
        "--probe-import",
        "komira_aws_tiny_rest.komira_aws_tiny_rest",
    ],
    golden = "golden/tiny_rest_json_client.mojo",
    golden_probe = "golden/tiny_rest_json_client_probe.mojo",
    model = TINY_REST_JSON.model,
    module = "komira_aws_tiny_rest",
    must_contain = _CONFIG_PINS,
)

# The pure-mode client of the same model, built in the komira cell: exactly
# the package's three files were generated, with no transport.
gen_check(
    name = "tiny_rest_json_pure_scoped",
    absent = ["komira_http"],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "komira_aws_tiny_rest.mojo",
    ],
    gen = "komira//tools/build/proto-codegen/aws_rest_json:komira_aws_tiny_rest[gen]",
    present = [
        "protocol     : rest-json (restJson1)",
        "mode         : pure (no transport)",
        "operations   : GetThing, PutThing, SetConfig",
        "model sha256 : " + TINY_REST_JSON.sha256,
        "def build_get_thing_request(",
        "def parse_get_thing_head(",
    ],
)

# Its layout probe, its environment scan and its caller test are welded into
# it, and each ran and passed.
tests_check(
    name = "tiny_rest_json_pure_tests",
    expect = [
        "_layout_probe",
        "_no_env_reads",
        "test_tiny_rest_json",
    ],
    markers = "komira//tools/build/proto-codegen/aws_rest_json:komira_aws_tiny_rest[tests]",
)

aws_codegen_refusal(
    name = "refuse_empty_operations",
    expect = "--operations is MANDATORY and may not be empty",
    gen_args = _LOGS + [
        "--operations",
        "",
    ],
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_no_operations",
    expect = "--operations is MANDATORY and may not be empty",
    gen_args = _LOGS,
    model = _LOGS_MODEL,
)

aws_codegen_refusal(
    name = "refuse_unknown_operation",
    expect = "GetLogEvent",
    gen_args = _LOGS + [
        "--operations",
        "GetLogEvent",
    ],
    model = _LOGS_MODEL,
)

# A restXml client of a tiny S3-shaped model, pure mode, with the `s3`
# customization: a label after a literal query, a header, the input's root
# element in its namespace holding a scalar, a timestamp, a wrapped list
# with renamed items and a flattened list of structures, a structure payload
# in its namespace, blob (streaming and not) and string output payloads, an
# operation with no output, the response side of each, and the two `s3`
# response behaviors. The model is
# komira//tools/build/proto-codegen/aws_rest_xml's, where the same module is
# compiled against the real runtime and tested.
_TINY_XML_OPERATIONS = ["GetBlob", "GetBytes", "GetPolicy", "PutThing", "SetConfig"]

aws_codegen_golden(
    name = "restxml_pure",
    gen_args = [
        "--model-sha256",
        TINY_REST_XML.sha256,
        "--service",
        "tiny",
        "--operations",
        ",".join(_TINY_XML_OPERATIONS),
        "--pure-only",
        "--customization",
        "s3",
        "--probe-import",
        "komira_aws_tiny_xml.komira_aws_tiny_xml",
    ],
    golden = "golden/restxml_pure.mojo",
    golden_probe = "golden/restxml_pure_probe.mojo",
    model = TINY_REST_XML.model,
    module = "komira_aws_tiny_xml",
)

# The same module, built in the komira cell: exactly the package's three
# files were generated, with no transport and no JSON runtime.
gen_check(
    name = "tiny_rest_xml_pure_scoped",
    absent = [
        "komira_http",
        "komira_json",
    ],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "komira_aws_tiny_xml.mojo",
    ],
    gen = "komira//tools/build/proto-codegen/aws_rest_xml:komira_aws_tiny_xml[gen]",
    present = [
        "protocol     : rest-xml (restXml)",
        "mode         : pure (no transport)",
        "operations   : " + ", ".join(_TINY_XML_OPERATIONS),
        "model sha256 : " + TINY_REST_XML.sha256,
        "customize    : s3 (",
        "def parse_get_blob_head(",
        "if aws_xml_body_is_error(resp):",
    ],
)

# Its layout probe, its environment scan and its caller test are welded into
# it, and each ran and passed.
tests_check(
    name = "tiny_rest_xml_pure_tests",
    expect = [
        "_layout_probe",
        "_no_env_reads",
        "test_tiny_rest_xml",
    ],
    markers = "komira//tools/build/proto-codegen/aws_rest_xml:komira_aws_tiny_xml[tests]",
)

# An awsQuery client of a tiny model, pure mode: the form encoder of every
# scalar kind, a wrapped list, a flattened list whose member is renamed, a
# flattened and a wrapped map, a nested structure; the response read from
# the operation's resultWrapper element, maps included; an operation with no
# input and no output. The model is
# komira//tools/build/proto-codegen/aws_query's, where the same module is
# compiled against the real runtime and tested.
_TINY_QUERY_OPERATIONS = ["Ping", "SendThing"]

# The client adds two anonymous operations (`authtype` `none`, `auth`
# `smithy.api#noAuth`), which it sends unsigned.
_TINY_QUERY_CLIENT_OPERATIONS = ["Ping", "PingAnonymous", "PingNoAuth", "SendThing"]

aws_codegen_golden(
    name = "query_pure",
    gen_args = [
        "--model-sha256",
        TINY_QUERY.sha256,
        "--service",
        "tiny",
        "--operations",
        ",".join(_TINY_QUERY_OPERATIONS),
        "--pure-only",
        "--probe-import",
        "komira_aws_tiny_query.komira_aws_tiny_query",
    ],
    golden = "golden/query_pure.mojo",
    golden_probe = "golden/query_pure_probe.mojo",
    model = TINY_QUERY.model,
    module = "komira_aws_tiny_query",
)

# The same module, built in the komira cell: exactly the package's three
# files were generated, with no transport and no JSON runtime.
