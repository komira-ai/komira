def komira_aws_tiny_rest_host(region: String) raises -> String:
    """`tiny.<region>.amazonaws.com`.

        ⚠ REGIONAL. An empty region here would sign against a host with a
        doubled dot and fail as DNS — an error that says nothing about the
        composition that left the region unset. So it is refused by name."""
    if region.byte_length() == 0:
        raise Error(
            "komira_aws_tiny_rest_host: REFUSED an EMPTY region — this is a REGIONAL"
            " service and there is no global endpoint to fall back to."
