load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Test 56 (std_only, mojo_deps), the half that must build: a library with no
# deps passes `std_only`. negative/std_only plants a Mojo dep and a C dep.
mojo_library(
    name = "leaf",
    srcs = ["leaf/__init__.mojo"],
    conda = False,
    visibility = ["//negative/std_only:"],
)

mojo_deps(
    name = "ok",
    buck = "deps.txt",
    srcs = ["leaf/__init__.mojo"],
    std_only = ":leaf",
)
