# What script_test promises of the directory the command runs in. Run as
# `sh <this file>`, so that it needs no /bin/sh.
set -eu
here=$(pwd)
scratch=$(dirname "$here")
pkg=functional/zig_rules

# The sources are copied, writable, at their paths from the cell root.
test -f $pkg/scratch.check
test "$(cat $pkg/data/note.txt)" = note
echo changed >> $pkg/data/note.txt
test -f $pkg/data/dir/inner.txt
echo new > $pkg/data/dir/created.txt

# Executable bits are kept.
test -x $pkg/exec_probe
test ! -x $pkg/data/note.txt

# HOME, TMPDIR, XDG_CACHE_HOME and the zig global cache are in the action's
# scratch directory (the parent of the working directory), writable, and
# nothing else is in HOME.
for v in HOME TMPDIR XDG_CACHE_HOME ZIG_GLOBAL_CACHE_DIR; do
    eval "d=\${$v}"
    case "$d" in
        "$scratch"/*) ;;
        *) echo "$v=$d is not under $scratch" >&2; exit 1 ;;
    esac
    touch "$d/probe"
done
test "$(ls "$HOME" | wc -l)" = 1

# The environment the BUCK file declared; an artifact path in it is absolute.
test "$KIND" = "plain"
case "$APP" in
    /*) test -x "$APP" ;;
    *) echo "APP=$APP is not absolute" >&2; exit 1 ;;
esac
