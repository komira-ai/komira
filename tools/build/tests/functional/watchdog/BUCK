load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "mojo_watchdog_cases")

# The stand-in toolchain: the compiler (bin/mojo) and the link driver (zig)
# the cases run the wrapper against.
zig_exe(
    name = "standin",
    exec_compatible_with = LINUX_X86_64,
    src = "standin.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "runner",
    exec_compatible_with = LINUX_X86_64,
    src = "cases.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# Every process behaviour of the compile wrapper (komira//tools/build/mojo:mojo_compile)
# on the stand-in toolchain (tools/build/tests/run_tests.sh, test 28).
mojo_watchdog_cases(
    name = "cases",
    exec_compatible_with = LINUX_X86_64,
    runner = ":runner",
    standin = ":standin",
)
