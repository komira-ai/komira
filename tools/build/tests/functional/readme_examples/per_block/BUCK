load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The README's examples are a welded test, `[tests][readme]` (test 38): each
# example is a program of its own, so two examples declaring the same names
# (`twice`, `said`) and importing the same name both build and run. The
# target must build.
mojo_library(
    name = "per_block",
    srcs = [
        "__init__.mojo",
        "greet.mojo",
    ],
)
