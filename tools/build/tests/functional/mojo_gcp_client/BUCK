load("@komira//tools/build/cloud:gcp.bzl", "mojo_gcp_client")
load("@komira//tools/build/mojo:proto.bzl", "proto_srcs")
load(":defs.bzl", "gen_check", "tests_check")

# mojo_gcp_client (tools/build/cloud/gcp.bzl) over a fixture API, with the stub
# komira_proto_codec of ../proto as the runtime. `buck2 build
# tests//functional/mojo_gcp_client:` builds each library, which runs its welded
# tests (the generated layout probe first), each gen_check and each
# tests_check. proto_tests.sh (sourced by run_tests.sh) builds this package
# and runs each target of ../../negative/mojo_gcp_client as an expect_red.

# The files the API imports, as a googleapis package would be vendored.
# audit.proto is in the closure and imported by nothing.
proto_srcs(
    name = "shop_deps",
    visibility = ["//negative/mojo_gcp_client:"],
    srcs = [
        "example/shop/v1/audit.proto",
        "example/shop/v1/item.proto",
    ],
)

# One method, messages only: the closure of GetItem's request and response,
# across shop.proto and the bundled item.proto.
mojo_gcp_client(
    name = "komira_gcp_shop",
    visibility = ["//negative/mojo_gcp_client:"],
    bundle_only = ["example/shop/v1/item.proto"],
    bundle_proto_deps = True,
    messages_only = True,
    methods = ["ShopService.GetItem"],
    proto_deps = [":shop_deps"],
    protos = ["example/shop/v1/shop.proto"],
    test_srcs = ["test_shop.mojo"],
    deps = ["//functional/proto:komira_proto_codec"],
)

# The absence check: DeleteItem and what only it reaches are not emitted,
# nor the service, nor a module for audit.proto.
gen_check(
    name = "komira_gcp_shop_scoped",
    absent = [
        "DeleteItem",
        "ItemTombstone",
        "ShopService",
        "AuditRecord",
    ],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "item.mojo",
        "shop.mojo",
    ],
    gen = ":komira_gcp_shop[gen]",
    present = [
        "struct GetItemRequest(",
        "struct GetItemResponse(",
        "struct Item(",
        "from komira_gcp_shop.item import Item",
        'size_of[shop.GetItemRequest]()',
        'size_of[item.Item]()',
    ],
)

# Two roots, one of them exact (leading `.`): the rule joins them with `+`.
mojo_gcp_client(
    name = "komira_gcp_shop_roots",
    bundle_only = ["example/shop/v1/item.proto"],
    bundle_proto_deps = True,
    messages_only = True,
    proto_deps = [":shop_deps"],
    protos = ["example/shop/v1/shop.proto"],
    roots = [
        "GetItemRequest",
        ".example.shop.v1.Item",
    ],
    deps = ["//functional/proto:komira_proto_codec"],
)

gen_check(
    name = "komira_gcp_shop_roots_scoped",
    absent = [
        "GetItemResponse",
        "DeleteItem",
        "ItemTombstone",
        "ShopService",
    ],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "item.mojo",
        "shop.mojo",
    ],
    gen = ":komira_gcp_shop_roots[gen]",
    present = [
        "struct GetItemRequest(",
        "struct Item(",
    ],
)

# The layout probe is welded into each library, not only generated: the
# libraries ran exactly these tests, and each passed. gen_check reads `[gen]`
# and cannot see the weld.
tests_check(
    name = "komira_gcp_shop_tests",
    expect = [
        "_layout_probe",
        "test_shop",
    ],
    markers = ":komira_gcp_shop[tests]",
)

tests_check(
    name = "komira_gcp_shop_roots_tests",
    expect = ["_layout_probe"],
    markers = ":komira_gcp_shop_roots[tests]",
)

# "grpc" with messages only: the plugin branches on the protocol only for
# service code, so the messages generate and compile as under "rest", and no
# gRPC import is written.
mojo_gcp_client(
    name = "komira_gcp_shop_grpc_messages",
    bundle_only = ["example/shop/v1/item.proto"],
    bundle_proto_deps = True,
    messages_only = True,
    methods = ["ShopService.GetItem"],
    proto_deps = [":shop_deps"],
    protocol = "grpc",
    protos = ["example/shop/v1/shop.proto"],
    deps = ["//functional/proto:komira_proto_codec"],
)

gen_check(
    name = "komira_gcp_shop_grpc_messages_scoped",
    absent = [
        "komira_grpc",
        "GrpcClient",
        "ShopService",
    ],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "item.mojo",
        "shop.mojo",
    ],
    gen = ":komira_gcp_shop_grpc_messages[gen]",
    present = [
        "struct GetItemRequest(",
        "struct GetItemResponse(",
        "struct Item(",
    ],
)

# `protocol = "grpc"` with a service: the client of
# komira//tools/build/proto-codegen/gcp_grpc, compiled there against the real
# komira_grpc and komira_gcp_core (which only the komira cell can depend on),
# one method of each streaming shape. Exactly the package's files were
# generated; the client takes a GcpTokenSource, runs the token hook in every
# method and raises a gRPC status through komira_gcp_core. Its tiny.mojo is
# byte for byte the golden of ../proto_codegen (tiny_grpc_gcp), which is
# generated from a second copy of the proto in the tests cell; this check is
# what keeps the two copies the same API.
_TINY_GRPC = "komira//tools/build/proto-codegen/gcp_grpc:komira_gcp_tiny_grpc"

gen_check(
    name = "komira_gcp_tiny_grpc_service",
    absent = [
        "P: Protocol",
        "ProtocolConnect",
    ],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "tiny.mojo",
    ],
    gen = _TINY_GRPC + "[gen]",
    identical = {"tiny.mojo": "//functional/proto_codegen:tiny_grpc_gcp_golden"},
    present = [
        "from komira_gcp_core import GcpTokenSource, gcp_grpc_status_error",
        "struct TinyServiceClient[C: Connector, T: GcpTokenSource](Movable, Deinitable):",
        "def get_thing[RT: Runtime]",
        "def watch_things[RT: Runtime]",
        "def upload_things[RT: Runtime]",
        "def sync_things[RT: Runtime]",
        "opts.raw_metadata.set(String(\"authorization\"), String(\"Bearer \") + bearer)",
    ],
)

# The client ran exactly these tests, and each passed: the layout probe and
# the test of the token hook and the status mapping.
tests_check(
    name = "komira_gcp_tiny_grpc_tests",
    expect = [
        "_layout_probe",
        "test_tiny_grpc",
    ],
    markers = _TINY_GRPC + "[tests]",
)

# `protocol = "rest"` with a service that declares no
# `(google.api.default_host)`: the client of
# komira//tools/build/proto-codegen/gcp_rest, compiled there against the real
# komira_http_client and komira_gcp_core. Exactly the package's files were
# generated; the client starts with no host (never a placeholder one) and
# every method raises the named refusal until `set_rest_host` names one.
_NOHOST_REST = "komira//tools/build/proto-codegen/gcp_rest:komira_gcp_nohost_rest"

gen_check(
    name = "komira_gcp_nohost_rest_service",
    absent = [
        "localhost",
        "gcp_grpc_status_error",
    ],
    files = [
        "__init__.mojo",
        "_layout_probe.mojo",
        "nohost.mojo",
    ],
    gen = _NOHOST_REST + "[gen]",
    present = [
        "from komira_gcp_core import GcpTokenSource, gcp_status_error",
        "struct NoHostServiceClient[C: Connector, T: GcpTokenSource](Movable, Deinitable):",
        "self._rest_host = String(\"\")",
        ": no REST host: example.nohost.v1.NoHostService declares no google.api.default_host; call set_rest_host(host) before sending",
        "self._rest_require_host(String(\"get_thing\"))",
    ],
)

# The client ran exactly these tests, and each passed: the layout probe and
# the test of the no-host refusal and of `set_rest_host`.
tests_check(
    name = "komira_gcp_nohost_rest_tests",
    expect = [
        "_layout_probe",
        "test_nohost_rest",
    ],
    markers = _NOHOST_REST + "[tests]",
)

# shop.proto as a proto_deps entry, so ../../negative/mojo_gcp_client can bundle
# it and generate its service.
proto_srcs(
    name = "shop_api",
    visibility = ["//negative/mojo_gcp_client:"],
    srcs = ["example/shop/v1/shop.proto"],
    proto_deps = [":shop_deps"],
)

# watch.proto, a streaming method, as a proto_deps entry, so
# ../../negative/mojo_gcp_client can list it in a "rest" client and be refused.
proto_srcs(
    name = "watch_api",
    visibility = ["//negative/mojo_gcp_client:"],
    srcs = ["example/shop/v1/watch.proto"],
    proto_deps = [":shop_deps"],
)
