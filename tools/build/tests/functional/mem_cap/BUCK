load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The memory cap of a test run (test 45; tools/build/mojo/mem_cap.sh). Every
# target here builds; the twins that must go red are in
# tests//negative/mem_cap.

# A test holding 256 MiB for 2 s passes under a 1024 MiB cap: the cap leaves a test
# that stays under it alone. Twin: negative:lib_over_cap.
mojo_library(
    name = "lib_under_cap",
    srcs = [
        "__init__.mojo",
        "chunks.mojo",
    ],
    conda = False,
    import_name = "memcap",
    test_memory_cap_mib = 1024,
    test_srcs = ["tests/test_holds_256mib.mojo"],
    # negative:test_unbounded compiles against it.
    visibility = ["//negative/mem_cap/..."],
)
