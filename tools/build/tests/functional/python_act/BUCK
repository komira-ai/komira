load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# The process behaviour of `python_act` (tools/build/python_act/python_act.zig):
# `dist` over archives built in memory and a stand-in interpreter (fake.zig),
# by messages, exit statuses and the tree written. A driver test: python_act is
# a built tool it runs by absolute path. The unit tests of its parts are
# tools/build/python_act:python_act_unit; every python_dist target runs through it too.

zig_exe(
    name = "fake",
    exec_compatible_with = LINUX_X86_64,
    src = "fake.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_test(
    name = "driver",
    exec_compatible_with = LINUX_X86_64,
    exec_tools = {
        "FAKE": ":fake",
        "PYTHON_ACT": "komira//tools/build/python_act:python_act",
    },
    src = "driver_test.zig",
    deps = [
        "komira//tools/build/node_tools:node_tartest",
        "tests//functional/driver_kit:driver_kit",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)
