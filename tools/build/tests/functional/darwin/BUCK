load("@komira//tools/build/lint:defs.bzl", "doc_tree", "shell_lint")
load(":cases.bzl", "darwin_properties_cases")

# Fails loading this package if `darwin_properties_refusal` gets any case in
# cases.bzl wrong (functional/darwin/check.sh runs `buck2 targets tests//functional/darwin:`).
darwin_properties_cases()

load(":census.bzl", "darwin_host_census")

# The host identities the macOS workers report (see census.bzl). Only for
# `--target-platforms komira//tools/build/platforms:darwin-arm64`.
darwin_host_census(
    name = "host_census",
    target_compatible_with = ["prelude//os/constraints:macos"],
)

shell_lint(
    name = "shell_lint",
    srcs = ["check.sh"],
    visibility = ["komira//:tests_lints"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["tests//:doc_tree"],
)
