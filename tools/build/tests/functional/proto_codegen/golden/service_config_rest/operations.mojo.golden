# REST/JSON client for `mixin.v1.Operations`.
struct OperationsClient[C: Connector, T: GcpTokenSource](Movable, Deinitable):
    """The generated REST/JSON client for `Operations`, parametric over the HTTP
        connector `C` and the access-token source `T`.

        Every request carries `Authorization: Bearer <token>` from `T` (a
        `komira_gcp_core.GcpTokenSource`): the client reads no environment
        and holds no credential of its own.

        The connector has one role: the `HttpClient[C]` passed to `__init__`
        owns it, and every method sends through that client's
        `send_buffered`, which checks the URL scheme against the connector,
        sets the dial host (SNI) per request and goes through the client's
        connection pool.
        No method takes a connector of its own.

        The caller owns the time budget: build the `HttpClient[C]` with the
        `HttpClientConfig` that fits the process. A process serving requests
        under a platform deadline (Cloud Run, Lambda) builds it from
        `HttpClientConfig.for_serving_ceiling(ceiling)`, not
        `HttpClient.with_defaults`, whose 600s budget can outlive the
        container. This client applies no ceiling of its own."""

    var _client: HttpClient[Self.C]
    """The HTTP transport."""

    var _token_source: Self.T
    """Where each request's bearer token comes from."""

    var _default_headers: HeaderMap
    """Headers merged into every request. Empty unless given."""

    var _rest_host: String
    """The host the request URLs target: it drives BOTH the dial DNS
        target and the `Host:` header. Starts at the API's service
        configuration `name`, `fixture.googleapis.com`; `set_rest_host` replaces it."""

    var _rest_port: UInt16
    """The port the request URLs name; 0, the default, is the scheme's."""

    var _rest_plaintext: Bool
    """Whether the request URLs are `http` rather than `https`. False
        unless `set_rest_endpoint` says otherwise."""

    def __init__(out self, var client: HttpClient[Self.C], var token_source: Self.T):
        """Construct with no default headers."""
        self._client = client^
        self._token_source = token_source^
        self._default_headers = HeaderMap()
        self._rest_host = String("fixture.googleapis.com")
        self._rest_port = UInt16(0)
        self._rest_plaintext = False

    def __init__(
        out self,
        var client: HttpClient[Self.C],
        var token_source: Self.T,
        var default_headers: HeaderMap,
    ):
        """Construct with default headers merged into every request."""
        self._client = client^
        self._token_source = token_source^
        self._default_headers = default_headers^
        self._rest_host = String("fixture.googleapis.com")
        self._rest_port = UInt16(0)
        self._rest_plaintext = False

    def set_rest_host(mut self, var host: String):
        """Point the request URLs at `host` (a regional or private endpoint,
            or a test server). The URL host feeds BOTH the dial-target DNS
            resolution and the injected `Host:` header. An empty host makes
            every method refuse to send."""
        self._rest_host = host^

    def set_rest_endpoint(mut self, var host: String, port: UInt16, plaintext: Bool):
        """Point the request URLs at an endpoint other than the service's
            public one: `host`, `port` (0 for the scheme's own) and, with
            `plaintext`, `http` instead of `https`, which is how an emulator
            serves. The connector must match the scheme: the `HttpClient`
            refuses an `http` URL over a TLS connector and an `https` one over
            a plaintext connector. The bearer token is sent either way."""
        self._rest_host = host^
        self._rest_port = port
        self._rest_plaintext = plaintext

    def _rest_require_host(self, method: String) raises:
        """Raise, naming the method, when no host is set."""
        if self._rest_host.byte_length() == 0:
            raise Error(String("OperationsClient.") + method + String(": no REST host: the host was set empty (the API's service configuration name is fixture.googleapis.com); call set_rest_host(host) with a host before sending"))

    def _rest_apply_default_headers(self, mut headers: HeaderMap) raises:
        """Merge the per-client default headers into `headers`."""
        var _rest_i = 0
        while _rest_i < self._default_headers.len():
            var _rest_e = self._default_headers.entry_at(_rest_i)
            headers.append(_rest_e.name, _rest_e.value)
            _rest_i += 1

    def get_operation[RT: Runtime](mut self, req: GetOperationRequest, mut reactor: Reactor[RT.Sink]) raises -> Operation:
        """GET `/v9/{name=projects/*/operations/*}`, `/v9/{name=folders/*/operations/*}` — REST/JSON, to the first path the request's values match."""
        self._rest_require_host(String("get_operation"))
        var path = String("")
        # Only a path variable that does not match this binding raises here.
        try:
            path += String("/v9")
            path += String("/")
            path += _rest_path_var(_rest_to_str(req.name), String("projects/*/operations/*"), String("name"))
        except:
            path = String("")
        if path.byte_length() == 0:
            # Only a path variable that does not match this binding raises here.
            try:
                path += String("/v9")
                path += String("/")
                path += _rest_path_var(_rest_to_str(req.name), String("folders/*/operations/*"), String("name"))
            except:
                path = String("")
        if path.byte_length() == 0:
            raise Error(String("REST method GetOperation: the request matches none of its paths: /v9/{name=projects/*/operations/*}, /v9/{name=folders/*/operations/*}"))
        var url: Url
        if self._rest_plaintext:
            url = Url.http(self._rest_host.copy(), self._rest_port, path^)
        else:
            url = Url.https(self._rest_host.copy(), self._rest_port, path^)
        var headers = HeaderMap()
        self._rest_apply_default_headers(headers)
        headers.append(String("Authorization"), String("Bearer ") + self._token_source.access_token())
        var req_http = build_get_request(url^, headers^)
        var resp = self._client.send_buffered[RT, EmptyBody](req_http^, reactor)
        var status_int = Int(resp.status)
        var resp_bytes = resp.body.take_bytes()
        if status_int < 200 or status_int >= 300:
            raise gcp_status_error(String("GET"), String("GetOperation"), status_int, resp_bytes)
        var resp_text = String(unsafe_from_utf8=Span(resp_bytes))
        if resp_text.byte_length() == 0:
            resp_text = String("{}")
        return decode_json_lenient[Operation](resp_text)

