        or (b >= 0x61 and b <= 0x7A)  # a-z
        or b == 0x2D  # -
        or b == 0x2E  # .
        or b == 0x5F  # _
        or b == 0x7E  # ~
    )
    if unreserved:
        out += chr(Int(b))
    else:
        out += String("%")
