        if status_int < 200 or status_int >= 300:
            raise gcp_status_error(String("GET"), String("GetRoot"), status_int, resp_bytes)
        var resp_text = String(unsafe_from_utf8=Span(resp_bytes))
        if resp_text.byte_length() == 0:
            resp_text = String("{}")
        return decode_json_lenient[Thing](resp_text)

