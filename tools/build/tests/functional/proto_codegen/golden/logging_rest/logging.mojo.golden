    """The host the request URLs target. Defaults to the offline
        `localhost` placeholder; a live caller sets the real public host via
        `set_rest_host` (it drives BOTH the dial DNS target and the `Host:`
        header)."""

    def __init__(out self, var client: HttpClient[Self.C], var token_source: Self.T):
        """Construct with no default headers."""
        self._client = client^
        self._token_source = token_source^
        self._default_headers = HeaderMap()
        self._rest_host = String("localhost")

    def __init__(
        out self,
        var client: HttpClient[Self.C],
        var token_source: Self.T,
        var default_headers: HeaderMap,
    ):
        """Construct with default headers merged into every request."""
        self._client = client^
        self._token_source = token_source^
        self._default_headers = default_headers^
        self._rest_host = String("localhost")

    def set_rest_host(mut self, var host: String):
        """Point the request URLs at a real public host (e.g.
            `logging.googleapis.com`) for a LIVE dial. The URL host feeds BOTH
            the dial-target DNS resolution and the injected `Host:` header;
            the default `localhost` is the offline scripted-loopback path."""
        self._rest_host = host^

    def _rest_apply_default_headers(self, mut headers: HeaderMap) raises:
        """Merge the per-client default headers into `headers`."""
        var _rest_i = 0
        while _rest_i < self._default_headers.len():
            var _rest_e = self._default_headers.entry_at(_rest_i)
            headers.append(_rest_e.name, _rest_e.value)
            _rest_i += 1

    def list_log_entries[RT: Runtime](mut self, req: ListLogEntriesRequest, mut reactor: Reactor[RT.Sink]) raises -> ListLogEntriesResponse:
        """POST `/v2/entries:list` — REST/JSON."""
        var path = String("")
        path += String("/v2")
        path += String("/entries")
        path += String(":list")
        var url = Url.https(self._rest_host.copy(), UInt16(0), path^)
        var headers = HeaderMap()
        self._rest_apply_default_headers(headers)
        headers.append(String("Authorization"), String("Bearer ") + self._token_source.access_token())
        headers.append(String("Content-Type"), String("application/json"))
        var body_text = encode_json(req)
        var body = BytesBody.from_str(body_text)
        var req_http = build_request_with_body[BytesBody](
            HttpMethod.post(), url^, headers^, body^,
        )
        var resp = self._client.send_buffered[RT, BytesBody](req_http^, reactor)
        var status_int = Int(resp.status)
        var resp_bytes = resp.body.take_bytes()
        if status_int < 200 or status_int >= 300:
            raise gcp_status_error(String("POST"), String("ListLogEntries"), status_int, resp_bytes)
        var resp_text = String(unsafe_from_utf8=Span(resp_bytes))
        if resp_text.byte_length() == 0:
            resp_text = String("{}")
        return decode_json_lenient[ListLogEntriesResponse](resp_text)

    def list_logs[RT: Runtime](mut self, req: ListLogsRequest, mut reactor: Reactor[RT.Sink]) raises -> ListLogsResponse:
        """GET `/v2/{parent=projects/*}/logs` — REST/JSON."""
        var path = String("")
        path += String("/v2")
        path += String("/")
        path += _rest_path_var(_rest_to_str(req.parent), String("projects/*"), String("parent"))
        path += String("/logs")
        var query = String("")
        for _rest_v in req.resource_names:
            if query.byte_length() > 0:
                query += String("&")
            query += String("resourceNames=") + _rest_pct_encode(_rest_to_str(_rest_v))
        if req.page_size != 0:
            if query.byte_length() > 0:
                query += String("&")
            query += String("pageSize=") + _rest_pct_encode(_rest_to_str(req.page_size))
        if req.page_token.byte_length() > 0:
            if query.byte_length() > 0:
                query += String("&")
            query += String("pageToken=") + _rest_pct_encode(_rest_to_str(req.page_token))
        var url = Url.https(self._rest_host.copy(), UInt16(0), path^)
        url.query = query^
        var headers = HeaderMap()
        self._rest_apply_default_headers(headers)
        headers.append(String("Authorization"), String("Bearer ") + self._token_source.access_token())
        var req_http = build_get_request(url^, headers^)
        var resp = self._client.send_buffered[RT, EmptyBody](req_http^, reactor)
        var status_int = Int(resp.status)
        var resp_bytes = resp.body.take_bytes()
        if status_int < 200 or status_int >= 300:
            raise gcp_status_error(String("GET"), String("ListLogs"), status_int, resp_bytes)
        var resp_text = String(unsafe_from_utf8=Span(resp_bytes))
        if resp_text.byte_length() == 0:
            resp_text = String("{}")
        return decode_json_lenient[ListLogsResponse](resp_text)

