def _rest_bool_str(b: Bool) -> String:
    """Stringify a proto `bool` for the URL as proto3-JSON lowercase
    `true`/`false`. Mojo's `String(Bool)` yields `True`/`False`, which is
    wrong on the wire — proto3 JSON mandates lowercase."""
