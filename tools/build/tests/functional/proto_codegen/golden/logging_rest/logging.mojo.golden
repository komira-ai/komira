def _rest_hex_upper(nibble: UInt8) -> String:
    """One uppercase hex digit for a 4-bit nibble."""
    if nibble < 10:
        return chr(Int(0x30 + nibble))
    return chr(Int(0x41 + (nibble - 10)))


