load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load(":defs.bzl", "proto_codegen_golden", "proto_codegen_goldens", "proto_codegen_rest_helpers")

# protoc-gen-mojo's options, checked as build actions: `buck2 build
# tests//functional/proto_codegen:all` runs every case (defs.bzl).
#
# TODO: no gate builds this package yet: run_tests.sh has no `tests//...`
# build, and protoc-gen-mojo's own build does not depend on it. The next
# change in the serialization order of run_tests.sh (the Google client rule,
# which factors the generation half out of proto.bzl) wires
# `tests//functional/proto_codegen:all` into its proto functional item.
#
# The corpus is shaped like the googleapis logging API: logging.proto's
# service has three methods, log_entry.proto's LogEntry carries an Any, a
# Struct and a Timestamp, and monitored_resource.proto declares both what a
# log query needs (MonitoredResource) and what it does not
# (MonitoredResourceDescriptor, LabelDescriptor). Maps: LogEntry reaches
# LogSplit through a map value only; WriteLogEntriesRequest (pruned by a
# log query) and ListLogEntriesRequest.Hint (declared, used by no field)
# hold maps of MonitoredResourceDescriptor, so a map entry outliving its
# message would import that type. audit/v1/audit.proto, generated only by
# the ambiguity refusals, declares a second LogEntry and ListLogEntries;
# nested/example/logging/v1/nested_entry.proto declares a LogEntry whose
# fully-qualified name ends in the logging one's (fq_root_is_exact).
#
# Options are comma-joined `key=value` tokens, as the Mojo proto rules pass
# them; the items of `roots=` and `methods=` are joined with `+`.

# The REST fixtures (google/, shapes/, refuse/) have their own cases below.
_SRCS = glob(["corpus/example/**/*.proto", "corpus/nested/**/*.proto"])

_ALL = [
    "example/logging/v1/logging.proto",
    "example/logging/v1/log_entry.proto",
    "example/logging/v1/monitored_resource.proto",
]

_PREFIX = "package_prefix=komira_example_logging"

# Not on the read path of a log query: what a pruned module must not hold.
_UNUSED = [
    "WriteLogEntries",
    "MonitoredResourceDescriptor",
    "LabelDescriptor",
    "ListMonitoredResourceDescriptors",
]

# No scope: every type and method of the corpus. The baseline the pruned
# cases are read against: everything they leave out is here.
proto_codegen_golden(
    name = "everything",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/everything/*.golden"]),
    options = _PREFIX,
    present = _UNUSED,
)

# TWO roots, messages only: the closure of the two messages of the read,
# through LogEntry into MonitoredResource and the Any, Struct and Timestamp
# of komira_wkt. No service, nothing of _UNUSED.
proto_codegen_golden(
    name = "two_roots",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/two_roots/*.golden"]),
    options = _PREFIX + ",roots=ListLogEntriesRequest+ListLogEntriesResponse,messages_only=true",
    absent = _UNUSED + ["LoggingService"],
    present = [
        "struct ListLogEntriesRequest",
        "struct ListLogEntriesResponse",
        "struct LogEntry",
        "struct MonitoredResource",
        "struct LogSeverity",
        "Any",
    ],
)

# One method: the service keeps ListLogEntries alone, and the types are the
# closure of its request and response.
proto_codegen_golden(
    name = "one_method",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method/*.golden"]),
    options = _PREFIX + ",methods=LoggingService.ListLogEntries",
    absent = _UNUSED,
    present = [
        "LoggingService",
        "ListLogEntries",
        "struct LogEntry",
    ],
)

# TWO methods, `+`-joined: the service keeps both, and the closure of the
# second brings MonitoredResourceDescriptor and LabelDescriptor back.
proto_codegen_golden(
    name = "two_methods",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/two_methods/*.golden"]),
    options = _PREFIX + ",methods=ListLogEntries+LoggingService.ListMonitoredResourceDescriptors",
    absent = ["WriteLogEntries"],
    present = [
        "def list_log_entries",
        "def list_monitored_resource_descriptors",
        "struct MonitoredResourceDescriptor",
        "struct LabelDescriptor",
    ],
)

# The layout probe: one more file, a size_of per emitted struct.
proto_codegen_golden(
    name = "layout_probe",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/layout_probe/*.golden"]),
    options = _PREFIX + ",roots=ListLogEntriesResponse,messages_only=true,layout_probe=true",
    absent = _UNUSED,
    present = ["size_of[log_entry.LogEntry]()"],
)

# One method, messages only: one_method's types, without the service.
proto_codegen_golden(
    name = "one_method_messages_only",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method_messages_only/*.golden"]),
    options = _PREFIX + ",methods=ListLogEntries,messages_only=true",
    absent = _UNUSED + ["LoggingService", "list_log_entries"],
    present = [
        "struct ListLogEntriesRequest",
        "struct ListLogEntriesResponse",
        "struct LogEntry",
    ],
)

# `messages_only=false` is the default: one_method's output, service kept.
proto_codegen_golden(
    name = "one_method_messages_only_false",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method/*.golden"]),
    options = _PREFIX + ",methods=ListLogEntries,messages_only=false",
    absent = _UNUSED,
    present = ["LoggingService", "def list_log_entries"],
)

# Messages only, nothing pruned: every type of the corpus, no service.
proto_codegen_golden(
    name = "messages_only",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/messages_only/*.golden"]),
    options = _PREFIX + ",messages_only=true",
    absent = ["LoggingService", "def list_log_entries", "def write_log_entries"],
    present = [
        "struct WriteLogEntriesRequest",
        "struct MonitoredResourceDescriptor",
        "struct LabelDescriptor",
    ],
)

# Fully-qualified names, leading `.` included, select as the bare ones do.
proto_codegen_golden(
    name = "fq_method",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method/*.golden"]),
    options = _PREFIX + ",methods=.example.logging.v1.LoggingService.ListLogEntries",
    absent = _UNUSED,
    present = ["def list_log_entries"],
)

proto_codegen_golden(
    name = "fq_root",
    srcs = _SRCS,
    generate = [
        "example/logging/v1/log_entry.proto",
        "example/logging/v1/monitored_resource.proto",
    ],
    golden = glob(["golden/fq_root/*.golden"]),
    options = _PREFIX + ",roots=.example.logging.v1.LogEntry",
    absent = _UNUSED,
    present = ["struct LogEntry", "struct LogSplit", "struct MonitoredResource"],
)

# A leading `.` makes a name fully qualified: it selects the one type it
# spells, never a type it is a dotted suffix of.
# nested/example/logging/v1/nested_entry.proto declares
# `.nested.example.logging.v1.LogEntry`, which `.example.logging.v1.LogEntry`
# is a suffix of. Each root selects its own LogEntry: fq_root's closure,
# plus the nested file (generated, so it must keep a type: its LogEntry is
# the second root). Matched as a suffix, the first root is refused as
# ambiguous, and "qualify it" cannot be done: it already is.
proto_codegen_golden(
    name = "fq_root_is_exact",
    srcs = _SRCS,
    generate = [
        "example/logging/v1/log_entry.proto",
        "example/logging/v1/monitored_resource.proto",
        "nested/example/logging/v1/nested_entry.proto",
    ],
    golden = glob(["golden/fq_root/*.golden"]) + glob(["golden/fq_root_is_exact/*.golden"]),
    options = _PREFIX + ",roots=.example.logging.v1.LogEntry+.nested.example.logging.v1.LogEntry",
    absent = _UNUSED,
    present = ["struct LogEntry", "struct LogSplit", "struct MonitoredResource", "var note"],
)

# ---- the rest route ----
#
# `default_protocol=rest` is a different entry into the plugin (the http
# annotations are recovered from the request bytes, and every kept service
# is pre-validated). This corpus carries no `(google.api.http)` annotation,
# so a rest target fails on any service it keeps, and scoping is what
# decides which.

# Scoped to one method's messages: one_method_messages_only's output, byte
# for byte. No service is kept, so nothing needs an annotation. Scoping
# ignored on this route would keep LoggingService and be refused, or emit
# _UNUSED.
proto_codegen_golden(
    name = "rest_one_method_messages_only",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method_messages_only/*.golden"]),
    options = _PREFIX + ",default_protocol=rest,methods=ListLogEntries,messages_only=true",
    absent = _UNUSED + ["LoggingService"],
    present = [
        "struct ListLogEntriesRequest",
        "struct ListLogEntriesResponse",
        "struct LogEntry",
    ],
)

# The kept service is still validated, and only its kept method is: the
# error names ListLogEntries, not WriteLogEntries (the first method of the
# unscoped service). `--mojo_out: ` is protoc's prefix for the plugin's own
# error, which the emitter's panic backstop does not produce.
proto_codegen_golden(
    name = "refuse_rest_unannotated_kept_method",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "--mojo_out: protoc-gen-mojo: service `LoggingService` method `ListLogEntries` has no `(google.api.http)` annotation",
    options = _PREFIX + ",default_protocol=rest,methods=ListLogEntries",
)

# A leading `.` is not a bare suffix: `.LogEntry` names a LogEntry declared
# in no package, and there is none.
proto_codegen_golden(
    name = "refuse_dotted_suffix",
    srcs = _SRCS,
    generate = [
        "example/logging/v1/log_entry.proto",
        "example/logging/v1/monitored_resource.proto",
    ],
    expect_error = "root `.LogEntry` is not declared in the files to generate",
    options = _PREFIX + ",roots=.LogEntry",
)

# A map entry is kept only beside its own message. ListLogEntriesRequest
# is reached and its nested Hint is not, so Hint's map entry goes, and
# with it the import of its value, MonitoredResourceDescriptor, whose file
# is not even generated here.
proto_codegen_golden(
    name = "nested_map_entry_pruned",
    srcs = _SRCS,
    generate = ["example/logging/v1/logging.proto"],
    golden = glob(["golden/nested_map_entry_pruned/*.golden"]),
    options = _PREFIX + ",roots=ListLogEntriesRequest",
    absent = ["monitored_resource", "MonitoredResourceDescriptor", "Hint"],
    present = ["struct ListLogEntriesRequest"],
)

# ---- refusals ----

# A token without `=`: the second root of a `,`-joined list.
proto_codegen_golden(
    name = "refuse_comma_list",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `ListLogEntriesResponse` is not `key=value`",
    options = _PREFIX + ",roots=ListLogEntriesRequest,ListLogEntriesResponse",
)

# A bare flag, which once read as nothing.
proto_codegen_golden(
    name = "refuse_bare_flag",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `messages_only` is not `key=value`",
    options = _PREFIX + ",messages_only",
)

proto_codegen_golden(
    name = "refuse_unknown_key",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "unknown option `root`",
    options = _PREFIX + ",root=ListLogEntriesRequest",
)

proto_codegen_golden(
    name = "refuse_unknown_root",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "root `ListLogEntryRequest` is not declared in the files to generate",
    options = _PREFIX + ",roots=ListLogEntryRequest",
)

proto_codegen_golden(
    name = "refuse_unknown_method",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "method `LoggingService.TailLogEntries` is not declared in the files to generate",
    options = _PREFIX + ",methods=LoggingService.TailLogEntries",
)

proto_codegen_golden(
    name = "refuse_empty_item",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "has an empty item",
    options = _PREFIX + ",roots=ListLogEntriesRequest++ListLogEntriesResponse",
)

proto_codegen_golden(
    name = "refuse_repeated_key",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `roots` is given twice",
    options = _PREFIX + ",roots=ListLogEntriesRequest,roots=ListLogEntriesResponse",
)

# The closure reaches LogEntry, whose file is not generated.
proto_codegen_golden(
    name = "refuse_ungenerated_reach",
    srcs = _SRCS,
    generate = ["example/logging/v1/logging.proto"],
    expect_error = "`.example.logging.v1.LogEntry` is reachable from",
    options = _PREFIX + ",roots=ListLogEntriesResponse",
)

# A generated file the closure does not reach: nothing of log_entry.proto
# or monitored_resource.proto is reachable from ListLogEntriesRequest.
proto_codegen_golden(
    name = "refuse_unreached_file",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "example/logging/v1/log_entry.proto emits nothing",
    options = _PREFIX + ",roots=ListLogEntriesRequest",
)

# A suffix names a type only at a `.` boundary: `LogEntriesRequest` is not
# `ListLogEntriesRequest`.
proto_codegen_golden(
    name = "refuse_partial_name",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "root `LogEntriesRequest` is not declared in the files to generate",
    options = _PREFIX + ",roots=LogEntriesRequest",
)

# audit.proto declares a second LogEntry and a second ListLogEntries.
proto_codegen_golden(
    name = "refuse_ambiguous_root",
    srcs = _SRCS,
    generate = _ALL + ["example/audit/v1/audit.proto"],
    expect_error = "root `LogEntry` is ambiguous",
    options = _PREFIX + ",roots=LogEntry",
)

proto_codegen_golden(
    name = "refuse_ambiguous_method",
    srcs = _SRCS,
    generate = _ALL + ["example/audit/v1/audit.proto"],
    expect_error = "method `ListLogEntries` is ambiguous",
    options = _PREFIX + ",methods=ListLogEntries",
)

# An empty token, between two commas.
proto_codegen_golden(
    name = "refuse_empty_token",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `` is not `key=value`",
    options = _PREFIX + ",,messages_only=true",
)

proto_codegen_golden(
    name = "refuse_non_boolean",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `messages_only` must be `true` or `false`, not `yes`",
    options = _PREFIX + ",messages_only=yes",
)

proto_codegen_golden(
    name = "refuse_empty_value",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `package_prefix` has an empty value",
    options = "package_prefix=",
)

# protoc-gen-mojo-db implements none of the scoping options.
[
    proto_codegen_golden(
        name = "refuse_db_" + key,
        srcs = _SRCS,
        generate = _ALL,
        expect_error = "protoc-gen-mojo-db does not implement roots, methods, messages_only or layout_probe",
        options = _PREFIX + "," + opt,
        plugin = "mojo-db",
    )
    for key, opt in [
        ("roots", "roots=LogEntry"),
        ("methods", "methods=ListLogEntries"),
        ("messages_only", "messages_only=true"),
        ("layout_probe", "layout_probe=true"),
    ]
]

# ---- REST clients: path templates, query fields and refusals ---------------
# corpus/google/api/annotations.proto declares the `(google.api.http)` option
# every REST fixture imports.

_ANNOTATIONS = "corpus/google/api/annotations.proto"

# The Cloud Logging calls a log reader makes: a custom-verb literal path
# (POST /v2/entries:list), a `{parent=projects/*}` capture and a repeated
# query field. The REST client imports komira_gcp_core (its token source and
# its google.rpc.Status error mapper).
proto_codegen_golden(
    name = "logging_rest",
    srcs = [
        _ANNOTATIONS,
        "corpus/google/logging/v2/logging.proto",
    ],
    generate = ["google/logging/v2/logging.proto"],
    golden = ["golden/logging_rest/logging.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_gcp_logging",
)

# `**`, a verb after a capture, `{x=*}`, and repeated, optional and bool
# query fields.
proto_codegen_golden(
    name = "shapes_rest",
    srcs = [
        _ANNOTATIONS,
        "corpus/shapes/v1/shapes.proto",
    ],
    generate = ["shapes/v1/shapes.proto"],
    golden = ["golden/shapes_rest/shapes.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_shapes",
)

# Well-known types as a GET response (Struct), a PUT response (Timestamp) and
# a `body:` field (Struct): the client reads and writes them through
# komira_proto_codec's codec, whose comptime branch gives a WKT its canonical
# JSON form. A direct `T.decode(JsonDecoder)` / `.encode(JsonEncoder)` would
# read and write the binary-shaped message instead.
proto_codegen_golden(
    name = "wkt_rest",
    srcs = [
        _ANNOTATIONS,
        "corpus/rest/v1/wkt_rest.proto",
    ],
    generate = ["rest/v1/wkt_rest.proto"],
    golden = ["golden/wkt_rest/wkt_rest.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_wkt_rest",
    absent = [
        "JsonDecoder",
        "JsonEncoder",
    ],
    present = [
        "decode_json_lenient[Struct](resp_text)",
        "decode_json_lenient[Timestamp](resp_text)",
        "encode_json(req.doc.value())",
    ],
)

# Templates a client cannot fill are refused, each naming the reason.
_REST_REFUSALS = [
    ("bare_wildcard", "a bare `*` segment has no request field to fill it"),
    ("double_star_not_last", "must be the last segment"),
    ("dotted_field", "names a nested field path"),
    ("repeated_path_var", "path variable `names` is a `repeated` field"),
    ("nested_braces", "nested `{` in a variable"),
    ("unclosed_brace", "unclosed `{`"),
    ("unbalanced_brace", "unbalanced `}`"),
    ("empty_verb", "custom verb \"\" must be a non-empty literal"),
    ("verb_with_slash", "custom verb \"a/b\" must be a non-empty literal"),
    ("pattern_not_unreserved", "pattern \"x y\" of `a` must be"),
    ("captured_twice", "field `a` is captured twice"),
    ("empty_pattern_segment", "pattern \"x//y\" of `a` must be"),
    ("double_star_not_last_in_pattern", "pattern \"**/x\" of `a` must be"),
    ("bytes_in_url", "field `blob` is `bytes`, which has no URL"),
]

[
    proto_codegen_golden(
        name = "refuse_rest_" + name,
        srcs = [
            _ANNOTATIONS,
            "corpus/refuse/{}.proto".format(name),
        ],
        expect_error = expect,
        generate = ["refuse/{}.proto".format(name)],
        options = "default_protocol=rest,package_prefix=refused",
    )
    for name, expect in _REST_REFUSALS
]

# The URL helpers protoc-gen-mojo emits into every REST client, cut out of
# the shapes client and compiled on their own (they need nothing outside the
# standard library). Building the library runs rest_url/test_helpers.mojo
# over them: matching, refusing and percent-encoding path variables, and
# errors that name the field and pattern but never the value. The goldens pin
# the text; this pins what the text does.
proto_codegen_rest_helpers(
    name = "rest_url_helpers_src",
    file = "files/shapes.mojo",
    gen = ":shapes_rest[out]",
    out = "rest_url/helpers.mojo",
)

mojo_library(
    name = "rest_url",
    srcs = [
        "rest_url/__init__.mojo",
        ":rest_url_helpers_src",
    ],
    test_srcs = ["rest_url_tests/test_helpers.mojo"],
)

# Not checked here: the OpenAPI emitter (openapi_emit.rs), including its
# whole-body fallback for a `{field=...}` template such as shapes'
# `/v1/{name=*}/things`. Its plugin, protoc-gen-openapi, has no target in
# proto-codegen/BUCK, and that file's next edit belongs to the rust_test
# weld, which will run openapi_emit.rs's own #[test]s. TODO(rust_test weld):
# add the plugin target and an OpenAPI golden over corpus/shapes here.

proto_codegen_goldens(
    name = "all",
    checks = [
        ":everything",
        ":two_roots",
        ":one_method",
        ":two_methods",
        ":layout_probe",
        ":one_method_messages_only",
        ":one_method_messages_only_false",
        ":messages_only",
        ":fq_method",
        ":fq_root",
        ":fq_root_is_exact",
        ":rest_one_method_messages_only",
        ":nested_map_entry_pruned",
        ":refuse_comma_list",
        ":refuse_bare_flag",
        ":refuse_unknown_key",
        ":refuse_unknown_root",
        ":refuse_unknown_method",
        ":refuse_empty_item",
        ":refuse_repeated_key",
        ":refuse_ungenerated_reach",
        ":refuse_unreached_file",
        ":refuse_partial_name",
        ":refuse_ambiguous_root",
        ":refuse_ambiguous_method",
        ":refuse_empty_token",
        ":refuse_non_boolean",
        ":refuse_empty_value",
        ":refuse_rest_unannotated_kept_method",
        ":refuse_dotted_suffix",
        ":refuse_db_roots",
        ":refuse_db_methods",
        ":refuse_db_messages_only",
        ":refuse_db_layout_probe",
        ":logging_rest",
        ":shapes_rest",
        ":wkt_rest",
    ] + [":refuse_rest_" + name for name, _ in _REST_REFUSALS],
)
