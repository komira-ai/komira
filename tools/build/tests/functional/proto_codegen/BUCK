load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load(":defs.bzl", "proto_codegen_golden", "proto_codegen_goldens", "proto_codegen_rest_helpers")

# protoc-gen-mojo's options, checked as build actions: `buck2 build
# tests//functional/proto_codegen:all` runs every case (defs.bzl), and
# proto_tests.sh (sourced by run_tests.sh, test 23) builds the package.
#
# The corpus is shaped like the googleapis logging API: logging.proto's
# service has three methods, log_entry.proto's LogEntry carries an Any, a
# Struct and a Timestamp, and monitored_resource.proto declares both what a
# log query needs (MonitoredResource) and what it does not
# (MonitoredResourceDescriptor, LabelDescriptor). Maps: LogEntry reaches
# LogSplit through a map value only; WriteLogEntriesRequest (pruned by a
# log query) and ListLogEntriesRequest.Hint (declared, used by no field)
# hold maps of MonitoredResourceDescriptor, so a map entry outliving its
# message would import that type. audit/v1/audit.proto, generated only by
# the ambiguity refusals, declares a second LogEntry and ListLogEntries;
# nested/example/logging/v1/nested_entry.proto declares a LogEntry whose
# fully-qualified name ends in the logging one's (fq_root_is_exact).
#
# Options are comma-joined `key=value` tokens, as the Mojo proto rules pass
# them; the items of `roots=` and `methods=` are joined with `+`.

# The REST fixtures (google/, shapes/, refuse/) and the Google Cloud gRPC
# fixture (example/tiny/) have their own cases below.
_SRCS = glob(
    ["corpus/example/**/*.proto", "corpus/nested/**/*.proto"],
    exclude = ["corpus/example/tiny/**"],
)

_ALL = [
    "example/logging/v1/logging.proto",
    "example/logging/v1/log_entry.proto",
    "example/logging/v1/monitored_resource.proto",
]

_PREFIX = "package_prefix=komira_example_logging"

# Not on the read path of a log query: what a pruned module must not hold.
_UNUSED = [
    "WriteLogEntries",
    "MonitoredResourceDescriptor",
    "LabelDescriptor",
    "ListMonitoredResourceDescriptors",
]

# No scope: every type and method of the corpus. The baseline the pruned
# cases are read against: everything they leave out is here.
proto_codegen_golden(
    name = "everything",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/everything/*.golden"]),
    options = _PREFIX,
    present = _UNUSED,
)

# TWO roots, messages only: the closure of the two messages of the read,
# through LogEntry into MonitoredResource and the Any, Struct and Timestamp
# of komira_wkt. No service, nothing of _UNUSED.
proto_codegen_golden(
    name = "two_roots",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/two_roots/*.golden"]),
    options = _PREFIX + ",roots=ListLogEntriesRequest+ListLogEntriesResponse,messages_only=true",
    absent = _UNUSED + ["LoggingService"],
    present = [
        "struct ListLogEntriesRequest",
        "struct ListLogEntriesResponse",
        "struct LogEntry",
        "struct MonitoredResource",
        "struct LogSeverity",
        "Any",
    ],
)

# One method: the service keeps ListLogEntries alone, and the types are the
# closure of its request and response.
proto_codegen_golden(
    name = "one_method",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method/*.golden"]),
    options = _PREFIX + ",methods=LoggingService.ListLogEntries",
    absent = _UNUSED,
    present = [
        "LoggingService",
        "ListLogEntries",
        "struct LogEntry",
    ],
)

# TWO methods, `+`-joined: the service keeps both, and the closure of the
# second brings MonitoredResourceDescriptor and LabelDescriptor back.
proto_codegen_golden(
    name = "two_methods",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/two_methods/*.golden"]),
    options = _PREFIX + ",methods=ListLogEntries+LoggingService.ListMonitoredResourceDescriptors",
    absent = ["WriteLogEntries"],
    present = [
        "def list_log_entries",
        "def list_monitored_resource_descriptors",
        "struct MonitoredResourceDescriptor",
        "struct LabelDescriptor",
    ],
)

# The layout probe: one more file, a size_of per emitted struct.
proto_codegen_golden(
    name = "layout_probe",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/layout_probe/*.golden"]),
    options = _PREFIX + ",roots=ListLogEntriesResponse,messages_only=true,layout_probe=true",
    absent = _UNUSED,
    present = ["size_of[log_entry.LogEntry]()"],
)

# One method, messages only: one_method's types, without the service.
proto_codegen_golden(
    name = "one_method_messages_only",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method_messages_only/*.golden"]),
    options = _PREFIX + ",methods=ListLogEntries,messages_only=true",
    absent = _UNUSED + ["LoggingService", "list_log_entries"],
    present = [
        "struct ListLogEntriesRequest",
        "struct ListLogEntriesResponse",
        "struct LogEntry",
    ],
)

# `messages_only=false` is the default: one_method's output, service kept.
proto_codegen_golden(
    name = "one_method_messages_only_false",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method/*.golden"]),
    options = _PREFIX + ",methods=ListLogEntries,messages_only=false",
    absent = _UNUSED,
    present = ["LoggingService", "def list_log_entries"],
)

# Messages only, nothing pruned: every type of the corpus, no service.
proto_codegen_golden(
    name = "messages_only",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/messages_only/*.golden"]),
    options = _PREFIX + ",messages_only=true",
    absent = ["LoggingService", "def list_log_entries", "def write_log_entries"],
    present = [
        "struct WriteLogEntriesRequest",
        "struct MonitoredResourceDescriptor",
        "struct LabelDescriptor",
    ],
)

# Fully-qualified names, leading `.` included, select as the bare ones do.
proto_codegen_golden(
    name = "fq_method",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method/*.golden"]),
    options = _PREFIX + ",methods=.example.logging.v1.LoggingService.ListLogEntries",
    absent = _UNUSED,
    present = ["def list_log_entries"],
)

proto_codegen_golden(
    name = "fq_root",
    srcs = _SRCS,
    generate = [
        "example/logging/v1/log_entry.proto",
        "example/logging/v1/monitored_resource.proto",
    ],
    golden = glob(["golden/fq_root/*.golden"]),
    options = _PREFIX + ",roots=.example.logging.v1.LogEntry",
    absent = _UNUSED,
    present = ["struct LogEntry", "struct LogSplit", "struct MonitoredResource"],
)

# A leading `.` makes a name fully qualified: it selects the one type it
# spells, never a type it is a dotted suffix of.
# nested/example/logging/v1/nested_entry.proto declares
# `.nested.example.logging.v1.LogEntry`, which `.example.logging.v1.LogEntry`
# is a suffix of. Each root selects its own LogEntry: fq_root's closure,
# plus the nested file (generated, so it must keep a type: its LogEntry is
# the second root). Matched as a suffix, the first root is refused as
# ambiguous, and "qualify it" cannot be done: it already is.
proto_codegen_golden(
    name = "fq_root_is_exact",
    srcs = _SRCS,
    generate = [
        "example/logging/v1/log_entry.proto",
        "example/logging/v1/monitored_resource.proto",
        "nested/example/logging/v1/nested_entry.proto",
    ],
    golden = glob(["golden/fq_root/*.golden"]) + glob(["golden/fq_root_is_exact/*.golden"]),
    options = _PREFIX + ",roots=.example.logging.v1.LogEntry+.nested.example.logging.v1.LogEntry",
    absent = _UNUSED,
    present = ["struct LogEntry", "struct LogSplit", "struct MonitoredResource", "var note"],
)

# ---- the rest route ----
#
# `default_protocol=rest` is a different entry into the plugin (the http
# annotations are recovered from the request bytes, and every kept service
# is pre-validated). This corpus carries no `(google.api.http)` annotation,
# so a rest target fails on any service it keeps, and scoping is what
# decides which.

# Scoped to one method's messages: one_method_messages_only's output, byte
# for byte. No service is kept, so nothing needs an annotation. Scoping
# ignored on this route would keep LoggingService and be refused, or emit
# _UNUSED.
proto_codegen_golden(
    name = "rest_one_method_messages_only",
    srcs = _SRCS,
    generate = _ALL,
    golden = glob(["golden/one_method_messages_only/*.golden"]),
    options = _PREFIX + ",default_protocol=rest,methods=ListLogEntries,messages_only=true",
    absent = _UNUSED + ["LoggingService"],
    present = [
        "struct ListLogEntriesRequest",
        "struct ListLogEntriesResponse",
        "struct LogEntry",
    ],
)

# The kept service is still validated, and only its kept method is: the
# error names ListLogEntries, not WriteLogEntries (the first method of the
# unscoped service). `--mojo_out: ` is protoc's prefix for the plugin's own
# error, which the emitter's panic backstop does not produce.
proto_codegen_golden(
    name = "refuse_rest_unannotated_kept_method",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "--mojo_out: protoc-gen-mojo: service `LoggingService` method `ListLogEntries` has no `(google.api.http)` annotation",
    options = _PREFIX + ",default_protocol=rest,methods=ListLogEntries",
)

# A leading `.` is not a bare suffix: `.LogEntry` names a LogEntry declared
# in no package, and there is none.
proto_codegen_golden(
    name = "refuse_dotted_suffix",
    srcs = _SRCS,
    generate = [
        "example/logging/v1/log_entry.proto",
        "example/logging/v1/monitored_resource.proto",
    ],
    expect_error = "root `.LogEntry` is not declared in the files to generate",
    options = _PREFIX + ",roots=.LogEntry",
)

# A map entry is kept only beside its own message. ListLogEntriesRequest
# is reached and its nested Hint is not, so Hint's map entry goes, and
# with it the import of its value, MonitoredResourceDescriptor, whose file
# is not even generated here.
proto_codegen_golden(
    name = "nested_map_entry_pruned",
    srcs = _SRCS,
    generate = ["example/logging/v1/logging.proto"],
    golden = glob(["golden/nested_map_entry_pruned/*.golden"]),
    options = _PREFIX + ",roots=ListLogEntriesRequest",
    absent = ["monitored_resource", "MonitoredResourceDescriptor", "Hint"],
    present = ["struct ListLogEntriesRequest"],
)

# ---- refusals ----

# A token without `=`: the second root of a `,`-joined list.
proto_codegen_golden(
    name = "refuse_comma_list",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `ListLogEntriesResponse` is not `key=value`",
    options = _PREFIX + ",roots=ListLogEntriesRequest,ListLogEntriesResponse",
)

# A bare flag, which once read as nothing.
proto_codegen_golden(
    name = "refuse_bare_flag",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `messages_only` is not `key=value`",
    options = _PREFIX + ",messages_only",
)

proto_codegen_golden(
    name = "refuse_unknown_key",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "unknown option `root`",
    options = _PREFIX + ",root=ListLogEntriesRequest",
)

proto_codegen_golden(
    name = "refuse_unknown_root",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "root `ListLogEntryRequest` is not declared in the files to generate",
    options = _PREFIX + ",roots=ListLogEntryRequest",
)

proto_codegen_golden(
    name = "refuse_unknown_method",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "method `LoggingService.TailLogEntries` is not declared in the files to generate",
    options = _PREFIX + ",methods=LoggingService.TailLogEntries",
)

proto_codegen_golden(
    name = "refuse_empty_item",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "has an empty item",
    options = _PREFIX + ",roots=ListLogEntriesRequest++ListLogEntriesResponse",
)

proto_codegen_golden(
    name = "refuse_repeated_key",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `roots` is given twice",
    options = _PREFIX + ",roots=ListLogEntriesRequest,roots=ListLogEntriesResponse",
)

# The closure reaches LogEntry, whose file is not generated.
proto_codegen_golden(
    name = "refuse_ungenerated_reach",
    srcs = _SRCS,
    generate = ["example/logging/v1/logging.proto"],
    expect_error = "`.example.logging.v1.LogEntry` is reachable from",
    options = _PREFIX + ",roots=ListLogEntriesResponse",
)

# A generated file the closure does not reach: nothing of log_entry.proto
# or monitored_resource.proto is reachable from ListLogEntriesRequest.
proto_codegen_golden(
    name = "refuse_unreached_file",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "example/logging/v1/log_entry.proto emits nothing",
    options = _PREFIX + ",roots=ListLogEntriesRequest",
)

# A suffix names a type only at a `.` boundary: `LogEntriesRequest` is not
# `ListLogEntriesRequest`.
proto_codegen_golden(
    name = "refuse_partial_name",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "root `LogEntriesRequest` is not declared in the files to generate",
    options = _PREFIX + ",roots=LogEntriesRequest",
)

# audit.proto declares a second LogEntry and a second ListLogEntries.
proto_codegen_golden(
    name = "refuse_ambiguous_root",
    srcs = _SRCS,
    generate = _ALL + ["example/audit/v1/audit.proto"],
    expect_error = "root `LogEntry` is ambiguous",
    options = _PREFIX + ",roots=LogEntry",
)

proto_codegen_golden(
    name = "refuse_ambiguous_method",
    srcs = _SRCS,
    generate = _ALL + ["example/audit/v1/audit.proto"],
    expect_error = "method `ListLogEntries` is ambiguous",
    options = _PREFIX + ",methods=ListLogEntries",
)

# An empty token, between two commas.
proto_codegen_golden(
    name = "refuse_empty_token",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `` is not `key=value`",
    options = _PREFIX + ",,messages_only=true",
)

proto_codegen_golden(
    name = "refuse_non_boolean",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `messages_only` must be `true` or `false`, not `yes`",
    options = _PREFIX + ",messages_only=yes",
)

proto_codegen_golden(
    name = "refuse_empty_value",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "option `package_prefix` has an empty value",
    options = "package_prefix=",
)

# protoc-gen-mojo-db implements none of the scoping options.
[
    proto_codegen_golden(
        name = "refuse_db_" + key,
        srcs = _SRCS,
        generate = _ALL,
        expect_error = "protoc-gen-mojo-db does not implement roots, methods, omit_fields, messages_only or layout_probe",
        options = _PREFIX + "," + opt,
        plugin = "mojo-db",
    )
    for key, opt in [
        ("roots", "roots=LogEntry"),
        ("methods", "methods=ListLogEntries"),
        ("messages_only", "messages_only=true"),
        ("layout_probe", "layout_probe=true"),
    ]
]

proto_codegen_golden(
    name = "refuse_db_gcp",
    srcs = _SRCS,
    generate = _ALL,
    expect_error = "protoc-gen-mojo-db does not implement gcp",
    options = _PREFIX + ",gcp=true",
    plugin = "mojo-db",
)

# ---- REST clients: path templates, query fields and refusals ---------------
# The REST fixtures import googleapis' google/api/annotations.proto (the
# `(google.api.http)` option) and, for `(google.api.default_host)`,
# google/api/client.proto. Neither is in the corpus: protoc reads them from
# the pinned googleapis tree, an import root after the corpus, so the goldens
# see the definitions the Google Cloud clients are generated against.

_GOOGLEAPIS = ["komira//tools/vendor/googleapis:api_client[tree]"]

# The Cloud Logging calls a log reader makes: a custom-verb literal path
# (POST /v2/entries:list), a `{parent=projects/*}` capture and a repeated
# query field. The REST client imports komira_gcp_core (its token source and
# its google.rpc.Status error mapper).
# The service declares `(google.api.default_host)`, so the client starts at
# logging.googleapis.com.
proto_codegen_golden(
    name = "logging_rest",
    srcs = ["corpus/google/logging/v2/logging.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["google/logging/v2/logging.proto"],
    golden = ["golden/logging_rest/logging.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_gcp_logging",
    absent = ["localhost"],
    present = ["self._rest_host = String(\"logging.googleapis.com\")"],
)

# `**`, a verb after a capture, `{x=*}`, and repeated, optional and bool
# query fields. The service declares no `(google.api.default_host)`, so the
# client starts with no host and every method refuses to send until
# `set_rest_host` names one.
proto_codegen_golden(
    name = "shapes_rest",
    srcs = ["corpus/shapes/v1/shapes.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["shapes/v1/shapes.proto"],
    golden = ["golden/shapes_rest/shapes.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_shapes",
    absent = ["localhost"],
    present = [
        "self._rest_host = String(\"\")",
        "komira.test.shapes.v1.Shapes declares no google.api.default_host",
    ],
)

# Well-known types as a GET response (Struct), a PUT response (Timestamp) and
# a `body:` field (Struct): the client reads and writes them through
# komira_proto_codec's codec, whose comptime branch gives a WKT its canonical
# JSON form. A direct `T.decode(JsonDecoder)` / `.encode(JsonEncoder)` would
# read and write the binary-shaped message instead.
proto_codegen_golden(
    name = "wkt_rest",
    srcs = ["corpus/rest/v1/wkt_rest.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["rest/v1/wkt_rest.proto"],
    golden = ["golden/wkt_rest/wkt_rest.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_wkt_rest",
    absent = [
        "JsonDecoder",
        "JsonEncoder",
    ],
    present = [
        "decode_json_lenient[Struct](resp_text)",
        "decode_json_lenient[Timestamp](resp_text)",
        "encode_json(req.doc.value())",
    ],
)

# Well-known types in the query, and messages holding them: a Timestamp or
# Duration query field is one parameter, its proto3 JSON string through
# komira_wkt's `to_proto3_json()` (the codec's own formatter); a message is
# flattened, to any depth, to dotted lowerCamelCase keys
# (`interval.startTime`, `window.bounds.endTime`), each level sent only when
# it is set.
proto_codegen_golden(
    name = "series_rest",
    srcs = ["corpus/rest/v1/series_rest.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["rest/v1/series_rest.proto"],
    golden = ["golden/series_rest/series_rest.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_series_rest",
    present = [
        "query += String(\"interval.startTime=\") + _rest_pct_encode(_rest_interval.start_time.value().to_proto3_json())",
        "query += String(\"aggregation.alignmentPeriod=\") + _rest_pct_encode(_rest_aggregation.alignment_period.value().to_proto3_json())",
        "query += String(\"window.bounds.endTime=\") + _rest_pct_encode(_rest_window__bounds.end_time.value().to_proto3_json())",
        "query += String(\"asOf=\") + _rest_pct_encode(req.as_of.value().to_proto3_json())",
    ],
    absent = [
        "startTime.seconds",
        "alignmentPeriod.nanos",
    ],
)

# `gcp=true` (what mojo_gcp_client passes) leaves a REST client as it is:
# REST clients are Google Cloud clients either way. logging_rest's golden,
# byte for byte.
proto_codegen_golden(
    name = "logging_rest_gcp",
    srcs = ["corpus/google/logging/v2/logging.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["google/logging/v2/logging.proto"],
    golden = ["golden/logging_rest/logging.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_gcp_logging,gcp=true",
)

# ---- Google Cloud gRPC clients (`gcp=true`) ---------------------------------
#
# corpus/example/tiny/v1/tiny.proto is the API of
# komira//tools/build/proto-codegen/gcp_grpc, one method of each streaming
# shape; that package compiles the same module against komira_grpc and
# komira_gcp_core and tests it over a scripted connector, and
# ../mojo_gcp_client holds its generated tiny.mojo to this golden byte for
# byte. The client takes a GcpTokenSource, fixes classic gRPC, runs the token
# hook (`authorization: Bearer <token>` on the call's CallOptions) first in
# every method, and raises a gRPC status through komira_gcp_core's
# gcp_grpc_status_error, outside the response decode.
proto_codegen_golden(
    name = "tiny_grpc_gcp",
    srcs = ["corpus/example/tiny/v1/tiny.proto"],
    generate = ["example/tiny/v1/tiny.proto"],
    golden = ["golden/tiny_grpc_gcp/tiny.mojo.golden"],
    options = "default_protocol=grpc,package_prefix=komira_gcp_tiny_grpc,gcp=true",
    absent = [
        "P: Protocol",
        ", opts: CallOptions",
    ],
    present = [
        "from komira_gcp_core import GcpTokenSource, gcp_grpc_status_error",
        "struct TinyServiceClient[C: Connector, T: GcpTokenSource](Movable, Deinitable):",
        "comptime P = ProtocolGrpcProto",
        "self._authorize(opts)",
        "raise _gcp_grpc_error(String(\"/example.tiny.v1.TinyService/SyncThings\"), String(e))",
    ],
)

# For tests//functional/mojo_gcp_client, which holds the module the komira
# cell compiles and tests to this golden, so the two proto copies cannot
# drift apart unnoticed.
export_file(
    name = "tiny_grpc_gcp_golden",
    src = "golden/tiny_grpc_gcp/tiny.mojo.golden",
    visibility = ["//functional/mojo_gcp_client:"],
)

# A Google Cloud client speaks classic gRPC or REST, never Connect.
proto_codegen_golden(
    name = "refuse_gcp_connect",
    srcs = ["corpus/example/tiny/v1/tiny.proto"],
    generate = ["example/tiny/v1/tiny.proto"],
    expect_error = "option `gcp=true` emits a Google Cloud client, which speaks classic gRPC",
    options = "default_protocol=connect,package_prefix=komira_gcp_tiny_grpc,gcp=true",
)

# Templates a client cannot fill are refused, each naming the reason.
_REST_REFUSALS = [
    ("bare_wildcard", "a bare `*` segment has no request field to fill it"),
    ("double_star_not_last", "must be the last segment"),
    ("dotted_field", "reads a field of `thing`, which is not the request body"),
    ("repeated_path_var", "path variable `names` is a `repeated` field"),
    ("nested_braces", "nested `{` in a variable"),
    ("unclosed_brace", "unclosed `{`"),
    ("unbalanced_brace", "unbalanced `}`"),
    ("empty_verb", "custom verb \"\" must be a non-empty literal"),
    ("verb_with_slash", "custom verb \"a/b\" must be a non-empty literal"),
    ("pattern_not_unreserved", "pattern \"x y\" of `a` must be"),
    ("captured_twice", "field `a` is captured twice"),
    ("empty_pattern_segment", "pattern \"x//y\" of `a` must be"),
    ("double_star_not_last_in_pattern", "pattern \"**/x\" of `a` must be"),
    ("bytes_in_url", "field `blob` is `bytes`, which has no URL"),
    ("optional_path_var", "path variable `name` is a proto3 `optional` field"),
    ("oneof_path_leaf", "field `thing.id` is used in the path/query but is an arm of a oneof"),
    ("repeated_message_in_query", "query field `items` is a repeated message, which has no query form"),
    ("binding_with_another_verb", "every binding must share them"),
]

[
    proto_codegen_golden(
        name = "refuse_rest_" + name,
        srcs = ["corpus/refuse/{}.proto".format(name)],
        import_roots = _GOOGLEAPIS,
        expect_error = expect,
        generate = ["refuse/{}.proto".format(name)],
        options = "default_protocol=rest,package_prefix=refused",
    )
    for name, expect in _REST_REFUSALS
]

# An Update method: `{thing.name=...}` is read from the body message after a
# presence check that comes before the token is asked for, and the
# FieldMask `update_mask` is the `updateMask` query parameter, sent as its
# proto3 JSON string when set.
proto_codegen_golden(
    name = "update_rest",
    srcs = ["corpus/rest/v1/update_rest.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["rest/v1/update_rest.proto"],
    golden = ["golden/update_rest/update_rest.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_update_rest",
    present = [
        "if not req.thing:",
        "_rest_to_str(req.thing.value().name)",
        "query += String(\"updateMask=\") + _rest_pct_encode(req.update_mask.value().to_proto3_json())",
        "body_text = encode_json(req.thing.value())",
    ],
)

# A rest target lists the unary method of a service that also has a
# bidirectional-streaming one: the client holds GetItem, and nothing of WatchItems.
proto_codegen_golden(
    name = "rest_unary_beside_streaming",
    srcs = ["corpus/rest/v1/feed.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["rest/v1/feed.proto"],
    golden = ["golden/rest_unary_beside_streaming/feed.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_feed,methods=Feed.GetItem",
    absent = [
        "WatchItems",
        "watch_items",
    ],
    present = ["def get_item[RT: Runtime]"],
)

# A method that streams its requests (here bidirectional), listed in
# `methods`, is refused by name, not skipped: skipped, the target would build
# a client without a method it lists. (A server-streaming method has a REST
# form, and is generated.)
proto_codegen_golden(
    name = "refuse_rest_streaming_method_listed",
    srcs = ["corpus/rest/v1/feed.proto"],
    import_roots = _GOOGLEAPIS,
    expect_error = "--mojo_out: protoc-gen-mojo: service `Feed` method `WatchItems` is bidirectional-streaming, and a `rest` target generates unary and server-streaming methods only",
    generate = ["rest/v1/feed.proto"],
    options = "default_protocol=rest,package_prefix=komira_test_feed,methods=Feed.GetItem+Feed.WatchItems",
)

# A `(google.api.default_host)` the client cannot send to (here a port other
# than 443) is refused by name rather than written into the client.
proto_codegen_golden(
    name = "refuse_rest_default_host_with_port",
    srcs = ["corpus/refuse/default_host_with_port.proto"],
    import_roots = _GOOGLEAPIS,
    expect_error = "service `refused.v1.Ported` declares `(google.api.default_host)` = \"ported.example.com:8443\", which is not a host name",
    generate = ["refuse/default_host_with_port.proto"],
    options = "default_protocol=rest,package_prefix=refused",
)

# ---- a service configuration's http.rules (`service_config`) ----
#
# corpus/mixin/v1/operations.proto is a mixin bound to its own generic paths
# (`/v1/{name=operations/**}`) at its own host, as
# google/longrunning/operations.proto is. service_config/fixture_v1.yaml, the
# configuration of an API serving it, binds its four methods to the API's
# paths: GetOperation with an additional binding, WaitOperation with
# `body: '*'`, CancelOperation with `body: spec`, a field, and
# ListOperations. Its `apis` does not list the mixin (as googleapis' API
# Gateway configuration does not list google.longrunning.Operations): the
# rules alone move the client to the configuration's `name`, and the client
# names the configuration as its host's source. The rule for
# DeleteOperation, a method the proto does not declare, is not used.
proto_codegen_golden(
    name = "service_config_rest",
    srcs = ["corpus/mixin/v1/operations.proto"],
    import_roots = _GOOGLEAPIS,
    generate = ["mixin/v1/operations.proto"],
    golden = ["golden/service_config_rest/operations.mojo.golden"],
    options = "default_protocol=rest,package_prefix=komira_test_mixin",
    service_config = "service_config/fixture_v1.yaml",
    absent = [
        "/v1/{name=operations/**}",
        "mixin.example.com",
        "delete_operation",
        "`/v1/{name=operations}`",
        "google.api.default_host",
    ],
    present = [
        "\"\"\"GET `/v9/{name=projects/*/operations/*}`, `/v9/{name=folders/*/operations/*}` — REST/JSON, to the first path the request's values match.\"\"\"",
        "\"\"\"POST `/v9/{name=projects/*/operations/*}:wait` — REST/JSON.\"\"\"",
        "\"\"\"POST `/v9/{name=projects/*/operations/*}:cancel` — REST/JSON.\"\"\"",
        "\"\"\"GET `/v9/{name=projects/*}/operations` — REST/JSON.\"\"\"",
        "encode_json(req.spec.value())",
        "self._rest_host = String(\"fixture.googleapis.com\")",
        "configuration `name`, `fixture.googleapis.com`; `set_rest_host` replaces it.",
    ],
)

# A generated mixin method the configuration does not bind is refused: its
# service starts at the API's host, which does not serve the mixin's own
# generic path (`/v1/{name=operations}`).
proto_codegen_golden(
    name = "refuse_service_config_unbound_mixin_method",
    srcs = ["corpus/mixin/v1/operations.proto"],
    import_roots = _GOOGLEAPIS,
    expect_error = "unbound_v1.yaml`: `mixin.v1.Operations.ListOperations` is generated with no http rule in it, but its service starts at the configuration's `name`, `fixture.googleapis.com`, not its own `mixin.example.com`: the proto's binding is not served there; bind the method in `http.rules` or leave it out of the target",
    generate = ["mixin/v1/operations.proto"],
    options = "default_protocol=rest,package_prefix=komira_test_mixin",
    service_config = "service_config/unbound_v1.yaml",
)

# `response_body` on a generated method is refused: the client decodes the
# whole response as the method's output.
proto_codegen_golden(
    name = "refuse_service_config_response_body",
    srcs = ["corpus/mixin/v1/operations.proto"],
    import_roots = _GOOGLEAPIS,
    expect_error = "line 24: the http rule for `mixin.v1.Operations.CancelOperation` sets `response_body`, which is not generated",
    generate = ["mixin/v1/operations.proto"],
    options = "default_protocol=rest,package_prefix=komira_test_mixin",
    service_config = "service_config/response_body_v1.yaml",
)

# http.rules bind REST methods: a gRPC target given a configuration is refused.
proto_codegen_golden(
    name = "refuse_service_config_grpc",
    srcs = ["corpus/mixin/v1/operations.proto"],
    import_roots = _GOOGLEAPIS,
    expect_error = "option `service_config` binds REST methods: it is read with `default_protocol=rest` only",
    generate = ["mixin/v1/operations.proto"],
    options = "default_protocol=grpc,package_prefix=komira_test_mixin",
    service_config = "service_config/fixture_v1.yaml",
)

# The URL helpers protoc-gen-mojo emits into every REST client, cut out of
# the shapes client and compiled on their own (they need nothing outside the
# standard library). Building the library runs rest_url/test_helpers.mojo
# over them: matching, refusing and percent-encoding path variables, and
# errors that name the field and pattern but never the value. The goldens pin
# the text; this pins what the text does.
proto_codegen_rest_helpers(
    name = "rest_url_helpers_src",
    file = "files/shapes.mojo",
    gen = ":shapes_rest[out]",
    out = "rest_url/helpers.mojo",
)

mojo_library(
    name = "rest_url",
    srcs = [
        "rest_url/__init__.mojo",
        ":rest_url_helpers_src",
    ],
    test_srcs = ["rest_url_tests/test_helpers.mojo"],
)

# Not checked here: the OpenAPI emitter (openapi_emit.rs), including its
# whole-body fallback for a `{field=...}` template such as shapes'
# `/v1/{name=*}/things`. Its plugin, protoc-gen-openapi, has no target in
# proto-codegen/BUCK, and that file's next edit belongs to the rust_test
# weld, which will run openapi_emit.rs's own #[test]s. TODO(rust_test weld):
# add the plugin target and an OpenAPI golden over corpus/shapes here.

# `module_names` (import path -> module, `+`-joined), refused by the plugin
# itself as well as by mojo_gcp_client, which passes it.
_MODULE_NAMES_REFUSALS = [
    ("malformed", "example/logging/v1/log_entry.proto", "is not `<proto path>:<module stem>`"),
    ("empty_stem", "example/logging/v1/log_entry.proto:", "has an empty path or stem"),
    (
        "twice",
        "example/logging/v1/log_entry.proto:a+example/logging/v1/log_entry.proto:b",
        "names `example/logging/v1/log_entry.proto` twice",
    ),
    ("stray", "example/audit/v1/audit.proto:audit", "names `example/audit/v1/audit.proto`, which is not a file to generate"),
    ("not_a_module", "example/logging/v1/log_entry.proto:log-entry", "module `log-entry`, which is not a Mojo module name"),
    ("keyword", "example/logging/v1/log_entry.proto:import", "module `import`, a Mojo keyword"),
    ("kept_name", "example/logging/v1/log_entry.proto:__init__", "a name the generated package keeps for itself"),
    ("clash", "example/logging/v1/log_entry.proto:logging", "would both be generated as module `logging`"),
]

[
    proto_codegen_golden(
        name = "refuse_module_names_" + name,
        srcs = _SRCS,
        generate = _ALL,
        expect_error = expect,
        options = _PREFIX + ",module_names=" + value,
    )
    for name, value, expect in _MODULE_NAMES_REFUSALS
]

proto_codegen_goldens(
