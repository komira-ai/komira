load("@komira//third_party/s2n-tls:features.bzl", "S2N_FEATURES")
load("@komira//third_party/s2n-tls:srcs.bzl", "PROBES")
load(":defs.bzl", "s2n_probe")

# The s2n-tls feature probes that pass on the one platform this repository
# builds for (linux x86_64): the features third_party/s2n-tls/features.bzl
# names. Every target here builds; a feature listed that does not compile is
# a red build. The probes that fail on that platform are
# tests//negative/s2n_probes: a probe that is expected to fail does not
# belong in a package whose targets are all expected to build.
# tools/build/tests/c_libs_tests.sh holds features.bzl to both packages.
[
    cxx_library(**s2n_probe(name, flags))
    for name, flags in PROBES.items()
    if name in S2N_FEATURES
]
