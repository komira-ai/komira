load("@komira//third_party/s2n-tls:srcs.bzl", "PROBE_GLOBAL_FLAGS", "PROBES")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

# One target per s2n-tls feature probe (tests/features/<name>.c), compiled as
# s2n-tls's CMake feature_probe compiles it: with GLOBAL.flags, the probe's
# own <name>.flags and the Release flags, against aws-lc's headers. Building
# `:probe_<name>` succeeds exactly when the probe passes. (CMake's
# try_compile also links the probe; these compile it, which is what every
# probe here tests: a header, a declaration, a builtin or a flag.)
# tools/build/tests/c_libs_tests.sh holds features.bzl to these results.
[
    cxx_library(
        name = "probe_" + name,
        srcs = ["komira//third_party/s2n-tls:src[tests/features/{}.c]".format(name)],
        compiler_flags = ["-O3", "-DNDEBUG"] + PROBE_GLOBAL_FLAGS.split(" ") + [f for f in flags.split(" ") if f],
        deps = ["komira//third_party/aws-lc:crypto"],
    )
    for name, flags in PROBES.items()
]

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["tests//:doc_tree"],
)
