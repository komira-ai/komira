# The cases of mojo_library's native-reach check
# (tests//negative/native_reach): each builds green only when the check
# refuses its planted defect with the named error, or passes its correct
# tree. This is the target that builds them in the pull request check.
filegroup(
    name = "cases",
    srcs = [
        "//negative/native_reach:" + name
        for name in [
            "archive_needed_by_c_dep",
            "archive_owner_missing",
            "call_in_comment",
            "call_owner_missing",
            "call_quoting",
            "owner_through_mojo_dep",
            "vendored_owner_missing",
        ]
    ],
)
