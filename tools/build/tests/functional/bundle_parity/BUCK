load("@komira//tools/build/lint:defs.bzl", "doc_tree", "shell_lint")
load("@komira//tools/build/package:defs.bzl", "mojo_bundle")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary")
load(":defs.bzl", "bundle_parity")

mojo_binary(
    name = "probe",
    srcs = ["probe.mojo"],
)

mojo_bundle(
    name = "probe_bundle",
    binary = ":probe",
    data = {"share/probe.txt": "probe.txt"},
    version = "0.0.0",
)

bundle_parity(
    name = "parity",
    binary = ":probe",
    bundle = ":probe_bundle",
)

export_file(name = "parity.sh")

shell_lint(
    name = "shell_lint",
    srcs = ["parity.sh"],
    visibility = ["komira//:tests_lints"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["tests//:doc_tree"],
)
