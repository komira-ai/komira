# Reproducibility without --no-remote-cache: two libraries build the same
# test, so two actions with different keys (their output paths differ) run on
# the farm, in different sandboxes. The test imports only reprodep, a
# dependency of both, so nothing of the two libraries themselves is in its
# debug info: the binaries must be the same bytes.
mojo_library(
    name = "reprodep",
    srcs = [
        "reprodep/__init__.mojo",
        "reprodep/calc.mojo",
    ],
    conda = False,
)

[
    mojo_library(
        name = name,
        srcs = ["repro/__init__.mojo"],
        conda = False,
        coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
        deps = [":reprodep"],
        import_name = "repro",
        test_srcs = ["tests/test_same.mojo"],
    )
    for name in ("repro_a", "repro_b")
]

cov_debug_check(
    name = "reproducible",
    bins = [
        ":repro_a[coverage][bin][test_same]",
        ":repro_b[coverage][bin][test_same]",
    ],
    mode = "same",
    script = "check.sh",
)

# Test 47: branch coverage. A library whose function has every kind of
# source decision (`if`, `elif`, `or`, `and`) and whose test takes some of
# its arms, never the first (and a String destroyed at an `if`, loops over
# collections, a Dict subscript, user masks, raising calls in `try:`
# bodies, `and`/`or` whose result is returned, stored or passed on, a
# function only a folded-away assert failure calls): with
# coverage (forced here, as for covlib_forced) it has [coverage][bc],
# [coverage][pgo_bin] and [coverage][branch].
mojo_library(
    name = "branchlib",
    srcs = [
        "branchlib/__init__.mojo",
        "branchlib/lookup.mojo",
        "branchlib/loops.mojo",
        "branchlib/mask.mojo",
        "branchlib/score.mojo",
        "branchlib/shapes.mojo",
        "branchlib/strings.mojo",
        "branchlib/trial.mojo",
        "branchlib/unrun.mojo",
        "branchlib/values.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    test_srcs = [
        "tests/test_gate_env.mojo",
        "tests/test_score_arms.mojo",
        "tests/test_unrun.mojo",
    ],
)

