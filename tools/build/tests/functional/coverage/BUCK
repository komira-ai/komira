# Coverage builds and runs (tools/build/mojo/README.md, "Coverage builds";
# tests 41 and 43 of tools/build/tests/run_tests.sh).

# A library with two tests and no README, coverage by the switch: with
# `-c komira.coverage=true` it has [coverage]; without it, none.
# tools/build/tests/functional/coverage_keys.sh compares its actions with the
# switch off and on.
mojo_library(
    name = "covlib",
    srcs = [
        "covlib/__init__.mojo",
        "covlib/value.mojo",
    ],
    conda = False,
    test_srcs = [
        "tests/test_describe.mojo",
        "tests/test_value.mojo",
    ],
)

# Test 46: a library that depends on covlib. coverage_keys.sh builds it with
# the switch off, then on: its compile and test must not run again, so
# covlib's package (its join's output) is the same bytes either way.
mojo_library(
    name = "covuser",
    srcs = ["covuser/__init__.mojo"],
    conda = False,
    deps = [":covlib"],
    test_srcs = ["tests/test_user.mojo"],
)

# Test 41: a library with no test and no README. Its package is the
# compiler's output and it has no join, with the switch off and on: its
# coverage gate (no report: NotMeasured) is waited for by a conda package
# only, and it has none. coverage_keys.sh reads both.
mojo_library(
    name = "covbare",
    srcs = ["covbare/__init__.mojo"],
    conda = False,
)

# The same library with coverage whatever the switch says (a tests-cell
# fixture may name the link directory), linked through the one every library
# uses: what the checks below read.
mojo_library(
    name = "covlib_forced",
    srcs = [
        "covlib/__init__.mojo",
        "covlib/value.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    import_name = "covlib",
    test_srcs = [
        "tests/test_describe.mojo",
        "tests/test_value.mojo",
    ],
)

# The coverage gate of what ships, in a build without the switch: a library
# with coverage and a gate whatever the switch says, and WITH a conda package
# (the macro's covconda_conda), as a library of komira has with
# `-c komira.coverage=true`. Its gate is komira's, in census mode (findings
# never fatal), and does not read branch records, so its markers are its one
# coverage run's and its gate's.
mojo_library(
    name = "covconda",
    srcs = [
        "covlib/__init__.mojo",
        "covlib/value.mojo",
    ],
    conda_name = "covconda",
    coverage_branch_gate = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_gate = "komira//tools/build/coverage:cov_gate",
    coverage_mode = "census",
    import_name = "covlib",
    test_srcs = ["tests/test_value.mojo"],
)

# Both joins of covconda_conda (what [default] and [release] are copies of)
# wait for covconda's two coverage markers, and those of covmt_conda for
# covmt's gate: checked at analysis (CondaJoinInfo,
# tools/build/package/conda.bzl), so `pr / check`, which builds
# tests//functional/... without the switch, fails when conda.bzl stops
# passing `gate` to either copy.
cov_conda_gate_check(
    name = "conda_gate",
    conda = ":covconda_conda",
    lib = ":covconda",
    markers = 2,
)

# The package of a library whose gate is the target `<name>_cov_gate` (one of
# the ledger COVERAGE_NO_GATE, tools/build/coverage/policy.bzl, or one naming
# `coverage_tests`) is given that target as `coverage_gate`, and conda.bzl
# refuses any other: covmt_conda, which mojo_library declares with
# `coverage_gate = ":covmt_cov_gate"`. Its joins wait for covmt's one
# coverage marker and for the outputs of covmt_cov_gate (its gate's marker
# and the runs of the three tests covmt names), none of which is covmt's.
cov_conda_gate_check(
    name = "conda_gate_ledger",
    conda = ":covmt_conda",
    coverage_gate = ":covmt_cov_gate",
    lib = ":covmt",
    markers = 1,
)

# Each coverage binary has line tables naming the library source its test
# calls, holds the placeholder of the working directory, names no sandbox
# path, and has no compressed section.
cov_debug_check(
    name = "hermetic",
    bins = [
        ":covlib_forced[coverage][bin][test_describe]",
        ":covlib_forced[coverage][bin][test_value]",
    ],
    # The directories of the tests and of the library's sources, as the
    # pinned Mojo writes them: relative, the library's its import name (its
    # package is compiled from the parent of [src]).
    dirs = [
        "tests",
        "covlib",
    ],
    mode = "hermetic",
    # Both tests call covlib/value.mojo.
    names = ["value.mojo"],
    script = "check.sh",
)

# [coverage][bin] is every test's binary, [coverage][tests] every test's
# report, and [coverage] both, no more and no fewer (checked at analysis).
_BINS = [
    ":covlib_forced[coverage][bin][test_describe]",
    ":covlib_forced[coverage][bin][test_value]",
]

_REPORTS = [
    ":covlib_forced[coverage][tests][test_describe]",
    ":covlib_forced[coverage][tests][test_value]",
]

cov_set_check(
    name = "aggregates",
    aggregates = [":covlib_forced[coverage][bin]"],
    members = _BINS,
)

cov_set_check(
    name = "aggregates_tests",
    aggregates = [":covlib_forced[coverage][tests]"],
    members = _REPORTS,
)

cov_set_check(
    name = "aggregates_all",
    aggregates = [":covlib_forced[coverage]"],
    members = _BINS + _REPORTS,
)

# Test 43: each test's report from its kcov run is its golden file byte for
# byte. In covlib/value.mojo, test_value covers clamp and test_describe
# calls describe(0) only: the arm `if x > 0: return "positive"` (lines 12
# and 13) is never taken, and line 14 carries `# cov: unreachable`, uncovered
# in the report (an exemption is covcheck's business). Lines 5 and 6 of
# clamp (`return hi`, `return x`) are absent, not uncovered: the -O0
# binary's line table has rows for value.mojo's lines 1 to 4 and none, not
# even a non-statement row (which kcov skips), for 5 or 6 (`readelf
# --debug-dump=decodedline` of [coverage][bin][test_value]; debug_relocate
# rewrites directory strings only). So the pinned Mojo emits no row there,
# and an arm like `return hi`, never taken, is invisible to coverage. The library is
# in the tests cell, outside src/, and its sources are in covlib/ below the
# package, so the paths are tools/build/tests/functional/coverage/....
cov_report_check(
    name = "numbers",
    goldens = [
        "golden/test_describe.xml",
        "golden/test_value.xml",
        "golden/test_gen.xml",
        "golden/test_gen_many.xml",
    ],
    mode = "golden",
    reports = _REPORTS + [
        ":covgen[coverage][tests][test_gen]",
        ":covgenmany[coverage][tests][test_gen_many]",
    ],
    script = "report.sh",
)

# Test 43: a library with a generated source. covgen/gen.mojo is made from
# covgen/gen.mojo.in (cov_plant used as a generator); test_gen calls a
# function of each. Its golden report has covgen/plain.mojo and the test, and
# no gen.mojo: a generated source is not measured (cov_run.sh --gen).
cov_plant(
    name = "covgen_gen",
    expr = "s/@FACTOR@/2/",
    out = "covgen/gen.mojo",
    src = "covgen/gen.mojo.in",
)

mojo_library(
    name = "covgen",
    srcs = [
        "covgen/__init__.mojo",
        "covgen/plain.mojo",
        ":covgen_gen",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    test_srcs = ["tests/test_gen.mojo"],
)

# Test 43: a library whose one test is generated (a `test_srcs` entry that is
# a build output: tests/test_gen_triple.mojo, made from its .in by cov_plant
# used as a generator). It has its coverage binary and run as a written test
# has ([coverage][tests][test_gen_triple] is its golden report, naming the
# test by its output path in the package), and its gate (census) counts the
# line it runs of covgentest/triple.mojo and sets the test aside.
cov_plant(
    name = "covgentest_test",
    expr = "s/@ARG@/4/",
    out = "tests/test_gen_triple.mojo",
    src = "tests/test_gen_triple.mojo.in",
)

mojo_library(
    name = "covgentest",
    srcs = [
        "covgentest/__init__.mojo",
        "covgentest/triple.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_gate = "komira//tools/build/coverage:cov_gate",
    coverage_mode = "census",
    test_srcs = [":covgentest_test"],
)

cov_report_check(
    name = "covgentest_report",
    goldens = ["golden/test_gen_triple.xml"],
    mode = "golden",
    reports = [":covgentest[coverage][tests][test_gen_triple]"],
    script = "report.sh",
)

cov_report_check(
    name = "covgentest_result",
    expect = [
        '"conclusion":"neutral","mode":"census",',
        '"package":{"package":"tools/build/tests/functional/coverage","files":1,"unmeasured_files":0,"line_hit":1,"line_found":1,"line_bp":10000,',
        '"excluded_test_files":1,',
    ],
    mode = "result",
    reports = [":covgentest[coverage][gate][result]"],
    script = "report.sh",
)

