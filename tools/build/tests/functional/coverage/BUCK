# Test 43: a library with twelve generated sources, each with a long name.
# cov_run.sh once named every generated source to kcov in one
# --exclude-path argument (two absolute paths each); kcov opens every
# argument before the program as a candidate binary and fails "Too long
# string!" at 2048 bytes, so this run was red. Its golden report has
# covgenmany/plain.mojo and the test, and none of the generated sources.
_GEN_MANY = "generated_source_with_a_name_long_enough_to_fill_kcov_argv_"

_GEN_MANY_N = [("0" + str(v))[-2:] for v in range(12)]

[
    cov_plant(
        name = "covgenmany_gen_{}".format(_GEN_MANY_N[v]),
        expr = "s/@N@/{}/; s/@V@/{}/".format(_GEN_MANY_N[v], v),
        out = "covgenmany/{}{}.mojo".format(_GEN_MANY, _GEN_MANY_N[v]),
        src = "covgenmany/gen.mojo.in",
    )
    for v in range(12)
]

mojo_library(
    name = "covgenmany",
    srcs = [
        "covgenmany/__init__.mojo",
        "covgenmany/plain.mojo",
    ] + [":covgenmany_gen_{}".format(n) for n in _GEN_MANY_N],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    test_srcs = ["tests/test_gen_many.mojo"],
)

# Test 43: a test of the gate's runtime contract (test_env, declared data
# reached from the working directory, the runner's PATH, LD_LIBRARY_PATH,
# HOME and TMPDIR, no LD_PRELOAD), green in the release gate and, with
# [coverage][tests][test_env], in its kcov run: the run has the gate's
# environment. One data file sits where the binary names a standard library
# source, so the run is red unless --include-path keeps it out of the report.
mojo_library(
    name = "covenv",
    srcs = ["covenv/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    test_data = {"tests/test_env.mojo": {
        "functional/coverage/tests/data/covenv.txt": "tests/data/covenv.txt",
        # Where the binary's line tables name a standard library source:
        # kcov would measure it but for cov_run.sh's --include-path list,
        # and its report would then hold a name no --map covers.
        "oss/modular/mojo/stdlib/std/testing/testing.mojo": "tests/data/stdlib_decoy.txt",
    }},
    test_env = {"COVENV": "set by test_env"},
    test_srcs = ["tests/test_env.mojo"],
)

# Test 43: covcheck's build gate reads those reports (census mode), over the
# package's sources: its numbers are the reports' (value.mojo's lines, the
# exempted line out of them) and the tests are set aside.
cov_report_check(
    name = "census",
    covcheck = "komira//tools/build/coverage:covcheck_bin",
    # value.mojo: 9 lines recorded besides the exempted one (1-4 by
    # test_value; 9-13 by test_describe), 7 hit (12 and 13 not), line 14
    # exempt; __init__.mojo has no executable line; the two tests set aside.
    expect = [
        '"conclusion":"neutral","mode":"census"',
        '"package":"tools/build/tests/functional/coverage","files":1,"unmeasured_files":0,"line_hit":7,"line_found":9,"line_bp":7777,',
        '"exempt_lines":1,',
        '"exemptions":[{"path":"tools/build/tests/functional/coverage/covlib/value.mojo","line":14,"reason":"a fixture line (test 43): the tests describe 0 only","status":"exempt"}]',
        '"excluded_test_files":2,',
    ],
    files = {
        "tools/build/tests/functional/coverage/covlib/__init__.mojo": "covlib/__init__.mojo",
        "tools/build/tests/functional/coverage/covlib/value.mojo": "covlib/value.mojo",
        "tools/build/tests/functional/coverage/tests/test_describe.mojo": "tests/test_describe.mojo",
        "tools/build/tests/functional/coverage/tests/test_value.mojo": "tests/test_value.mojo",
    },
    mode = "census",
    package = "tools/build/tests/functional/coverage",
    reports = _REPORTS,
    script = "report.sh",
)

# Tests 43 and 46: a library whose only tests are standalone mojo_test
# targets, which it names in `coverage_tests`: test_covmt in this package
# calls half, test_covmt_far in //functional/coverage/covmt_far (another
# package, as an end-to-end test under src/tests/ is) calls quarter. Its gate
# is the target covmt_cov_gate (the library cannot depend on its tests),
# which runs each test's coverage binary under kcov against covmt's sources
# and gates over both reports: every line of half.mojo is covered, by one
# test or the other. The test in this package is set aside (--test-source),
# and the other one's source is staged with a BUCK file at its package, so
# the gate does not measure it as covmt's.
mojo_library(
    name = "covmt",
    srcs = [
        "covmt/__init__.mojo",
        "covmt/half.mojo",
    ],
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_gate = "komira//tools/build/coverage:cov_gate",
    coverage_mode = "census",
    coverage_tests = [
        ":test_covmt",
        ":test_covmt_top",
        "//functional/coverage/covmt_far:test_covmt_far",
    ],
    visibility = ["//functional/coverage/covmt_far:"],
)

mojo_test(
    name = "test_covmt",
    srcs = ["tests/test_covmt.mojo"],
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    deps = [":covmt"],
)

# A test of covmt's package at the package's top, outside tests/: covcheck
# sets aside only <package>/tests/ by itself, so the gate must name this one
# (--test-source), or its lines count as covmt's source.
mojo_test(
    name = "test_covmt_top",
    srcs = ["test_covmt_top.mojo"],
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    deps = [":covmt"],
)

