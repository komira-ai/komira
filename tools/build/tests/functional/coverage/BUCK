# The profile of test_score_arms's instrumented run holds one function named
# like classify_score (`ld-temp.o;branchlib::score::classify_score(...)`),
# with six counters. IR profile counters sit on the edges outside a spanning
# tree of the function's control flow, not one per arm, so the list is what
# the instrumentation of this function gives, sorted, as measured remotely:
# 1 and 1 are "top" and "high" (one call each), 2 is "pass" (two calls), and
# the zeros include the "invalid" arm, which the test never takes. A run
# whose counters were not written would read all zeros, and a test taking
# another set of arms other numbers.
cov_branch_check(
    name = "branch_counts",
    counts = [0, 0, 1, 1, 2, 2],
    exec_compatible_with = LINUX_X86_64,
    function = "classify_score",
    profdata = ":branchlib[coverage][branch][test_score_arms]",
    script = "branch_check.sh",
)

# Test 47: the branch records of test_score_arms's run
# ([coverage][branch_info], cov_branch_classify) are its golden file byte for
# byte. classify_score's `if` and both `elif`s are three branches Mojo puts
# on the `if`'s line and column (4,5): 0/3 is the `if` (0 taken: the test
# never asks for "invalid"), 1/3 the first `elif` (1 of 4), 2/3 the second
# (1 of 3). The `or` (4,18) is a select whose right operand never decides
# true (rhs 0,4), and the `and` (6,22) one whose right operand, `bonus`,
# decides both ways once (rhs 1,1). shapes.mojo: the plain @always_inline
# `pick`'s `if` is a select at its own line (9,5: 1,1), not at its call;
# in `a > 0 or b > 0 or c > 0` (15) the first `or`'s result is the second's
# condition, so its right operand is derived from the second select (rhs
# 0,1: `b` never decides true) and the second's from the `if`'s branch
# (rhs 1,0); the `while` (23,5: 3,2); the `range(` loop's two branches on
# one value, one record (25,19: arm 0 the loop's end, 2, arm 1 an
# iteration, 3); the ternary (27,15: 1,1). A classifier summing the three
# branches at 4,5 into one record would give 2,9 here; one losing a
# derivation, no rhs; one writing a decision tested twice, 25,19 twice.
# strings.mojo: `first` owns a String destroyed on its `if`'s return path,
# so the IR holds five branches at the `if` (8,5): the `if` and the String
# destructor's four, one record (1,1); a classifier reading the String's
# branches as decisions there gives 8,5:br:0/5 to 4/5. loops.mojo: a loop
# over a List by name (9,14, at the name) and one over a list literal of
# Strings (16,14, at the `[`, whose branch is on the `i1` that
# `_ArrayIterOwned.__next__` returns, true when it raises StopIteration):
# one record each, arm 0 the end and arm 1 an iteration (2,3 and 1,2); a
# classifier dropping a raising call's flag at a loop head loses 16,14.
# lookup.mojo: `d[key]`'s branch on `Dict.__getitem__`'s error flag at the
# `[` is compiler-made (no record), and one refusing it fails here.
# mask.mojo: `if ys.capacity() & (1 << 62):` (11,5) is a String's flags
# test in shape, the `and` and `icmp ne` at the `&`; it stays a decision
# because the test is not at the `if`'s location (`!= 0`, 9,5, is an
# `icmp eq` and a `xor`, no String shape).
# trial.mojo: each raising call in a `try:` body is a `try` decision, arm 0
# the call returned, arm 1 it raised into the handler: `both` (15,23: 1,1),
# `normal_only` (23,20: 1,0, its raise never taken), a nested `try` (35,24
# outer, 37,25 inner, 39,25 a call in the inner `except` body, still in the
# outer `try:` body: 1,0), a `try`/`finally` (57,20), a `try`/`else` (66,20;
# the call in the `else` body, 70, is the compiler's), a Dict subscript
# (76,17, at the `[`), and in `calls` a call returning only its flag (110),
# an inlined raising callee (111,16: its `if` is 88,5 at its own line), the
# two calls of `checked(checked(x))` (112,29 inner, 112,21 outer: 4,0), a
# raising constructor (113), a method (114) and `Int(s)` (115); one in a
# loop (125,25). `outside`'s call (30), whose error goes to its caller, and
# `raise` (48) give no record. A classifier without the `try` rule loses
# every try record; one ignoring the `try:` scope records 70 (and
# lookup.mojo's 7,13); one keeping LLVM's arm order gives 23,20 as 0,1.
# values.mojo: an `and`/`or` whose result no branch tests is a decision of
# its own two arms, the right operand skipped or evaluated, with no `rhs`:
# returned (`both_set`'s select 31,14: 1,1; `either_small`'s short-circuit
# 35,21: 1,1; `nested_values` 48,18 and its inner `or` 48,32: 0,1),
# stored (39,19), passed to a call (44,24: 0,1, the right operand never
# skipped), with a raising right operand (`and` 52,18: 2,0, and `or`
# 56,18: 1,1, its error flag a phi beside the result). In `guarded`, a
# `try:` body's `if a > 0 and strict(b):`, the call is a `try` decision
# (61,28: returned 1, raised 1) and the `if` (61,9) ran 2 of the `and`'s 3
# times (the raise skips it): no test of this result, so 61,18 is its own
# two arms (2,1). Where a branch does test the result its right
# operand is counted as before: `digit`, a plain @always_inline helper
# inlined twice, is tested by the `if` (folded into a select, 71,9) in one
# copy and passed on in the other: 27,20 sums both copies (5,1) and its
# rhs is the tested copy's (2,1); in `folded`, Mojo folds `if a > 0 and
# is_even(b): hit = True` away and the `if hit:` select (91,5) tests the
# `and`'s phi itself (89,14 rhs 1,1). `lowers`'s `lower = c >= 97 and ...`
# is tested only when `i != 0` (the `or` at 81,46), two of its three runs:
# no test of this result, so 80,29 is its own two arms (2,1) and no rhs; the
# `or`'s result merges with `lower` in a phi before the `if ok:`, which no
# rule follows: 81,46 is its own two arms too. A classifier refusing an
# untested and/or (as it first did: `return a or b` refused) fails here; one
# dropping its record loses 31,14 to 52,18; one deriving a right operand
# from a test of other counts writes 80,29:rhs and 61,18:rhs.
# test_gate_env calls none of branchlib: its record file is empty.
# test_unrun asserts two known equal Tags equal: assert_equal's failure path,
# which writes them (unrun.mojo's Tag.write_to), is a branch Mojo folds to
# never taken, so the instrumented link drops Tag.write_to with its counters
# and the run's profile holds no record of it. Its `if` (24,9) is one record
# with both arms never run (`-`); an annotation refusing a function the
# profile lacks fails this test's [branch_ir] (as every one did, naming
# Tag::write_to among 182), and one dropping such a function's branches
# gives an empty file.
cov_report_check(
    name = "branch_info",
    goldens = [
        "golden/test_score_arms.info",
        "golden/test_unrun.info",
    ],
    mode = "golden",
    reports = [
        ":branchlib[coverage][branch_info][test_score_arms]",
        ":branchlib[coverage][branch_info][test_unrun]",
    ],
    script = "report.sh",
)

# Test 47: the branch coverage link of test_score_arms is the link of its
# release build plus the profile runtime: mojo_wrapper.sh's `cc` shim gives
# zig what `mojo build` asks for (the compiler's runtime library,
# --gc-sections, -lm, the shim's --strip-debug and run path), and
# cov_branch_link.sh gives zig the same line for the instrumented object
# (link_line.sh). A Mojo release linking with another library, or a link
# script that drops one, fails here.
cov_link_line_check(
    name = "link_line",
    bc = ":branchlib[coverage][bc][test_score_arms]",
    exec_compatible_with = LINUX_X86_64,
    lib = ":branchlib",
    script = "link_line.sh",
    src = "tests/test_score_arms.mojo",
)

# Test 47: the bitcode and the instrumented binary of one test built in two
# actions with different keys (repro_a and repro_b, above), so two
# sandboxes, are the same bytes. No --no-remote-cache.
cov_debug_check(
    name = "reproducible_branch",
    bins = [
        ":repro_a[coverage][bc][test_same]",
        ":repro_b[coverage][bc][test_same]",
    ],
    mode = "same",
    script = "check.sh",
)

cov_debug_check(
    name = "reproducible_pgo_bin",
    bins = [
        ":repro_a[coverage][pgo_bin][test_same]",
        ":repro_b[coverage][pgo_bin][test_same]",
    ],
    mode = "same",
    script = "check.sh",
)

