# The functional test scripts run_tests.sh runs on the client (see ../README.md).
# `//...` does not reach into this cell, so //:tests_lints (the root BUCK)
# names this lint, and `./buck2 build //...` runs it.
load("@komira//tools/build/lint:defs.bzl", "shell_lint")

shell_lint(
    name = "shell_lint",
    srcs = glob(["*.sh"]),
    visibility = ["komira//:tests_lints"],
)
