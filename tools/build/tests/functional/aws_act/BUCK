load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# The process behaviour of `aws_act gen` (tools/build/cloud/aws_act.zig): the
# generator's arguments and exit status, the files written, and each refusal,
# over a stand-in generator (fake_gen.zig). A driver test: aws_act is a built
# tool it runs by absolute path. The unit tests of its check are
# tools/build/cloud:aws_act_unit; every mojo_aws_client runs through it too.

zig_exe(
    name = "fake_gen",
    exec_compatible_with = LINUX_X86_64,
    src = "fake_gen.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_test(
    name = "driver",
    exec_compatible_with = LINUX_X86_64,
    exec_tools = {
        "AWS_ACT": "komira//tools/build/cloud:aws_act",
        "FAKE_GEN": ":fake_gen",
    },
    src = "driver_test.zig",
    deps = ["tests//functional/driver_kit:driver_kit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)
