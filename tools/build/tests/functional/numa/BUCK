load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_multi_numa_test")
load(":defs.bzl", "numa_gate_run", "numa_guard_cases")

# Requires an execution platform providing
# komira//tools/build/platforms:numa_multi. A standalone checkout registers
# none unless `[komira_re] mojo_compile_multi_numa_properties` is set, so
# building this must fail to configure (tools/build/tests/run_tests.sh,
# test 10). Given a platform whose workers
# span only one NUMA node, the run refuses to start (test 11).
# A test program, not a shipped binary: -O1, like a mojo_test.
mojo_binary(
    name = "hello",
    srcs = ["hello.mojo"],
    optimization_level = "1",
)

mojo_multi_numa_test(
    name = "hello_multi_numa",
    binary = ":hello",
    expected_stdout = "hello from mojo\n",
)

# Every verdict of the multi-NUMA run guard, on made-up topologies (test 11).
numa_guard_cases(
    name = "guard_cases",
    script = "guard_cases.sh",
)

# hello_multi_numa's `buck2 test` command without the NUMA guard, run in one
# action: the gate runner must accept the rule's own arguments and pass.
# Needs a numa_multi platform to configure (run_tests.sh uses the stand-in).
numa_gate_run(
    name = "gate_run",
    test = ":hello_multi_numa",
)

shell_lint(
    name = "shell_lint",
    srcs = ["guard_cases.sh"],
    visibility = ["komira//:tests_lints"],
)
