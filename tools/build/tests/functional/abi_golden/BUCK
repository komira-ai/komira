load("@komira//tools/build/mojo:abi_golden.bzl", "komira_abi_golden")

# The twin of tests//negative/abi_golden: the sources every defect there is
# measured against. It builds.
komira_abi_golden(
    name = "ok",
    src = "good.mojo",
    golden = "good.tsv",
)

# The same, with constants held to a constants file: the header defines them.
komira_abi_golden(
    name = "ok_constants",
    src = "good.mojo",
    constants_src = "consts.mojo",
    golden = "good_consts.tsv",
)

# CStr and ConstBytes declared as the pointers to UInt8 the tool expects.
komira_abi_golden(
    name = "ok_named",
    src = "named.mojo",
    golden = "named.tsv",
)
