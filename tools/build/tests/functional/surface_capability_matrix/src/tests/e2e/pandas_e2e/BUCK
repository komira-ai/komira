load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_test")

# Test 53 (the surface capability matrix): the planted pandas surface e2e
# package. Never built: the matrix lint only analyses these targets.
#   pandas_e2e   a mojo_library whose test_srcs weld a test (WeldedTestsInfo),
#                so a row may name it
#   test_filter  a mojo_test (ExternalRunnerTestInfo), so a row may name it
#   data.csv     no test, so a row naming it is a finding (negative not_test)

mojo_library(
    name = "pandas_e2e",
    srcs = ["__init__.mojo"],
    test_srcs = ["tests/test_scan_csv.mojo"],
    conda = False,
    visibility = ["PUBLIC"],
)

mojo_test(
    name = "test_filter",
    main = "tests/test_filter.mojo",
    srcs = ["tests/test_filter.mojo"],
    visibility = ["PUBLIC"],
)

export_file(
    name = "data.csv",
    visibility = ["PUBLIC"],
)
