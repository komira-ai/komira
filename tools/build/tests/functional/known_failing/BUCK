load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The tests of mojo_library's `tests_known_failing` (a hold that inverts: the
# held test still runs and must FAIL). tools/build/tests/run_tests.sh builds
# each target and requires the verdict written above it.

_SRCS = [
    "__init__.mojo",
    "value.mojo",
]

# GREEN: the held test fails as its row says, the other test passes.
mojo_library(
    name = "held_ok",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = [
        "tests/test_passes.mojo",
        "tests/test_fails.mojo",
    ],
    tests_known_failing = {
        "tests/test_fails.mojo": {
            "issue": "#1",
            "reason": "fixture: test_fails raises whenever answer() is 42, which it always is.",
        },
    },
)
