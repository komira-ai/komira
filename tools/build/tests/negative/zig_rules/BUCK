load("@komira//tools/build/mojo:script_test.bzl", "script_test")
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_module", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# Planted defects for the Zig rules (K1-K3) and script_test (K4); the cases
# that work are tests//functional/zig_rules. Every target here must fail, and
# tools/build/selftest requires the text named in its row of
# analysis_refusals_zig_rules (analysis) or planted_red_builds_zig_rules (an
# action fails). What each plants is written above it.

_BUSYBOX = "komira//tools/build/toolchains:busybox"
_ZIG = "komira//tools/build/toolchains:zig"
_PKG = "negative/zig_rules/"

# ---- zig_module deps ----------------------------------------------------------

# REFUSED "two different modules are imported as": two modules named `shared`
# reached through different deps.
zig_module(
    name = "through_a",
    deps = ["//negative/zig_rules/clash_a:shared"],
    src = "through_a.zig",
)

zig_module(
    name = "through_b",
    deps = ["//negative/zig_rules/clash_b:shared"],
    src = "through_b.zig",
)

zig_exe(
    name = "name_clash",
    exec_compatible_with = LINUX_X86_64,
    deps = [":through_a", ":through_b"],
    src = "use_clash.zig",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# RED "no module named 'zr_leaf' available within module root": the importer
# declares zr_mid, not zr_leaf; zr_mid's own dep is not visible to it.
zig_exe(
    name = "dep_of_dep_not_visible",
    exec_compatible_with = LINUX_X86_64,
    deps = ["//functional/zig_rules:zr_mid"],
    src = "direct.zig",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# RED "no module named 'zr_leaf' available within module zr_mid_nodeps": a
# module that imports a module it does not declare.
zig_module(
    name = "zr_mid_nodeps",
    src = "mid_nodeps.zig",
)

zig_exe(
    name = "module_without_deps",
    exec_compatible_with = LINUX_X86_64,
    deps = [":zr_mid_nodeps"],
    src = "via_nodeps.zig",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# ---- optimize, strip, target ----------------------------------------------------

# REFUSED "optimize \"Fast\" is not a zig optimization mode".
zig_exe(
    name = "exe_unknown_optimize",
    exec_compatible_with = LINUX_X86_64,
    optimize = "Fast",
    src = "direct.zig",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

zig_test(
    name = "test_unknown_optimize",
    exec_compatible_with = LINUX_X86_64,
    optimize = "Fast",
    src = "direct.zig",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# REFUSED "is not a zig target triple".
zig_test(
    name = "test_bad_target",
    exec_compatible_with = LINUX_X86_64,
    src = "direct.zig",
    target = "x86 64",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# RED "expected builtin.OptimizeMode.ReleaseFast, found builtin.OptimizeMode.Debug": the test that passes with optimize = "ReleaseFast"
# (functional/zig_rules:optimize_unit), built with the default mode.
zig_test(
    name = "optimize_not_applied",
    exec_compatible_with = LINUX_X86_64,
    src = "//functional/zig_rules:optimize_test.zig",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# RED "expected Target.Abi.gnu, found Target.Abi.musl": the test that passes with target =
# "x86_64-linux-gnu" (functional/zig_rules:target_unit), built for the default
# musl.
zig_test(
    name = "target_not_applied",
    exec_compatible_with = LINUX_X86_64,
    src = "//functional/zig_rules:target_test.zig",
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# RED "got '42 Debug', expected '42 ReleaseSafe'": the Debug build is not the
# default one, so optimize reaches the compile.
script_test(
    name = "debug_is_not_release_safe",
    args = [
        "modes.check",
        "$(location //functional/zig_rules:app_debug)",
        "42 ReleaseSafe",
    ],
    cmd = "sh",
    srcs = {"modes.check": "//functional/zig_rules:modes.check"},
)

# RED "is unstripped, expected stripped": strip = False keeps debug information.
script_test(
    name = "unstripped_is_not_stripped",
    args = [
        "stripped.check",
        "$(location //functional/zig_rules:app_debug)",
        "stripped",
    ],
    cmd = "sh",
    srcs = {"stripped.check": "//functional/zig_rules:stripped.check"},
)

# ---- script_test ----------------------------------------------------------------

# RED "script_test: sh exited with status 3" and the command's own output.
script_test(
    name = "fails",
    args = [_PKG + "boom.check"],
    cmd = "sh",
    srcs = ["boom.check"],
)

# RED "script_test: no_such_command_anywhere exited with status 127".
script_test(
    name = "command_missing",
    cmd = "no_such_command_anywhere",
)

# RED the same: a failed script_test keeps a zig_exe that lists it in
# unit_tests from being built.
zig_exe(
    name = "welded_to_a_failure",
    exec_compatible_with = LINUX_X86_64,
    src = "direct.zig",
    unit_tests = [":fails"],
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# RED "a declared tool is not on PATH by another name": the command exits 127.
script_test(
    name = "tool_under_another_name",
    args = ["--version"],
    cmd = "zigg",
    tools = {"zig": _ZIG},
)

# REFUSED "cmd is empty".
script_test(
    name = "cmd_empty",
    cmd = "",
)

# REFUSED "env name 1BAD is not a shell variable name".
script_test(
    name = "env_bad_name",
    cmd = "true",
    env = {"1BAD": "x"},
)

# REFUSED "env sets HOME, which the action sets itself".
script_test(
    name = "env_sets_home",
    cmd = "true",
    env = {"HOME": "/elsewhere"},
)

# REFUSED "env sets ZIG_GLOBAL_CACHE_DIR, which the action sets itself".
script_test(
    name = "env_sets_zig_cache",
    cmd = "true",
    env = {"ZIG_GLOBAL_CACHE_DIR": "/elsewhere"},
)

# REFUSED "tool name a/b is not a file name".
script_test(
    name = "tool_name_with_slash",
    cmd = "true",
    tools = {"a/b": _ZIG},
)

# REFUSED "data destination ok.check is both a file and the directory of".
script_test(
    name = "src_file_and_directory",
    cmd = "true",
    srcs = {
        "d": "ok.check",
        "d/inner": "ok.check",
    },
)
