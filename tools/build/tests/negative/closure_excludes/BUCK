load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# mojo_library's `closure_excludes` (tools/build/mojo/defs.bzl): each library
# depends on one package that the host profile's closure may not hold
# (src/host_profile/BUCK) and excludes that package by its import name. Every target here must fail at analysis, naming the package;
# //tools/build/selftest:analysis_refusals_mojo requires the text.
# The leaf's own BUCK file holds the same four names; its closure holds
# async_api, which an exact comparison does not refuse. The lowering
# package's BUCK file holds these four and the three at the end of this file.

mojo_library(
    name = "fs",
    srcs = ["__init__.mojo"],
    conda = False,
    import_name = "closure_excludes_fs",
    deps = ["komira//src/fs:fs"],
    closure_excludes = ["fs"],
)

mojo_library(
    name = "objectstore",
    srcs = ["__init__.mojo"],
    conda = False,
    import_name = "closure_excludes_objectstore",
    deps = ["komira//src/objectstore:objectstore"],
    closure_excludes = ["objectstore"],
)

mojo_library(
    name = "async_runtime",
    srcs = ["__init__.mojo"],
    conda = False,
    import_name = "closure_excludes_async_runtime",
    deps = ["komira//src/async_rt:async_rt"],
    closure_excludes = ["async_rt"],
)

mojo_library(
    name = "shuffle",
    srcs = ["__init__.mojo"],
    conda = False,
    import_name = "closure_excludes_shuffle",
    deps = ["komira//src/shuffle:shuffle"],
    closure_excludes = ["shuffle"],
)

# The three packages lowering's closure may not hold besides those four
# (src/lowering/BUCK): the host measurement and runtime package, the
# optimizer and the SQL front end.
mojo_library(
    name = "engine_runtime",
    srcs = ["__init__.mojo"],
    conda = False,
    import_name = "closure_excludes_engine_runtime",
    deps = ["komira//src/engine_runtime:engine_runtime"],
    closure_excludes = ["engine_runtime"],
)

mojo_library(
    name = "optimizer",
    srcs = ["__init__.mojo"],
    conda = False,
    import_name = "closure_excludes_optimizer",
    deps = ["komira//src/optimizer:optimizer"],
    closure_excludes = ["optimizer"],
)

mojo_library(
    name = "sql",
    srcs = ["__init__.mojo"],
    conda = False,
    import_name = "closure_excludes_sql",
    deps = ["komira//src/sql:sql"],
    closure_excludes = ["sql"],
