load("@komira//tools/build/mojo:abi_golden.bzl", "komira_abi_golden")

# Every komira_abi_golden below must FAIL to build, each for one defect against
# the sources of tests//functional/abi_golden:ok (good.mojo and good.tsv, which
# build). tools/build/selftest:planted_red_builds_abi_golden requires each to fail naming its finding.

# The golden says neg_add returns Int64; the source returns Int32.
komira_abi_golden(
    name = "drift",
    src = "good.mojo",
    golden = "drift.tsv",
)

# The golden lists neg_fill; the source no longer exports it.
komira_abi_golden(
    name = "removed",
    src = "removed.mojo",
    golden = "good.tsv",
)

# The source exports neg_extra; the golden has no row for it.
komira_abi_golden(
    name = "added",
    src = "added.mojo",
    golden = "good.tsv",
)

# Source and golden agree on a type, Bool, that the type map does not have.
komira_abi_golden(
    name = "unknown_type",
    src = "unknown.mojo",
    golden = "unknown.tsv",
)

# A row says it was added in 1.2; the golden is version 1.1.
komira_abi_golden(
    name = "since_above_version",
    src = "good.mojo",
    golden = "since.tsv",
)

# The golden says neg_add takes (Int32, Int64); the source takes (Int32, Int32).
komira_abi_golden(
    name = "arg_drift",
    src = "good.mojo",
    golden = "arg_drift.tsv",
)

# The golden says KOMIRA_NEG_LIMIT is 4096; the constants file says 2 * 1024.
komira_abi_golden(
    name = "const_value",
    src = "good.mojo",
    constants_src = "consts.mojo",
    golden = "const_value.tsv",
)

# The golden lists KOMIRA_NEG_GONE; the constants file declares no such comptime.
komira_abi_golden(
    name = "const_missing",
    src = "good.mojo",
    constants_src = "consts.mojo",
    golden = "const_missing.tsv",
)

# The constants file declares KOMIRA_NEG_LIMIT; the golden has no row for it.
komira_abi_golden(
    name = "const_extra",
    src = "good.mojo",
    constants_src = "consts.mojo",
    golden = "const_extra.tsv",
)

# The golden lists constants and the target names no file to hold them to.
komira_abi_golden(
    name = "const_unheld",
    src = "good.mojo",
    golden = "consts_good.tsv",
)

# neg_open takes a CStr and the source never declares the alias.
komira_abi_golden(
    name = "named_undeclared",
    src = "named_undeclared.mojo",
    golden = "named.tsv",
)

# The source declares CStr as a pointer to Int32; the header would say `const char *`.
komira_abi_golden(
    name = "named_wrong",
    src = "named_wrong.mojo",
    golden = "named.tsv",
)
