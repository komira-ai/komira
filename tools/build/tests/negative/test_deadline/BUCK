load("@komira//tools/build/mojo:defs.bzl", "mojo_test")

# The target whose `buck2 test` command carries the time limit of a mojo_test
# (`gate mojo --deadline-s`, tools/build/run). The scenario config_refusals
# (tools/build/selftest/config_refusals.zig) reads the command under
# `-c komira.test_timeout_s=90` and requires `--deadline-s 30
# --runner-timeout-s 90`; it is not run, because a time limit is checked on a
# clock the gate's tests move themselves, not by sleeping past it. The test
# returns at once.
mojo_test(
    name = "test_slow",
    srcs = ["test_slow.mojo"],
)
