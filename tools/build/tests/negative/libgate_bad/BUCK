load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

mojo_library(
    name = "libgate_bad",
    srcs = [
        "__init__.mojo",
        "payload.mojo",
    ],
    test_srcs = ["tests/test_payload_deliberate_failure.mojo"],
)

# Must FAIL with GATED TEST FAILED: a consumer of the library waits on the
# library's gate, so it cannot be built while the library's test fails.
mojo_binary(
    name = "gated_consumer",
    srcs = ["consumer.mojo"],
    deps = [":libgate_bad"],
)

# Must FAIL at analysis: `[ungated]` carries no MojoInfo, so naming it in
# `deps` cannot be used to compile against a library whose tests fail.
mojo_binary(
    name = "bypass_consumer",
    srcs = ["consumer.mojo"],
    deps = [":libgate_bad[ungated]"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["tests//:doc_tree"],
)
