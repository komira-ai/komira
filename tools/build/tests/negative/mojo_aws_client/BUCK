    deps = _RUNTIME,
)

# "env_t_string.mojo has a t-string, which the environment scan does not
# read", in the build: the braces of a t-string hold code with strings of
# their own, so the scan cannot say where the t-string ends.
mojo_aws_client(
    name = "env_read_t_string",
    hand_srcs = ["hand/env_t_string.mojo"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/env_t_string.json",
    deps = _RUNTIME,
)

# "env_t_upper.mojo has a t-string, which the environment scan does not read", in
# the build: a t-string of prefix `T` holds a quote in its braces, then the
# import follows after `;`; read as a plain string, it would hide the import (the
# prefix is read in any case).
mojo_aws_client(
    name = "env_read_t_upper",
