# "env_triple_escape.mojo imports std.pathlib, which is not on the environment scan's
# import allow-list (mojo_aws_client's _ENV_IMPORTS)", in the build:
# a triple-quoted string ends in an escaped `\"`, then the import follows
# after `;`; read without the escape, the string would close one quote
# early and the quote left over would hide the import.
mojo_aws_client(
    name = "env_read_triple_escape",
    hand_srcs = ["hand/env_triple_escape.mojo"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/env_triple_escape.json",
    deps = _RUNTIME,
)

