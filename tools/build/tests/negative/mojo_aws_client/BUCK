load("@komira//third_party/botocore:models.bzl", "botocore_model")
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# mojo_aws_client targets that must fail, over the pinned botocore CloudWatch Logs
# model and the stub runtime of ../../functional/mojo_aws_client. Each refusal is
# in its own target, so this package loads and every target fails on its
# own. run_tests.sh (test 36) builds each as an expect_red, requiring the
# text quoted above the target.

_LOGS = botocore_model("logs")

_RUNTIME = [
    "//functional/mojo_aws_client:komira_aws_core",
    "//functional/mojo_aws_client:komira_json",
]

# "`operations` is empty", at analysis: the client is operation-scoped.
mojo_aws_client(
    name = "no_operations",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = [],
    deps = _RUNTIME,
)

# "is not a botocore operation name", at analysis: two operations joined into
# one entry would be split by the generator into a scope the BUCK file does
# not show.
mojo_aws_client(
    name = "joined_operations",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents,FilterLogEvents"],
    deps = _RUNTIME,
)

# "`deps` is empty", at analysis: no runtime is added by default.
mojo_aws_client(
    name = "no_runtime",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    deps = [],
)

# "GetLogEvent", in the build: an operation the model does not declare is
# refused by the generator (the analysis check only reads the name's shape).
mojo_aws_client(
    name = "unknown_operation",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvent"],
    deps = _RUNTIME,
)

# "GATED TEST FAILED: tests//negative/mojo_aws_client:caller_test_red:
# test_logs_deliberate_failure.mojo": a failing caller `test_srcs` entry
# blocks the client like any library's test, next to the generated layout
# probe (which passes, so the red is the caller's test and no other).
mojo_aws_client(
    name = "caller_test_red",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    test_srcs = ["test_logs_deliberate_failure.mojo"],
    deps = _RUNTIME,
)

# "`operations` names `GetLogEvents` twice", at analysis.
mojo_aws_client(
    name = "duplicate_operation",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = [
        "GetLogEvents",
        "GetLogEvents",
    ],
    deps = _RUNTIME,
)

# "`overrides` is set and `hand_srcs` is empty", at analysis.
mojo_aws_client(
    name = "overrides_without_hand_srcs",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/overrides.json",
    deps = _RUNTIME,
)

# "`endpoint_rules` and `partitions` are set together", at analysis: the
# ruleset's aws.partition reads the partition table. Its run_tests.sh row is
# to be added with the next edit of that file: expect_red
# aws_client_endpoint_rules_without_partitions 'are set together'
# tests//negative/mojo_aws_client:endpoint_rules_without_partitions
mojo_aws_client(
    name = "endpoint_rules_without_partitions",
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    endpoint_rules = _LOGS.endpoint_rules,
    deps = _RUNTIME,
)

# "`hand_srcs` is set and `overrides` is not", at analysis.
mojo_aws_client(
    name = "hand_srcs_without_overrides",
    hand_srcs = ["hand/hand_owner.mojo"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    deps = _RUNTIME,
)

export_file(
    name = "hand_owner_label",
    src = "hand/hand_owner.mojo",
)

# "is not a source path of a `.mojo` file", at analysis: a label, whose
# output's name the package would take without the BUCK file showing it.
mojo_aws_client(
    name = "hand_src_is_label",
    hand_srcs = [":hand_owner_label"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/overrides.json",
    deps = _RUNTIME,
)

# "is not a source path of a `.mojo` file", at analysis: a file the library
# would not compile.
mojo_aws_client(
    name = "hand_src_not_mojo",
    hand_srcs = ["hand/notes.txt"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/overrides.json",
    deps = _RUNTIME,
)

# "has the name of a generated or another hand-written file", at analysis:
# copied into the package, it would overwrite the generated layout probe.
mojo_aws_client(
    name = "hand_src_clashes",
    hand_srcs = ["hand/_layout_probe.mojo"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/overrides.json",
    deps = _RUNTIME,
)

# "the botocore service id cannot be read from the model path", at analysis:
# a model outside botocore's `<service>/<api version>/service-2.json` layout
# with no `service` naming it.
mojo_aws_client(
    name = "service_unreadable",
    model = "not_botocore_layout.json",
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    deps = _RUNTIME,
)

# "env_reader.mojo names getenv; a mojo_aws_client package takes every input
# as a parameter", in the build: the package compiles, and its generated
# environment scan (_no_env_reads) reads every file of it, the hand-written
# module that reads HOME included, and fails.
mojo_aws_client(
    name = "env_read_hand",
    hand_srcs = ["hand/env_reader.mojo"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/env_reader.json",
    deps = _RUNTIME,
)

# "env_home.mojo imports std.pathlib, which is not on the environment scan's
# import allow-list (mojo_aws_client's _ENV_IMPORTS)", in the build: the
# hand-written module reads HOME through Path.home and names nothing the scan
# bans, so the import allow-list is what refuses it.
mojo_aws_client(
    name = "env_read_home",
    hand_srcs = ["hand/env_home.mojo"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/env_home.json",
    deps = _RUNTIME,
)

# "env_std_os.mojo names expanduser; a mojo_aws_client package takes every
# input as a parameter", in the build: `from std import os` does not contain
# the banned dotted module name, and os.path.expanduser reads HOME.
mojo_aws_client(
    name = "env_read_std_os",
    hand_srcs = ["hand/env_std_os.mojo"],
    model = _LOGS.model,
    model_sha256 = _LOGS.sha256,
    operations = ["GetLogEvents"],
    overrides = "hand/env_std_os.json",
    deps = _RUNTIME,
)

