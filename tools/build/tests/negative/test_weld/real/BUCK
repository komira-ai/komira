load("@komira//tools/build/lint:test_weld.bzl", "test_weld")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_test")
load(":tree.bzl", "REAL_TREE", "check_real_tree")

# Test 39 (test_weld) over the real rules: what a mojo_library and a mojo_test
# give the lint (WeldedTestsInfo, tools/build/mojo/providers.bzl). Never
# built: the lint only analyses the targets `welds` matches.
#
# Under src/komira_real/tests/, by how each test file is (not) welded:
#   test_listed.mojo     welded: an entry of a computed test_srcs
#   test_commented.mojo  not welded: named only in a comment of that list
#   test_main.mojo       welded: the `main` of a mojo_test
#   test_imported.mojo   not welded: another `srcs` of that mojo_test, which
#                        its binary compiles but never runs
#   test_shared.mojo     not welded: test_srcs names komira_other's file of
#                        that name by label, and that file is the one welded

_OTHER_SHARED = "//negative/test_weld/real/src/komira_other:tests/test_shared.mojo"

# REAL_TREE (tree.bzl) is what tests//functional/test_weld/real:ok, the green
# half, gives the lint; a file added here and not to the list would be seen
# by `red` alone, which the pull-request check does not build. Loading this
# package, as resolving `ok` does, fails unless the two agree.
check_real_tree(glob(["src/komira_real/**"]))

mojo_library(
    name = "komira_real",
    srcs = ["src/komira_real/__init__.mojo"],
    test_srcs = ["src/komira_real/tests/test_{}.mojo".format(t) for t in ["listed"]] + [_OTHER_SHARED] + [
        # "src/komira_real/tests/test_commented.mojo",
    ],
    conda = False,
)

mojo_test(
    name = "test_main",
    srcs = [
        "src/komira_real/tests/test_main.mojo",
        "src/komira_real/tests/test_imported.mojo",
    ],
    main = "src/komira_real/tests/test_main.mojo",
    deps = [":komira_real"],
)

# `red` has no ledger row, so it must name exactly the three unwelded files
# (run_tests.sh checks it). Its green twin, which holds those three in its
# ledger, is tests//functional/test_weld/real:ok, over these files.
test_weld(
    name = "red",
    files = glob(["src/komira_real/**"]) + [_OTHER_SHARED],
    known_untested = "ledger_empty.tsv",
    root = "negative/test_weld/real/src",
    welds = "//negative/test_weld/real/...",
)

[
    export_file(
        name = f,
        mode = "reference",
        visibility = ["//functional/test_weld/real:"],
    )
    for f in REAL_TREE
]
