load("@komira//tools/build/lint:test_weld.bzl", "test_weld")
load("//functional/test_weld:fixture.bzl", "TEST_WELD_FLOOR", "TEST_WELD_LEDGER", "TEST_WELD_TREE")

# Test 39 (test_weld), the half that must go red: one planted defect per
# target, in the tree of functional/test_weld (whose `ok` holds it exactly).
# run_tests.sh requires each to fail naming its finding, counts included.
[
    test_weld(
        name = name,
        coverage_floor = floor or TEST_WELD_FLOOR,
        files = TEST_WELD_TREE,
        known_untested = ledger or TEST_WELD_LEDGER,
        root = root,
    )
    for name, ledger, floor, root in [
        # test_dead.mojo has no ledger row.
        ("unwelded", "ledger_unwelded.tsv", None, "src"),
        # komira_b has no ledger row.
        ("untested", "ledger_untested.tsv", None, "src"),
        # A row for a package that welds a test: the ledger only shrinks.
        ("shrink_package", "ledger_shrink_package.tsv", None, "src"),
        # A row for a test file that is welded.
        ("shrink_file", "ledger_shrink_file.tsv", None, "src"),
        # Rows for a package with no .mojo and for a file that does not exist.
        ("nothing", "ledger_nothing.tsv", None, "src"),
        # A row with no reason.
        ("malformed", "ledger_malformed.tsv", None, "src"),
        # komira_a welds 2 test files; its floor says 3.
        ("floor_files", None, "floor_files.tsv", "src"),
        # komira_a has 3 test functions and komira_c 1; their floors say 4 and 2.
        ("floor_functions", None, "floor_functions.tsv", "src"),
        # A floor row for komira_b, which welds no test.
        ("floor_untested", None, "floor_untested.tsv", "src"),
        # No package under the root: the lint checks nothing, so it fails.
        ("empty", None, None, "nosuch"),
    ]
]
