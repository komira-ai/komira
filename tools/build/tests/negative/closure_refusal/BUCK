load("@komira//tools/build/mojo:defs.bzl", "mojo_binary")
load("@komira//tools/build/mojo:toolchain.bzl", "mojo_toolchain")
load(":defs.bzl", "compiler_without_member")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

# The compiler closure minus one runtime library it needs.
compiler_without_member(
    name = "compiler_missing_member",
    delete = "lib/libKGENCompilerRTShared.so",
)

mojo_toolchain(
    name = "incomplete_toolchain",
    busybox = "komira//tools/build/toolchains:busybox",
    cc_target = "x86_64-linux-gnu.2.34",
    compiler = ":compiler_missing_member",
    runtime = "komira//tools/build/toolchains:mojo_runtime",
    target_cpu = "x86-64-v3",
    zig = "komira//tools/build/toolchains:zig",
)

# Must FAIL: the wrapper refuses (exit 2) before running the compiler,
# naming the missing member, instead of falling back to anything on the host.
mojo_binary(
    name = "hello_incomplete_toolchain",
    srcs = ["hello.mojo"],
    toolchain = ":incomplete_toolchain",
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["tests//:doc_tree"],
)
