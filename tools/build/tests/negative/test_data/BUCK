load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_test")

# Planted defects for the test runtime contract (test 29): a test reading a
# file it did not declare, env that tries to mute a red test, and every
# inadmissible data/env declaration. Every target here must fail;
# tools/build/tests/run_tests.sh requires the failure written above it. The
# contract that works is in ../../functional/test_data.

_SRCS = [
    "__init__.mojo",
    "value.mojo",
]

# RED (GATED TEST FAILED): the test opens a repository file it did not declare.
mojo_library(
    name = "undeclared",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_undeclared.mojo"],
    test_data = {
        "tests/test_reads_undeclared.mojo": ["fixtures/declared.txt"],
    },
)

# RED (GATED TEST FAILED): a test's env reaches the test only, never the
# runner's own variables, so naming one of them cannot mute a red test.
# Exported into the runner, BIN=true would run `true` in place of the test
# and the gate would pass.
mojo_library(
    name = "env_bin_lib",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_red.mojo"],
    test_env = {"BIN": "true"},
)

# RED under `buck2 test`: env {"BIN": "true"} does not run `true` in place of
# the test.
mojo_test(
    name = "env_bin",
    srcs = ["tests/test_red.mojo"],
    env = {"BIN": "true"},
)

# Refused at analysis, each with its own message.
mojo_library(
    name = "bad_dest",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_data = {"tests/test_reads_declared.mojo": {"../escape.txt": "fixtures/declared.txt"}},
)

mojo_library(
    name = "bad_dest_clash",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_data = {"tests/test_reads_declared.mojo": {
        "a": "fixtures/declared.txt",
        "a/b.txt": "fixtures/declared.txt",
    }},
)

mojo_library(
    name = "bad_data_entry",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_data = {"tests/test_nope.mojo": ["fixtures/declared.txt"]},
)

mojo_library(
    name = "bad_env_owned",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_env = {"TEST_TMPDIR": "/tmp"},
)

mojo_test(
    name = "bad_env_name",
    srcs = ["tests/test_mojo_test_data.mojo"],
    env = {"NOT-A-NAME": "x"},
)
