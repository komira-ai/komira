load("@komira//tools/build/lint:defs.bzl", "src_layout")
load("//functional/src_layout:fixture.bzl", "SRC_LAYOUT_PACKAGES", "SRC_LAYOUT_SHIPPED")

# Test 45 (src_layout), the half that must go red: one planted defect per
# target, added to the list of functional/src_layout (whose `ok` holds it).
# run_tests.sh requires each to fail naming its finding.
[
    src_layout(
        name = name,
        packages = SRC_LAYOUT_PACKAGES + extra,
        shipped = shipped if shipped != None else SRC_LAYOUT_SHIPPED,
    )
    for name, extra, shipped in [
        # A test-only package of each kind directly under src/.
        ("top_e2e", ["src/komira_foo_e2e"], None),
        ("top_loopback", ["src/komira_foo_loopback"], None),
        ("top_conformance", ["src/komira_foo_conformance"], None),
        # A test harness komira does not ship, directly under src/.
        ("top_test_library", ["src/komira_test_unlisted"], None),
        # A `shipped` name that is no package directly under src/.
        ("shipped_missing", [], SRC_LAYOUT_SHIPPED + ["komira_test_gone"]),
        # A package nested where no package directory is.
        ("nested", ["src/komira_a_extra/komira_x_e2e"], None),
        # src/tests: a kind it does not hold, a package not at
        # tests/<kind>/<name>, and packages under the wrong kind.
        ("bad_kind", ["src/tests/bench/komira_y"], None),
        ("shallow", ["src/tests/komira_z_e2e"], None),
        ("e2e_in_conformance", ["src/tests/conformance/komira_w_e2e"], None),
        ("conformance_in_e2e", ["src/tests/e2e/komira_v_conformance"], None),
        ("e2e_in_helpers", ["src/tests/helpers/komira_u_loopback"], None),
        ("harness_in_e2e", ["src/tests/e2e/komira_t"], None),
    ]
]

# The module map (`map`): one planted defect each, against the map of
# functional/src_layout or a copy of it.
[
    src_layout(
        name = name,
        map = map,
        packages = packages,
        shipped = SRC_LAYOUT_SHIPPED,
    )
    for name, map, packages in [
        # A package with no row: a new package the map does not list.
        ("map_missing_row", "//functional/src_layout:map.txt", SRC_LAYOUT_PACKAGES + ["src/komira_new"]),
        # A row for a path that is no package: a package deleted or moved
        # while its row stayed.
        ("map_stale_row", "//functional/src_layout:map.txt", [p for p in SRC_LAYOUT_PACKAGES if p != "src/komira_a"]),
        # Two rows for one package.
        ("map_duplicate_row", "map_duplicate_row.txt", SRC_LAYOUT_PACKAGES),
        # A row whose name is not its link's directory.
        ("map_misnamed_row", "map_misnamed_row.txt", SRC_LAYOUT_PACKAGES),
    ]
]

# No package under the root: the lint checks nothing, so it fails.
src_layout(
    name = "empty",
    packages = ["tools/komira_tool"],
)
