load("@komira//tools/build/lint:defs.bzl", "public_boundary")
load("//functional/public_boundary:fixture.bzl", "PB_HOLDS", "PB_HOSTS", "PB_TREE", "PB_WINDOW")

# The public boundary lint's analysis refusals, which
# //tools/build/selftest:analysis_refusals_lint requires. What the lint finds
# in a tree is tested by the tool's own tests
# (//tools/build/lint/public_boundary).

# Neither `tree` nor `files`: refused at analysis.
public_boundary(
    name = "no_tree",
    holds = PB_HOLDS,
    hosts = PB_HOSTS,
    **PB_WINDOW
)

# Both `tree` and `files`: refused at analysis.
public_boundary(
    name = "both_tree_and_files",
    files = PB_TREE,
    holds = PB_HOLDS,
    hosts = PB_HOSTS,
    tree = ":doc_tree",
    **PB_WINDOW
)
