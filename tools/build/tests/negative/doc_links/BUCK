load("@komira//tools/build/lint:defs.bzl", "doc_tree", "markdown_docs")

# Planted dead links (test 17): a missing file, a heading that does not
# exist, a link leaving the staged tree. The validation must fail naming each
# with its reason, and pass the two links beside them that resolve.
markdown_docs(
    name = "dead",
    srcs = [
        "dead.md",
        "sub/a.md",
    ],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["tests//:doc_tree"],
)
