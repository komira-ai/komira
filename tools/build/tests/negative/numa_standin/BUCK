load("@komira//tools/build/platforms:defs.bzl", "re_properties", "remote_execution_platforms")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

# A deliberately misconfigured set of execution platforms, for test 11 only:
# `exec-mojo-multi-numa` is realized by the SAME single-NUMA workers as
# `exec-mojo`. komira_execution_platforms refuses that at load, so this calls
# the underlying rule directly, standing in for any platform whose workers turn
# out to expose one NUMA node (a wrong pool, a cpuset, a memory binding).
# tools/build/tests/run_tests.sh selects it with
# `-c build.execution_platforms=tests//negative/numa_standin:single_numa_standin`,
# passes the two property sets into this cell (`-c tests//komira_re.<key>=`,
# since `.buckconfig.local` configures the root cell only), and requires the
# multi-NUMA run to refuse to start.
#
# Declared only when this cell is given both property sets, as run_tests.sh
# does: without them re_properties fails at load, and the package must load
# for its doc_tree (//:docs).
_PROPS = [read_config("komira_re", "mojo_compile_properties"), read_config("komira_re", "light_properties")]

[remote_execution_platforms(
    name = "single_numa_standin",
    names = ["mojo_compile", "light", "mojo_compile_multi_numa"],
    constraints = [
        "komira//tools/build/platforms:exec-mojo",
        "komira//tools/build/platforms:exec-light",
        "komira//tools/build/platforms:exec-mojo-multi-numa",
    ],
    properties = [
        re_properties("mojo_compile_properties"),
        re_properties("light_properties"),
        re_properties("mojo_compile_properties"),
    ],
) for _ in ([1] if all(_PROPS) else [])]

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["tests//:doc_tree"],
)
