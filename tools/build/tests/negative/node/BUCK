    native_libs = _PKG + "native_libs",
    top = NODE["top"],
    version = "24.20.0",
)

# RED "is v24.21.0, the pin says v24.21": a version the node's begins with.
node_dist(
    name = "version_prefix_node",
    archive = _PKG + NODE["archive"],
    native_libs = _PKG + "native_libs",
    top = NODE["top"],
    version = "24.21",
)

# RED "is v24.21.0, the pin says v4.21.0": a version the node's ends with.
node_dist(
    name = "version_suffix_node",
    archive = _PKG + NODE["archive"],
    native_libs = _PKG + "native_libs",
    top = NODE["top"],
    version = "4.21.0",
)

# RED "holds no package/bin/node": an archive that is no Node.js release
# (tslib's tarball, whose top directory is `package`).
node_dist(
    name = "not_node",
    archive = _PKG + _TSLIB["file"],
    native_libs = _PKG + "native_libs",
    top = "package",
    version = NODE["version"],
)

# Archives built here, top directory `node-x`, for the checks of what the
# archive holds and of the node in it.

stand_in_archive(
    name = "archive_no_bin_node",
    top = "node-x",
    files = ["LICENSE", "include/node/node_api.h"],
)

stand_in_archive(
    name = "archive_no_header",
    top = "node-x",
    files = ["LICENSE"],
    programs = ["bin/node"],
)

stand_in_archive(
    name = "archive_node_not_executable",
    top = "node-x",
    files = ["LICENSE", "bin/node", "include/node/node_api.h"],
)

stand_in_archive(
    name = "archive_header_is_dir",
    top = "node-x",
    files = ["LICENSE", "include/node/node_api.h/not_a_header"],
    programs = ["bin/node"],
)

stand_in_archive(
    name = "archive_node_does_not_run",
    top = "node-x",
    files = ["LICENSE", "include/node/node_api.h"],
    programs = ["bin/node"],
)

