# Test 43. A coverage run is bounded: kcov waits for every process the test
# started, so a test that leaves a child running would hold the run open.
# :linger_run is cov_run with a test-only limit of 20 s (komira's is 450 s).
# GREEN: tests//negative/coverage:linger (the release gate waits for the test
# alone) and linger[coverage][tests][test_brief] (a run fits in the limit).
# RED: tests//negative/coverage:linger[coverage][tests][test_lingers] (its
# child sleeps 100 s): "The test left processes running or did not finish
# within 20 s under kcov".
cov_run_dir(
    name = "linger_run",
    exec_compatible_with = LINUX_X86_64,
    limit_s = 20,
    script = "komira//tools/build/coverage/kcov:cov_run.sh",
)

mojo_library(
    name = "linger",
    srcs = ["linger/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_run = ":linger_run",
    test_srcs = [
        "tests/test_brief.mojo",
        "tests/test_lingers.mojo",
    ],
)

# Test 43. After the limit's kill, cov_run.sh lists the group's processes
# from /proc, so it first requires /proc to show its own shell under its own
# pid. A cov_run.sh copy takes 1 for its own pid: /proc/1/stat exists and
# starts with 1, as /proc/<pid> of another PID namespace names another
# process with that pid, where the scan would list none of the group and
# pass; only /proc/self/stat, which the shell reads itself, shows the other
# pid. RED: tests//negative/coverage:lingerproc[coverage][tests][test_lingers]:
# "/proc is not readable as this run's own".
cov_plant(
    name = "lingerproc_run_sh",
    expr = "s|^    me=\\$\\$$|    me=1|",
    out = "cov_run.sh",
    src = "komira//tools/build/coverage/kcov:cov_run.sh",
)

cov_run_dir(
    name = "lingerproc_run",
    exec_compatible_with = LINUX_X86_64,
    limit_s = 20,
    script = ":lingerproc_run_sh",
)

mojo_library(
    name = "lingerproc",
    srcs = ["linger/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_run = ":lingerproc_run",
    import_name = "linger",
    test_srcs = ["tests/test_lingers.mojo"],
)

# ---- Test 46: the coverage gate -------------------------------------------
#
# Each library below has coverage builds and the gate whatever the switch
# says (coverage_debug and coverage_gate, which a tests-cell fixture may
# pass), in the mode it names. A red gate fails its [coverage][gate] and,
# for covlow and covnotests, which have one, its conda package (what ships
# waits for the gate); the library itself, its package, builds GREEN: no
# dependent waits for a gate. Its census twin is green, and
# :<name>_census_result reads the twin's [coverage][gate][result].
_LINK = "komira//tools/build/coverage/kcov:cov_link"

_GATE = "komira//tools/build/coverage:cov_gate"

# name: (sources, tests, gate directory)
_GATED = {
    # covlow/word.mojo: test_word calls word(0) only; three of its six lines
    # run, and one of the four arms of its two `if`s (BelowTarget on both).
    "covlow": (["covlow/__init__.mojo", "covlow/word.mojo"], ["tests/test_word.mojo"], _GATE),
    # No test: no report, so the gate sees nothing measured (NotMeasured).
    "covnotests": (["covnotests/__init__.mojo", "covnotests/inc.mojo"], [], _GATE),
    # covun/unused.mojo: in the package, compiled into no test binary
    # (UnmeasuredFile).
    "covun": (["covun/__init__.mojo", "covun/unused.mojo", "covun/used.mojo"], ["tests/test_used.mojo"], _GATE),
    # Every line covered, a ratchet row at 100% line, and no decision: its
    # branch records name full.mojo with no arm (measured, none to take), so
    # it has no finding and its gate is GREEN in enforce mode too.
    "covfull": (["covfull/__init__.mojo", "covfull/full.mojo"], ["tests/test_full.mojo"], ":covfull_gate"),
    # Every line covered, a ratchet row at 100% line and branch floor 0, and
    # one `if` whose false arm test_clamp_high never takes: the one finding
    # is BelowTarget on branch (its branch records, not BranchNotMeasured).
    "covbranch": (["covbranch/__init__.mojo", "covbranch/clamp.mojo"], ["tests/test_clamp_high.mojo"], ":covbranch_gate"),
    # Every line covered, the `except` body included (the first raising call
    # in its `try:` body raises once), but the second call never raises: the
    # one finding is BelowTarget on branch, a `try` decision's raise arm
    # (tools/build/coverage/branch/README.md, "try"), which line coverage
    # cannot see.
    "covtry": (["covtry/__init__.mojo", "covtry/total.mojo"], ["tests/test_total_first.mojo"], ":covbranch_gate"),
    # Every line covered, but `return a or b` is only ever decided by its
    # right operand: the one finding is BelowTarget on branch, the `or`'s
    # arm that skips its right operand (tools/build/coverage/branch/README.md,
    # "And, or": an and/or whose result no branch tests is a decision of
    # its own), which line coverage cannot see.
    "covandor": (["covandor/__init__.mojo", "covandor/either.mojo"], ["tests/test_either_one.mojo"], ":covbranch_gate"),
}

cov_gate_dir(
    name = "covbranch_gate",
    exec_compatible_with = LINUX_X86_64,
    ratchet = "covbranch_ratchet.tsv",
)

# GREEN in enforce mode: covbranch with a test taking both arms of its `if`,
# every line covered: no finding, so its [coverage][gate] is green.
mojo_library(
    name = "covbranch_both",
