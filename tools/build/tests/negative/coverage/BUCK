# ---- Test 47: branch coverage runs --------------------------------------------
#
# Each library below has coverage builds whatever the switch says
# (coverage_debug), so its [coverage][branch][<test>] exists. It has no
# gate, so its default output, the package, is green: nothing waits for a
# branch coverage run (a gate of the tests cell would read its records).

# A test that passes in the release gate and fails in its branch coverage
# run (it asserts that LLVM_PROFILE_FILE is unset). RED:
# tests//negative/coverage:branchfail[coverage][branch][test_profile_env],
# with the run's message, not gate_runner's banner.
mojo_library(
    name = "branchfail",
    srcs = [
        "noop/__init__.mojo",
        "noop/value.mojo",
    ],
    conda = False,
    coverage_debug = _LINK,
    import_name = "noop",
    test_srcs = ["tests/test_profile_env.mojo"],
)

# Copies of the branch coverage scripts, each with one planted defect
# (name, the script it copies, cov_plant's sed expression): the copy is
# :<name>_<script>_sh, its directory :<name>_branch, and the library below
# of the same name runs tests/test_one.mojo's branch coverage through it.
_BRANCH_PLANTS = [
    # A cov_branch_run.sh copy that gives the test LLVM_PROFILE_FILE_OFF in
    # place of LLVM_PROFILE_FILE: the profile runtime writes its default
    # (default.profraw in the test's working directory), or nothing, and never
    # where the run reads. RED:
    # tests//negative/coverage:branchnoprof[coverage][branch][test_one], "wrote
    # no .profraw".
    ("branchnoprof", "run", "s|--env \"LLVM_PROFILE_FILE=|--env \"LLVM_PROFILE_FILE_OFF=|"),
    # A cov_branch_run.sh copy that raises each raw profile's version from 11 to
    # 12 (the low byte of the version field, byte 8) before reading it, as a
    # runtime and instrumenter of another LLVM would write it. RED:
    # tests//negative/coverage:branchversion[coverage][branch][test_one], "has
    # raw profile version 12, not 11".
    ("branchversion", "run", "s|^n=0$|n=0; while read -r f; do printf '\\\\014' \\| dd of=\"$f\" bs=1 seek=8 count=1 conv=notrunc 2>/dev/null; done <\"$K/raws\"|"),
    # A cov_branch_annotate.sh copy that runs `simplifycfg` before applying the
    # profile: the control flow the profile is applied to is no longer the one
    # that was instrumented, as with a profile of other bitcode, and LLVM drops
    # those functions' counts with a warning. RED:
    # tests//negative/coverage:branchannotate[coverage][branch_ir][test_one],
    # "diagnostic(s) applying the profile".
    ("branchannotate", "annotate", "s|\"--lto-newpm-passes=pgo-instr-use\"|\"--lto-newpm-passes=function(simplifycfg),pgo-instr-use\"|"),
    # A cov_branch_run.sh copy whose merge leaves out the test's `main`: the
    # profile holds no record of a function the instrumented binary links (a run
    # writes one for each, ran or not), as a profile of another binary would
    # not, and applying it would read that function as never run. RED:
    # tests//negative/coverage:branchmissing[coverage][branch_ir][test_one],
    # "a run writes the record of every function its binary links".
    ("branchmissing", "run", "s|\"$PD\" merge -o|\"$PD\" merge --no-function=main -o|"),
    # A cov_branch_annotate.sh copy that internalizes the bitcode before applying
    # the profile: `main` becomes a local function, whose profile name is not
    # the one the binary's run wrote, so the bitcode the profile is applied to
    # is not the one the binary was made from (as other bitcode would be), and
    # LLVM finds one function of the profile fewer in it. RED:
    # tests//negative/coverage:branchinternal[coverage][branch_ir][test_one],
    # "the binary that wrote it was not made from this bitcode".
    ("branchinternal", "annotate", "s|\"--lto-newpm-passes=pgo-instr-use\"|\"--lto-newpm-passes=internalize,pgo-instr-use\"|"),
    # A cov_branch_annotate.sh copy whose section-name pipeline carries about
    # 1 MB more after each name: the reader that cuts the name must read all of
    # it, or its writer dies of SIGPIPE (exit 141 under pipefail; a race at 16
    # bytes, as seen in remote runs with `head -n 1`, certain here). GREEN:
    # tests//negative/coverage:branchwide[coverage][branch_ir][test_one].
    ("branchwide", "annotate", "s#count=16 2>/dev/null |#count=16 2>/dev/null | { cat; awk 'BEGIN { while (n++ < 40000) print \"padding padding padding\" }'; } |#"),
    # The branchweights copy with its branch-weights check reading for a string
    # no bitcode holds: the bitcode the annotation reads holds entry counts
    # (`function_entry_count`) before the profile is applied, which the
    # entry-count check would count as functions found in the profile. RED:
    # tests//negative/coverage:branchentry[coverage][branch_ir][test_one],
    # "already holds function entry counts".
    ("branchentry", "annotate", "s|^# 0\\. No branch weights before.*$|\"$LLD\" -flavor gnu -r -m elf_x86_64 \"$BC\" -o \"$K/w.bc\" --lto-O0 --plugin-opt=emit-llvm --lto-newpm-passes=pgo-instr-use -mllvm \"-pgo-test-profile-file=$PROF\" \\&\\& BC=\"$K/w.bc\"|; s|grep -q -F branch_weights \"$BC\"|grep -q -F branch_weights_unread \"$BC\"|"),
    # A cov_branch_annotate.sh copy that first applies the profile and writes
    # the module back as bitcode (lld's emit-llvm), then reads that: a bitcode
    # that holds branch weights before the profile is applied, which
    # pgo-instr-use would keep on the branches that never ran. RED:
    # tests//negative/coverage:branchweights[coverage][branch_ir][test_one],
    # "already holds branch weights".
    ("branchweights", "annotate", "s|^# 0\\. No branch weights before.*$|\"$LLD\" -flavor gnu -r -m elf_x86_64 \"$BC\" -o \"$K/w.bc\" --lto-O0 --plugin-opt=emit-llvm --lto-newpm-passes=pgo-instr-use -mllvm \"-pgo-test-profile-file=$PROF\" \\&\\& BC=\"$K/w.bc\"|"),
]

[
    (
        cov_plant(
            name = "{}_{}_sh".format(name, script),
            expr = expr,
            out = "cov_branch_{}.sh".format(script),
            src = "komira//tools/build/coverage/branch:cov_branch_{}.sh".format(script),
        ),
        cov_branch_dir(
            name = "{}_branch".format(name),
            exec_compatible_with = LINUX_X86_64,
            **{script + "_script": ":{}_{}_sh".format(name, script)}
        ),
    )
    for name, script, expr in _BRANCH_PLANTS
]

[
    mojo_library(
        name = name,
        srcs = [
            "noop/__init__.mojo",
            "noop/value.mojo",
        ],
        conda = False,
        coverage_branch = ":{}_branch".format(name),
        coverage_debug = _LINK,
        import_name = "noop",
        test_srcs = ["tests/test_one.mojo"],
    )
    for name, _script, _expr in _BRANCH_PLANTS
]

