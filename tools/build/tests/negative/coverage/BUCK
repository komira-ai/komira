# location of its call, `count_down(`, where the classifier cannot tell it
# from the compiler's branches. RED:
# tests//negative/coverage:branchnodebug[coverage][branch_info][test_nodebug],
# "may be a decision of count_down".
mojo_library(
    name = "branchnodebug",
