load("@komira//tools/build/coverage:defs.bzl", "cov_gate_dir")
load("@komira//tools/build/coverage/kcov:defs.bzl", "cov_link_dir", "cov_run_dir")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("//functional/coverage:defs.bzl", "cov_debug_check", "cov_plant", "cov_report_check", "kcov_stub_dir")

# A coverage link whose relocator rewrites nothing (test 41). Its [coverage]
# must fail with mojo_wrapper.sh's exit 4, "contains this action's working
# directory": the wrapper's check of every output stays on for coverage
# builds, and a relocation that does not happen cannot pass it.
zig_exe(
    name = "noop_relocate",
    src = "noop_relocate.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    exec_compatible_with = LINUX_X86_64,
    zig = "komira//tools/build/toolchains:zig",
)

cov_link_dir(
    name = "noop_link",
    exec_compatible_with = LINUX_X86_64,
    relocate = ":noop_relocate",
)

# RED: tests//negative/coverage:noop[coverage]
mojo_library(
    name = "noop",
    srcs = [
        "noop/__init__.mojo",
        "noop/value.mojo",
    ],
    conda = False,
    coverage_debug = ":noop_link",
    test_srcs = ["tests/test_one.mojo"],
)

# Planted defects for the hermetic check (tests//functional/coverage:check.sh,
# test 41): made-up strings of a coverage binary, each good but for one
# thing, checked as :hermetic checks the real binaries.
_DIRS = [
    "tests",
    "buck-out/v2/art/tests/functional/coverage/__covlib_forced__/[0-9a-f]+/src/covlib",
]

# RED: tests//negative/coverage:abs_relocated (a Mojo source named by an
# absolute path under the working directory, relocated)
# RED: tests//negative/coverage:abs_other (an absolute path of another build
# directory, which the wrapper's check of its own directory cannot see)
# RED: tests//negative/coverage:no_reldir (no relative test directory)
[
    cov_debug_check(
        name = name,
        bins = ["planted/{}.txt".format(name)],
        dirs = _DIRS,
        mode = "hermetic",
        names = ["value.mojo"],
        script = "//functional/coverage:check.sh",
    )
    for name in ("abs_relocated", "abs_other", "no_reldir")
]

# Test 43. A test that fails when it is traced (TracerPid in
# /proc/self/status not 0). GREEN: tests//negative/coverage:tracer (the
# release gate runs it untraced). RED:
# tests//negative/coverage:tracer[coverage][tests][test_tracer], its kcov
# run: kcov traced it, and passed its exit status on.
mojo_library(
    name = "tracer",
    srcs = ["tracer/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    test_srcs = ["tests/test_tracer.mojo"],
)

# Test 43. cov_run.sh with the library's sources staged at the root of the
# run's working directory instead of the directory the line tables name them
# by. kcov cannot open them there and would drop them without an error;
# their names fall through to the run's lost/ copy, and cov_normalize
# refuses them as unmapped. RED:
# tests//negative/coverage:lost[coverage][tests][test_lost]
cov_plant(
    name = "lost_run_sh",
    expr = 's|^cp -RL "\\$SRC/\\." "\\$R/share/\\$SRC_REL/"$|cp -RL "$SRC/." "$R/share/"|',
    out = "cov_run.sh",
    src = "komira//tools/build/coverage/kcov:cov_run.sh",
)

cov_run_dir(
    name = "lost_run",
    exec_compatible_with = LINUX_X86_64,
    script = ":lost_run_sh",
)

mojo_library(
    name = "lost",
    srcs = [
        "lostlib/__init__.mojo",
        "lostlib/value.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_run = ":lost_run",
    import_name = "lostlib",
    test_srcs = ["tests/test_lost.mojo"],
)

# Test 43. A test's data staged at the test's own source path, where a
# coverage run stages the source: analysis fails, naming it. RED:
# tests//negative/coverage:clash
mojo_library(
    name = "clash",
    srcs = [
        "lostlib/__init__.mojo",
        "lostlib/value.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    import_name = "lostlib",
    test_data = {"tests/test_lost.mojo": {"tests/test_lost.mojo": "lostlib/value.mojo"}},
    test_srcs = ["tests/test_lost.mojo"],
)

# Test 43. A test's data staged under buck-out/, where a coverage run stages
# the library's sources: analysis fails, naming it. RED:
# tests//negative/coverage:clash_buckout
mojo_library(
    name = "clash_buckout",
    srcs = [
        "lostlib/__init__.mojo",
        "lostlib/value.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    import_name = "lostlib",
    test_data = {"tests/test_lost.mojo": {"buck-out/data.txt": "lostlib/value.mojo"}},
    test_srcs = ["tests/test_lost.mojo"],
)

# Test 43. The library's sources staged, and named to kcov and cov_normalize,
# at a directory other than the one the line tables name them by (as if the
# rule passed cov_run.sh another [src] than the one the binary was compiled
# from): kcov would drop them without an error, and lost/ (a copy at the
# same wrong directory) cannot catch it. cov_run.sh's check of the names in
# the binary refuses it before kcov runs. RED:
# tests//negative/coverage:lostdir[coverage][tests][test_lost]
cov_plant(
    name = "lostdir_run_sh",
    expr = 's|^SRC=\\$(abs "\\$SRC_REL")$|SRC=$(abs "$SRC_REL"); SRC_REL=${SRC_REL}x|',
    out = "cov_run.sh",
    src = "komira//tools/build/coverage/kcov:cov_run.sh",
)

cov_run_dir(
    name = "lostdir_run",
    exec_compatible_with = LINUX_X86_64,
    script = ":lostdir_run_sh",
)

mojo_library(
    name = "lostdir",
    srcs = [
        "lostlib/__init__.mojo",
        "lostlib/value.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_run = ":lostdir_run",
    import_name = "lostlib",
    test_srcs = ["tests/test_lost.mojo"],
)

# Test 43. The exit status of a coverage run is the test's: not that of the
# last process kcov traced, and 128+N for a test killed by signal N, as the
# release gate reports it. GREEN: tests//negative/coverage:orphan and its
# [coverage] (the test passes; a child it leaves behind exits 3 later). RED:
# tests//negative/coverage:exits[coverage][tests][test_parent_fails] (exit 1;
# its child exits 0 later), ...[test_killed] (exit 137). The release gate of
# :exits is red by design; nothing builds it.
mojo_library(
    name = "orphan",
    srcs = ["exits/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    import_name = "exits",
    test_srcs = ["tests/test_orphan_late.mojo"],
)

mojo_library(
    name = "exits",
    srcs = ["exits/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    test_srcs = [
        "tests/test_killed.mojo",
        "tests/test_parent_fails.mojo",
    ],
)

# Test 43. A kcov that the executor refuses (it prints kcov's "Can't set
# personality" and exits 255, as kcov does under a seccomp profile that
# refuses personality(ADDR_NO_RANDOMIZE)): the run is red, saying kcov could
# not trace the test, not that the test failed. RED:
# tests//negative/coverage:refused[coverage][tests][test_one]
zig_exe(
    name = "kcov_refused",
    src = "kcov_refused.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    exec_compatible_with = LINUX_X86_64,
    zig = "komira//tools/build/toolchains:zig",
)

kcov_stub_dir(
    name = "kcov_refused_dist",
    exec_compatible_with = LINUX_X86_64,
    kcov = ":kcov_refused",
)

cov_run_dir(
    name = "refused_run",
    exec_compatible_with = LINUX_X86_64,
    kcov = ":kcov_refused_dist",
    script = "komira//tools/build/coverage/kcov:cov_run.sh",
)

mojo_library(
    name = "refused",
    srcs = [
        "noop/__init__.mojo",
        "noop/value.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_run = ":refused_run",
    import_name = "noop",
    test_srcs = ["tests/test_one.mojo"],
)

# Test 43. A coverage run is bounded: kcov waits for every process the test
# started, so a test that leaves a child running would hold the run open.
# :linger_run is cov_run with a test-only limit of 20 s (komira's is 450 s).
# GREEN: tests//negative/coverage:linger (the release gate waits for the test
# alone) and linger[coverage][tests][test_brief] (a run fits in the limit).
# RED: tests//negative/coverage:linger[coverage][tests][test_lingers] (its
# child sleeps 100 s): "The test left processes running or did not finish
# within 20 s under kcov".
cov_run_dir(
    name = "linger_run",
    exec_compatible_with = LINUX_X86_64,
    limit_s = 20,
    script = "komira//tools/build/coverage/kcov:cov_run.sh",
)

mojo_library(
    name = "linger",
    srcs = ["linger/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_run = ":linger_run",
    test_srcs = [
        "tests/test_brief.mojo",
        "tests/test_lingers.mojo",
    ],
)

# ---- Test 44: the coverage gate and the join ------------------------------
#
# Each library below has coverage builds and the gate whatever the switch
# says (coverage_debug and coverage_gate, which a tests-cell fixture may
# pass), in the mode it names. A red one fails its default output, the
# package: the join waits for the gate. Its census twin is green, and
# :<name>_census_result reads the twin's [coverage][gate][result].
_LINK = "komira//tools/build/coverage/kcov:cov_link"

_GATE = "komira//tools/build/coverage:cov_gate"

# name: (sources, tests, gate directory)
_GATED = {
    # covlow/word.mojo: test_word calls word(0) only; three of its six lines
    # run (BelowTarget).
    "covlow": (["covlow/__init__.mojo", "covlow/word.mojo"], ["tests/test_word.mojo"], _GATE),
    # No test: no report, so the gate sees nothing measured (NotMeasured).
    "covnotests": (["covnotests/__init__.mojo", "covnotests/inc.mojo"], [], _GATE),
    # covun/unused.mojo: in the package, compiled into no test binary
    # (UnmeasuredFile).
    "covun": (["covun/__init__.mojo", "covun/unused.mojo", "covun/used.mojo"], ["tests/test_used.mojo"], _GATE),
    # Every line covered, a ratchet row at 100% line: the one finding left is
    # that kcov measures no branch (BranchNotMeasured).
    "covfull": (["covfull/__init__.mojo", "covfull/full.mojo"], ["tests/test_full.mojo"], ":covfull_gate"),
}

cov_gate_dir(
    name = "covfull_gate",
    exec_compatible_with = LINUX_X86_64,
    ratchet = "covfull_ratchet.tsv",
)

# RED: tests//negative/coverage:covlow, :covnotests, :covun, :covfull
# (enforce). GREEN: :covlow_census, :covnotests_census, :covun_census,
# :covfull_census and their :<name>_census_result checks.
[
    mojo_library(
        name = name + suffix,
        srcs = srcs,
        conda = False,
        coverage_debug = _LINK,
        coverage_gate = gate,
        coverage_mode = mode,
        import_name = name,
        test_srcs = tests,
    )
    for name, (srcs, tests, gate) in _GATED.items()
    for suffix, mode in (("", "enforce"), ("_census", "census"))
]

# What each census twin's gate found, in its result.json.
_PKG = '"package":{"package":"tools/build/tests/negative/coverage",'

_RESULTS = {
    "covlow": [
        '"conclusion":"neutral","mode":"census","target_bp":10000,',
        _PKG + '"files":1,"unmeasured_files":0,"line_hit":3,"line_found":6,"line_bp":5000,"branch_hit":0,"branch_found":0,"branch_bp":null,',
        '"kind":"BelowTarget","package":"tools/build/tests/negative/coverage","metric":"line","measured_bp":5000,"bound_bp":10000,',
        '"kind":"BranchNotMeasured",',
        '"excluded_test_files":1,',
    ],
    "covnotests": [
        '"conclusion":"neutral","mode":"census",',
        _PKG + '"files":1,"unmeasured_files":1,"line_hit":0,"line_found":2,',
        '"kind":"NotMeasured",',
        '"kind":"UnmeasuredFile","package":"tools/build/tests/negative/coverage","metric":"","measured_bp":null,"bound_bp":null,"path":"tools/build/tests/negative/coverage/covnotests/inc.mojo","line":0,',
    ],
    "covun": [
        '"conclusion":"neutral","mode":"census",',
        _PKG + '"files":2,"unmeasured_files":1,"line_hit":1,"line_found":3,',
        '"kind":"UnmeasuredFile","package":"tools/build/tests/negative/coverage","metric":"","measured_bp":null,"bound_bp":null,"path":"tools/build/tests/negative/coverage/covun/unused.mojo","line":0,',
    ],
    "covfull": [
        '"conclusion":"neutral","mode":"census",',
        _PKG + '"files":1,"unmeasured_files":0,"line_hit":1,"line_found":1,"line_bp":10000,"branch_hit":0,"branch_found":0,"branch_bp":null,',
        '"line_floor_bp":10000,"branch_floor_bp":null}',
        '"findings":[{"kind":"BranchNotMeasured","package":"tools/build/tests/negative/coverage","metric":"branch","measured_bp":null,"bound_bp":10000,"path":"","line":0,',
    ],
}

[
    cov_report_check(
        name = name + "_census_result",
        expect = expect,
        mode = "result",
        reports = [":{}_census[coverage][gate][result]".format(name)],
        script = "//functional/coverage:report.sh",
    )
    for name, expect in _RESULTS.items()
]

# Test 44. A library whose welded tests are outside its package's tests/:
# one in another tests/ directory (elsewhere/tests/, as komira_db_postgres's
# wire/tests/) and one at the package's top (as a cloud SDK client's). With
# coverage it analyzes, and its gate names both tests to covcheck
# (--test-source), so they are left out of covtop's numbers. GREEN:
# tests//negative/coverage:covtop_census_result.
mojo_library(
    name = "covtop_census",
    srcs = [
        "covtop/__init__.mojo",
        "covtop/top.mojo",
    ],
    conda = False,
    coverage_debug = _LINK,
    coverage_gate = _GATE,
    coverage_mode = "census",
    import_name = "covtop",
    test_srcs = [
        "elsewhere/tests/test_top.mojo",
        "test_covtop.mojo",
    ],
)

cov_report_check(
    name = "covtop_census_result",
    expect = [
        '"conclusion":"neutral","mode":"census",',
        _PKG + '"files":1,"unmeasured_files":0,"line_hit":1,"line_found":1,"line_bp":10000,',
        '"excluded_test_files":2,',
    ],
    mode = "result",
    reports = [":covtop_census[coverage][gate][result]"],
    script = "//functional/coverage:report.sh",
)

# Test 44. A census gate over a malformed ratchet: covcheck exits 1, which
# fails the gate in every mode (census never fails on a finding, but does on
# an input covcheck refuses). RED: tests//negative/coverage:covbad
cov_gate_dir(
    name = "covbad_gate",
    exec_compatible_with = LINUX_X86_64,
    ratchet = "covbad_ratchet.tsv",
)

mojo_library(
    name = "covbad",
    srcs = [
        "covfull/__init__.mojo",
        "covfull/full.mojo",
    ],
    conda = False,
    coverage_debug = _LINK,
    coverage_gate = ":covbad_gate",
    coverage_mode = "census",
    import_name = "covfull",
    test_srcs = ["tests/test_full.mojo"],
)

# Test 44. A test that passes in the release gate and fails under kcov (the
# tracer test above), in a library with no coverage attribute of its own: with
# -c komira.coverage=true its package waits for that coverage run, so the
# build is RED ("COVERAGE RUN FAILED"); without the switch it is GREEN.
mojo_library(
    name = "tracer_joined",
    srcs = ["tracer/__init__.mojo"],
    conda = False,
    import_name = "tracer",
    test_srcs = ["tests/test_tracer.mojo"],
)
