# A test_env setting LLVM_PROFILE_FILE, which a branch coverage run sets
# itself. RED at analysis: tests//negative/coverage:branchenv, "test_env
# sets LLVM_PROFILE_FILE".
mojo_library(
    name = "branchenv",
    srcs = [
        "noop/__init__.mojo",
        "noop/value.mojo",
    ],
    conda = False,
    coverage_debug = _LINK,
    import_name = "noop",
