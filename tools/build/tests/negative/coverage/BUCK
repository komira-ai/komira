    # BelowTarget on branch is the only finding.
    "covandor": [
        '"conclusion":"neutral","mode":"census",',
        _PKG + '"files":1,"unmeasured_files":0,"line_hit":2,"line_found":2,"line_bp":10000,"branch_hit":1,"branch_found":2,"branch_bp":5000,',
        '"findings":[{"kind":"BelowTarget","package":"tools/build/tests/negative/coverage","metric":"branch","measured_bp":5000,"bound_bp":10000,"path":"","line":0,"message":"branch 50.00% is below the target 100.00%","count":null}],"exemptions"',
    ],
}

[
    cov_report_check(
        name = name + "_census_result",
        expect = expect,
        mode = "result",
        reports = [":{}_census[coverage][gate][result]".format(name)],
        script = "//functional/coverage:report.sh",
    )
    for name, expect in _RESULTS.items()
]

