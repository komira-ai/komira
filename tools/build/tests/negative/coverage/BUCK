# A coverage link whose relocator rewrites nothing (test 41). Its [coverage]
# must fail with mojo_wrapper.sh's exit 4, "contains this action's working
# directory": the wrapper's check of every output stays on for coverage
# builds, and a relocation that does not happen cannot pass it.
zig_exe(
    name = "noop_relocate",
    src = "noop_relocate.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    exec_compatible_with = LINUX_X86_64,
    zig = "komira//tools/build/toolchains:zig",
)

cov_link_dir(
    name = "noop_link",
    exec_compatible_with = LINUX_X86_64,
    relocate = ":noop_relocate",
)

# RED: tests//negative/coverage:noop[coverage]
mojo_library(
    name = "noop",
    srcs = [
        "noop/__init__.mojo",
        "noop/value.mojo",
    ],
    conda = False,
    coverage_debug = ":noop_link",
    test_srcs = ["tests/test_one.mojo"],
)

# Planted defects for the hermetic check (tests//functional/coverage:check.sh,
# test 41): made-up strings of a coverage binary, each good but for one
# thing, checked as :hermetic checks the real binaries.
_DIRS = [
    "tests",
    "buck-out/v2/art/tests/functional/coverage/__covlib_forced__/[0-9a-f]+/src/covlib",
]

# RED: tests//negative/coverage:abs_relocated (a Mojo source named by an
# absolute path under the working directory, relocated)
# RED: tests//negative/coverage:abs_other (an absolute path of another build
# directory, which the wrapper's check of its own directory cannot see)
# RED: tests//negative/coverage:no_reldir (no relative test directory)
[
    cov_debug_check(
        name = name,
        bins = ["planted/{}.txt".format(name)],
        dirs = _DIRS,
        mode = "hermetic",
        names = ["value.mojo"],
        script = "//functional/coverage:check.sh",
    )
    for name in ("abs_relocated", "abs_other", "no_reldir")
]

# Test 43. A test that fails when it is traced (TracerPid in
# /proc/self/status not 0). GREEN: tests//negative/coverage:tracer (the
# release gate runs it untraced). RED:
# tests//negative/coverage:tracer[coverage][tests][test_tracer], its kcov
# run: kcov traced it, and passed its exit status on.
mojo_library(
    name = "tracer",
    srcs = ["tracer/__init__.mojo"],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    test_srcs = ["tests/test_tracer.mojo"],
)

# Test 43. cov_run.sh with the library's sources staged at the root of the
# run's working directory instead of the directory the line tables name them
# by. kcov cannot open them there and would drop them without an error;
# their names fall through to the run's lost/ copy, and cov_normalize
# refuses them as unmapped. RED:
# tests//negative/coverage:lost[coverage][tests][test_lost]
cov_plant(
    name = "lost_run_sh",
    expr = 's|^cp -RL "\\$SRC/\\." "\\$R/share/\\$SRC_REL/"$|cp -RL "$SRC/." "$R/share/"|',
    out = "cov_run.sh",
    src = "komira//tools/build/coverage/kcov:cov_run.sh",
)

cov_run_dir(
    name = "lost_run",
    exec_compatible_with = LINUX_X86_64,
    script = ":lost_run_sh",
)

mojo_library(
    name = "lost",
    srcs = [
        "lostlib/__init__.mojo",
        "lostlib/value.mojo",
    ],
    conda = False,
    coverage_debug = "komira//tools/build/coverage/kcov:cov_link",
    coverage_run = ":lost_run",
    import_name = "lostlib",
    test_srcs = ["tests/test_lost.mojo"],
)

