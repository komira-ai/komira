# A cov_branch_link.sh copy whose zig line drops `-lm`: the branch coverage
# link is no longer the release link plus the profile runtime. RED:
# tests//negative/coverage:branchlinkline, "the branch coverage link is not
# the release link".
cov_plant(
    name = "branchlinkline_link_sh",
    expr = "s|-Wl,--gc-sections -lm|-Wl,--gc-sections|",
    out = "cov_branch_link.sh",
    src = "komira//tools/build/coverage/branch:cov_branch_link.sh",
)

cov_branch_dir(
    name = "branchlinkline_branch",
    exec_compatible_with = LINUX_X86_64,
    link_script = ":branchlinkline_link_sh",
)

cov_link_line_check(
    name = "branchlinkline",
    bc = ":branchnoprof[coverage][bc][test_one]",
    branch = ":branchlinkline_branch",
    exec_compatible_with = LINUX_X86_64,
    lib = ":branchnoprof",
    script = "//functional/coverage:link_line.sh",
    src = "tests/test_one.mojo",
)

