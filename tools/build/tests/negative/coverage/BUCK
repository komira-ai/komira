    coverage_gate = ":covbranch_gate",
    coverage_mode = "enforce",
    import_name = "covbranch",
    test_srcs = ["tests/test_clamp_both.mojo"],
)

# GREEN in enforce mode: covtry with a test making each raising call of its
# `try:` body raise once: no finding.
mojo_library(
    name = "covtry_both",
    srcs = [
        "covtry/__init__.mojo",
        "covtry/total.mojo",
    ],
    conda = False,
    coverage_debug = _LINK,
    coverage_gate = ":covbranch_gate",
    coverage_mode = "enforce",
    import_name = "covtry",
    test_srcs = ["tests/test_total_both.mojo"],
)

# GREEN in enforce mode: covandor with a test taking both arms of its
# `or`: no finding.
mojo_library(
    name = "covandor_both",
    srcs = [
        "covandor/__init__.mojo",
        "covandor/either.mojo",
    ],
    conda = False,
    coverage_debug = _LINK,
    coverage_gate = ":covbranch_gate",
    coverage_mode = "enforce",
    import_name = "covandor",
    test_srcs = ["tests/test_either_both.mojo"],
)

cov_gate_dir(
    name = "covfull_gate",
    exec_compatible_with = LINUX_X86_64,
    ratchet = "covfull_ratchet.tsv",
)

# covfull with `coverage_branch_gate = False`: its gate reads no branch
# record (the side of a library not in COVERAGE_BRANCH_GATE), so the one
# finding left is BranchNotMeasured. Its gate is RED in enforce mode; its
# census twin's result.json says so (:covfull_unread_census_result).
[
    mojo_library(
        name = "covfull_unread" + suffix,
        srcs = [
            "covfull/__init__.mojo",
            "covfull/full.mojo",
        ],
        conda = False,
        coverage_branch_gate = False,
        coverage_debug = _LINK,
        coverage_gate = ":covfull_gate",
        coverage_mode = mode,
        import_name = "covfull",
        test_srcs = ["tests/test_full.mojo"],
    )
    for suffix, mode in (("", "enforce"), ("_census", "census"))
]

# RED: tests//negative/coverage:covlow[coverage][gate], :covnotests[...],
# :covun[...], :covfull_unread[...], :covbranch[...], :covtry[...],
# :covandor[...] (enforce), and
# :covlow_conda, :covnotests_conda (a library with no test: a REFUSED conda
# package, which waits for its NotMeasured gate all the same). GREEN:
# :covlow, :covnotests, :covun, :covfull, :covfull_unread, :covbranch,
# :covtry, :covandor (the libraries), :covfull[coverage][gate],
# :covtry_both[coverage][gate] and :covandor_both[coverage][gate]
# (enforce), :covlow_census,
# :covnotests_census, :covun_census, :covfull_census, :covbranch_census,
# :covtry_census, :covandor_census and their :<name>_census_result checks.
[
    mojo_library(
        name = name + suffix,
        srcs = srcs,
        conda = suffix == "" and name in ("covlow", "covnotests"),
        coverage_debug = _LINK,
        coverage_gate = gate,
        coverage_mode = mode,
        import_name = name,
        test_srcs = tests,
    )
    for name, (srcs, tests, gate) in _GATED.items()
    for suffix, mode in (("", "enforce"), ("_census", "census"))
]

# What each census twin's gate found, in its result.json.
_PKG = '"package":{"package":"tools/build/tests/negative/coverage",'

_RESULTS = {
    # Its branch records: word(0) takes one arm of `if x == 0` and never
    # reaches `if x > 0` (both arms `-`): 1 of 4, and no BranchNotMeasured
    # (the whole findings list).
    "covlow": [
        '"conclusion":"neutral","mode":"census","target_bp":10000,',
        _PKG + '"files":1,"unmeasured_files":0,"line_hit":3,"line_found":6,"line_bp":5000,"branch_hit":1,"branch_found":4,"branch_bp":2500,',
