load("@komira//tools/build/lint:defs.bzl", "mojo_deps")

# Test 54 (refused imports, mojo_deps), the half that must go red: one import
# form per target, each in its own file (<name>.mojo); the qualified_* and
# alias_* targets name the module by a dotted path without importing it. run_tests.sh requires
# each to fail naming exactly its one finding.
_REFUSED = [
    "komira_plan_ir.physical_plan",
    "komira_plan_ir.physical_plan_purity_gate",
]

[
    mojo_deps(
        name = name,
        buck = "deps.txt",
        srcs = [name + ".mojo"],
        refused_imports = _REFUSED,
    )
    for name in [
        "after_docstring",
        "alias_parent",
        "continuation",
        "from_module",
        "from_parent",
        "from_spaced",
        "from_submodule",
        "import_as",
        "import_list",
        "import_module",
        "import_spaced",
        "import_sub",
        "indented",
        "paren_comment_close",
        "paren_comment_open",
        "mixed_triple_quotes",
        "parenthesised",
        "qualified",
        "qualified_continued",
        "qualified_in_parens",
        "qualified_spaced",
        "semicolon",
        "semicolon_imports",
        "triple_quote_in_string",
    ]
]

# A name a from-import binds to an ancestor of a refused module, used as a
# path into it: refused here is one level deeper than physical_plan.
mojo_deps(
    name = "alias_from",
    buck = "deps.txt",
    srcs = ["alias_from.mojo"],
    refused_imports = ["komira_plan_ir.physical_plan.segment"],
)

# An entry that is not a dotted komira_* module name: refused at analysis.
mojo_deps(
    name = "bad_entry",
    buck = "deps.txt",
    srcs = ["from_module.mojo"],
    refused_imports = ["komira_plan_ir"],
)
