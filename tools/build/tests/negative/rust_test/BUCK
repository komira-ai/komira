load("@komira//tools/build/rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Planted defects for the Rust test weld; each `must fail` target must fail
# its build, and the `green` ones must build (run_tests.sh, test 35).

# One test passes, one fails: red.
rust_test(
    name = "red",
    srcs = ["src/red.rs"],
    crate_root = "src/red.rs",
)

# must fail: a binary welded to a red test cannot be built, though it compiles
# (its `[ungated]` compile is not a target; `:red[bin]` shows the test
# compiles too, so the red is the test's run).
rust_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    tests = [":red"],
)

# must fail: a library welded to a red test cannot be built, so neither can a
# binary that links it.
rust_library(
    name = "red_lib",
    srcs = ["src/red.rs"],
    crate_root = "src/red.rs",
    tests = [":red"],
)

rust_binary(
    name = "lib_consumer",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = [":red_lib"],
)

# must fail: EMPTY GATE, nothing to run.
rust_test(
    name = "empty",
    srcs = ["src/empty.rs"],
    crate_root = "src/empty.rs",
)

# must fail: an #[ignore]d test is a mute.
rust_test(
    name = "ignored",
    srcs = ["src/ignored.rs"],
    crate_root = "src/ignored.rs",
)

# green: the harness sees only HOME, PATH and TMPDIR.
rust_test(
    name = "env_scrubbed",
    srcs = ["src/env.rs"],
    crate_root = "src/env.rs",
)

# green: a binary welded to a passing test builds, and runs (`[run_check]`).
rust_binary(
    name = "bin_green",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    tests = [":env_scrubbed"],
    expected_stdout = "hello\n",
)

# must fail: NO VERDICT, the harness is killed at its timeout (exit 142).
rust_test(
    name = "hang",
    srcs = ["src/hang.rs"],
    crate_root = "src/hang.rs",
    test_timeout_s = 3,
)

# External tests (`test_srcs`, Cargo's tests/*.rs) gate the library itself:
# each is compiled against the UNGATED rlib and run (rust_tests.sh, test 35).

# green: the external test passes, so the library builds, and so does a binary
# linking it.
rust_library(
    name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    test_srcs = ["tests/ext_pass.rs", "tests/common/mod.rs"],
)

rust_binary(
    name = "ext_consumer",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = [":ext"],
)

# must fail: one external test fails, so the library cannot be built, nor a
# binary that links it, though the library and each test crate compile.
rust_library(
    name = "ext_red",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    test_srcs = ["tests/ext_pass.rs", "tests/ext_fail.rs", "tests/common/mod.rs"],
)

rust_binary(
    name = "ext_red_consumer",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = [":ext_red"],
)

# must fail at analysis: test_srcs with no test crate (tests/<name>.rs).
rust_library(
    name = "ext_no_crate",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    test_srcs = ["tests/common/mod.rs"],
)

# must fail at analysis: a test_srcs file outside tests/ (it would otherwise be
# cut to a crate named from the tail of its path).
rust_library(
    name = "ext_outside",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    test_srcs = ["tests/ext_pass.rs", "tests/common/mod.rs", "src/ext_misplaced.rs"],
)

# must fail at analysis: tests/1bad.rs does not name a Rust identifier.
rust_library(
    name = "ext_bad_name",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    test_srcs = ["tests/1bad.rs"],
)

# must fail at analysis: a file directly under tests/ that is not a .rs file.
rust_library(
    name = "ext_not_rs",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    test_srcs = ["tests/ext_pass.rs", "tests/ext_data.txt"],
)

# `tests` and `test_srcs` together: the markers of both gate the library.

# green: the unit test and the external test pass, so the library builds.
rust_library(
    name = "both",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    tests = [":env_scrubbed"],
    test_srcs = ["tests/ext_pass.rs", "tests/common/mod.rs"],
)

# must fail: the external test passes, but the unit test fails, and it still
# gates (a gate built from the external markers alone would publish this).
rust_library(
    name = "both_red",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    tests = [":red"],
    test_srcs = ["tests/ext_pass.rs", "tests/common/mod.rs"],
)

# must fail: the unit test passes, but an external test fails, and it still
# gates (a gate built from the `tests` markers alone would publish this).
rust_library(
    name = "both_ext_red",
    crate_name = "ext",
    srcs = ["src/ext_lib.rs"],
    crate_root = "src/ext_lib.rs",
    tests = [":env_scrubbed"],
    test_srcs = ["tests/ext_pass.rs", "tests/ext_fail.rs", "tests/common/mod.rs"],
)
