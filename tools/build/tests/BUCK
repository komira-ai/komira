# The client-side scripts of this cell: run_tests.sh, tool_lib.sh and the
# sections run_tests.sh sources, and the scripts of functional/ and negative/.
# `//...` does not reach into this cell, so //:tests_lints (the root BUCK)
# names this lint and the other shell lints of the cell, and
# `./buck2 build //...` runs them.
load("@komira//tools/build/lint:defs.bzl", "shell_lint")

# This cell's configuration, for the public boundary lint (komira//:public_boundary),
# which reads every committed file: a glob skips a dotfile.
export_file(
    name = "buckconfig",
    src = ".buckconfig",
    visibility = ["komira//:public_boundary"],
)

shell_lint(
    name = "shell_lint",
    srcs = glob([
        "*.sh",
        "functional/*.sh",
        "negative/*.sh",
    ]),
    excludes = {
        # The audited target list is split into arguments on purpose.
        "run_tests.sh": "SC2046",
    },
    visibility = ["komira//:tests_lints"],
)

# The conda scripts, for tests//functional/install_gate:cases, which runs
# their argument check.
[
    export_file(
        name = name,
        src = "functional/" + name,
        visibility = ["//functional/install_gate:"],
    )
    for name in [
        "conda.sh",
        "conda_set.sh",
    ]
]
