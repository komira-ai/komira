load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load("@komira//tools/build/platforms:isa_variants.bzl", "variant_label_name")
load("@komira//tools/build/platforms:table.bzl", "row")
load(":dist.bzl", "libkomira_dist_load", "picked_dir")
load(":elf_report.bzl", "libkomira_elf_report")
load(":variants.bzl", "libkomira_variants", "libkomira_variants_load", "libkomira_variants_manifest")
load("@komira//tools/build/package/install_check:install_check.bzl", "conda_install_check")

# libkomira as a conda package. The package is so's own: the library's
# `.mojoc` and `lib/libkomira.so` (the one shared library every SDK loads),
# with a `lib_files` row for the library in its metadata. Its requirements are
# the Mojo compiler pin (the package whose `lib/` holds the Mojo runtime the
# library is NEEDED on, libKGENCompilerRTShared.so and what that loads), the
# glibc floor of the platform table, and so's Mojo dependencies, all at
# the release's version and build. The plain `so_conda` of the library
# is the same package without the shared library: a release declares one of
# the two.
conda_package(
    name = "komira_so_libkomira_conda",
    lib = "//src/so:so",
    shared_lib = "//src/so:libkomira",
    summary = "libkomira, the shared library with komira's flat C API, and the Mojo library it is built from.",
    visibility = ["PUBLIC"],
)

# The package installed into an empty prefix, with the Mojo runtime its
# requirements install beside it, and the library loaded from there with
# RTLD_NOW: the four exports resolve, the version is at least 1.0, and every
# runtime library the loader maps is the prefix's.
conda_install_check(
    name = "libkomira_install",
    lib = "libkomira.so",
    min_version = 1000,
    # The packages libkomira's `depends` name for its NEEDED shared libraries:
    # each native owner's own package, installed beside it (libkomira bundles no
    # owner's library: each C owner ships its own in its own package), and each owner's library must be loaded from the prefix.
    owner_libs = [
        "libkomira_async_rt_native.so.1",
        "libkomira_async_api_native.so.1",
        "libkomira_compression_native.so.1",
        "libkomira_crypto_native.so.1",
        "libkomira_fs_native.so.1",
        "libkomira_http_core_native.so.1",
        "libkomira_libc_native.so.1",
        "libkomira_metrics_native.so.1",
        "libkomira_objectstore_native.so.1",
        "libkomira_scan_source_native.so.1",
        "libkomira_parquet_codec_native.so.1",
    ],
    owners = [
        "//src/async_rt:async_rt_conda",
        "//src/async_api:async_api_conda",
        "//src/compression:compression_conda",
        "//src/crypto:crypto_conda",
        "//src/fs:fs_conda",
        "//src/http_core:http_core_conda",
        "//src/libc:libc_conda",
        "//src/metrics:metrics_conda",
        "//src/objectstore:objectstore_conda",
        "//src/scan_source:scan_source_conda",
        "//src/parquet_codec:parquet_codec_conda",
    ],
    package = ":komira_so_libkomira_conda",
    symbols = [
        "komira_abi_version",
        "komira_ctx_free",
        "komira_ctx_new",
        "komira_last_error",
    ],
    version_symbol = "komira_abi_version",
    visibility = ["PUBLIC"],
)

# The negative of the `mojo-compiler` requirement. The same package is asked
# for a pin its `depends` does not hold (a package built without the compiler
# pin is the same defect: the runtime installed beside it would come from a
# compiler it never asked for). The target builds only while the check refuses
# with "depends does not hold". If `install_check.bzl` stopped passing
# `--require-depend`, the install would go through and this target would go red.
conda_install_check(
    name = "libkomira_install_unpinned",
    depend_pin = "0.0.0",
    expect_red = "does not hold `mojo-compiler ==0.0.0`",
    lib = "libkomira.so",
    package = ":komira_so_libkomira_conda",
)

# What libkomira links and weighs, read from the built files: size, SONAME,
# RUNPATH and DT_NEEDED of the library, of each native owner and of the Mojo
# runtime libraries, the highest GLIBC, GLIBCXX and CXXABI version each needs,
# which owners the library reaches, and the wheel tag that floor allows. The
# table in src/so/README.md is this target's output.
libkomira_elf_report(
    name = "libkomira_elf_report",
    lib = "//src/so:libkomira",
    native_owners = [
        "//src/async_rt:komira_async_native",
        "//src/async_api:komira_async_api_native",
        "//src/compression:komira_compression_native",
        "//src/crypto:komira_crypto_native",
        "//src/fs:komira_fs_native",
        "//src/http_core:komira_http_core_native",
        "//src/libc:komira_libc_native",
        "//src/metrics:komira_metrics_native",
        "//src/objectstore:komira_objectstore_native",
        "//src/parquet_codec:komira_parquet_codec_native",
        "//src/scan_source:komira_scan_source_native",
    ],
    visibility = ["PUBLIC"],
)

# ---- The native directory language packages carry ----------------------------
#
# `//src/so:libkomira[dist]`: libkomira, its native owners and the three Mojo
# runtime libraries, the one directory the Python wheel (python/BUCK) and every
# other language package copy as it is. These targets copy it to another path
# and load it there from a C caller with no library path set, no Python and
# nothing of Modular's (dist.bzl): libkomira answers komira_abi_version() as
# komira.h states, and every library is mapped from the copy.

_DIST = "//src/so:libkomira[dist]"

libkomira_dist_load(
    name = "libkomira_dist_load",
    dir = _DIST,
    src = "dist_load.c",
    header = "//src/so:komira_abi",
)

# The same directory with libMSupportGlobals.so left out: the load fails, and
# the loader's error names the missing file. The owners' file names are the
# table of src/so/README.md.
_OWNERS = [
    "libkomira_async_api_native.so.1",
    "libkomira_async_rt_native.so.1",
    "libkomira_compression_native.so.1",
    "libkomira_crypto_native.so.1",
    "libkomira_fs_native.so.1",
    "libkomira_http_core_native.so.1",
    "libkomira_libc_native.so.1",
    "libkomira_metrics_native.so.1",
    "libkomira_objectstore_native.so.1",
    "libkomira_parquet_codec_native.so.1",
    "libkomira_scan_source_native.so.1",
]

picked_dir(
    name = "dist_without_msupport",
    dir = _DIST,
    paths = ["libkomira.so"] + ["lib/" + n for n in _OWNERS + [
        "libAsyncRTRuntimeGlobals.so",
        "libKGENCompilerRTShared.so",
    ]],
)

libkomira_dist_load(
    name = "libkomira_dist_load_refuses_missing_runtime",
    dir = ":dist_without_msupport",
    src = "dist_load.c",
    header = "//src/so:komira_abi",
    expect_failure = "dist_load: cannot load <dir>/libkomira.so: libMSupportGlobals.so: cannot open shared object file: No such file or directory",
)

# ---- The CPU-level variants -----------------------------------------------------
#
# libkomira at every level of the linux-x86_64 row's `isa_variants`
# (tools/build/platforms/isa_variants.bzl), in one native directory with its
# VARIANTS manifest (variants.bzl): the floor, x86-64-v2, at libkomira.so, and
# x86-64-v3 at variants/x86-64-v3/libkomira.so, both over one lib/.

_ROW = row("linux-x86_64")

# The `native_owners` of //src/so:libkomira, which every variant links: one copy
# of each, in lib/.
_NATIVE_OWNERS = [
    "//src/async_rt:komira_async_native",
    "//src/async_api:komira_async_api_native",
    "//src/compression:komira_compression_native",
    "//src/crypto:komira_crypto_native",
    "//src/fs:komira_fs_native",
    "//src/http_core:komira_http_core_native",
    "//src/libc:komira_libc_native",
    "//src/metrics:komira_metrics_native",
    "//src/objectstore:komira_objectstore_native",
    "//src/parquet_codec:komira_parquet_codec_native",
    "//src/scan_source:komira_scan_source_native",
]

_LIBS = {v["name"]: "//src/so:libkomira_" + variant_label_name(v) for v in _ROW["isa_variants"]}

libkomira_variants(
    name = "libkomira_variants",
    libs = _LIBS,
    native_owners = _NATIVE_OWNERS,
    visibility = ["PUBLIC"],
)

# The directory's VARIANTS alone, written from the row without linking a
# variant: what the selector tests of the Python loader (python/tests) and of
# the Node package (node) read as the shipped manifest.
libkomira_variants_manifest(
    name = "libkomira_variants_manifest",
    visibility = ["//node:", "//python/tests:"],
)

staged_files(
    name = "variants_load_files",
    srcs = ["variants_load.c"],
)

cxx_binary(
    name = "variants_load_driver",
    srcs = [":variants_load_files[variants_load.c]"],
    headers = {"komira.h": "//src/so:komira_abi"},
    header_namespace = "",
)

# Each variant loaded from a copy of the directory with no library path, by the
# path its VARIANTS line names: `:libkomira_variants_load_x86_64_v2` and
# `:libkomira_variants_load_x86_64_v3`. A worker implements x86-64-v3, so both
# run on hardware that has every feature their line lists.
[
    libkomira_variants_load(
        name = "libkomira_variants_load_" + variant_label_name(v),
        dir = ":libkomira_variants",
        driver = ":variants_load_driver",
        variant = v["name"],
    )
    for v in _ROW["isa_variants"]
]

# x86-64-v3 is two directories below lib/ and finds the Mojo runtime only
# there (`$ORIGIN/../../lib`): with libMSupportGlobals.so left out of lib/, its
# load fails and the loader names the missing file, so no other copy of the
# runtime stands in for the directory's.
libkomira_variants(
    name = "variants_without_msupport",
    libs = _LIBS,
    native_owners = _NATIVE_OWNERS,
    omit = ["lib/libMSupportGlobals.so"],
)

libkomira_variants_load(
    name = "libkomira_variants_load_refuses_missing_runtime",
    dir = ":variants_without_msupport",
    driver = ":variants_load_driver",
    variant = "x86-64-v3",
    expect_failure = "variants_load: cannot load <dir>/variants/x86-64-v3/libkomira.so: libMSupportGlobals.so: cannot open shared object file: No such file or directory",
)

# A manifest line whose file is not in the directory: the load of that variant
# fails naming it, and never falls back to another variant.
libkomira_variants(
    name = "variants_without_v3",
    libs = _LIBS,
    native_owners = _NATIVE_OWNERS,
    omit = ["variants/x86-64-v3/libkomira.so"],
)

libkomira_variants_load(
    name = "libkomira_variants_load_refuses_missing_variant",
    dir = ":variants_without_v3",
    driver = ":variants_load_driver",
    variant = "x86-64-v3",
    expect_failure = "variants_load: cannot load <dir>/variants/x86-64-v3/libkomira.so: <dir>/variants/x86-64-v3/libkomira.so: cannot open shared object file: No such file or directory",
)

# What each variant links and weighs, as `libkomira_elf_report` above records
# `:libkomira`: `:libkomira_elf_report_x86_64_v2` and
# `:libkomira_elf_report_x86_64_v3`. The variants table of src/so/README.md
# is their output.
[
    libkomira_elf_report(
        name = "libkomira_elf_report_" + variant_label_name(v),
        lib = _LIBS[v["name"]],
        native_owners = _NATIVE_OWNERS,
    )
    for v in _ROW["isa_variants"]
]
