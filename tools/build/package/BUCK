# closure checks accept) equal to it, so the two cannot drift.
system_libs_record(
    name = "system_libs",
    visibility = ["//src/kci_release_set:"],
)

# The platform table's glibc floor per conda subdir, as `<subdir> <floor>`
# lines: kci_release_set's welded test holds kci's compiled copy (the one
# `__glibc >=<floor>` requirement it accepts) equal to it.
glibc_floor_record(
    name = "glibc_floor",
    visibility = ["//src/kci_release_set:"],
)

