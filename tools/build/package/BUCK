# The README check (release_set.bzl) over the fixtures in release_readme/.
# release_set_check exists only after each of these passed (its
# `readme_tests`).

# b's README holds a ```text sketch and a ```python block, no example; a,
# listed first, holds one. The refusal names b and quotes kci.
release_readme_test(
    name = "release_readme_refuses_no_example",
    members = ["a", "b"],
    readmes = {
        "a": "release_readme/one_example.txt",
        "b": "release_readme/no_example.txt",
    },
    refuses = "release member b: src/b/README.md holds no ```mojo or ```mojo module example, so kci's install validation would refuse it after publish: \"src/b/README.md holds no ```mojo example, so the validation would run nothing; add one\"",
)

# b packages no README.
release_readme_test(
    name = "release_readme_refuses_no_readme",
    members = ["a", "b"],
    readmes = {"a": "release_readme/one_example.txt"},
    refuses = "release member b: no README is packaged, so kci's install validation would refuse it after publish: \"b ships no share/doc/b/README.md: a release needs a README; add src/b/README.md\"",
)

# One ```mojo example.
release_readme_test(
    name = "release_readme_passes_one_example",
    members = ["a"],
    readmes = {"a": "release_readme/one_example.txt"},
)

# One ```mojo module example, and nothing else: it counts.
release_readme_test(
    name = "release_readme_passes_a_module_example",
    members = ["m"],
    readmes = {"m": "release_readme/module_example.txt"},
)

# The release order check (release_set.bzl) over the fixtures in
# release_order/, at version 1.0.0 and build string hb_1. release_set_check
# exists only after each of these passed (its `order_tests`).

# a requires b at the set's version and build string, b is listed after a.
release_order_test(
    name = "release_order_refuses_a_requirement_listed_later",
    version = "1.0.0",
    build = "hb_1",
    members = ["a", "b"],
    metadata_files = ["release_order/requires_b.json", "release_order/leaf.json"],
    refuses = "member a requires b, which release_set lists after it",
)

# The same requirement with b listed first.
release_order_test(
    name = "release_order_passes_a_requirement_listed_earlier",
    version = "1.0.0",
    build = "hb_1",
    members = ["b", "a"],
    metadata_files = ["release_order/leaf.json", "release_order/requires_b.json"],
)

# a requires b at another build string and at another version: not a
# requirement of this set, so no order is implied.
release_order_test(
    name = "release_order_passes_another_version_or_build",
    version = "1.0.0",
    build = "hb_1",
    members = ["a", "b"],
    metadata_files = ["release_order/requires_b_other_pin.json", "release_order/leaf.json"],
)

# a requires bb, whose name extends b's: not a requirement on b.
release_order_test(
    name = "release_order_passes_a_longer_name",
    version = "1.0.0",
    build = "hb_1",
    members = ["a", "b"],
    metadata_files = ["release_order/requires_bb.json", "release_order/leaf.json"],
)

# a requires _OLD_NATIVE at the set's version and build string, listed after
# it: refused like any other member. This proves the old exemption for that
# package is gone (the skip in the order check, deleted 2026-10-11, would let it
# pass).
release_order_test(
    name = "release_order_refuses_a_{}_requirement_listed_later".format(_OLD_NATIVE),
    version = "1.0.0",
    build = "hb_1",
    members = ["a", _OLD_NATIVE],
    metadata_files = ["release_order/requires_{}.json".format(_OLD_NATIVE), "release_order/leaf.json"],
    refuses = "member a requires {}, which release_set lists after it".format(_OLD_NATIVE),
)

