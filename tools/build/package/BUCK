# The wheel writer and its read-back check (wheel/main.zig; the rule is
# wheel.bzl). Each scenario is its own test, on synthetic files and ELF
# libraries (wheel/testing.zig), and the tool is built only behind all of
# them:
#   wheel_zip_unit     the zip: members, modes, dates and order read back,
#                      deflated or stored by size, the same bytes twice, the
#                      commit time as the DOS date, and a damaged or foreign
#                      zip refused by defect;
#   wheel_elf_unit     DT_NEEDED, run path and symbol versions read back, and a
#                      file that is not a 64-bit little-endian ELF or reads
#                      outside itself refused;
#   wheel_macho_unit   the Mach-O reader: install name, loads in command
#                      order, run paths and the minimum macOS (from either
#                      version command) read back, and a universal file, a
#                      file that is not Mach-O or reads outside itself refused;
#   wheel_codesign_unit  the code signature of a Mach-O file: an ad hoc
#                      signature of each hash type passes, and a file with
#                      none, a page or a requirements blob changed after
#                      signing, a code limit short of the signature, a slot
#                      count that is not the page count, an unknown hash type,
#                      a hash for a bundle file and a SuperBlob or blob outside
#                      its bounds are each refused by their exact message;
#   wheel_compare_unit two wheels of one package for two platforms
#                      (`komira_wheel same`): the macOS and Linux layouts pass
#                      with their native libraries as each one's own, and a
#                      Python file missing, added, changed or of another mode
#                      on one side, a Python file named as one side's own, a
#                      native file named but absent or on both sides, another
#                      version, another Python tag and a WHEEL differing beyond
#                      its Tag are each refused by their exact message;
#   wheel_policy_unit  the library checks: GLIBC_2.38 under a 2.34 tag, a
#                      GLIBCXX_ or CXXABI_ version over or without its bound,
#                      an absolute run path, an unlisted DT_NEEDED, a bundled
#                      Mojo runtime library, an ELF file in a macOS wheel, a
#                      Mach-O file in a manylinux wheel and a member over
#                      90 MB, each refused by its check's name; and for a macOS
#                      wheel, a dylib needing a newer macOS than the tag (and
#                      one with no minimum), another CPU, an install name that
#                      is not @rpath/<file>, a run path that is not
#                      @loader_path-relative, a load nobody provides and an
#                      unsigned dylib;
#   wheel_build_unit   the wheel: the same bytes twice and from inputs in
#                      another order, the members, METADATA, WHEEL and RECORD,
#                      the stamp's version (a half stamp refused), the tags
#                      taken and refused, and each input it cannot carry;
#   wheel_check_unit   the read-back check: the builder's wheel passes, and
#                      each defect is refused by its check's name;
#   wheel_cli_unit     the command line: flags, <name>=<value>, files and
#                      directories staged with their modes, a link refused,
#                      and the README as the description;
#   wheel_libs_unit    the finished wheel read alone (`komira_wheel libs`):
#                      komira's layout passes with its libraries in the
#                      loader's order, and a second or foreign or missing Mojo
#                      runtime library, a run path that misses, is absolute or
#                      leaves the package, an unresolved or path DT_NEEDED, a
#                      library nothing loads, a member outside the package, a
#                      missing runtime licence and a Requires-Dist of the
#                      runtime are each refused by their exact message, as are
#                      the command's flags and an expected refusal that differs.
_WHEEL_SRCS = [
    "wheel/check.zig",
    "wheel/cli.zig",
    "wheel/codesign.zig",
    "wheel/compare.zig",
    "wheel/diag.zig",
    "wheel/elf.zig",
    "wheel/libs.zig",
    "wheel/macho.zig",
    "wheel/policy.zig",
    "wheel/stamp.zig",
    "wheel/tag.zig",
    "wheel/wheel.zig",
    "wheel/zip.zig",
]

_WHEEL_SCENARIOS = ["build", "check", "cli", "codesign", "compare", "elf", "libs", "macho", "policy", "zip"]

[
    zig_test(
        name = "wheel_{}_unit".format(scenario),
        exec_compatible_with = LINUX_X86_64,
        src = "wheel/{}_test.zig".format(scenario),
        imports = _WHEEL_SRCS + ["wheel/testing.zig"],
        deps = [":pack_deflate"],
        busybox = "komira//tools/build/toolchains:busybox",
        zig = "komira//tools/build/toolchains:zig_next",
    )
    for scenario in _WHEEL_SCENARIOS
]

