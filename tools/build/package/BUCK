load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe")
load(":conda.bzl", "conda_manifest_kci")
load(":defs.bzl", "launcher_level_test")
load(":kcov_guard.bzl", "kcov_guard_cases", "kcov_guard_tool")
load(":release_set.bzl", "conda_release_set_check")

# The launcher's CPU level function against made-up CPUs (tools/build/package/launcher).
launcher_level_test(
    name = "level_test",
    exec_compatible_with = LINUX_X86_64,
)

# The package-format writer (tar, OCI), a static executable.
zig_exe(
    name = "komira_pack",
    exec_compatible_with = LINUX_X86_64,
    src = "pack/komira_pack.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# The version a release of the conda packages carries (conda.bzl); run by a
# release job, tested by tools/build/tests/functional/conda.sh. The other one
# prints the library packages' targets (the release tool declares which of
# them it publishes).
shell_lint(
    name = "shell_lint",
    srcs = [
        "kcov_guard.sh",
        "list_conda_targets.sh",
        "release_version.sh",
    ],
)

# kcov is GPL-2.0 and build-only: every package format runs this guard over
# what it packs and refuses a file that is kcov's bin/kcov or holds its usage
# line (kcov_guard.bzl, README.md "kcov is never packed"). Gated by the
# cases below, so a guard that cannot refuse is red.
kcov_guard_tool(
    name = "kcov_guard",
    exec_compatible_with = LINUX_X86_64,
    script = "kcov_guard.sh",
    checks = [":kcov_guard_cases"],
    visibility = ["PUBLIC"],
)

# The guard on known inputs: kcov renamed, as a file and under a path; kcov
# with a byte more and its usage line between NUL bytes (refused by the line);
# two offenders named together; symlinks to kcov and to a directory holding
# it; near misses of the line, the line split by a NUL or a newline, and
# kcov's libgcc_s.so.1 (accepted).
kcov_guard_cases(
    name = "kcov_guard_cases",
    exec_compatible_with = LINUX_X86_64,
    script = "kcov_guard.sh",
)

# release_version.sh as a file: kci_workflow_check's welded test holds kci.yml's
# documentation filter (its push trigger's paths-ignore) to the documentation
# this script does not count (rule R17).
export_file(
    name = "release_version.sh",
    src = "release_version.sh",
    visibility = ["//src/kci_workflow_check:"],
)

# Selectable form of linux-x86_64: what conda_package derives its subdir from
# (conda.bzl). Declared here and not in //tools/build/platforms, which holds
# exactly the platform table's targets (tests//functional/platform_table).
config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
    ],
    visibility = ["PUBLIC"],
)

# The stamped release path, before any release runs it (release_set.bzl): each
# library of the release set packaged with the fixed test stamp of conda.bzl
# (build number 999999999, build string h7e57c0de_999999999), their [release]
# manifests given to `komira_pack conda-meta`, and the metapackage read back.
# Red if a member's [release_check] fails, if a member or the metapackage does
# not carry the test stamp, if the metapackage does not require a member at
# that version and build string, if conda-check refuses it, or if `libs` and
# `metapackage` are not release_set.txt's (which kci_artifact's welded test
# holds equal to release/artifacts.textproto's metapackage).
conda_release_set_check(
    name = "release_set_check",
    metapackage = "komira_all",
    libs = ["//src/komira_encoding:komira_encoding"],
    release_set = "release_set.txt",
)

# The release set file: kci_artifact's welded test holds it equal to
# release/artifacts.textproto's metapackage (release_set.txt's header).
export_file(
    name = "release_set.txt",
    src = "release_set.txt",
    visibility = ["//src/kci_artifact:"],
)

# The stamped metapackage above, read with kci's own manifest parser
# (manifest_probe/BUCK): what a PUBLISH step reads.
conda_manifest_kci(
    name = "release_set_kci",
    package = ":release_set_check",
)
