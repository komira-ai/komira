# The release order check (release_set.bzl) over the fixtures in
# release_order/, at version 1.0.0 and build string hb_1. release_set_check
# exists only after each of these passed (its `order_tests`).

# a requires b at the set's version and build string, b is listed after a.
release_order_test(
    name = "release_order_refuses_a_requirement_listed_later",
    version = "1.0.0",
    build = "hb_1",
    members = ["a", "b"],
    metadata_files = ["release_order/requires_b.json", "release_order/leaf.json"],
    refuses = "member a requires b, which release_set lists after it",
)

# The same requirement with b listed first.
release_order_test(
    name = "release_order_passes_a_requirement_listed_earlier",
    version = "1.0.0",
    build = "hb_1",
    members = ["b", "a"],
    metadata_files = ["release_order/leaf.json", "release_order/requires_b.json"],
)

# a requires b at another build string and at another version: not a
# requirement of this set, so no order is implied.
release_order_test(
    name = "release_order_passes_another_version_or_build",
    version = "1.0.0",
    build = "hb_1",
    members = ["a", "b"],
    metadata_files = ["release_order/requires_b_other_pin.json", "release_order/leaf.json"],
)

# a requires bb, whose name extends b's: not a requirement on b.
release_order_test(
    name = "release_order_passes_a_longer_name",
    version = "1.0.0",
    build = "hb_1",
    members = ["a", "b"],
    metadata_files = ["release_order/requires_bb.json", "release_order/leaf.json"],
)

# a requires komira_native, listed after it: the one exemption.
release_order_test(
    name = "release_order_exempts_komira_native",
    version = "1.0.0",
    build = "hb_1",
    members = ["a", "komira_native"],
    metadata_files = ["release_order/requires_komira_native.json", "release_order/leaf.json"],
)

# The release set file: kci_artifact's welded test holds it equal to
# release/artifacts.textproto's metapackage (release_set.txt's header).
export_file(
    name = "release_set.txt",
    src = "release_set.txt",
    visibility = ["//src/kci_artifact:"],
)

# system_libs.bzl's table as `<soname> <requirement>` lines: kci_release_set's
# welded test holds kci's compiled copy (the conda-forge requirements its
# closure checks accept) equal to it, so the two cannot drift.
system_libs_record(
    name = "system_libs",
    visibility = ["//src/kci_release_set:"],
)

# The stamped metapackage above, read with kci's own manifest parser
# (manifest_probe/BUCK): what a PUBLISH step reads.
conda_manifest_kci(
    name = "release_set_kci",
    package = ":release_set_check",
)
