# The version a release of the conda packages carries (conda.bzl); run by a
# release job, tested by tools/build/tests/functional/conda.sh. The other one
# prints the library packages' targets (the release tool declares which of
# them it publishes).
shell_lint(
    name = "shell_lint",
    srcs = [
        "list_conda_targets.sh",
        "release_version.sh",
    ],
)

# kcov is GPL-2.0 and build-only: every package format runs this guard over
# what it packs and refuses a file that is kcov's bin/kcov (by the sha256 in
# tools/build/toolchains/kcov/identity.bzl) or holds its usage line
# (kcov_guard.bzl, README.md "kcov is never packed"). It depends on no kcov
# target. Gated by the cases below, so a guard that cannot refuse is red.
kcov_guard_tool(
    name = "kcov_guard",
    exec_compatible_with = LINUX_X86_64,
    checks = [":kcov_guard_cases"],
    visibility = ["PUBLIC"],
)

# The guard on known inputs, with a fixture file standing for bin/kcov (its
# sha256 is passed as the constant): a malformed sha256 or an empty line
# (refused); the fixture renamed, as a file and under a path (refused by the
# sha256); a file holding the usage line after other bytes, and the line
# between NUL bytes (refused by the line); two offenders named together;
# symlinks to the fixture and to a directory holding it; near misses of the
# line, the line split by a NUL or a newline, and the fixture with a byte
# more (accepted); and three of those through the guard's command line, as
# the package rules run it.
kcov_guard_cases(
    name = "kcov_guard_cases",
    exec_compatible_with = LINUX_X86_64,
)

# release_version.sh as a file: kci_workflow_check's welded test holds kci.yml's
# documentation filter (its push trigger's paths-ignore) to the documentation
# this script does not count (rule R17).
export_file(
    name = "release_version.sh",
    src = "release_version.sh",
    visibility = ["//src/kci_workflow_check:"],
)

# Selectable form of linux-x86_64: what conda_package derives its subdir from
# (conda.bzl). Declared here and not in //tools/build/platforms, which holds
# exactly the platform table's targets (tests//functional/platform_table).
config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
    ],
    visibility = ["PUBLIC"],
)

# The package of the superseded one-library plan (retired 2026-10-07): the
# release order fixture below requires it, so that an exemption for it cannot
# come back. Spelt in parts, as the root BUCK's retired_names lint asks.
_OLD_NATIVE = "komira" + "_native"

# The stamped release path, before any release runs it (release_set.bzl): each
# library of the release set packaged with the fixed test stamp of conda.bzl
# (build number 999999999, build string h7e57c0de_999999999), their [release]
# manifests given to `komira_pack conda-meta`, and the metapackage read back.
# Red if a member's [release_check] fails, if a member or the metapackage does
# not carry the test stamp, if the metapackage does not require a member at
# that version and build string, if a member requires a member listed after
# it, if a member packages no README or one with no ```mojo example (kci's
# install validation refuses both, after publish), if conda-check refuses it,
# or if `libs` and
# `metapackage` are not release_set.txt's (which kci_artifact's welded test
# holds equal to release/artifacts.textproto's metapackage).
