    imports = [
        "pack/common.zig",
        "pack/conda.zig",
        "pack/conda_check.zig",
        "pack/conda_dlopen.zig",
        "pack/conda_index.zig",
        "pack/conda_lib.zig",
        "pack/conda_meta.zig",
        "pack/deflate.zig",
        "pack/readme_link.zig",
        "pack/tar_oci.zig",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# pkg_act (act/pkg_act.zig): the small actions of the package rules, in place
# of their busybox scripts: the bundle assembly (bundle.zig), the kcov guard and
# its cases (kcov_guard.zig), the release-set checks (release.zig), the OCI
# release manifest, the conda manifest read-back and the directory copy of the
# joins (misc.zig). Built behind its unit tests; its process cases are
# tests//functional/pkg_act.
zig_test(
    name = "pkg_act_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "act/pkg_act_test.zig",
    imports = [
        "act/bundle.zig",
        "act/kcov_guard.zig",
        "act/misc.zig",
        "act/release.zig",
    ],
    deps = ["//tools/build/act_util:act_util"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

