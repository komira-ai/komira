# The rule on fixtures (wheel/fixtures/): a linux-x86_64 wheel holding a real
# Mojo shared library (the example `plain`, which needs the Mojo runtime:
# external_needed; an ELF library, so a darwin-arm64 build skips it and
# `wheel_file_name_cases`) at the test stamp, so building it runs [check] and
# [release_check], the twin's byte equality among them; and wheels of plain
# files for the linux-arm64 and darwin-arm64 (macOS) rows, whose tags are
# derived the same way.
wheel_file_test_stamped(
    name = "wheel_fixture",
    distribution = "komira-wheel-fixture",
    summary = "The wheel rule's fixture",
    readme = "wheel/fixtures/readme.md",
    requires_python = ">=3.13",
    requires_dist = ["mojo-compiler==1.0.0"],
    classifiers = ["Programming Language :: Python :: 3 :: Only"],
    project_urls = {"Source": "https://github.com/komira-ai/komira"},
    license_expression = "Apache-2.0",
    files = {
        "komira_wheel_fixture/_lib/plain.so": "komira//tools/build/examples/shared_lib:plain",
        "komira_wheel_fixture/data.txt": "wheel/fixtures/data.txt",
    },
    executable = ["komira_wheel_fixture/_lib/plain.so"],
    external_needed = [
        "libAsyncRTRuntimeGlobals.so",
        "libKGENCompilerRTShared.so",
        "libMSupportGlobals.so",
    ],
    target_compatible_with = LINUX_X86_64,  # komira-limit:manylinux-wheel-linux-x86-64
)

# Named by the tag they test: each is built on linux like every other
# target; only its tag is another platform's.
[
    wheel_file_test_stamped(
        name = "wheel_fixture_{}_tag".format(tag),
        distribution = "komira-wheel-fixture",
        summary = "The wheel rule's fixture",
        readme = "wheel/fixtures/readme.md",
        requires_python = ">=3.13",
        license_expression = "Apache-2.0",
        files = {"komira_wheel_fixture/data.txt": "wheel/fixtures/data.txt"},
        platform = platform,
    )
    for tag, platform in [("aarch64", "linux-arm64"), ("macosx", "darwin-arm64")]
]

# The `[file_name]` of two fixtures read back (wheel/file_name_test.zig): each is the one line
# of its distribution, the stamp's version and its row's tag, and agrees with the wheel the same
# target wrote (its dist-info directory, METADATA's Version, WHEEL's Tag); a name that does not
# agree is refused. pypi.yml asks TestPyPI for the macOS wheel's `[file_name]` before building it.
zig_test(
    name = "wheel_file_name_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "wheel/file_name_test.zig",
    imports = ["wheel/diag.zig", "wheel/zip.zig"],
    deps = [":pack_deflate"],
    data = {
        "linux.file_name": ":wheel_fixture[file_name]",
        "linux.whl": ":wheel_fixture[release]",
        "macosx.file_name": ":wheel_fixture_macosx_tag[file_name]",
        "macosx.whl": ":wheel_fixture_macosx_tag[release]",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    target_compatible_with = LINUX_X86_64,  # komira-limit:manylinux-wheel-linux-x86-64
)

# The tag of each release platform's row, written out: the glibc floor and
# the macOS floor of tools/build/platforms/table.bzl. A fixture row at
# another glibc floor shows the floor is read from the row. A member path
# holding either brace is refused by its exact message; a plain path is not.
wheel_tag_cases(
    name = "wheel_tag_cases",
    cases = {
        "linux-arm64": "py3-none-manylinux_2_34_aarch64",
        "linux-x86_64": "py3-none-manylinux_2_34_x86_64",
        "darwin-arm64": "py3-none-macosx_11_0_arm64",
    },
    linux_floors = {"glibc-2.28": "py3-none-manylinux_2_28_x86_64"},
    path_refusals = {
        "komira/lib{x}.so": "fixture: the path komira/lib{x}.so holds a brace, which a command-line format would misread",
        "komira/}.txt": "fixture: the path komira/}.txt holds a brace, which a command-line format would misread",
        "komira/plain.txt": "",
    },
)

