load("@komira//tools/build/mojo:defs.bzl", "mojo_shared_lib")

# One C-ABI export whose Mojo closure reaches komira_libc, a library that owns
# C and ships it as its own shared library. `native_owners` links that shared
# library (NEEDED) instead of the owner's static archive; the gate stages it
# in lib/ beside the library and checks it is mapped.
mojo_shared_lib(
    name = "spike_native",
    srcs = ["abi.mojo"],
    exports = ["native_owner_write_probe"],
    exports_exact = True,
    gate_srcs = ["call_driver.mojo"],
    deps = ["//src/komira_libc:komira_libc"],
    native_owners = ["//src/komira_libc:komira_libc_native"],
)
