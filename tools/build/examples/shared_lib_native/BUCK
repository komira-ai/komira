load("@komira//tools/build/mojo:c_abi_check.bzl", "komira_c_abi_check")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_shared_lib")

# One C-ABI export whose Mojo closure reaches libc, a library that owns
# C and ships it as its own shared library. `native_owners` links that shared
# library (NEEDED) instead of the owner's static archive; the gate stages it
# in lib/ beside the library and checks it is mapped.
mojo_shared_lib(
    name = "spike_native",
    srcs = ["abi.mojo"],
    exports = ["native_owner_write_probe"],
    exports_exact = True,
    gate_srcs = ["call_driver.mojo"],
    deps = ["//src/libc:libc"],
    native_owners = ["//src/libc:komira_libc_native"],
    # tests//negative/shared_lib:dist_without_owner reads its [dist].
    visibility = ["PUBLIC"],
)

# The gate driver, for its negative twin
# tests//negative/shared_lib:owner_embedded_bound.
export_file(
    name = "call_driver.mojo",
    visibility = ["PUBLIC"],
)

# A host of `[dist]`, the directory a language package copies: dist_load.mojo
# opens the library from a copy of it at ./dist, with no other copy of the owner
# in the run tree, and calls the export (on Linux and macOS arm64).
# tests//negative/shared_lib:dist_without_owner is the same check on that
# directory with the owner left out, and fails.
mojo_binary(
    name = "dist_load",
    srcs = ["dist_load.mojo"],
    visibility = ["PUBLIC"],
)

komira_c_abi_check(
    name = "spike_native_dist_load",
    driver = ":dist_load",
    lib = ":spike_native",
    data = {"dist": ":spike_native[dist]"},
)
