load("@komira//tools/build/mojo:run_check.bzl", "run_check_wired")
load("@komira//tools/build/rust:defs.bzl", "rust_binary")

# A Rust binary using a derive macro from a registry crate: exercises the
# pinned toolchain, a proc-macro, the rlib closure and the zig link.
rust_binary(
    name = "prost_roundtrip",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = ["//third_party/rust:prost"],
    # field 1 (string "hi"), field 2 (varint 300).
    expected_stdout = "0a 02 68 69 10 ac 02\nhi 300\n",
)

# prost_roundtrip returns its run check as a validation: a rust_binary rule
# that stopped returning it would build it green with no run check run, and
# fails this target's analysis instead.
run_check_wired(
    name = "run_check_wired",
    binaries = [":prost_roundtrip"],
)
