# bisect (README.md): the first commit between a good and a bad one at which
# the given Buck2 targets stop building, found by building them at
# first-parent commits in worktrees of their own. A Zig tool, as every build
# tool under tools/build is; built behind its unit tests and its scenarios.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "bisect_scenario")

_SRCS = [
    "classify.zig",
    "git.zig",
    "main.zig",
    "probe.zig",
    "report.zig",
    "search.zig",
]

_FIXTURES = [
    "testdata/report_action_failed.json",
    "testdata/report_analysis_failed.json",
    "testdata/report_success.json",
]

# ---- Unit tests: `zig test` of each, run as a build action -------------------

[
    zig_test(
        name = name + "_unit",
        exec_compatible_with = LINUX_X86_64,
        src = name + "_test.zig",
        imports = _SRCS + _FIXTURES,
        busybox = "komira//tools/build/toolchains:busybox",
        zig = "komira//tools/build/toolchains:zig",
    )
    for name in [
        "classify",
        "main",
        "report",
        "search",
    ]
]

_UNIT = [
    ":classify_unit",
    ":main_unit",
    ":report_unit",
    ":search_unit",
]

# ---- The tool the scenarios run, behind its unit tests -----------------------

zig_exe(
    name = "bisect_unchecked",
    exec_compatible_with = LINUX_X86_64,
    src = "main.zig",
    imports = _SRCS,
    unit_tests = _UNIT,
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# ---- Scenarios (testing/scenario.zig): one build action each -----------------

zig_exe(
    name = "fake_buck2",
    exec_compatible_with = LINUX_X86_64,
    src = "testing/fake_buck2.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "scenario",
    exec_compatible_with = LINUX_X86_64,
    src = "testing/scenario.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

_SCENARIOS = [
    "culprit_first",
    "culprit_last",
    "culprit_middle",
    "flake",
    "good_not_ancestor",
    "infra_boundary",
    "infra_retried",
    "single_commit",
    "two_culprits",
]

[
    bisect_scenario(
        name = s,
        exec_compatible_with = LINUX_X86_64,
        bisect = ":bisect_unchecked",
        fake_buck2 = ":fake_buck2",
        git = "//third_party/git:git",
        scenario = ":scenario",
    )
    for s in _SCENARIOS
]

# ---- The tool: built only when every unit test and scenario passed -----------

zig_exe(
    name = "bisect",
    exec_compatible_with = LINUX_X86_64,
    src = "main.zig",
    imports = _SRCS,
    unit_tests = _UNIT + [":" + s for s in _SCENARIOS],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)
