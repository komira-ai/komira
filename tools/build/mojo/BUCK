load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/platforms:table.bzl", "row")
load(":toolchain.bzl", "zig_bootstrap_exe", "zig_exe", "zig_test")

# Scripts and tool sources used by the Mojo rules.
# The compile wrapper (tools/mojo_compile.zig; docs/design/zig_compile_wrapper.md):
# every Mojo compile on Linux runs through it, and it is the `cc` the
# compiler links with. Its unit tests (`zig test` of mojo_compile.zig, whose
# test block imports every module) run as a build action; the executable
# is not built unless they passed. Its process cases are
# tests//functional/watchdog:cases.
_MOJO_COMPILE_SRCS = [
    "tools/cc_shim.zig",
    "tools/compile_args.zig",
    "tools/modular_cfg.zig",
    "tools/mojo_compile.zig",
    "tools/proc_tree.zig",
]

zig_test(
    name = "mojo_compile_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _MOJO_COMPILE_SRCS,
    src = "tools/mojo_compile.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "mojo_compile",
    exec_compatible_with = LINUX_X86_64,
    imports = _MOJO_COMPILE_SRCS,
    src = "tools/mojo_compile.zig",
    unit_tests = [":mojo_compile_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# The same wrapper for macOS arm64 (tools/mojo_compile_macos.zig, the macOS
# main over the same modules), built on a Linux worker for the darwin triple:
# the darwin-arm64 toolchain's `wrapper` (darwin.bzl). Its unit tests run on
# Linux (the pure modules, the libproc layouts); its process cases run on the
# macOS workers (tests//functional/watchdog:cases_darwin).
_MOJO_COMPILE_MACOS_SRCS = _MOJO_COMPILE_SRCS + [
    "tools/host_identity.zig",
    "tools/mojo_compile_macos.zig",
    "tools/proc_tree_macos.zig",
]

zig_test(
    name = "mojo_compile_darwin_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _MOJO_COMPILE_MACOS_SRCS,
    src = "tools/mojo_compile_macos.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "mojo_compile_darwin",
    exec_compatible_with = LINUX_X86_64,
    imports = _MOJO_COMPILE_MACOS_SRCS,
    src = "tools/mojo_compile_macos.zig",
    target = row("darwin-arm64")["zig_triple"],
    unit_tests = [":mojo_compile_darwin_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# The runner of every `zig_test` action (tools/zig_launch.zig). It is built by
# the pinned zig directly (`zig_bootstrap_exe`: no shell, no busybox), behind
# its unit tests, because the rules that run it cannot build it.
zig_bootstrap_exe(
    name = "zig_launch",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/zig_launch.zig",
    test_src = "tools/zig_launch_test.zig",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# act (tools/act.zig): the small actions of the Mojo and Rust rules (copy a
# published file once its markers exist, cat the README join's markers, run a
# built binary in a clean environment and compare its stdout), in place of
# run_check.sh and the busybox cp and cat applets. Built behind its unit tests;
# its process cases are tests//functional/act.
zig_test(
    name = "act_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["tools/act.zig"],
    src = "tools/act_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "act",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/act.zig",
    unit_tests = [":act_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# doc_check (tools/doc_check.zig): the golden, symbol and copy checks of
# mojo_doc_json (doc.bzl). Built behind its unit tests; the cases are
# tests//negative/mojo_doc_json (a stale golden, missing symbols) and the docs
# of the library packages.
zig_test(
    name = "doc_check_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["tools/doc_check.zig"],
    src = "tools/doc_check_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "doc_check",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/doc_check.zig",
    unit_tests = [":doc_check_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# The same for macOS arm64 (the darwin toolchain's `act`), built on a Linux worker.
zig_exe(
    name = "act_darwin",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/act.zig",
    target = row("darwin-arm64")["zig_triple"],
    unit_tests = [":act_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

export_file(name = "proto_fixture.sh", visibility = ["PUBLIC"])

export_file(name = "conda_unpack.zig", src = "tools/conda_unpack.zig", visibility = ["PUBLIC"])

export_file(name = "launch.sh", visibility = ["PUBLIC"])
export_file(name = "zig_cc_launcher.zig", src = "tools/zig_cc_launcher.zig", visibility = ["PUBLIC"])

# The rule of the branch coverage actions, as data for the coverage
# workflow's cases (the root BUCK's coverage_ci_cases), which hold
# .github/ci/coverage_measure.sh's list of their categories equal to its.
export_file(name = "coverage_branch.bzl", visibility = ["PUBLIC"])

# Every script above; a validation of the Mojo toolchain (toolchain.bzl).
shell_lint(
    name = "shell_lint",
    srcs = glob(["*.sh"]),
    visibility = ["PUBLIC"],
)
