load("@komira//tools/build/lint:defs.bzl", "doc_tree", "shell_lint")

# Scripts and tool sources used by the Mojo rules.
export_file(name = "mojo_wrapper.sh", visibility = ["PUBLIC"])

export_file(name = "gate_runner.sh", visibility = ["PUBLIC"])

export_file(name = "run_check.sh", visibility = ["PUBLIC"])

export_file(name = "numa_guard.sh", visibility = ["PUBLIC"])

export_file(name = "conda_unpack.zig", src = "tools/conda_unpack.zig", visibility = ["PUBLIC"])

export_file(name = "launch.sh", visibility = ["PUBLIC"])
export_file(name = "zig_cc_launcher.zig", src = "tools/zig_cc_launcher.zig", visibility = ["PUBLIC"])

# Every script above; a validation of the Mojo toolchain (toolchain.bzl).
shell_lint(
    name = "shell_lint",
    srcs = glob(["*.sh"]),
    visibility = ["PUBLIC"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["komira//:docs"],
)
