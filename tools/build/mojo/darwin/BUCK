load("@komira//tools/build/lint:defs.bzl", "doc_tree", "shell_lint")

# Scripts of the macOS arm64 Mojo toolchain (see darwin.bzl).
export_file(name = "busybox.sh", visibility = ["PUBLIC"])

export_file(name = "cc", visibility = ["PUBLIC"])

export_file(name = "mojo_wrapper.sh", visibility = ["PUBLIC"])

export_file(name = "dyld_prelude.sh", visibility = ["PUBLIC"])

export_file(name = "host_identity.sh", visibility = ["PUBLIC"])

# Every script above; a validation of the Mojo toolchain (toolchain.bzl).
shell_lint(
    name = "shell_lint",
    srcs = glob(["*.sh"]) + ["cc"],
    visibility = ["PUBLIC"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["komira//:docs"],
)
