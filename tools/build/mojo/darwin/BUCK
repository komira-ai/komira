load("@komira//tools/build/lint:defs.bzl", "shell_lint")

# Scripts of the macOS arm64 Mojo toolchain (see darwin.bzl). The compile
# runs none of them: its wrapper is komira//tools/build/mojo:mojo_compile_darwin.
export_file(name = "busybox.sh", visibility = ["PUBLIC"])

export_file(name = "dyld_prelude.sh", visibility = ["PUBLIC"])

# Every script above; a validation of the Mojo toolchain (toolchain.bzl).
shell_lint(
    name = "shell_lint",
    srcs = glob(["*.sh"]),
    visibility = ["PUBLIC"],
)
