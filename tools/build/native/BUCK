# Symbol prefixing of the vendored C libraries, and libkomira_native.so.1
# (README.md): the symbol reader, the scripts of the rules in defs.bzl and
# komira_native.bzl, and the shared library itself.
load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/package:conda.bzl", "conda_manifest_kci", "conda_native_package")
load("@komira//tools/build/package:conda_prefix.bzl", "conda_prefix")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "c_exe", "checked_cxx_library")
load(":komira_native.bzl", "komira_native", "komira_native_run_test")
load(":members.bzl", "ARCHIVES", "CALLERS", "PER_LIBRARY")

# elfsyms: an archive's symbol table and its members' symbols, a shared
# object's dynamic section and symbols (elfsyms.c).
c_exe(
    name = "elfsyms",
    exec_compatible_with = LINUX_X86_64,
    src = "elfsyms.c",
    visibility = ["PUBLIC"],
)

# callsites: the external_call names of Mojo sources, by tokenizing them
# (callsites.c); the second reader of the call sites, for
# native_callsite_check.sh.
c_exe(
    name = "callsites",
    exec_compatible_with = LINUX_X86_64,
    src = "callsites.c",
)

export_file(
    name = "prefix_header.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "archive_check.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "native_exports.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "native_link.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "native_check.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "native_callsite_check.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "native_run.sh",
    visibility = ["PUBLIC"],
)

shell_lint(
    name = "shell_lint",
    srcs = [
        "archive_check.sh",
        "native_callsite_check.sh",
        "native_check.sh",
        "native_exports.sh",
        "native_link.sh",
        "native_run.sh",
        "prefix_header.sh",
    ],
)

# libkomira_native.so.1: every C archive komira's Mojo packages call that
# holds nothing per library, with the prefixed vendored libraries, exporting
# exactly the names those packages pass to external_call (README.md, "One
# shared library"). The export check is a validation of this target.
komira_native(
    name = "libkomira_native",
    archives = ARCHIVES,
    # Every package whose sources call a name one of the archives defines
    # (a package calling one it does not list fails its own link against the
    # library). The lists are in members.bzl, which the conda packages of the
    # Mojo libraries read too.
    callers = CALLERS,
    exec_compatible_with = LINUX_X86_64,
    per_library = PER_LIBRARY,
    soname = "libkomira_native.so.1",
)

# Mojo programs calling aws-lc, snappy, s2n-tls and komira_libc's shim
# through the library, as a conda environment would hold it (native_run.sh).
komira_native_run_test(
    name = "komira_native_run_test",
    cases = [
        "R1",
        "B1",
        "IR1",
        "IR2",
    ],
    exec_compatible_with = LINUX_X86_64,
    lib = ":libkomira_native",
    mojoc = {"komira_libc": "//src/komira_libc:komira_libc"},
    srcs = [
        "run_test/native_checks.mojo",
        "run_test/native_dlopen.mojo",
        "run_test/native_interpose.mojo",
        "run_test/native_openssl.mojo",
        "run_test/native_run.mojo",
        "run_test/native_util.mojo",
    ],
)

# The library as others name it: :libkomira_native gated by the run test
# (and by its own export check).
checked_cxx_library(
    name = "komira_native",
    checks = [":komira_native_run_test"],
    lib = ":libkomira_native",
    visibility = ["PUBLIC"],
)

# The conda package `komira_native`: lib/libkomira_native.so.1 and the link
# name lib/libkomira_native.so, from :komira_native (so it exists only after
# the export checks and the run test passed). Every Mojo library whose closure
# links an archive of the library requires it at the same version and build
# string (tools/build/package/conda.bzl).
conda_native_package(
    name = "komira_native_conda",
    lib = ":komira_native",
    summary = "komira's C in one shared library: the komira C shims and the symbol-prefixed aws-lc, s2n-tls and snappy that komira's Mojo packages call.",
    visibility = ["PUBLIC"],
)

# The packages as a user installs them: komira_crypto's conda package and
# what its run requirements reach among the pool below, extracted into an
# environment (tools/build/package/conda_prefix.bzl), and a program calling
# aws-lc through komira_crypto run (R1) and built and run (B1) there. Only the
# requirements decide what is installed, so a library package that stopped
# requiring komira_native has no libkomira_native.so.1 here and fails.
conda_prefix(
    name = "installed_crypto_prefix",
    packages = [
        ":komira_native_conda",
        "//src/komira_crypto:komira_crypto_conda",
        "//src/komira_encoding:komira_encoding_conda",
    ],
    root = "komira_crypto",
)

komira_native_run_test(
    name = "installed_crypto_run_test",
    cases = [
        "R1",
        "B1",
    ],
    exec_compatible_with = LINUX_X86_64,
    prefix = ":installed_crypto_prefix",
    program = "installed_crypto",
    srcs = [
        "run_test/installed_crypto.mojo",
        "run_test/native_util.mojo",
    ],
)

# komira_log's package ships its per_library holder archive
# (lib/libkomira_log_holder.a), which a program links into its own image
# (`-lkomira_log_holder`); `mojo run` links no static archive, so only B1.
conda_prefix(
    name = "installed_log_prefix",
    packages = [
        ":komira_native_conda",
        "//src/komira_atomic_alias:komira_atomic_alias_conda",
        "//src/komira_clock:komira_clock_conda",
        "//src/komira_collections:komira_collections_conda",
        "//src/komira_fork_join:komira_fork_join_conda",
        "//src/komira_hash:komira_hash_conda",
        "//src/komira_libc:komira_libc_conda",
        "//src/komira_log:komira_log_conda",
        "//src/komira_metrics:komira_metrics_conda",
        "//src/komira_name_registry:komira_name_registry_conda",
        "//src/komira_spsc_ring:komira_spsc_ring_conda",
        "//src/komira_trace:komira_trace_conda",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths_conda",
    ],
    root = "komira_log",
)

komira_native_run_test(
    name = "installed_log_run_test",
    cases = ["B1"],
    exec_compatible_with = LINUX_X86_64,
    link = ["komira_log_holder"],
    prefix = ":installed_log_prefix",
    program = "installed_log",
    srcs = [
        "run_test/installed_log.mojo",
        "run_test/native_util.mojo",
    ],
)

# The native package's manifest and metadata.json, read with kci's
# artifact-manifest parser and conda metadata reader
# (tools/build/package/manifest_probe): what a PUBLISH step reads. Red unless
# kci reads the metadata as kind `native`.
conda_manifest_kci(
    name = "komira_native_conda_kci",
    kind = "native",
    package = ":komira_native_conda",
)
