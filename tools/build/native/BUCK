# Symbol prefixing of the vendored C libraries (README.md): the tool of the
# rules in defs.bzl, and the shared-library tools of shared.bzl.
load("@komira//tools/build/mojo:toolchain.bzl", "exec_tool_target", "zig_exe", "zig_module", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64", "TOOL_EXEC")
load(":shared.bzl", "glibc_floor_test", "shared_form_test")

# Built with zig 0.15.2 (`:zig_next`); the executables are built behind the check
# that the pin is that release.
_ZIG = "komira//tools/build/toolchains:zig_next"
_ZIG_VERSION = "komira//tools/build/toolchains:zig_next_version"

# native_so: a library's shared library, its export list and checks 1 to 7
# (README.md, "Each library's shared library"; shared.bzl), in Zig. It reads
# ELF and Mach-O (native_macho.zig) alike.
_NATIVE_SO = [
    "native_callsites.zig",
    "native_checks.zig",
    "native_elf.zig",
    "native_elf_test.zig",
    "native_macho.zig",
    "native_macho_test.zig",
    "native_so_test.zig",
]

# The unit tests (native_so_test.zig: each check green, and red on the
# defect it exists for; native_macho_test.zig: the Mach-O reader and checks 1 to 7
# on Mach-O bytes), run as a build action.
zig_test(
    name = "native_so_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _NATIVE_SO,
    src = "native_so.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
)

# Built behind its unit tests: no shared library is checked unless they pass.
# native_shared_library takes it as an exec_dep, so it is configured for the
# execution platform of the library's actions: on darwin-arm64 the macOS one
# (the Mojo toolchain's), whose workers cannot run a Linux executable. It is
# built for the platform it is configured for (`exec_tool_target`; zig still
# runs on TOOL_EXEC and cross-compiles); on linux x86_64 the triple is the one
# it always had, so linux action keys are unchanged.
zig_exe(
    name = "native_so",
    exec_compatible_with = TOOL_EXEC,
    imports = _NATIVE_SO,
    src = "native_so.zig",
    target = exec_tool_target(),
    unit_tests = [":native_so_unit", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# so_report: the ELF record of libkomira and what it loads (so_report.zig),
# as a markdown table. Its tests read built shared objects and values.
# native_elf.zig imports native_macho.zig (it hands Mach-O bytes there), so the
# Mach-O reader is an input here too.
_SO_REPORT = [
    "native_elf.zig",
    "native_elf_test.zig",
    "native_checks.zig",
    "native_macho.zig",
    "so_report_test.zig",
]

zig_test(
    name = "so_report_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _SO_REPORT,
    src = "so_report.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
)

# Built behind its unit tests: no report is written unless they pass.
zig_exe(
    name = "so_report",
    exec_compatible_with = LINUX_X86_64,
    imports = _SO_REPORT,
    src = "so_report.zig",
    unit_tests = [":so_report_unit", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The object reader (native_elf.zig, which hands Mach-O to native_macho.zig) as
# a module prefix_tool imports by name, `@import("native_objects")`: zig refuses
# a relative import of ../native_elf.zig from src/. Welded to the reader's own
# cases (`:native_so_unit` runs native_elf_test.zig and native_macho_test.zig).
zig_module(
    name = "native_objects",
    src = "native_elf.zig",
    imports = ["native_macho.zig"],
    unit_tests = [":native_so_unit"],
)

# prefix_tool's sources, and the two archives its cases read
# (src/testdata/README.md says what each holds and how it was made).
_SRCS = glob(["src/*.zig"]) + [
    "src/testdata/elf_x86_64.a",
    "src/testdata/macho_arm64.a",
]

# The unit tests of prefix_tool: `zig test` of main.zig, whose test block
# imports prefix_test.zig and cli_test.zig, run as a build action.
zig_test(
    name = "prefix_tool_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _SRCS,
    src = "src/main.zig",
    deps = [":native_objects"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
)

# prefix_tool (Zig): `header` writes a prefix_header's header, `check` is a
# prefixed_archive_check. Built behind its unit tests: no header or check
# runs unless they pass.
zig_exe(
    name = "prefix_tool",
    exec_compatible_with = LINUX_X86_64,
    imports = _SRCS,
    src = "src/main.zig",
    deps = [":native_objects"],
    unit_tests = [":prefix_tool_unit", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The glibc floor is read from a platform row: a fixture row with a floor no
# real row has (glibc 2.17) must give 2.17, so a constant floor is red here.
glibc_floor_test(
    name = "glibc_floor_fixture_row",
    expect = "2.17",
    os_floor = "glibc-2.17",
)

# The two forms of a library's shared library (shared.bzl, `shared_names` and
# `macho_link_args`): each fails at analysis unless the names, and on darwin
# the ld64 arguments of the link, are exactly these. darwin with an owner and
# a C++ archive: the install name @rpath/<file>, the exported symbols list,
# each archive force-loaded, the system libc++, the owner and the one run path
# @loader_path; without them, neither -lc++ nor a run path; linux: the names
# the ELF link has always had.
shared_form_test(
    name = "shared_form_darwin",
    archives = ["liba.a", "libb.a"],
    cxx_runtime = True,
    expect_link_args = [
        "-arch",
        "arm64",
        "-mmacosx-version-min=11.0",
        "-dynamiclib",
        "-o",
        "out.dylib",
        "-Wl,-install_name,@rpath/libkomira_t_native.1.dylib",
        "-Wl,-exported_symbols_list,exported_symbols.txt",
        "-Wl,-dead_strip",
        "-Wl,-undefined,error",
        "-Wl,-S",
        "-Wl,-force_load,liba.a",
        "-Wl,-force_load,libb.a",
        "-lc++",
        "libkomira_o_native.1.dylib",
        "-Wl,-rpath,@loader_path",
    ],
    expect_names = {
        "file": "libkomira_t_native.1.dylib",
        "format": "macho",
        "link": "libkomira_t_native.dylib",
        "name": "@rpath/libkomira_t_native.1.dylib",
        "script": "exported_symbols.txt",
        "script_sub": "exported_symbols_list",
    },
    library = "t",
    os = "darwin",
    owners = ["libkomira_o_native.1.dylib"],
)

shared_form_test(
    name = "shared_form_darwin_alone",
    archives = ["liba.a"],
    expect_link_args = [
        "-arch",
        "arm64",
        "-mmacosx-version-min=11.0",
        "-dynamiclib",
        "-o",
        "out.dylib",
        "-Wl,-install_name,@rpath/libkomira_t_native.1.dylib",
        "-Wl,-exported_symbols_list,exported_symbols.txt",
        "-Wl,-dead_strip",
        "-Wl,-undefined,error",
        "-Wl,-S",
        "-Wl,-force_load,liba.a",
    ],
    expect_names = {
        "file": "libkomira_t_native.1.dylib",
        "format": "macho",
        "link": "libkomira_t_native.dylib",
        "name": "@rpath/libkomira_t_native.1.dylib",
        "script": "exported_symbols.txt",
        "script_sub": "exported_symbols_list",
    },
    library = "t",
    os = "darwin",
)

shared_form_test(
    name = "shared_form_linux",
    expect_names = {
        "file": "libkomira_t_native.so.1",
        "format": "elf",
        "link": "libkomira_t_native.so",
        "name": "libkomira_t_native.so.1",
        "script": "libkomira_t_native.so.1.map",
        "script_sub": "version_script",
    },
    library = "t",
    os = "linux",
)
