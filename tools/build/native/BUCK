# Symbol prefixing of the vendored C libraries (README.md): the symbol reader
# and the tool of the rules in defs.bzl.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "c_exe")

# elfsyms: an archive's symbol table and its members' symbols (elfsyms.c).
c_exe(
    name = "elfsyms",
    exec_compatible_with = LINUX_X86_64,
    src = "elfsyms.c",
    visibility = ["PUBLIC"],
)

_SRCS = glob(["src/*.zig"])

# The unit tests of prefix_tool: `zig test` of main.zig, whose test block
# imports prefix_test.zig and cli_test.zig, run as a build action.
zig_test(
    name = "prefix_tool_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _SRCS,
    src = "src/main.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# prefix_tool (Zig): `header` writes a prefix_header's header, `check` is a
# prefixed_archive_check. Built behind its unit tests: no header or check
# runs unless they pass.
zig_exe(
    name = "prefix_tool",
    exec_compatible_with = LINUX_X86_64,
    imports = _SRCS,
    src = "src/main.zig",
    unit_tests = [":prefix_tool_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)
