# The generated program, byte for byte, and its line map.

from std.testing import assert_equal, assert_false, assert_true
from readme_examples.examples import extract_examples
from readme_examples.program import generate_program, map_report, program_name, readme_line_of

comptime _README = """# P

<!-- mojo-hidden from std.testing import assert_equal -->
```mojo
from pkg import f

@fieldwise_init
struct P(Copyable):
    var x: Int

var p = P(1)
assert_equal(f(p.x), 2)
```

```mojo
from pkg import f
comptime S = \"\"\"a
  b\"\"\"
print(S)
```
"""

# Imports hoisted and deduplicated, declarations hoisted (a decorator runs
# into the declaration it decorates), the rest wrapped per example, a
# triple-quoted string copied untouched, a README-line tail on every copied
# line that ends outside a string, and main's verdict line in kci's
# read-back form.
comptime _GOLDEN = """# Generated by //tools/build/readme_examples from R.md. Do not edit:
# each line copied from the README ends with the README line it came from.

from std.testing import assert_equal  # README.md:3
from pkg import f  # README.md:5


@fieldwise_init  # README.md:7
struct P(Copyable):  # README.md:8
    var x: Int  # README.md:9

comptime S = \"\"\"a
  b\"\"\"  # README.md:18


def _example_4() raises:
    var p = P(1)  # README.md:11
    assert_equal(f(p.x), 2)  # README.md:12


def _example_15() raises:
    print(S)  # README.md:19


def main() raises:
    var failed = 0
    try:
        _example_4()
    except e:
        failed += 1
        print("R.md:4: FAILED: " + String(e))
    try:
        _example_15()
    except e:
        failed += 1
        print("R.md:15: FAILED: " + String(e))
    print("readme_pkg validation: " + String(2 - failed) + " of 2 checks passed")
    if failed > 0:
        raise Error(String(failed) + " of 2 README examples failed")
"""


def _program() raises -> String:
    return generate_program(extract_examples(_README, "R.md", False), "pkg", "R.md")


def test_golden() raises:
    assert_equal(_program(), _GOLDEN)


def test_a_statement_only_example_and_an_empty_one() raises:
    var p = generate_program(extract_examples("```mojo\n```\n\n```mojo\ndef g():\n    pass\n```\n", "R.md", False), "q", "R.md")
    # Neither has a statement: each body is `pass`.
    assert_true(p.find("def _example_1() raises:\n    pass\n") >= 0, p)
    assert_true(p.find("def _example_4() raises:\n    pass\n") >= 0, p)
    assert_true(p.find("\ndef g():  # README.md:5\n    pass  # README.md:6\n") >= 0, p)


# A statement over several lines is hoisted whole and compared whole. Lines
# 2-5 and 10-13 are the same statement: the second copy is dropped. Lines
# 14-17 open the same way, have as many lines and import other names: they
# are kept. Every line is tagged (a comment inside the parentheses is legal)
# except line 18, which ends with a backslash, runs on to line 19, and stays
# untagged (a comment there would end the line).
comptime _MULTILINE = """```mojo
from pkg import (
    f,
    g,
)
print(f(g(1)))
```

```mojo
from pkg import (
    f,
    g,
)
from pkg import (
    h,
    k,
)
from pkg import m, \\
    n
print(h(k(m(n))))
```
"""

comptime _MULTILINE_HEAD = """# Generated by //tools/build/readme_examples from R.md. Do not edit:
# each line copied from the README ends with the README line it came from.

from pkg import (  # README.md:2
    f,  # README.md:3
    g,  # README.md:4
)  # README.md:5
from pkg import (  # README.md:14
    h,  # README.md:15
    k,  # README.md:16
)  # README.md:17
from pkg import m, \\
    n  # README.md:19


def _example_1() raises:
    print(f(g(1)))  # README.md:6


def _example_9() raises:
    print(h(k(m(n))))  # README.md:20


def main() raises:
"""


def test_a_multiline_import_is_hoisted_whole() raises:
    var p = generate_program(extract_examples(_MULTILINE, "R.md", False), "pkg", "R.md")
    assert_true(p.startswith(_MULTILINE_HEAD), p)


def test_an_example_ending_inside_an_import_is_refused() raises:
    var raised = False
    try:
        _ = generate_program(extract_examples("```mojo\nfrom pkg import (\n    f,\n```\n", "R.md", False), "q", "R.md")
    except e:
        raised = True
        assert_equal(String(e), "R.md:1: the example ends inside an import statement")
    assert_true(raised)


def test_zero_examples_generate_nothing() raises:
    var raised = False
    try:
        _ = generate_program(extract_examples("# none\n", "R.md", False), "q", "R.md")
    except e:
        raised = True
        assert_equal(String(e), "R.md: holds no ```mojo example; there is nothing to run")
    assert_true(raised)


def test_an_example_ending_inside_a_string_is_refused() raises:
    var raised = False
    try:
        _ = generate_program(extract_examples('```mojo\nvar s = """x\n```\n', "R.md", False), "q", "R.md")
    except e:
        raised = True
        assert_equal(String(e), "R.md:1: the example ends inside a triple-quoted string")
    assert_true(raised)


def test_the_program_is_never_named_like_the_package() raises:
    assert_equal(program_name("komira_x"), "readme_komira_x.mojo")


def test_line_map() raises:
    var p = _program()
    # Program line 4 is the first import (README line 3); line 1 is generated.
    assert_equal(readme_line_of(p, 4), 3)
    assert_equal(readme_line_of(p, 1), 0)
    assert_equal(readme_line_of(p, 18), 12)
    var report = String(
        "/w/out/readme_pkg.mojo:18:5: error: no f\n"
        + "    assert_equal(f(p.x), 2)  # README.md:12\n"
        + "at readme_pkg.mojo:31 (generated)\n"
        + "other.mojo:21: untouched\n"
    )
    assert_equal(
        map_report(report, p, "pkg", "src/pkg/README.md"),
        "src/pkg/README.md:12:5: error: no f\n"
        + "    assert_equal(f(p.x), 2)  # README.md:12\n"
        + "at readme_pkg.mojo:31 (generated)\n"
        + "other.mojo:21: untouched\n",
    )


def main() raises:
    test_golden()
    test_a_statement_only_example_and_an_empty_one()
    test_a_multiline_import_is_hoisted_whole()
    test_an_example_ending_inside_an_import_is_refused()
    test_zero_examples_generate_nothing()
    test_an_example_ending_inside_a_string_is_refused()
    test_the_program_is_never_named_like_the_package()
    test_line_map()
    print("test_program: OK")
