# The generated programs, byte for byte: one per example, in the mode its
# fence names, every copied line on its README line; the runner; the line map.

from std.testing import assert_equal, assert_false, assert_true
from readme_examples.examples import extract_examples
from readme_examples.program import (
    example_name,
    example_program,
    generate_programs,
    map_report,
    program_name,
    runner_program,
)

comptime _README = """# P

<!-- mojo-hidden from std.testing import assert_equal -->
```mojo
from pkg import f

def g(x: Int) -> Int:
    return f(x)

assert_equal(g(1), 2)
```

```mojo module
from pkg import f


@fieldwise_init
struct P(Copyable):
    var x: Int


def main():
    print(f(P(1).x))
```
<!-- mojo-hidden
comptime S = \"\"\"a
  b\"\"\"
-->
"""

# A ```mojo example: `def main() raises:` on the line before its first
# copied line (the hidden import, README line 3), then every line pasted as
# it is and indented, on its README line. The import stays where it is
# (inside main), and the nested `def g` is not hoisted.
comptime _GOLDEN_4 = """# Generated by //tools/build/readme_examples from R.md, the example at line 4. Do not edit: line n is README line n.
def main() raises:
    from std.testing import assert_equal

    from pkg import f

    def g(x: Int) -> Int:
        return f(x)

    assert_equal(g(1), 2)
"""

# A ```mojo module example: copied as it is, hidden lines after it included
# (a triple-quoted string untouched), on its README lines; no main is added.
comptime _GOLDEN_13 = """# Generated by //tools/build/readme_examples from R.md, the example at line 13. Do not edit: line n is README line n.












from pkg import f


@fieldwise_init
struct P(Copyable):
    var x: Int


def main():
    print(f(P(1).x))


comptime S = \"\"\"a
  b\"\"\"
"""

comptime _RUNNER = """# Generated by //tools/build/readme_examples from R.md. Do not edit: it runs each example's program, beside it.

import readme_pkg_4
import readme_pkg_13


def main() raises:
    var failed = 0
    try:
        readme_pkg_4.main()
    except e:
        failed += 1
        print("R.md:4: FAILED: " + String(e))
    try:
        readme_pkg_13.main()
    except e:
        failed += 1
        print("R.md:13: FAILED: " + String(e))
    print("readme_pkg validation: " + String(2 - failed) + " of 2 checks passed")
    if failed > 0:
        raise Error(String(failed) + " of 2 README examples failed")
"""


def _programs(text: String, package: String = "pkg") raises -> List[String]:
    """The text of every program generate_programs makes, runner last."""
    var ps = generate_programs(extract_examples(text, "R.md", False), package, "R.md")
    var out = List[String]()
    for i in range(len(ps)):
        out.append(ps[i].text)
    return out^


def test_golden() raises:
    var ps = generate_programs(extract_examples(_README, "R.md", False), "pkg", "R.md")
    assert_equal(len(ps), 3)
    assert_equal(ps[0].name, "readme_pkg_4.mojo")
    assert_equal(ps[0].text, _GOLDEN_4)
    assert_equal(ps[1].name, "readme_pkg_13.mojo")
    assert_equal(ps[1].text, _GOLDEN_13)
    assert_equal(ps[2].name, "readme_pkg.mojo")
    assert_equal(ps[2].text, _RUNNER)


def test_every_copied_line_is_on_its_readme_line() raises:
    # Line n of each program is README line n, with the indent its mode adds
    # (an indented fence's own indent removed first).
    var text = String(_README) + "\n- item\n\n  ```mojo\n  if True:\n      print(1)\n  ```\n"
    var readme = text.split("\n")
    var exs = extract_examples(text, "R.md", False)
    assert_equal(len(exs), 3)
    for e in range(len(exs)):
        var prog = example_program(exs[e], "R.md").split("\n")
        for k in range(len(exs[e].code)):
            var n = exs[e].code_lines[k]
            var want = exs[e].code[k] if exs[e].module or exs[e].code[k].byte_length() == 0 else "    " + exs[e].code[k]
            assert_equal(String(prog[n - 1]), want, "README line " + String(n))
    # README line 34 is `      print(1)` (fence indent 2): line 34 of its
    # program is the line dedented by 2, then indented by 4.
    assert_equal(String(readme[33]), "      print(1)")
    assert_equal(String(example_program(exs[2], "R.md").split("\n")[33]), "        print(1)")


def test_each_example_is_its_own_program() raises:
    # Two examples importing the same name and declaring the same names:
    # each program holds its own import (nothing is deduplicated across
    # examples) and nothing of the other example.
    var t = "```mojo\nfrom pkg import f\nvar x = f(1)\n```\n\n```mojo\nfrom pkg import f\nvar x = f(2)\n```\n"
    var ps = generate_programs(extract_examples(t, "R.md", False), "q", "R.md")
    assert_equal(len(ps), 3)
    assert_equal(ps[0].name, "readme_q_1.mojo")
    assert_equal(ps[1].name, "readme_q_6.mojo")
    assert_equal(ps[0].text, "def main() raises:\n    from pkg import f\n    var x = f(1)\n")
    assert_equal(
        ps[1].text,
        "# Generated by //tools/build/readme_examples from R.md, the example at line 6. Do not edit: line n is README line n.\n"
        + "\n\n\n\ndef main() raises:\n    from pkg import f\n    var x = f(2)\n",
    )


def test_the_mode_is_the_fence_tag_alone() raises:
    # A struct in a ```mojo example is pasted into main like any line (its
    # compile then fails); a ```mojo module example that declares nothing
    # but main gets no second main.
    var ps = _programs("```mojo\nstruct T:\n    pass\nprint(1)\n```\n\n```mojo module\ndef main():\n    print(2)\n```\n")
    assert_equal(ps[0], "def main() raises:\n    struct T:\n        pass\n    print(1)\n")
    assert_true(ps[1].endswith("\n\n\n\n\n\ndef main():\n    print(2)\n"), ps[1])
    assert_equal(len(ps[1].split("def main")), 2, ps[1])


def test_a_block_with_no_code_gets_pass() raises:
    assert_equal(_programs("```mojo\n```\n")[0], "def main() raises:\n    pass\n")
    assert_equal(_programs("```mojo\n# a comment\n\n```\n")[0], "def main() raises:\n    # a comment\n\n    pass\n")
    assert_equal(_programs("```mojo\nprint(1)  # not only a comment\n```\n")[0], "def main() raises:\n    print(1)  # not only a comment\n")


def test_a_first_line_on_readme_line_1_is_refused() raises:
    var raised = False
    try:
        _ = _programs("<!-- mojo-hidden var x = 1 -->\n```mojo\nprint(x)\n```\n")
    except e:
        raised = True
        assert_equal(String(e), "R.md:2: the example's first line is README line 1, which leaves no line for its `def main`")
    assert_true(raised)
    # A module example has no main to place: it may start on line 1.
    assert_equal(_programs("<!-- mojo-hidden var x = 1 -->\n```mojo module\n```\n")[0], "var x = 1\n")


def test_no_example_is_a_runner_that_runs_nothing() raises:
    var ps = generate_programs(extract_examples("# none\n", "R.md", False), "q", "R.md")
    assert_equal(len(ps), 1)
    assert_equal(ps[0].name, "readme_q.mojo")
    assert_equal(
        ps[0].text,
        "# Generated by //tools/build/readme_examples from R.md. Do not edit: it runs each example's program, beside it.\n"
        + "\n\ndef main():\n    print(\"NO EXAMPLE: R.md holds no ```mojo example\")\n",
    )


def test_the_programs_are_never_named_like_the_package() raises:
    assert_equal(program_name("komira_x"), "readme_komira_x.mojo")
    assert_equal(example_name("komira_x", 12), "readme_komira_x_12.mojo")


def test_line_map() raises:
    var report = String(
        "/w/out/readme_pkg_4.mojo:10:5: error: no f\n"
        + "At readme_pkg_13.mojo:23:11: x\n"
        + "at readme_pkg.mojo:9 (the runner)\n"
        + "other_readme_pkg_4.mojo:3: untouched\n"
        + "readme_pkg_4.main() and readme_pkg_4.mojo: too\n"
    )
    assert_equal(
        map_report(report, "pkg", "src/pkg/README.md"),
        "src/pkg/README.md:10:5: error: no f\n"
        + "At src/pkg/README.md:23:11: x\n"
        + "at readme_pkg.mojo:9 (the runner)\n"
        + "other_readme_pkg_4.mojo:3: untouched\n"
        + "readme_pkg_4.main() and readme_pkg_4.mojo: too\n",
    )


def main() raises:
    test_golden()
    test_every_copied_line_is_on_its_readme_line()
    test_each_example_is_its_own_program()
    test_the_mode_is_the_fence_tag_alone()
    test_a_block_with_no_code_gets_pass()
    test_a_first_line_on_readme_line_1_is_refused()
    test_no_example_is_a_runner_that_runs_nothing()
    test_the_programs_are_never_named_like_the_package()
    test_line_map()
    print("test_program: OK")
