"""The programs that run a README's examples, and their line map. Pure: no I/O.

Each example is a program of its own, `readme_<package>_<line>.mojo`,
`<line>` being the README line of its opening fence: two examples never
share a module, so they may declare the same names and import the same
ones, and a failure names exactly one example. The fence tag is the mode,
and nothing is inferred from the code:

- ```mojo: the example's lines are pasted as they are, each indented four
  spaces, into `def main() raises:`. Mojo allows an import inside a
  function, so nothing is hoisted and no line is read as a statement. A
  `pass` follows when no line holds code (blank lines and comments only).
- ```mojo module: the example's lines are the whole program, copied as they
  are; it declares its own `main`.

Hidden lines (examples.mojo) are part of the example in either mode.

Every copied line sits on the line it has in the README: line n of the
program is line n of the README (the lines before and between are blank;
the first holds a comment naming the README, and in a ```mojo example the
line just before the first copied line holds `def main() raises:`). So a
compile error or an assertion's `readme_<package>_<line>.mojo:<n>` names
README line n, and `map_report` rewrites it to `<readme>:<n>`.

The runner, `readme_<package>.mojo`, imports each example's program as a
module beside it and calls its `main` inside `try`, in README order; a
failure prints `<readme>:<line>: FAILED: <error>` and the run continues.
Then it prints `readme_<package> validation: P of E checks passed` (one
check per example: the line kci's read-back parses) and raises if any
failed. With no example it prints that it ran nothing. The build runs each
example's program on its own (`[tests][readme]`); the runner is what a
single run of every example (a coverage build, an installed README's
validation) compiles.
"""

from .examples import Example
from .text import byte_at, is_blank, mojo_string_literal, strip, suffix

comptime GENERATED = "# Generated by //tools/build/readme_examples from "


def program_name(package: String) -> String:
    """`readme_<package>.mojo`, the runner. Never `<package>.mojo`: a file
    next to the program named like the package would be an import root
    shadowing it."""
    return "readme_" + package + ".mojo"


def example_module(package: String, line: Int) -> String:
    """`readme_<package>_<line>`: the module of the example whose opening
    fence is README line `line`."""
    return "readme_" + package + "_" + String(line)


def example_name(package: String, line: Int) -> String:
    """`readme_<package>_<line>.mojo`, the example's program."""
    return example_module(package, line) + ".mojo"


def _holds_code(lines: List[String]) -> Bool:
    for i in range(len(lines)):
        var t = strip(lines[i])
        if t.byte_length() > 0 and not t.startswith("#"):
            return True
    return False


def example_program(ex: Example, display: String) raises -> String:
    """The program of example `ex` of README `display` (file header): line n
    of it is line n of the README."""
    var where = display + ":" + String(ex.line)
    var first = ex.code_lines[0] if len(ex.code) > 0 else ex.line + 1
    # The line `def main() raises:` takes in a ```mojo example.
    var main_line = 0 if ex.module else first - 1
    if not ex.module and main_line < 1:
        raise Error(where + ": the example's first line is README line 1, which leaves no line for its `def main`")
    var out = List[String]()
    var header_room = (main_line if not ex.module else first) - 1
    if header_room >= 1:
        out.append(GENERATED + display + ", the example at line " + String(ex.line) + ". Do not edit: line n is README line n.")
    while len(out) < main_line - 1:
        out.append("")
    if not ex.module:
        out.append("def main() raises:")
    for k in range(len(ex.code)):
        var n = ex.code_lines[k]
        if n <= len(out):
            raise Error(where + ": README line " + String(n) + " is copied out of order")
        while len(out) < n - 1:
            out.append("")
        var line = ex.code[k]
        if ex.module or is_blank(line):
            out.append(line if not is_blank(line) else "")
        else:
            out.append("    " + line)
    if not ex.module and not _holds_code(ex.code):
        out.append("    pass")
    var text = String("")
    for i in range(len(out)):
        text += out[i] + "\n"
    return text^


@fieldwise_init
struct Program(Copyable, Movable):
    # The file name: example_name's, or program_name's for the runner.
    var name: String
    var text: String


def generate_programs(examples: List[Example], package: String, display: String) raises -> List[Program]:
    """Every program of package `package`'s README `display`: one per
    example, in README order, each made from that example alone, then the
    runner (file header)."""
    var out = List[Program]()
    for e in range(len(examples)):
        out.append(Program(example_name(package, examples[e].line), example_program(examples[e], display)))
    out.append(Program(program_name(package), runner_program(examples, package, display)))
    return out^


def runner_program(examples: List[Example], package: String, display: String) -> String:
    """The runner of the examples of package `package`'s README, named
    `display` in its messages (file header)."""
    var out = GENERATED + display + ". Do not edit: it runs each example's program, beside it.\n"
    if len(examples) == 0:
        out += "\n\ndef main():\n"
        out += "    print(" + mojo_string_literal("NO EXAMPLE: " + display + " holds no ```mojo example") + ")\n"
        return out^
    out += "\n"
    for e in range(len(examples)):
        out += "import " + example_module(package, examples[e].line) + "\n"
    out += "\n\ndef main() raises:\n    var failed = 0\n"
    for e in range(len(examples)):
        var ln = examples[e].line
        out += "    try:\n        " + example_module(package, ln) + ".main()\n    except e:\n        failed += 1\n"
        out += "        print(" + mojo_string_literal(display + ":" + String(ln) + ": FAILED: ") + " + String(e))\n"
    var total = String(len(examples))
    out += "    print(" + mojo_string_literal("readme_" + package + " validation: ") + " + String(" + total + " - failed) + "
    out += mojo_string_literal(" of " + total + " checks passed") + ")\n"
    out += "    if failed > 0:\n"
    out += "        raise Error(String(failed) + " + mojo_string_literal(" of " + total + " README examples failed") + ")\n"
    return out^


def map_report(report: String, package: String, display: String) -> String:
    """`report` with every `[<dir>/]readme_<package>_<line>.mojo:<n>` (an
    example's program) rewritten to `<display>:<n>`: the program's line n is
    README line n. The runner's own lines are left as they are."""
    var stem = "readme_" + package + "_"
    var out = String()
    var n = report.byte_length()
    var i = 0
    var start = 0
    while i < n:
        var at = report.find(stem, i)
        if at < 0:
            break
        var j = at + stem.byte_length()
        var k = j
        while k < n and byte_at(report, k) >= 48 and byte_at(report, k) <= 57:
            k += 1
        var ext = ".mojo:"
        if k == j or not suffix(report, k).startswith(ext):
            i = j
            continue
        var d = k + ext.byte_length()
        var e = d
        while e < n and byte_at(report, e) >= 48 and byte_at(report, e) <= 57:
            e += 1
        if e == d:
            i = j
            continue
        # The whole path token: back to whitespace, a quote, a bracket or the line start.
        var p = at
        while p > 0:
            var c = byte_at(report, p - 1)
            if c == 32 or c == 9 or c == 10 or c == 34 or c == 39 or c == 40:
                break
            p -= 1
        # `readme_<package>_` must start the file name, not end another one.
        if at > p and byte_at(report, at - 1) != 47:
            i = j
            continue
        out += String(report[byte=start:p]) + display + ":" + String(report[byte=d:e])
        start = e
        i = e
    out += suffix(report, start)
    return out^
