load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")

# A README's ```mojo examples as a program that runs them (README.md of
# tools/build/mojo, "README examples"). The library is pure (text in, text
# out): the CommonMark fence and link reader that buildtools.doc_links also
# reads code through, the examples with their refusals, and the generated
# program with its line map. Its unit tests are welded.
#
# This package has no README.md and must not get one: every mojo_library
# whose package holds a README runs `:tool` on it, so a README here would
# make the tool depend on itself.
mojo_library(
    name = "readme_examples",
    srcs = [
        "readme_examples/__init__.mojo",
        "readme_examples/examples.mojo",
        "readme_examples/markdown.mojo",
        "readme_examples/program.mojo",
        "readme_examples/text.mojo",
    ],
    test_srcs = [
        "tests/test_examples.mojo",
        "tests/test_markdown.mojo",
        "tests/test_program.mojo",
    ],
    visibility = ["PUBLIC"],
)

# `generate` and `map` (main.mojo). mojo_library runs it as an action.
mojo_binary(
    name = "tool",
    srcs = ["main.mojo"],
    deps = [":readme_examples"],
    visibility = ["PUBLIC"],
)
