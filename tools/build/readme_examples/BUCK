load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "TOOL_EXEC")
load("@komira//tools/build/platforms:table.bzl", "row")

# Built with zig 0.15.2 (`:zig_next`); the executables are built behind the check
# that the pin is that release.
_ZIG = "komira//tools/build/toolchains:zig_next"
_ZIG_VERSION = "komira//tools/build/toolchains:zig_next_version"

# The README examples tool (README.md of tools/build/mojo, "README
# examples"): `generate` makes a README's ```mojo examples into programs, one
# per example, `readme_<import name>_<line>.mojo`, line n of each being README
# line n, plus the runner of them all; `map` rewrites a report's program
# lines to README lines; `link` reads a packaged README's `sh komira-link`
# block (the link commands the packer writes) and `link-check` compares it
# with what the packer wrote (cli.zig, link.zig); `release-check` refuses a
# release member that packages no README or one with no example
# (tools/build/package/release_set.bzl). mojo_library runs it on its package's
# README.md as an action, and so do the coverage build and the README API
# census; kci ships it beside its executable and runs it on an installed
# README (src/kci_validate). Zig, as every build tool under tools/build is;
# what is code, a fence and a link is the shared Markdown reader's
# (//tools/build/markdown:markdown).

_SRCS = glob(["*.zig"])

# The unit tests (examples_test.zig, program_test.zig, cli_test.zig): `zig
# test` of main.zig, run as a build action.
zig_test(
    name = "readme_examples_unit",
    exec_compatible_with = TOOL_EXEC,
    imports = _SRCS,
    src = "main.zig",
    deps = ["//tools/build/markdown:markdown"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
)

# Welded: no README is made into programs unless `:readme_examples_unit`
# passed.
#
# Built for the platform it is configured for. Its users take it as an
# exec_dep (mojo_library's `generate` action, conda, the census), so its
# configuration is that of the execution platform their action runs on: on a
# darwin-arm64 Mojo target that is the macOS one, whose workers cannot run a
# Linux executable. zig cross-compiles it on the linux execution platform
# either way. On linux the triple is the one it always had, so linux action
# keys are unchanged. mojo_library refuses at analysis a tool built for
# another os than its action (tools/build/mojo/readme.bzl, ZigExeInfo).
zig_exe(
    name = "tool",
    exec_compatible_with = TOOL_EXEC,
    imports = _SRCS,
    src = "main.zig",
    target = select({
        "prelude//os/constraints:macos": row("darwin-arm64")["zig_triple"],
        "DEFAULT": "x86_64-linux-musl",
    }),
    deps = ["//tools/build/markdown:markdown"],
    unit_tests = [":readme_examples_unit", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# What is left in Mojo: the Markdown reader `buildtools.doc_links`
# (tools/build/inspect) imports, `markdown` and `text`, with their welded
# unit tests. The README examples are the Zig tool's alone; kci ships the
# tool (bin/kci/BUCK `helpers`) and runs it on an installed README. This
# library is deleted by the doc_links port of komira-ai/komira#1281, which
# moves doc_links onto //tools/build/markdown.
mojo_library(
    name = "readme_examples",
    srcs = [
        "readme_examples/__init__.mojo",
        "readme_examples/markdown.mojo",
        "readme_examples/text.mojo",
    ],
    test_srcs = ["tests/test_markdown.mojo"],
    visibility = ["//tools/build/inspect:", "//tools/build/tests/..."],
)
