# The parity cases of //tools/build/ci:affected and :derive_checks
# (runner.zig's header says what a case is). Each case is one build action:
# the tool runs in a tree of the case's making, replay.zig answers every buck2
# and git call from the case's transcript, and the target exists only when the
# tool printed the golden stdout and stderr, exited with the golden code and
# asked exactly the recorded questions. The goldens are the Mojo tools'
# answers: each case green against them is that proof. A change of the tools'
# behavior shows up here as a golden diff.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "ci_parity_case")

# ---- The harness, behind its unit tests --------------------------------------

zig_test(
    name = "runner_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "runner_test.zig",
    imports = [
        "format.zig",
        "runner.zig",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "runner",
    exec_compatible_with = LINUX_X86_64,
    src = "runner.zig",
    imports = ["format.zig"],
    unit_tests = [":runner_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "replay",
    exec_compatible_with = LINUX_X86_64,
    src = "replay.zig",
    imports = ["format.zig"],
    unit_tests = [":runner_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# ---- The cases: cases/<tool>_<name> ------------------------------------------

_AFFECTED = [
    "affected",
    "affected_targets",
    "base_diff_fails",
    "base_only",
    "broken_mapping_chain",
    "broken_mapping_node",
    "broken_rdeps_chain",
    "broken_rdeps_node",
    "broken_universe_chain",
    "broken_universe_node",
    "buck2_killed",
    "buck2_missing",
    "bzl_audit_short",
    "bzl_loaded",
    "bzl_prelude_skipped",
    "bzl_unloaded",
    "coverage_covered",
    "coverage_uncovered",
    "crlf",
    "deleted_bad_base",
    "deleted_found",
    "deleted_no_base",
    "deleted_none",
    "deleted_none_inert",
    "deleted_package_gone",
    "empty",
    "files_missing",
    "help",
    "invalid_utf8",
    "isolation_order",
    "json",
    "json_broken_escape",
    "json_vacuous_control",
    "kept_stderr_8192",
    "kept_stderr_8193",
    "kept_stderr_utf8_cut",
    "owner_no_answer",
    "units_bad_line",
    "unsafe_path",
    "usage_coverage_no_units",
    "usage_json_units",
    "usage_missing_value",
    "usage_none",
    "usage_unknown",
    "vacuous",
    "vacuous_units",
    "widened_rdeps_empty",
    "widened_rule",
    "widened_rule_targets",
]

_DERIVE_CHECKS = [
    "basic",
    "broken_chain",
    "broken_whitespace",
    "buck2_killed",
    "buck2_missing",
    "empty_universe",
    "from_textproto",
    "names",
    "ordering",
    "package_collision",
    "strip",
    "strip_nel",
    "strip_unicode_space",
    "strip_unit_separator",
    "units_bad_line",
    "units_missing",
    "unmatched",
    "usage",
]

[
    ci_parity_case(
        name = tool + "_" + case,
        exec_compatible_with = LINUX_X86_64,
        case = "cases/" + tool + "_" + case,
        common = "common",
        replay = ":replay",
        runner = ":runner",
        subject = "//tools/build/ci:" + tool + "[runnable]",
    )
    for tool, cases in [
        ("affected", _AFFECTED),
        ("derive_checks", _DERIVE_CHECKS),
    ]
    for case in cases
]
