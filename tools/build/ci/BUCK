)

# darwin_targets: writes the targets of the macOS part of the pull request's check (pr.yml, step
# `the macOS targets to build`) from the log of darwin.bxl:select, and sets the step's output `any`
# when there is one (darwin_targets/darwin_targets.zig says what it reads and refuses). The pull
# request's check builds it on the farm and runs it on the runner. Its cases are recorded runs of
# darwin.bxl:select (darwin_targets/fixtures); welded: the tool is built only when they pass.
_DARWIN_TARGETS_FIXTURES = [
    "darwin_targets/fixtures/select_broken.log",
    "darwin_targets/fixtures/select_none.log",
    "darwin_targets/fixtures/select_some.log",
    "darwin_targets/fixtures/select_whole.log",
]

zig_test(
    name = "darwin_targets_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "darwin_targets/darwin_targets_test.zig",
    imports = ["darwin_targets/darwin_targets.zig"] + _DARWIN_TARGETS_FIXTURES,
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

