    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["//:buck2_farm_cases"],
)

# release_beta_version: gives every member of a mopm workspace one version
# (0.1.<run number>) and the exact pins between members with it, so each push
# to main publishes to the beta and prod registries under a version they have not seen
# (release_beta_version.zig says what it edits and refuses). release.yml's
# `mopm-stage` job builds it and runs it, before the stage. (The name is from the
# time the per-push publish went to a beta registry; the target is kept so its
# label and action keys do not move.)
# Its cases run on scratch workspaces; welded: the tool is built only when they pass.
zig_test(
    name = "release_beta_version_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_version/release_beta_version_test.zig",
    imports = ["release_beta_version/release_beta_version.zig"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "release_beta_version",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_version/release_beta_version.zig",
    unit_tests = [":release_beta_version_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# release_beta_fetch: the plan reader and the registry client that release_staged_verify
# (below) imports (release_beta_fetch.zig says what it reads, asks and refuses). It is no
# longer built as a binary of its own: no job of release.yml runs it. Its cases run
# against a registry in memory and a socket on loopback.
zig_test(
    name = "release_beta_fetch_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/release_beta_fetch_test.zig",
    imports = ["release_beta_fetch/release_beta_fetch.zig"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

# The same plan reader and client as a module, for //python/smoke:pypi_smoke_lib (its `Fetcher`,
# `Got` and `Http`: https only, no redirect, a body bounded by the caller). Imported only once
# release_beta_fetch_unit passed.
zig_module(
    name = "release_beta_fetch",
    src = "release_beta_fetch/release_beta_fetch.zig",
    unit_tests = [":release_beta_fetch_unit"],
    visibility = ["//python/smoke:"],
)

# release_staged_verify: the five checks of the release that write nothing to a registry
# (release_staged_verify.zig says what each reads and refuses). release.yml's `mopm-stage` runs
# `expect` (plan_expect.zig) on the plan `mopm stage` wrote, before anything is staged in beta or prod;
# `beta-test` and `prod-test` run `verify` on the staged set `beta-stage` and `prod-stage` uploaded, before
# anything is committed, and
# writes the directory the README e2e runs on; `prod-smoke` runs `smoke` against the prod channel
# once the group is visible; `prod-add` then runs `add` (prod_add.zig): a user's `mopm add` and
# `mopm sync` from prod with the pinned mopm, checked against the plan; `beta-served-readmes` and
# `prod-served-readmes` run `served` (served.zig) after each commit: the files and READMEs that registry
# serves, checked against the plan and written for the README e2e. It reads the plan and the
# client of release_beta_fetch.zig, which sits beside it. Its cases run on scratch directories, a
# registry in memory and a mopm in memory; welded: the tool is built only when they, served_unit and
# prod_add_set_cases (below) pass.
zig_test(
    name = "release_staged_verify_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/release_staged_verify_test.zig",
    imports = [
        "release_beta_fetch/release_staged_verify.zig",
        "release_beta_fetch/release_beta_fetch.zig",
        "release_beta_fetch/prod_add.zig",
        "release_beta_fetch/plan_expect.zig",
        "release_beta_fetch/served.zig",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

# `release_staged_verify served` (served.zig): what a registry serves after its commit, every file from its
# channel and every README from its API at the plan's version, held to the plan (served_test.zig lists its
# cases). Its cases run on scratch directories and a registry in memory.
zig_test(
    name = "served_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/served_test.zig",
    imports = [
        "release_beta_fetch/served.zig",
        "release_beta_fetch/release_beta_fetch.zig",
        "release_beta_fetch/prod_add.zig",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

# `release_staged_verify expect` (plan_expect.zig): the plan `mopm stage` wrote holds the set the release
# builds, //release:mopm_plan_expectation (every package of packages.bzl on linux-64, the macOS set on
# osx-arm64 too). release.yml's `mopm-stage` runs it right after `mopm stage`. Its cases run on plans
# written in the test and on scratch directories, and the last two on the release's own expectation (`data`).
zig_test(
    name = "plan_expect_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/plan_expect_test.zig",
    imports = [
        "release_beta_fetch/plan_expect.zig",
        "release_beta_fetch/release_beta_fetch.zig",
    ],
    data = {"mopm_plan_expectation.json": "//release:mopm_plan_expectation"},
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

# The names `release_staged_verify add` installs from prod (`add_set` of prod_add.zig) are held to the release's
# data (prod_add_set_test.zig lists its cases): every package that ships a native archive
