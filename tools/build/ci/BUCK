load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# The BXL selector of the pull request check (affected.bxl, affected.bzl) and the
# aggregate's generator and guards (targets.bxl, guard.bxl, python_guard.bxl) are
# scripts, not targets; cases.bxl holds their cases. The rows the selector widens
# and treats as inert on are data in rules.bzl (README.md).

# assert_remote: reads the output of one ./buck2 run and exits non-zero unless
# every action ran on the farm (assert_remote.zig says what buck2 prints and
# what is accepted). The CI action `buck2-farm` runs it over the run's log.
# Its cases are recorded buck2 output (assert_remote/fixtures); welded: the
# tool is built only when they pass.
zig_test(
    name = "assert_remote_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "assert_remote/assert_remote_test.zig",
    imports = [
        "assert_remote/assert_remote.zig",
        "assert_remote/fixtures/build_cached.log",
        "assert_remote/fixtures/build_failed_unknown_target.log",
        "assert_remote/fixtures/build_remote.log",
        "assert_remote/fixtures/bxl_cached.log",
        "assert_remote/fixtures/bxl_remote.log",
        "assert_remote/fixtures/test_cached_remote.log",
        "assert_remote/fixtures/test_none_ran.log",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "assert_remote",
    exec_compatible_with = LINUX_X86_64,
    src = "assert_remote/assert_remote.zig",
    unit_tests = [":assert_remote_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# The recorded buck2 output of assert_remote's cases, as a directory, for the
# cases of the CI action that runs it (//:buck2_farm_cases).
export_file(
    name = "assert_remote_fixtures",
    src = "assert_remote/fixtures",
    visibility = ["//:buck2_farm_cases"],
)

# What the cases of the buck2-farm action run as `./buck2`: it prints a
# recorded log and exits as told (assert_remote/stand_in_buck2.zig).
zig_exe(
    name = "stand_in_buck2",
    exec_compatible_with = LINUX_X86_64,
    src = "assert_remote/stand_in_buck2.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["//:buck2_farm_cases"],
)

# release_beta_version: gives every member of a mopm workspace one beta version
# (0.1.<run number>) and the exact pins between members with it, so each push
# to main publishes to the beta registry under a version it has not seen
# (release_beta_version.zig says what it edits and refuses). release.yml's
# `mopm-stage` job builds it; only `mopm-stage-beta` runs it, before the stage.
# Its cases run on scratch workspaces; welded: the tool is built only when they pass.
zig_test(
    name = "release_beta_version_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_version/release_beta_version_test.zig",
    imports = ["release_beta_version/release_beta_version.zig"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "release_beta_version",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_version/release_beta_version.zig",
    unit_tests = [":release_beta_version_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# release_beta_fetch: downloads the packages a registry published and checks each file's
# sha256 and size against the staged plan (release_beta_fetch.zig says what it reads, asks
# and refuses). release.yml's `mopm-e2e-beta` job runs it after `mopm-publish-beta`; it is
# built there, on the farm, and run on the runner, because it makes requests. Its cases run
# against a registry in memory and a socket on loopback; welded: the tool is built only when
# they pass.
zig_test(
    name = "release_beta_fetch_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/release_beta_fetch_test.zig",
    imports = ["release_beta_fetch/release_beta_fetch.zig"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "release_beta_fetch",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/release_beta_fetch.zig",
    unit_tests = [":release_beta_fetch_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# release_staged_verify: the two checks of the prod publish that write nothing to a registry
# (release_staged_verify.zig says what each reads and refuses). release.yml's `prod-test`
# job runs `verify` on the staged set `prod-stage` uploaded, before anything is committed, and
# writes the directory the README e2e runs on; `prod-smoke` runs `smoke` against the prod channel
# once the group is visible. It reads the plan and the client of release_beta_fetch.zig, which
# sits beside it. Its cases run on scratch directories and a registry in memory; welded: the
# tool is built only when they pass.
zig_test(
    name = "release_staged_verify_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/release_staged_verify_test.zig",
    imports = [
        "release_beta_fetch/release_staged_verify.zig",
        "release_beta_fetch/release_beta_fetch.zig",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "release_staged_verify",
    exec_compatible_with = LINUX_X86_64,
    src = "release_beta_fetch/release_staged_verify.zig",
    imports = ["release_beta_fetch/release_beta_fetch.zig"],
    unit_tests = [":release_staged_verify_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

