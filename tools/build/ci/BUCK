load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_module", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# The BXL selector of the pull request check (affected.bxl, which runs buildrules'
# rules/affected) and the generator of the aggregate's committed roots and its guards
# (targets.bxl, guard.bxl, python_guard.bxl) are scripts, not targets; cases.bxl holds their cases. The rows
# the selector widens and treats as inert on are data in rules.bzl (README.md).

# assert_remote: reads the output of one ./buck2 run and exits non-zero unless
# every action ran on the farm (assert_remote.zig says what buck2 prints and
# what is accepted). The CI action `buck2-farm` runs it over the run's log.
# `assert_remote run` is the action's first line: it runs the buck2 command,
# and when its only failures are the farm's, a cut connection to the farm, a
# request to the farm whose connection closed, or a job the farm failed to
# start because an input was unavailable on its host
# (assert_remote/farm_retry.zig says what counts as one), waits for the farm's
# port to answer, for a bounded time (assert_remote/farm_wait.zig), and runs it
# again, at most three runs in all. While a run runs, its watchdog
# (assert_remote/farm_watchdog.zig) ends one that hangs on a dead connection to
# the farm, and that run is run again the same way.
# Its cases are recorded buck2 output (assert_remote/fixtures); welded: the
# tool is built only when they pass.
zig_test(
    name = "assert_remote_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "assert_remote/assert_remote_test.zig",
    imports = [
        "assert_remote/assert_remote.zig",
        "assert_remote/farm_retry.zig",
        "assert_remote/farm_run.zig",
        "assert_remote/farm_wait.zig",
        "assert_remote/farm_watchdog.zig",
        "assert_remote/fixtures/build_cached.log",
        "assert_remote/fixtures/build_failed_unknown_target.log",
        "assert_remote/fixtures/build_remote.log",
        "assert_remote/fixtures/bxl_cached.log",
        "assert_remote/fixtures/bxl_remote.log",
        "assert_remote/fixtures/test_cached_remote.log",
        "assert_remote/fixtures/test_none_ran.log",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

# Which failed runs `assert_remote run` runs again (assert_remote/farm_retry_test.zig
# says what each case holds): recorded failed runs on the farm, a cut, a request
# to the farm whose connection closed, a job the farm failed to start and real
# failures, and logs made from them with a line added or changed; and the wait
# for the farm before a run again, on a clock of the case's own.
zig_test(
    name = "farm_retry_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "assert_remote/farm_retry_test.zig",
    imports = [
        "assert_remote/farm_retry.zig",
        "assert_remote/farm_run.zig",
        "assert_remote/farm_wait.zig",
        "assert_remote/farm_watchdog.zig",
        "assert_remote/fixtures/build_cut.log",
        "assert_remote/fixtures/build_cut_after_file_changes.log",
        "assert_remote/fixtures/build_cut_and_compile_error.log",
        "assert_remote/fixtures/build_download_cut.log",
        "assert_remote/fixtures/build_failed_unknown_target.log",
        "assert_remote/fixtures/build_input_unavailable.log",
        "assert_remote/fixtures/build_remote.log",
        "assert_remote/fixtures/test_cut.log",
        "assert_remote/fixtures/test_failed.log",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

# How the watchdog tells a dead connection to the farm from a slow build
# (assert_remote/farm_watchdog_test.zig says what each case holds): the
# judgement over the times the kernel reports, the kernel's answer read from
# bytes made in the case, the bound read from the farm config, and the real
# read of a loopback connection of the case's own.
zig_test(
    name = "farm_watchdog_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "assert_remote/farm_watchdog_test.zig",
    imports = [
        "assert_remote/farm_wait.zig",
        "assert_remote/farm_watchdog.zig",
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "assert_remote",
    exec_compatible_with = LINUX_X86_64,
    src = "assert_remote/assert_remote.zig",
    imports = ["assert_remote/farm_retry.zig", "assert_remote/farm_run.zig", "assert_remote/farm_wait.zig", "assert_remote/farm_watchdog.zig"],
    unit_tests = [":assert_remote_unit", ":farm_retry_unit", ":farm_watchdog_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# change: writes the change of the pull request's check (pr.yml, step `the change`), the files it
# touches and the coverage holds of both sides, against the base of its event: HEAD^1 of a pull
# request's merge commit, a merge group's base_sha (change/change.zig says what it runs and
# refuses). The pull request's check builds it on the farm and runs it on the runner, in the
# checkout. Its cases run the whole selection against a fake git in a scratch directory; welded:
# the tool is built only when they pass.
zig_test(
    name = "change_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "change/change_test.zig",
    imports = ["change/change.zig"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "change",
    exec_compatible_with = LINUX_X86_64,
    src = "change/change.zig",
    unit_tests = [":change_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# The cases of change's executable (change/change_cli_test.zig says what each catches): the built
# tool run with its flags, as pr.yml runs it, in a directory of each case's own with the stand-in
# git (change/stand_in_git.zig) alone on its PATH; each checks the exit code, stderr, the files
# written and the git commands asked. A build action.
zig_test(
    name = "change_cli_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "change/change_cli_test.zig",
    exec_tools = {
        "CHANGE": ":change",
        "STAND_IN_GIT": ":stand_in_git",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

# What change_cli_cases run as `git`: it records what it is asked and answers from the case's file
