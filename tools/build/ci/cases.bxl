# The cases of the BXL selector's use here and of the aggregate's guard.
#
#   ./buck2 bxl komira//tools/build/ci/cases.bxl:run
#
# Fails, listing every case that answered otherwise. The selector's mapping is
# buildrules' `rules/affected`, which holds its own table cases (every file
# shape, the coverage holds, the patterns, the heavy rows). Here:
#
#   real cases     the library over the real Buck2 graph of the fixture
#                  package (fixture/BUCK, fixture/agg/BUCK), run from this
#                  cell: the queries the selector asks (owner, targets in a
#                  build file, reverse dependencies, the loaders of a .bzl) and
#                  the guard green over a complete aggregate and red over one
#                  that leaves a check out.
#   shipped cases  rules.bzl as shipped and affected.bxl's configuration: the
#                  paths that must widen, the log and failure text.
#   the rest       the aggregate's committed roots and guards, the
#                  toolchains per platform, the macOS selection, the checks of
#                  the Python tests' suite (python/tests/families.bzl), the
#                  python macros' platform default (python_platform_cases.bzl),
#                  and the common-task examples' one root of the check set
#                  (tasks_cases.bzl, over python/docs/task_tree_fixture/).
#
# Each case names what it proves.

load("@prelude//cxx:cxx_toolchain_types.bzl", "CxxToolchainInfo")
load("@buildrules//rules/affected:defs.bzl", "AFFECTED", "VACUOUS", "WIDENED", "affected_answer", "affected_output", "is_inert", "make_graph", "select", "widen_reason", "without_left_out")
load("//python/tests:families_cases.bzl", "python_tests_cases")
load("//release:darwin_libs.bzl", "DARWIN_PACKAGES")
load(":darwin_cases.bzl", "darwin_answer_cases", "darwin_real_cases", "darwin_table_cases")
load(":heavy_cases.bzl", "heavy_cases")
load(":python_platform_cases.bzl", "python_platform_cases")
load(":tasks_cases.bzl", "task_tree_cases")
load(":rules.bzl", "EXCLUDED", "INERT", "WIDEN")
load(":affected.bxl", "CONFIG")
load(":ci_graph.bzl", "REGENERATE", "check_nodes", "closure", "findings", "python_findings", "python_nodes", "root_findings", "roots", "sdk_own_deps")
load(":roots.bzl", "labels_of", "root_files", "root_label", "root_path")

# ---- the table graph ---------------------------------------------------
#
#   src/a/a.mojo  -> owned by a:a        src/a/BUCK (package src/a: a:a, a:a_test)
#   src/b/b.mojo  -> owned by b:b        b:b depends on a:a; c:c depends on b:b
#   src/lib.bzl   -> loaded by src/a/BUCK and src/b/BUCK
#   docs/x.md     -> owned by docs:doc_tree
#   .hidden       -> owned by nothing
#   ci/BUCK, ci/roots/k/src/b:b -> the aggregate's package (ci:pr; a root's file is ci:root_files')

_FILES = {
    "src/a/a.mojo": True,
    "src/a/BUCK": True,
    "src/b/b.mojo": True,
    "src/b/BUCK": True,
    "src/lib.bzl": True,
    "docs/x.md": True,
    "docs/BUCK": True,
    "README.md": True,
    ".hidden": True,
    "ci/BUCK": True,
    "ci/roots/k/src/b:b": True,
    "orphan.bzl": True,
}
_OWNERS = {
    "src/a/a.mojo": ["k//src/a:a"],
    "src/b/b.mojo": ["k//src/b:b"],
    "docs/x.md": ["k//docs:doc_tree"],
    "ci/roots/k/src/b:b": ["k//ci:root_files"],
}
_PACKAGES = {
    "src/a": ["k//src/a:a", "k//src/a:a_test"],
    "src/b": ["k//src/b:b"],
    "docs": ["k//docs:doc_tree"],
    "ci": ["k//ci:pr", "k//ci:root_files"],
}
_INCLUDING = {
    "src/lib.bzl": ["k//src/a:a", "k//src/a:a_test", "k//src/b:b"],
}

# reverse edges: who depends on a target (the aggregate is not in the universe)
_DEPENDENTS = {
    "k//src/a:a": ["k//src/b:b", "k//src/a:a_test"],
    "k//src/b:b": ["k//src/c:c"],
}

def _reverse_closure(seeds):
    seen = {}
    todo = list(seeds)
    for _ in range(1000):
        if not todo:
            break
        t = todo.pop()
        if t in seen:
            continue
        seen[t] = True
        todo += _DEPENDENTS.get(t, [])
    return seen.keys()

def _table():
    return struct(
        exists = lambda p: p in _FILES,
        owners = lambda p: _OWNERS.get(p, []),
        package_targets = lambda d: _PACKAGES.get(d, []),
        including = lambda p: _INCLUDING.get(p, []),
        rdeps = _reverse_closure,
    )

# ---- the real graph: the fixture ----------------------------------------

_F = "komira//tools/build/ci/fixture"
_SCOPE = ["{}:{}".format(_F, n) for n in ["leaf_src", "lonely_src", "leaf", "mid", "top", "lonely"]]
_AGG = "{}/agg:agg_complete".format(_F)
_AGG_PKG = "tools/build/ci/fixture/agg"
_FIXTURE_RULES = struct(
    widen = [("tools/build/ci/fixture/widen*", "a fixture row")],
    inert = [],
)

def _real_case(g, name, changed, kind, targets = None):
    v = select(_FIXTURE_RULES, changed, g, _AGG_PKG)
    problems = []
    if v.kind != kind:
        problems.append("kind {} (reason: {}), wanted {}".format(v.kind, v.reason, kind))
    if targets != None:
        got = [t for t in v.targets if t.startswith(_F + ":")]
        want = ["{}:{}".format(_F, t) for t in targets]
        if got != want:
            problems.append("targets {}, wanted {}".format(got, want))
    return [] if not problems else ["real: {}: {}".format(name, "; ".join(problems))]

def _real_cases(ctx):
    out = []
    g = make_graph(ctx, _SCOPE, "komira//" + _AGG_PKG + ":")
    both = ["leaf", "leaf_src", "lonely", "lonely_src", "mid", "top"]
    dir = "tools/build/ci/fixture/"

    # the owner query, then the reverse dependencies within the scope
    out += _real_case(g, "a leaf file selects its owner and every dependent, not the unrelated check", [dir + "leaf.txt"], AFFECTED, ["leaf", "leaf_src", "mid", "top"])
    out += _real_case(g, "the other leaf selects only its own chain", [dir + "lonely.txt"], AFFECTED, ["lonely", "lonely_src"])
    out += _real_case(g, "a BUCK file selects its whole package", [dir + "BUCK"], AFFECTED, both)
    out += _real_case(g, "a file deleted from the package selects the package", [dir + "gone.txt"], AFFECTED, both)
    out += _real_case(g, "a bzl selects the packages that load it", ["tools/build/ci/aggregate.bzl"], AFFECTED, both)

    # a file no target owns widens; inert, it is vacuous
    out += _real_case(g, "a file no target owns widens", [dir + ".unowned"], WIDENED)
    out += _real_case(g, "a widen row widens", [dir + "widen_me"], WIDENED)
    out += _real_case(g, "the aggregate's package widens", [_AGG_PKG + "/BUCK"], WIDENED)
    v = select(struct(widen = [], inert = [dir + ".unowned"]), [dir + ".unowned"], g, _AGG_PKG)
    if v.kind != VACUOUS:
        out.append("real: an inert unowned file: kind {}, wanted {}".format(v.kind, VACUOUS))

    # what the aggregate leaves out (rules.bzl EXCLUDED) is never selected: a change to
    # lonely.txt reaches `lonely` and `lonely_src`; with a row naming `lonely` only the source stays
    v = select(_FIXTURE_RULES, [dir + "lonely.txt"], g, _AGG_PKG)
    row = [_F + ":lonely"]
    kept = without_left_out(ctx, v.targets, row)
    if _F + ":lonely" not in v.targets or kept != [t for t in v.targets if t != _F + ":lonely"] or _F + ":lonely_src" not in kept:
        out.append("real: an EXCLUDED row naming `lonely` must drop it from the selection and keep `lonely_src`: selected {}, kept {}".format(v.targets, kept))
    if without_left_out(ctx, v.targets, []) != v.targets:
        out.append("real: no EXCLUDED row must leave the selection as it is")
    if without_left_out(ctx, v.targets, [_F + ":"]) != []:
        out.append("real: a package pattern in EXCLUDED must drop every target of the package")

    # each shipped row names real targets, and the filter drops exactly those
    for pattern, _ in EXCLUDED:
        named = [str(t.label) for t in ctx.uquery().eval(pattern)]
        if not named:
            out.append("real: the EXCLUDED row '{}' names no target".format(pattern))
        elif without_left_out(ctx, named + ["komira//ci:pr"], [pattern]) != ["komira//ci:pr"]:
            out.append("real: the EXCLUDED row '{}' must drop all its targets and nothing else".format(pattern))

    # the aggregate's side: roots, closure, the guard
    nodes = check_nodes(ctx, _SCOPE, "komira//" + _AGG_PKG + ":")
    got_checks = sorted(nodes.keys())
    want_checks = sorted(["{}:{}".format(_F, n) for n in ["leaf", "mid", "top", "lonely"]])
    if got_checks != want_checks:
        out.append("real: the checks of the scope (sources are none): {}, wanted {}".format(got_checks, want_checks))
    got_roots = roots(nodes)
    want_roots = sorted(["{}:{}".format(_F, n) for n in ["top", "lonely"]])
    if got_roots != want_roots:
        out.append("real: roots of the checks: {}, wanted {}".format(got_roots, want_roots))
    complete = findings(got_checks, closure(ctx, _AGG), _AGG)
    if complete:
        out.append("real: guard over the complete aggregate failed: " + complete)
    missing_agg = "{}/agg:agg_missing".format(_F)
    text = findings(got_checks, closure(ctx, missing_agg), missing_agg)
    if "{}:lonely".format(_F) not in text or "1 check target(s)" not in text or "targets.bxl:generate" not in text:
        out.append("real: guard over an aggregate that leaves `lonely` out did not name it and the regeneration: '{}'".format(text))
    # The printed command must not be the bare `cp ... "$(generator)"/.`: an empty generator output
    # would make it copy `/` into ci/. It assigns the output, checks it is a directory other than /,
    # and deletes the committed files only after that.
    if REGENERATE not in text or not REGENERATE.startswith('out=$(./buck2 bxl komira//tools/build/ci/targets.bxl:generate) && [ -d "$out" ] && [ "$out" != / ] && git rm ') or '"$(./buck2' in text:
        out.append("real: the regeneration command in the guard message is not the fail-safe form: '{}'".format(text))
    return out

# ---- roots and the execution-platform registration -------------------------

def _fake(label, kind, deps = []):
    return struct(label = struct(raw_target = lambda: label), rule_type = kind, deps = lambda: [struct(label = struct(raw_target = lambda: d)) for d in deps])

def _roots_cases():
    """roots() ignores what an execution-platform registration depends on: the
    registration names a macOS platform only in a checkout whose `[komira_re]`
    names a macOS worker, and the list must not depend on that (the row of
    `platforms:darwin-arm64` was lost on regeneration)."""
    out = []
    reg = "komira//tools/build/platforms/defs.bzl:remote_execution_platforms"
    local = "komira//tools/build/platforms/defs.bzl:local_execution_platforms"
    plat = "prelude//platform.bzl:platform"
    wrap = "komira//tools/build/platforms/with_buildrules.bzl:execution_platforms_plus"
    for name, kind in [("remote", reg), ("local", local)]:
        named = {
            "k//p:darwin": _fake("k//p:darwin", plat),
            "k//p:linux": _fake("k//p:linux", plat),
            "k//p:reg": _fake("k//p:reg", kind, ["k//p:linux", "k//p:darwin"]),
            "k//p:wrap": _fake("k//p:wrap", wrap, ["k//p:reg"]),
        }
        got = roots(named)
        if got != ["k//p:darwin", "k//p:linux", "k//p:wrap"]:
            out.append("roots: a {} registration's platforms stay roots, its own dependent is not: got {}".format(name, got))
    plain = {
        "k//p:leaf": _fake("k//p:leaf", plat),
        "k//p:top": _fake("k//p:top", wrap, ["k//p:leaf"]),
    }
    if roots(plain) != ["k//p:top"]:
        out.append("roots: an ordinary dependent still removes its dependency from the roots: got {}".format(roots(plain)))
    # The surface capability matrix names each cell's test and builds none:
    # the tests stay roots beside it. The library a test compiles against is
    # an ordinary dependency, so it is no root.
    matrix_kind = "komira//tools/build/lint/surface_capability_matrix.bzl:_surface_capability_matrix_rule"
    test_kind = "komira//tools/build/mojo/defs.bzl:mojo_test_rule"
    lib_kind = "komira//tools/build/mojo/defs.bzl:mojo_library_rule"
    named = {
        "k//:matrix": _fake("k//:matrix", matrix_kind, ["k//e:test_a", "k//e:test_b"]),
        "k//e:lib": _fake("k//e:lib", lib_kind),
        "k//e:test_a": _fake("k//e:test_a", test_kind, ["k//e:lib"]),
        "k//e:test_b": _fake("k//e:test_b", test_kind, ["k//e:lib"]),
    }
    if roots(named) != ["k//:matrix", "k//e:test_a", "k//e:test_b"]:
        out.append("roots: the tests the surface capability matrix names stay roots, the library they compile against is not: got {}".format(roots(named)))
    return out

def _registration_cases(ctx):
    """The execution platforms the checkout registers (`platforms/default:default`): whichever worker sets this
    checkout's configuration names, komira's linux platform stays first; buildrules' linux platform is registered;
    buildrules' macOS platform is registered exactly when komira's own macOS platform is, after it, with the
    executor of komira's macOS platform and not the one of komira's linux platform."""
    out = []
    plats = ctx.analysis(ctx.configured_targets("komira//tools/build/platforms/default:default")).providers()[ExecutionPlatformRegistrationInfo].platforms
    got = [str(p.label) for p in plats]
    by_label = {str(p.label): p for p in plats}
    if not got or got[0] != "komira//tools/build/platforms:linux-x86_64":
        out.append("registration: komira's linux-x86_64 platform must stay first, got {}".format(got))
    if "buildrules//platforms:linux_x86_64" not in got:
        out.append("registration: buildrules' linux_x86_64 platform is missing: {}".format(got))
    komira_mac = "komira//tools/build/platforms:darwin-arm64" in got
    rules_mac = "buildrules//platforms:macos_aarch64" in got
    if komira_mac != rules_mac:
        out.append("registration: buildrules' macos_aarch64 platform must be registered exactly when komira's darwin-arm64 is (komira's: {}, buildrules': {}): {}".format(komira_mac, rules_mac, got))
    if komira_mac and rules_mac:
        if got.index("buildrules//platforms:macos_aarch64") < got.index("komira//tools/build/platforms:darwin-arm64"):
            out.append("registration: buildrules' macos_aarch64 platform must come after komira's darwin-arm64: {}".format(got))
        rules_exec = str(by_label["buildrules//platforms:macos_aarch64"].executor_config)
        if rules_exec != str(by_label["komira//tools/build/platforms:darwin-arm64"].executor_config):
            out.append("registration: buildrules' macos_aarch64 platform must run on komira's macOS workers (the executor of komira's darwin-arm64), but its executor differs")
        if rules_exec == str(by_label["komira//tools/build/platforms:linux-x86_64"].executor_config):
            out.append("registration: buildrules' macos_aarch64 platform has the executor of komira's linux-x86_64 platform")
    return out

# ---- the Python guard ------------------------------------------------------

_PYTEST = "komira//tools/build/python/defs.bzl:_py_test"
_WHEEL = "komira//tools/build/python/defs.bzl:_python_wheel"

def _node(label, kind, srcs = []):
    return struct(label = label, kind = kind, srcs = srcs)

def _python_case(name, nodes, surface, own_deps, wanted):
    """`wanted` is the list of labels the finding must name, [] for none."""
    text = python_findings(nodes, surface, own_deps, "k//ci:pr")
    if not wanted:
        return [] if not text else ["python: {}: wanted none, got: {}".format(name, text)]
    missing = [w for w in wanted if w not in text]
    if missing or "{} Python target(s)".format(len(wanted)) not in text or "EXCLUDED" not in text:
        return ["python: {}: wanted {} named with the way out, got: '{}'".format(name, wanted, text)]
    return []

def _python_cases(ctx):
    out = []
    ci_test = _node("k//release/ci/tests:test_main_red", _PYTEST)
    sdk_test = _node("k//src/sdk_py:test_api", _PYTEST)
    wheel = _node("k//third_party/python:six", _WHEEL)

    # a py_test outside the SDK is a finding, whatever the surface says elsewhere
    out += _python_case("a py_test of a CI script, no SDK package", [ci_test], [], {}, ["k//release/ci/tests:test_main_red"])
    out += _python_case("a py_test outside the SDK package", [ci_test, sdk_test], ["src/sdk_py"], {}, ["k//release/ci/tests:test_main_red"])

    # the SDK's own py_tests and what they reach are allowed, nobody else's
    out += _python_case("the SDK's py_test", [sdk_test], ["src/sdk_py"], {}, [])
    out += _python_case("a wheel the SDK's tests reach", [sdk_test, wheel], ["src/sdk_py"], {"k//third_party/python:six": True}, [])
    out += _python_case("a wheel nothing of the SDK reaches", [sdk_test, wheel], ["src/sdk_py"], {}, ["k//third_party/python:six"])
    out += _python_case("a package that only starts with the SDK's name is not the SDK", [_node("k//src/sdk_py_extra:test_x", _PYTEST)], ["src/sdk_py"], {}, ["k//src/sdk_py_extra:test_x"])

    # what counts as Python: a kind, the hermetic packages, a .py source
    out += _python_case("the pinned interpreter by its package", [_node("k//third_party/python:cpython", "prelude//rules.bzl:alias")], [], {}, ["k//third_party/python:cpython"])
    out += _python_case("a rule of the hermetic-Python package by its package", [_node("k//tools/build/python:oracle_run.py", "prelude//rules.bzl:alias")], [], {}, ["k//tools/build/python:oracle_run.py"])
    out += _python_case("a python_ rule kind elsewhere", [_node("k//x:y", "k//x.bzl:_python_oracle_rule")], [], {}, ["k//x:y"])
    out += _python_case("a .py source of a Mojo test", [_node("k//src/m:t", "k//m.bzl:mojo_test_rule", ["t.mojo", "peer.py"])], [], {}, ["k//src/m:t"])
    out += _python_case("a package that only starts with `python` is not Python", [_node("k//third_party/python_other:x", "k//m.bzl:mojo_library_rule", ["x.mojo"])], [], {}, [])

    # what does not: the prelude's bootstrap helpers, a doc_tree's data, plain targets
    out += _python_case("a python_bootstrap_binary", [_node("k//x:h", "prelude//python_bootstrap/python_bootstrap.bzl:python_bootstrap_binary", ["h.py"])], [], {}, [])
    out += _python_case("the toolchain that provides no interpreter", [_node("k//x:t", "k//cxx.bzl:no_python_bootstrap_toolchain")], [], {}, [])
    out += _python_case("a doc_tree holding a .py file as data", [_node("k//third_party/python:doc_tree", "k//doc_tree.bzl:doc_tree", ["pins.bzl", "x.py"])], [], {}, [])
    out += _python_case("no Python at all", [_node("k//src/a:a", "k//m.bzl:mojo_library_rule", ["a.mojo"])], [], {}, [])

    # the real graph: the fixture aggregate reaches no Python; the pinned interpreter's closure
    # is Python and is allowed only as the SDK's own
    fixture = python_findings(python_nodes(ctx, _AGG), [], {}, _AGG)
    if fixture:
        out.append("python: the complete fixture aggregate reached Python: " + fixture)
    cpython = python_nodes(ctx, "komira//third_party/python:cpython")
    red = python_findings(cpython, [], {}, "komira//third_party/python:cpython")
    if "komira//third_party/python:cpython (" not in red:
        out.append("python: the real pinned interpreter was not a finding: '{}'".format(red))
    green = python_findings(cpython, ["third_party/python"], sdk_own_deps(ctx, cpython, ["third_party/python"]), "komira//third_party/python:cpython")
    if green:
        out.append("python: the real pinned interpreter in the surface was a finding: " + green)
    return out

# ---- the shipped rules -------------------------------------------------------
#
# rules.bzl as shipped, held to the paths that must never be mapped by guess: a
# change to any of them can reach every target through the configuration, the
# rules or the toolchain, so a widen row (not the ownerless-file fallback) names
# it. Deleting a row of WIDEN, or narrowing a pattern, turns the named case red.

_MUST_WIDEN = [
    ".buckconfig",
    ".buckconfig.local.example",
    "buck2",
    "tools/buck2/main",
    "prelude/cxx/cxx.bzl",
    "tools/build/platforms/BUCK",
    "tools/build/cells/toolchains/BUCK",
    "tools/build/mojo/defs.bzl",
    "tools/build/ci/rules.bzl",
    "tools/build/ci/affected.bxl",
    "third_party/snappy/pin.bzl",
]

_ORDINARY = [
    "src/containers/BUCK",
    "src/containers/src/containers/slab.mojo",
    "docs/ci.md",
    "release/artifacts.textproto",
    ".github/workflows/pr.yml",
    "ci/roots/komira/src/containers:ci",
]

def _shipped_rules_cases():
    out = []
    shipped = struct(widen = WIDEN, inert = INERT)
    for p in _MUST_WIDEN:
        v = select(shipped, [p], _table(), "ci")
        if v.kind != WIDENED or "matches widen rule" not in v.reason:
            out.append("shipped rules: '{}' must match a widen row, got {} ({})".format(p, v.kind, v.reason))
    for p in _ORDINARY:
        if widen_reason(shipped, p):
            out.append("shipped rules: '{}' is ordinary and must match no widen row, got '{}'".format(p, widen_reason(shipped, p)))
    for p in ["README.md", "LICENSE", "docs/README.md"]:
        if not is_inert(shipped, p):
            out.append("shipped rules: '{}' builds nothing and must be inert".format(p))
    for p in ["src/x/x.mojo", "release/channels.textproto", "tools/build/ci/BUCK"]:
        if is_inert(shipped, p):
            out.append("shipped rules: '{}' builds something and must not be inert".format(p))
    return out

# ---- the shipped configuration -----------------------------------------------
#
# affected.bxl's CONFIG run through the library over the table graph: what a run
# prints and fails with, by exact equality. pr.yml, darwin.bzl and the scripts that
# read the selector's log match these lines, so the configuration's `held` message
# and `where` names hold the text they read.

def _keep(targets):
    return list(targets)

def _shipped_config_cases():
    out = []
    marker = "src/a/coverage_held"

    def case(name, changed, drop, held, log, failure, stdout):
        got = affected_output(affected_answer(CONFIG, changed, _table(), drop, held, "HEAD"), "labels")
        if got.log != log or got.failure != failure or got.stdout != stdout:
            out.append("shipped config: {}: log {}, failure '{}', stdout {}; wanted log {}, failure '{}', stdout {}".format(name, got.log, got.failure, got.stdout, log, failure, stdout))

    case(
        "a dropped hold fails BROKEN with the coverage README in the message",
        [marker],
        _keep,
        ["B:{}:1:line".format(marker), "B:{}:2:branch".format(marker), "HEAD:{}:1:line".format(marker)],
        [],
        "BROKEN: a coverage hold was dropped (a package that reached the target stays held; tools/build/coverage/README.md): src/a/coverage_held: branch is no longer held",
        [],
    )
    case(
        "a hold marker named by another basename is not a hold",
        ["src/a/held_marker"],
        _keep,
        ["B:src/a/held_marker:1:line"],
        ["affected: AFFECTED: 1 file(s), 4 target(s), 0 left out (EXCLUDED), 0 left out (HEAVY)"],
        "",
        ["k//src/a:a", "k//src/a:a_test", "k//src/b:b", "k//src/c:c"],
    )
    case(
        "an AFFECTED answer logs its counts and prints its labels",
        ["src/b/b.mojo"],
        _keep,
        [],
        ["affected: AFFECTED: 1 file(s), 2 target(s), 0 left out (EXCLUDED), 0 left out (HEAVY)"],
        "",
        ["k//src/b:b", "k//src/c:c"],
    )
    case(
        "an answer whose every target is excluded is the aggregate, naming rules.bzl EXCLUDED",
        ["src/b/b.mojo"],
        lambda targets: [],
        [],
        ["affected: WIDENED: every target reached is left out of the aggregate (rules.bzl EXCLUDED)"],
        "",
        ["komira//ci:pr"],
    )
    case(
        "a build-system file widens to komira//ci:pr, naming the row",
        ["tools/build/mojo/defs.bzl"],
        _keep,
        [],
        ["affected: WIDENED: 'tools/build/mojo/defs.bzl' matches widen rule tools/build/**: the Mojo rules, platforms, toolchains and build tooling are loaded by every target"],
        "",
        ["komira//ci:pr"],
    )
    case(
        "inert files alone, one unowned and one deleted, fail VACUOUS after their warnings",
        ["README.md", ".github/CODEOWNERS"],
        _keep,
        [],
        ["affected: warning: deleted file no package holds (inert): .github/CODEOWNERS", "affected: warning: no target owns (inert): README.md"],
        "VACUOUS: the 2 changed file(s) reach no target: .github/CODEOWNERS, README.md",
        [],
    )
    case("no file fails EMPTY", [], _keep, [], [], "EMPTY: the change names no file", [])
    if CONFIG.where.heavy != "rules.bzl HEAVY" or CONFIG.default != "komira//ci:pr_default":
        out.append("shipped config: a left-out HEAVY row's note must name rules.bzl HEAVY and a WIDENED answer without it is komira//ci:pr_default: where {}, default {}".format(CONFIG.where, CONFIG.default))
    return out

# ---- the C/C++ toolchain per target platform ---------------------------------
#
# `toolchains//:cxx` (komira_cxx_toolchains) configured for each target platform, read off
# the analysed toolchain: macOS arm64 compiles and archives for `aarch64-macos` at zig's
# generic arm64 CPU and its linker is a refusal; linux x86_64 compiles for the glibc triple at
# x86-64-v2, the floor of the row's `isa_variants` (every CPU level of libkomira links the
# same C, so no higher level may reach the compile line), and its linker is zig's; a platform that is macOS on another CPU, or arm64 on another OS,
# is incompatible (the toolchain admits macOS AND arm64 together, never one of them).

_CXX = "toolchains//:cxx"
_FIXTURE_PLATFORMS = "komira//tools/build/ci/fixture/platforms"

# (target platform, the triple the C is compiled for, the CPU it is compiled at, what must not be on the compile line)
_CXX_ADMITTED = [
    ("komira//tools/build/platforms:darwin-arm64", "aarch64-macos", "-mcpu=generic", ["x86_64-linux-gnu", "x86_64_v2", "x86_64_v3"]),
    ("komira//tools/build/platforms:linux-x86_64", "x86_64-linux-gnu", "-mcpu=x86_64_v2", ["aarch64-macos", "-mcpu=generic", "x86_64_v3"]),
]
_CXX_REFUSED = [
    _FIXTURE_PLATFORMS + ":macos_x86_64",
    _FIXTURE_PLATFORMS + ":linux_arm64",
]

def _cxx_toolchain_cases(ctx):
    out = []
    for platform, triple, cpu, absent in _CXX_ADMITTED:
        who = "{} on {}".format(_CXX, platform)
        node = ctx.configured_targets(_CXX, target_platform = platform)
        if node == None:
            out.append("cxx toolchain: {}: incompatible, but the platform is one it must admit".format(who))
            continue
        info = ctx.analysis(node).providers()[CxxToolchainInfo]
        flags = str(info.c_compiler_info.compiler_flags)
        if triple not in flags:
            out.append("cxx toolchain: {}: the C compile is not for {}: {}".format(who, triple, flags))
        if cpu not in flags:
            out.append("cxx toolchain: {}: the C compile is not at {}: {}".format(who, cpu, flags))
        for a in absent:
            if a in flags:
                out.append("cxx toolchain: {}: the C compile carries {}, which belongs to the other platform: {}".format(who, a, flags))
        macos = triple.startswith("aarch64-macos")
        refused = "is not provided" in str(info.linker_info.linker)
        if refused != macos:
            out.append("cxx toolchain: {}: the linker is {}, and must be {}".format(who, "a refusal" if refused else "a real one", "a refusal (compile and archive only)" if macos else "a real one"))
        if "ar" not in str(info.linker_info.archiver):
            out.append("cxx toolchain: {}: no archiver: {}".format(who, info.linker_info.archiver))
    for platform in _CXX_REFUSED:
        if ctx.configured_targets(_CXX, target_platform = platform) != None:
            out.append("cxx toolchain: {} on {}: compatible, but the toolchain admits macOS arm64 and linux x86_64 only".format(_CXX, platform))
    return out

# ---- the protobuf toolchain per target platform --------------------------------
#
# `toolchains//:mojo_proto` (komira_proto_toolchains) is compatible with the two platforms the
# release builds a Mojo package for: its tools are execution dependencies, run on the linux
# execution platform, and what they write is the same for both, so a macOS arm64 package whose
# welded tests read a proto_fixture_check report (chat_proto, managed_mail_proto) configures.
# Any other platform stays incompatible, as for `toolchains//:cxx`.

_PROTO = "toolchains//:mojo_proto"
_PROTO_ADMITTED = [
    "komira//tools/build/platforms:darwin-arm64",
    "komira//tools/build/platforms:linux-x86_64",
]

def _proto_toolchain_cases(ctx):
    out = []
    for platform in _PROTO_ADMITTED:
        if ctx.configured_targets(_PROTO, target_platform = platform) == None:
            out.append("proto toolchain: {} on {}: incompatible, but the platform is one it must admit".format(_PROTO, platform))
    for platform in _CXX_REFUSED:
        if ctx.configured_targets(_PROTO, target_platform = platform) != None:
            out.append("proto toolchain: {} on {}: compatible, but the toolchain admits macOS arm64 and linux x86_64 only".format(_PROTO, platform))
    return out

# ---- adopted libraries on macOS arm64 ------------------------------------------
#
# A target configured for darwin-arm64 compiles its Mojo on macOS, and the C toolchain
# (`toolchains//:cxx`) runs on a linux execution platform. A rule that takes the C toolchain
# as a toolchain dep next to the Mojo one has no execution platform, and its
# `readme_examples:tool` exec dep fails analysis ("no execution platform was resolved").
# So `mojo_adopted_library` reaches the C toolchain through `adopt_cxx_link_facts`, a rule
# of its own.
#
# Two reads, neither needing a macOS worker (a checkout without the worker properties
# registers no macOS execution platform, so no adopted library can be configured there):
#   - the declared graph: every adopted library's `cxx_toolchain` is a `cxx_link_facts`
#     target, never a toolchain rule; and the library files of the package that links C
#     (libc) and the one that does not (lz4) configure for darwin-arm64;
#   - when the macOS execution platform is registered (the farm's checkouts), every
#     adopted library is configured for darwin-arm64, which resolves its execution
#     platform and its exec dependencies.

_DARWIN = "komira//tools/build/platforms:darwin-arm64"
_ADOPTED_LIBS = ["komira//src/libc:lib", "komira//src/lz4:lib"]
_ADOPTED_WITH_C = "komira//src/libc:libc"

def _adopted_darwin_cases(ctx):
    out = []
    for lib in _ADOPTED_LIBS:
        if ctx.configured_targets(lib, target_platform = _DARWIN) == None:
            out.append("adopted darwin: {} is incompatible with {}, but it builds there".format(lib, _DARWIN))
    adopted = list(ctx.uquery().kind("^_adopted$", "komira//src/..."))
    labels = [str(t.label) for t in adopted]
    if _ADOPTED_WITH_C not in labels:
        out.append("adopted darwin: the query for adopted libraries did not find {}, so this check proves nothing".format(_ADOPTED_WITH_C))
    for t in adopted:
        tc = t.get_attr("cxx_toolchain")
        if tc == None:
            continue
        rule = [str(ctx.unconfigured_targets(str(tc)).rule_type)]
        if len(rule) != 1 or not rule[0].endswith(":cxx_link_facts"):
            out.append("adopted darwin: {} takes `cxx_toolchain` = {} ({}); a toolchain rule there leaves it no execution platform on {} (use //tools/build/mojo:adopt_cxx_link_facts)".format(t.label, tc, rule, _DARWIN))
    platforms = ctx.analysis(ctx.configured_targets("komira//tools/build/platforms/default:default")).providers()[ExecutionPlatformRegistrationInfo].platforms
    if _DARWIN in [str(p.label) for p in platforms]:
        for t in adopted:
            ctx.configured_targets(t.label, target_platform = _DARWIN)
    return out

# ---- the committed roots (roots.bzl) -------------------------------------------
#
# One empty file per root. The cases hold the encoding (label <-> path, both ways, and
# the paths that name no label), the trees (a test root under ci/test_roots/, any other
# under ci/roots/), the merge of two branches that each add targets, and the guard's
# refusals, each named by the path to add or delete.

def _changed(base, branch):
    """path -> "add" or "delete": what `branch` changes in the tree `base` (both path -> "")."""
    out = {p: "add" for p in branch if p not in base}
    for p in base:
        if p not in branch:
            out[p] = "delete"
    return out

def _merge(base, a, b):
    """(tree, conflicts): git's three-way merge of the file trees `a` and `b` of one `base`, at
    the level of paths, which is all a tree of empty files has. A path one side changed takes
    that change; a path both sides changed the same way (two adds of the same empty file, two
    deletes) takes it; a path the two sides changed differently is a conflict, and so is a file
    that stands where another file's directory does."""
    ca, cb = _changed(base, a), _changed(base, b)
    conflicts = sorted([p for p in ca if p in cb and ca[p] != cb[p]])
    tree = dict(base)
    for c in [ca, cb]:
        for p, op in c.items():
            if op == "add":
                tree[p] = ""
            elif p in tree:
                tree.pop(p)
    for p in tree:
        for q in tree:
            if q.startswith(p + "/"):
                conflicts.append("{} is a file and a directory of {}".format(p, q))
    return tree, conflicts

def _graph(roots_of, tests_of, add = [], add_tests = [], depended = []):
    """The (roots, tests) of a branch of the graph (`roots_of`, `tests_of`): it adds the
    targets `add` and the tests `add_tests`, which nothing depends on, and its new targets
    depend on the old roots `depended`, which are roots no more."""
    rs = sorted([l for l in roots_of if l not in depended] + add + add_tests)
    ts = sorted([l for l in tests_of if l not in depended] + add_tests)
    return rs, ts

_BASE_ROOTS = [
    "komira//:top",
    "komira//python/docs/tasks:1-read-csv-file",
    "komira//src/p1:lib",
    "komira//src/p1:test_p1",
    "komira//src/p2:lib",
    "tests//functional/f:case",
]
_BASE_TESTS = ["komira//src/p1:test_p1"]

def _merge_case(name, a, b):
    """The merge of the branches `a` and `b` (each a (roots, tests) of the graph) of the base:
    each branch's files are the generator's for its graph, the merge has no conflict in either
    order, the two orders give one tree, and the guard holds over the merged tree against the
    graph of both changes (the base's roots, less those either side now depends on, plus both
    sides' new ones)."""
    out = []
    base = root_files(_BASE_ROOTS, _BASE_TESTS)
    fa, fb = root_files(a[0], a[1]), root_files(b[0], b[1])
    ab, conflicts = _merge(base, fa, fb)
    ba, conflicts_ba = _merge(base, fb, fa)
    if conflicts or conflicts_ba:
        out.append("roots: merge, {}: conflicts {} {}".format(name, conflicts, conflicts_ba))
    if sorted(ab.keys()) != sorted(ba.keys()):
        out.append("roots: merge, {}: the two orders give different trees".format(name))
    gone = {l: True for l in _BASE_ROOTS if l not in a[0] or l not in b[0]}
    merged_roots = sorted({l: True for l in a[0] + b[0] if l not in gone}.keys())
    merged_tests = sorted({l: True for l in a[1] + b[1] if l not in gone}.keys())
    text = root_findings(root_files(merged_roots, merged_tests).keys(), ab.keys())
    if text:
        out.append("roots: merge, {}: the guard fails over the merged tree: {}".format(name, text))
    return out

def _root_file_cases():
    out = []

    # the encoding: a label's path is the label with `//` written `/`, and back
    for label, path in [
        ("komira//src/avro:avro_conda", "komira/src/avro:avro_conda"),
        ("komira//:top", "komira/:top"),
        ("tests//functional/a/b:c.d=e,f+g@h!i~j-k_l", "tests/functional/a/b:c.d=e,f+g@h!i~j-k_l"),
        ("komira//python/docs/tasks:22-read-json-file-write-records-database__probe_native_insert", "komira/python/docs/tasks:22-read-json-file-write-records-database__probe_native_insert"),
    ]:
        if root_path(label) != path:
            out.append("roots: the path of {} is {}, wanted {}".format(label, root_path(label), path))
        if root_label(path) != label:
            out.append("roots: the label of {} is '{}', wanted {}".format(path, root_label(path), label))
    for path, why in [
        ("komira", "no cell directory"),
        ("/src/a:b", "an empty cell"),
        ("komira/src/a", "no `:`"),
        ("komira/src/a:b:c", "two `:`"),
        ("komira/src/a:", "an empty target name"),
        ("komira/src:x/y:z", "a `:` in a directory"),
        ("komira/src/b_no_colon", "no `:` in the last part"),
    ]:
        if root_label(path) != "":
            out.append("roots: '{}' ({}) names no label, got '{}'".format(path, why, root_label(path)))

    # what ci/BUCK reads from its globs: the labels, sorted, and nothing for a path that names none
    got = labels_of(["roots/komira/src/b:b", "roots/komira/src/a:a", "roots/komira/src/bad", "roots/tests/functional:x"], "roots")
    if got != ["komira//src/a:a", "komira//src/b:b", "tests//functional:x"]:
        out.append("roots: labels_of the glob: {}".format(got))

    # the trees: a test root's file is under ci/test_roots/, every other root's under ci/roots/
    got = root_files(["komira//src/a:a", "komira//src/a:test_a", "komira//:top"], ["komira//src/a:test_a"])
    want = {"ci/roots/komira/:top": "", "ci/roots/komira/src/a:a": "", "ci/test_roots/komira/src/a:test_a": ""}
    if got != want:
        out.append("roots: root_files: {}, wanted {}".format(got, want))

    # a file never stands where another's directory does: the target `b` of the package `src/a`
    # and the targets of the package `src/a/b` (with the `:` dropped, `src/a/b` would be both)
    paths = root_files(["k//src/a:b", "k//src/a/b:c", "k//src/a/b/c:d", "k//:src"], []).keys()
    for p in paths:
        for q in paths:
            if q.startswith(p + "/"):
                out.append("roots: the file {} is a directory of {}".format(p, q))
    _, clash = _merge({}, {"k/src/a/b": ""}, {"k/src/a/b/c": ""})
    if not clash:
        out.append("roots: the merge model must refuse a file at the path of another's directory")
    _, clash = _merge({"x": ""}, {"x": "", "y": ""}, {})
    if clash:
        out.append("roots: one side's add is no conflict: {}".format(clash))

    # two branches merge with no conflict, in either order, and the guard holds after: targets
    # added in two packages; in one package (the task examples, which every example batch adds
    # to); a new package beside a new test; and two new targets that depend on the same old
    # root, which both branches delete
    out += _merge_case(
        "targets added in two packages",
        _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//src/new_a:lib"]),
        _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//src/p2:extra"]),
    )
    out += _merge_case(
        "targets added in one package",
        _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//python/docs/tasks:2-select-columns"]),
        _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//python/docs/tasks:3-sort-rows"]),
    )
    out += _merge_case(
        "a new package and a new test",
        _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//src/new_b:lib", "komira//src/new_b:lib_conda"]),
        _graph(_BASE_ROOTS, _BASE_TESTS, add_tests = ["komira//src/p2:test_p2"]),
    )
    out += _merge_case(
        "two new dependents of one old root",
        _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//src/p1:bin"], depended = ["komira//src/p1:lib"]),
        _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//src/p3:bin"], depended = ["komira//src/p1:lib"]),
    )

    # the guard: the current tree passes; each defect fails, naming the file to add or delete
    want = root_files(_BASE_ROOTS, _BASE_TESTS).keys()

    def named(text):
        """(the paths the failure says to add, those it says to delete)."""
        adds, deletes = [], []
        for part in text.split(". Add and delete those files")[0].split("; "):
            if "): " not in part:
                continue
            paths = part.split("): ", 1)[1].split(" ")
            if "have no file" in part:
                adds += paths
            elif "name no root" in part:
                deletes += paths
        return sorted(adds), sorted(deletes)

    def refused(name, have, adds, deletes, want = want):
        text = root_findings(want, have)
        if not text:
            out.append("roots: guard, {}: passed".format(name))
            return
        if named(text) != (sorted(adds), sorted(deletes)):
            out.append("roots: guard, {}: names {} to add and {} to delete, wanted {} and {}: '{}'".format(name, named(text)[0], named(text)[1], adds, deletes, text))
        if REGENERATE not in text:
            out.append("roots: guard, {}: the failure does not name the command that writes every file".format(name))

    if root_findings(want, want) != "":
        out.append("roots: guard, a current tree failed: " + root_findings(want, want))
    if root_findings(want, list(reversed(want))) != "":
        out.append("roots: guard, the order of the listing must not matter")
    refused("a root with no file", [p for p in want if p != "ci/roots/komira/src/p2:lib"], ["ci/roots/komira/src/p2:lib"], [])
    refused("a file whose target is gone", want + ["ci/roots/komira/src/gone:x"], [], ["ci/roots/komira/src/gone:x"])
    g = _graph(_BASE_ROOTS, _BASE_TESTS, add = ["komira//src/p1:bin"], depended = ["komira//src/p1:lib"])
    nowdep = root_files(g[0], g[1]).keys()
    refused("a file of a root that now has a dependent", nowdep + ["ci/roots/komira/src/p1:lib"], [], ["ci/roots/komira/src/p1:lib"], want = nowdep)
    refused("a test filed as a plain root", [p for p in want if "test_p1" not in p] + ["ci/roots/komira/src/p1:test_p1"], ["ci/test_roots/komira/src/p1:test_p1"], ["ci/roots/komira/src/p1:test_p1"])
    refused("a plain root filed as a test", [p for p in want if p != "ci/roots/komira/src/p2:lib"] + ["ci/test_roots/komira/src/p2:lib"], ["ci/roots/komira/src/p2:lib"], ["ci/test_roots/komira/src/p2:lib"])
    refused("a root in both trees", want + ["ci/roots/komira/src/p1:test_p1"], [], ["ci/roots/komira/src/p1:test_p1"])
    refused("a file that names no label", want + ["ci/roots/komira/src/p2_lib"], [], ["ci/roots/komira/src/p2_lib"])

    # after a merge the guard still refuses a branch that left its new root without a file
    base = root_files(_BASE_ROOTS, _BASE_TESTS)
    tree, _ = _merge(base, root_files(_BASE_ROOTS + ["komira//src/new_a:lib"], _BASE_TESTS), base)
    merged_want = root_files(_BASE_ROOTS + ["komira//src/new_a:lib", "komira//src/new_c:lib"], _BASE_TESTS).keys()
    refused("a merged branch that left its root without a file", tree.keys(), ["ci/roots/komira/src/new_c:lib"], [], want = merged_want)

    # the whole text, by exact equality: one of each, and the count past the first ten
    text = root_findings(["ci/roots/k/src/a:a"], ["ci/roots/k/src/b:b"])
    exact = "the committed roots of //ci:pr (ci/roots/, ci/test_roots/) are out of date: 1 root(s) of the check set have no file (first 1, add each as an empty file): ci/roots/k/src/a:a; 1 file(s) name no root of the check set (first 1, delete each): ci/roots/k/src/b:b. Add and delete those files, or write every one from the graph: " + REGENERATE
    if text != exact:
        out.append("roots: guard, the failure text: '{}', wanted '{}'".format(text, exact))
    many = ["ci/roots/k/src/m:" + c for c in "abcdefghijkl".elems()]
    text = root_findings(many, [])
    if "12 root(s) of the check set have no file (first 10," not in text or named(text)[0] != many[:10]:
        out.append("roots: guard, twelve missing files must be counted and the first ten named: '{}'".format(text))
    return out

def _run(ctx):
    table = _root_file_cases() + _python_cases(ctx) + _roots_cases() + _shipped_rules_cases() + _shipped_config_cases() + heavy_cases() + _registration_cases(ctx) + _cxx_toolchain_cases(ctx) + _proto_toolchain_cases(ctx) + _adopted_darwin_cases(ctx) + darwin_table_cases() + python_tests_cases() + python_platform_cases(ctx)
    real = _real_cases(ctx) + darwin_real_cases(ctx, DARWIN_PACKAGES, "komira//release:mopm_darwin_libs") + darwin_answer_cases(DARWIN_PACKAGES, "komira//release:mopm_darwin_libs") + task_tree_cases(ctx)
    failures = table + real
    if failures:
        fail("{} case(s) failed:\n  ".format(len(failures)) + "\n  ".join(failures))
    ctx.output.print("cases: table and real cases all passed")

run = bxl_main(impl = _run, cli_args = {})
