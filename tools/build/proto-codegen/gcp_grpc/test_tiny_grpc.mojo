# =============================================================================
# test_tiny_grpc.mojo — a generated Google Cloud gRPC client, end to end.
# =============================================================================
#
# `TinyServiceClient` is generated by mojo_gcp_client(protocol = "grpc") from
# example/tiny/v1/tiny.proto and compiled against the real komira_grpc and
# komira_gcp_core. Each test drives it over a ScriptedConnector (canned
# HTTP/1.1 responses, every written byte captured; no socket) and checks:
#
#   * the token hook: every call, of each streaming shape, carries exactly one
#     `authorization: Bearer <token>`, fetched from the client's
#     GcpTokenSource for that call; a caller's own `authorization` entry is
#     replaced, not sent beside it; an empty token is refused before anything
#     is sent;
#   * the status mapping: a gRPC status, on a unary or a streaming call, is
#     raised as komira_gcp_core's error, with its google.rpc.Code, and without
#     the server's `grpc-message`;
#   * the messages: requests are protobuf-encoded on the RPC's path, responses
#     decode into the generated types.
# =============================================================================

from std.memory import ArcPointer
from std.sys.info import CompilationTarget
from std.testing import assert_equal, assert_false, assert_true

from komira_async.cancellation.token import CancellationToken
from komira_async.ops.waker_sink import NoopSink
from komira_async.reactor.reactor import BACKEND_EPOLL, BACKEND_KQUEUE, Reactor
from komira_async.runtime.runtime import PerCoreAsyncRuntime
from komira_http_client.client import HttpClient
from komira_http_client.url import Url
from komira_http_core.transport.scripted import ScriptedConnector, ScriptedStream
from komira_gcp_core import (
    CODE_PERMISSION_DENIED,
    CODE_UNAUTHENTICATED,
    CODE_UNAVAILABLE,
    CODE_UNKNOWN,
    GcpTokenSource,
    code_name,
)
from komira_grpc import (
    BidiStreamCodec,
    CallOptions,
    ClientStreamEncoder,
    GrpcClient,
    ProtocolGrpcProto,
    ServerStreamDecoder,
    STREAM_OUTCOME_MESSAGE,
    encode_stream_message,
    encode_unary_request,
)
from komira_proto_codec.proto_binary import PbDecoder, PbEncoder

from komira_gcp_tiny_grpc.tiny import (
    GetThingRequest,
    Thing,
    TinyServiceClient,
    UploadThingsResponse,
    WatchThingsRequest,
)


comptime RT = PerCoreAsyncRuntime[NoopSink]

comptime _GET = "/example.tiny.v1.TinyService/GetThing"
comptime _WATCH = "/example.tiny.v1.TinyService/WatchThings"
comptime _UPLOAD = "/example.tiny.v1.TinyService/UploadThings"
comptime _SYNC = "/example.tiny.v1.TinyService/SyncThings"

comptime _SERVER_TEXT = "bucket acme-secret-bucket of leaked@example.com is busy"
"""A `grpc-message` holding what a server's error text holds: names."""


# =============================================================================
# The token source and the rig.
# =============================================================================


struct CountingTokenSource(GcpTokenSource, Movable, Deinitable):
    """Returns `tok-1`, `tok-2`, ...: a different token for each fetch, so a
    test can tell which call fetched which. `empty` returns "" instead."""

    var _fetches: Int
    var _empty: Bool

    def __init__(out self, empty: Bool = False):
        self._fetches = 0
        self._empty = empty

    def access_token(mut self) raises -> String:
        self._fetches += 1
        if self._empty:
            return String()
        return String("tok-") + String(self._fetches)

    def fetches(self) -> Int:
        return self._fetches


comptime Client = TinyServiceClient[ScriptedConnector, CountingTokenSource]


def _b(s: String) -> List[UInt8]:
    var out = List[UInt8]()
    for b in s.as_bytes():
        out.append(b)
    return out^


def _lower_text(bytes: List[UInt8]) -> String:
    """`bytes` as text, ASCII letters lowered (header names are
    case-insensitive), every other byte kept."""
    var out = String()
    for i in range(len(bytes)):
        var c = Int(bytes[i])
        if c >= ord("A") and c <= ord("Z"):
            c += 32
        out += chr(c)
    return out^


def _find_from(hay: String, needle: String, start: Int) -> Int:
    """The byte offset of the first `needle` in `hay` at or after `start`, or
    -1."""
    var h = hay.as_bytes()
    var n = needle.as_bytes()
    var last = len(h) - len(n)
    var i = start
    while i <= last:
        var j = 0
        while j < len(n) and h[i + j] == n[j]:
            j += 1
        if j == len(n):
            return i
        i += 1
    return -1


def _count(hay: String, needle: String) -> Int:
    var n = 0
    var at = _find_from(hay, needle, 0)
    while at >= 0:
        n += 1
        at = _find_from(hay, needle, at + needle.byte_length())
    return n


def _make_reactor() raises -> Reactor[NoopSink]:
    comptime if CompilationTarget.is_linux():
        return Reactor[NoopSink](NoopSink(_placeholder=UInt8(0)), BACKEND_EPOLL)
    return Reactor[NoopSink](NoopSink(_placeholder=UInt8(0)), BACKEND_KQUEUE)


def _http_200(body: List[UInt8], status_headers: String = "") -> List[UInt8]:
    """A canned HTTP/1.1 200 gRPC response: `status_headers` (CRLF-terminated
    lines) after the content type, then `body`. `Connection: close`, so each
    call dials its own scripted stream."""
    var out = _b(
        String("HTTP/1.1 200 OK\r\nContent-Type: application/grpc\r\n")
        + status_headers
        + "Content-Length: "
        + String(len(body))
        + "\r\nConnection: close\r\n\r\n"
    )
    for i in range(len(body)):
        out.append(body[i])
    return out^


def _status_only(grpc_status: Int) -> List[UInt8]:
    """A trailers-only failure: `grpc-status` and `grpc-message`, no body."""
    return _http_200(
        List[UInt8](),
        String("grpc-status: ")
        + String(grpc_status)
        + "\r\ngrpc-message: "
        + _SERVER_TEXT
        + "\r\n",
    )


def _thing(name: String, size: Int64) raises -> List[UInt8]:
    var enc = PbEncoder()
    Thing(name=name.copy(), size=size).encode(enc)
    return enc.into_buf()


def _unary_body(var message: List[UInt8]) raises -> List[UInt8]:
    return encode_unary_request[ProtocolGrpcProto](Span(message))


def _client(
    var scripts: List[List[UInt8]],
    capture: ArcPointer[List[UInt8]],
    var tokens: CountingTokenSource,
) raises -> Client:
    """A client whose connector serves `scripts`, one per dial, and mirrors
    every written byte into `capture`."""
    var connector = ScriptedConnector()
    for i in range(len(scripts)):
        var s = ScriptedStream.from_read_script_with_capture(
            scripts[i].copy(), capture
        )
        if i == 0:
            connector.arm(s^)
        else:
            connector.arm_next(s^)
    var http = HttpClient[ScriptedConnector].with_defaults(connector^)
    var base = Url.parse(String("http://127.0.0.1:8080/"))
    return Client(GrpcClient[ScriptedConnector](http^, base^), tokens^)


def _new_capture() -> ArcPointer[List[UInt8]]:
    return ArcPointer[List[UInt8]](List[UInt8]())


def _sent(capture: ArcPointer[List[UInt8]]) -> String:
    return _lower_text(capture[])


def _drain_things(var decoder: ServerStreamDecoder[ProtocolGrpcProto]) raises -> List[String]:
    """Every message of `decoder`, decoded as a Thing, as `name:size`."""
    var got = List[String]()
    for _ in range(100):
        var o = decoder.try_next_message()
        if o.kind != STREAM_OUTCOME_MESSAGE:
            break
        var dec = PbDecoder(o.message_bytes.copy())
        var t = Thing.decode(dec)
        got.append(t.name + ":" + String(t.size))
    return got^


# =============================================================================
# The token hook.
# =============================================================================


def test_each_unary_call_carries_its_own_bearer_token() raises:
    var capture = _new_capture()
    var scripts = List[List[UInt8]]()
    scripts.append(_http_200(_unary_body(_thing("a", 3))))
    scripts.append(_http_200(_unary_body(_thing("b", 4))))
    var client = _client(scripts^, capture, CountingTokenSource())
    var reactor = _make_reactor()
    var token = CancellationToken.never()

    var first = client.get_thing[RT](
        GetThingRequest(name=String("things/a")), CallOptions(), 0, reactor, token
    )
    var second = client.get_thing[RT](
        GetThingRequest(name=String("things/b")), CallOptions(), 0, reactor, token
    )
    assert_equal(first.name, "a")
    assert_equal(first.size, Int64(3))
    assert_equal(second.name, "b")
    assert_equal(second.size, Int64(4))
    assert_equal(client.token_source().fetches(), 2, "one token per call")

    var sent = _sent(capture)
    var path = String("post ") + _lower_text(_b(_GET))
    assert_equal(_count(sent, path), 2, sent)
    assert_equal(_count(sent, "authorization:"), 2, sent)
    assert_equal(_count(sent, "authorization: bearer tok-1\r\n"), 1, sent)
    assert_equal(_count(sent, "authorization: bearer tok-2\r\n"), 1, sent)
    # The first request carries the first token.
    assert_true(
        _find_from(sent, "tok-1", 0) < _find_from(sent, path, _find_from(sent, path, 0) + 1),
        sent,
    )
    # The request message is on the wire (protobuf: field 1, "things/a").
    assert_true(sent.find("things/a") >= 0, sent)


def test_a_callers_authorization_entry_is_replaced() raises:
    var capture = _new_capture()
    var scripts = List[List[UInt8]]()
    scripts.append(_http_200(_unary_body(_thing("a", 3))))
    var client = _client(scripts^, capture, CountingTokenSource())
    var reactor = _make_reactor()
    var token = CancellationToken.never()

    var opts = CallOptions()
    opts.raw_metadata.set(String("authorization"), String("Bearer stale"))
    opts.metadata.set(String("x-caller"), String("kept"))
    _ = client.get_thing[RT](
        GetThingRequest(name=String("things/a")), opts^, 0, reactor, token
    )
    var sent = _sent(capture)
    assert_equal(_count(sent, "authorization:"), 1, sent)
    assert_equal(_count(sent, "authorization: bearer tok-1\r\n"), 1, sent)
    assert_false(sent.find("stale") >= 0, sent)
    # The caller's other metadata travels unchanged.
    assert_equal(_count(sent, "x-caller: kept\r\n"), 1, sent)


def test_an_empty_token_is_refused_before_anything_is_sent() raises:
    var capture = _new_capture()
    var scripts = List[List[UInt8]]()
    scripts.append(_http_200(_unary_body(_thing("a", 3))))
    var client = _client(scripts^, capture, CountingTokenSource(empty=True))
    var reactor = _make_reactor()
    var token = CancellationToken.never()

    var message = String()
    try:
        _ = client.get_thing[RT](
            GetThingRequest(name=String("things/a")), CallOptions(), 0, reactor, token
        )
    except e:
        message = String(e)
    assert_equal(message, "the token source returned an empty access token")
    assert_equal(len(capture[]), 0, "no byte may be sent without a token")


def test_every_streaming_shape_carries_the_bearer_token() raises:
    var capture = _new_capture()
    var scripts = List[List[UInt8]]()
    # WatchThings: two streamed Things.
    var watch = List[UInt8]()
    encode_stream_message[ProtocolGrpcProto](watch, Span(_thing("w1", 1)))
    encode_stream_message[ProtocolGrpcProto](watch, Span(_thing("w2", 2)))
    scripts.append(_http_200(watch))
    # UploadThings: one response.
    var up = PbEncoder()
    UploadThingsResponse(count=Int64(2)).encode(up)
    scripts.append(_http_200(_unary_body(up.into_buf())))
    # SyncThings: one streamed Thing back.
    var sync = List[UInt8]()
    encode_stream_message[ProtocolGrpcProto](sync, Span(_thing("s1", 7)))
    scripts.append(_http_200(sync))
    var client = _client(scripts^, capture, CountingTokenSource())
    var reactor = _make_reactor()
    var token = CancellationToken.never()

    var watched = _drain_things(
        client.watch_things[RT](
            WatchThingsRequest(prefix=String("things/")), CallOptions(), 0, reactor, token
        )
    )
    assert_equal(len(watched), 2)
    assert_equal(watched[0], "w1:1")
    assert_equal(watched[1], "w2:2")

    var encoder = ClientStreamEncoder[ProtocolGrpcProto].new()
    encoder.encode_message(Span(_thing("u1", 5)))
    encoder.encode_message(Span(_thing("u2", 6)))
    encoder.mark_close()
    var uploaded = client.upload_things[RT](encoder^, CallOptions(), 0, reactor, token)
    assert_equal(uploaded.count, Int64(2))

    var codec = BidiStreamCodec[ProtocolGrpcProto].new()
    codec.encoder.encode_message(Span(_thing("q1", 8)))
    codec.encoder.mark_close()
    var synced = _drain_things(
        client.sync_things[RT](codec^, CallOptions(), 0, reactor, token)
    )
    assert_equal(len(synced), 1)
    assert_equal(synced[0], "s1:7")

    assert_equal(client.token_source().fetches(), 3, "one token per call")
    var sent = _sent(capture)
    assert_equal(_count(sent, "authorization:"), 3, sent)
    var i = 0
    for path in [_WATCH, _UPLOAD, _SYNC]:
        i += 1
        var at = _find_from(sent, String("post ") + _lower_text(_b(path)), 0)
        assert_true(at >= 0, String(path) + " was not sent: " + sent)
        var bearer = String("authorization: bearer tok-") + String(i) + "\r\n"
        assert_equal(_count(sent, bearer), 1, sent)
        assert_true(_find_from(sent, bearer, 0) > at, String(path) + " carries " + bearer)
    # The streamed request messages are on the wire.
    for name in ["things/", "u1", "u2", "q1"]:
        assert_true(sent.find(name) >= 0, String(name) + " not sent: " + sent)


# =============================================================================
# The status mapping.
# =============================================================================


def _unary_failure(grpc_status: Int) raises -> String:
    """The error text of a GetThing the server fails with `grpc_status`."""
    var capture = _new_capture()
    var scripts = List[List[UInt8]]()
    scripts.append(_status_only(grpc_status))
    var client = _client(scripts^, capture, CountingTokenSource())
    var reactor = _make_reactor()
    var token = CancellationToken.never()
    try:
        _ = client.get_thing[RT](
            GetThingRequest(name=String("things/a")), CallOptions(), 0, reactor, token
        )
    except e:
        return String(e)
    raise Error(String("GetThing succeeded over grpc-status ") + String(grpc_status))


def _expected(rpc: String, code: Int) -> String:
    return (
        String("gRPC ")
        + rpc
        + ": "
        + code_name(code)
        + " (code "
        + String(code)
        + ")"
    )


def test_a_grpc_status_is_raised_with_its_google_rpc_code() raises:
    var statuses: List[Int] = [14, 7, 16]
    var codes: List[Int] = [CODE_UNAVAILABLE, CODE_PERMISSION_DENIED, CODE_UNAUTHENTICATED]
    for k in range(len(statuses)):
        var text = _unary_failure(statuses[k])
        var want = _expected(_GET, codes[k])
        assert_true(text.startswith(want + ", error text "), text)
        assert_false(text.find("grpc-status") >= 0, text)
        assert_true(text.endswith(" bytes"), text)
        for leak in ["acme-secret-bucket", "leaked@example.com", "busy", "[grpc:"]:
            assert_false(text.find(leak) >= 0, String("echoed: ") + leak + " in " + text)


def test_a_status_grpc_does_not_define_is_unknown() raises:
    var text = _unary_failure(42)
    assert_true(
        text.startswith(_expected(_GET, CODE_UNKNOWN) + ", grpc-status 42, error text "),
        text,
    )


def test_a_streaming_call_maps_its_status_too() raises:
    var capture = _new_capture()
    var scripts = List[List[UInt8]]()
    scripts.append(_status_only(7))
    var client = _client(scripts^, capture, CountingTokenSource())
    var reactor = _make_reactor()
    var token = CancellationToken.never()
    var text = String()
    try:
        _ = client.watch_things[RT](
            WatchThingsRequest(prefix=String("things/")), CallOptions(), 0, reactor, token
        )
    except e:
        text = String(e)
    assert_true(text.startswith(_expected(_WATCH, CODE_PERMISSION_DENIED)), text)
    assert_false(text.find("acme-secret-bucket") >= 0, text)


def main() raises:
    test_each_unary_call_carries_its_own_bearer_token()
    test_a_callers_authorization_entry_is_replaced()
    test_an_empty_token_is_refused_before_anything_is_sent()
    test_every_streaming_shape_carries_the_bearer_token()
    test_a_grpc_status_is_raised_with_its_google_rpc_code()
    test_a_status_grpc_does_not_define_is_unknown()
    test_a_streaming_call_maps_its_status_too()
    print("all tiny gRPC client tests passed")
