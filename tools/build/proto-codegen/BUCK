load("@komira//tools/build/mojo:proto.bzl", "proto_srcs")
load("@komira//tools/build/rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# The protoc plugins that generate Mojo, from the `komira_proto_codegen`
# crate. The Mojo proto rules name these binaries through the toolchain
# `toolchains//:mojo_proto`.

_DEPS = [
    "komira//third_party/rust:prost",
    "komira//third_party/rust:prost-types",
]

_LIB_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/main.rs", "src/main_*.rs"],
)

# The library is published behind its inline #[test]s: it, and every
# generator binary that links it, cannot build unless they pass.
rust_library(
    name = "komira_proto_codegen",
    srcs = _LIB_SRCS,
    crate_root = "src/lib.rs",
    deps = _DEPS,
    tests = [":komira_proto_codegen_unit"],
)

# The crate's inline #[test]s: the same sources, compiled with `rustc --test`
# and run as a build action.
rust_test(
    name = "komira_proto_codegen_unit",
    srcs = _LIB_SRCS,
    crate_root = "src/lib.rs",
    crate_name = "komira_proto_codegen",
    deps = _DEPS,
)

# Reads a CodeGeneratorRequest on stdin, writes one `<stem>.mojo` per input
# `.proto` in the CodeGeneratorResponse on stdout.
rust_binary(
    name = "protoc-gen-mojo",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = _DEPS + [":komira_proto_codegen"],
    visibility = ["PUBLIC"],
)

# The same, emitting `<stem>_db.mojo` (a DbStorable implementation) for each
# input `.proto` that declares a table message.
rust_binary(
    name = "protoc-gen-mojo-db",
    srcs = ["src/main_db.rs"],
    crate_root = "src/main_db.rs",
    deps = _DEPS + [":komira_proto_codegen"],
    visibility = ["PUBLIC"],
)

# The `(komira.db.*)` options protoc-gen-mojo-db reads, imported as
# "komira/db/options.proto": a `proto_deps` entry of every
# mojo_db_proto_library.
proto_srcs(
    name = "db_options",
    srcs = ["db/options.proto"],
    import_prefix = "komira",
    visibility = ["PUBLIC"],
)

# A Mojo AWS client module from a pinned botocore model and an operation
# list: `--model`, `--model-sha256` (checked against the model bytes),
# `--service`, `--operations`, `--module`, `--out`, and `--probe-out` for the
# module's layout probe. Every input is a flag. The text goldens and
# refusals are check actions in tests//functional/aws_codegen.
rust_binary(
    name = "aws-client-gen",
    srcs = ["src/main_aws_client.rs"],
    crate_root = "src/main_aws_client.rs",
    deps = _DEPS + [":komira_proto_codegen"],
    visibility = ["PUBLIC"],
)
