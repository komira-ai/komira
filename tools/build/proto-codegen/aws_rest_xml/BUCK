load("@komira//tools/build/cloud:aws.bzl", "aws_client")
load(":model.bzl", "TINY_REST_XML")

# A restXml client of a tiny S3-shaped model (serviceId S3, signature
# version `s3`), generated in pure mode with the `s3` customization and
# compiled against the real komira_aws_core and komira_xml: a label after a
# literal query, a header, the input's root element in its namespace, a
# wrapped list with renamed items, a flattened list of structures, a
# structure payload, a streaming blob output payload, and the two `s3`
# response behaviors.
#
# The library is gated by its layout probe and test_tiny_rest_xml, which
# checks the requests it builds and the responses it reads, byte for byte.
# botocore's rest-xml conformance corpus is run against the same emitter by
# //tools/build/proto-codegen:aws_conformance_test.

export_file(
    name = "tiny_rest_xml.json",
    visibility = ["PUBLIC"],
)

aws_client(
    name = "komira_aws_tiny_xml",
    customizations = ["s3"],
    mode = "pure",
    model = "tiny_rest_xml.json",
    model_sha256 = TINY_REST_XML.sha256,
    operations = [
        "GetBlob",
        "PutThing",
        "SetConfig",
    ],
    service = "tiny",
    test_srcs = ["test_tiny_rest_xml.mojo"],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_xml:komira_xml",
    ],
)
