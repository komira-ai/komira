load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library", "mojo_routes_proto_library")

# protoc-gen-mojo-routes over a fixture: the routes module of
# example/library/v1/library_service.proto (two services; see its comment),
# whose messages are generated from example/library/v1/library.proto into
# :komira_routes_fixture_messages. The routes library is gated by two welded
# tests:
#
# - test_routes_golden: the generated module, byte for byte, against
#   golden/library_service_routes.mojo.golden. To rewrite the golden, build
#   `:komira_routes_fixture_gen[library_service_routes.mojo]` and copy it.
# - test_routes_dispatch: the generated dispatchers driven with requests and
#   fake handlers: every RPC reached through each of its bindings, 405 for a
#   known path under another method with its methods in Allow, both services
#   behind one ComposedRoutes, an unknown JSON field or query parameter
#   refused with 400, path and query values bound by type, a handler raise
#   mapped by the handler.

mojo_proto_library(
    name = "komira_routes_fixture_messages",
    srcs = ["example/library/v1/library.proto"],
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
)

mojo_routes_proto_library(
    name = "komira_routes_fixture",
    srcs = ["example/library/v1/library_service.proto"],
    messages = ":komira_routes_fixture_messages",
    outs = ["library_service_routes.mojo"],
    proto_deps = [
        ":komira_routes_fixture_messages",
        "//tools/vendor/googleapis:api_http",
    ],
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_http_server:komira_http_server",
        "//src/komira_proto_codec:komira_proto_codec",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "test_routes_dispatch.mojo",
        "test_routes_golden.mojo",
    ],
    test_data = {
        "test_routes_golden.mojo": {
            "gen/library_service_routes.mojo": ":komira_routes_fixture_gen[library_service_routes.mojo]",
            "golden/library_service_routes.mojo.golden": "golden/library_service_routes.mojo.golden",
        },
    },
)
