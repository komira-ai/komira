load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/platforms:table.bzl", "pinned_kwargs", "row", "zig_strip_prefix")
load("@komira//tools/build/package:defs.bzl", "oci_base")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/mojo:toolchain.bzl", "conda_closure", "mojo_runtime", "zig_dist", "zig_exe")

# ---- Pinned inputs (linux x86_64 execution platform) -----------------------
# Each is a row pin of the platform table (tools/build/platforms/table.bzl):
# the URL and sha256 are stated there, once, with every other platform's.

# Static busybox: `sh` and the file utilities every action uses.
pinned_file(**pinned_kwargs("linux-x86_64", "busybox", visibility = ["PUBLIC"]))

# zig: the C link driver for `mojo build`, and the compiler for conda_unpack.
pinned_file(**pinned_kwargs("linux-x86_64", "zig"))

# The Mojo compiler package.
pinned_file(**pinned_kwargs("linux-x86_64", "mojo_compiler"))

# The C++ runtime the compiler links against (NEEDED libstdc++.so.6 and
# libgcc_s.so.1; newest symbol versions GLIBCXX_3.4.30, CXXABI_1.3.13,
# GCC_3.3, i.e. GCC 12 or newer). conda-forge, one matched pair: this
# libstdcxx build depends on exactly this libgcc build.
pinned_file(**pinned_kwargs("linux-x86_64", "libstdcxx"))

pinned_file(**pinned_kwargs("linux-x86_64", "libgcc", visibility = ["PUBLIC"]))

# The base of oci_image: distroless base-debian12 for linux/amd64, its
# digests in the linux-x86_64 row of the platform table (table.bzl).
oci_base(
    name = "distroless_base",
    visibility = ["PUBLIC"],
    **row("linux-x86_64")["oci_base"]
)

# ---- Unpacked by remote actions ---------------------------------------------

# Unpacking and copying run linux x86_64 binaries, so they state the linux
# execution platform's constraints. A toolchain's `exec_compatible_with`
# binds every target that uses it, so each Mojo target builds on the
# execution platform of the OS its toolchain states.

zig_dist(
    name = "zig",
    exec_compatible_with = LINUX_X86_64,
    archive = ":zig_linux_x86_64.tar.xz",
    busybox = ":busybox",
    strip_prefix = zig_strip_prefix("linux-x86_64"),
    visibility = ["PUBLIC"],
)

zig_exe(
    name = "conda_unpack",
    exec_compatible_with = LINUX_X86_64,
    src = "komira//tools/build/mojo:conda_unpack.zig",
    busybox = ":busybox",
    zig = ":zig",
    visibility = ["PUBLIC"],
)

conda_closure(
    name = "mojo_compiler",
    exec_compatible_with = LINUX_X86_64,
    libs = {
        "lib/libgcc_s.so.1": ":libgcc_15.3.0_linux-64.conda",
        "lib/libstdc++.so.6": ":libstdcxx_15.3.0_linux-64.conda",
    },
    package = ":" + pinned_kwargs("linux-x86_64", "mojo_compiler")["name"],
    unpacker = ":conda_unpack",
    visibility = ["PUBLIC"],
)

# What a built binary loads, read from the loader's own record of a run
# (tests//functional/runtime_libs:loader_trace, `run init <toolchain>/lib/...` lines).
# tools/build/tests/run_tests.sh fails if this list and that record disagree.
mojo_runtime(
    name = "mojo_runtime",
    exec_compatible_with = LINUX_X86_64,
    busybox = ":busybox",
    compiler = ":mojo_compiler",
    libs = [
        "libAsyncRTRuntimeGlobals.so",
        "libKGENCompilerRTShared.so",
        "libMSupportGlobals.so",
        "libgcc_s.so.1",
        "libstdc++.so.6",
    ],
    visibility = ["PUBLIC"],
)

# The Mojo toolchain built from these (`toolchains//:mojo`) is declared by `komira_mojo_toolchains` in
# defs.bzl, which komira_toolchains calls from the `toolchains` cell of the
# repository at the project root: tools/build/cells/toolchains/BUCK in a standalone checkout.

# ---- C/C++ -----------------------------------------------------------------

# The compiler driver of the C/C++ toolchain (komira_cxx_toolchains in
# defs.bzl): runs zig's clang, flattening nested response files, which zig
# refuses.
zig_exe(
    name = "zig_cc_launcher",
    exec_compatible_with = LINUX_X86_64,
    src = "komira//tools/build/mojo:zig_cc_launcher.zig",
    busybox = ":busybox",
    zig = ":zig",
    visibility = ["PUBLIC"],
)

# The C++ standard library for C++ code linked into a Mojo binary: zig's
# libc++ and libc++abi, built by zig for the link's target and linked
# statically. A `cxx_library` with C++ sources lists this in
# `exported_deps`; the Mojo rules then pass `-lc++` to the link.
cxx_library(
    name = "libcxx",
    exported_linker_flags = ["-lc++"],
    visibility = ["PUBLIC"],
)
