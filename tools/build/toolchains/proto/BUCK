load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/platforms:table.bzl", "pinned_kwargs")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/mojo:proto.bzl", "protoc_dist")

# protoc 29.1, the release build for linux x86_64 (a static executable),
# with the well-known-type .proto files under include/.
pinned_file(**pinned_kwargs("linux-x86_64", "protoc"))

protoc_dist(
    name = "protoc",
    exec_compatible_with = LINUX_X86_64,
    archive = ":protoc-29.1-linux-x86_64.zip",
    busybox = "komira//tools/build/toolchains:busybox",
    visibility = ["PUBLIC"],
)

# The toolchain of mojo_proto_library, `toolchains//:mojo_proto` (protoc and
# the plugin), is declared by komira_proto_toolchains() in ../defs.bzl,
# which komira_toolchains() calls in the root repository's `toolchains` cell.
