load("@komira//tools/build/platforms:defs.bzl", "DARWIN_ARM64", "LINUX_X86_64", "darwin_macos_hosts")
load("@komira//tools/build/platforms:table.bzl", "os_floor_version", "pinned_kwargs", "row")
load("@komira//tools/build/mojo:darwin.bzl", "dyld_script", "mojo_darwin_toolchain")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/mojo:toolchain.bzl", "conda_closure", "mojo_runtime")

# Every target below except the pinned download exists for darwin-arm64 only,
# so each states it: a wildcard (`buck2 build toolchains//...`) on a checkout
# with no macOS platform configured skips them instead of analysing them.

# ---- Pinned inputs (macOS arm64 execution platform) --------------------------

# The Mojo compiler package, osx-arm64 build of the same release as the linux
# one. Its binaries need only the operating system: every load command names
# @rpath/ (its own lib/), /usr/lib or /System, and the minimum OS is 11.0.
pinned_file(**pinned_kwargs("darwin-arm64", "mojo_compiler"))

# liblz4 (conda-forge lz4-c), which komira_lz4 opens at run time by the name
# `liblz4.dylib`. macOS ships no liblz4 (on linux the worker's loader finds
# `liblz4.so.1`), so the compiler closure's lib/ carries it below: that
# directory is what the gate puts on DYLD_LIBRARY_PATH for every gated test.
# It loads only /usr/lib/libSystem.B.dylib.
pinned_file(**pinned_kwargs("darwin-arm64", "liblz4"))

# ---- Unpacked by linux actions ------------------------------------------------

# Unpacking moves bytes only, so it runs on the linux execution platform,
# with the same static unpacker as the linux toolchain. bin/lld is not kept: links
# go through the cc on PATH (the compile wrapper's `cc` mode, the host's
# cc and ld), as they do on linux, although modular.cfg names bin/lld in
# `lld_path`. Measured on the macOS workers (2026-09-29): a cc that exits 7
# fails the link of //tools/build/examples:hello.
conda_closure(
    name = "mojo_compiler",
    exec_compatible_with = LINUX_X86_64,
    target_compatible_with = DARWIN_ARM64,  # komira-limit:darwin-mojo-compiler
    libs = {
        "lib/liblz4.dylib": ":" + pinned_kwargs("darwin-arm64", "liblz4")["name"],
    },
    package = ":mojo_compiler_1.0.0_osx-arm64.conda",
    unpacker = "komira//tools/build/toolchains:conda_unpack",
    visibility = ["PUBLIC"],
)

# What a built binary loads: the compiler's three runtime libraries, and
# liblz4 (above), which komira_lz4 opens at run time. Everything else it loads
# (libc++, libSystem, frameworks) is the operating system's. The list is
# every .dylib of the closure's lib/ (functional/darwin/check.sh).
mojo_runtime(
    name = "mojo_runtime",
    exec_compatible_with = LINUX_X86_64,
    busybox = "komira//tools/build/toolchains:busybox",
    compiler = ":mojo_compiler",
    target_compatible_with = DARWIN_ARM64,  # komira-limit:darwin-mojo-runtime
    libs = [
        "libAsyncRTRuntimeGlobals.dylib",
        "libKGENCompilerRTShared.dylib",
        "libMSupportGlobals.dylib",
        "liblz4.dylib",
    ],
    visibility = ["PUBLIC"],
)

# MojoToolchainInfo requires a `launcher` (launch.sh: starts a built binary
# from outside its runnable directory, pointing the loader at the compiler's
# lib/). No rule in this repository consumes it yet, on either platform; the
# macOS toolchain carries the macOS form, DYLD_LIBRARY_PATH instead of
# LD_LIBRARY_PATH, so that the field is right wherever it is read. Nothing
# builds it unless asked (functional/darwin/check.sh does).
dyld_script(
    name = "launcher",
    exec_compatible_with = LINUX_X86_64,
    busybox = "komira//tools/build/toolchains:busybox",
    prelude = "komira//tools/build/mojo/darwin:dyld_prelude.sh",
    src = "komira//tools/build/mojo:launch.sh",
    target_compatible_with = DARWIN_ARM64,  # komira-limit:darwin-launcher
)

# The toolchain of darwin-arm64 targets (selected by toolchains//:mojo).
mojo_darwin_toolchain(
    name = "mojo",
    exec_compatible_with = DARWIN_ARM64,
    target_compatible_with = DARWIN_ARM64,  # komira-limit:darwin-mojo
    busybox = "komira//tools/build/mojo/darwin:busybox.sh",
    compiler = ":mojo_compiler",
    # Matches the compiler's own minimum OS.
    deployment_target = os_floor_version("darwin-arm64"),
    gate = "komira//tools/build/run:gate_darwin",
    launcher = ":launcher",
    # The host identities a compile may run on (`[komira_re] darwin_macos_hosts`
    # of the root cell; see DARWIN_HOSTS_KEY in platforms/defs.bzl). Unset,
    # analysing this toolchain for darwin-arm64 fails naming that key; nothing
    # needs it then, since no macOS execution platform is registered either.
    macos_hosts = darwin_macos_hosts(),
    runtime = ":mojo_runtime",
    # Every compile targets this CPU, whatever worker runs it: the first Apple
    # silicon generation, so a built binary runs on every Apple silicon Mac.
    target_cpu = row("darwin-arm64")["target_cpu"],
    visibility = ["PUBLIC"],
)
