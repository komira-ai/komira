load("@komira//tools/build/platforms:defs.bzl", "darwin_macos_sdk")
load("@komira//tools/build/mojo:darwin.bzl", "dyld_script", "mojo_darwin_link", "mojo_darwin_toolchain")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/mojo:toolchain.bzl", "conda_closure", "mojo_runtime")

# ---- Pinned inputs (macOS arm64 execution platform) --------------------------

# The Mojo compiler package, osx-arm64 build of the same release as the linux
# one. Its binaries need only the operating system: every load command names
# @rpath/ (its own lib/), /usr/lib or /System, and the minimum OS is 11.0.
pinned_file(
    name = "mojo_compiler_1.0.0_osx-arm64.conda",
    url = "https://conda.modular.com/max-nightly/osx-arm64/mojo-compiler-1.0.0-release.conda",
    sha256 = "c52054bc444d851e5c38cc33e790fb011a1080470244aaa59351ac5056d08c59",
)

# ---- Unpacked by remote actions (on linux `light` workers) ------------------

# Unpacking moves bytes only, so it runs on the same linux workers, with the
# same static unpacker, as the linux toolchain. bin/lld is kept: the macOS
# compiler links with it (modular.cfg `lld_path`).
conda_closure(
    name = "mojo_compiler",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    keep = ["bin/lld"],
    package = ":mojo_compiler_1.0.0_osx-arm64.conda",
    unpacker = "komira//tools/build/toolchains:conda_unpack",
    visibility = ["PUBLIC"],
)

# What a built binary loads: the compiler's three runtime libraries. Everything
# else it loads (libc++, libSystem, frameworks) is the operating system's.
mojo_runtime(
    name = "mojo_runtime",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    busybox = "komira//tools/build/toolchains:busybox",
    compiler = ":mojo_compiler",
    libs = [
        "libAsyncRTRuntimeGlobals.dylib",
        "libKGENCompilerRTShared.dylib",
        "libMSupportGlobals.dylib",
    ],
    visibility = ["PUBLIC"],
)

dyld_script(
    name = "gate_runner",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    busybox = "komira//tools/build/toolchains:busybox",
    prelude = "komira//tools/build/mojo/darwin:dyld_prelude.sh",
    src = "komira//tools/build/mojo:gate_runner.sh",
)

dyld_script(
    name = "launcher",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    busybox = "komira//tools/build/toolchains:busybox",
    prelude = "komira//tools/build/mojo/darwin:dyld_prelude.sh",
    src = "komira//tools/build/mojo:launch.sh",
)

# The `cc` a compile finds on PATH, and the SDK version the macOS execution
# platform promises (`macos_sdk` in `[komira_re] darwin_mojo_compile_properties`
# of the root cell). Unset, analysing this target fails naming that key; nothing
# needs it then, since no macOS execution platform is registered either.
mojo_darwin_link(
    name = "link",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    cc = "komira//tools/build/mojo/darwin:cc",
    macos_sdk = darwin_macos_sdk(),
)

# The toolchain of darwin-arm64 targets (selected by toolchains//:mojo).
mojo_darwin_toolchain(
    name = "mojo",
    exec_compatible_with = [
        "komira//tools/build/platforms:mojo_compile",
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:arm64",
    ],
    target_compatible_with = [
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:arm64",
    ],
    busybox = "komira//tools/build/mojo/darwin:busybox.sh",
    compiler = ":mojo_compiler",
    # Matches the compiler's own minimum OS.
    deployment_target = "11.0",
    gate_runner = ":gate_runner",
    launcher = ":launcher",
    link = ":link",
    runtime = ":mojo_runtime",
    # Every compile targets this CPU, whatever worker runs it: the first Apple
    # silicon generation, so a built binary runs on every Apple silicon Mac.
    target_cpu = "apple-m1",
    visibility = ["PUBLIC"],
)
