load("@komira//tools/build/platforms:defs.bzl", "darwin_macos_hosts")
load("@komira//tools/build/mojo:darwin.bzl", "dyld_script", "mojo_darwin_link", "mojo_darwin_toolchain")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/mojo:toolchain.bzl", "conda_closure", "mojo_runtime")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

# Every target below except the pinned download exists for darwin-arm64 only,
# so each states it: a wildcard (`buck2 build toolchains//...`) on a checkout
# with no macOS platform configured skips them instead of analysing them.
_DARWIN = [
    "prelude//os/constraints:macos",
    "prelude//cpu/constraints:arm64",
]

# ---- Pinned inputs (macOS arm64 execution platform) --------------------------

# The Mojo compiler package, osx-arm64 build of the same release as the linux
# one. Its binaries need only the operating system: every load command names
# @rpath/ (its own lib/), /usr/lib or /System, and the minimum OS is 11.0.
pinned_file(
    name = "mojo_compiler_1.0.0_osx-arm64.conda",
    url = "https://conda.modular.com/max-nightly/osx-arm64/mojo-compiler-1.0.0-release.conda",
    sha256 = "c52054bc444d851e5c38cc33e790fb011a1080470244aaa59351ac5056d08c59",
)

# ---- Unpacked by remote actions (on linux `light` workers) ------------------

# Unpacking moves bytes only, so it runs on the same linux workers, with the
# same static unpacker, as the linux toolchain. bin/lld is not kept: links
# go through the cc on PATH (komira//tools/build/mojo/darwin:cc, the host's
# cc and ld), as they do on linux, although modular.cfg names bin/lld in
# `lld_path`. Measured on the macOS workers (2026-09-29): a cc that exits 7
# fails the link of //tools/build/examples:hello.
conda_closure(
    name = "mojo_compiler",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    target_compatible_with = _DARWIN,
    package = ":mojo_compiler_1.0.0_osx-arm64.conda",
    unpacker = "komira//tools/build/toolchains:conda_unpack",
    visibility = ["PUBLIC"],
)

# What a built binary loads: the compiler's three runtime libraries. Everything
# else it loads (libc++, libSystem, frameworks) is the operating system's.
mojo_runtime(
    name = "mojo_runtime",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    busybox = "komira//tools/build/toolchains:busybox",
    compiler = ":mojo_compiler",
    target_compatible_with = _DARWIN,
    libs = [
        "libAsyncRTRuntimeGlobals.dylib",
        "libKGENCompilerRTShared.dylib",
        "libMSupportGlobals.dylib",
    ],
    visibility = ["PUBLIC"],
)

dyld_script(
    name = "gate_runner",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    busybox = "komira//tools/build/toolchains:busybox",
    prelude = "komira//tools/build/mojo/darwin:dyld_prelude.sh",
    src = "komira//tools/build/mojo:gate_runner.sh",
    target_compatible_with = _DARWIN,
)

# MojoToolchainInfo requires a `launcher` (launch.sh: starts a built binary
# from outside its runnable directory, pointing the loader at the compiler's
# lib/). No rule in this repository consumes it yet, on either platform; the
# macOS toolchain carries the macOS form, DYLD_LIBRARY_PATH instead of
# LD_LIBRARY_PATH, so that the field is right wherever it is read. Nothing
# builds it unless asked (functional/darwin/check.sh does).
dyld_script(
    name = "launcher",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    busybox = "komira//tools/build/toolchains:busybox",
    prelude = "komira//tools/build/mojo/darwin:dyld_prelude.sh",
    src = "komira//tools/build/mojo:launch.sh",
    target_compatible_with = _DARWIN,
)

# The `cc` a compile finds on PATH, host_identity.sh, and the host identities
# a compile may run on (`[komira_re] darwin_macos_hosts` of the root cell;
# see DARWIN_HOSTS_KEY in platforms/defs.bzl). Unset, analysing this
# target for darwin-arm64 fails naming that key; nothing needs it then, since
# no macOS execution platform is registered either.
mojo_darwin_link(
    name = "link",
    exec_compatible_with = ["komira//tools/build/platforms:light"],
    target_compatible_with = _DARWIN,
    cc = "komira//tools/build/mojo/darwin:cc",
    host_identity = "komira//tools/build/mojo/darwin:host_identity.sh",
    macos_hosts = darwin_macos_hosts(),
)

# The toolchain of darwin-arm64 targets (selected by toolchains//:mojo).
mojo_darwin_toolchain(
    name = "mojo",
    exec_compatible_with = [
        "komira//tools/build/platforms:mojo_compile",
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:arm64",
    ],
    target_compatible_with = _DARWIN,
    busybox = "komira//tools/build/mojo/darwin:busybox.sh",
    compiler = ":mojo_compiler",
    # Matches the compiler's own minimum OS.
    deployment_target = "11.0",
    gate_runner = ":gate_runner",
    launcher = ":launcher",
    link = ":link",
    runtime = ":mojo_runtime",
    # Every compile targets this CPU, whatever worker runs it: the first Apple
    # silicon generation, so a built binary runs on every Apple silicon Mac.
    target_cpu = "apple-m1",
    visibility = ["PUBLIC"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["komira//:docs"],
)
