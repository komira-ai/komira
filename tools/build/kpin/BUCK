# kpin (README.md): pins.toml and the native lockfiles (package-lock.json v3)
# in, a generated pins.lock.bzl out; `update` is the one command that touches
# the network and never runs in a build action. A Zig tool, as every build tool
# under tools/build is; built behind its unit tests.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":selftest.bzl", "SELFTEST")

_SRCS = [
    "cargo.zig",
    "cargo_lock.zig",
    "cargo_trim.zig",
    "cargo_update.zig",
    "diag.zig",
    "fetch.zig",
    "lockfmt.zig",
    "main.zig",
    "npm.zig",
    "pins.zig",
    "resolve.zig",
    "toml.zig",
    "update.zig",
    "valid.zig",
]

# Test support, and the golden lock (which the load above also reads).
_SUPPORT = [
    "fixtures.zig",
    "registry.zig",
    "example.lock.bzl",
    "cargo_fixture/Cargo.lock",
    "cargo_fixture/expected.bzl",
    "cargo_fixture/metadata.json",
    "cargo_fixture/raw_metadata.json",
    "cargo_fixture/raw_weak_metadata.json",
    "cargo_fixture/overrides.json",
    "cargo_fixture/sizes.txt",
]

# Loading selftest.bzl is the test that the generated lock is Starlark Buck2
# loads and that pins.bzl reads it (the package fails to load otherwise).
_ = SELFTEST

# kpin builds with zig 0.15.2 (`:zig_next`): the std.http client of 0.12 cannot
# complete a TLS handshake with the registries kpin updates from. The rest of
# the tools stay on the zig of `:zig`. The executable is built behind the check
# that the pin is the release it names.
_ZIG = "komira//tools/build/toolchains:zig_next"
_ZIG_VERSION = "komira//tools/build/toolchains:zig_next_version"

# ---- Unit tests: `zig test` of each, run as a build action -------------------

[
    zig_test(
        name = name + "_unit",
        exec_compatible_with = LINUX_X86_64,
        src = name + "_test.zig",
        imports = _SRCS + _SUPPORT,
        busybox = "komira//tools/build/toolchains:busybox",
        zig = _ZIG,
    )
    for name in [
        "cargo",
        "cargo_update",
        "lockfmt",
        "main",
        "npm",
        "pins",
        "resolve",
        "toml",
        "update",
    ]
]

# The https client against a real TLS server on loopback (tls_test.zig): aws-lc's
# `bssl s_server` pinned to TLS 1.2 and to TLS 1.3, with the throwaway
# certificates of komira_http_core's tests. A validation, as it runs a built
# tool; kpin is built behind it.
zig_test(
    name = "tls_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "tls_test.zig",
    imports = ["fetch.zig"],
    data = {
        "fixtures/leaf_cert.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_cert.pem",
        "fixtures/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
        "fixtures/root_ca.pem": "//src/komira_http_core:tests/fixtures/tls/root_ca.pem",
        "fixtures/smoke_cert.pem": "//src/komira_http_core:tests/fixtures/smoke_cert.pem",
    },
    exec_tools = {"BSSL": "//third_party/aws-lc:bssl"},
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
)

# ---- The tool, built only when every unit test passed ------------------------

zig_exe(
    name = "kpin",
    exec_compatible_with = LINUX_X86_64,
    src = "main.zig",
    imports = _SRCS,
    unit_tests = [
        ":cargo_unit",
        ":cargo_update_unit",
        ":lockfmt_unit",
        ":main_unit",
        ":npm_unit",
        ":pins_unit",
        ":resolve_unit",
        ":toml_unit",
        ":tls_unit",
        ":update_unit",
        _ZIG_VERSION,
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)
