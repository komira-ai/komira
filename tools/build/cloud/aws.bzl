"""aws_client: an AWS client generated from a botocore service model at build time.

    load("@komira//third_party/botocore:models.bzl", "botocore_model")

    aws_client(
        name = "komira_aws_logs",
        model = botocore_model("logs").model,
        model_sha256 = botocore_model("logs").sha256,
        operations = ["GetLogEvents"],
        mode = "pure",                  # or "client"
        # optional; set both or neither
        endpoint_rules = botocore_model("logs").endpoint_rules,
        partitions = botocore_model("logs").partitions,
        deps = [
            "komira//src/komira_aws_core:komira_aws_core",
            "komira//src/komira_json:komira_json",
        ],
    )

is two targets:

  * `<name>_gen`, the generation action: komira//tools/build/proto-codegen:
    aws-client-gen writes `gen/<name>/` with `__init__.mojo`, the module
    `<name>.mojo` and `_layout_probe.mojo` (one `size_of` per emitted
    struct), plus a copy of each `hand_srcs` file. Nothing is compiled
    there.
  * `<name>`, an ordinary `mojo_library` over those files, so the client is
    welded exactly like a hand-written library: its `test_srcs` gate its
    `.mojoc`. The layout probe is its first test (a generated `test_srcs`
    entry), followed by the caller's. `<name>[gen]` is the generated
    directory (the `gen` attr of mojo_library); `<name>[gen][<file>]` one
    file of it. The client is imported as `<name>.<name>`.

Model. `model` is one botocore `service-2.json`, normally
`botocore_model("<service>").model` of //third_party/botocore, and
`model_sha256` its digest (`botocore_model("<service>").sha256`); the
generator refuses a model whose bytes have another digest. The botocore
service id is read from the model's path (`<service>/<api version>/
service-2.json`, botocore's data layout) unless `service` names it.

Scope. `operations` is required and non-empty, checked at analysis: the
generator is operation-scoped and emits only the closure of the operations
named. Each entry is one botocore operation name (`GetLogEvents`); an entry
holding `,` (the generator's list separator), whitespace or anything else is
refused here rather than mis-split. An operation the model does not declare
is refused by the generator, in the build.

Mode. `pure` emits the shapes and `build_<op>_request` / `parse_<op>_response`
with no transport (`--pure-only`); `client` adds the signed-send surface,
which imports the komira_aws_core transport names and komira_http.

Endpoints. `endpoint_rules` is the service's botocore endpoint ruleset
(`endpoint-rule-set-1.json`, normally `botocore_model("<service>")
.endpoint_rules`) and `partitions` the partition table it reads
(`botocore_model("<service>").partitions`); the two are set together or not
at all. With them the module embeds both and resolves each operation's
endpoint through `komira_aws_core.EndpointRuleSet`: a `<Prefix>EndpointConfig`
holding the ruleset's built-in and client context parameters, and a
`resolve_<op>_endpoint` binding the operation's context parameters. The
generator refuses a binding the ruleset does not declare. Without them, the
module's header lists the endpoint bindings of the model it does not apply.

Overrides. `overrides` is the generator's hand-override manifest (a JSON
file naming, per operation, the hand-written owner of its plain verb), and
`hand_srcs` the hand-written `.mojo` modules that own them: the generator
checks each named owner exists in them, and they are copied into the
package next to the generated module. Each needs the other.

Runtime. `deps` is required and non-empty, and nothing is added to it: the
generated code imports its runtime (komira_aws_core, komira_json, and in
client mode komira_http), which the caller names as `komira//`
labels, or as stubs in a test. They are the library's `deps`, so they take
what `mojo_library.deps` takes; `<name>_gen` sees only their count.

Every refusal of the rule happens at analysis, in `<name>_gen`, so a BUCK
file with one wrong aws_client still loads.
"""

load("@komira//tools/build/lint:doc_tree.bzl", "declares_docs")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The generated layout probe's file name (as emit.rs's LAYOUT_PROBE_FILE for
# the proto plugin), and the generator's list separator for --operations
# (main_aws_client.rs splits on it).
_LAYOUT_PROBE = "_layout_probe.mojo"
_LIST_SEPARATOR = ","

_GEN_SCRIPT = """
# $1 busybox, $2 generator, $3 output package directory, $4 module name;
# $5 number of hand sources, then those; then the generator's arguments.
BB="$1"; GEN="$2"; OUT="$3"; MOD="$4"; N="$5"; shift 5
case "$BB" in /*) ;; *) BB="$PWD/$BB" ;; esac
case "$GEN" in /*) ;; *) GEN="$PWD/$GEN" ;; esac
"$BB" mkdir -p "$OUT"
HAND=""
while [ "$N" -gt 0 ]; do
    HAND="$HAND $1"
    shift; N=$((N - 1))
done
"$GEN" --module "$MOD" --out "$OUT/$MOD.mojo" --probe-out "$OUT/_layout_probe.mojo" "$@"
printf '%s\\n' '# Generated by aws_client (tools/build/cloud/aws.bzl): the package of the' \\
    '# module generated from this target'"'"'s botocore model. Do not edit.' > "$OUT/__init__.mojo"
n=3
for h in $HAND; do
    "$BB" cp "$h" "$OUT/"
    n=$((n + 1))
done
# Exactly the expected files, none empty: an empty module is a silent
# generator failure, and an unexpected one would not be compiled.
for f in "$MOD.mojo" _layout_probe.mojo; do
    if [ ! -s "$OUT/$f" ]; then
        echo "aws-client-gen wrote no code (or an empty file) for the expected $f" >&2
        exit 1
    fi
done
if [ "$("$BB" ls -A "$OUT" | "$BB" wc -l)" != "$n" ]; then
    echo "aws_client: the generated package holds files that were not declared:" >&2
    "$BB" ls -A "$OUT" >&2
    exit 1
fi
"""

def _basename(path):
    return path.rsplit("/", 1)[-1]

def _service_of(ctx):
    if ctx.attrs.service:
        if not regex_match("^[a-z0-9][a-z0-9-]*$", ctx.attrs.service):
            fail("{}: `service` `{}` is not a botocore service id".format(ctx.label, ctx.attrs.service))
        return ctx.attrs.service
    parts = ctx.attrs.model.short_path.split("/")
    if len(parts) < 3 or parts[-1] != "service-2.json" or not regex_match("^[a-z0-9][a-z0-9-]*$", parts[-3]):
        fail("{}: the botocore service id cannot be read from the model path `{}` (botocore's layout is `<service>/<api version>/service-2.json`); set `service`".format(ctx.label, ctx.attrs.model.short_path))
    return parts[-3]

def _aws_client_gen_impl(ctx):
    import_name = ctx.attrs.import_name
    if not regex_match("^[A-Za-z_][A-Za-z0-9_]*$", import_name):
        fail("{}: import name `{}` is not a Mojo identifier".format(ctx.label, import_name))
    if not ctx.attrs.operations:
        fail("{}: `operations` is empty. An aws_client generates the operations it names, never a whole service: list the botocore operations the client calls".format(ctx.label))
    seen = {}
    for op in ctx.attrs.operations:
        if not regex_match("^[A-Za-z][A-Za-z0-9]*$", op):
            fail("{}: `operations` entry `{}` is not a botocore operation name (`GetLogEvents`); entries are separate list items, never joined with `{}`".format(ctx.label, op, _LIST_SEPARATOR))
        if op in seen:
            fail("{}: `operations` names `{}` twice".format(ctx.label, op))
        seen[op] = True
    if ctx.attrs.runtime_dep_count == 0:
        fail("{}: `deps` is empty. The generated code imports its runtime (komira_aws_core, komira_json, and in client mode komira_http); name it, as komira// labels. No runtime is added by default.".format(ctx.label))
    if ctx.attrs.overrides and not ctx.attrs.hand_srcs:
        fail("{}: `overrides` is set and `hand_srcs` is empty: the manifest names hand-written owners, and they are its `hand_srcs`".format(ctx.label))
    if ctx.attrs.hand_srcs and not ctx.attrs.overrides:
        fail("{}: `hand_srcs` is set and `overrides` is not: hand-written modules of an aws_client own the operations its overrides manifest names".format(ctx.label))
    if (ctx.attrs.endpoint_rules == None) != (ctx.attrs.partitions == None):
        fail("{}: `endpoint_rules` and `partitions` are set together: the ruleset's aws.partition reads the partition table".format(ctx.label))
    reserved = {"__init__.mojo": True, _LAYOUT_PROBE: True, import_name + ".mojo": True}
    for p in ctx.attrs.hand_src_paths:
        if ":" in p or not p.endswith(".mojo"):
            fail("{}: `hand_srcs` entry `{}` is not a source path of a `.mojo` file. `hand_srcs` takes source paths only, never a label: the library's file names are derived from these paths".format(ctx.label, p))
        b = _basename(p)
        if b in reserved:
            fail("{}: `hand_srcs` entry `{}` has the name of a generated or another hand-written file, `{}`".format(ctx.label, p, b))
        reserved[b] = True

    gen_args = [
        "--model",
        ctx.attrs.model,
        "--model-sha256",
        ctx.attrs.model_sha256,
        "--service",
        _service_of(ctx),
        "--operations",
        _LIST_SEPARATOR.join(ctx.attrs.operations),
        "--probe-import",
        import_name + "." + import_name,
    ]
    if ctx.attrs.mode == "pure":
        gen_args.append("--pure-only")
    if ctx.attrs.endpoint_rules:
        gen_args += ["--endpoint-rules", ctx.attrs.endpoint_rules, "--partitions", ctx.attrs.partitions]
    if ctx.attrs.overrides:
        gen_args += ["--overrides", ctx.attrs.overrides]
        for h in ctx.attrs.hand_srcs:
            gen_args += ["--hand-src", h]

    bb = ctx.attrs._busybox[DefaultInfo].default_outputs[0]
    gen = ctx.attrs._gen[DefaultInfo].default_outputs[0]

    # One directory output: every file of a package must share one
    # directory, and separately declared outputs need not.
    gen_dir = ctx.actions.declare_output("gen/" + import_name, dir = True)
    ctx.actions.run(
        cmd_args(
            bb,
            "sh",
            "-euc",
            _GEN_SCRIPT,
            "sh",
            bb,
            gen,
            gen_dir.as_output(),
            import_name,
            str(len(ctx.attrs.hand_srcs)),
            ctx.attrs.hand_srcs,
            gen_args,
        ),
        category = "aws_client_gen",
    )

    files = ["__init__.mojo", import_name + ".mojo", _LAYOUT_PROBE] + [h.basename for h in ctx.attrs.hand_srcs]
    return [DefaultInfo(
        default_output = gen_dir,
        sub_targets = {f: [DefaultInfo(default_output = gen_dir.project(f))] for f in files},
    )]

_aws_client_gen = rule(
    impl = _aws_client_gen_impl,
    attrs = {
        "endpoint_rules": attrs.option(attrs.source(), default = None),
        "hand_src_paths": attrs.list(attrs.string(), default = []),
        "hand_srcs": attrs.list(attrs.source(), default = []),
        "import_name": attrs.string(),
        "mode": attrs.enum(["pure", "client"]),
        "model": attrs.source(),
        "model_sha256": attrs.string(),
        "operations": attrs.list(attrs.string()),
        "overrides": attrs.option(attrs.source(), default = None),
        "partitions": attrs.option(attrs.source(), default = None),
        # `len(deps)` of the library, so an empty runtime is refused at
        # analysis. A count, not the labels: the generator has no edge to the
        # runtime, and `deps` keeps every kind `mojo_library.deps` accepts.
        "runtime_dep_count": attrs.int(),
        "service": attrs.option(attrs.string(), default = None),
        "_busybox": attrs.exec_dep(default = "komira//tools/build/toolchains:busybox"),
        "_gen": attrs.exec_dep(default = "komira//tools/build/proto-codegen:aws-client-gen"),
    },
)

def _aws_client(
        name,
        model,
        model_sha256,
        operations,
        deps,
        mode = "pure",
        service = None,
        endpoint_rules = None,
        partitions = None,
        overrides = None,
        hand_srcs = [],
        test_srcs = [],
        visibility = None,
        **kwargs):
    """See the module docstring. `kwargs` go to the mojo_library (test_data, test_env)."""
    gen = name + "_gen"
    vis = {"visibility": visibility} if visibility != None else {}
    _aws_client_gen(
        name = gen,
        endpoint_rules = endpoint_rules,
        partitions = partitions,
        hand_src_paths = hand_srcs,
        hand_srcs = hand_srcs,
        import_name = name,
        mode = mode,
        model = model,
        model_sha256 = model_sha256,
        operations = operations,
        overrides = overrides,
        runtime_dep_count = len(deps),
        service = service,
        **vis
    )

    # The file names the generation action is held to (it refuses a missing,
    # empty or extra file), so they can be named here. A hand_srcs entry that
    # is not a `.mojo` path is left out rather than turned into a sub-target
    # name: `<name>_gen` refuses it, and that refusal is what the build
    # reports.
    hand = [_basename(h) for h in hand_srcs if h.endswith(".mojo") and ":" not in h]
    srcs = [":{}[{}]".format(gen, f) for f in ["__init__.mojo", name + ".mojo"] + hand]
    mojo_library(
        name = name,
        srcs = srcs,
        deps = deps,
        gen = ":" + gen,
        test_srcs = [":{}[{}]".format(gen, _LAYOUT_PROBE)] + test_srcs,
        **(vis | kwargs)
    )

aws_client = declares_docs(_aws_client)
