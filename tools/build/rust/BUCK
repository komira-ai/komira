load("@komira//tools/build/lint:defs.bzl", "doc_tree", "shell_lint")

# Scripts used by the Rust rules.
export_file(name = "rustc_wrapper.sh", visibility = ["PUBLIC"])

# A validation of the Rust toolchain (defs.bzl).
shell_lint(
    name = "shell_lint",
    srcs = ["rustc_wrapper.sh"],
    visibility = ["PUBLIC"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["komira//:docs"],
)
