load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# The compile launcher of every rustc action (rustc_launch.zig): the sysroot,
# the zig linker shim, a fixed environment and the output checks. Built behind
# its unit tests; its process cases (the environment, the exit statuses, the
# shim) are tests//functional/rustc_launch.
zig_test(
    name = "rustc_launch_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "rustc_launch_test.zig",
    imports = ["rustc_launch.zig"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "rustc_launch",
    exec_compatible_with = LINUX_X86_64,
    src = "rustc_launch.zig",
    unit_tests = [":rustc_launch_unit", "komira//tools/build/toolchains:zig_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# crate_patch (crate_patch.zig): the `patch` attribute of the Rust rules, run
# in a build action. A Zig tool, built behind its unit tests like every tool
# under tools/build.
zig_test(
    name = "crate_patch_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "crate_patch.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "crate_patch",
    exec_compatible_with = LINUX_X86_64,
    src = "crate_patch.zig",
    unit_tests = [":crate_patch_unit", "komira//tools/build/toolchains:zig_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# rust_sysroot (rust_sysroot.zig): the `rust_sysroot` rule's unpack of the
# rustc and rust-std release tarballs into the sysroot the Rust rules compile
# with. A Zig tool, built behind its unit tests.
zig_test(
    name = "rust_sysroot_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "rust_sysroot_test.zig",
    imports = ["rust_sysroot.zig"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
