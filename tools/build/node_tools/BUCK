# node_tools (README.md): the program the node_modules rules run
# (tools/build/node/modules.bzl): node_modules from a package-lock.json and
# pinned tarballs, and a program of node_modules run by the pinned node over a
# copy of a source tree. A Zig tool, as every build tool under tools/build is;
# built behind its unit tests.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# Built with zig 0.15.2 (`:zig_next`); the executables are built behind the check
# that the pin is that release.
_ZIG = "komira//tools/build/toolchains:zig_next"
_ZIG_VERSION = "komira//tools/build/toolchains:zig_next_version"

_SRCS = [
    "layout.zig",
    "main.zig",
    "platform.zig",
    "runner.zig",
    "sri.zig",
    "unpack.zig",
]

_SUPPORT = ["tartest.zig"]

[
    zig_test(
        name = name + "_unit",
        exec_compatible_with = LINUX_X86_64,
        src = name + "_test.zig",
        imports = _SRCS + _SUPPORT,
        busybox = "komira//tools/build/toolchains:busybox",
        zig = _ZIG,
    )
    for name in [
        "layout",
        "platform",
        "runner",
        "sri",
        "unpack",
    ]
]

zig_exe(
    name = "node_tools",
    exec_compatible_with = LINUX_X86_64,
    src = "main.zig",
    imports = _SRCS,
    unit_tests = [
        ":layout_unit",
        ":platform_unit",
        ":runner_unit",
        ":sri_unit",
        ":unpack_unit",
        _ZIG_VERSION,
    ],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)
