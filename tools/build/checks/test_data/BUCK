load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_test")
load(":runner_cases.bzl", "mojo_gate_runner_cases")

# The checks of the test runtime contract. They use only the standard library:
# komira_runtime_paths is exercised by its own gate test in the komira cell,
# because a checks-cell target cannot depend on a komira-cell mojo_library
# (Buck2 gives the MojoPkgTSet a distinct identity per loading cell).
# The contract is in tools/build/mojo/README.md ("Test data, environment and
# scratch"). tools/build/checks/run_checks.sh builds each target and requires
# the verdict written above it.

_SRCS = [
    "__init__.mojo",
    "value.mojo",
]

# GREEN: a list entry is staged at its path from the cell root and opens by
# that relative path; two tests each get a private, empty TEST_TMPDIR; the
# library's test_env reaches both.
mojo_library(
    name = "declared",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = [
        "tests/test_reads_declared.mojo",
        "tests/test_env_and_tmp.mojo",
        "tests/test_env_and_tmp_twin.mojo",
    ],
    test_data = {
        "tests/test_reads_declared.mojo": ["fixtures/declared.txt"],
    },
    test_env = {"TD_MODE": "checks"},
)

# RED (GATED TEST FAILED): the test opens a repository file it did not declare.
mojo_library(
    name = "undeclared",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_undeclared.mojo"],
    test_data = {
        "tests/test_reads_undeclared.mojo": ["fixtures/declared.txt"],
    },
)

# GREEN under `buck2 test`: a mojo_test with dict data and env.
mojo_test(
    name = "mojo_test_data",
    srcs = ["tests/test_mojo_test_data.mojo"],
    data = {"staged/as.txt": "fixtures/declared.txt"},
    env = {"TD_MODE": "mojo_test"},
)

# RED (GATED TEST FAILED): a test's env reaches the test only, never the
# runner's own variables, so naming one of them cannot mute a red test.
mojo_library(
    name = "env_held",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_red.mojo"],
    test_env = {"HELD": "1"},
)

# RED under `buck2 test`: env {"BIN": "true"} does not run `true` in place of
# the test.
mojo_test(
    name = "env_bin",
    srcs = ["tests/test_red.mojo"],
    env = {"BIN": "true"},
)

# The runner itself, in one action directory (runner_cases.sh): two runs get
# two TEST_TMPDIRs, each empty, under the action directory and gone after the
# run; --env HELD / BIN / rc cannot turn a red test green; a held red is HELD.
mojo_gate_runner_cases(
    name = "runner_cases",
    script = "runner_cases.sh",
)

# Refused at analysis, each with its own message.
mojo_library(
    name = "bad_dest",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_data = {"tests/test_reads_declared.mojo": {"../escape.txt": "fixtures/declared.txt"}},
)

mojo_library(
    name = "bad_dest_clash",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_data = {"tests/test_reads_declared.mojo": {
        "a": "fixtures/declared.txt",
        "a/b.txt": "fixtures/declared.txt",
    }},
)

mojo_library(
    name = "bad_data_entry",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_data = {"tests/test_nope.mojo": ["fixtures/declared.txt"]},
)

mojo_library(
    name = "bad_env_owned",
    srcs = _SRCS,
    import_name = "tdlib",
    test_srcs = ["tests/test_reads_declared.mojo"],
    test_env = {"TEST_TMPDIR": "/tmp"},
)

mojo_test(
    name = "bad_env_name",
    srcs = ["tests/test_mojo_test_data.mojo"],
    env = {"NOT-A-NAME": "x"},
)

shell_lint(
    name = "shell_lint",
    srcs = ["runner_cases.sh"],
    visibility = ["komira//:checks_lints"],
)
