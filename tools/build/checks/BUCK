# The client-side check scripts of this cell (run_checks.sh and the scripts it
# runs). `//...` does not reach into this cell, so //:checks_lints (the
# root BUCK) names this lint and the other shell lints of the cell, and
# `./buck2 build //...` runs them.
load("@komira//tools/build/lint:defs.bzl", "shell_lint")

shell_lint(
    name = "shell_lint",
    srcs = glob(["*.sh"]),
    excludes = {
        # The audited target list is split into arguments on purpose.
        "run_checks.sh": "SC2046",
    },
    visibility = ["komira//:checks_lints"],
)
