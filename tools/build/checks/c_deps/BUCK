load("@komira//tools/build/mojo:defs.bzl", "mojo_binary")

# Calls komira_example_add (C) with the C library in `deps`: links.
mojo_binary(
    name = "c_linked",
    srcs = ["main.mojo"],
    deps = ["komira//tools/build/examples/cshim:add"],
    expected_stdout = "42\n",
)

# The same program without it: the link fails on the undefined symbol,
# nothing on the worker supplies it.
mojo_binary(
    name = "c_missing",
    srcs = ["main.mojo"],
)

# `deps` names a target that is neither a Mojo package nor a C/C++ library.
export_file(name = "not_a_library", src = "main.mojo")

mojo_binary(
    name = "bad_dep",
    srcs = ["main.mojo"],
    deps = [":not_a_library"],
)
