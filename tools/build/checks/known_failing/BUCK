load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The checks of mojo_library's `tests_known_failing` (a hold that inverts: the
# held test still runs and must FAIL). tools/build/checks/run_checks.sh builds
# each target and requires the verdict written above it.

_SRCS = [
    "__init__.mojo",
    "value.mojo",
]

# GREEN: the held test fails as its row says, the other test passes.
mojo_library(
    name = "held_ok",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = [
        "tests/test_passes.mojo",
        "tests/test_fails.mojo",
    ],
    tests_known_failing = {
        "tests/test_fails.mojo": {
            "issue": "#1",
            "reason": "fixture: test_fails raises whenever answer() is 42, which it always is.",
        },
    },
)

# RED (LEDGER STALE): the held test passes, so its row must go.
mojo_library(
    name = "held_passing",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = [
        "tests/test_passes.mojo",
        "tests/test_passes_too.mojo",
    ],
    tests_known_failing = {
        "tests/test_passes_too.mojo": {
            "issue": "https://github.com/komira-ai/komira/issues/1",
            "reason": "fixture: held, but test_passes_too passes; the row is stale.",
        },
    },
)

# RED (GATED TEST FAILED): a hold on one red test excuses no other.
mojo_library(
    name = "unheld_red",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = [
        "tests/test_passes.mojo",
        "tests/test_fails.mojo",
        "tests/test_fails_too.mojo",
    ],
    tests_known_failing = {
        "tests/test_fails.mojo": {
            "issue": "1",
            "reason": "fixture: test_fails is held; test_fails_too is not.",
        },
    },
)

# RED at analysis, before any action: each row below is inadmissible.
mojo_library(
    name = "bad_no_issue",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = ["tests/test_passes.mojo", "tests/test_fails.mojo"],
    tests_known_failing = {"tests/test_fails.mojo": {"reason": "fixture: no issue."}},
)

mojo_library(
    name = "bad_issue_ref",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = ["tests/test_passes.mojo", "tests/test_fails.mojo"],
    # A tracker key that is not a GitHub issue reference.
    tests_known_failing = {"tests/test_fails.mojo": {"issue": "PROJ-12", "reason": "fixture: not an issue ref."}},
)

mojo_library(
    name = "bad_empty_reason",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = ["tests/test_passes.mojo", "tests/test_fails.mojo"],
    tests_known_failing = {"tests/test_fails.mojo": {"issue": "1", "reason": "  "}},
)

mojo_library(
    name = "bad_entry",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = ["tests/test_passes.mojo", "tests/test_fails.mojo"],
    tests_known_failing = {"tests/test_nope.mojo": {"issue": "1", "reason": "fixture: no such test."}},
)

mojo_library(
    name = "bad_field",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = ["tests/test_passes.mojo", "tests/test_fails.mojo"],
    tests_known_failing = {"tests/test_fails.mojo": {"issue": "1", "reason": "fixture: extra field.", "card": "x"}},
)

mojo_library(
    name = "bad_same_reason",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = ["tests/test_passes.mojo", "tests/test_fails.mojo", "tests/test_fails_too.mojo"],
    tests_known_failing = {
        "tests/test_fails.mojo": {"issue": "1", "reason": "fixture: pasted reason."},
        "tests/test_fails_too.mojo": {"issue": "2", "reason": "fixture: pasted reason."},
    },
)

mojo_library(
    name = "bad_all_held",
    srcs = _SRCS,
    import_name = "kflib",
    test_srcs = ["tests/test_fails.mojo", "tests/test_fails_too.mojo"],
    tests_known_failing = {
        "tests/test_fails.mojo": {"issue": "1", "reason": "fixture: held, one."},
        "tests/test_fails_too.mojo": {"issue": "2", "reason": "fixture: held, two."},
    },
)
