load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load(":cases.bzl", "darwin_properties_cases")

# Fails loading this package if `darwin_properties_refusal` gets any case in
# cases.bzl wrong (checks/darwin/check.sh runs `buck2 targets checks//darwin:`).
darwin_properties_cases()

load(":census.bzl", "darwin_host_census")

# The host identities the macOS workers report (see census.bzl). Only for
# `--target-platforms komira//tools/build/platforms:darwin-arm64`.
darwin_host_census(
    name = "host_census",
    target_compatible_with = ["prelude//os/constraints:macos"],
)

shell_lint(
    name = "shell_lint",
    srcs = ["check.sh"],
)
