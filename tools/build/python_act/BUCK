load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# python_act (python_act.zig): the action of `python_dist` (tools/build/python)
# in place of its busybox script. It lives beside, not in, that package: Python
# serves only the Python surface (//:python_closure). Built behind its unit tests; its process cases are
# tests//functional/python_act.
zig_test(
    name = "python_act_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "python_act_test.zig",
    imports = ["python_act.zig"],
    deps = ["//tools/build/act_util:act_util"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
)

zig_exe(
    name = "python_act",
    exec_compatible_with = LINUX_X86_64,
    src = "python_act.zig",
    deps = ["//tools/build/act_util:act_util"],
    unit_tests = [":python_act_unit", "komira//tools/build/toolchains:zig_next_version"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)
