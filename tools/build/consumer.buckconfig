# The .buckconfig of a repository that builds Mojo with komira's rules, with
# komira fetched as a git external cell. Copy it to your repository's root as
# `.buckconfig`, set `git_origin` and `commit_hash`, and put your
# remote-execution endpoints and `[komira_re]` worker properties in
# `.buckconfig.local` (see komira's .buckconfig.local.example). Without
# them every action runs on your machine.
#
# To mount komira as a git submodule instead, set `komira` in `[cells]` to the
# submodule's path, and delete the `komira = git` line and the
# `[external_cell_komira]` section.
#
# The whole komira repository is one cell, `komira`: the rules load from
# komira//tools/build/mojo, the platforms from komira//tools/build/platforms.
# Two directories are yours, copied from komira:
#   toolchains/BUCK  from tools/build/cells/toolchains/BUCK. The `toolchains`
#                    cell belongs to the root repository (the prelude requires
#                    one); the Mojo rules take their toolchain from its `mojo`
#                    target.
#   platforms/BUCK   from tools/build/platforms/default/BUCK: your execution
#                    platforms: local, or remote from `[komira_re]` in your
#                    .buckconfig.local.

[cells]
  app = .
  prelude = prelude
  toolchains = toolchains
  # A git external cell needs no directory here; nothing is checked out at this path.
  komira = komira-ext
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled
  komira = git

[external_cell_komira]
  git_origin = https://github.com/komira-ai/komira.git
  commit_hash = 0000000000000000000000000000000000000000

[buildfile]
  name = BUCK

[parser]
  target_platform_detector_spec = target:app//...->komira//tools/build/platforms:host target:komira//...->komira//tools/build/platforms:host target:toolchains//...->komira//tools/build/platforms:host

[build]
  execution_platforms = app//platforms:default

[buck2_re_client]
  max_total_batch_size = 1048576

[komira]
  # The timeout of buck2's test runner (`buck2 test ... -- --timeout <s>`, 600
  # by default), as in komira's .buckconfig, which says why: a mojo_test stops
  # itself 60 s before it. The rules read it from the root cell, so komira's
  # own setting does not reach a test run from here.
  test_timeout_s = 600

[project]
  ignore = buck-out, .git
