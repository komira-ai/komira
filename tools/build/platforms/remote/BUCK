load("//tools/build/platforms:defs.bzl", "komira_execution_platforms", "re_properties")

# The execution platforms of a standalone checkout: every action runs
# remotely, on workers with the property sets named in `.buckconfig.local`.
# They live apart from `//tools/build/platforms`, which holds only abstract
# constraints, so that a repository mounting komira as a cell can load the
# target platform without configuring these (see tools/build/README.md,
# "Mounting komira in another repository").

komira_execution_platforms(
    name = "remote",
    light = re_properties("light_properties"),
    mojo_compile = re_properties("mojo_compile_properties"),
    # Unset unless your service has workers spanning more than one NUMA node.
    mojo_compile_multi_numa = re_properties("mojo_compile_multi_numa_properties", required = False),
    visibility = ["PUBLIC"],
)
