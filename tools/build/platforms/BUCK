load(":defs.bzl", "komira_host_platform")
load(":table.bzl", "constraints", "registered_names")
load("//tools/build/toolchains:mojo_versions.bzl", "MOJO_NEXT", "MOJO_NEXT_CONSTRAINT")

# Platforms only. Nothing here names a service or a worker property set: the
# execution platforms that use these configurations are declared in
# //tools/build/platforms/default for a standalone checkout (local, or remote
# when `.buckconfig.local` names a service), and by any repository that
# mounts komira.

# One platform per registered row of the platform table (table.bzl), named
# for the row: `linux-x86_64`, `linux-arm64`, `darwin-arm64`. A row komira
# reserves (`registered = False`; none today) has no platform here: it is not a
# build key. Each is also the configuration of the one execution platform of
# that (os, cpu) that runs actions (registered by `komira_execution_platforms`
# or `komira_local_execution_platforms` in defs.bzl), so a tool built to run in
# an action is configured exactly like a target built for that platform. See
# README.md.
#
# `linux-x86_64` is the target platform for everything in this repo run from a
# Linux x86_64 client (see `host` below, and `[parser]` in .buckconfig), and the
# configuration of the linux execution platform. `linux-arm64` is the target
# platform for Linux on aarch64 (`--target-platforms
# komira//tools/build/platforms:linux-arm64`), and the configuration of the
# arm64 execution platform, registered only when one is configured. `darwin-arm64` is the target
# platform for macOS on Apple silicon: `--target-platforms
# komira//tools/build/platforms:darwin-arm64`, and the configuration of the
# macOS execution platform, registered only when one is configured; see
# README.md, "macOS".
[
    platform(
        name = name,
        constraint_values = constraints(name),
        visibility = ["PUBLIC"],
    )
    for name in registered_names()
]

# The same platforms building with the second Mojo compiler: each row's platform plus buildrules'
# constraint value for that compiler's version, named `<row>-mojo-<version>` (`linux-x86_64-mojo-1.2.0`).
# Everything Mojo builds with that compiler under it: komira's own rules (toolchains//:mojo selects on
# the constraint) and every `mojo_package` (buildrules selects on it). Nothing else sees the
# constraint, and the row platforms above are unchanged, so a build without one of these is the
# default build, byte for byte. See tools/build/toolchains/mojo_versions.bzl.
[
    platform(
        name = name + "-mojo-" + MOJO_NEXT,
        constraint_values = constraints(name) + [MOJO_NEXT_CONSTRAINT],
        visibility = ["PUBLIC"],
    )
    for name in registered_names()
]

# The default target platform: the client's own (`[parser]` in .buckconfig).
komira_host_platform(
    name = "host",
    visibility = ["PUBLIC"],
)
