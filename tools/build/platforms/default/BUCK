load("@komira//tools/build/platforms:defs.bzl", "execution_mode", "komira_default_execution_platforms")
load("@komira//tools/build/platforms:with_buildrules.bzl", "execution_platforms_plus")

# The execution platforms of a standalone checkout (`[build]
# execution_platforms` in .buckconfig). With no `.buckconfig.local`, every
# action runs on this machine. When `.buckconfig.local` names the worker
# property sets of a remote-execution service (`[komira_re]`), every action
# runs there instead, exactly as `komira_execution_platforms` registers it.
# `-c komira.execution=local|remote` forces one. See DEVELOPMENT.md.
#
# A repository that uses komira as a cell copies this file to its own
# platforms/BUCK (tools/build/consumer.buckconfig): only the root cell's
# `[komira_re]` is read, so its platforms live in its root cell.

komira_default_execution_platforms(
    name = "komira",
    visibility = ["PUBLIC"],
)

# `default` is komira's registration plus the platform buildrules' rules run on
# (with_buildrules.bzl says why), so that a library built with buildrules'
# `mojo_package` (src/komira_json) builds here. Komira's own platform stays first.
execution_platforms_plus(
    name = "default",
    base = ":komira",
    local = execution_mode() == "local",
    extra = ["buildrules//platforms:linux_x86_64"],
    # The macOS arm64 platform of buildrules' Mojo rules, on komira's macOS workers when it has them.
    extra_darwin = ["buildrules//platforms:macos_aarch64"],
    visibility = ["PUBLIC"],
)
