# Branch coverage of a mojo_library's welded tests (README.md): cov_branch
# (whose `link` links a test's LLVM bitcode with profile counters and whose
# `run` runs the test and merges its profile), the script that applies the
# profile, and the classifier that turns the annotated IR into lcov records.
# linux-x86_64 only, like the coverage builds that use it.
load("@komira//tools/build/coverage/kcov:defs.bzl", "kcov_tool", "kcov_tool_cases")
load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "cov_branch_dir")

# The directory every mojo_library's branch coverage build links and runs
# from (tools/build/mojo/coverage_branch.bzl).
cov_branch_dir(
    name = "cov_branch",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["PUBLIC"],
)

# cov_branch: the tool of the branch coverage actions, one subcommand each
# (cov_branch.zig; README.md, "cov_branch_link" and "cov_branch_run");
# `link` instruments a test's bitcode and links it; `run` runs a test through
# the release gate's runner with bounded_run.zig (a command waited for with
# an optional limit; with one, in a session of its own, and the survivors of
# the limit's kill), the module the coverage runs share.
_COV_BRANCH_SRCS = [
    "bounded_run.zig",
    "cov_branch_link.zig",
    "cov_branch_link_test.zig",
    "cov_branch_run.zig",
    "cov_branch_run_test.zig",
]

# Its unit tests (cov_branch_link_test.zig, cov_branch_run_test.zig and the
# test blocks of bounded_run.zig and cov_branch.zig), run by `zig test` as a
# build action.
zig_test(
    name = "cov_branch_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _COV_BRANCH_SRCS,
    src = "cov_branch.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# Welded: no branch coverage run has the tool unless its unit tests passed.
zig_exe(
    name = "cov_branch_exe",
    exec_compatible_with = LINUX_X86_64,
    imports = _COV_BRANCH_SRCS,
    src = "cov_branch.zig",
    unit_tests = [":cov_branch_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# The stand-in busybox, lld and zig of the process tests of `cov_branch
# link`: a test-only program that records its arguments and environment.
zig_exe(
    name = "cov_branch_link_stub",
    exec_compatible_with = LINUX_X86_64,
    src = "cov_branch_link_stub.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# The shipped executable's `link` run as a process
# (cov_branch_link_exe_test.zig) over the stand-ins. It runs the
# executable, so it cannot be an input of it: it is a validation of
# :cov_branch_tool instead.
zig_test(
    name = "cov_branch_link_exe_test",
    exec_compatible_with = LINUX_X86_64,
    exes = {
        "cov_branch": ":cov_branch_exe",
        "stub": ":cov_branch_link_stub",
    },
    imports = ["bounded_run.zig"],
    src = "cov_branch_link_exe_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# What the branch coverage directories take (defs.bzl): the executable,
# gated by its process test.
kcov_tool(
    name = "cov_branch_tool",
    cases = [":cov_branch_link_exe_test"],
    exec_compatible_with = LINUX_X86_64,
    exe = ":cov_branch_exe",
    visibility = ["PUBLIC"],
)

# Its sources, for the tests cell's planted copies (test 47).
[
    export_file(
        name = f,
        visibility = ["PUBLIC"],
    )
    for f in ["cov_branch.zig"] + _COV_BRANCH_SRCS
]

# cov_branch_classify: the branches of a test's annotated IR in the library's
# measured sources, each a source decision or a known compiler-made branch,
# as lcov BRDA records (README.md, "cov_branch_classify"); a static
# executable built with the pinned zig, gated by its cases.
zig_exe(
    name = "cov_branch_classify_exe",
    exec_compatible_with = LINUX_X86_64,
    imports = [
        "cov_branch_andor.zig",
        "cov_branch_ir.zig",
        "cov_branch_records.zig",
        "cov_branch_source.zig",
    ],
    src = "cov_branch_classify.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

kcov_tool_cases(
    name = "cov_branch_classify_cases",
    exec_compatible_with = LINUX_X86_64,
    data = [
        "fixtures/a.src",
        "fixtures/b.src",
        "fixtures/c.src",
        "fixtures/case.golden.info",
        "fixtures/case.ll",
        "fixtures/d.src",
        "fixtures/gen.src",
        "fixtures/rules.golden.info",
        "fixtures/rules.ll",
        "fixtures/t.src",
        "fixtures/try.golden.info",
        "fixtures/try.ll",
    ],
    script = "cov_branch_classify_cases.sh",
    tool = ":cov_branch_classify_exe",
)

kcov_tool(
    name = "cov_branch_classify",
    cases = [":cov_branch_classify_cases"],
    exec_compatible_with = LINUX_X86_64,
    exe = ":cov_branch_classify_exe",
    visibility = ["PUBLIC"],
)

# The script, for cov_branch_dir's default and for planted defects (the
# tests cell copies it with one fault: test 47).
export_file(
    name = "cov_branch_annotate.sh",
    visibility = ["PUBLIC"],
)

shell_lint(
    name = "shell_lint",
    srcs = [
        "cov_branch_annotate.sh",
        "cov_branch_classify_cases.sh",
    ],
)
