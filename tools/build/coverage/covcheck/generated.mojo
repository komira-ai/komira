"""Generated sources: the files coverage leaves out.

A `.mojo` file is generated when its FIRST LINE is the header every
generator writes: after an optional UTF-8 byte order mark, exactly
`# @generated` (a hash, one space, the token) at the very start of the
line, followed by the end of the line or a space or tab (`# @generated`,
`# @generated by a-tool; do not edit`). Nothing else marks a file: not the
token elsewhere on line 1 (`# not @generated`, `#@generated`), not leading
blanks before the hash, not a docstring that opens line 1 with the token,
not the token on a later line, in a docstring or in a string literal
(those are hand-written files and are measured), and an empty file has no
first line to mark. The line ends at the first line feed, and a carriage
return before it (a CRLF file) is part of no match.

A generated file is neither measured nor counted as a file no test
compiled, in any package: no report record of it is read (a test that
reaches it changes nothing), no executable line of it is counted, and it
appears in no floor or hold. analyze.mojo counts the files it leaves out
(`Analysis.generated_paths`); the summary names them, the result JSON lists
them, and the census writes them into each package's coverage_census.tsv
so adding the marker to a hand-written file is a reviewed diff.
"""

from covcheck.text import byte_at, substr

comptime GENERATED_HEADER = "# @generated"


def first_line(text: String) -> String:
    """`text` up to its first line feed (all of it when it has none)."""
    var n = text.byte_length()
    var end = 0
    while end < n and byte_at(text, end) != 10:
        end += 1
    return substr(text, 0, end)


def is_generated(text: String) -> Bool:
    """Whether the source `text` marks itself generated (the module header)."""
    var line = first_line(text)
    var at = 0
    # An optional UTF-8 byte order mark.
    if line.byte_length() >= 3 and byte_at(line, 0) == 0xEF and byte_at(line, 1) == 0xBB and byte_at(line, 2) == 0xBF:
        at = 3
    var rest = substr(line, at, line.byte_length())
    if not rest.startswith(GENERATED_HEADER):
        return False
    var end = String(GENERATED_HEADER).byte_length()
    if end == rest.byte_length():
        return True
    var c = byte_at(rest, end)
    return c == 32 or c == 9 or c == 13
