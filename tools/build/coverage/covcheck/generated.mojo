"""Generated sources: the files coverage leaves out.

A `.mojo` file is generated when its FIRST LINE contains the bytes
`@generated`: anywhere in that line, so `# @generated by a-tool` marks it
and so does a docstring that opens on line 1 with the token. Only the first line
counts. A file that mentions `@generated` on a later line, in a docstring or
in a string literal, is a hand-written file and is measured; so is an empty
file (it has no first line to mark). The line ends at the first line feed,
and a carriage return before it (a CRLF file) is part of no match.

A generated file is neither measured nor counted as a file no test
compiled, in any package: no report record of it is read (a test that
reaches it changes nothing), no executable line of it is counted, and it
appears in no floor or hold. analyze.mojo counts the files it leaves out
(`Analysis.generated_paths`), and the summary and the result JSON say how
many (and the JSON, which).
"""

from covcheck.text import byte_at, substr

comptime GENERATED_TOKEN = "@generated"


def first_line(text: String) -> String:
    """`text` up to its first line feed (all of it when it has none)."""
    var n = text.byte_length()
    var end = 0
    while end < n and byte_at(text, end) != 10:
        end += 1
    return substr(text, 0, end)


def is_generated(text: String) -> Bool:
    """Whether the source `text` marks itself generated (the module header)."""
    return first_line(text).find(GENERATED_TOKEN) >= 0
