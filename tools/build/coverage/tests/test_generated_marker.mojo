from std.testing import assert_equal, assert_false, assert_true

from covcheck.analyze import FORMAT_BRANCH_LCOV, FORMAT_LCOV, Analysis, Input, Options, Sources, analyze
from covcheck.generated import first_line, is_generated
from covcheck.held import Held, add_hold
from covcheck.paths import RepoFiles, repo_files_of
from covcheck.result import gate_json

# Generated sources: a `.mojo` file whose first line contains `@generated` is
# left out of coverage (neither measured nor counted as a file no test
# compiled, in no floor), whether or not a report reaches it. Only line 1
# counts.

comptime HAND = "def f() -> Int:\n    return 1\n"
comptime GEN = "# @generated by a-tool; do not edit\ndef g() -> Int:\n    return 2\n"


def _repo() -> RepoFiles:
    var l = List[String]()
    l.append("src/p/BUCK")
    l.append("src/p/a.mojo")
    l.append("src/p/g.mojo")
    return repo_files_of(l)


def _sources(g: String) -> Sources:
    var s = Sources(String(""))
    s.texts[String("src/p/a.mojo")] = String(HAND)
    s.texts[String("src/p/g.mojo")] = g
    return s^


def _a_only() -> List[Input]:
    var l = List[Input]()
    l.append(Input(String(FORMAT_LCOV), String(""), String("t.info"), String("SF:src/p/a.mojo\nDA:1,1\nDA:2,1\nend_of_record\n")))
    return l^


def _a_and_g() -> List[Input]:
    # g.mojo reached by a test: line 2 hit, line 3 never.
    var l = List[Input]()
    l.append(Input(String(FORMAT_LCOV), String(""), String("t.info"), String(
        "SF:src/p/a.mojo\nDA:1,1\nDA:2,1\nend_of_record\nSF:src/p/g.mojo\nDA:2,4\nDA:3,0\nend_of_record\n"
    )))
    return l^


def _kinds(a: Analysis) -> String:
    var s = String("")
    for i in range(len(a.findings)):
        if i > 0:
            s += String(" ")
        s += a.findings[i].kind
        if a.findings[i].path.byte_length() > 0:
            s += String("@") + a.findings[i].path
    return s^


def _held() raises -> Held:
    var h = Held()
    add_hold(h, String("src/p"), String("line\n"), String("src/p/coverage_held"), List[String]())
    return h^


def _run(reports: List[Input], g: String, o: Options = Options()) raises -> Analysis:
    return analyze(reports, List[Input](), _repo(), _held(), _sources(g), o)


def test_the_match_rule() raises:
    # First line only, anywhere in it; a CR before the line feed is no part of it.
    assert_true(is_generated(String("@generated")))
    assert_true(is_generated(String("# @generated")))
    assert_true(is_generated(String("# @generated\n")))
    assert_true(is_generated(String("# generated by x, @generated, more\nx\n")))
    assert_true(is_generated(String("\"\"\"@generated module.\"\"\"\nx\n")))
    assert_true(is_generated(String("# @generated\r\nx\r\n")))
    assert_false(is_generated(String("")))
    assert_false(is_generated(String("\n")))
    assert_false(is_generated(String("x\n# @generated\n")))
    assert_false(is_generated(String("x\r\n# @generated\r\n")))
    assert_false(is_generated(String("\n@generated\n")))
    assert_false(is_generated(String("# generated\n")))
    assert_false(is_generated(String("# @Generated\n")))
    assert_false(is_generated(String("# @ generated\n")))
    assert_equal(first_line(String("ab\r\ncd")), "ab\r")
    assert_equal(first_line(String("ab")), "ab")
    assert_equal(first_line(String("")), "")


def test_a_marked_file_a_report_reaches_is_left_out() raises:
    # Counted, g.mojo would add 2 found and 1 hit (the line it never runs is
    # a miss): the package would be at 75% and below the target.
    var a = _run(_a_and_g(), String(GEN))
    var k = a.package_index(String("src/p"))
    assert_true(k >= 0)
    assert_equal(a.packages[k].line_found, 2, _kinds(a))
    assert_equal(a.packages[k].line_hit, 2)
    assert_equal(a.packages[k].files, 1)
    assert_equal(len(a.files), 1)
    assert_equal(a.files[0].path, "src/p/a.mojo")
    assert_true(_kinds(a).find("BelowTarget") < 0, _kinds(a))
    assert_true(_kinds(a).find("UnmeasuredFile") < 0, _kinds(a))
    assert_true(_kinds(a).find("Regression") < 0, _kinds(a))
    assert_equal(len(a.generated_paths), 1)
    assert_equal(a.generated_paths[0], "src/p/g.mojo")


def test_a_marked_file_no_report_reaches_is_left_out() raises:
    var a = _run(_a_only(), String(GEN))
    var k = a.package_index(String("src/p"))
    assert_equal(a.packages[k].line_found, 2, _kinds(a))
    assert_equal(a.packages[k].unmeasured_files, 0)
    assert_equal(a.packages[k].files, 1)
    assert_true(_kinds(a).find("UnmeasuredFile") < 0, _kinds(a))
    assert_equal(len(a.generated_paths), 1)
    assert_equal(a.generated_paths[0], "src/p/g.mojo")


def test_an_unmarked_file_still_counts() raises:
    var never = _run(_a_only(), String("def g() -> Int:\n    return 2\n"))
    assert_equal(_kinds(never).find("UnmeasuredFile@src/p/g.mojo") >= 0, True, _kinds(never))
    assert_equal(never.packages[never.package_index(String("src/p"))].line_found, 4)
    assert_equal(len(never.generated_paths), 0)
    var reached = _run(_a_and_g(), String("def g() -> Int:\n    return 2\n"))
    var k = reached.package_index(String("src/p"))
    assert_equal(reached.packages[k].line_found, 4)
    assert_equal(reached.packages[k].line_hit, 3)
    assert_true(_kinds(reached).find("Regression") >= 0, _kinds(reached))


def test_the_token_past_line_one_does_not_exempt() raises:
    var cases = List[String]()
    cases.append("def g() -> Int:\n    # @generated\n    return 2\n")                    # line 2 comment
    cases.append("def g() -> Int:\n    \"\"\"@generated\"\"\"\n    return 2\n")          # line 2 docstring
    cases.append("def g() -> String:\n    return \"@generated\"\n")                      # string literal
    cases.append("\n# @generated\ndef g() -> Int:\n    return 2\n")                       # after a blank first line
    cases.append("def g() -> Int:\r\n    # @generated\r\n    return 2\r\n")               # CRLF, line 2
    for i in range(len(cases)):
        var a = _run(_a_only(), cases[i])
        assert_true(_kinds(a).find("UnmeasuredFile@src/p/g.mojo") >= 0, String(i) + String(": ") + _kinds(a))
        assert_equal(len(a.generated_paths), 0)
        var b = _run(_a_and_g(), cases[i])
        assert_true(b.packages[b.package_index(String("src/p"))].line_found > 2, String(i))
        assert_equal(len(b.generated_paths), 0)


def test_an_empty_file_is_not_generated_and_counts_nothing() raises:
    var a = _run(_a_only(), String(""))
    assert_equal(len(a.generated_paths), 0)
    assert_true(_kinds(a).find("UnmeasuredFile") < 0, _kinds(a))
    assert_equal(a.packages[a.package_index(String("src/p"))].line_found, 2)


def test_crlf_line_ends_on_line_one() raises:
    var g = String("# @generated\r\ndef g() -> Int:\r\n    return 2\r\n")
    var never = _run(_a_only(), g)
    assert_equal(len(never.generated_paths), 1)
    assert_true(_kinds(never).find("UnmeasuredFile") < 0, _kinds(never))
    var reached = _run(_a_and_g(), g)
    assert_equal(reached.packages[reached.package_index(String("src/p"))].line_found, 2)
    assert_equal(len(reached.generated_paths), 1)


def test_branch_records_and_mutants_of_a_marked_file_are_left_out() raises:
    var r = _a_only()
    r.append(Input(String(FORMAT_BRANCH_LCOV), String(""), String("b.info"), String(
        "SF:src/p/g.mojo\nBRDA:2,20:select:0/1,0,0\nBRDA:2,20:select:0/1,1,0\nend_of_record\n"
    )))
    # A second branch record file that disagrees with the first on how many
    # decisions the marked file's location holds: refused for a measured file, read by no
    # one for a left-out one.
    r.append(Input(String(FORMAT_BRANCH_LCOV), String(""), String("c.info"), String(
        "SF:src/p/g.mojo\nBRDA:2,20:select:0/2,0,0\nBRDA:2,20:select:0/2,1,0\nBRDA:2,20:select:1/2,0,0\nBRDA:2,20:select:1/2,1,0\nend_of_record\n"
    )))
    var m = List[Input]()
    m.append(Input(String("mutants"), String(""), String("m.tsv"), String("src/p/g.mojo\t2\tsurvived\top\tflip\n")))
    var a = analyze(r, m, _repo(), _held(), _sources(String(GEN)), Options())
    var p = a.packages[a.package_index(String("src/p"))].copy()
    assert_equal(p.branch_found, 0)
    assert_equal(p.mutants, 0)
    assert_true(_kinds(a).find("MutantSurvived") < 0, _kinds(a))
    assert_equal(len(a.generated_paths), 1)
    # The same inputs against an unmarked file: the disagreement is refused.
    var raised = False
    try:
        _ = analyze(r, m, _repo(), _held(), _sources(String("def g() -> Int:\n    return 2\n")), Options())
    except:
        raised = True
    assert_true(raised)
    # And with one agreeing branch record file, its mutant and arms count.
    var one = _a_only()
    one.append(r[1].copy())
    var b = analyze(one, m, _repo(), _held(), _sources(String("def g() -> Int:\n    return 2\n")), Options())
    var q = b.packages[b.package_index(String("src/p"))].copy()
    assert_equal(q.mutants, 1)
    assert_equal(q.branch_found, 2)


def test_the_gate_leaves_it_out_and_says_so() raises:
    var o = Options()
    o.only_package = String("src/p")
    var a = analyze(_a_and_g(), List[Input](), _repo(), _held(), _sources(String(GEN)), o)
    var j = gate_json(a, String("src/p"))
    assert_true(j.find("\"generated_files\":1,\"generated_paths\":[\"src/p/g.mojo\"]") >= 0, j)
    assert_true(j.find("\"line_found\":2,") >= 0, j)
    var none = analyze(_a_only(), List[Input](), _repo(), _held(), _sources(String(HAND)), o)
    assert_true(gate_json(none, String("src/p")).find("\"generated_files\":0,\"generated_paths\":[]") >= 0)


def main() raises:
    test_the_match_rule()
    test_a_marked_file_a_report_reaches_is_left_out()
    test_a_marked_file_no_report_reaches_is_left_out()
    test_an_unmarked_file_still_counts()
    test_the_token_past_line_one_does_not_exempt()
    test_an_empty_file_is_not_generated_and_counts_nothing()
    test_crlf_line_ends_on_line_one()
    test_branch_records_and_mutants_of_a_marked_file_are_left_out()
    test_the_gate_leaves_it_out_and_says_so()
    print("test_generated_marker: PASS")
