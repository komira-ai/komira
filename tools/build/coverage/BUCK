load("@komira//tools/build/lint:defs.bzl", "shell_lint")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "branch_gate_rows", "cov_gate_dir")
load(":policy.bzl", "COVERAGE_BRANCH_GATE")

# covcheck: coverage reports (kcov's Cobertura, lcov, and the branch records
# of tools/build/coverage/branch) to per-package numbers,
# findings against the policy (the 99% target, the metrics a package holds,
# surviving mutants, exemptions), a GitHub check run's request bodies, and
# the per-package build gate. See README.md. The holds are DATA, each
# package's own `coverage_held` (README.md, "The 99% threshold and holds").
#
# The coverage census (census.md): census_files assembles every package's
# coverage_census.tsv and coverage_held, census.sh renders the census doc
# from them; the root BUCK's :coverage_census builds the doc and fails while
# a package the census measured at the target does not hold it.
export_file(
    name = "census.sh",
    visibility = ["PUBLIC"],
)

# The policy, as data for the coverage workflow's cases (the root BUCK's
# coverage_ci_cases), which parse it the way .github/ci/coverage_measure.sh does.
export_file(
    name = "policy.bzl",
    visibility = ["PUBLIC"],
)

mojo_library(
    name = "covcheck",
    srcs = glob(["covcheck/*.mojo"]),
    deps = [
        "//src/komira_json:komira_json",
    ],
    test_srcs = [
        # the lcov reader: lines, branches ('-' not taken), summary records that
        # lie are ignored, duplicate SF summed, and every refusal
        "tests/test_lcov.mojo",
        # the Cobertura reader: kcov's real shape, no branches from rate
        # attributes, the XML it accepts, every refusal, and Cobertura == lcov
        "tests/test_cobertura.mojo",
        # branch record files (--branch-lcov, cov_branch_classify's): the
        # strict reader and every refusal, the sum of an arm across tests
        # ('-' counted, not taken), a location's decisions disagreeing
        # between tests refused, one source of branch data per file, the
        # branch numbers next to Cobertura lines (BelowTarget, the hold, no
        # BranchNotMeasured, a file named with no arm measured), the checks
        # over kept files only, one report naming a path twice refused, an
        # unmeasured file whose arms ran said so, and their annotations
        "tests/test_branch_lcov.mojo",
        # path mapping in its documented order (strip prefix, buck-out hash,
        # PKGDIR, outside vs unmapped) and a file's package
        "tests/test_paths.mojo",
        # a test's generated main (a client's layout probe, named at its
        # output path in the package) set aside as a test source, and every
        # other unmapped path still an error: a missing file in a repository
        # directory, another file of the output directory, the test's name
        # in a repository directory, a report that is no test's
        "tests/test_generated_tests.mojo",
        # every diff block shape: modified, added, deleted, renames, binary,
        # mode-only, omitted and zero counts, C-quoted paths
        "tests/test_diff.mojo",
        # exemption markers and their near misses, their effect on the counts;
        # the mutants file format
        "tests/test_exempt_mutants.mojo",
        # the source lexer: markers recognised only in a real comment (not
        # in a string, a docstring or another comment's text), CRLF, and the
        # executable-line heuristic over every kind of line, trait
        # requirements (no code) left out
        "tests/test_lexer.mojo",
        # declaration reachability (report only): the functions a source
        # declares (methods, multi-line and generic signatures, one-line
        # bodies, nested functions, trait requirements left out, `def` in a
        # string or comment ignored, scanner edges), each one's class
        # (plain, always_inline, comptime_if), which ones no report gives a
        # line, markers leaving their count, a branch-only file listing
        # none, and analyze listing them, split by class, in both JSON
        # results without changing any number or finding
        "tests/test_decls.mojo",
        # the full-source denominator: a measured package's source file no
        # report names counts uncovered and raises UnmeasuredFile
        "tests/test_full_source.mojo",
        # declaration-only files: a fixture of bodiless trait methods,
        # comptime values and imports no test compiled counts no line and is
        # a DeclarationOnlyFile note; the near-miss fixture (a default
        # method body with code) and a table of near misses still count
        "tests/test_declaration_only.mojo",
        # the held marker's grammar and refusals, and the holds against the
        # target at its edges: held below fails, at it passes, not held is
        # neutral or a notice, per metric, unmeasured, nothing to cover
        "tests/test_held.mojo",
        # the shared computation: merged reports, test sources both ways,
        # exemptions, mutants, the target, conclusions per mode, rounding, and
        # the gate's numbers equal to the report's, test-only packages'
        # findings as information
        "tests/test_analyze.mojo",
        # check-run batching, annotation scope/order/ranges/levels, changed-line
        # coverage, the summary's size limit, JSON escaping
        "tests/test_report.mojo",
        # the command line end to end: the summary golden, check-run files,
        # result JSON, a hold, gate == report, the annotation cap
        # and the full annotations file, every exit code, --info-package
        # (information, notices, a gate passing in enforce mode)
        "tests/test_cli.mojo",
    ],
    test_data = {
        "tests/test_lcov.mojo": ["tests/fixtures/basic.info"],
        "tests/test_cobertura.mojo": [
            "tests/fixtures/equiv.info",
            "tests/fixtures/equiv.xml",
            "tests/fixtures/kcov_trimmed.xml",
        ],
        "tests/test_declaration_only.mojo": [
            "tests/fixtures/decl/declaration_only.mojo",
            "tests/fixtures/decl/near_miss.mojo",
        ],
        "tests/test_cli.mojo": [
            "tests/fixtures/e2e/beta_held",
            "tests/fixtures/e2e/cov_alpha.xml",
            "tests/fixtures/e2e/cov_beta.xml",
            "tests/fixtures/e2e/diff.txt",
            "tests/fixtures/e2e/mutants.tsv",
            "tests/fixtures/e2e/root/src/alpha/__init__.mojo",
            "tests/fixtures/e2e/root/src/alpha/a.mojo",
            "tests/fixtures/e2e/root/src/alpha/z.mojo",
            "tests/fixtures/e2e/root/src/beta/c.mojo",
            "tests/fixtures/e2e/summary.md",
        ],
    },
    visibility = ["PUBLIC"],
)

mojo_binary(
    name = "covcheck_bin",
    srcs = ["main.mojo"],
    deps = [
        ":covcheck",
        "//src/komira_json:komira_json",
    ],
    visibility = ["PUBLIC"],
)

# The directory every mojo_library's coverage gate runs from
# (tools/build/mojo/coverage.bzl; README.md, "The build gate"): cov_gate.sh
# and covcheck_bin; each gate reads its own package's coverage_held. The
# Mojo libraries covcheck_bin depends on cannot have it as a dependency (a
# gate of their own): they are the ledger COVERAGE_NO_GATE of policy.bzl,
# held equal to that closure by no_gate.bxl.
cov_gate_dir(
    name = "cov_gate",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["PUBLIC"],
)

# For planted defects (the tests cell copies it with one fault: test 46).
export_file(
    name = "cov_gate.sh",
    visibility = ["PUBLIC"],
)

# census_files: the per-package coverage files assembled for the census and
# split back into packages (census_files.zig). Its cases
# (census_files_test.zig, which imports the tool) run as a build action,
# `zig test`; the executable is built behind them, so it does not exist
# unless they pass.
zig_test(
    name = "census_files_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["census_files.zig"],
    src = "census_files_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "census_files",
    exec_compatible_with = LINUX_X86_64,
    src = "census_files.zig",
    unit_tests = [":census_files_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

shell_lint(
    name = "shell_lint",
    srcs = [
        "census.sh",
        "cov_gate.sh",
    ],
)

# Every row of COVERAGE_BRANCH_GATE (policy.bzl) names a Mojo library by the
# exact label string mojo_library looks itself up by: a row naming none, or
# spelled another way, fails this target, which the pull-request check builds.
branch_gate_rows(
    name = "branch_gate_rows",
    libraries = {row: row for row in sorted(COVERAGE_BRANCH_GATE.keys())},
)
