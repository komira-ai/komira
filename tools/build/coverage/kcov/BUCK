# The path tools of a kcov coverage run (README.md): static executables built
# with the pinned zig, each gated by its cases, which run as build actions.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":defs.bzl", "cov_link_dir", "cov_run_dir", "kcov_tool")

# debug_relocate: a directory path in a file overwritten by a placeholder of
# the same length. Its cases (debug_relocate_test.zig, which imports the tool)
# run as a build action, `zig test`; the executable is built behind them, so
# it does not exist unless they pass.
zig_test(
    name = "debug_relocate_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["debug_relocate.zig"],
    src = "debug_relocate_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "debug_relocate_exe",
    exec_compatible_with = LINUX_X86_64,
    src = "debug_relocate.zig",
    unit_tests = [":debug_relocate_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# The shipped executable run as a process (debug_relocate_exe_test.zig): exit
# 0, 1 and 2, the counts on stdout and the messages on stderr, and a stdout
# whose writes fail. Its path reaches the test in the environment
# (`env_tools`, DEBUG_RELOCATE). It runs the executable, so it cannot be an
# input of it; it is a validation of the public target instead.
zig_test(
    name = "debug_relocate_exe_test",
    exec_compatible_with = LINUX_X86_64,
    env_tools = {"DEBUG_RELOCATE": ":debug_relocate_exe"},
    src = "debug_relocate_exe_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

kcov_tool(
    name = "debug_relocate",
    cases = [":debug_relocate_exe_test"],
    exec_compatible_with = LINUX_X86_64,
    exe = ":debug_relocate_exe",
    visibility = ["PUBLIC"],
)

# cov_normalize: a kcov Cobertura report rewritten to repository paths, with
# bytes that do not depend on the run. Its cases (cov_normalize_test.zig,
# which imports the tool) run as a build action, `zig test`; the executable is
# built behind them, so it does not exist unless they pass.
zig_test(
    name = "cov_normalize_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = [
        "cov_normalize.zig",
        "fixtures/kcov_full_paths.golden.xml",
        "fixtures/kcov_full_paths.xml",
    ],
    src = "cov_normalize_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "cov_normalize_exe",
    exec_compatible_with = LINUX_X86_64,
    src = "cov_normalize.zig",
    unit_tests = [":cov_normalize_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# The shipped executable run as a process (cov_normalize_exe_test.zig): exit
# 0, 1 and 2 with their messages on stderr, and a write cut short. Its path
# reaches the test in the environment (`env_tools`, COV_NORMALIZE). It runs
# the executable, so it cannot be an input of it; it is a validation of the
# public target instead.
zig_test(
    name = "cov_normalize_exe_test",
    exec_compatible_with = LINUX_X86_64,
    env_tools = {"COV_NORMALIZE": ":cov_normalize_exe"},
    imports = [
        "fixtures/kcov_full_paths.golden.xml",
        "fixtures/kcov_full_paths.xml",
    ],
    src = "cov_normalize_exe_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

kcov_tool(
    name = "cov_normalize",
    cases = [":cov_normalize_exe_test"],
    exec_compatible_with = LINUX_X86_64,
    exe = ":cov_normalize_exe",
    visibility = ["PUBLIC"],
)

# cov_zig: the `zig` of a coverage build's link directory (tools/build/mojo/
# coverage.bzl). It keeps the debug info of a link and relocates the action's
# directories out of it with debug_relocate. Its cases (cov_zig_test.zig,
# which imports the tool) run as a build action, `zig test`, over a stand-in
# zig (cov_zig_stub.zig) and the real debug_relocate; the executable is built
# behind them, so it does not exist unless they pass.
zig_exe(
    name = "cov_zig_stub",
    exec_compatible_with = LINUX_X86_64,
    src = "cov_zig_stub.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_test(
    name = "cov_zig_unit",
    exec_compatible_with = LINUX_X86_64,
    env_tools = {
        "COV_ZIG_STUB": ":cov_zig_stub",
        "DEBUG_RELOCATE": ":debug_relocate",
    },
    imports = [
        "cov_zig.zig",
        "cov_zig_elf.zig",
    ],
    src = "cov_zig_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "cov_zig_exe",
    exec_compatible_with = LINUX_X86_64,
    src = "cov_zig.zig",
    unit_tests = [":cov_zig_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

# The shipped executable run as a process (cov_zig_exe_test.zig) from a link
# directory like :cov_link's, over the pinned zig: a C program compiled and
# linked through it, a refusal (exit 1) and bad usage (exit 2); over the
# stand-in zig: $PWD and $BUCK_SCRATCH_PATH read from its environment. It
# runs the executable, so it cannot be an input of it; it is a validation of
# the public target instead.
zig_test(
    name = "cov_zig_exe_test",
    exec_compatible_with = LINUX_X86_64,
    env_tools = {
        "COV_ZIG": ":cov_zig_exe",
        "COV_ZIG_STUB": ":cov_zig_stub",
        "DEBUG_RELOCATE": ":debug_relocate",
        "PINNED_ZIG": "komira//tools/build/toolchains:zig",
    },
    imports = ["cov_zig_elf.zig"],
    src = "cov_zig_exe_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

kcov_tool(
    name = "cov_zig",
    cases = [":cov_zig_exe_test"],
    exec_compatible_with = LINUX_X86_64,
    exe = ":cov_zig_exe",
    visibility = ["PUBLIC"],
)

# The link directory every mojo_library's coverage build links through
# (tools/build/mojo/coverage.bzl): cov_zig, debug_relocate and the toolchain's
# zig. One target for all of them, so the paths of zig's C runtime sources in
# the debug info do not depend on the library.
cov_link_dir(
    name = "cov_link",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["PUBLIC"],
)

# The directory every mojo_library's coverage run runs from
# (tools/build/mojo/coverage.bzl): cov_run, which runs one test's coverage
# binary under kcov through the release gate's runner and normalizes its
# report; kcov; cov_normalize.
cov_run_dir(
    name = "cov_run",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["PUBLIC"],
)

# cov_run (cov_run.zig): the program of a coverage run. Built behind its unit
# tests; the run's cases are the fixtures of tests//negative/coverage and
# tests//functional/coverage (tests 41 to 47).
zig_test(
    name = "cov_run_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["cov_run.zig"],
    src = "cov_run_test.zig",
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
)

zig_exe(
    name = "cov_run_bin",
    exec_compatible_with = LINUX_X86_64,
    src = "cov_run.zig",
    unit_tests = [":cov_run_unit"],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig",
    visibility = ["PUBLIC"],
)

# For planted defects (the tests cell copies it with one fault: test 43).
export_file(
    name = "cov_run.zig",
    visibility = ["PUBLIC"],
)
