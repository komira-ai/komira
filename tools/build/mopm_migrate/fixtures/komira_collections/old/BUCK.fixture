load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The typed slab, a type-erased inline value, a variadic pack, a HyperLogLog cardinality sketch: generic containers with no dependencies.
mojo_library(
    name = "komira_collections",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_atomic_alias:komira_atomic_alias",
    ],
    test_srcs = [
        "tests/test_atomic_slab.mojo",
        "tests/test_dyn_value.mojo",
        "tests/test_hyperloglog.mojo",
        "tests/test_owned_slab.mojo",
        "tests/test_slab.mojo",
        "tests/test_slab_edges.mojo",
        "tests/test_variadic_pack.mojo",
    ],
    visibility = ["PUBLIC"],
)
