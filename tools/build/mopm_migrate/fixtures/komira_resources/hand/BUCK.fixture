load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Files a program reads at run time, found under its own share/ directory;
# see src/komira_resources/resources.mojo. The test declares its fixtures as
# data, and one fixture it deliberately does not declare, to show an
# undeclared file is refused.
#
# It also runs a built program that is its data. The program finds its share/
# as `<exe>/../../share`, so it is staged as a bundle is laid out: its runnable
# directory at `<tool>/bin` and its own resources at `<tool>/share/<name>`.
# Staged one level down (`flat`), its share/ is the test's `share/share`, and
# its resource is absent; the test asserts both.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the test of tests/ has passed. The package depends on
# komira_runtime_paths, a sibling package (`[dependencies]` of mopm.toml): its `:lib` is built from
# that package's `:lib`.
mojo_package(
    path = ".",
    test_data = {
        "tests/test_resources.mojo": {
            "renamed/shipped.txt": "tests/fixtures/declared.txt",
            "src/komira_resources/tests/fixtures/declared.txt": "tests/fixtures/declared.txt",
            "src/komira_resources/tests/fixtures/dir/a.txt": "tests/fixtures/dir/a.txt",
            "src/komira_resources/tests/fixtures/dir/b.txt": "tests/fixtures/dir/b.txt",
            "tool/bin": ":resources_probe[runnable]",
            "tool/share/probe/value.txt": "tests/fixtures/declared.txt",
            "flat": ":resources_probe[runnable]",
        },
    },
    test_layout = "installed",
)

# `:komira_resources`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the test has passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of
# those packages: the rule refuses a list that is not the closure `:lib` was built from. It carries
# the README gate too (`[tests][readme]`): the examples run against `:lib`; the test is not run again.
mojo_adopted_library(
    name = "komira_resources",
    deps = ["//src/komira_runtime_paths:komira_runtime_paths"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_resources/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The program the test runs as its data (see above). It uses komira_runtime_paths.data_path, the
# rule komira_resources applies, rather than komira_resources itself: that library's gated test
# runs this program, so depending on the gated library would be a cycle.
mojo_binary(
    name = "resources_probe",
    srcs = ["tests/resources_probe.mojo"],
    deps = ["//src/komira_runtime_paths:komira_runtime_paths"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_resources-0.1.0-mojo1.0.0_0.conda`), which records komira_runtime_paths as a
# dependency (`mojo-komira_runtime_paths >=0.1,<0.2`) and holds that package's files nowhere. `members`
# is the manifests of the path dependencies, staged at their repository paths, because `mopm pack`
# reads the manifest of each beside the one it is given. `:lib` exists only once the test passed, so
# this file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action:
# it is a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_resources",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../komira_runtime_paths": "//src/komira_runtime_paths:mopm.toml"},
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_73",
    package = "komira_resources",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/` (komira_runtime_paths is not in it), and exactly one
# dependency, `mojo-komira_runtime_paths >=0.1,<0.2`, which is what installing the package pulls in.
# Red when the manifest drops the dependency, names another range, or the file carries the sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_runtime_paths >=0.1,<0.2"],
    package = "komira_resources",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_resources`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_resources_conda",
    lib = ":komira_resources",
    summary = "The `komira_resources` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
