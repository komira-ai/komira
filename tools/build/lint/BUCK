# The linters run by the lint rules (defs.bzl), as pinned downloads, and the
# lint action script. linux x86_64 static binaries.
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/platforms:table.bzl", "pinned_kwargs")
load(":defs.bzl", "shell_lint", "tar_member")

export_file(name = "lint.sh", visibility = ["PUBLIC"])

export_file(name = "retired_names.sh", visibility = ["PUBLIC"])

export_file(name = "test_weld.sh", visibility = ["PUBLIC"])

pinned_file(**pinned_kwargs("linux-x86_64", "shellcheck"))

tar_member(
    name = "shellcheck",
    archive = ":shellcheck-v0.11.0.linux.x86_64.tar.xz",
    member = "shellcheck-v0.11.0/shellcheck",
    visibility = ["PUBLIC"],
)

pinned_file(**pinned_kwargs("linux-x86_64", "actionlint"))

tar_member(
    name = "actionlint",
    archive = ":actionlint_1.7.12_linux_amd64.tar.gz",
    member = "actionlint",
    visibility = ["PUBLIC"],
)

# The lint actions' own scripts.
shell_lint(
    name = "shell_lint",
    srcs = ["lint.sh", "retired_names.sh", "test_weld.sh"],
    visibility = ["PUBLIC"],
)
