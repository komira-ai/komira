# The linters run by the lint rules (defs.bzl), as pinned downloads, and the
# lint action script. linux x86_64 static binaries.
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/platforms:table.bzl", "pinned_kwargs")
load(":defs.bzl", "shell_lint", "tar_member")
load(":shell_budget.bzl", "shell_budget")

export_file(name = "lint.sh", visibility = ["PUBLIC"])

export_file(name = "readme_api_coverage.sh", visibility = ["PUBLIC"])

export_file(name = "test_weld.sh", visibility = ["PUBLIC"])

# The reader of lint kind pointer_lint (lint.sh; the rule is pointer_lint in defs.bzl).
export_file(name = "pointer_lint.awk", visibility = ["PUBLIC"])

# The reader of lint kind public_boundary (lint.sh; the rule is public_boundary in defs.bzl).
export_file(name = "public_boundary.awk", visibility = ["PUBLIC"])

pinned_file(**pinned_kwargs("linux-x86_64", "shellcheck"))

tar_member(
    name = "shellcheck",
    archive = ":shellcheck-v0.11.0.linux.x86_64.tar.xz",
    member = "shellcheck-v0.11.0/shellcheck",
    visibility = ["PUBLIC"],
)

pinned_file(**pinned_kwargs("linux-x86_64", "actionlint"))

tar_member(
    name = "actionlint",
    archive = ":actionlint_1.7.12_linux_amd64.tar.gz",
    member = "actionlint",
    visibility = ["PUBLIC"],
)

# The lint actions' own scripts.
shell_lint(
    name = "shell_lint",
    srcs = ["lint.sh", "readme_api_coverage.sh", "test_weld.sh"],
    visibility = ["PUBLIC"],
)

# The shell list (shell_budget.bzl): every shell script of the repository
# (`.sh`, `.bash`, or a `#!` line naming a shell) has a row in
# shell_allowlist.tsv (path, reason), and every row names one. Existence only:
# a script's size is never checked. The tree is every file of the cell
# (`//:doc_tree`), the files under .github/ (`//:github_tree`) and the tests
# cell's tree. A row comes out when its script is written in Zig or deleted;
# a row is added only with a reason review accepts.
shell_budget(
    name = "shell_budget",
    allowlist = "tools/build/lint/shell_allowlist.tsv",
    cells = {"tools/build/tests": "tests//:doc_tree"},
    dotfiles = ["//:github_tree"],
    tree = "//:doc_tree",
)
