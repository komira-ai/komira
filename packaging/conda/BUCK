load("@komira//tools/build/lint:defs.bzl", "conda_names")
load("@komira//tools/build/package:conda.bzl", "PUBLISHED_NAME_PREFIX", "conda_package")

# The approved list and the version prefix are the only statements of either
# (tools/build/package/conda.bzl reads them); see README.md.
export_file(name = "names.tsv", visibility = ["PUBLIC"])

export_file(name = "VERSION_PREFIX", visibility = ["PUBLIC"])

# The list is well formed, every row names a `komira_` package whose library
# exists as a target here, and this file never swaps the list for another.
conda_names(
    name = "names_lint",
    names = "names.tsv",
    buck = "BUCK",
    prefix = PUBLISHED_NAME_PREFIX,
)

# The canary: one library with no dependencies and no native code.
conda_package(
    name = "komira_encoding",
    lib = "//src/komira_encoding:komira_encoding",
    summary = "Base64, base64url, base32 and hex in pure Mojo, with constant-time strict decoding.",
)
