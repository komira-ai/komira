# The failing cases of :install_test (tools/build/tests/negative/node), which
# install the packages below and the test's files. That package is in the
# `tests` cell, which only komira's own checkout has; a label naming it
# would fail to load in a repository that uses komira as a cell, so it is
# named only when the cell exists.
_NEGATIVE = ["tests//negative/node:"] if read_root_config("cells", "tests") else []

