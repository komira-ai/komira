# ---- The TypeScript package (docs/design/typescript_package.md, part 3) -----
#
# @komira-ai/komira, not published: its sources (src/), the package.json npm
# reads, and the declarations and JavaScript tsc compiles from them (dist/).
# The name is a placeholder until the npm name is decided (the design's D1
# and D4).

# The TypeScript compiler and Node.js's types (devtools/README.md).
_DEVTOOLS = "//node/devtools:modules"

_SRCS = [
    "src/arrow_import.ts",
    "src/cpu.ts",
    "src/errors.ts",
    "src/index.ts",
    "src/native.ts",
    "src/platform.ts",
    "src/result.ts",
    "src/session.ts",
    "src/version.ts",
]

# The Arrow import is measured by :arrow_test, whose stand-in producer makes
# every format it maps; :package_test measures the rest.
_ARROW_IMPORT = "src/arrow_import.ts"

_TESTS = [
    "tests/abi_1_4.test.ts",
    "tests/cpu.test.ts",
    "tests/default_session.test.ts",
    "tests/engine_errors.test.ts",
    "tests/errors.test.ts",
    "tests/exports.test.ts",
    "tests/load.test.ts",
    "tests/missing_runtime.test.ts",
    "tests/package.test.ts",
    "tests/platform.test.ts",
    "tests/options.test.ts",
    "tests/register_args.test.ts",
    "tests/session.test.ts",
    "tests/sql.test.ts",
    "tests/unknown_status.test.ts",
    "tests/variants.test.ts",
]

# The modules the tests import that are not tests themselves.
_TEST_MODULES = [
    "tests/default_session_worker.ts",
    "tests/helpers.ts",
]

# The peer dependency's declarations, which the sources import: the pinned
# apache-arrow and the flatbuffers its declarations import, in a node_modules
# at the cell root, where tsc finds them after the package's own (devtools).
_ARROW_TYPES = {
    "node_modules/apache-arrow": "//third_party/node:apache-arrow",
    "node_modules/flatbuffers": "//third_party/node:flatbuffers",
}

# The SQL conformance runner (tests/conformance/README.md): its modules, which
# :sql_conformance_test measures, its tests, and the module they share.
_CONFORMANCE_SRCS = [
    "tests/conformance/corpus.ts",
    "tests/conformance/render.ts",
]

_CONFORMANCE_TESTS = [
    "tests/conformance/corpus.test.ts",
    "tests/conformance/render.test.ts",
    "tests/conformance/sql_conformance.test.ts",
    "tests/conformance/wrong_answer.test.ts",
]

_CONFORMANCE_MODULES = ["tests/conformance/staged.ts"]

# Every source and test, type-checked with strict on.
tsc_check(
    name = "typecheck",
    modules = _DEVTOOLS,
    srcs = _SRCS + _TESTS + _TEST_MODULES + _CONFORMANCE_SRCS + _CONFORMANCE_TESTS + _CONFORMANCE_MODULES + ["package.json", "tsconfig.json"],
    data = _ARROW_TYPES,
)

# The JavaScript and .d.ts files the package ships, compiled from src/.
tsc_build(
    name = "dist",
    modules = _DEVTOOLS,
    srcs = _SRCS + ["package.json", "tsconfig.build.json", "tsconfig.json"],
    data = _ARROW_TYPES,
)

# ---- The npm packages (docs/design/typescript_package.md, section 4) -------
#
# The tarballs `npm pack` would write, by `npm_tarball`
# (tools/build/package/README.md, "The npm packages"): byte for byte
# reproducible, each read back by its [check], and refused when a file is not
# one the manifest's `files` names, when a native library needs what the
# platform does not give (a Mojo runtime library missing among them), or when
# the manifest's repository.url is not komira's. The package.json each carries
# is its manifest here stamped: package.json for the main package, and
# platforms/<npm platform>/package.json for a platform package. Unstamped (a
# pull request) they are 0.0.0 and stay `"private": true`; the release stamp
# gives 0.1.<N>, the wheel's version. Nothing here publishes them.

# @komira-ai/komira: the compiled JavaScript and declarations, LICENSE and
# NOTICE.
npm_tarball(
    name = "package",
    package = "@komira-ai/komira",
    manifest = "package.json",
    license = "Apache-2.0",
    files = {
        "LICENSE": "komira//:LICENSE",
        "NOTICE": "komira//:NOTICE",
        "dist": ":dist",
    },
    visibility = ["komira//ci:"] + _NEGATIVE,
)

# @komira-ai/komira-linux-x64-gnu: the addon, libkomira's self-contained native
# directory as it is at native/ (where the main package loads it from:
# src/platform.ts), and the wheel's licence files, under the wheel's licence
# expression and native bounds (tools/build/package/libkomira/packaged.bzl).
npm_tarball(
    name = "package_linux_x64",
    package = "@komira-ai/komira-linux-x64-gnu",
    manifest = "platforms/linux-x64-gnu/package.json",
    license = DIST_LICENSE_EXPRESSION,
    platform = "linux-x86_64",
    files = {
        "komira_addon.node": ":komira_addon",
        "native": "komira//src/so:libkomira[dist]",
    } | DIST_LICENSE_FILES,
    visibility = ["komira//ci:"] + _NEGATIVE,
    **DIST_NATIVE_NEEDS["linux-x86_64"]
)

# ---- From the installed package (docs/design/typescript_package.md, section 5)
#
# The tarballs above as a user installs them: the pinned npm (third_party/
# node, :npm) installs :package into an empty project, offline and with
# --ignore-scripts, and npm resolves its platform package to
# :package_linux_x64 and its peer, apache-arrow, to the pinned tarballs. Then
# install/install.test.ts and install/commonjs.test.cjs import the package by
# its name from that project: what npm installed, the public names, the load
# of libkomira from the platform package alone, SELECT 1, a GROUP BY over the
# Parquet, CSV and NDJSON fixtures, apache-arrow's classes, and require() from
# CommonJS. Once per pinned Node.js line, 22, 24 and 26 (`[node_22]`,
# `[node_24]`, `[node_26]`), each its own action; a package npm marks as
# having an install script fails it (tools/build/node/README.md).
[export_file(
    name = "install/" + f,
    src = "install/" + f,
    visibility = _NEGATIVE,
) for f in INSTALL_FILES]

npm_install_test(
    name = "install_test",
    install = ":package",
    tarballs = [":package_linux_x64"] + INSTALL_REGISTRY,
    data = INSTALL_DATA,
    test_files = INSTALL_TESTS,
    nodes = INSTALL_NODES,
)

