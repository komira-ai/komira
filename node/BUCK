# ---- SQL conformance, reused (docs/design/typescript_package.md, section 5) ----
#
# The cases of src/tests/conformance/komira_sql_conformance run through
# Session.sql on the real engine (tests/conformance/README.md): each corpus's
# tables as the Parquet the pinned DuckDB wrote from its tables.sql, each
# answer written as the corpus writes DuckDB's and compared byte for byte,
# and each case komira refuses or answers otherwise held to its line in the
# corpus's refusals.tsv or differences.tsv. Nothing of the corpus is copied:
# the cases, the tables and the lists are that package's targets.
_CONFORMANCE = "komira//src/tests/conformance/komira_sql_conformance:"

# The negative case: a fixture corpus whose wrong.tsv is wrong in one cell,
# its table W written by the pinned DuckDB as the corpus's tables are.
_WRONG_ANSWER = glob(["tests/conformance/fixtures/wrong_answer/*"])

corpus_tables(
    name = "conformance_wrong_answer_tables",
    tables_sql = "tests/conformance/fixtures/wrong_answer/tables.sql",
    tables = ["W"],
)

# The runner's tests (corpus.test.ts, render.test.ts), the fixture corpus
# with one wrong answer (wrong_answer.test.ts), and every corpus case
# (sql_conformance.test.ts). The runner's modules are measured: at least 99%
# of their lines and branches together covered. The package's sources are
# loaded unmeasured; :package_test measures them.
node_binding_test(
    name = "sql_conformance_test",
    srcs = _CONFORMANCE_TESTS,
    covered_srcs = _CONFORMANCE_SRCS,
    data = {
        "komira_addon.node": ":komira_addon",
        "libkomira": LIBKOMIRA,
        "package.json": "package.json",
        "fixtures/cpuinfo_x86_64_v3.txt": "komira//python/tests:fixtures/cpuinfo_x86_64_v3.txt",
        "conformance/cases": _CONFORMANCE + "cases_tree",
        "conformance/differences.tsv": _CONFORMANCE + "differences.tsv",
        "conformance/refusals.tsv": _CONFORMANCE + "refusals.tsv",
        "conformance/wrong_answer_tables/W.parquet": ":conformance_wrong_answer_tables[W.parquet]",
    } | {
        "conformance/tables/{}/{}.parquet".format(corpus, t): "{}{}_tables[{}.parquet]".format(_CONFORMANCE, corpus, t)
        for corpus, tables in CORPUS_TABLES.items()
        for t in tables
    } | {
        "conformance/wrong_answer/" + f.split("/")[-1]: f
        for f in _WRONG_ANSWER
    } | {
        m: m
        for m in _SRCS + _CONFORMANCE_MODULES + ["tests/helpers.ts"]
    },
    deps = ["//third_party/node:apache-arrow"],
)
