load("@komira//tools/build/node:defs.bzl", "c_shared_lib", "node_addon", "node_binding_test")
load("@komira//tools/build/node:modules.bzl", "tsc_build", "tsc_check")

# The Node-API addon over libkomira, built with the pinned zig against the
# headers of the pinned node. README.md says what it exposes and why it opens
# the library with dlopen; arrow_import.c is its import of an Arrow C stream.
node_addon(
    name = "komira_addon",
    srcs = ["komira_addon.c", "arrow_import.c"],
    headers = ["arrow_c.h", "arrow_import.h"],
)

# libkomira with the Mojo runtime and its native owners in lib/ beside it: the
# directory the tests hand to load().
LIBKOMIRA = "komira//src/so:libkomira[runnable]"

# Stand-ins for libkomira that the addon must refuse: a library of ABI major 2,
# one of major 0 (version 0.999), and one without komira_plan_render.
c_shared_lib(
    name = "fake_v2",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=2000"],
    out = "libkomira_fake_v2.so",
)

c_shared_lib(
    name = "fake_v0",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=999"],
    out = "libkomira_fake_v0.so",
)

c_shared_lib(
    name = "fake_no_render",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_OMIT_PLAN_RENDER"],
    out = "libkomira_fake_no_render.so",
)

# Libraries whose minor version promises a call they lack: ABI 1.3 without
# komira_sql_stream, and ABI 1.7 with it but without komira_last_error_code.
c_shared_lib(
    name = "fake_v1_3_no_sql",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=1003"],
    out = "libkomira_fake_v1_3_no_sql.so",
)

c_shared_lib(
    name = "fake_v1_7_no_code",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=1007", "-DFAKE_SQL_STREAM"],
    out = "libkomira_fake_v1_7_no_code.so",
)

# A stand-in whose parquet_schema and plan_render results hold the capacity the
# addon passed and the length the call reported.
c_shared_lib(
    name = "fake_capacity",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_RECORD_CAPACITY"],
    out = "libkomira_fake_capacity.so",
)

# The addon before and while the library loads: the refusals of load().
node_binding_test(
    name = "load_test",
    srcs = ["load.test.mjs", "capacity.test.mjs"],
    data = {
        "komira_addon.node": ":komira_addon",
        "libkomira": LIBKOMIRA,
        "fake/libkomira_fake_v2.so": ":fake_v2",
        "fake/libkomira_fake_v0.so": ":fake_v0",
        "fake/libkomira_fake_no_render.so": ":fake_no_render",
        "fake/libkomira_fake_v1_3_no_sql.so": ":fake_v1_3_no_sql",
        "fake/libkomira_fake_v1_7_no_code.so": ":fake_v1_7_no_code",
        "fake/libkomira_fake_capacity.so": ":fake_capacity",
    },
)

# An addon of the tests whose external value is not a session.
node_addon(
    name = "foreign_external",
    srcs = ["tests/foreign_external.c"],
)

# The calls on the real library: the version, an error with its last error,
# the Parquet schema, the plan text, and the session's lifetime.
node_binding_test(
    name = "session_test",
    srcs = ["session.test.mjs"],
    data = {
        "komira_addon.node": ":komira_addon",
        "libkomira": LIBKOMIRA,
        "foreign_external.node": ":foreign_external",
        "two_columns.parquet": "komira//src/so:tests/fixtures/two_columns.parquet",
    },
)

# ---- The TypeScript package (docs/design/typescript_package.md, part 3) -----
#
# @komira-ai/komira, not published: its sources (src/), the package.json npm
# reads, and the declarations and JavaScript tsc compiles from them (dist/).
# The name is a placeholder until the npm name is decided (the design's D1
# and D4).

# The TypeScript compiler and Node.js's types (devtools/README.md).
_DEVTOOLS = "//node/devtools:modules"

_SRCS = [
    "src/arrow_import.ts",
    "src/cpu.ts",
    "src/errors.ts",
    "src/index.ts",
    "src/native.ts",
    "src/platform.ts",
    "src/result.ts",
    "src/session.ts",
    "src/version.ts",
]

# The Arrow import is measured by :arrow_test, whose stand-in producer makes
# every format it maps; :package_test measures the rest.
_ARROW_IMPORT = "src/arrow_import.ts"

_TESTS = [
    "tests/cpu.test.ts",
    "tests/default_session.test.ts",
    "tests/errors.test.ts",
    "tests/exports.test.ts",
    "tests/load.test.ts",
    "tests/package.test.ts",
    "tests/platform.test.ts",
    "tests/register_args.test.ts",
    "tests/session.test.ts",
    "tests/sql.test.ts",
    "tests/unknown_status.test.ts",
    "tests/variants.test.ts",
]

# The modules the tests import that are not tests themselves.
_TEST_MODULES = [
    "tests/default_session_worker.ts",
    "tests/helpers.ts",
]

# The peer dependency's declarations, which the sources import: the pinned
# apache-arrow and the flatbuffers its declarations import, in a node_modules
# at the cell root, where tsc finds them after the package's own (devtools).
_ARROW_TYPES = {
    "node_modules/apache-arrow": "//third_party/node:apache-arrow",
    "node_modules/flatbuffers": "//third_party/node:flatbuffers",
}

# Every source and test, type-checked with strict on.
tsc_check(
    name = "typecheck",
    modules = _DEVTOOLS,
    srcs = _SRCS + _TESTS + _TEST_MODULES + ["package.json", "tsconfig.json"],
    data = _ARROW_TYPES,
)

# The JavaScript and .d.ts files the package ships, compiled from src/.
tsc_build(
    name = "dist",
    modules = _DEVTOOLS,
    srcs = _SRCS + ["package.json", "tsconfig.build.json", "tsconfig.json"],
    data = _ARROW_TYPES,
)

# Stand-ins for the package's tests: a library of ABI 1.1 that loads, and two
# whose komira_register_parquet fails, with status -3 (KOMIRA_ERR_ENGINE) and
# a last error, and with a status libkomira does not define and no last error.
c_shared_lib(
    name = "fake_v1_1",
    srcs = ["tests/fake_libkomira.c"],
    out = "libkomira_fake_v1_1.so",
)

c_shared_lib(
    name = "fake_engine_error",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_REGISTER_STATUS=-3", "-DFAKE_LAST_ERROR=\"IO Error: the stand-in refuses every file\""],
    out = "libkomira_fake_engine_error.so",
)

# A stand-in that answers each komira_register_parquet with -3 and the
# arguments it received as the last error: what the package passed the C call.
c_shared_lib(
    name = "fake_echo_register",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_ECHO_REGISTER"],
    out = "libkomira_fake_echo_register.so",
)

# A stand-in of ABI 1.9 whose komira_sql_stream answers fixed queries with
# Arrow C streams, and refusals with the code and step the query names.
c_shared_lib(
    name = "fake_sql",
    srcs = ["tests/fake_sql.c"],
    headers = ["arrow_c.h"],
    out = "libkomira_fake_sql.so",
)

c_shared_lib(
    name = "fake_unknown_status",
    srcs = ["tests/fake_libkomira.c"],
    copts = ["-DFAKE_REGISTER_STATUS=-42"],
    out = "libkomira_fake_unknown_status.so",
)

_ISA_FIXTURES = [
    "VARIANTS_aarch64",
    "VARIANTS_macos",
    "VARIANTS_x86_64_v4",
    "choices.tsv",
    "cpuinfo_aarch64_cortex_a72.txt",
    "cpuinfo_aarch64_neoverse_n1.txt",
    "cpuinfo_x86_64_core2.txt",
    "cpuinfo_x86_64_skylake_sp.txt",
    "cpuinfo_x86_64_westmere.txt",
]

# The platform package as npm installs it beside the main package: its
# package.json, the addon, and the self-contained native directory.
_PLATFORM = "node_modules/@komira-ai/komira-linux-x64-gnu/"

# The package's behaviour tests (tests/*.test.ts, run by the pinned node with
# its types stripped), each file its own process, with the pinned apache-arrow
# as the peer dependency npm installs. The sources but the Arrow import are
# measured: every one must be loaded, with at least 99% of its lines and
# branches together covered.
node_binding_test(
    name = "package_test",
    srcs = _TESTS,
    covered_srcs = [s for s in _SRCS if s != _ARROW_IMPORT],
    data = {
        "dist": ":dist",
        "fake/echo_register/libkomira.so": ":fake_echo_register",
        "fake/engine_error/libkomira.so": ":fake_engine_error",
        "fake/sql/libkomira.so": ":fake_sql",
        "fake/unknown_status/libkomira.so": ":fake_unknown_status",
        "fake/v1_1/libkomira.so": ":fake_v1_1",
        "fake/v2/libkomira.so": ":fake_v2",
        "fixtures/cpuinfo_x86_64_v3.txt": "komira//python/tests:fixtures/cpuinfo_x86_64_v3.txt",
        "fixtures/isa_variants/VARIANTS_shipped": "komira//tools/build/package/libkomira:libkomira_variants_manifest",
        "fixtures/komira.tsv": "komira//src/so:abi/komira.tsv",
        "fixtures/two_columns.parquet": "komira//src/so:tests/fixtures/two_columns.parquet",
        "package.json": "package.json",
        _PLATFORM + "komira_addon.node": ":komira_addon",
        _PLATFORM + "native": "komira//src/so:libkomira[dist]",
        _PLATFORM + "package.json": "tests/fixtures/platform_package.json",
    } | {
        "fixtures/isa_variants/" + f: "komira//python/tests:fixtures/isa_variants/" + f
        for f in _ISA_FIXTURES
    } | {
        m: m
        for m in _TEST_MODULES
    } | {
        # The Arrow import, which the sources load, unmeasured here.
        _ARROW_IMPORT: _ARROW_IMPORT,
    },
    deps = ["//third_party/node:apache-arrow"],
)

# The session thread's stand-in (tests/fake_latch.c): its own context per
# session, a journal of every call with its context and thread, gates that
# hold a call until the test opens them, and refusals of a call on the
# JavaScript thread, two at once on one context, or from a second thread.
c_shared_lib(
    name = "fake_latch",
    srcs = ["tests/fake_latch.c"],
    out = "libkomira_fake_latch.so",
)

# An addon of the tests that opens and reads the stand-in's gates and journal.
node_addon(
    name = "fake_control",
    srcs = ["tests/fake_control.c"],
)

# The session thread: calls in order on one thread per session, two sessions
# at once, freeSession while a call is held, the finalizer of a session with a
# pending call, and sessions in worker threads.
node_binding_test(
    name = "thread_test",
    srcs = ["thread.test.mjs"],
    data = {
        "komira_addon.node": ":komira_addon",
        "fake_control.node": ":fake_control",
        "fake/libkomira_fake_latch.so": ":fake_latch",
    },
)

# A stand-in Arrow C stream producer: an addon of the tests that builds a
# stream from a description and counts the releases of its structs.
node_addon(
    name = "arrow_stand_in",
    srcs = ["tests/arrow_stand_in.c"],
    headers = ["arrow_c.h"],
)

# The Arrow import: the addon's drain and descriptions (arrow_stream.test.mts)
# and the apache-arrow Table the private module builds from them
# (arrow_import.test.mts), over streams of the stand-in. The tests run the
# pinned apache-arrow, the version package.json's peer range names. The
# module is measured here: at least 99% of its lines and branches covered.
node_binding_test(
    name = "arrow_test",
    srcs = ["arrow_stream.test.mts", "arrow_import.test.mts"],
    covered_srcs = [_ARROW_IMPORT],
    data = {
        "arrow_stand_in.node": ":arrow_stand_in",
        "foreign_external.node": ":foreign_external",
        "komira_addon.node": ":komira_addon",
        "package.json": "package.json",
        "src/errors.ts": "src/errors.ts",
        "tests/arrow_specs.mts": "tests/arrow_specs.mts",
    },
    deps = ["//third_party/node:apache-arrow"],
)
