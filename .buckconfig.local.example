# Copy to `.buckconfig.local` (gitignored) and fill in your remote-execution
# service. Every action in this repo runs remotely; there is no local
# execution platform.

[buck2_re_client]
  engine_address = grpc://re.example.internal:8980
  action_cache_address = grpc://re.example.internal:8980
  cas_address = grpc://re.example.internal:8980
  instance_name = default
  tls = false
  execution_concurrency_limit = 64

[komira_re]
  # Exact REAPI platform property sets of your workers, as comma-separated
  # key=value pairs, one per execution configuration (see
  # tools/build/platforms/BUCK).
  # Workers match a set exactly: a key the workers do not advertise leaves
  # actions queued until the scheduler gives up. Two keys may name the same
  # set if you have one kind of worker.
  #
  # Unpacking and copying toolchain files.
  light_properties = pool=light
  # Mojo compiles, gated tests and run checks, on one NUMA node.
  mojo_compile_properties = pool=mojo
  # Optional: workers that span more than one NUMA node. Leave unset unless
  # you have them; targets that require them then fail to configure instead
  # of running on single-node workers.
  # mojo_compile_multi_numa_properties = pool=mojo-multi-numa
  # Optional: macOS arm64 workers, for `--target-platforms
  # komira//tools/build/platforms:darwin-arm64`. Must carry macos_sdk=<the workers'
  # `xcrun --show-sdk-version`>; see README.md, "macOS".
  # darwin_mojo_compile_properties = pool=macos-arm64,macos_sdk=26.5
