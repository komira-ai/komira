load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/native:defs.bzl", "c_exe")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/platforms:table.bzl", "pinned_kwargs")
load("@komira//tools/build/toolchains/llvm_branch:defs.bzl", "llvm_branch_unpack")
load(":probe.bzl", "elf_report", "log_jit", "native_so", "probe_case", "probe_env", "probe_report")

# PROBE 3 (docs/design/native_packaging.md, "What the evidence covers, and
# probe 3"). Branch probe/native-packaging-3, never merged.
#
# Every owner of komira_http_core's closure as its own shared library, linked
# as the design's "How each shared library is linked" says (whole archive,
# -Bsymbolic, --gc-sections, -z defs, a version script; http_core with
# DT_NEEDED on crypto and DT_RUNPATH $ORIGIN), komira_log's holder archive and
# its JIT object (option A), the conda-forge codec libraries, and the .mojoc
# closure of every consumer: one installed environment (:env). Each case is
# one target; its action FAILS unless the case met its expectation:
#   expect "pass"         the case passed;
#   expect "fail:<ERE>"   the case failed and its log matches <ERE>.
# A must-fail case also has a `<case>_raw` target that expects "pass": its
# build is RED, which is the must-fail case shown failing.
#
#   ./buck2 build komira//tests/native_probe3:report --show-output

c_exe(
    name = "elfsyms",
    exec_compatible_with = LINUX_X86_64,
    src = "elfsyms.c",
)

_ROW = "linux-x86_64"

# ---- the owners' shared libraries ------------------------------------------

_OWNERS = {
    "async": ["//src/komira_async:komira_async_posix"],
    "async_api": ["//src/komira_async_api:komira_concurrency_pool_depth"],
    "compression": ["//third_party/snappy:snappy"],
    "crypto": [
        "//third_party/aws-lc:crypto",
        "//src/komira_crypto:komira_crypto_sha256_hw",
    ],
    "libc": ["//src/komira_libc:komira_libc_posix"],
    "metrics": ["//src/komira_metrics:komira_metrics_ea_flag"],
    "scan_source": ["//src/komira_scan_source:komira_scan_source_inmem_id"],
}

[
    native_so(
        name = "so_" + lib,
        archives = [a + "[static-pic]" for a in archives],
        cxx = lib == "compression",
        soname = "libkomira_{}_native.so.1".format(lib),
        version_script = "komira_owner.map",
    )
    for lib, archives in _OWNERS.items()
]

# komira_http_core: s2n-tls only; aws-lc through DT_NEEDED on crypto's .so,
# found through its own DT_RUNPATH $ORIGIN.
native_so(
    name = "so_http_core",
    archives = ["//third_party/s2n-tls:s2n[static-pic]"],
    needed = [":so_crypto"],
    runpath_origin = True,
    soname = "libkomira_http_core_native.so.1",
    version_script = "komira_owner.map",
)

# B3's library: the same link without DT_RUNPATH.
native_so(
    name = "so_http_core_nort",
    archives = ["//third_party/s2n-tls:s2n[static-pic]"],
    needed = [":so_crypto"],
    soname = "libkomira_http_core_native.so.1",
    version_script = "komira_owner.map",
)

log_jit(
    name = "log_holder_jit",
    src = "//src/komira_log:log_holder_files[engine/_log_holder_shim.c]",
    version_script = "log_holder_jit.map",
)

_SOS = [":so_" + lib for lib in sorted(_OWNERS.keys())] + [":so_http_core"]

elf_report(
    name = "elf",
    libs = _SOS + [
        ":so_http_core_nort",
        ":log_holder_jit",
    ],
    tool = ":elfsyms",
)

# ---- the codecs, from conda-forge -------------------------------------------

# lz4-c 1.10.0 (no platform-table role holds it; pinned here, probe only).
pinned_file(
    name = "lz4-c_1.10.0_linux-64.conda",
    sha256 = "47326f811392a5fd3055f0f773036c392d26fdb32e4d8e7a8197eed951489346",
    size_bytes = 167055,
    url = "https://conda.anaconda.org/conda-forge/linux-64/lz4-c-1.10.0-h5888daf_1.conda",
)

# zstd and libzlib: the table's own pins (same sha256, nothing new downloaded).
pinned_file(**pinned_kwargs(_ROW, "llvm_branch_zstd"))

pinned_file(**pinned_kwargs(_ROW, "libzlib"))

llvm_branch_unpack(
    name = "codecs",
    exec_compatible_with = LINUX_X86_64,
    conda_payload = "komira//tools/build/toolchains/kcov:conda_payload",
    members = {
        "liblz4.so.1": "lz4c/lib/liblz4.so.1",
        "libz.so.1": "libzlib/lib/libz.so.1",
        "libzstd.so.1": "zstd/lib/libzstd.so.1",
    },
    packages = {
        "libzlib": ":" + pinned_kwargs(_ROW, "libzlib")["name"],
        "lz4c": ":lz4-c_1.10.0_linux-64.conda",
        "zstd": ":" + pinned_kwargs(_ROW, "llvm_branch_zstd")["name"],
    },
    script = "unpack.sh",
)

# ---- the installed environment ---------------------------------------------

probe_env(
    name = "env",
    codecs = ":codecs",
    lib_files = {
        "libkomira_log_holder.a": "//src/komira_log:komira_log_holder[static-pic]",
        "libkomira_log_holder_jit.so.1": ":log_holder_jit",
    },
    libs = _SOS,
    mojo = [
        "//src/komira_compression:komira_compression",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_log:komira_log",
    ],
    nort = {"libkomira_http_core_native.so.1": ":so_http_core_nort"},
)

# ---- the cases ---------------------------------------------------------------

_CONSUMERS = glob(["consumers/*.mojo"]) + [
    "//src/komira_http_core:tests/fixtures/tls/leaf_cert.pem",
    "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
    "//src/komira_http_core:tests/fixtures/tls/root_ca.pem",
]

# case -> expectation. The must-fail ones name the text the failure must show.
_CASES = {
    "B1": "pass",
    "B2": "pass",
    "B3": "fail:libkomira_crypto_native\\.so\\.1",
    "DL_B": "pass",
    "DL_R": "pass",
    "DL_MISS_B": "fail:LOADED_FROM liblz4\\.so\\.1 OUTSIDE",
    "DL_MISS_R": "fail:LOADED_FROM liblz4\\.so\\.1 OUTSIDE",
    "IR1": "pass",
    "IR2": "pass",
    "LOG1_B": "pass",
    "LOG1_R": "pass",
    "LOG2": "pass",
    "ONE": "pass",
    "R1": "pass",
    "R1_MISS": "fail:komira_ignore_sigpipe",
    "R2": "pass",
}

[
    probe_case(
        name = case,
        case = case,
        consumers = _CONSUMERS,
        env = ":env",
        expect = expect,
        script = "case.sh",
        tool = ":elfsyms",
    )
    for case, expect in _CASES.items()
]

[
    probe_case(
        name = case + "_raw",
        case = case,
        consumers = _CONSUMERS,
        env = ":env",
        expect = "pass",
        script = "case.sh",
        tool = ":elfsyms",
    )
    for case, expect in _CASES.items()
    if expect != "pass"
]

probe_report(
    name = "report",
    logs = [":elf"] + [":" + c for c in sorted(_CASES.keys())],
)
