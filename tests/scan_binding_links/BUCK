load("@komira//tools/build/mojo:defs.bzl", "mojo_test")

# The link from each registered scan kind's SHIPPING binding constructor to
# the wire bytes `plan_wire` froze for it.
#
# plan_wire's golden test freezes `topic_live` and `index_pinned` from
# bindings it RESTATES out of the core packages primitives, because the codec may not
# import the kinds. Nothing there notices a kind drifting away from that
# restatement. This test encodes what the kinds themselves build, through the
# real codec, and requires the checked-in bytes.
#
# A package of its own so that no library gains a dependency for a test:
# plan_wire keeps no broker or search dependency, search_scan
# none on the broker, and broker none on search or the codec. It is a
# `mojo_test`, so `./buck2 test //...` runs it; no library's build waits on it.
_GOLDEN = "src/plan_wire/tests/fixtures/golden/"

mojo_test(
    name = "test_scan_binding_links",
    srcs = ["test_scan_binding_links.mojo"],
    deps = [
        "//src/arrow:arrow",
        "//src/broker:broker",
        "//src/objectstore:objectstore",
        "//src/plan_ir:plan_ir",
        "//src/plan_wire:plan_wire",
        "//src/scan_source:scan_source",
        "//src/search_scan:search_scan",
    ],
    # Staged at their repository paths, the same paths plan_wire's own
    # golden test opens.
    data = {
        _GOLDEN + name + ".hex": "//src/plan_wire:tests/fixtures/golden/" + name + ".hex"
        for name in ["index_pinned", "topic_live"]
    },
)
