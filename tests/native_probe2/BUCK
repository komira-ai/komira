load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load(":probe.bzl", "awslc_prefix_header", "c_exe", "elf_report", "native_probe2", "native_shared")

# EXPERIMENT (branch exp/native-probe-2, never merged). Does ONE shared
# library, libkomira_native.so.1, holding all komira-owned C plus the vendored
# aws-lc and snappy, work for Mojo consumers of a pixi-shaped prefix?
#
#   ./buck2 build komira//tests/native_probe2:report --show-output
#
# The library: the real komira C shims, aws-lc built with its symbol prefix
# komira_awslc_ (third_party/aws-lc:crypto_komira_prefixed), snappy with its C
# API renamed komira_snappy_* (third_party/snappy:snappy_komira_native), linked
# with --whole-archive, -Bsymbolic and a version script exporting only the names
# Mojo code calls (libkomira_native.map). The cases are in case.sh; R0, B0, LR1
# and LB1 are controls. A case action always succeeds; its log holds MOJO_RC=,
# RUN_RC= and the program's CHECK/RESULT lines.

# The probe's nm/readelf.
c_exe(
    name = "elfsyms",
    src = "elfsyms.c",
)

# aws-lc's prefix header, from the unprefixed archive's symbol table.
awslc_prefix_header(
    name = "awslc_prefix_h",
    archive = "//third_party/aws-lc:crypto[static-pic]",
    prefix = "komira_awslc",
    tool = ":elfsyms",
    visibility = ["PUBLIC"],
)

staged_files(
    name = "sha256_hw_files",
    srcs = ["komira_crypto_sha256_hw.c"],
)

cxx_library(
    name = "komira_crypto_sha256_hw",
    srcs = [":sha256_hw_files[komira_crypto_sha256_hw.c]"],
    preprocessor_flags = ["-include", "$(location :awslc_prefix_h)"],
)

_SHIMS = [
    "//src/komira_libc:komira_libc_posix",
    "//src/komira_concurrency:komira_concurrency_pool_depth",
    "//src/komira_scan_source:komira_scan_source_inmem_id",
    "//src/komira_async:komira_async_posix",
    "//src/komira_fs:komira_fs_posix",
    "//src/komira_log:komira_log_holder",
    "//src/komira_metrics:komira_metrics_ea_flag",
    "//src/komira_objectstore:komira_objectstore_posix",
    "//src/komira_supervisor:komira_supervisor_proc",
]

_PREFIXED = [
    "//third_party/aws-lc:crypto_komira_prefixed",
    "//third_party/snappy:snappy_komira_native",
    ":komira_crypto_sha256_hw",
]

_FLAGS = ["-Wl,-Bsymbolic", "-Wl,--gc-sections"]

# Every komira cxx_library as it is on main, komira_core's copy included: the
# duplicate definitions the link reports (expected to fail).
native_shared(
    name = "dup_link",
    archives = [t + "[static-pic]" for t in _SHIMS + ["//src/komira_core:komira_core_posix"] + _PREFIXED],
    expect_failure = True,
    link_flags = _FLAGS,
    soname = "libkomira_native.so.1",
    version_script = "libkomira_native.map",
)

# One owner per symbol (probe only): komira_core's posix file is dropped; its
# 23 functions are all defined by komira_libc, komira_concurrency or
# komira_scan_source.
native_shared(
    name = "libkomira_native",
    archives = [t + "[static-pic]" for t in _SHIMS + _PREFIXED],
    link_flags = _FLAGS,
    soname = "libkomira_native.so.1",
    version_script = "libkomira_native.map",
)

# The control for case (c): unprefixed aws-lc and snappy, no version script,
# no -Bsymbolic. It exports the OpenSSL and snappy names.
native_shared(
    name = "libkomira_native_leaky",
    archives = [t + "[static-pic]" for t in _SHIMS + [
        "//third_party/aws-lc:crypto",
        "//third_party/snappy:snappy",
    ]],
    soname = "libkomira_native_leaky.so.1",
)

elf_report(
    name = "exports",
    libs = [
        ":libkomira_native",
        ":libkomira_native_leaky",
    ],
    tool = ":elfsyms",
    version_script = "libkomira_native.map",
)

mojo_library(
    name = "knative",
    srcs = ["knative/__init__.mojo"],
    conda = False,
)

native_probe2(
    name = "report",
    cases = ["R0", "R1", "B0", "B1", "IR1", "IB1", "LR1", "LB1"],
    consumers = [
        "consumers/consumer_interpose.mojo",
        "consumers/consumer_leaky.mojo",
        "consumers/consumer_main.mojo",
    ],
    extra_logs = [
        ":dup_link",
        ":libkomira_native[log]",
        ":exports",
    ],
    leaky = ":libkomira_native_leaky",
    mojoc = {
        "knative": ":knative",
        "komira_libc": "//src/komira_libc:komira_libc",
    },
    script = "case.sh",
    shared = ":libkomira_native",
    tool = ":elfsyms",
)
