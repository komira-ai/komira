load("@komira//tools/build/mojo:defs.bzl", "mojo_test")

# Which spelling of each construct Mojo 1.1 removed the 1.0.0 compiler accepts.
# One dependency-free test per spelling, so a refused spelling fails only its
# own target. This package is removed once each verdict is recorded.
[
    mojo_test(
        name = name,
        srcs = [name + ".mojo"],
    )
    for name in [
        "test_array",
        "test_atomic_value_type",
        "test_atomic_type_of_ctor",
        "test_string_capacity_bytes",
        "test_conforms_to_refinement",
        "test_deinitable",
        "test_raw_file_descriptor",
    ]
]
