        the attempt count and the length of the status text, never the text:
        the message is the server's. An error without a status (a transport
        fault before any status arrived) is returned unchanged."""
    var status = parse_grpc_status_code(text)
    if status < 0:
        return Error(text)
    return gcp_grpc_status_error(rpc, status, text)


# gRPC client for `google.firestore.v1.Firestore`, authorized by a komira_gcp_core token source.
struct FirestoreClient[C: Connector, T: GcpTokenSource](Movable, Deinitable):
    """The generated gRPC client for the Google Cloud service `Firestore`,
        parametric over the HTTP connector `C` and the access-token source `T`.

        Classic gRPC (`ProtocolGrpcProto`) through `GrpcClient[C]`. Every call
        carries `authorization: Bearer <token>`, a token `T` (a
        `komira_gcp_core.GcpTokenSource`) returns for that call, set on the call's
        `CallOptions.raw_metadata`: the client reads no environment and holds
        no credential of its own. A call that ends in a gRPC status raises
        `komira_gcp_core.gcp_grpc_status_error`, whose text starts with a
        `[grpc:<google.rpc.Code>]` anchor that komira_grpc's
        `parse_grpc_status_code` reads.

        The full path for each method is `/google.firestore.v1.Firestore/<MethodName>`."""

    # Google APIs serve classic gRPC; Connect is not offered.
    comptime P = ProtocolGrpcProto

    var _client: GrpcClient[Self.C]
    """The gRPC transport."""

    var _token_source: Self.T
    """Where each call's bearer token comes from."""

    def __init__(out self, var client: GrpcClient[Self.C], var token_source: Self.T):
        self._client = client^
        self._token_source = token_source^

    def token_source(mut self) -> ref [self._token_source] Self.T:
        """The token source, for example to drop a cached token after a call
            raised UNAUTHENTICATED (`parse_grpc_status_code(String(e)) == 16`)."""
        return self._token_source

    def _authorize(mut self, mut opts: CallOptions) raises:
        """The token hook: one token per call, set as the `authorization` entry
            of `opts.raw_metadata`. komira_grpc sends that entry verbatim and once,
            so a replayed attempt carries the same header, not a second one. An
            empty token is refused rather than sent as `Bearer `."""
        var bearer = self._token_source.access_token()
        if bearer.byte_length() == 0:
            raise Error("the token source returned an empty access token")
        opts.raw_metadata.set(String("authorization"), String("Bearer ") + bearer)

    def listen[RT: Runtime](mut self, var codec: BidiStreamCodec[Self.P], var opts: CallOptions, now_us: Int, mut reactor: Reactor[RT.Sink], ref token: CancellationToken) raises -> ServerStreamDecoder[Self.P]:
        """Bidirectional RPC — `/google.firestore.v1.Firestore/Listen`.

            The caller buffers N request messages into `codec.encoder` + `mark_close()`
            before calling; returns the response decoder (decode each via `ListenResponse.decode`).
            """
        self._authorize(opts)
        try:
            return self._client.bidi_stream[RT, Self.P](
                String("/google.firestore.v1.Firestore/Listen"),
                codec^,
                opts,
                now_us,
                reactor,
                token,
            )
        except e:
            raise _gcp_grpc_error(String("/google.firestore.v1.Firestore/Listen"), String(e))

