        if path.byte_length() == 0:
            # Only a path variable that does not match this binding raises here.
            try:
                path += String("/v1")
                path += String("/")
                path += _rest_path_var(_rest_to_str(req.parent), String("projects/*/databases/*/documents/*/**"), String("parent"))
                path += String(":runQuery")
