load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Test-only: the generated AWS Secrets Manager client
# (komira_aws_secretsmanager) against a stateful fake of the service, over a
# real socket on 127.0.0.1, in one process on two threads (komira_fork_join).
# The fake is a komira_http_server RequestDispatcher speaking awsJson 1.1: it
# verifies each request's SigV4 signature itself (komira_crypto, not
# komira_aws_core), keeps secrets, their versions and staging labels, holds
# a name while its secret is scheduled for deletion, honours
# ClientRequestToken idempotency, and answers scripted 500s. The library
# holds the fake, its verifier, the duet runner and the client pointed at
# the fake with canned credentials (the AWS documentation's example key);
# the tests are the point. Nothing ships, so `conda = False`.
#
# The tests, each run as a build action:
#   test_secret_lifecycle -- CreateSecret (token filled by the client),
#     GetSecretValue, PutSecretValue, DescribeSecret (versions and stages),
#     DeleteSecret with a recovery window, CreateSecret on the held name
#     refused, RestoreSecret, GetSecretValue; the fake's request log exactly;
#     no error text the client raised holds a secret value, although the
#     fake's error bodies carried it (the process's stdout is not captured).
#   test_retry_reuses_token -- a write applied then answered 500, and one
#     answered 500 before it is applied: each resend carries the same
#     ClientRequestToken, byte for byte, and each write is applied once;
#     the server's stdout lines for the two 500s, rendered with its own
#     error_response_log_line, hold no value (a check of the fake).
#   test_signature_refusals -- the verifier against a signature computed
#     outside komira for a request in the SigV4 suite's get-vanilla shape
#     (accepted; a changed digit, a changed body, another service's scope and
#     an unknown key refused), and a client with a wrong secret key refused
#     InvalidSignatureException over the wire.
#
# `deps` lists the Mojo packages of the full transitive closure of what the
# library and its tests import.
mojo_library(
    name = "komira_secrets_e2e",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    conda = False,
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_aws_secretsmanager:komira_aws_secretsmanager",
        "//src/komira_clock:komira_clock",
        "//src/komira_core:komira_core",
        "//src/komira_core_ffi:komira_core_ffi",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_fork_join:komira_fork_join",
        "//src/komira_hash:komira_hash",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_http_server:komira_http_server",
        "//src/komira_json:komira_json",
        "//src/komira_log:komira_log",
        "//src/komira_metrics:komira_metrics",
        "//src/komira_name_registry:komira_name_registry",
        "//src/komira_net:komira_net",
        "//src/komira_retry:komira_retry",
        "//src/komira_spsc_ring:komira_spsc_ring",
        "//src/komira_trace:komira_trace",
        "//src/komira_uuid:komira_uuid",
        "//src/komira_xml:komira_xml",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_retry_reuses_token.mojo",
        "tests/test_secret_lifecycle.mojo",
        "tests/test_signature_refusals.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
