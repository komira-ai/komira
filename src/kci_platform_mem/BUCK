load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The in-memory reference platforms: "mem" (complete) and "mem-lite"
# (partial: no job, no public ingress). The executable specification of a
# platform, the offline test double, and the offline proof that a graph a
# platform cannot host is refused before anything is created.
#
# komira_proto_codec is here for the welded tests, which read graphs in the
# proto3 JSON form an author writes.
mojo_library(
    name = "kci_platform_mem",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_iac:kci_iac",
        "//src/kci_platform:kci_platform",
        "//src/kci_resource_proto:kci_resource_proto",
        "//src/komira_proto_codec:komira_proto_codec",
    ],
    test_srcs = [
        "tests/test_mem_conformance.mojo",
        "tests/test_mem_lite_refuses_offline.mojo",
    ],
    visibility = ["PUBLIC"],
)
