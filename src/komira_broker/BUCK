load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The object-store-native message broker core: the produce path (coalesced
# produce over a conditional-write store), partition maps and assignment
# (split, merge, triggers, lease generations), the consumer source and
# read-committed isolation, transactions, producer idempotence, retention and
# log compaction, and the sub-lineage write path. Storage is a trait
# parameter (komira_objectstore's ConditionalWriteStore / AsyncCasStore), so
# the concrete cloud conformer is chosen by the program that instantiates the
# broker, not by this library.

mojo_library(
    name = "komira_broker",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
