load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# A Model Context Protocol (MCP) server library: JSON-RPC 2.0 framing, the
# session lifecycle (initialize, version negotiation, the initialized
# notification), ping, tools and resources, behind two provider traits. It
# does no I/O: a transport hands McpServer.handle one message as text and
# writes back what it returns. See src/komira_mcp_server/__init__.mojo.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the tests of tests/ have passed. The package depends on
# komira_encoding and komira_json, sibling packages (`[dependencies]` of mopm.toml): its `:lib` is
# built from their `:lib`.
mojo_package(path = ".")

# `:komira_mcp_server`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of
# those packages: the rule refuses a list that is not the closure `:lib` was built from. It carries
# the README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_mcp_server",
    deps = [
        "//src/komira_encoding:komira_encoding",
        "//src/komira_json:komira_json",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_mcp_server/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_mcp_server-0.1.0-mojo1.0.0_0.conda`), which records komira_encoding and komira_json
# as dependencies and holds neither package's files. `members` is the manifests of the path
# dependencies, staged at their repository paths, because `mopm pack` reads the manifest of each
# beside the one it is given. `:lib` exists only once the tests passed, so this file exists only
# then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step of a CI job
# that takes this target's output.
mojo_conda(
    name = "conda",
    dir = "src/komira_mcp_server",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_encoding": "//src/komira_encoding:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_83",
    package = "komira_mcp_server",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/`, and exactly the two dependencies, which is what installing
# the package pulls in. Red when the manifest drops a dependency, names another range, or the file
# carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_encoding >=0.1,<0.2",
        "mojo-komira_json >=0.1,<0.2",
    ],
    package = "komira_mcp_server",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_mcp_server`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_mcp_server_conda",
    lib = ":komira_mcp_server",
    summary = "The `komira_mcp_server` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
