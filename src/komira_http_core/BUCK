# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps), so a missing dep fails here, in review, and
# not only in the compile.
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)

export_file(name = "tests/fixtures/tls/leaf_cert.pem", visibility = ["PUBLIC"])
export_file(name = "tests/fixtures/tls/leaf_key.pem", visibility = ["PUBLIC"])
export_file(name = "tests/fixtures/tls/root_ca.pem", visibility = ["PUBLIC"])
export_file(name = "tests/fixtures/smoke_cert.pem", visibility = ["PUBLIC"])
