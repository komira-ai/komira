load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The part of the HTTP layer a client and a server share: the h1 and h2 codecs
# (HPACK included), TLS over s2n-tls (which carries aws-lc's libcrypto; the TLS
# layer declares its functions itself, so s2n is a dep), and the transport seam:
# the IO stream traits, plain TCP, a scripted fake, stream parking and gRPC
# trailer emission. komira_http_client and komira_http_server depend on it and
# on nothing of each other.
#
# The TLS tests read the throwaway certificates under tests/fixtures, which the
# client package's tests and komira_http_tls_e2e's read too: the ones they use
# are exported below.

mojo_library(
    name = "komira_http_core",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_libc:komira_libc",
        "//third_party/s2n-tls:s2n",
    ],
    test_srcs = [
        "tests/test_L1_h1_length_wrap.mojo",
        "tests/test_L1_tls_alpn.mojo",
        "tests/test_L1_tls_buffered_plaintext_lost_wakeup.mojo",
        "tests/test_L1_tls_cert_chain_freed.mojo",
        "tests/test_L1_tls_cert_verify.mojo",
        "tests/test_L1_tls_client_construction.mojo",
        "tests/test_L1_tls_client_disable_verify.mojo",
        "tests/test_L1_tls_client_handshake_against_test_root.mojo",
        "tests/test_L1_tls_client_sni_send.mojo",
