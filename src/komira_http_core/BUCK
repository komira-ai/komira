        "tests/test_L1_tls_handshake_departed_peer_fails_fast.mojo",
        "tests/test_L1_tls_init_process_local_not_env_inherited.mojo",
        "tests/test_L1_tls_init_refused.mojo",
        "tests/test_L1_tls_key_update.mojo",
        "tests/test_L1_tls_partial_send_resumption.mojo",
