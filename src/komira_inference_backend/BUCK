load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")

# The local-inference engine seam: the InferenceBackend trait (launch, health,
# teardown, base_url over an OpenAI /v1 endpoint), a connect-to-running
# MlxBackend, and the conformers that spawn mlx_lm.server, llama-server or
# mlx-openai-server as a child process (komira_supervisor, inherited stdio),
# probe it over HTTP (komira_http_client, on a komira_async BlockingRuntime,
# with a deadline per probe) and stop it on teardown. The probes are
# parametric over a komira_http_core Connector.
#
# The welded tests run no real engine and touch nothing beyond 127.0.0.1:
# - test_inference_backend_port: a conformer declared in the test and
#   MlxBackend through one generic, the full argv of each child-spec factory,
#   and the comptime-OS default URL.
# - test_spawning_backend: the full argv each spawning backend would spawn
#   (defaults, explicit host and port, llama-server's --parallel flags), both
#   probes and health() against a refused port, and launch() of a binary that
#   does not exist, which raises naming the spawn failure.
# - test_spawning_backend_live: the backends against stub_openai_server, a
#   stand-in engine built below and staged as the test's data: probes that
#   succeed, a wrong model, a 5xx and a stalled server; launch, health,
#   teardown and relaunch of all three backends; an engine that logs more
#   than a pipe holds, one that exits at once, one that never serves; and a
#   reused server that teardown leaves running.
# - README.md's example: builds a llama-server backend and checks its URL and
#   GPU flag; spawns nothing.
mojo_library(
    name = "komira_inference_backend",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_supervisor:komira_supervisor",
    ],
    test_data = {
        "tests/test_spawning_backend_live.mojo": {
            "stub": ":stub_openai_server[runnable]",
        },
    },
    test_srcs = [
        "tests/test_inference_backend_port.mojo",
        "tests/test_spawning_backend.mojo",
        "tests/test_spawning_backend_live.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The stand-in engine test_spawning_backend_live spawns; see the header of the
# file. Test data, not a shipped program.
mojo_binary(
    name = "stub_openai_server",
    srcs = ["tests/stub_openai_server.mojo"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps), so a missing dep fails here, in review, and
# not only in the compile.
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
