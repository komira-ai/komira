load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The datasets of the komira benchmarks: a manifest type (name, scale, files with
# expected size, sha256 and row count, any of which may be unrecorded) and a
# manifest for each supported dataset (TPC-H sf1, sf10, sf100, ClickBench hits, a
# generated h2o-style group-by table and join tables); a verifier that checks a
# cache directory against a manifest; a lock file that records the fingerprint of
# the dataset a run used; and a seeded, deterministic generator of the h2o-style
# tables that writes Parquet through komira_parquet_writer. It ships no data,
# downloads nothing and generates no TPC-H: the user supplies those files.
#
# The welded tests (each file's header says what it proves):
# - test_manifest: the supported manifests, TPC-H row counts, ClickBench's
#   recorded size and rows, no unverified checksum recorded, the h2o sizes,
#   the refusals of a malformed manifest.
# - test_verify: SHA-256 against known digests and across chunk boundaries,
#   verified, missing, truncated, altered and unrecorded files, the report.
# - test_lock: the exact lock text and fingerprint, decode, the fingerprint
#   following every field, edited and malformed locks refused, a lock built only
#   from a usable report, one lock file per dataset and scale written once, a
#   cache directory verified against a lock.
# - test_h2o_golden: the SHA-256 of small generated tables, pinned.
# - test_h2o_groupby: the number source, the same bytes for the same seed and
#   size, the decoded rows against the stream, ranges, batch independence.
# - test_h2o_join: the same for x, small, medium and big, and the keys that join.
# - test_h2o_files: generated files verified and locked, never regenerated.
# - test_no_env_reads: the sources read no environment, hold no raw pointer in a
#   public signature, import only these deps, and use no stdlib parallelize.
_SRCS = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"])

mojo_library(
    name = "komira_bench_data",
    srcs = _SRCS,
    # Direct dependencies: the rule adds each one's own closure to the compiler.
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_collections:komira_collections",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_parquet_api:komira_parquet_api",
        "//src/komira_parquet_writer:komira_parquet_writer",
    ],
    # The reader decodes the generator's bytes in the tests; the scratch
    # directory is the test runner's. Neither is a dependency of the library.
    test_deps = [
        "//src/komira_buffer:komira_buffer",
        "//src/komira_parquet:komira_parquet",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_data = {
        "tests/test_no_env_reads.mojo": {
            "src/" + f: f
            for f in _SRCS
        },
    },
    test_srcs = [
        "tests/test_h2o_files.mojo",
        "tests/test_h2o_golden.mojo",
        "tests/test_h2o_groupby.mojo",
        "tests/test_h2o_join.mojo",
        "tests/test_lock.mojo",
        "tests/test_manifest.mojo",
        "tests/test_no_env_reads.mojo",
        "tests/test_verify.mojo",
    ],
    visibility = ["PUBLIC"],
)
