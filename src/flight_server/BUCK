load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The Arrow Flight service over the broker: `FlightBrokerService` serves
# GetFlightInfo, DoGet and DoPut on the gRPC dispatch seams of http_core,
# and `FlightBrokerData` is the Arrow-native data plane under it (one broker
# produce core and one consume core per partition per topic, over an in-memory
# conditional-write store). The wire messages and the Arrow IPC bridge are in
# flight.
#
# Every test is hermetic. tests/test_flight_live_socket.mojo runs a real
# HttpServer with the service over TLS + h2 on the loopback address against a
# real GrpcClient, server and client on two fork_join threads, reading
# http_core's exported TLS fixtures. Welded tests get no test-only deps,
# so the packages that test imports are listed here: grpc, clock,
# atomic_alias and fork_join are TEST-ONLY deps (no source outside
# tests/ imports them). http_server and async_rt are in the closure
# through connect and http_core.

_TLS_FIXTURES = {
    "src/http_core/tests/fixtures/tls/leaf_cert.pem": "//src/http_core:tests/fixtures/tls/leaf_cert.pem",
    "src/http_core/tests/fixtures/tls/leaf_key.pem": "//src/http_core:tests/fixtures/tls/leaf_key.pem",
    "src/http_core/tests/fixtures/tls/root_ca.pem": "//src/http_core:tests/fixtures/tls/root_ca.pem",
}

mojo_library(
    name = "flight_server",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/arrow_ipc:arrow_ipc",
        "//src/async_rt:async_rt",
        "//src/atomic_alias:atomic_alias",
        "//src/broker:broker",
        "//src/clock:clock",
        "//src/containers:containers",
        "//src/connect:connect",
        "//src/flight:flight",
        "//src/fork_join:fork_join",
        "//src/grpc:grpc",
        "//src/http_client:http_client",
        "//src/http_core:http_core",
        "//src/http_server:http_server",
        "//src/objectstore:objectstore",
        "//src/op_sources:op_sources",
    ],
    test_srcs = [
        "tests/test_flight_broker_data.mojo",
        "tests/test_flight_live_socket.mojo",
        "tests/test_flight_multipartition.mojo",
        "tests/test_flight_service_dispatch.mojo",
    ],
    test_data = {
        "tests/test_flight_live_socket.mojo": _TLS_FIXTURES,
    },
    visibility = ["PUBLIC"],
)
