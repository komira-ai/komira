        "tests/test_csv_cov_parallel_fallbacks.mojo",
        "tests/test_csv_cov_parallel_headerless.mojo",
        "tests/test_csv_cov_parallel_typed.mojo",
        "tests/test_csv_cov_reader.mojo",
        "tests/test_csv_cov_scanner_edges.mojo",
        "tests/test_csv_cov_sink_paths.mojo",
        "tests/test_csv_cov_sink_types.mojo",
        "tests/test_csv_cov_temporal_inference.mojo",
        "tests/test_csv_dtype_completion.mojo",
