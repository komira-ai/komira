load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The one Parquet footer cache and the footer reader built on it: `FooterCache`
# (a locked, shared cache of parsed footers whose errors name the file),
# `ParquetFooters` (komira_sql's `SqlParquetFooters` over that cache, with table
# registration and the registered-schema check) and `lowering_facts`
# (komira_lowering's `LoweringInputs` built from the same cache the binder read).
# It is a package of its own, not part of komira_sdk_exec, because the engine
# context that will hold the cache is not written yet; the context holds a
# `FooterCache` handle when it lands (README.md).
#
# The welded tests (each file's header says which defect it catches):
# - test_footer_cache: the footer of a written file (schema, row count, row
#   groups), one read for many lookups and handles, named errors for a missing,
#   text or short file, no cached failure, change detection, invalidation, and
#   the null count (summed over every row group, unknown when one records none).
# - test_bind_and_lower: bind_statement and lower over real footers through one
#   cache, the statistics in the inputs, a registered schema that disagrees
#   refused by name, and a missing or text file named at bind.
#
# deps is the full transitive closure: komira_parquet (the footer reader),
# komira_sql (the binder's trait) and komira_lowering (the inputs) with theirs.
# komira_runtime_paths and komira_parquet_writer are for the welded tests only.
mojo_library(
    name = "komira_parquet_footers",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
