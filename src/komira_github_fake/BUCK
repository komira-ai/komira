load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

_KEY = {
    "src/komira_http_core/tests/fixtures/tls/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
}

mojo_library(
    name = "komira_github_fake",
    srcs = glob(["*.mojo"]),
    deps = [
        "//src/komira_crypto:komira_crypto",
        "//src/komira_datetime:komira_datetime",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_github:komira_github",
        "//src/komira_json:komira_json",
    ],
    test_srcs = [
        "tests/test_client_auth.mojo",
        "tests/test_client_routes.mojo",
        "tests/test_fake_install.mojo",
    ],
    test_data = {
        "tests/test_client_auth.mojo": _KEY,
        "tests/test_client_routes.mojo": _KEY,
        "tests/test_fake_install.mojo": _KEY,
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
