load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Binary-to-text encodings (base64, base64url, base32, hex) and PEM armor
# (RFC 7468) in Mojo with no dependencies. The codecs decode in constant
# time; the PEM armor scan does not. The one call into C is `wipe_bytes`
# (src/komira_encoding/codec.mojo), which zeroes decoded secrets through
# libc's `explicit_bzero` (`memset_s` on macOS): libc symbols only, so the
# package has no native archive. See src/komira_encoding/__init__.mojo.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_encoding`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`, with `[file]` and `[generated]`,
# which kci_validate's golden test reads): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_encoding",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_encoding/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_encoding-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step
# of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_25",
    package = "komira_encoding",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the packages whose own conda packages require this one and for the release machine, which
# still builds it (release/artifacts.textproto): komira's conda packer over `:komira_encoding`. It goes
# when those packages move to mopm. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_encoding_conda",
    lib = ":komira_encoding",
    summary = "The `komira_encoding` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
