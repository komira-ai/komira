load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Binary-to-text encodings (base64, base64url, base32, hex) and PEM armor
# (RFC 7468) in pure Mojo with no dependencies. The codecs decode in constant
# time; the PEM armor scan does not. See __init__.mojo.
mojo_library(
    name = "komira_encoding",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_base64.mojo",
        "tests/test_base32.mojo",
        "tests/test_hex.mojo",
        "tests/test_invalid_input.mojo",
        "tests/test_crypto_compat.mojo",
        "tests/test_pem.mojo",
    ],
    visibility = ["PUBLIC"],
)
