load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# AWS Lambda: a restJson1 client generated at build time from botocore's
# lambda model (//third_party/botocore, pinned by sha256; nothing of it is
# copied here), in client mode: each operation's request builder and
# response parser, its endpoint resolved through the service's published
# endpoint ruleset and partition table, embedded in the module, and
# `LambdaClient`, which resolves each call's endpoint and sends
# through komira_aws_core's send_sigv4_signed_request (signing name
# `lambda`, signed per attempt, retried as the AWS SDKs' standard mode
# does) over the komira_http_core Connector it is given.
#
# Each operation's path carries its own API date, read from the model:
# `/2015-03-31` for most, `/2017-10-31` for PutFunctionConcurrency and
# `/2021-10-31` for the function URL operations.
#
# `operations` is a function's lifecycle as a deployment drives it: an
# image function created, read, its code and configuration updated, a
# permission added for its front door, its reserved concurrency put, its
# function URL created, read and updated, the function invoked, and
# deleted. An operation joins the list with its own rows in the tests
# below.
#
# Invoke's `Payload` is the request body as given (a blob payload), typed
# `application/octet-stream` as Smithy's restJson1 types a blob payload;
# the response payload is the body, and a function's own failure is the
# `X-Amz-Function-Error` header of a 200.
#
# The library is gated by its layout probe and these tests, hand-written
# against the AWS Lambda API reference (no upstream test body is copied):
# test_lambda_requests (each operation's method, path, query, headers and
# body, exactly, and the model's bounds refused before the wire),
# test_lambda_responses (each result decoded, and the restJson1 error
# forms), test_lambda_endpoints (botocore's endpoint cases for lambda
# through every operation's resolver, the regional, FIPS, dual-stack and
# LocalStack endpoints, and two requests signed end to end against
# independently computed signatures), test_lambda_client (the generated
# client over a scripted connector: two calls answered, one error per verb
# raised under its code, and each verb's request as it reached the wire,
# through komira_aws_core's AwsEchoConnector) and _no_env_reads (written
# by mojo_aws_client: the package reads no environment).
#
# No test here talks to the service.

_M = botocore_model("lambda")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("lambda")

mojo_aws_client(
    name = "komira_aws_lambda",
    endpoint_rules = _M.endpoint_rules,
    mode = "client",
    model = _M.model,
    model_sha256 = _M.sha256,
    operations = [
        "AddPermission",
        "CreateFunction",
        "CreateFunctionUrlConfig",
        "DeleteFunction",
        "GetFunction",
        "GetFunctionUrlConfig",
        "Invoke",
        "PutFunctionConcurrency",
        "UpdateFunctionCode",
        "UpdateFunctionConfiguration",
        "UpdateFunctionUrlConfig",
    ],
    partitions = _M.partitions,
    test_data = {
        "tests/test_lambda_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_lambda_client.mojo",
        "tests/test_lambda_endpoints.mojo",
        "tests/test_lambda_requests.mojo",
        "tests/test_lambda_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` and `<op>_with` take a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
