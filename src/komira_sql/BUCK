load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The analytical SQL front end's tokenizer, parser, parsed AST, scalar-function table and catalogs: tokens, the statement parser, expression, relation and statement nodes, one row per SQL function name, the table and UDF catalogs a query resolves names against,
# the bind-time schemas and scan leaves of the read_csv / read_json / read_avro table functions,
# and the binder (sql_binder and its sql_bind_* modules) that turns a parsed statement into a LogicalPlan.
