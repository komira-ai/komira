load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The typed hash join of the engine's stage pipelines: the build table
# `JoinBuildTable[KB, *Payload]` (a key block of any arity, a pack of payload
# columns, open addressing with linear probing, one slot per build row), its
# key and payload columns and key model, its free functions over typed keys,
# and the JOIN_BUILD and JOIN_PROBE breaker states.
mojo_library(
