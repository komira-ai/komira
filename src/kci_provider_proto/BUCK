load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The build/test provider registry schema (`provider.proto`, proto package
# `kci.deploy.v1`). Standalone: it imports no other proto. Reach the
# surface via
#   from kci_provider_proto.provider import (
#       Provider, ProviderKind, Capability, ProviderPlatform,
#       ProviderBackendConfig,
#   )
# The `.proto` has the import path `kci/deploy/v1/provider.proto`, which
# is the descriptor's file name and the `# Source:` line of the generated
# `provider.mojo`. The generated code imports `komira_proto_codec`, its only
# runtime dependency.
mojo_proto_library(
    name = "kci_provider_proto",
    srcs = ["provider.proto"],
    import_prefix = "kci/deploy/v1",
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    visibility = ["PUBLIC"],
)
