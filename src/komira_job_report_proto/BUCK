load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The job report wire (`komira/job_report/v1/job_report.proto`, package
# `komira.job_report.v1`): a supervised job's phase, progress, message and
# failure details (`JobHeartbeat`), and the reply that says CONTINUE or CANCEL
# (`JobHeartbeatReply`). komira_job_supervisor sends it; a receiver depends on
# this package alone, not on the supervisor.
#
#   from komira_job_report_proto.job_report import (
#       JobHeartbeat, JobHeartbeatReply, JobFailure, JobPhase, JobDirective,
#   )
#
# It imports no other `.proto`. The welded tests round-trip every message, pin
# every JobHeartbeat and JobFailure field number by exact bytes, and pin what
# an unknown enum number decodes to.

# The generator's half: `komira_job_report_proto_generated_gen` writes the Mojo of the `.proto` files, `komira_job_report_proto_generated_fresh` holds the
# committed directory `generated/komira_job_report_proto_generated/` to it, byte for byte, and fails with the command that regenerates
# (tools/build/gen/README.md). That directory is the library of mopm.toml (`[targets] lib`), compiled as the module
# `komira_job_report_proto`: `import_name` is that module's name, and the rule names the directory after the target, which
# `:komira_job_report_proto` below cannot be. The library this call declares itself (`:komira_job_report_proto_generated`, the same files without the
# tests) is not what dependents use. Regenerate with
#   ./buck2 run komira//tools/build/gen:regen -- komira//src/komira_job_report_proto:komira_job_report_proto_generated
mojo_proto_library(
    name = "komira_job_report_proto_generated",
    srcs = ["job_report.proto"],
    import_name = "komira_job_report_proto",
    import_prefix = "komira/job_report/v1",
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    visibility = ["PUBLIC"],
)

# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file, compiled from the committed directory, and exists only once the tests of tests/
# have passed.
mojo_package(path = ".")

# `:komira_job_report_proto`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`.
mojo_adopted_library(
    name = "komira_job_report_proto",
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["generated/komira_job_report_proto_generated/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves. `members` is the
# manifests of the path dependencies of the closure, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given.
mojo_conda(
    name = "conda",
    dir = "generated/komira_job_report_proto_generated",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_encoding": "//src/komira_encoding:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_proto_codec": "//src/komira_proto_codec:mopm.toml",
        "../komira_protobuf": "//src/komira_protobuf:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_job_report_proto",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file: this package's own `.mojoc` and nothing else
# under `lib/mojo/`, and exactly the direct dependencies of mopm.toml.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_proto_codec >=0.1,<0.2"],
    package = "komira_job_report_proto",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_job_report_proto`. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_job_report_proto_conda",
    lib = ":komira_job_report_proto",
    summary = "The `komira_job_report_proto` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

