load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Where a running program finds its files, from its own executable path; see
# src/komira_runtime_paths/__init__.mojo. The test runs in the installed layout
# (`test_layout = "installed"`), the layout the library reads: the test binary is
# <root>/bin/<exe>, the files it declares under `test_data` are under <root>/share
# (each key relative to share/), the working directory is <root>, and TMPDIR,
# TEST_TMPDIR and HOME are private to the run. The test checks all of that, and the
# variable it declares under `test_env`.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the test of tests/ has passed.
mojo_package(
    path = ".",
    test_data = {
        "tests/test_runtime_paths.mojo": {
            "fixtures/greeting.txt": "fixtures/greeting.txt",
            "renamed/other.txt": "fixtures/other.txt",
        },
    },
    test_env = {"KOMIRA_TEST_GREETING": "hello, env"},
    test_layout = "installed",
)

# `:komira_runtime_paths`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only
# once the test has passed. It carries the README gate too (`[tests][readme]`): the examples run
# against `:lib`; the test is not run again. The old label,
# //tools/build/mojo/runtime_paths:komira_runtime_paths, is an alias of it.
mojo_adopted_library(
    name = "komira_runtime_paths",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_runtime_paths/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_runtime_paths-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the test passed, so
# this file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it
# is a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_42",
    package = "komira_runtime_paths",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_runtime_paths`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_runtime_paths_conda",
    lib = ":komira_runtime_paths",
    summary = "The `komira_runtime_paths` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
