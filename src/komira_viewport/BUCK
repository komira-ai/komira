load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The viewport protocol v1, request half: a positional byte cursor
# (LEB128 varints, zigzag, fixed floats, length-prefixed strings), the
# versioned wire codec for Expr trees under a v1 allow-list, the grid-ticket
# model and codec, the grid-response envelope, and the untrusted-ticket
# validation boundary (size, depth and count caps, the Expr allow-list, UDF
# rejection). A viewport server decodes and validates a client's ticket with
# it; it reads no file and serves nothing.
#
# It depends on komira_plan_expr for Expr / ScalarValue and on komira_protobuf for
# the varint primitive, so it builds and tests without the engine.
#
# The welded tests:
# - test_viewport_expr_roundtrip: every allow-listed Expr shape encodes and decodes
#   back to an identical structural hash.
# - test_viewport_hostile_ticket: malformed and out-of-allow-list tickets (truncated,
#   oversized, too deep, disallowed tags and ops, UDFs, duplicate output names)
#   are rejected with an error, never accepted.
# - test_viewport_bytes_cursor: the byte cursor by its exact bytes; the UTF-8
#   gate swept across every sequence length and RFC 3629 boundary; every
#   truncation and length-cap refusal.
# - test_viewport_codec_reject: the op-code allow-lists swept over all 256
#   byte values, the depth cap at its boundary through every recursive site,
#   scalar wire tags, and every refusal of the response envelope.
# - test_viewport_ticket_limits: the ticket's count caps, node budget, size and
#   window bounds at their boundaries, and which refusal wins when two faults
#   meet.
mojo_library(
    name = "komira_viewport",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_collections:komira_collections",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_protobuf:komira_protobuf",
    ],
    test_srcs = [
        "tests/test_viewport_expr_roundtrip.mojo",
        "tests/test_viewport_hostile_ticket.mojo",
        "tests/test_viewport_bytes_cursor.mojo",
        "tests/test_viewport_codec_reject.mojo",
        "tests/test_viewport_ticket_limits.mojo",
    ],
    visibility = ["PUBLIC"],
)
