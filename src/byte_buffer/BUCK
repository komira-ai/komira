load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")
load("@komira//tools/build/toolchains:mojo_versions.bzl", "mojo_version")

# Aligned, shared and memory-mapped byte buffers and the region trait that columns sit on.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# host_probe, libc and simd_ops, sibling packages (`[dependencies]` of mopm.toml): its
# `:lib` is built from their `:lib`.
mojo_package(path = ".")

# `:byte_buffer`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages: the rule refuses a list that is not the closure `:lib` was built from. It carries the
# README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "byte_buffer",
    deps = [
        "//src/host_probe:host_probe",
        "//src/libc:libc",
        "//src/simd_ops:simd_ops",
    ],
    # libc links C (its posix shim), so `lib`'s closure carries that archive and a dependent's link
    # takes it from here. This package owns no C, so it names no `c_deps`: it takes the C toolchain's
    # link facts directly.
    cxx_toolchain = "komira//tools/build/mojo:adopt_cxx_link_facts",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/byte_buffer/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira-ai.byte_buffer-0.1.0-mojo1.1.0_0.conda`), which records host_probe, libc and
# simd_ops as dependencies (`mojo-komira-ai.<name> >=0.1,<0.2`) and holds none of their files. `members` is
# the manifests of the path dependencies, staged at their repository paths, because `mopm pack` reads
# the manifest of each beside the one it is given. `:lib` exists only once the tests passed, so this
# file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a
# step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/byte_buffer",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../host_probe": "//src/host_probe:mopm.toml",
        "../libc": "//src/libc:mopm.toml",
        "../simd_ops": "//src/simd_ops:mopm.toml",
    },
    mojo = mojo_version(),
    mopm = "toolchains//:mopm_0_0_138",
    package = "komira-ai/byte_buffer",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/`, and exactly three dependencies, which is what installing
# the package pulls in. Red when the manifest drops a dependency, names another range, or the file
# carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira-ai.host_probe >=0.1,<0.2",
        "mojo-komira-ai.libc >=0.1,<0.2",
        "mojo-komira-ai.simd_ops >=0.1,<0.2",
    ],
    package = "byte_buffer",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:byte_buffer`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "byte_buffer_conda",
    lib = ":byte_buffer",
    summary = "The `byte_buffer` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
