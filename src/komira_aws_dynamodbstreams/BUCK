load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon DynamoDB Streams: an awsJson 1.0 client generated at build time
# from botocore's dynamodbstreams model (//third_party/botocore, pinned by
# sha256; nothing of it is copied here), in client mode: each operation's
# request builder and response parser, its endpoint resolved through the
# service's published endpoint ruleset and partition table, embedded in the
# module, and `DynamoDBStreamsClient`, which resolves each
# call's endpoint and sends through komira_aws_core's
# send_sigv4_signed_request (signing name `dynamodb`, the model's
# signingName) over the komira_http_core Connector it is given, retrying as
# botocore's standard mode does (komira_aws_core's aws_retry.mojo).
#
# `operations` is what a change-stream reader calls: a stream described to
# list its shards, an iterator taken on a shard, and its records read page
# by page. An operation joins the list with its own rows in the tests
# below.
#
# The library is gated by its layout probe and these tests, hand-written
# against the DynamoDB Streams API reference (no upstream test body is
# copied): test_dynamodbstreams_requests (the request each operation
# builds, exactly, and the model's bounds), test_dynamodbstreams_responses
# (each result decoded, stream records and their attribute values included,
# and the error forms read through komira_aws_core and the modeled error
# shapes), test_dynamodbstreams_endpoints (botocore's endpoint cases for
# dynamodbstreams through every operation's resolver, and the regional,
# FIPS, dual-stack and custom endpoints), _no_env_reads (written by
# mojo_aws_client: the package reads no environment) and
# test_dynamodbstreams_client (the generated client over a scripted
# connector: a call answered, an expired iterator raised under its code,
# and a request as it reached the wire, through komira_aws_core's
# AwsEchoConnector).
#
# No test here talks to the service.

_STREAMS = botocore_model("dynamodbstreams")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("dynamodbstreams")

mojo_aws_client(
    name = "komira_aws_dynamodbstreams",
    endpoint_rules = _STREAMS.endpoint_rules,
    mode = "client",
    model = _STREAMS.model,
    model_sha256 = _STREAMS.sha256,
    operations = [
        "DescribeStream",
        "GetRecords",
        "GetShardIterator",
    ],
    partitions = _STREAMS.partitions,
    test_data = {
        "tests/test_dynamodbstreams_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_dynamodbstreams_client.mojo",
        "tests/test_dynamodbstreams_endpoints.mojo",
        "tests/test_dynamodbstreams_requests.mojo",
        "tests/test_dynamodbstreams_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` takes a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
