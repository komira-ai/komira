load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The single spelling of every `Atomic` width, with zero deps. The welded test
# names all six rows (a `comptime` alias is elaborated lazily, so a row nothing
# imports is never checked) and pins each one's width, signedness and
# read-modify-write round trip. It must stay green across the Mojo 1.1 cutover
# edit: the two spellings are the same type.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the test of tests/ has passed.
mojo_package(path = ".")

# `:komira_atomic_alias`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only
# once the test has passed. It carries the README gate too (`[tests][readme]`): the examples run
# against `:lib`; the test is not run again.
mojo_adopted_library(
    name = "komira_atomic_alias",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_atomic_alias/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_atomic_alias-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the test passed, so
# this file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is
# a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_42",
    package = "komira_atomic_alias",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_atomic_alias`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_atomic_alias_conda",
    lib = ":komira_atomic_alias",
    summary = "The `komira_atomic_alias` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
