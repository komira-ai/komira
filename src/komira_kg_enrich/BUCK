load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The enrichment queue of the knowledge-graph port (docs/design/knowledge_graph_port.md,
# PR 18): a durable, partition-scoped, at-least-once queue of opaque items, the
# per-partition drain lease, the delayed-retry seam and the drain worker that
# delivers each item through an `EnrichmentSender` the host supplies and arms a
# retry for what was refused. The queue and the lease live on komira_objectstore's
# conditional-write stores. No network, vendor or vocabulary is named, and no clock
# or environment is read: time is an argument, and the fakes run on a clock a test
# advances.
#
# The welded tests: test_enrichment_queue runs one contract over the in-memory and the
# object-store queue and pins the object-store key layout and refusals;
# test_drain_lease pins exclusion, expiry, epochs, release and the changed-under-me
# race; test_retry_scheduler pins the fake scheduler's due times and dedup;
# test_enrichment_sender pins the fake sender; test_drain_worker pins delivery and ack, fencing,
# the retry schedule, per-source order, sender faults and the lease behaviour.
mojo_library(
    name = "komira_kg_enrich",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    # The full transitive closure of the Mojo libraries this package and its tests
    # build on: komira_objectstore and what it builds on.
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
        "//src/komira_async_api:komira_async_api",
