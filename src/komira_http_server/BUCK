load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The HTTP server over the komira_async reactor: accept loop, dispatch, serve_h2,
# the connection, HttpServer, the middleware chain, the router, and the
# serverless entry point. It depends on komira_http_core, and its tests take
# their scratch directory from `test_tmpdir()`.
#
# It is generic: no identity, tenancy or authorization model of its own. An
# embedder plugs in its own `Middleware` (see middleware/middleware.mojo), and
# tests/test_no_product_vocabulary.mojo keeps product concepts out.

mojo_library(
    name = "komira_http_server",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_libc:komira_libc",
        "//src/komira_log:komira_log",
        "//src/komira_uuid:komira_uuid",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_L0_accept_loop_rounds.mojo",
        "tests/test_L0_accept_loop_tls.mojo",
        "tests/test_L0_transport_basic.mojo",
        "tests/test_L2_codec_header_limits.mojo",
        "tests/test_L2_h2_hostile_frames.mojo",
        "tests/test_L2_h2_serve_emit.mojo",
        "tests/test_L2_h2_serve_flow_control.mojo",
        "tests/test_L2_h2_serve_frames.mojo",
        "tests/test_L2_h2_serve_read_round.mojo",
        "tests/test_L2_h2_serve_requests.mojo",
        "tests/test_L2_h2_side_tables_regression.mojo",
        "tests/test_L3_chain_composition.mojo",
        "tests/test_L3_cors.mojo",
        "tests/test_L3_error_mapper.mojo",
        "tests/test_L3_error_propagation.mojo",
        "tests/test_L3_logging.mojo",
        "tests/test_L3_metrics_sink.mojo",
        "tests/test_L3_short_circuit.mojo",
        "tests/test_L3_tracing.mojo",
        "tests/test_L4_routing_basic.mojo",
        "tests/test_chunked_request_body_dispatch.mojo",
        "tests/test_claims_principal.mojo",
        "tests/test_cloudrun_bind_before_warmup.mojo",
        "tests/test_custom_middleware.mojo",
        "tests/test_e2e_bind_any_addr.mojo",
        "tests/test_e2e_bring_up.mojo",
        "tests/test_e2e_fault_attribution_socket.mojo",
        "tests/test_e2e_full_chain.mojo",
        "tests/test_e2e_malformed_inputs.mojo",
        "tests/test_fault_attribution.mojo",
        "tests/test_fault_report_emit_line_loss.mojo",
        "tests/test_gcp_cloud_run_serve_stack.mojo",
        "tests/test_middleware_in_dispatch_path.mojo",
        "tests/test_no_product_vocabulary.mojo",
        "tests/test_presented_credential.mojo",
        "tests/test_route_pack.mojo",
        "tests/test_serverless_entry.mojo",
    ],
    test_deps = ["//src/tests/helpers/komira_test_vocabulary:komira_test_vocabulary"],
    test_data = {
        "tests/test_L0_accept_loop_tls.mojo": {
            "src/komira_http_core/tests/fixtures/tls/leaf_cert.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_cert.pem",
            "src/komira_http_core/tests/fixtures/tls/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
        },
        "tests/test_L2_h2_serve_read_round.mojo": {
            "src/komira_http_core/tests/fixtures/tls/leaf_cert.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_cert.pem",
            "src/komira_http_core/tests/fixtures/tls/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
        },
        "tests/test_L3_metrics_sink.mojo": {
            "src/komira_http_server/middleware/metrics.mojo": "middleware/metrics.mojo",
        },
        # The vocabulary test reads the library's own sources, staged at their
        # repository paths.
        "tests/test_no_product_vocabulary.mojo": glob(
            ["**/*.mojo"],
            exclude = ["tests/**/*.mojo"],
        ),
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps), so a missing dep fails here, in review, and
# not only in the compile.
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
