load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The engine's execution primitives, with no algorithm logic: the detection of
# the host profile (measured once per host; the value and morsel sizing are in
# host_profile), hardware and topology detection and the async runtime
# built from them, the dispatch-time fan-out grain, the run and segment
# execution context, the parallel RecordBatch concat,
# the memory reservation a breaker grows against the host budget, the spill
# storage and its arbitration (which breaker or partition spills under memory
# pressure), the shuffle combine buffer and retention policy, counters, the small
# shared row and column helpers, the THSPLC column codec with the RecordBatch <->
# ColumnNativeBatch bridges, and filter-by-predicate over either batch form. It
# depends on no engine package above it.
mojo_library(
    name = "engine_runtime",
