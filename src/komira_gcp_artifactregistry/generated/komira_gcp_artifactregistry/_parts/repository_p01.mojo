    def __ne__(self, other: Self) -> Bool:
        return self.value != other.value

    def number(self) -> Int:
        """The proto int32 value — the binary wire form."""
        return self.value

    def json_name(self) -> String:
        """The proto value NAME — the proto3-canonical-JSON form."""
        if self.value == 0:
            return String("VERSION_POLICY_UNSPECIFIED")
        elif self.value == 1:
            return String("RELEASE")
        elif self.value == 2:
            return String("SNAPSHOT")
        return String(self.value)

    @staticmethod
    def from_number(n: Int) -> Self:
        """Construct from the proto int32 value."""
        return Self(n)

    @staticmethod
    def from_json_name(s: String) -> Self:
        """Construct from the proto value NAME (proto3-JSON input); an
        unknown name maps to the zero value (proto3 unknown-enum contract).
        """
        if s == "VERSION_POLICY_UNSPECIFIED":
            return Self(0)
        if s == "RELEASE":
            return Self(1)
        if s == "SNAPSHOT":
            return Self(2)
        return Self(0)

    @staticmethod
    def is_known_json_name(s: String) -> Bool:
        """True iff `s` is a DECLARED value name of this enum."""
        if s == "VERSION_POLICY_UNSPECIFIED":
            return True
        if s == "RELEASE":
            return True
        if s == "SNAPSHOT":
            return True
        return False

    @staticmethod
    def known_json_names() -> String:
        """The declared value names, comma-separated — the accepted
        vocabulary, for a refusal that says what IS accepted. ERROR PATH
        ONLY: it allocates.
        """
        return String("VERSION_POLICY_UNSPECIFIED,RELEASE,SNAPSHOT")
