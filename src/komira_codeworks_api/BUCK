load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The CodeWorks HTTP surface as path classification: the git wire, the repository
# and review control routes, the liveness probes, the owning arm, and the repository
# a wire path names. Pure String functions, no dependencies. See README.md.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The welded tests:
# - test_surface: planes, sub-surfaces, owner arms, the wire's repository name, the route
#   lookalikes and unknown paths.
# - test_repo_name_and_constants: the legal-repository-name check and the declared constants.
mojo_package(path = ".")

# `:komira_codeworks_api`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`): the examples run
# against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_codeworks_api",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_codeworks_api/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_codeworks_api-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a
# step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_73",
    package = "komira_codeworks_api",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Komira's conda packer over `:komira_codeworks_api`: the target `ci/targets.bzl` builds and the one the release
# machine takes, if it takes this library. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_codeworks_api_conda",
    lib = ":komira_codeworks_api",
    summary = "The `komira_codeworks_api` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
