load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon EC2: an ec2Query client generated at build time from botocore's ec2
# model (//third_party/botocore, pinned by sha256; nothing of it is copied
# here), in client mode: each operation's request builder (a form body,
# named as botocore's EC2Serializer names it) and response parser (the
# members of the root element; ec2 has no result wrapper), its endpoint
# resolved through EC2's published endpoint ruleset and partition table,
# embedded in the module, and `EC2Client`, which resolves each call's
# endpoint and sends through komira_aws_core's send_sigv4_signed_request
# (signing name `ec2`) over the komira_http_core Connector it is given.
# Every EC2 operation is a POST, and a call is retried as botocore's
# standard mode retries it, EC2's RequestLimitExceeded throttle included
# (komira_aws_core's aws_retry.mojo).
#
# EC2's model declares several hundred operations; the generator is
# operation-scoped, so only the closure of the twelve below is emitted.
# They cover an instance's, a spot request's and a security group's
# lifecycle: an instance launched (on demand or spot), found and
# terminated; a spot request read and cancelled; the VPCs and subnets of an
# account read; a security group created, read, opened, closed and deleted.
# The generator refuses none of them. An operation joins the list with its
# own rows in the tests below.
#
# RunInstances' ClientToken is the model's idempotency token. When the
# caller leaves it unset, the client fills it with a fresh UUID once per
# call, before the request is built, as botocore does
# (generate_idempotent_uuid), so a launch retried after a 5xx or a dropped
# response carries the same token and EC2 does not launch twice. A
# caller's own token is sent as given (test_ec2_client).
#
# One departure from botocore: a 200 with an empty body parses as a result
# with no members set, where botocore's EC2QueryParser raises a
# ResponseParserError (the shared awsQuery/ec2Query reader,
# komira_aws_core's aws_query.mojo, reads an empty body as an empty
# element). test_ec2_responses pins it.
#
# The library is gated by its layout probe and these tests, hand-written
# against the EC2 API reference (no upstream test body is copied):
# test_ec2_requests (the form body each operation builds, exactly: ec2
# names, unwrapped lists, nested structures), test_ec2_responses (each
# result read from the root, the <Response><Errors><Error> document, a
# throttle read through komira_aws_core and counted a throttle by its retry
# classifier, and an empty body), test_ec2_endpoints (botocore's endpoint
# cases for ec2 through every operation's resolver, the regional, FIPS,
# dual-stack and LocalStack endpoints, and two requests signed end to end
# against independently computed signatures), _no_env_reads (written by
# mojo_aws_client: the package reads no environment) and test_ec2_client
# (the generated client over a scripted connector, a missing instance raised
# under its code, the DescribeVpcs request as it reached the wire, through
# komira_aws_core's AwsEchoConnector, and over the verbs' seams: a
# RunInstances resent after a 503 with the token it filled, a token the
# caller sets sent as given, and a RequestLimitExceeded resent after one
# backoff).
#
# No test here talks to the service.

_EC2 = botocore_model("ec2")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("ec2")

mojo_aws_client(
    name = "komira_aws_ec2",
    endpoint_rules = _EC2.endpoint_rules,
    mode = "client",
    model = _EC2.model,
    model_sha256 = _EC2.sha256,
    operations = [
        "AuthorizeSecurityGroupIngress",
        "CancelSpotInstanceRequests",
        "CreateSecurityGroup",
        "DeleteSecurityGroup",
        "DescribeInstances",
        "DescribeSecurityGroups",
        "DescribeSpotInstanceRequests",
        "DescribeSubnets",
        "DescribeVpcs",
        "RevokeSecurityGroupIngress",
        "RunInstances",
        "TerminateInstances",
    ],
    partitions = _EC2.partitions,
    test_data = {
        "tests/test_ec2_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_ec2_client.mojo",
        "tests/test_ec2_endpoints.mojo",
        "tests/test_ec2_requests.mojo",
        "tests/test_ec2_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        # test_ec2_endpoints reads botocore's endpoint cases with it.
        "//src/komira_json:komira_json",
        # The client's `send_with` takes a komira_retry loop.
        "//src/komira_retry:komira_retry",
        "//src/komira_xml:komira_xml",
    ],
)
