load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# SlabStorage, the group table of the struct-state hash aggregation sinks:
# a SwissTable-style hash table over packed composite keys (one to eight
# fixed-width columns) with one columnar state slab per aggregate, each read
# as that aggregate's AggregatorWithStruct state struct. Groups are probed,
# initialized, committed, merged across workers and finalized here. The
# struct-state MorselSinks on top of it, SlabHashAggSinkStruct (variadic
# over AggregatorWithStruct kernels) and SlabHashAggSinkStructCorr (CORR),
# partition each worker's groups 64 ways and merge workers per partition.
mojo_library(
    name = "op_agg_slab",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/async_rt:async_rt",
        "//src/async_api:async_api",
        "//src/atomic_alias:atomic_alias",
        "//src/containers:containers",
        "//src/counters:counters",
        "//src/morsel:morsel",
        "//src/op_agg_hash:op_agg_hash",
        "//src/op_agg_state:op_agg_state",
        "//src/operator_api:operator_api",
        "//src/physical_plan:physical_plan",
        "//src/plan_expr:plan_expr",
        "//src/plan_ir:plan_ir",
    ],
    test_srcs = [
        "tests/test_aggregator_with_struct_trait.mojo",
        "tests/test_corr_aggregator.mojo",
        "tests/test_slab_hash_agg_sink_struct_consume.mojo",
        "tests/test_slab_hash_agg_sink_struct_corr.mojo",
        "tests/test_slab_hash_agg_sink_struct_two_keys.mojo",
        "tests/test_slab_storage_multikey_comprehensive.mojo",
    ],
    visibility = ["PUBLIC"],
)
