load("@komira//tools/build/cloud:gcp.bzl", "mojo_gcp_client")

# Resource Manager v3, Projects: a REST/JSON client generated at build time
# from the googleapis protos //tools/vendor/googleapis:resourcemanager_v3
# extracts from its pinned archive (nothing of them is copied here).
# `ProjectsClient` sends through komira_http_client's `HttpClient` over the
# komira_http_core `Connector` it is given, takes each request's bearer
# token from a komira_gcp_core `GcpTokenSource`, and raises a non-2xx answer
# through komira_gcp_core's `gcp_status_error`. It reads no environment.
#
# `methods` is what komira's deploy side and its validators call, each for:
#
#   GetProject          resolve a project id to its number (`name` is
#                       `projects/<number>`), which a workload identity
#                       pool's audience and principals name
#   GetIamPolicy        the IAM-binding resource reads a project's policy;
#                       a teardown check reads it for bindings left behind
#   SetIamPolicy        the IAM-binding resource grants or revokes a
#                       project role
#   TestIamPermissions  a validator asks which of a list of permissions the
#                       caller holds on a project
#
# Not generated, so not reachable through this package: ListProjects,
# SearchProjects, CreateProject, UpdateProject, MoveProject, DeleteProject
# and UndeleteProject (no long-running operation is reached), and the API's
# other services (Folders, Organizations and the tag services), which are
# other protos. A method joins the list with its own rows in the tests
# below.
#
# A policy change is a read-modify-write: the caller reads the policy with
# GetIamPolicy, changes the bindings and sends it back with SetIamPolicy
# carrying the etag it read. The client passes the etag through untouched
# (decoded from base64 on the read, encoded back on the write), so the write
# is conditional: a policy changed since the read is refused with 409
# ABORTED, which the caller answers by reading again. The client invents no
# etag. Here GetIamPolicy takes a body, so its `GetPolicyOptions` (the
# policy version asked for) rides in it.
#
# `bundle_only` is the files the methods reach, each generated into this
# package: projects (the service and Project), iam_policy (the policy and
# permission requests), options, policy and expr (a binding's condition).
# Project's timestamps are komira_wkt's.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Resource Manager v3 REST reference (no upstream test body is
# copied), each sending through the generated client over komira_http_core's
# ScriptedConnector (no socket, no DNS): test_default_host (a fresh client
# starts at cloudresourcemanager.googleapis.com; `set_rest_host` replaces
# it, and the replacement is what is dialled and named in the Host header),
# test_projects (the request line, headers and body of each method and the
# answer read back, a project id without `projects/` refused before the
# dial, the read-modify-write sending the etag it read byte for byte),
# test_errors (the google.rpc.Status envelope mapped to its code, a stale
# etag's ABORTED among them, the body never quoted) and test_no_env_reads
# (every generated module reads no environment and holds no method but
# those listed).
#
# No test here talks to the service.

mojo_gcp_client(
    name = "komira_gcp_cloudresourcemanager",
    bundle_only = [
        "google/cloud/resourcemanager/v3/projects.proto",
        "google/iam/v1/iam_policy.proto",
        "google/iam/v1/options.proto",
        "google/iam/v1/policy.proto",
        "google/type/expr.proto",
    ],
    bundle_proto_deps = True,
    methods = [
        "google.cloud.resourcemanager.v3.Projects.GetProject",
        "google.cloud.resourcemanager.v3.Projects.GetIamPolicy",
        "google.cloud.resourcemanager.v3.Projects.SetIamPolicy",
        "google.cloud.resourcemanager.v3.Projects.TestIamPermissions",
    ],
    proto_deps = ["//tools/vendor/googleapis:resourcemanager_v3"],
    protocol = "rest",
    protos = [],
    test_data = {
        "tests/test_no_env_reads.mojo": {"gen": ":komira_gcp_cloudresourcemanager_gen"},
    },
    test_srcs = [
        "tests/test_default_host.mojo",
        "tests/test_errors.mojo",
        "tests/test_no_env_reads.mojo",
        "tests/test_projects.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
)
