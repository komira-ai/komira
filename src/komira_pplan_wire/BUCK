load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A protobuf-free, length-prefixed wire codec for one physical plan shape,
# `PROJECT? -> FILTER* -> SCAN(parquet)`, plus the field-for-field comparator
# its round-trip test asserts with. It depends on the core packages alone.
mojo_library(
    name = "komira_pplan_wire",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_collections:komira_collections",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_ir:komira_plan_ir",
    ],
    test_srcs = [
        "tests/test_pplan_wire_roundtrip.mojo",
    ],
    visibility = ["PUBLIC"],
)
