load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A protobuf-free, length-prefixed wire codec for one physical plan shape,
# `PROJECT? -> FILTER* -> SCAN(parquet)`, plus the field-for-field comparator
# its round-trip test asserts with. It depends on komira_core alone.
mojo_library(
    name = "komira_pplan_wire",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_core:komira_core",
    ],
    test_srcs = [
        "tests/test_pplan_wire_golden_bytes.mojo",
        "tests/test_pplan_wire_hostile_bytes.mojo",
        "tests/test_pplan_wire_roundtrip.mojo",
    ],
    # Declared data is staged at its repository path, and each test opens it
    # by that path: the test runs with the staged data as its current
    # directory.
    test_data = {
        "tests/test_pplan_wire_golden_bytes.mojo": glob(["tests/fixtures/golden/*.hex"]),
        "tests/test_pplan_wire_hostile_bytes.mojo": glob(["tests/fixtures/hostile/*.hex"]) + [
            "tests/fixtures/golden/scan_bare.hex",
            "tests/fixtures/golden/scan_full.hex",
        ],
    },
    visibility = ["PUBLIC"],
)
