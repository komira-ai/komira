load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")
load("@komira//tools/build/mojo:proto_fixture.bzl", "proto_encode", "proto_fixture_check")

# Every `.proto` of the package, one file per message family (resource.proto
# says which holds what); the held-number test reads them all.
_PROTOS = ["resource.proto", "refs.proto", "compute.proto", "data.proto", "identity.proto", "messaging.proto", "secrets.proto", "names.proto", "triggers.proto", "networks.proto", "artifacts.proto", "composite.proto"]

# Ten composed graphs, frozen as bytes (tests/test_resource_graph_golden_bytes.mojo
# says what each holds): between them every field of every message of the
# catalog, each at a value other than its default. `Scale.min` and
# `ContainerJob.max_retries` are also set to an explicit zero: an encoder that
# drops a present zero still round-trips, and the field-number test compares
# with zero records dropped, so only these bytes see it.
_GRAPHS = ["compute_graph", "dns_graph", "job_bucket_graph", "messaging_graph", "metadata_graph", "network_graph", "registry_graph", "secret_graph", "service_graph", "trigger_graph"]

# The generator's half: `kci_resource_proto_generated_gen` writes the Mojo of the `.proto` files, `kci_resource_proto_generated_fresh` holds the
# committed directory `generated/kci_resource_proto_generated/` to it, byte for byte, and fails with the command that regenerates
# (tools/build/gen/README.md). That directory is the library of mopm.toml (`[targets] lib`), compiled as the module
# `kci_resource_proto`: `import_name` is that module's name, and the rule names the directory after the target, which
# `:kci_resource_proto` below cannot be. The library this call declares itself (`:kci_resource_proto_generated`, the same files without the
# tests) is not what dependents use. Regenerate with
#   ./buck2 run komira//tools/build/gen:regen -- komira//src/kci_resource_proto:kci_resource_proto_generated
mojo_proto_library(
    name = "kci_resource_proto_generated",
    srcs = _PROTOS,
    import_name = "kci_resource_proto",
    import_prefix = "kci/resource/v1",
    deps = [
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
    visibility = ["PUBLIC"],
)

# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file, compiled from the committed directory, and exists only once the tests of tests/
# have passed.
# `test_data` stages what the tests read, under the paths they open.
mojo_package(
    path = ".",
    test_data = {
        "tests/test_held_numbers_are_unused.mojo": {
            p: p
            for p in _PROTOS
        },
        "tests/test_resource_graph_golden_bytes.mojo": {
            "fixtures/{}{}".format(s, ext): "tests/fixtures/graph/{}{}".format(s, ext)
            for s in _GRAPHS
            for ext in [".hex", ".canonical.hex"]
        },
    },
)

# `:kci_resource_proto`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`.
mojo_adopted_library(
    name = "kci_resource_proto",
    deps = [
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["generated/kci_resource_proto_generated/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves. `members` is the
# manifests of the path dependencies of the closure, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given.
mojo_conda(
    name = "conda",
    dir = "generated/kci_resource_proto_generated",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_datetime": "//src/komira_datetime:mopm.toml",
        "../komira_encoding": "//src/komira_encoding:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_proto_codec": "//src/komira_proto_codec:mopm.toml",
        "../komira_protobuf": "//src/komira_protobuf:mopm.toml",
        "../komira_wkt": "//src/komira_wkt:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_resource_proto",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file: this package's own `.mojoc` and nothing else
# under `lib/mojo/`, and exactly the direct dependencies of mopm.toml.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_proto_codec >=0.1,<0.2",
        "mojo-komira_wkt >=0.1,<0.2",
    ],
    package = "kci_resource_proto",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_resource_proto`. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_resource_proto_conda",
    lib = ":kci_resource_proto",
    summary = "The `kci_resource_proto` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)


# protoc, the reference implementation, reading the graph fixtures
# (tools/build/mojo/README.md, "Wire fixtures"). The test above freezes the
# bytes this package's encoder writes for each graph as `<stem>.hex` and
# reads them back through this package's decoder only; this check holds them
# to an implementation that never saw it. Each `<stem>.txtpb` is protoc's
# decode of `<stem>.hex` under the package's `.proto` files, and each
# `<stem>.canonical.hex` is protoc's encoding of that text, made by the
# `graph_<stem>_canonical` targets below:
#   ./buck2 build //src/kci_resource_proto:graph_<stem>_canonical \
#       --out src/kci_resource_proto/tests/fixtures/graph/<stem>.canonical.hex
# The `.hex` is this encoder's output, which writes scalars at their
# defaults that protoc omits, so no `.hex` equals its canonical bytes (leg 0
# holds without `canonical_producer`).
_GRAPH_ROOT = "kci.resource.v1.ResourceList"

_GRAPH_PROTO = [":kci_resource_proto_generated_gen"]

proto_fixture_check(
    name = "resource_graph_fixtures",
    dir = "tests/fixtures/graph",
    fixtures = {s: _GRAPH_ROOT for s in _GRAPHS},
    proto_deps = _GRAPH_PROTO,
)

[
    proto_encode(
        name = "graph_{}_canonical".format(s),
        proto_deps = _GRAPH_PROTO,
        root = _GRAPH_ROOT,
        txtpb = "tests/fixtures/graph/{}.txtpb".format(s),
    )
    for s in _GRAPHS
]
