# proto-message: kci.resource.v1.ResourceList
resource {
  id: "db"
  retention: KEEP
  secret {
  }
}
resource {
  id: "token"
  retention: DELETE
  secret {
  }
}
resource {
  id: "api"
  uses {
    target {
      resource: "db"
    }
    access: READ
  }
  uses {
    target {
      resource: "token"
    }
    access: READ
  }
  service {
    image {
      digest: "sha256:5ec2"
    }
    internal {
    }
    secret_env {
      key: "DB_PASSWORD"
      value {
        version: "2"
        secret {
          resource: "db"
        }
      }
    }
    secret_env {
      key: "TOKEN"
      value {
        secret {
          resource: "token"
        }
      }
    }
  }
}
resource {
  id: "rotator"
  uses {
    target {
      resource: "token"
    }
    access: READ_WRITE
  }
  service_account {
  }
}
resource {
  id: "rotator-db"
  grant {
    principal {
      resource: "rotator"
    }
    target {
      resource: "db"
    }
    access: WRITE
  }
}
