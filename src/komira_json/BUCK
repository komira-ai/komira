load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# A small general JSON library (RFC 8259): the `JsonValue` tagged value, a
# strict depth-limited non-recursive parser, a duplicate-member check, and direct-byte writers for
# strings, numbers, booleans and null. It has no deps, so the proto3-JSON
# codec, the generated cloud clients, validators and kci can all import it
# cheaply.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_json`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed.
mojo_adopted_library(
    name = "komira_json",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_json/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# Kept for the packages whose own conda packages require this one and for the release machine, which
# still builds it (release/artifacts.textproto): komira's conda packer over `:komira_json`. It goes
# when those packages move to mopm. This library's mopm package is `mopm pack` over `:lib`.
conda_package(
    name = "komira_json_conda",
    lib = ":komira_json",
    summary = "The `komira_json` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
