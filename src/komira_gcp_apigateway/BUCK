load("@komira//tools/build/cloud:gcp.bzl", "mojo_gcp_client")

# API Gateway v1: a REST/JSON client generated at build time from the
# googleapis protos //tools/vendor/googleapis:apigateway_v1 extracts from
# its pinned archive (nothing of them is copied here).
# `ApiGatewayServiceClient` sends through komira_http_client's `HttpClient`
# over the komira_http_core `Connector` it is given, takes each request's
# bearer token from a komira_gcp_core `GcpTokenSource`, and raises a non-2xx
# answer through komira_gcp_core's `gcp_status_error`. It reads no
# environment.
#
# `methods` is what a deploy of an API edge makes: Create, Get and Delete
# of the Api, of its ApiConfig (the OpenAPI document and the service
# account the gateway calls the backend as) and of the Gateway serving it;
# a validator reads the gateway and its config back with the two Gets.
#
# Not generated, with a caller: UpdateGateway, which repoints a gateway at
# a new config. Its path names a nested field
# (`/v1/{gateway.name=projects/*/locations/*/gateways/*}`) and its
# `update_mask` is a FieldMask message in the query; the generator captures
# only top-level scalar fields, so it refuses the method by name. Nor the
# operation poll: Create and Delete answer a google.longrunning
# `Operation`, and its GetOperation route
# (`/v1/{name=projects/*/locations/*/operations/*}`) is declared in the
# service's API configuration, not in the protos, whose generic route
# (`/v1/{name=operations/**}`) does not match an API Gateway operation
# name. Without a caller: the listings and the Api and ApiConfig updates.
#
# The client starts at apigateway.googleapis.com, the
# `google.api.default_host` ApiGatewayService declares.
#
# `bundle_only` is the files the methods reach, each generated into this
# package: the service, its messages (a separate file, which the
# generator's REST emitter resolves across the package), and
# google.longrunning's Operation with google.rpc's Status.
#
# The library is gated by its layout probe and these tests, hand-written
# against the API Gateway v1 REST reference (no upstream test body is
# copied), each sending through the generated client over komira_http_core's
# ScriptedConnector pointed at `localhost` (no socket, no name lookup):
# test_apigateway_requests (each method's request line, query and body, an
# OpenAPI document's base64 contents, the `view` enum by name),
# test_apigateway_errors (the google.rpc.Status envelope mapped to a code,
# the body never quoted, and an accepted create whose operation failed),
# test_apigateway_default_host and test_no_env_reads (no generated file
# reads the environment; exactly the nine methods above are generated).
#
# No test here talks to the service.

mojo_gcp_client(
    name = "komira_gcp_apigateway",
    bundle_only = [
        "google/cloud/apigateway/v1/apigateway_service.proto",
        "google/cloud/apigateway/v1/apigateway.proto",
        "google/longrunning/operations.proto",
        "google/rpc/status.proto",
    ],
    bundle_proto_deps = True,
    methods = [
        "ApiGatewayService.CreateApi",
        "ApiGatewayService.GetApi",
        "ApiGatewayService.DeleteApi",
        "ApiGatewayService.CreateApiConfig",
        "ApiGatewayService.GetApiConfig",
        "ApiGatewayService.DeleteApiConfig",
        "ApiGatewayService.CreateGateway",
        "ApiGatewayService.GetGateway",
        "ApiGatewayService.DeleteGateway",
    ],
    proto_deps = ["//tools/vendor/googleapis:apigateway_v1"],
    protocol = "rest",
    protos = [],
    test_data = {
        # The whole generated package, so the scan covers every file the
        # generator writes with no second list of them to drift.
        "tests/test_no_env_reads.mojo": {"gen": ":komira_gcp_apigateway_gen"},
    },
    test_srcs = [
        "tests/test_apigateway_default_host.mojo",
        "tests/test_apigateway_errors.mojo",
        "tests/test_apigateway_requests.mojo",
        "tests/test_no_env_reads.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
)
