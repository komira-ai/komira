load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The logical-plan wire codec: `LogicalPlan` to `komira.plan.v1` protobuf
# bytes and back. The encoder writes every node, expression and value the
# engine can plan; the decoder admits only a plan that is structurally and
# semantically valid (`plan_wire_admit`, `plan_wire_values`) and refuses
# hostile bytes with an error rather than building a plan the engine cannot
# run. It sits above `komira_core`, whose types it closes over.
mojo_library(
    name = "komira_plan_wire",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_core:komira_core",
        "//src/komira_rpc_plan:komira_rpc_plan",
        "//src/komira_proto_codec:komira_proto_codec",
    ],
    test_srcs = [
        "tests/test_plan_wire_golden_bytes.mojo",
        "tests/test_plan_wire_hostile_bytes.mojo",
        "tests/test_plan_wire_hostile_values.mojo",
        "tests/test_plan_wire_round_trip_ir.mojo",
        "tests/test_plan_wire_udf_tier.mojo",
    ],
    # Declared data is staged at its repository path, and each test opens it
    # by that path: the test runs with the staged data as its current
    # directory.
    test_data = {
        "tests/test_plan_wire_golden_bytes.mojo": glob(["tests/fixtures/golden/*.hex"]),
        "tests/test_plan_wire_hostile_values.mojo": glob(["tests/fixtures/hostile/*.hex"]) + [
            "tests/fixtures/endpoint/filter_over_parquet.canonical.hex",
        ],
    },
    visibility = ["PUBLIC"],
)
