# The engine's core types: Arrow arrays and IPC, the logical plan and its
# expressions, SIMD kernels, scan sources, runtime topology and the shared
# collections every engine package builds on.
#
# Almost every other engine package depends on this one, so its `deps` stay
# minimal: a package listed here is rebuilt and retested along with everything
# downstream of komira_core.

# Fixed-arity C wrappers over the POSIX calls the Mojo code makes, and the
# process-global counters it shares across threads.
staged_files(
    name = "posix_files",
    srcs = ["native/komira_core_posix.c"],
)

cxx_library(
    name = "komira_core_posix",
    srcs = [":posix_files[native/komira_core_posix.c]"],
    visibility = ["PUBLIC"],
)

