load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The secret seams over GCP Secret Manager: `GcpSecretManagerStore`, a
# komira_secret_store `SecretStore` (AccessSecretVersion, its payload's
# CRC32C checked), and `GcpSecretManagerWriter`, a kci_secret_writer
# `SecretWriter` (AddSecretVersion with the payload's CRC32C, CreateSecret,
# ListSecretVersions), each over the generated komira_gcp_secretmanager
# `SecretManagerServiceClient` it is given. Hand-written; it reads no
# environment.
#
# The welded test, test_gcp_secret_store, sends over komira_http_core's
# ScriptedConnector with a write capture: the handle grammar and its
# refusals (never quoting the handle), CRC32C against published values, a
# resolve's request line for `latest` and for a version number, a payload
# decoded, a checksum mismatch and an answer with no payload raised, an
# error answer raised naming the handle without the body's canary, the
# write's request (payload and dataCrc32c) and the probe's (pageSize=1,
# filter state:ENABLED) as written, and the writer's refusals (a deploy
# token, a version handle) with nothing on the wire. The service's behaviour
# (versions, `latest`, create-if-absent, regional secrets at their own host,
# the checksum verified) is tested against a stateful fake behind TLS over a
# real socket in src/tests/e2e/komira_secrets_e2e (test_gcp_store_registry),
# through komira_secret_registry to a CredentialConsumer.
#
# No test here talks to the service.
mojo_library(
    name = "komira_gcp_secret_store",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_secret_writer:kci_secret_writer",
        "//src/komira_async:komira_async",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_gcp_secretmanager:komira_gcp_secretmanager",
        # For the test's HttpClient; the library imports nothing of it.
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_secret_store:komira_secret_store",
    ],
    test_srcs = ["tests/test_gcp_secret_store.mojo"],
    visibility = ["PUBLIC"],
)
