load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A native OCI distribution client: a registry-to-registry, digest-preserving
# image copy over HTTPS. The transport and the redirect policy are komira_http's,
# the sha256 that content-addresses every manifest and blob is komira_crypto's,
# the JSON DOM used to discover manifest descriptors is komira_json's, and the
# synchronous per-call request runs on komira_async's BlockingRuntime. The tests
# drive the copier over a scripted transport: no network and no sockets.
mojo_library(
    name = "komira_oci",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
    ],
    test_srcs = [
        "tests/test_oci_copy_blob_redirect.mojo",
        "tests/test_oci_copy_digest_preserved.mojo",
        "tests/test_oci_copy_index_and_mount.mojo",
        "tests/test_oci_copy_refusals.mojo",
        "tests/test_oci_fake_registry.mojo",
        "tests/test_oci_grammar.mojo",
        "tests/test_oci_layout_reader.mojo",
        "tests/test_oci_layout_reader_refusals.mojo",
        "tests/test_oci_location.mojo",
        "tests/test_oci_push_basic.mojo",
        "tests/test_oci_push_faults.mojo",
        "tests/test_oci_push_hardening.mojo",
        "tests/test_oci_push_steps.mojo",
        "tests/test_oci_push_tags.mojo",
    ],
    visibility = ["PUBLIC"],
)
