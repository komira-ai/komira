load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The DuckDB comparison arm of the komira benchmarks and its value checks:
# a pin table and a verifier for a user-supplied DuckDB binary, one persistent
# DuckDB process driven over stdin and stdout with host-timed markers around
# every query, DuckDB's JSON output as typed results, the order-independent
# value signature with its tolerance rules, the row-order check and recorded
# reference answers. DuckDB itself is never shipped or downloaded. See
# __init__.mojo.
#
# The welded tests (each file's header says what each test proves):
# - test_values: the signature, the tolerance rules and the row-order check on
#   fixed inputs.
# - test_reference_rows: recorded answers round-trip and refuse bad records;
#   DuckDB's JSON output becomes typed cells.
# - test_memory: DuckDB's printed sizes and the read-back check of the memory
#   limit and of size-valued settings.
# - test_pins: the pin table and the digest-and-size check of a file.
# - test_session: timing from markers, errors, fetch and the fairness settings,
#   over a stand-in process in the test and a manual clock.
# - test_process: the same session over real pipes to a shell loop that stands
#   in for DuckDB, including a long error text, a process that stays silent and
#   a write to a process that has gone.
mojo_library(
    name = "komira_bench_duckdb",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    # Direct dependencies: the rule adds each one's own closure to the compiler.
    deps = [
        "//src/komira_clock:komira_clock",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_supervisor:komira_supervisor",
    ],
    test_srcs = [
        "tests/test_memory.mojo",
        "tests/test_pins.mojo",
        "tests/test_process.mojo",
        "tests/test_reference_rows.mojo",
        "tests/test_session.mojo",
        "tests/test_values.mojo",
    ],
    visibility = ["PUBLIC"],
)
