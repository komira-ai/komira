load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The COUNT(DISTINCT) kernels of grouped aggregation: the STRING-key encode
# of the grouped COUNT(DISTINCT) driver (a parallel FNV-1a hash pass and the
# three bodies that number dict ids in first-seen row order), the
# dictionary-code encode, the per-worker distinct-pair set, the heavy-group
# split, the group-table sizing rule, the string key emit, the radix-parallel
# exact COUNT(DISTINCT) of Int64 buffers and of a STRING column, the
# per-worker state of the streaming COUNT(DISTINCT) aggregation, its global
# group directory and its MorselSink, the stage DISTINCT breaker state and
# its run-time-typed sibling (`DistinctState_Untyped`), the
# parallel per-group finalize of the stage MEDIAN drain, and the grouped
# COUNT(DISTINCT) driver over one batch (hash-partitioned across the
# dispatcher's workers, with the bounded top-k drain, and the fused route
# for one STRING key with only COUNT(DISTINCT)s).
mojo_library(
    name = "op_agg_distinct",
