        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_ir:komira_plan_ir",
        "//src/komira_plan_stats:komira_plan_stats",
        "//src/komira_scalar_arithmetic:komira_scalar_arithmetic",
        "//src/komira_scan_source:komira_scan_source",
        "//src/komira_simd:komira_simd",
