load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The network half of the model seams of komira_kg (docs/design/knowledge_graph_port.md): HTTP
# transports for a chat-completions wire and an embeddings wire, an Embedder and an LlmClient over
# them, the prompts as values the caller passes in, and the choice between extracting by rules and
# extracting by a model. No vendor, product or model is named; the address, path, credential
# header, model id, dimension and prompts are arguments with no default. No environment variable
# and no clock is read, and a call is made once (no retry).
#
# The welded tests: test_auth_header pins the credential header's checks (token name, no control
# byte, not a header the transport writes) on both sides of each limit; test_wire_endpoint the
# endpoint's rules; test_prompt the templates (one-pass substitution, the refusals, the neutral
# values); test_wire_json the request bodies (any text reaches the wire unchanged) and the
# response readers (the envelope, the row count, the dimension, finite numbers, the index);
# test_embedder and test_chat_client the embedder and the client over a scripted transport
# (extraction in a fenced block, skipped entries, the yes or no reading, the schema attached only
# when the prompt has one); test_extract_client the routing by mode and its refusals;
# test_http_transport the HTTP transports against a loopback server in this process (request
# shape, the configured path and credential header, a non-success status, a truncated body, the
# size bound, a body that is not UTF-8, no retry, the time bound reaching the connector factory,
# the https scheme); test_http_clients the embedder and the chat client over that server (a
# response of the wrong width refused, two different prompts reaching the wire unchanged, malformed
# JSON refused). The README's examples run as tests too.
mojo_library(
    name = "komira_kg_llm",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    # The full transitive closure of the Mojo libraries this package and its tests
    # build on: komira_kg and komira_kg_format, komira_kg_mode, komira_json, and the
    # HTTP client with the async runtime under it.
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
