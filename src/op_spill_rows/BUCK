        "//src/simd_ops:simd_ops",
        "//src/udf:udf",
    ],
    test_srcs = [
        "tests/test_agg_spill_files.mojo",
        "tests/test_agg_spill_refusals.mojo",
        "tests/test_agg_spill_round_trip.mojo",
        "tests/test_sort_spill_files.mojo",
        "tests/test_sort_spill_merge_order.mojo",
        "tests/test_spill_root.mojo",
    ],
    visibility = ["PUBLIC"],
)
