load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The engine-execution layer of the SDK, first slice: nine leaf modules (see
# README.md). Each module's header says what it is for.
#
# The welded tests (each file's header says which defect it catches):
# - test_plan_cache_full_sink_hash: the sink kind is part of the Layer 2 cache
#   key, the path is not, and the key is deterministic.
# - test_resolved_cache_pin_count: a pinned entry survives an eviction wave,
#   pins are counted, and a cache whose entries are all pinned refuses an insert.
# - test_resolved_cache_lru_eviction_stress: past the cap the oldest unpinned
#   entry is evicted and the rest stay reachable.
# - test_plan_validation_routes_ledger: the route ledger's self check, token
#   lookup and status names, and the scan-binding wiring refusing an
#   unregistered token and a handle from another epoch.
mojo_library(
    name = "komira_sdk_exec",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    # The full transitive closure of the Mojo libraries this package builds on.
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_column_kernels:komira_column_kernels",
        "//src/komira_compression:komira_compression",
        "//src/komira_counters:komira_counters",
        "//src/komira_dynamic_filter:komira_dynamic_filter",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_host:komira_host",
        "//src/komira_json:komira_json",
        "//src/komira_libc:komira_libc",
        "//src/komira_lz4:komira_lz4",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_ir:komira_plan_ir",
        "//src/komira_plan_proto:komira_plan_proto",
        "//src/komira_plan_stats:komira_plan_stats",
        "//src/komira_plan_wire:komira_plan_wire",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_protobuf:komira_protobuf",
        "//src/komira_scalar_arithmetic:komira_scalar_arithmetic",
        "//src/komira_scan_source:komira_scan_source",
        "//src/komira_simd:komira_simd",
        "//src/komira_zlib:komira_zlib",
    ],
    test_srcs = [
        "tests/test_plan_cache_full_sink_hash.mojo",
        "tests/test_plan_validation_routes_ledger.mojo",
        "tests/test_resolved_cache_lru_eviction_stress.mojo",
        "tests/test_resolved_cache_pin_count.mojo",
    ],
    visibility = ["PUBLIC"],
)
