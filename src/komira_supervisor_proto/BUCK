load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The job supervisor <-> coordinator wire contract
# (`komira/supervisor/v1/supervisor.proto`, package `komira.supervisor.v1`),
# generated into the Mojo package `komira_supervisor_proto`:
#
#   from komira_supervisor_proto.supervisor import (
#       JobPhase, SupervisorHeartbeat, HeartbeatResponse, FailureReport,
#   )
#
# It imports the multi-node routing types of `komira_broker_proto`
# (NodeLoad, ClusterConfig, BrokerClusterMap), a leaf package: the dependency
# is one way. A generated package is flat and writes a reference to another
# `.proto`'s message as `<package_name>.<stem>`, so `package_name` is the
# broker package: the generated heartbeat then imports
# `komira_broker_proto.broker` and shares its types, where
# `bundle_proto_deps` would generate a second, incompatible copy of them into
# this package. (The cost is the generated file's `# Mojo package:` header
# line, which names the broker package. The generator has no option mapping an
# imported file to its package, and adding one is a change to proto-codegen, not
# to this library; this stays until that option exists.) The `.proto` sits at its import
# path so the path matches the proto package. `proto_deps` names the broker
# library's generation half (`_generated_gen`), which carries its `.proto` files.
# The package's tests (`tests/test_*.mojo`) weld it to its field-number census, and README.md's
# examples run as one more welded test.

# The generator's half: `komira_supervisor_proto_generated_gen` writes the Mojo of the `.proto` files, `komira_supervisor_proto_generated_fresh` holds the
# committed directory `generated/komira_supervisor_proto_generated/` to it, byte for byte, and fails with the command that regenerates
# (tools/build/gen/README.md). That directory is the library of mopm.toml (`[targets] lib`), compiled as the module
# `komira_supervisor_proto`: `import_name` is that module's name, and the rule names the directory after the target, which
# `:komira_supervisor_proto` below cannot be. The library this call declares itself (`:komira_supervisor_proto_generated`, the same files without the
# tests) is not what dependents use. Regenerate with
#   ./buck2 run komira//tools/build/gen:regen -- komira//src/komira_supervisor_proto:komira_supervisor_proto_generated
mojo_proto_library(
    name = "komira_supervisor_proto_generated",
    srcs = ["komira/supervisor/v1/supervisor.proto"],
    import_name = "komira_supervisor_proto",
    package_name = "komira_broker_proto",
    proto_deps = ["//src/komira_broker_proto:komira_broker_proto_generated_gen"],
    deps = [
        "//src/komira_broker_proto:komira_broker_proto",
        "//src/komira_proto_codec:komira_proto_codec",
    ],
    visibility = ["PUBLIC"],
)

# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file, compiled from the committed directory, and exists only once the tests of tests/
# have passed.
mojo_package(path = ".")

# `:komira_supervisor_proto`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`.
mojo_adopted_library(
    name = "komira_supervisor_proto",
    deps = [
        "//src/komira_broker_proto:komira_broker_proto",
        "//src/komira_proto_codec:komira_proto_codec",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["generated/komira_supervisor_proto_generated/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves. `members` is the
# manifests of the path dependencies of the closure, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given.
mojo_conda(
    name = "conda",
    dir = "generated/komira_supervisor_proto_generated",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_broker_proto": "//src/komira_broker_proto:mopm.toml",
        "../komira_encoding": "//src/komira_encoding:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_proto_codec": "//src/komira_proto_codec:mopm.toml",
        "../komira_protobuf": "//src/komira_protobuf:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_supervisor_proto",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file: this package's own `.mojoc` and nothing else
# under `lib/mojo/`, and exactly the direct dependencies of mopm.toml.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_broker_proto >=0.1,<0.2",
        "mojo-komira_proto_codec >=0.1,<0.2",
    ],
    package = "komira_supervisor_proto",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_supervisor_proto`. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_supervisor_proto_conda",
    lib = ":komira_supervisor_proto",
    summary = "The `komira_supervisor_proto` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

