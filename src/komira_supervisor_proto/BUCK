load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The job supervisor <-> job manager / broker coordinator wire contract
# (`komira/supervisor/v1/supervisor.proto`, package `komira.supervisor.v1`),
# generated into the Mojo package `komira_supervisor_proto`:
#
#   from komira_supervisor_proto.supervisor import (
#       JobPhase, SupervisorHeartbeat, HeartbeatResponse, FailureReport,
#   )
#
# It imports the multi-node routing types of `komira_broker_proto`
# (NodeLoad, ClusterConfig, BrokerClusterMap), a leaf package: the dependency
# is one way. A generated package is flat and writes a reference to another
# `.proto`'s message as `<package_name>.<stem>`, so `package_name` is the
# broker package: the generated heartbeat then imports
# `komira_broker_proto.broker` and shares its types, where
# `bundle_proto_deps` would generate a second, incompatible copy of them into
# this package. (The cost is the generated file's `# Mojo package:` header
# line, which names the broker package. The generator has no option mapping an
# imported file to its package, and adding one is a change to proto-codegen, not
# to this library; this stays until that option exists.) The `.proto` sits at its import
# path so the path matches the proto package.
mojo_proto_library(
    name = "komira_supervisor_proto",
    srcs = ["komira/supervisor/v1/supervisor.proto"],
    package_name = "komira_broker_proto",
    proto_deps = ["//src/komira_broker_proto:komira_broker_proto"],
    deps = [
        "//src/komira_broker_proto:komira_broker_proto",
        "//src/komira_proto_codec:komira_proto_codec",
    ],
    visibility = ["PUBLIC"],
)
