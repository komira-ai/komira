load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")

# The `kci publish` verb: publish the release set `kci build` left in a release
# directory to a conda channel, or refuse it whole. Step 0 re-verifies every
# member over its bytes with the same `kci_release_set.verify_member` the build
# ran, then lockstep, the requirement closure and the set hash, before any
# request. The channel is read by download; a file present with other bytes, an
# unclaimed new name, or a listing that could not be read stops the run with
# nothing written. Then the missing members are uploaded (never with `force`),
# every member is read back, and the metapackage goes last. The credential is
# the channel's own (kci_release_channel), resolved once. One JSON report.
# Nothing here names a channel, an account or an organisation.
#
# Every welded test drives `ScriptedChannel`, an in-memory channel, over
# release directories `ExampleRelease` writes under TEST_TMPDIR: no socket, no
# network, `.invalid` hosts only.
mojo_library(
    name = "kci_publish_lib",
    import_name = "kci_publish",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo", "main/**/*.mojo"]),
    deps = [
        "//src/kci_artifact_declaration:kci_artifact_declaration",
        "//src/kci_artifact_declaration_proto:kci_artifact_declaration_proto",
        "//src/kci_pkg_upload:kci_pkg_upload",
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_release_set:kci_release_set",
        "//src/komira_http:komira_http",
        "//src/komira_json:komira_json",
        "//src/komira_retry:komira_retry",
        "//src/komira_secret_store:komira_secret_store",
    ],
    test_srcs = [
        # 2.1: every flag, both spellings; --credential/--approved-names unknown
        "tests/test_publish_flags.mojo",
        # 0.1/0.2/0.6: every declared member and nothing else, verified over its bytes
        "tests/test_publish_inputs.mojo",
        # 0.3: one version/build/build_number/commit/timestamp/subdir; --release-version
        "tests/test_publish_lockstep.mojo",
        # 0.4: the requirement closure; exactly one metapackage of every library
        "tests/test_publish_closure.mojo",
        # 0.5: golden set hash; a wrong --expect-set-hash sends nothing
        "tests/test_publish_set_hash.mojo",
        # 1: by download; other bytes = 7, unclaimed new name = 8, all same = 6, unread = 5
        "tests/test_publish_channel_state.mojo",
        # 2-4: once per attempt, settle, bounded retry, read-back barrier, metapackage last
        "tests/test_publish_run.mojo",
        # 2: no request of any scenario says force
        "tests/test_publish_never_force.mojo",
        # 6: report keys and states, no secret, one verdict per exit code
        "tests/test_publish_report.mojo",
        # dry run reads only, mints nothing; the credential is the channel's
        "tests/test_publish_flow.mojo",
    ],
    visibility = ["PUBLIC"],
)

# `kci publish` as a standalone binary, until the kci binary dispatches its
# `publish` verb to the same `publish_main`.
mojo_binary(
    name = "kci_publish",
    srcs = ["main/kci_publish_main.mojo"],
    deps = [":kci_publish_lib"],
    visibility = ["PUBLIC"],
)
