load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# One PUBLISH step of a stage (`kci run --stage S`; the kci binary's one
# parser fills the request): publish the
# release set a BUILD step left in <--release-dir>/<platform>/ to a conda
# channel, or refuse it whole. The release must be the one --revision-id names,
# for the step's platform; an OIDC channel's push identity must name the
# stage's GitHub environment. Step 0 re-verifies every
# member over its bytes with the same `kci_release_set.verify_member` the build
# ran, then lockstep, the requirement closure and release.json's set hash,
# before any request. The channel is read by download; a file present with
# other bytes, or a listing that could not be read, stops the run with nothing
# written. Names the channel has never held are REPORTED (NEW NAMES, in the
# result and a job-summary block), never refused: which names a release
# publishes is its artifacts file's. A later stage's NEW NAMES are read
# anonymously (lookahead) so its approver sees them before approving. A dry
# run writes nothing; under CI it exchanges an OIDC channel's token and
# discards it (the credential probe). Then the missing members are uploaded by up to
# `--concurrency` worker threads (komira_fork_join; never with `force`), every
# member is read back, and the metapackage goes last. The credential is
# the channel's own (kci_release_channel), resolved once. The step ends in a
# kci_api outcome word and error id, and puts its rows into the run's one
# result document; no exit number is spelled here, and a release already in
# the channel byte for byte is NOOP, exit 0. Nothing here names a channel, an
# account or an organisation.
#
# Every welded test drives `ScriptedChannel`, an in-memory channel, over
# release directories `ExampleRelease` writes under TEST_TMPDIR: no socket, no
# network, `.invalid` hosts only.
mojo_library(
    name = "kci_publish_lib",
    import_name = "kci_publish",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_artifact:kci_artifact",
        "//src/kci_artifact_proto:kci_artifact_proto",
        "//src/kci_api:kci_api",
        "//src/kci_pkg_upload:kci_pkg_upload",
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_release_set:kci_release_set",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_fork_join:komira_fork_join",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        "//src/komira_libc:komira_libc",
        "//src/komira_retry:komira_retry",
        "//src/komira_secret_store:komira_secret_store",
    ],
    test_srcs = [
        # 0.1/0.2/0.6: every declared member and nothing else, verified over its bytes
        "tests/test_publish_inputs.mojo",
        # 0.3: one version/build/build_number/commit/timestamp/subdir; --release-version
        "tests/test_publish_lockstep.mojo",
        # 0.4: the requirement closure; exactly one metapackage of every library
        "tests/test_publish_closure.mojo",
        # 0.5: golden set hash; a release.json of another set sends nothing
        "tests/test_publish_set_hash.mojo",
        # 1: by download; other bytes REFUSED (3), new names reported never refused,
        # all same NOOP (0), unread INDETERMINATE (5) and no name new
        "tests/test_publish_channel_state.mojo",
        # 2-4: once per attempt, settle, bounded retry, read-back barrier, metapackage last;
        # --concurrency 1 and 4 end in the same state; workers really run in parallel
        "tests/test_publish_run.mojo",
        # 1: a stage that never goes backward refuses a lower build number than
        # its channel lists for the same name and version (KCI-E-SUPERSEDED)
        "tests/test_publish_never_backward.mojo",
        # 1, the split (staged pipeline P1): a channel AHEAD of the release whose
        # newest build descends from it is SUPERSEDED (exit 0, no upload), an
        # unrelated one REFUSED, one git cannot resolve exit 5; the main-line
        # filter: a branch's break-glass build is not counted, an ambiguous
        # prefix is
        "tests/test_publish_never_backward_split.mojo",
        # 2: no request of any scenario says force
        "tests/test_publish_never_force.mojo",
        # 6: the result document's rows, new_names[], the probe, no secret, one outcome
        # per reason
        "tests/test_publish_result.mojo",
        # dry run writes nothing; the credential is the channel's; RUNNING first
        "tests/test_publish_flow.mojo",
        # a dry run under CI mints and discards; a refused mint is red; not under CI
        # is recorded, never a mint
        "tests/test_publish_plan_probe.mojo",
        # the runner's handshake is read through komira_libc's one getenv, so a
        # binary that links both (bin/kci) links
        "tests/test_publish_actions_env.mojo",
        # a later stage's NEW NAMES read anonymously; a PRIVATE channel is not read;
        # the job-summary block
        "tests/test_publish_new_names_summary.mojo",
        # the release identity: --revision-id and the platform must be release.json's;
        # the subdir is the platform's; an OIDC channel publishes only from its
        # stage's environment
        "tests/test_publish_platform.mojo",
    ],
    visibility = ["PUBLIC"],
)
