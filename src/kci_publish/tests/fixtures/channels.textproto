# Two example channels for the kci_publish tests. The hosts are reserved
# example names; nothing here is dialled.
channel {
  name: "example-stable"
  visibility: PUBLIC
  repository {
    artifact_type: CONDA
    location: "https://conda.example.invalid/example-stable"
    push_identity: "publisher@example.invalid"
  }
}
channel {
  name: "example-private"
  visibility: PRIVATE
  repository {
    artifact_type: CONDA
    location: "https://conda.example.invalid/example-private"
    push_identity: "publisher@example.invalid"
  }
}
