            var _v_on_demand_throughput_override = DynamoDBOnDemandThroughputOverride.from_aws_json(v.get(String("OnDemandThroughputOverride")))
            out.set_on_demand_throughput_override(_v_on_demand_throughput_override^)
        return out^
