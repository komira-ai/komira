load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon DynamoDB: an awsJson 1.0 client generated at build time from
# botocore's dynamodb model (//third_party/botocore, pinned by sha256;
# nothing of it is copied here), in pure mode: each operation's request
# builder and response parser, and its endpoint resolved through the
# service's published endpoint ruleset and partition table, embedded in the
# module. No transport; a caller signs a built request with
# komira_aws_core's build_sigv4_signed_request (signing name `dynamodb`).
#
# Pure, not client, mode: komira_aws_core's `send_sigv4_signed_request` and
# the client-mode emitter are in place (komira_aws_s3 and komira_aws_sqs
# are client mode), and this library moves to client mode with client
# tests of its own over a scripted connector, as theirs have.
#
# Endpoints: every operation below binds the ruleset's `ResourceArn` from
# its `TableName`, and `AccountId` and `AccountIdEndpointMode` are fields
# of `DynamoDBEndpointConfig`, set by the caller (nothing here reads a
# credential or the environment for them). The mode starts as `preferred`,
# the AWS SDKs' default for that built-in, so an account id alone picks the
# account-based endpoint (`<account>.ddb.<region>.amazonaws.com`); a caller
# clears or changes the mode to choose otherwise.
#
# `operations` is what a table's owner and its readers and writers call:
# items read, written, updated and deleted, a query and a scan, and the
# table created, described, updated (with its TTL and point-in-time
# recovery) and deleted. An operation joins the list with its own rows in
# the tests below.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Amazon DynamoDB API reference (no upstream test body is
# copied): test_dynamodb_requests (the request each operation builds,
# exactly, every AttributeValue type, and the model's bounds),
# test_dynamodb_responses (each result decoded, and the error forms read
# through komira_aws_core and the modeled error shapes),
# test_dynamodb_endpoints (botocore's endpoint cases for dynamodb through
# every operation's resolver, the regional, FIPS, dual-stack, account-based
# and LocalStack endpoints, and three requests signed end to end against
# independently computed signatures) and _no_env_reads (written by
# mojo_aws_client: the package reads no environment).
#
# No test here talks to the service.

_DYNAMODB = botocore_model("dynamodb")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("dynamodb")

mojo_aws_client(
    name = "komira_aws_dynamodb",
    endpoint_rules = _DYNAMODB.endpoint_rules,
    mode = "pure",
    model = _DYNAMODB.model,
    model_sha256 = _DYNAMODB.sha256,
    operations = [
        "CreateTable",
        "DeleteItem",
        "DeleteTable",
        "DescribeContinuousBackups",
        "DescribeTable",
        "DescribeTimeToLive",
        "GetItem",
        "PutItem",
        "Query",
        "Scan",
        "UpdateContinuousBackups",
        "UpdateItem",
        "UpdateTable",
        "UpdateTimeToLive",
    ],
    partitions = _DYNAMODB.partitions,
    test_data = {
        "tests/test_dynamodb_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_dynamodb_endpoints.mojo",
        "tests/test_dynamodb_requests.mojo",
        "tests/test_dynamodb_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_json:komira_json",
    ],
)
