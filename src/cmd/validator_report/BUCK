load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The one report library every validator shares, and its falsifier.
#
# It produces EVIDENCE, not authorization: the record it renders is written by
# the party being gated, into a bucket that party can write. The gate stays the
# EXIT CODE (`report_exit_code`) and the build graph (a test's pass marker is an
# input to the package).
#
# The one dep is `validator_rows_lib`, and that is the whole design. A report
# model that lives in a package linking an HTTP client and an async runtime is
# never adopted, because copying forty lines is cheaper; `validator_rows_lib` is
# dep-free, so this closure is pure `String`/`List` work: no HTTP, no async, no
# clock, no store, no FFI, no cloud SDK. A dep added here is a dep every
# validator pays. Do not add deps.
#
# A consumer gets both packages on its compile closure through `deps`; the
# re-exports in `__init__.mojo` buy it one import line.
mojo_library(
    name = "validator_report_lib",
    srcs = glob(
        ["validator_report_lib/**/*.mojo"],
        exclude = ["validator_report_lib/tests/**/*.mojo"],
    ),
    deps = ["//src/komira/validator_rows_lib:validator_rows_lib"],
    test_srcs = ["validator_report_lib/tests/test_validator_report.mojo"],
    visibility = ["PUBLIC"],
)
