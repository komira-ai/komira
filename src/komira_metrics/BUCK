load("@buildrules//rules/mojo:pack.bzl", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/native:shared.bzl", "native_shared_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The metrics model: the per-operator MetricsSet, attribute-set interning, the
# per-worker series and histogram tables with their export sweep, and the
# EXPLAIN ANALYZE collector and renderer. It depends on komira_collections (for
# `Slab[T]`), komira_name_registry and komira_hash (name ids and the FNV-1a
# constants), komira_clock and komira_atomic_alias (the atomic counters);
# komira_fork_join is a dev-dependency, because its tests fork real threads. It
# must NOT depend on engine packages, komira_trace or komira_log.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"). `:lib` is the library
# file and exists only once every test of tests/ has passed. The C it owns, native/komira_metrics_ea_flag.c
# (the EXPLAIN ANALYZE arm flag: one TU-static read with a relaxed atomic load, so the disarmed check at
# every collection seam stays a few nanoseconds), is `[native.komira_metrics_ea_flag]` of mopm.toml:
# `mojo_package` compiles it into `:native_komira_metrics_ea_flag` (`libkomira_metrics_ea_flag.a`), links it
# into every test of the package and of the packages that depend on it, and packs it into `:conda`.
mojo_package(path = ".")

# `:komira_metrics`, the target the packages that depend on this library name, is `:lib` as komira's Mojo
# rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the tests have
# passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those packages (the dev-dependency
# is not part of what `:lib` is built from); the rule refuses a list that is not the closure `:lib` was built
# from. It also hands the native archive of `:lib` to a dependent's link, and carries the README gate
# (`[tests][readme]`): the examples run against `:lib` and the archive.
mojo_adopted_library(
    name = "komira_metrics",
    c_deps = [":komira_metrics_ea_flag"],
    deps = [
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_hash:komira_hash",
        "//src/komira_name_registry:komira_name_registry",
    ],
    lib = ":lib",
    native = ":komira_metrics_native",
    readme = "README.md",
    srcs = glob(["src/komira_metrics/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package is `:conda`, which `mojo_package` makes for a package that owns a native library: `mopm pack`
# over `:lib`, the `.conda` a mopm registry serves (`mojo-komira_metrics-0.1.0-mojo1.0.0_0.conda`), with the
# manifest of every path dependency of the closure staged at its repository path. It records the direct
# dependencies of mopm.toml (`mojo-komira_atomic_alias`, `mojo-komira_clock`, `mojo-komira_collections`,
# `mojo-komira_hash`, `mojo-komira_name_registry`, each `>=0.1,<0.2`), holds none of their files, and holds
# `lib/libkomira_metrics_ea_flag.a`.

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/`, the archive that was built and tested
# (`lib/libkomira_metrics_ea_flag.a` is exactly the bytes of `:native_komira_metrics_ea_flag`), and the
# direct dependencies only (komira_fork_join is a dev-dependency, which `mopm pack` leaves out).
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_atomic_alias >=0.1,<0.2",
        "mojo-komira_clock >=0.1,<0.2",
        "mojo-komira_collections >=0.1,<0.2",
        "mojo-komira_hash >=0.1,<0.2",
        "mojo-komira_name_registry >=0.1,<0.2",
    ],
    natives = {"libkomira_metrics_ea_flag.a": ":native_komira_metrics_ea_flag"},
    package = "komira_metrics",
    sole = True,
    visibility = ["PUBLIC"],
)

# The release machine builds `komira_metrics_conda` (release/artifacts.textproto): komira's conda packer over
# `:komira_metrics`, with the library's own shared library below. It goes when the release machine takes
# `:conda`, which is this library's mopm package.
conda_package(
    name = "komira_metrics_conda",
    lib = ":komira_metrics",
    native = ":komira_metrics_native",
    summary = "The `komira_metrics` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

# The older packaging of the same C, kept while the release set ships it
# (tools/build/package/BUCK, `native`) and the one-definition gate links it
# (tools/build/one_definition/libraries.bzl): the C file as a `cxx_library`, and
# `komira_metrics_native` below, its shared library. No test or program links this
# archive: the Mojo side links `:native_komira_metrics_ea_flag`, built from the same file.
staged_files(
    name = "ea_flag_files",
    srcs = ["native/komira_metrics_ea_flag.c"],
)

cxx_library(
    name = "komira_metrics_ea_flag",
    srcs = [":ea_flag_files[native/komira_metrics_ea_flag.c]"],
    visibility = ["PUBLIC"],
)

# libkomira_metrics_native.so.1: the C this library owns, as its own
# shared library exporting the names its callers call
# (tools/build/native/README.md, "Each library's shared library"). Built and
# checked here, and packed into the library's conda package (`native`).
native_shared_library(
    name = "komira_metrics_native",
    archives = [
        ":komira_metrics_ea_flag",
    ],
    callers = [
        ":komira_metrics",
    ],
    library = "komira_metrics",
    # Every weak undefined symbol of the library, recorded from its first
    # green link (checks 3 and 7 hold it to exactly this list):
    weak_undefined = [
        # zig's C runtime (crti.o): the profiling hook, absent unless -pg.
        "__gmon_start__",
    ],
    visibility = ["PUBLIC"],
)
