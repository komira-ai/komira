load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/native:shared.bzl", "native_shared_library")

# The metrics model: the per-operator MetricsSet, attribute-set interning, the
# per-worker series and histogram tables with their export sweep, and the
# EXPLAIN ANALYZE collector and renderer. It depends on the core packages (for
# `Slab[T]`), komira_name_registry and komira_hash (name ids and the FNV-1a
# constants), komira_clock, komira_fork_join (its tests fork real threads) and
# komira_atomic_alias (the atomic counters). It must NOT depend on engine
# packages, komira_trace or komira_log.

# The EXPLAIN ANALYZE arm flag: one TU-static read with a relaxed atomic load,
# so the disarmed check at every collection seam stays a few nanoseconds.
staged_files(
    name = "ea_flag_files",
    srcs = ["native/komira_metrics_ea_flag.c"],
)

cxx_library(
    name = "komira_metrics_ea_flag",
    srcs = [":ea_flag_files[native/komira_metrics_ea_flag.c]"],
    visibility = ["PUBLIC"],
)

mojo_library(
    name = "komira_metrics",
    # Its C ships in its package as komira_metrics_native below (lib/libkomira_metrics_native.so.1).
    native = ":komira_metrics_native",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        ":komira_metrics_ea_flag",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_hash:komira_hash",
        "//src/komira_name_registry:komira_name_registry",
        "//src/komira_fork_join:komira_fork_join",
    ],
    test_srcs = [
        "tests/test_explain_analyze.mojo",
        "tests/test_explain_analyze_disarmed_cost.mojo",
        "tests/test_histogram.mojo",
        "tests/test_metric_point_and_attr_set.mojo",
        "tests/test_metric_sweep.mojo",
        "tests/test_metrics_set.mojo",
        "tests/test_metrics_set_owned_factory.mojo",
        "tests/test_metrics_set_unregistered_lookup_quarantine.mojo",
        "tests/test_series_table.mojo",
    ],
    visibility = ["PUBLIC"],
)

# libkomira_metrics_native.so.1: the C this library owns, as its own
# shared library exporting the names its callers call
# (tools/build/native/README.md, "Each library's shared library"). Built and
# checked here, and packed into the library's conda package (`native`).
native_shared_library(
    name = "komira_metrics_native",
    archives = [
        ":komira_metrics_ea_flag",
    ],
    callers = [
        ":komira_metrics",
    ],
    library = "komira_metrics",
    # Every weak undefined symbol of the library, recorded from its first
    # green link (checks 3 and 7 hold it to exactly this list):
    weak_undefined = [
        # zig's C runtime (crti.o): the profiling hook, absent unless -pg.
        "__gmon_start__",
    ],
    visibility = ["PUBLIC"],
)
