load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# A Kafka-protocol server for the komira broker. For now the package holds its
# wire codec, the `wire` subpackage (imported as komira_kafka_server.wire):
# primitive types, request/response headers and framing, the v2 RecordBatch
# with CRC-32C, and the message schemas for the handshake, data,
# consumer-group, topic-admin, idempotent-producer and transactional APIs; and
# `produce_error`, which maps an append error to its Produce error code by the
# fixed tokens of the object store's error texts. The package has no deps
# (mopm.toml has no [dependencies] table): the codec is pure bytes, and
# `produce_error` matches its own copies of the tokens (held equal to
# komira_objectstore's by the mojo_test //tests/kafka_produce_error_tokens) so
# that this library stays a conda package. The server part arrives later in
# this package.
#
# The welded tests are byte-exact against the Apache Kafka protocol spec and
# round-trip every codec; none opens a socket. The test_kafka_golden_* tests
# check the handshake (ApiVersions, Metadata), data-path (Produce, Fetch,
# ListOffsets), consumer-group, topic-admin, idempotent-producer and
# transactional codecs against hand-written reference bytes (provenance:
# tests/GOLDENS.md).
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_kafka_server`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only
# once the tests have passed. It carries the README gate too (`[tests][readme]`): the examples run
# against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_kafka_server",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_kafka_server/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_kafka_server-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so
# this file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it
# is a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_25",
    package = "komira_kafka_server",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_kafka_server`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_kafka_server_conda",
    lib = ":komira_kafka_server",
    summary = "The `komira_kafka_server` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
