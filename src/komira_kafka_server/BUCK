load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A Kafka-protocol server for the komira broker. For now the package holds its
# wire codec, the `wire` subpackage (imported as komira_kafka_server.wire):
# primitive types, request/response headers and framing, the v2 RecordBatch
# with CRC-32C, and the message schemas for the handshake, data,
# consumer-group, topic-admin, idempotent-producer and transactional APIs; and
# `produce_error`, which maps an append error to its Produce error code using
# komira_objectstore's error classifiers. The codec is pure bytes and imports
# nothing outside `wire`; the server part arrives later in this package.
#
# The welded tests are byte-exact against the Apache Kafka protocol spec and
# round-trip every codec; neither opens a socket.
mojo_library(
    name = "komira_kafka_server",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_objectstore:komira_objectstore",
    ],
    test_srcs = [
        "tests/test_kafka_record_batch_v2.mojo",
        "tests/test_kafka_record_batch_hostile.mojo",
        "tests/test_kafka_wire_codec.mojo",
        "tests/test_produce_error_for.mojo",
    ],
    visibility = ["PUBLIC"],
)
