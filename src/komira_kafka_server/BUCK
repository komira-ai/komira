load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A Kafka-protocol server for the komira broker. For now the package holds its
# wire codec, the `wire` subpackage (imported as komira_kafka_server.wire):
# primitive types, request/response headers and framing, the v2 RecordBatch
# with CRC-32C, and the message schemas for the handshake, data,
# consumer-group, topic-admin, idempotent-producer and transactional APIs; and
# `produce_error`, which maps an append error to its Produce error code by the
# fixed tokens of the object store's error texts. The package has no deps: the
# codec is pure bytes, and `produce_error` matches its own copies of the
# tokens (held equal to komira_objectstore's by the mojo_test
# //tests/kafka_produce_error_tokens) so that this library stays a conda
# package. The server part arrives later in this package.
#
# The welded tests are byte-exact against the Apache Kafka protocol spec and
# round-trip every codec; none opens a socket. The test_kafka_golden_* tests
# check the handshake (ApiVersions, Metadata), data-path (Produce, Fetch,
# ListOffsets), consumer-group, topic-admin, idempotent-producer and
# transactional codecs against hand-written reference bytes (provenance:
# tests/GOLDENS.md).
mojo_library(
    name = "komira_kafka_server",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_kafka_record_batch_v2.mojo",
        "tests/test_kafka_record_batch_hostile.mojo",
        "tests/test_kafka_wire_codec.mojo",
        "tests/test_kafka_golden_offset_apis.mojo",
        "tests/test_kafka_golden_group_apis.mojo",
        "tests/test_kafka_golden_consumer_protocol.mojo",
        "tests/test_kafka_golden_create_topics.mojo",
        "tests/test_kafka_golden_init_producer_id.mojo",
        "tests/test_kafka_golden_transaction.mojo",
        "tests/test_produce_error_for.mojo",
        "tests/test_kafka_wire_primitive_edges.mojo",
        "tests/test_kafka_record_batch_edges.mojo",
        "tests/test_kafka_golden_metadata.mojo",
        "tests/test_kafka_golden_data_path.mojo",
    ],
    visibility = ["PUBLIC"],
)
