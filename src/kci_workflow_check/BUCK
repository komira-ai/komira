load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The workflow consistency check: a hand-written CI workflow held to the
# release machine. It is library code, not a command: `kci run` runs it at
# start-up on the workflow it runs under (`check_running_workflow`), and its
# welded tests hold fixture workflows to it. No workflow of this repository
# is held to it now (the release workflow, .github/workflows/release.yml,
# runs Buck2 targets and no kci); it goes when kci does. The
# machine file owns the stages; the workflow must agree: one job per stage with
# the stage's name, running in the stage's environment, `needs` = the stage's
# `after`, `id-token: write` exactly on the stages that publish by OIDC
# trusted publishing or are farm-connected, the farm-connect action exactly on
# the farm-connected stages, one literal `kci run --stage <id>` per job with a
# `--summary-file`, a pull_request trigger exactly when the machine file
# declares a PULL_REQUEST stage, whose job is then the only one a pull request
# runs (same-repository pull requests only, no environment, `contents: read`
# and the farm connection's token, `--affected-by` the merge commit's first
# parent, the full history) while every other job's `if:` keeps a pull request
# out, a `revision` input on workflow_dispatch, every `uses:` pinned to a commit id (the farm-connect
# action excepted), no `--only` on a release job unless the stage is SPLIT
# (the job named after the stage runs its steps, other jobs run its
# validations, and together they run each step and validation exactly once;
# a validations job holds no environment and no id-token and needs the step
# job), and every `kci run` reading the machine file being checked (the
# default, or its `--machine`).
#
# The workflow is read by a FAIL-CLOSED reader of a strict YAML subset
# (workflow_reader.mojo's header; docs/ci.md, "The workflow subset kci
# reads"); any line outside it is "cannot tell", never a pass. actionlint
# (//:workflow_lint) stays the YAML validity gate.
#
# Deps: kci_release_machine (the stages), kci_release_channel (which channels
# publish by OIDC) and kci_api (the default machine file). Pure: it
# checks text it is given.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on kci_api,
# kci_release_channel and kci_release_machine, sibling packages (`[dependencies]` of mopm.toml): its
# `:lib` is built from those packages' `:lib`.
mojo_package(
    path = ".",
    test_data = {
        "tests/test_ci_auto_promotion.mojo": {
            "channels.textproto": "tests/data/publish_channels.textproto",
            "kci.yml": "tests/data/publish_kci.yml",
            "machine.textproto": "tests/data/publish_machine.textproto",
        },
    },
)

# `:kci_workflow_check`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are
# not run again.
mojo_adopted_library(
    name = "kci_workflow_check",
    deps = [
        "//src/kci_api:kci_api",
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_release_machine:kci_release_machine",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_workflow_check/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_workflow_check-0.1.0-mojo1.0.0_0.conda`), which records kci_api, kci_release_channel
# and kci_release_machine as dependencies (`mojo-kci_api >=0.1,<0.2`, `mojo-kci_release_channel
# >=0.1,<0.2` and `mojo-kci_release_machine >=0.1,<0.2`) and holds those packages' files nowhere.
# `members` is the manifests of the path dependencies, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given. `:lib` exists only once the
# tests passed, so this file exists only then. Publishing it (`mopm publish`) uploads, which is not
# a build action: it is a step of a CI job that takes this target's output. `mopm` is the one
# `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/kci_workflow_check",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../kci_api": "//src/kci_api:mopm.toml",
        "../kci_release_channel": "//src/kci_release_channel:mopm.toml",
        "../kci_release_machine": "//src/kci_release_machine:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_textproto": "//src/komira_textproto:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_workflow_check",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/` (kci_api, kci_release_channel and
# kci_release_machine are not in it), and exactly 3 dependencies, `mojo-kci_api >=0.1,<0.2`,
# `mojo-kci_release_channel >=0.1,<0.2` and `mojo-kci_release_machine >=0.1,<0.2`, which is what
# installing the package pulls in. Red when the manifest drops a dependency, names another range, or
# the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-kci_api >=0.1,<0.2",
        "mojo-kci_release_channel >=0.1,<0.2",
        "mojo-kci_release_machine >=0.1,<0.2",
    ],
    package = "kci_workflow_check",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_workflow_check`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_workflow_check_conda",
    lib = ":kci_workflow_check",
    summary = "The `kci_workflow_check` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
