load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The workflow consistency check: a hand-written CI workflow held to the
# release machine. It is library code, not a command: `kci run` runs it at
# start-up on the workflow it runs under (`check_running_workflow`), and its
# welded tests hold fixture workflows to it. No workflow of this repository
# is held to it now (the release workflow, .github/workflows/release.yml,
# runs Buck2 targets and no kci); it goes when kci does. The
# machine file owns the stages; the workflow must agree: one job per stage with
# the stage's name, running in the stage's environment, `needs` = the stage's
# `after`, `id-token: write` exactly on the stages that publish by OIDC
# trusted publishing or are farm-connected, the farm-connect action exactly on
# the farm-connected stages, one literal `kci run --stage <id>` per job with a
# `--summary-file`, a pull_request trigger exactly when the machine file
# declares a PULL_REQUEST stage, whose job is then the only one a pull request
# runs (same-repository pull requests only, no environment, `contents: read`
# and the farm connection's token, `--affected-by` the merge commit's first
# parent, the full history) while every other job's `if:` keeps a pull request
# out, a `revision` input on workflow_dispatch, every `uses:` pinned to a commit id (the farm-connect
# action excepted), no `--only` on a release job unless the stage is SPLIT
# (the job named after the stage runs its steps, other jobs run its
# validations, and together they run each step and validation exactly once;
# a validations job holds no environment and no id-token and needs the step
# job), and every `kci run` reading the machine file being checked (the
# default, or its `--machine`).
#
# The workflow is read by a FAIL-CLOSED reader of a strict YAML subset
# (workflow_reader.mojo's header; docs/ci.md, "The workflow subset kci
# reads"); any line outside it is "cannot tell", never a pass. actionlint
# (//:workflow_lint) stays the YAML validity gate.
#
# Deps: kci_release_machine (the stages), kci_release_channel (which channels
# publish by OIDC) and kci_api (the default machine file). Pure: it
# checks text it is given.
mojo_library(
    name = "kci_workflow_check",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_api:kci_api",
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_release_machine:kci_release_machine",
    ],
    test_srcs = [
        # what the fail-closed reader reads, and each construct it cannot tell
        "tests/test_workflow_reader.mojo",
        # the subset as a table: every spelling found to read one way to kci
        # and another to GitHub ends in cannot tell or in the rule's finding
        "tests/test_workflow_subset.mojo",
        # a fixture that agrees, one mutation per rule R1-R12 and R14, the id-token
        # stages, the start-up entry point
        "tests/test_ci_rules.mojo",
        # one stage split over jobs whose --only parts run all of it once
        # (R1 and R9 as amended)
        "tests/test_ci_split_stage.mojo",
        # R6 for pr.yml, the pull request's check: the PULL_REQUEST stage as the
        # ONE job `check` of a workflow of its own (no fork, no environment, no
        # secret, minimal permissions, the base commit, the full history,
        # pinned runner and uses, the pull_request trigger alone); one
        # mutation per branch
        "tests/test_ci_pull_request.mojo",
        # R6's change base: `--affected-by "$change_base"`, the merge commit's
        # first parent, never the event's base.sha (which widened a pull
        # request by every later change to main); R18 lets no `${{ }}` into a
        # script
        "tests/test_ci_pr_change_base.mojo",
        # R6 for kci.yml: no pull_request trigger and no job for the
        # PULL_REQUEST stage; each file refused when read as the other
        "tests/test_ci_two_workflows.mojo",
        # R15-R20 and R4's allow-list: mutations of a FIXTURE workflow and
        # machine file, each ending in its rule's finding
        "tests/test_ci_auto_promotion.mojo",
    ],
    # test_ci_auto_promotion: a FIXTURE pair, the workflow and machine file
    # komira had while it published to channels (tests/data/publish_*), so
    # the rules that guard a publishing job stay tested while kci can publish.
    # No workflow of this repository is held to a machine file any more: the
    # release workflow (.github/workflows/release.yml) runs Buck2 targets.
    test_data = {
        "tests/test_ci_auto_promotion.mojo": {
            "channels.textproto": "tests/data/publish_channels.textproto",
            "kci.yml": "tests/data/publish_kci.yml",
            "machine.textproto": "tests/data/publish_machine.textproto",
        },
    },
    visibility = ["PUBLIC"],
)
