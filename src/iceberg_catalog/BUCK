load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_test")

# The Iceberg catalog client: resolves `namespace.table` through the
# IcebergCatalog seam (a storage-based resolver with no network, and a REST
# client over the standard Iceberg REST protocol), and creates and commits
# tables over REST, with the append committer. The HTTP transport is
# komira_http's, responses are parsed with json's DOM parser, and the
# synchronous per-call request runs on async_rt's BlockingRuntime; the
# committer's production clock and ids come from clock and uuid. The tests
# drive the client over a scripted transport and an in-process catalog: no
# network and no sockets.
mojo_library(
    name = "iceberg_catalog",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/async_rt:async_rt",
        "//src/clock:clock",
        "//src/http_client:http_client",
        "//src/http_core:http_core",
        "//src/json:json",
        "//src/uuid:uuid",
    ],
    test_srcs = [
        "tests/test_iceberg_catalog_values.mojo",
        "tests/test_iceberg_commit_append.mojo",
        "tests/test_iceberg_commit_base_checks.mojo",
        "tests/test_iceberg_commit_budget.mojo",
        "tests/test_iceberg_commit_reload_failures.mojo",
        "tests/test_iceberg_commit_unknown.mojo",
        "tests/test_iceberg_metadata_apply.mojo",
        "tests/test_iceberg_metadata_updates.mojo",
        "tests/test_iceberg_rest_catalog.mojo",
        "tests/test_iceberg_rest_error_messages.mojo",
        "tests/test_iceberg_rest_errors.mojo",
        "tests/test_iceberg_rest_http_transport.mojo",
        "tests/test_iceberg_rest_test_catalog.mojo",
        "tests/test_iceberg_rest_test_catalog_scripting.mojo",
        "tests/test_iceberg_rest_write.mojo",
        "tests/test_iceberg_table_changes.mojo",
        "tests/test_iceberg_table_metadata.mojo",
        "tests/test_storage_based_catalog.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The production HttpIcebergRestTransport over a real socket: the catalog
# client against a http_server fake catalog on 127.0.0.1, both in this
# one action on two threads (komira_http_tls_e2e's serve_while). It asserts
# the paths, Authorization and Host headers the server received, the
# metadata-location returned, and the 404 and 401 errors by exact message.
# Standalone, not in `test_srcs`: it opens sockets, which the library gate's
# tests do not.
mojo_test(
    name = "test_iceberg_rest_loopback",
    srcs = ["tests/test_iceberg_rest_loopback.mojo"],
    deps = [
        ":iceberg_catalog",
        "//src/async_rt:async_rt",
        "//src/http_client:http_client",
        "//src/http_core:http_core",
        "//src/http_server:http_server",
        "//src/tests/e2e/komira_http_tls_e2e:komira_http_tls_e2e",
        "//src/json:json",
    ],
)
