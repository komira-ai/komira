load("@komira//third_party/python:pins.bzl", "PYTHON", "WHEELS")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/python:defs.bzl", "py_test", "python_oracle", "python_proto")

# The tests of the hermetic Python (third_party/python, tools/build/python):
# each py_test runs its script with the pinned interpreter as a build action,
# so building a target is running it, and its output exists only if it passed;
# a python_oracle's output exists only if its two runs agreed. What each test
# proves is in README.md; the mutants each was seen red against are in the
# pull request that added it.

_ALL = ["//third_party/python:" + w["name"] for w in WHEELS]

py_test(
    name = "smoke",
    src = "smoke.py",
    args = ["python=" + PYTHON["version"]] + [w["name"] + "=" + w["version"] for w in WHEELS],
    deps = _ALL,
)

py_test(
    name = "oracle_demo",
    src = "oracle_demo.py",
    deps = [
        "//third_party/python:duckdb",
        "//third_party/python:pandas",
        "//third_party/python:polars",
        "//third_party/python:pyarrow",
    ],
)

py_test(
    name = "timezones",
    src = "timezones.py",
    # No tzdata here: py_test adds the wheel its `tzdata` names.
    deps = ["//third_party/python:pyarrow"],
)

py_test(
    name = "missing_module",
    src = "missing_module.py",
    expect_error = "ModuleNotFoundError: No module named 'requests'",
    deps = _ALL,
)

py_test(
    name = "isolation",
    src = "isolation.py",
    deps = _ALL,
)

# The files that name a GNU licence, each reviewed (third_party/python/README.md,
# Licences): none puts a pinned component under a GNU licence except
# numpy's two bundled GCC runtime libraries.
_REVIEWED = [
    # CPython's licence: its history of Python's releases says which were
    # "GPL-compatible" and that 1.6.1 incorporated "material that was
    # previously distributed under the GNU General Public License". The PSF
    # licence itself is not the GPL. typing-extensions and pandas (for code it
    # carries) include the same text.
    "cpython:lib/python3.13/LICENSE.txt",
    "typing-extensions:typing_extensions-4.16.0.dist-info/licenses/LICENSE",
    "pandas:pandas-3.0.6.dist-info/LICENSE",
    # The MPL-2.0 text, whose definition of a Secondary License names the
    # GNU GPL, LGPL and AGPL.
    "grpcio:grpcio-1.84.0.dist-info/licenses/LICENSE",
    # numpy's bundled libgfortran (GPL-3.0-or-later WITH GCC-exception-3.1)
    # and libquadmath (LGPL-2.1-or-later), and the licence texts of both.
    "numpy:numpy-2.5.3.dist-info/licenses/LICENSE.txt",
    "numpy:numpy.libs/libgfortran-83c28eba-468e71e5.so.5.0.0",
    "numpy:numpy.libs/libquadmath-2284e583-a9307bba.so.0.0.0",
]

py_test(
    name = "licenses",
    src = "licenses.py",
    args = [PYTHON["name"] + "=" + PYTHON["license"]] + [w["name"] + "=" + w["license"] for w in WHEELS] + ["allow=" + r for r in _REVIEWED],
    deps = _ALL,
)

py_test(
    name = "runner_cases",
    src = "runner_cases.py",
    srcs = glob(["cases/*.py"]),
    args = ["$(location //tools/build/python:pyrun.py)"],
)

# python_oracle (tools/build/python): DuckDB sums a checked-in CSV on the farm;
# the output directory (and each `outs` file, a sub-target) is test data for
# the targets below. The twin is the same oracle in an action of its own, so
# `oracle_twins` compares two separate runs.
[python_oracle(
    name = name,
    src = "golden_sums.py",
    data = {"scores.csv": "oracle_data/scores.csv"},
    outs = [
        "sums.tsv",
        "summary/count.txt",
    ],
    deps = ["//third_party/python:duckdb"],
) for name in [
    "golden_sums",
    "golden_sums_twin",
]]

py_test(
    name = "oracle_twins",
    src = "oracle_twins.py",
    args = [
        "$(location :golden_sums)",
        "$(location :golden_sums_twin)",
    ],
)

# An oracle that needs the zone database: pyarrow writes an ORC timestamp
# column (ORC reads its writer's zone, GMT, from TZDIR) and the script asserts
# the zone setup the rule gives each run; it builds only if both runs wrote
# the same bytes.
python_oracle(
    name = "orc_timestamps",
    src = "orc_timestamps.py",
    outs = ["ts.orc"],
    deps = ["//third_party/python:pyarrow"],
)

py_test(
    name = "oracle_cases",
    src = "oracle_cases.py",
    srcs = glob(["oracle_cases/*.py"]),
    args = ["$(location //tools/build/python:oracle_run.py)"],
)

# The oracle's files read by a welded Mojo test, as declared test data. The
# library has no API; it exists for this test (__init__.mojo).
mojo_library(
    name = "komira_test_python",
    srcs = ["__init__.mojo"],
    conda = False,
    test_data = {
        "tests/test_oracle_output.mojo": {
            "oracle/sums.tsv": ":golden_sums[sums.tsv]",
            "oracle_dir": ":golden_sums",
        },
    },
    test_srcs = ["tests/test_oracle_output.mojo"],
)

# The pinned protobuf runtime against code the pinned protoc generates
# (protoc 29.1 writes Python gencode 5.29.1): protobuf_gencode imports and
# parses with it.
python_proto(
    name = "gencode_probe_pb2",
    src = "gencode_probe.proto",
)

py_test(
    name = "protobuf_gencode",
    src = "protobuf_gencode.py",
    srcs = [":gencode_probe_pb2"],
    args = [
        "gencode=5.29.1",
        "runtime=" + [w["version"] for w in WHEELS if w["name"] == "protobuf"][0],
    ],
    deps = ["//third_party/python:protobuf"],
)
