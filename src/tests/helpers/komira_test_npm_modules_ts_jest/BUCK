load("@komira//tools/build/node:modules.bzl", "jest_test", "node_tree_test", "npm_modules", "tsc_build", "tsc_check")
load(":pins.lock.bzl", "NPM")

# The real tools: typescript, jest and ts-jest (and their 270-odd
# dependencies) from the lockfile kpin pinned (pins.lock.bzl). The planted
# type error and failing jest test are in tests//negative/npm_modules.

_NEGATIVE = ["tests//negative/npm_modules:"] if read_root_config("cells", "tests") else []

_SRCS = [
    "check_dist.js",
    "jest.config.js",
    "src/add.ts",
    "test/add.test.ts",
    "tsconfig.build.json",
    "tsconfig.json",
]

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
    visibility = _NEGATIVE,
)

tsc_check(
    name = "typecheck",
    modules = ":modules",
    srcs = _SRCS,
)

jest_test(
    name = "jest",
    modules = ":modules",
    srcs = _SRCS,
)

# The compiled output is the target, and a program reads it back.
tsc_build(
    name = "dist",
    modules = ":modules",
    srcs = _SRCS,
)

node_tree_test(
    name = "dist_is_compiled",
    modules = ":modules",
    program = "check_dist.js",
    srcs = ["check_dist.js"],
    data = {package_name() + "/dist": ":dist"},
)
