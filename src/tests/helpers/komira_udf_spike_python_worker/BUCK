load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library", "mojo_shared_lib")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("@komira//tools/build/python:defs.bzl", "py_test", "python_oracle")
load("//src/tests/helpers/komira_udf_spike_python:defs.bzl", "udf_bench")
load(":defs.bzl", "PYWORKER", "bytecode", "code_layer", "dist_native_libs", "pyrt_files", "runtime_dir")

# Test-only: the Python UDF runtime of docs/design/udf_runtime_interface.md
# behind its worker transport (section 5), one worker process per engine
# thread, reached through the UDF runtime C ABI by a proxy runtime library.
# Spike code: nothing outside src/tests may depend on it.
#
#   native/proxy_runtime.c  the proxy: the C ABI table, each entry one message
#                           of the worker protocol (komira_udf_wire.h)
#   native/proxy_channel.c  one worker: posix_spawn, the control socket, the
#                           shared region and its slot heaps, the wait that
#                           forwards clock reads and cancel
#   native/ipc_codec.c      the Arrow IPC subset the engine side writes
#                           (schemas, batches) and reads (one-column batches)
#   native/probe_*.c       single cases the engine loop does not reach:
#                           probe_codec.c the engine-side codec (golden bytes,
#                           pyarrow's batches, each refusal); probe_boundary.c
#                           HELLO and replies a fake worker breaks;
#                           probe_fake.c the channel against a scripted fake
#                           worker (slots, clock, cancel, heap edges, partial
#                           reads and writes, reaping); probe_worker.c a real
#                           worker driven message by message; probe_calls.c and
#                           probe_table.c calls through a library's table
#   pyworker/               the worker (komira_udf_pyworker.py), its IPC codec
#                           (kudf_ipc.py) and the fixtures only these tests load;
#                           user code runs through the in-process runtime's
#                           adapter (komira_udf_spike_python/pyrt), staged as pyrt/
#   producer/make_closure.py  a VALUE UDF's capture: a function of __main__
#                           closing over a 16 MiB numpy model, cloudpickled
#                           (:closure_capture, laid out by digest as :closure)
#   producer/pyarrow_batches.py, producer/value_payloads.py
#                           batches as pyarrow writes them, and VALUE payloads
#                           the worker refuses (python_oracle targets)
#   tests/ipc_golden.txt    the engine-side writer's messages, byte for byte
#   refrt/                  the builds' one export each (below)
#   native/drive.c, drive.mojo, workloads.mojo
#                           the engine loop the tests and the bench drive a
#                           runtime with, and what it measures
#   bench/                  the bench program; :bench_zygote, :bench_spawn and
#                           :bench_pipe are its runs
#
# The welded tests (each file's header says what it proves; the pull
# request's operator sweep names the mutants each kills):
#   test_conform_worker   the shared conformance cases a managed runtime can
#                         express, through the proxy, on four builds.
#   test_worker_processes describe through the proxy, one process per context
#                         and none left after shutdown, the zygote as every
#                         forked worker's parent, per-context state, the
#                         proxy's call accounting, numpy on 4 threads, a crash
#                         mapped to a lost context, kept input views falling
#                         back to inline payloads.
#   test_closure          the VALUE closure on both start-ups: values, its
#                         payload by value, a digest mismatch refused, the
#                         model's pages shared by forked workers and not by
#                         spawned ones, and the fork's thread facts.
#   test_worker_boundary  the engine-side codec (golden writer bytes, every
#                         decode refusal, pyarrow's batches), HELLO refused on
#                         any version difference by a real worker and by the
#                         engine, malformed replies from a fake worker, and the
#                         channel against a scripted fake worker.
#   test_worker_protocol  a real worker driven message by message: its
#                         refusals of requests and LOAD bodies, its frame.
#   test_runtime_table    the table entries the others do not reach (spec
#                         refusals, describe, frames and aggregates), what each
#                         build starts, deadlines before a batch, init.
#   test_worker_calls     two arguments at different offsets, a UDF loaded
#                         after a context, call_batch's refusals, and the
#                         kill of a worker deaf to cancel or past a deadline.
# And a py_test, :test_kudf_ipc: the worker's IPC codec against pyarrow, and
# tests/ipc_golden.txt read by pyarrow.

_CASES = {"src/tests/helpers/komira_udf_spike_abi": "//src/tests/helpers/komira_udf_spike_abi:cases"}

mojo_library(
    name = "komira_udf_spike_python_worker",
    srcs = glob(["*.mojo"]),
    conda = False,
    deps = [
        ":komira_udf_pyworker_drive",
        ":komira_udf_pyworker_probe",
        "//src/komira_json:komira_json",
        "//src/tests/helpers/komira_udf_spike_abi:komira_udf_spike_abi",
        "//src/tests/helpers/komira_udf_spike_python:komira_udf_spike_python",
    ],
    test_srcs = [
        "tests/test_closure.mojo",
        "tests/test_conform_worker.mojo",
        "tests/test_runtime_table.mojo",
        "tests/test_worker_boundary.mojo",
        "tests/test_worker_calls.mojo",
        "tests/test_worker_processes.mojo",
        "tests/test_worker_protocol.mojo",
    ],
    test_data = {
        "tests/test_closure.mojo": runtime_dir(["spawn", "zygote", "zygote_threads"], extra = {"closure": ":closure"}),
        "tests/test_conform_worker.mojo": runtime_dir(
            ["pipe", "pyarrow", "spawn", "zygote"],
            site = ":site_bc_pyarrow",
            extra = _CASES,
        ),
        "tests/test_runtime_table.mojo": runtime_dir(
            ["pipe", "pyarrow", "spawn", "zygote", "zygote_threads"],
            site = ":site_bc_pyarrow",
        ),
        "tests/test_worker_boundary.mojo": runtime_dir([], extra = {
            "ipc_golden.txt": "tests/ipc_golden.txt",
            "pyarrow_batches": ":pyarrow_batches",
        }),
        "tests/test_worker_calls.mojo": runtime_dir(["pipe", "pyarrow", "spawn", "zygote"], site = ":site_bc_pyarrow"),
        "tests/test_worker_processes.mojo": runtime_dir(["spawn", "zygote"]),
        "tests/test_worker_protocol.mojo": runtime_dir([], extra = {"value_payloads": ":value_payloads"}),
    },
    visibility = ["PUBLIC"],
)

# The C side, after the library so the deps lint reads the library's name
# first. Copied into buck-out so the objects' digests do not depend on where
# komira is mounted (cxx.bzl, staged_files).
staged_files(
    name = "c_files",
    srcs = [
        "native/drive.c",
        "native/ipc_codec.c",
        "native/proxy_channel.c",
        "native/probe_boundary.c",
        "native/probe_calls.c",
        "native/probe_codec.c",
        "native/probe_fake.c",
        "native/probe_json.h",
        "native/probe_table.c",
        "native/probe_worker.c",
        "native/proxy_runtime.c",
        "native/pyw.h",
    ],
)

# The proxy runtime: every init of refrt/ and the code they share.
cxx_library(
    name = "komira_udf_pyworker_proxy",
    srcs = [
        ":c_files[native/ipc_codec.c]",
        ":c_files[native/proxy_channel.c]",
        ":c_files[native/proxy_runtime.c]",
    ],
    headers = {"pyw.h": ":c_files[native/pyw.h]"},
    header_namespace = "",
    compiler_flags = ["-O2"],
    deps = ["//src/tests/helpers/komira_udf_spike_abi:komira_udf_spike_c"],
    visibility = ["PUBLIC"],
)

# The engine loop (native/drive.c), linked into the tests and the bench.
cxx_library(
    name = "komira_udf_pyworker_drive",
    srcs = [":c_files[native/drive.c]"],
    compiler_flags = ["-O2"],
    deps = ["//src/tests/helpers/komira_udf_spike_abi:komira_udf_spike_c"],
    visibility = ["PUBLIC"],
)

# The probes (native/probe_*.c), linked into the tests; they reach the
# proxy's channel and codec directly, and a runtime library through its
# table.
cxx_library(
    name = "komira_udf_pyworker_probe",
    srcs = [
        ":c_files[native/probe_boundary.c]",
        ":c_files[native/probe_calls.c]",
        ":c_files[native/probe_codec.c]",
        ":c_files[native/probe_fake.c]",
        ":c_files[native/probe_table.c]",
        ":c_files[native/probe_worker.c]",
    ],
    headers = {
        "probe_json.h": ":c_files[native/probe_json.h]",
        "pyw.h": ":c_files[native/pyw.h]",
    },
    header_namespace = "",
    compiler_flags = ["-O2"],
    deps = [
        ":komira_udf_pyworker_proxy",
        "//src/tests/helpers/komira_udf_spike_abi:komira_udf_spike_c",
    ],
    visibility = ["PUBLIC"],
)

# The proxy's builds, each a shared library exporting
# komira_udf_runtime_init_v1 and nothing else (native/proxy_runtime.c):
#   pyworker_spawn.so           a posix_spawned worker per context; shared memory
#   pyworker_zygote.so          workers forked from a zygote that loaded the
#                               UDF; shared memory
#   pyworker_pipe.so            spawned; every payload on the control socket
#   pyworker_pyarrow.so         spawned; shared memory; the worker's IPC by pyarrow
#   pyworker_zygote_threads.so  the zygote, native thread pools not limited
[mojo_shared_lib(
    name = "pyworker_" + v,
    srcs = ["refrt/pyworker_{}_so.mojo".format(v)],
    exports = ["komira_udf_runtime_init_v1"],
    exports_exact = True,
    deps = [":komira_udf_pyworker_proxy"],
    visibility = ["PUBLIC"],
) for v in [
    "pipe",
    "pyarrow",
    "spawn",
    "zygote",
    "zygote_threads",
]]

# The runtime directory's parts that are not plain files here.
pyrt_files(
    name = "pyrt",
    files = [
        "komira_udf_pyrt.py",
        "udf_fixtures.py",
        "udf_np.py",
        "udf_shadow.py",
    ],
    test = "//src/tests/helpers/komira_udf_spike_python:komira_udf_spike_python[tests][test_python_shared_gil]",
)

dist_native_libs(
    name = "native_libs",
    python = "//third_party/python:cpython",
)

# The interpreter, the Python modules and the wheels, compiled to bytecode as
# a base image ships them (defs.bzl, bytecode).
bytecode(
    name = "python_bc",
    dir = "//third_party/python:cpython",
)

bytecode(
    name = "pyrt_bc",
    dir = ":pyrt",
)

bytecode(
    name = "pyworker_bc",
    srcs = PYWORKER,
)

bytecode(
    name = "site_bc",
    srcs = {
        "cloudpickle": "//third_party/python:cloudpickle",
        "numpy": "//third_party/python:numpy",
    },
)

bytecode(
    name = "site_bc_pyarrow",
    srcs = {
        "cloudpickle": "//third_party/python:cloudpickle",
        "numpy": "//third_party/python:numpy",
        "pyarrow": "//third_party/python:pyarrow",
    },
)

# The VALUE UDF the closure cases load (producer/make_closure.py), captured
# by a python_oracle (two runs must write the same bytes), then laid out as a
# code layer: good/<sha256>, bad/<sha256>, info.json.
code_layer(
    name = "closure",
    capture = ":closure_capture",
)

# One-column batches as pyarrow writes them (producer/pyarrow_batches.py),
# for the engine-side decoder's cases (native/probe_codec.c).
python_oracle(
    name = "pyarrow_batches",
    src = "producer/pyarrow_batches.py",
    outs = ["batches.txt"],
    deps = [
        "//third_party/python:numpy",
        "//third_party/python:pyarrow",
    ],
)

# VALUE code objects the worker must refuse or take at LOAD
# (producer/value_payloads.py), for native/probe_worker.c.
python_oracle(
    name = "value_payloads",
    src = "producer/value_payloads.py",
    outs = [
        "bad_pickle",
        "bad_signature",
        "good",
        "info.txt",
        "not_function",
        "unresolved_hints",
    ],
    deps = ["//third_party/python:cloudpickle"],
)

python_oracle(
    name = "closure_capture",
    src = "producer/make_closure.py",
    outs = [
        "info.json",
        "payload",
        "payload_bad",
    ],
    deps = [
        "//third_party/python:cloudpickle",
        "//third_party/python:numpy",
    ],
)

# The bench program and its runs, one per start-up and transport. Their
# outputs are the numbers:
#   ./buck2 build komira//src/tests/helpers/komira_udf_spike_python_worker:bench_zygote --show-output
mojo_binary(
    name = "bench",
    srcs = ["bench/bench_main.mojo"],
    deps = [
        ":komira_udf_pyworker_drive",
        ":komira_udf_spike_python_worker",
        "//src/komira_json:komira_json",
        "//src/tests/helpers/komira_udf_spike_abi:komira_udf_spike_abi",
        "//src/tests/helpers/komira_udf_spike_python:komira_udf_spike_python",
    ],
)

[udf_bench(
    name = "bench_" + v,
    args = [
        "./pyworker_{}.so".format(v),
        v,
    ],
    binary = ":bench",
    data = runtime_dir([v], extra = {"closure": ":closure"}),
    exec_compatible_with = LINUX_X86_64,
    run_id = "bench/run_id",
) for v in [
    "pipe",
    "spawn",
    "zygote",
]]

# The worker's Arrow IPC codec (pyworker/kudf_ipc.py) against pyarrow: the
# schemas and batches pyarrow writes read back, each reader check refusing a
# copy with its defect, and BatchWriter's messages read by pyarrow. A py_test
# runs as a build action: building the target is running it.
py_test(
    name = "test_kudf_ipc",
    src = "tests/test_kudf_ipc.py",
    srcs = [
        "pyworker/kudf_ipc.py",
        "tests/ipc_golden.txt",
    ],
    deps = [
        "//third_party/python:numpy",
        "//third_party/python:pyarrow",
    ],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
