load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# An in-process decision point on the OpenID AuthZEN Authorization API 1.0
# wire, in the komira profile (docs/design/http_auth.md, "The decision
# point"): `TestPdp` answers `POST /access/v1/evaluation` and
# `/access/v1/evaluations` from an in-memory policy table with revoke, and
# takes the subject only from the subject token. Beside it, the scenario
# table every decision point in the profile must pass, and a runner that
# drives any decision point through the `PdpEndpoint` trait. Test-only, so
# no conda package: a library names it in `test_deps`, which reaches that
# library's welded tests and nothing it ships (tools/build/mojo/test_deps.bzl).
#
# Deps: komira_json (the request and reply bodies).
#
# The welded tests: the scenario table passes on TestPdp; the endpoint's
# order of checks and every refusal by reason code; the safety conditions
# against near-miss values on both sides of each comparison; the request
# shape; the token table; and (over komira_test_vocabulary) that the
# sources name no product concept and hold no early date.
mojo_library(
    name = "komira_test_pdp",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    conda = False,
    deps = ["//src/komira_json:komira_json"],
    test_srcs = [
        "tests/test_bearer_and_tokens.mojo",
        "tests/test_endpoint.mojo",
        "tests/test_no_product_vocabulary.mojo",
        "tests/test_request_shape.mojo",
        "tests/test_safety_near_miss.mojo",
        "tests/test_scenario_table.mojo",
    ],
    test_deps = ["//src/tests/helpers/komira_test_vocabulary:komira_test_vocabulary"],
    test_data = {
        # The vocabulary test reads the library's own sources, staged at their
        # repository paths.
        "tests/test_no_product_vocabulary.mojo": glob(
            ["**/*.mojo"],
            exclude = ["tests/**/*.mojo"],
        ),
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
