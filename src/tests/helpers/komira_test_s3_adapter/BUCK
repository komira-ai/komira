load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The real adapters behind the test-bucket seams, for a test that runs on
# an embedded MinIO: `MinioObjectStore`, komira_test_bucket's
# `ObjectStoreClient` over komira_objectstore_s3's `S3Store` (path-style
# plaintext HTTP, the credential read from the shared-credentials file the
# target names; it reads no environment, and its messages never carry the
# bucket or the endpoint), and `SpawnedProcessRunner`, komira_test_minio's
# `ProcessRunner` over komira_supervisor's `spawn_detached` (Linux only:
# the child dies with the test through setpriv's PR_SET_PDEATHSIG; readiness
# is MinIO's health endpoint). `open_embedded_minio_test_bucket` opens a
# run's bucket from the test binary's flags with both.
#
# Why its own package: komira_test_bucket builds on komira_test_minio and
# both stay free of a cloud client, an HTTP stack and a process supervisor.
# The runner needs komira_supervisor and an HTTP probe, so placing it in
# komira_test_minio would pull both into every komira_test_bucket user; it
# sits here, above both, next to the object store it is always used with.
#
# Deps: komira_test_bucket and komira_test_minio (the seams), komira_supervisor
# (spawn_detached), komira_objectstore_s3, komira_objectstore, komira_aws_core,
# komira_http_client and komira_http_core (the S3 store, the signed
# CreateBucket and the health probe), komira_test_run_id and
# komira_test_verdict (the run id and the CANNOT_TELL exit of the opener),
# and komira_libc (`_read_env`, for the scratch root).
#
# The welded tests are hermetic: the store's verbs over komira_http_core's
# `ScriptedConnector` and a test connector that logs each request to a
# file, the health probe over a recording transport, the runner's argv,
# environment and exit-status mapping as values, and the runner itself over
# short /bin/sh children (as komira_supervisor's welded scenarios start
# them). No server is started and no network is reached: the only socket is
# the runner's probe dialling 127.0.0.1 port 1, which nothing serves. The
# files they write live in TEST_TMPDIR.
mojo_library(
    name = "komira_test_s3_adapter",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_libc:komira_libc",
        "//src/komira_objectstore:komira_objectstore",
        "//src/komira_objectstore_s3:komira_objectstore_s3",
        "//src/komira_supervisor:komira_supervisor",
        "//src/tests/helpers/komira_test_bucket:komira_test_bucket",
        "//src/tests/helpers/komira_test_minio:komira_test_minio",
        "//src/komira_test_run_id:komira_test_run_id",
        "//src/komira_test_verdict:komira_test_verdict",
    ],
    test_srcs = [
        "tests/test_minio_object_store.mojo",
        "tests/test_spawned_process_runner.mojo",
    ],
    visibility = ["PUBLIC"],
)
