load("@komira//tools/build/node:modules.bzl", "cdk_synth", "node_tree_test", "npm_modules")
load(":fixtures.bzl", "FILES", "NPM")

# The node_modules rules (tools/build/node/modules.bzl) over a lockfile of
# seven small packages whose tarballs are checked in (tarballs/): nested,
# hoisted, aliased, scoped, bundled and platform-specific packages, bin links
# and an install script. What each target proves is in ../README.md. The
# planted defects of the same rules are in tests//negative/npm_modules.

_NEGATIVE = ["tests//negative/npm_modules:"] if read_root_config("cells", "tests") else []

[export_file(
    name = f,
    src = "tarballs/" + f,
    visibility = _NEGATIVE,
) for f in FILES.values()]

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
    tarballs = {k: ":" + f for k, f in FILES.items()},
    visibility = _NEGATIVE,
)

node_tree_test(
    name = "layout",
    modules = ":modules",
    program = "check_layout.js",
    srcs = ["check_layout.js"],
)

# The .bin link runs as a program: fx-a asserts it sees its nested fx-b.
node_tree_test(
    name = "bin_runs",
    modules = ":modules",
    program = "node_modules/.bin/fx-a",
)

# cdk_synth passes the context, the fixed environment and the flags that keep
# the real command line off the network; the stand-in aws-cdk fails unless it
# gets them, and its cdk.out is the target.
cdk_synth(
    name = "synth",
    modules = ":modules",
    srcs = ["cdk.json"],
    app = "node node_modules/.bin/fx-a",
    context = {
        "hostedZoneId": "Z0DUMMYZONE",
        "stage": "beta",
    },
    env = {"CDK_DEFAULT_REGION": "us-east-1"},
)

# `tools` names the commands a program may run: bzip2 is busybox's applet, linked as bzip2;
# ls, which the worker has, is not on PATH.
node_tree_test(
    name = "tools_on_path",
    modules = ":modules",
    program = "check_tools.js",
    srcs = ["check_tools.js"],
    tools = {"bzip2": "komira//tools/build/toolchains:busybox"},
)
