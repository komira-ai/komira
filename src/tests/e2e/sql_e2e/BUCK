[mojo_test(
    name = "test_sql_" + capability,
    srcs = ["tests/test_sql_capability.mojo"],
    args = [
        "--capability=" + capability,
        "--cases=" + ",".join(cases),
    ],
    data = dict(
        _TABLE_DATA,
        **dict(
            [("cases/" + c + ".sql", "cases/" + c + ".sql") for c in cases] +
            [("answers/" + c + ".tsv", ":oracle/" + c + "[expected.tsv]") for c in cases],
        )
    ),
    deps = [":sql_e2e"] + _DEPS,
    visibility = ["PUBLIC"],
) for capability, cases in _CAPABILITY_CASES.items()]
