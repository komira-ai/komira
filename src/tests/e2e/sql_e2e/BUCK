mojo_library(
    name = "sql_e2e",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    conda = False,
    deps = _DEPS,
    test_srcs = [
        "tests/test_sql_e2e.mojo",
        "tests/test_sql_capability_checks.mojo",
        "tests/test_sql_e2e_checks.mojo",
    ],
    test_data = {
        "tests/test_sql_capability_checks.mojo": _TABLE_DATA,
        "tests/test_sql_e2e.mojo": _CORPUS,
        # The tables, and a tree for load_corpus at tree/ (case a with its
        # answer, case b with none, answer c with no case, notes.txt).
        "tests/test_sql_e2e_checks.mojo": dict(
            _TABLE_DATA.items() +
            [(f[len("tests/data/"):], f) for f in glob(["tests/data/tree/**"])],
        ),
    },
    visibility = ["PUBLIC"],
)

# One test per capability of the SQL surface, for the surface capability
# matrix (docs/surface_capability_matrix.md), whose lint takes one test target
# for each filled cell: test_sql_<capability> runs the cases below through
# so.sql_result, each held to its DuckDB answer by value and in row order
# (capability.mojo, tests/test_sql_capability.mojo). Only those cases and
# their answers are staged, with the tables and no refusal list, so a case
# komira refuses fails its capability, and the staged cases must be exactly the
# ones named. A case may serve more than one capability; a refused case
# (refusals.tsv) serves none. Each row of tests/surface_capability_matrix.bzl
# whose surface is sql names one of these targets. The whole corpus, refusals
# included, is still test_sql_e2e above.
