        "tests/test_sql_e2e_checks.mojo",
    ],
    test_data = {
        "tests/test_sql_e2e.mojo": _CORPUS,
        # The tables, and a tree for load_corpus at tree/ (case a with its
        # answer, case b with none, answer c with no case, notes.txt).
        "tests/test_sql_e2e_checks.mojo": dict(
            [("tables/" + t, src) for t, src in _TABLES.items()] +
            [(f[len("tests/data/"):], f) for f in glob(["tests/data/tree/**"])],
        ),
    },
    visibility = ["PUBLIC"],
