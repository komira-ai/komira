load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/sql:defs.bzl", "sql_oracle")

# Test-only: komira's SQL surface held end to end to the pinned DuckDB.
#
# A case is cases/<case>.sql: comment lines, then one SELECT over
# komira_test_oracle's datasets (types, nulls, join_left, join_right) or
# the regression tables below (lj_customer and lj_orders also as
# lj_customer_mem and lj_orders_mem, the same rows registered from memory:
# runner.mojo, has_resident_twin), whose outermost ORDER BY is total. A
# regression case (regress_*) says in its comment which engine defect it
# catches. Its expected answer is the sql_oracle target
# :oracle/<case>: the pinned DuckDB reads the same Parquet files
# (sql/tables.sql), komira_test_oracle's discipline refuses a case whose
# answer could depend on the order DuckDB happened to produce, and its
# run.sql writes the answer as expected.tsv. Nothing komira builds is an
# input of an answer.
#
# The library (corpus.mojo, runner.mojo) runs each case through so.sql_result,
# the call on values libkomira's komira_sql_stream wraps, and holds komira's
# answer to DuckDB's by value and in row order; a case komira refuses must
# be listed in refusals.tsv with its refusal, word for word. Nothing ships,
# so `conda = False`.
#
# The tests, each run as a build action:
#   test_sql_e2e -- every case equals DuckDB's answer or is refused as
#     listed; the count of cases is pinned; the whole corpus with one DuckDB
#     answer changed in one cell fails that case alone, by name.
#   test_sql_e2e_checks -- the runner and the corpus reader fed wrong
#     answers and broken lists: a wrong cell, a missing or extra row, another row order or
#     column name; a refusal not listed, listed but answered, or worded
#     otherwise; a malformed refusal list; a case with no answer, an answer
#     with no case, a file that is no case; a session with no table; a
#     resident twin not registered from memory or not holding its rows.
#
# `deps` is the full transitive closure: so's, so itself and
# komira_plan_harness.

_DATASETS = [
    "types",
    "nulls",
    "join_left",
    "join_right",
]

_TABLES = {
    d + ".parquet": "//src/tests/helpers/komira_test_oracle:datasets[" + d + ".parquet]"
    for d in _DATASETS
}

# The small tables the regression cases (cases/regress_*.sql) read, written
# by the pinned DuckDB from sql/regression_tables.sql: each is shaped so one
# engine defect (a NULL-padded row lost in an outer or anti join, a
# string-key join, a join fan-out, a correlated IN, a distinct count across
# a cross join, ...) changes a case's answer.
_REGRESSION_TABLES = [
    "agg_scalar",
    "count_groups",
    "lj_customer",
    "lj_orders",
    "distinct_pairs",
    "cross_a",
    "cross_b",
    "skey_probe",
    "skey_build",
    "derived_l",
    "derived_r",
    "profit_lineitem",
    "profit_partsupp",
    "profit_supplier",
    "pad_probe",
    "pad_build",
    "fan_probe",
    "fan_build",
    "full_l",
    "full_r",
    "in_outer",
    "in_inner",
    "in_supplier",
    "in_partsupp",
    "in_part",
    "floats",
]

sql_oracle(
    name = "regression_tables",
    srcs = "sql/regression_tables.sql",
    outputs = [t + ".parquet" for t in _REGRESSION_TABLES],
)

_TABLES.update({
    t + ".parquet": ":regression_tables[" + t + ".parquet]"
    for t in _REGRESSION_TABLES
})

_ORACLE = "//src/tests/helpers/komira_test_oracle:"

_CASES = [p[len("cases/"):-len(".sql")] for p in glob(["cases/*.sql"])]

[sql_oracle(
    name = "oracle/" + case,
    srcs = [
        _ORACLE + "sql/discipline.sql",
        "sql/tables.sql",
        _ORACLE + "sql/run.sql",
    ],
    inputs = dict(_TABLES, **{"case.sql": "cases/" + case + ".sql"}),
    outputs = ["expected.tsv"],
) for case in _CASES]

# The corpus as test_sql_e2e reads it: cases/, answers/, refusals.tsv and
# the tables under tables/.
_CORPUS = dict(
    [("cases/" + c + ".sql", "cases/" + c + ".sql") for c in _CASES] +
    [("answers/" + c + ".tsv", ":oracle/" + c + "[expected.tsv]") for c in _CASES] +
    [("tables/" + t, src) for t, src in _TABLES.items()] +
    [("refusals.tsv", "refusals.tsv")],
)

mojo_library(
