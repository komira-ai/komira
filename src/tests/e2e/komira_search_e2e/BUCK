        "//src/tests/e2e/komira_http_tls_e2e:komira_http_tls_e2e",
        "//tools/build/mojo/runtime_paths:runtime_paths",
    ],
    test_srcs = [
        "tests/test_search_e2e_catalog_generation.mojo",
        "tests/test_search_e2e_publish_race.mojo",
        "tests/test_search_e2e_retire_reap.mojo",
        "tests/test_search_e2e_scan_equals_core.mojo",
        "tests/test_search_http_front_door.mojo",
        "tests/test_search_http_refusals.mojo",
    ],
    visibility = ["PUBLIC"],
)
