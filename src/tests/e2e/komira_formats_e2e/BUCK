load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A test-only package: one nullable dataset written through the ORC, Avro OCF,
# JSONL and CSV (CsvSink) writers into a Hive tree with a non-ASCII partition
# value (`city=Zürich`), discovered over the real LocalFs and read back with
# projections; the same dataset as an Arrow IPC File and Stream. The sources
# are the shared fixture (the dataset, the tree writer, the IPC assembly); the
# tests are the point. Nothing ships, so `conda = False`.
#
# The tests, each run as a build action:
#   test_formats_arrow_ipc -- the dataset (two RecordBatches) as an Arrow IPC
#     File and Stream assembled from komira_arrow_ipc's message encoders,
#     written and read through LocalFs, decoded by the copy decoder (and the
#     mmap decoder for the File): every value and NULL exact, the edge
#     numerics bit-exact; and the bytes against the Arrow spec (ARROW1 magic
#     and padding, footer size, continuation markers, 8-byte alignment, EOS,
#     Footer Blocks, schema, FieldNodes, LSB-first validity, value bytes,
#     Utf8 offsets and slots). The Parquet leg is pending the komira_parquet
#     reader and writer port; it lands as soon as that port does.
#   test_formats_hive_discovery -- EagerGlobDiscovery (directory and glob,
#     including a glob whose static prefix is the non-ASCII directory) and
#     PrunedHiveDiscovery (inferred partition schema, byte-exact partition
#     values, a prune to Zürich by the fold past near-miss siblings, an
#     escaped directory decoded, a prune to Oslo by the list prefix) return
#     exactly the files on disk.
#   test_formats_projected_roundtrip -- every discovered file, read with
#     column subsets in a different order, matches the source values, NULLs
#     and partition value (a writer/reader self-round-trip).
#   test_formats_edge_binary -- integer limits and IEEE-754 edges (-0.0,
#     subnormals, DBL_MIN/MAX, +-Inf, NaN payloads, 17-digit values) through
#     Avro OCF and ORC: encoded bytes (zig-zag varints, RLE v2 DIRECT runs,
#     little-endian doubles, ColumnStatistics protobuf) against the specs,
#     then a bit-exact read-back.
#   test_formats_edge_text -- the same values through JSONL and CsvSink:
#     exact text, then a bit-exact read-back; NaN/Inf as each format
#     documents (JSON null and refusal, CSV `inf`/`nan` tokens). Known
#     defects are held out by name in its header.
#   test_formats_golden_bytes -- the writer-side oracle: exact CSV and JSONL
#     bytes, Avro OCF framing and writer schema, ORC stripe stats and stream
#     sizes, and hand-written JSONL the writer never produces.
#   test_formats_foreign_orc -- six ORC files pyarrow's ORC C++ writer
#     wrote (tests/fixtures/orc, with the generator script as provenance),
#     read by value: codec, row count, every value and NULL, stripe count;
#     and a read that fails in one column (one encoding byte changed) or is
#     cancelled leaves the next read intact, serial and column-parallel.
#   test_formats_foreign_avro -- Apache Avro's weather OCF files (codecs
#     null, deflate, snappy, zstandard; pinned in //third_party/apache-avro),
#     read by value against upstream's own expected records.
#
# Mutants planted in the readers, seen red in the foreign tests (when the
# reader package's own tests catch a mutant, its test_srcs were emptied for
# that build so this package could build at all):
#   * komira_orc reads column c's ColumnEncoding from entry c-1, so `id`
#     gets the root STRUCT's DIRECT: every foreign ORC test red
#     ("OrcRleError.TRUNCATED: vulong overrun"); komira_orc's own tests
#     also catch it.
#   * komira_avro reads the snappy block's CRC32 trailer little-endian:
#     test_weather_snappy red ("SNAPPY_CRC32_MISMATCH"), the only test in
#     this package to catch it; komira_avro's own snappy tests also do.
#   * The ORC reader before the error-path fix (double free): the
#     serial failed-read test died with SIGSEGV (exit 139). With the slab
#     marked empty after the re-raise instead of before, both tests in one
#     run gave exit 139; the column-parallel test alone gave exit 132
#     ("index 800 is out of bounds, valid range is 0 to 799").
#     komira_orc's own tests stayed green.
#   * Now that each accumulator slot is an Optional: a column-parallel
#     worker moves its accumulator out through a raw pointer, leaving the
#     slot Some: test_formats_foreign_orc exit 139 (komira_orc's own tests
#     stay green, since none of them reads through a dispatcher). The same
#     move in the serial loop: 13 komira_orc tests red (exit 139/132/1).
#
# Planted against test_formats_arrow_ipc:
#   * the copy decoder reads each validity bitmap one byte late
#     (_maybe_decode_validity_bitmap): komira_arrow_ipc's own tests red
#     (test_ipc_file_e2e_write, test_ipc_file_e2e_pyarrow_batches,
#     test_ipc_file_e2e_pyarrow_nullable, test_ipc_field_node_flat) and so
#     does komira_orc's test_orc_arrow_write_primitive_null_drop, so this
#     package does not build under it at all.
#   * the assembly records Block.metaDataLength without the 8-byte prefix:
#     red ("Footer Block 0 (264, 296, 192) is not the RecordBatch message at
#     (264, 304, 192)").
#   * the assembly flips the first validity bit of each RecordBatch: red, six
#     mismatches, e.g. "file Zürich id: validity bit 0 (row 0) is False" and
#     "file Zürich copy row 0 id: NULL, want 1" (copy and mmap).
#
# `deps` lists the Mojo packages of the full transitive closure of the five
# format/storage packages the fixture and tests use (each package's C helper
# libraries come with it).
mojo_library(
    name = "komira_formats_e2e",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    conda = False,
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_avro:komira_avro",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_csv:komira_csv",
        "//src/komira_fork_join:komira_fork_join",
        "//src/komira_fs:komira_fs",
        "//src/komira_hash:komira_hash",
        "//src/komira_json_index:komira_json_index",
        "//src/komira_jsonl:komira_jsonl",
        "//src/komira_log:komira_log",
        "//src/komira_metrics:komira_metrics",
        "//src/komira_name_registry:komira_name_registry",
        "//src/komira_orc:komira_orc",
        "//src/komira_protobuf:komira_protobuf",
        "//src/komira_row_format:komira_row_format",
        "//src/komira_spsc_ring:komira_spsc_ring",
        "//src/komira_trace:komira_trace",
        "//src/komira_udf:komira_udf",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_data = {
        "tests/test_formats_foreign_avro.mojo": {
            "avro/weather-deflate.avro": "//third_party/apache-avro:weather-deflate.avro",
            "avro/weather-snappy.avro": "//third_party/apache-avro:weather-snappy.avro",
            "avro/weather-zstd.avro": "//third_party/apache-avro:weather-zstd.avro",
            "avro/weather.avro": "//third_party/apache-avro:weather.avro",
            "avro/weather.json": "//third_party/apache-avro:weather.json",
        },
        "tests/test_formats_foreign_orc.mojo": {
            "orc/pyarrow_multistripe_nullable.orc": "tests/fixtures/orc/pyarrow_multistripe_nullable.orc",
            "orc/pyarrow_nullable_codec_lz4.orc": "tests/fixtures/orc/pyarrow_nullable_codec_lz4.orc",
            "orc/pyarrow_nullable_codec_snappy.orc": "tests/fixtures/orc/pyarrow_nullable_codec_snappy.orc",
            "orc/pyarrow_nullable_codec_zlib.orc": "tests/fixtures/orc/pyarrow_nullable_codec_zlib.orc",
            "orc/pyarrow_nullable_codec_zstd.orc": "tests/fixtures/orc/pyarrow_nullable_codec_zstd.orc",
            "orc/pyarrow_nullable_mixed.orc": "tests/fixtures/orc/pyarrow_nullable_mixed.orc",
        },
    },
    test_srcs = [
        "tests/test_formats_arrow_ipc.mojo",
        "tests/test_formats_edge_binary.mojo",
        "tests/test_formats_edge_text.mojo",
        "tests/test_formats_foreign_avro.mojo",
        "tests/test_formats_foreign_orc.mojo",
        "tests/test_formats_golden_bytes.mojo",
        "tests/test_formats_hive_discovery.mojo",
        "tests/test_formats_projected_roundtrip.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
