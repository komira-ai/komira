load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Test-only: read_orc through run_sql (the SQL door of sdk_exec: parse, bind
# the file's columns from its footer, optimize, lower to a SOURCE_ORC segment,
# run) over local ORC files, read by value. The six files pyarrow's ORC C++
# writer wrote (komira_formats_e2e's tests/fixtures/orc, with the generator
# script beside them as provenance) are the input; the expected values are
# recomputed from the generator's rules, never from a komira read. Files of
# other column types and the refused shapes are written by the test itself in
# its scratch directory.
#
#   test_read_orc_sql  every row and NULL of each codec's file (none, zlib,
#                      snappy, zstd, lz4) and of the file of three stripes,
#                      with DuckDB's column types; a projection in query
#                      order; a filter on a column the projection leaves out;
#                      count(*); a grouped aggregate with a NULL group; the
#                      eight other types the SQL scan reads; and each refusal
#                      by name: a missing file, a file that is not ORC, an
#                      option, a glob, a struct, list or timestamp column.
#
# The README's example (examples/read_orc_sql.mojo) writes a small ORC file
# and runs read_orc in SQL over it; it runs as a welded test of its own.
#
# Nothing depends on this package.
mojo_library(
    name = "komira_read_orc_e2e",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo", "examples/**/*.mojo"]),
