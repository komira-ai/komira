load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Test-only: end-to-end tests of the HTTP stack over loopback, a real
# komira_http_server HttpServer against a real komira_http_client HttpClient in
# one process, on two threads (komira_fork_join). The library holds what the
# tests share: the TLS fixtures and configurations, and the runner that steps
# the server on one thread while the client runs on the other.
#
# The welded tests: an HTTP/1.1 GET over TLS checked byte for byte; the ALPN
# pivot to h2 on both sides; a 4 MiB plaintext response flushed through the
# server's buffered-write path; and a client refusing an untrusted root and a
# wrong server name while the server goes on serving. The certificates are
# komira_http_core's test fixtures, staged at their source paths.

_TLS_FIXTURES = {
    "src/komira_http_core/tests/fixtures/smoke_cert.pem": "//src/komira_http_core:tests/fixtures/smoke_cert.pem",
    "src/komira_http_core/tests/fixtures/tls/leaf_cert.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_cert.pem",
    "src/komira_http_core/tests/fixtures/tls/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
    "src/komira_http_core/tests/fixtures/tls/root_ca.pem": "//src/komira_http_core:tests/fixtures/tls/root_ca.pem",
}

mojo_library(
    name = "komira_http_tls_e2e",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_clock:komira_clock",
        "//src/komira_fork_join:komira_fork_join",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_http_server:komira_http_server",
        "//src/komira_net:komira_net",
    ],
    test_srcs = [
        "tests/test_large_response_flush.mojo",
        "tests/test_tls_h1_get.mojo",
        "tests/test_tls_h2_alpn.mojo",
        "tests/test_tls_verify_refusals.mojo",
    ],
    test_data = {
        "tests/test_tls_h1_get.mojo": _TLS_FIXTURES,
        "tests/test_tls_h2_alpn.mojo": _TLS_FIXTURES,
        "tests/test_tls_verify_refusals.mojo": _TLS_FIXTURES,
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
