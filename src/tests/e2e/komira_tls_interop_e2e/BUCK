load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_test")

# Test-only: komira's TLS against real TLS peers, `bssl s_server` and
# `bssl s_client`, aws-lc's tool built from the pinned archive
# (//third_party/aws-lc:bssl). Each mojo_test below starts bssl as a child
# process (komira_supervisor) and drives komira's side of the connection
# itself. komira listens and connects on 127.0.0.1 only; s_server listens on
# the dual-stack wildcard ([::], aws-lc's choice), komira connects to
# 127.0.0.1, so the tests need IPv6 with dual-stack sockets. The tests get
# the binary through `args`
# ($(exe_target)) and run under `./buck2 test`, not as part of this library's
# build. The certificates are komira_http_core's test fixtures, staged at
# their source paths.
#
# test_komira_client_vs_bssl_server: komira's production client config
#   against s_server -www pinned to TLS 1.3 and TLS 1.2, offering ALPN
#   h2,http/1.1 and http/1.1: version and cipher suite agree on both sides,
#   no ALPN (s_server selects none), and a GET answered over TLS.
# test_bssl_client_vs_komira_server: s_client pinned to TLS 1.3 and TLS 1.2,
#   offering h2,http/1.1 and http/1.1, verifying komira's server: version,
#   cipher suite and ALPN agree on both sides, and a line each way.
# test_komira_client_refuses_bssl_server: komira's client refuses s_server
#   with "Certificate is untrusted" for an untrusted root and a wrong name,
#   and accepts it when it can verify it.
#
# The library holds the peer processes, the reading of bssl's report, the
# fixtures and komira's configurations, and komira's side of a connection;
# its welded test checks the reading of bssl's report on its own.
mojo_library(
    name = "komira_tls_interop_e2e",
    srcs = glob(["*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_supervisor:komira_supervisor",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_bssl_report.mojo",
    ],
    visibility = ["PUBLIC"],
)

_DEPS = [
    ":komira_tls_interop_e2e",
    "//src/komira_async:komira_async",
    "//src/komira_http_client:komira_http_client",
    "//src/komira_http_core:komira_http_core",
    "//src/komira_supervisor:komira_supervisor",
    "//tools/build/mojo/runtime_paths:komira_runtime_paths",
]

_TLS_FIXTURES = {
    "src/komira_http_core/tests/fixtures/smoke_cert.pem": "//src/komira_http_core:tests/fixtures/smoke_cert.pem",
    "src/komira_http_core/tests/fixtures/tls/leaf_cert.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_cert.pem",
    "src/komira_http_core/tests/fixtures/tls/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
    "src/komira_http_core/tests/fixtures/tls/root_ca.pem": "//src/komira_http_core:tests/fixtures/tls/root_ca.pem",
}

_BSSL = "--bssl=$(exe_target //third_party/aws-lc:bssl)"

mojo_test(
    name = "test_komira_client_vs_bssl_server",
    srcs = ["tests/test_komira_client_vs_bssl_server.mojo"],
    args = [_BSSL],
    data = _TLS_FIXTURES,
    deps = _DEPS,
)

# bssl s_client sends what it reads on its standard input; the test gives it
# a file through the pinned busybox's sh.
mojo_test(
    name = "test_bssl_client_vs_komira_server",
    srcs = ["tests/test_bssl_client_vs_komira_server.mojo"],
    args = [_BSSL, "--busybox=$(location //tools/build/toolchains:busybox)"],
    data = _TLS_FIXTURES,
    deps = _DEPS,
)

mojo_test(
    name = "test_komira_client_refuses_bssl_server",
    srcs = ["tests/test_komira_client_refuses_bssl_server.mojo"],
    args = [_BSSL],
    data = _TLS_FIXTURES,
    deps = _DEPS,
)

# The deps above name every komira_* module the library and the tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
