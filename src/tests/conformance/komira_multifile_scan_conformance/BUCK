load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/sql:defs.bzl", "sql_oracle")

# Test-only: Parquet tables of several files through run_sql (the SQL door of
# sdk_exec) against the answers of the pinned DuckDB. oracle/ holds the SQL
# that DuckDB runs: table_dir.sql builds the table `m` (30 rows) and
# table_hive.sql the table `hl` (16 rows); write.sql writes m as three files
# (dir3_0 to dir3_2) and hl as four leaf files (hive_0 to hive_3). answers.sql
# reads the files back at the paths the tests stage them at (a directory of
# three files, and a Hive tree laid out yr=/tag=/dt=, whose key order differs
# from the key order of the columns a reader answers) and writes
# answers.tsv: the result of each query the tests run, the column names and
# types of SELECT *, and typeof() of the partition columns.
#
#   test_directory_scan        a directory registered with register_parquet:
#                              SELECT *, filters, count(*), GROUP BY, ORDER BY
#                              and LIMIT answer DuckDB's rows, names and types
#   test_hive_scan             a glob over a Hive tree registered with
#                              register_parquet: columns, types and order of
#                              the partition columns, filters on a partition
#                              column and on a data column, a partition
#                              column alone, GROUP BY, ORDER BY
#   test_sql_globs             read_parquet('<glob>'), FROM '<glob>', a brace
#                              glob and hive_partitioning = true | false in
#                              SQL text answer DuckDB's rows
#
# The checks are in checks.mojo (library code), so each test is its own action.
# Nothing depends on this package.
sql_oracle(
    name = "files",
    srcs = ["oracle/table_dir.sql", "oracle/table_hive.sql", "oracle/write.sql"],
    outputs = [
        "dir3_0.parquet",
        "dir3_1.parquet",
        "dir3_2.parquet",
        "hive_0.parquet",
        "hive_1.parquet",
        "hive_2.parquet",
        "hive_3.parquet",
    ],
)

sql_oracle(
    name = "answers",
    srcs = ["oracle/answers.sql"],
    inputs = {
        "dir3/part-0.parquet": ":files[dir3_0.parquet]",
        "dir3/part-1.parquet": ":files[dir3_1.parquet]",
        "dir3/part-2.parquet": ":files[dir3_2.parquet]",
        "hive/yr=2024/tag=red/dt=2024-01-01/part-0.parquet": ":files[hive_0.parquet]",
        "hive/yr=2024/tag=blue/dt=2024-01-02/part-0.parquet": ":files[hive_1.parquet]",
        "hive/yr=2025/tag=red/dt=2024-01-01/part-0.parquet": ":files[hive_2.parquet]",
        "hive/yr=2025/tag=blue/dt=2024-03-05/part-0.parquet": ":files[hive_3.parquet]",
    },
    outputs = ["answers.tsv"],
)

