load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Test-only: komira_datetime's time zones against the IANA tz release
# pinned in //third_party/tzdata (compiled TZif files) and against zdump's
# reading of the same files (goldens/, written by regen_goldens.sh, which the
# build does not run: a person reruns it when the pin moves and reviews the
# diff). zdump is glibc's implementation, which shares no code with
# komira_datetime.
#
#   test_named_zones   New York, London, Lord Howe, Kathmandu, Sao Paulo and
#                      Apia, every change 1800..2100 equal to zdump's, and
#                      local times around each change resolved as the
#                      offsets imply
#   test_plan_vectors  the calendar plan's named cases, written out from the
#                      published rules
#   test_corpus        every zone of the release loads; each footer agrees
#                      with its file at the last listed transition; every
#                      zone's changes in 2037..2040 equal zdump's; lookup
#                      refusals
#
# Welded (test_srcs): a verdict is a build action the cache keeps for exactly
# these inputs, and nothing named komira_datetime_conformance exists unless
# every test passed. Nothing depends on this package.

# The pinned release as `share/tzdata/` (LICENSE, src/tzdata/zones and
# src/tzdata/zoneinfo/).
_TZDATA = {"tzdata": "//third_party/tzdata:files"}

mojo_library(
    name = "komira_datetime_conformance",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_datetime:komira_datetime",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    conda = False,
    test_srcs = [
        "tests/test_corpus.mojo",
        "tests/test_named_zones.mojo",
        "tests/test_plan_vectors.mojo",
    ],
    test_data = {
        "tests/test_corpus.mojo": _TZDATA | {
            "goldens/footer.txt": "goldens/footer.txt",
        },
        "tests/test_named_zones.mojo": _TZDATA | {
            "goldens/named.txt": "goldens/named.txt",
        },
        "tests/test_plan_vectors.mojo": _TZDATA,
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
