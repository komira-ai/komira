load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/sql:defs.bzl", "sql_oracle")

# Test-only: read_json through run_sql (the SQL door of sdk_exec: parse, bind,
# optimize, lower to a SOURCE_JSONL segment, run) against the pinned DuckDB's
# read_json over the same file. data/rows.jsonl is the input of both: ten
# objects whose keys come in different orders, with JSON nulls, missing keys, a
# key on one line only, integers in a float column, escapes and non-ASCII text.
# oracle/<case>.sql is one query, written by DuckDB as <case>.tsv; the test
# runs the text between `COPY (` and `) TO` of the same file, so a query has
# one source. types.sql records the type DuckDB gives each column.
#
#   test_read_json_equals_duckdb  the names, order and types of `SELECT *` are
#                                 DuckDB's (BIGINT, DOUBLE, BOOLEAN, VARCHAR),
#                                 and each case's result equals DuckDB's by
#                                 value (komira_plan_harness: duckdb_tsv read
#                                 at the engine's schema, compare_canon), as a
#                                 multiset or, for ORDER BY, in order
#
# Nothing depends on this package.

_CASES = [
    "scan_all",
    "project_reordered",
    "filter_compare",
    "filter_bool",
    "filter_unprojected",
    "count_star",
    "aggregate",
    "group_by",
    "order_by",
]

[sql_oracle(
    name = case,
    srcs = ["oracle/" + case + ".sql"],
    inputs = {"rows.jsonl": "data/rows.jsonl"},
    outputs = [case + ".tsv"],
) for case in _CASES + ["types"]]

mojo_library(
    name = "komira_read_json_conformance",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
