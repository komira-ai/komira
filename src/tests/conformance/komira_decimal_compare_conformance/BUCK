load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/sql:defs.bzl", "sql_oracle")

# Test-only: DECIMAL column vs literal comparisons through run_sql (the SQL
# door of komira_sdk_exec) against the answers of the pinned DuckDB. oracle/
# holds the SQL that DuckDB runs: table.sql builds the table `t` (nine nullable
# DECIMAL columns of precision 15 to 38 and scale 0 to 10, with NULLs and
# extreme rows) and table_x.sql the table `tx` (four columns that hold values
# so large that DuckDB cannot widen them to the scale of a longer literal);
# write.sql and write_x.sql write them as t.parquet and tx.parquet; every
# other action starts from one of them. compare_<col>.sql counts, for each
# literal and each of the six comparison operators, the rows of one column that
# the comparison keeps, and the rows for which DuckDB raises an error instead
# (TRY gives NULL); where.sql does the same for whole WHERE texts; types.sql
# records DuckDB's type and value for each constant a comparison folds;
# errors.sql records the constants DuckDB cannot fold. The first comment of
# each file says what it holds; each repeats one SELECT per literal or
# predicate. A test reads the literal and the predicate text from DuckDB's own
# answer, so a predicate has one source.
#
#   test_column_<col>[_n]        for every literal of compare_<col>.tsv (part n
#                                of it, for the columns with many literals) and
#                                each operator, the rows `<col> <op> <literal>`
#                                and each reversed spelling keep are DuckDB's,
#                                and a comparison DuckDB raises on is refused
#   test_where_texts             the rows each WHERE text of where.tsv keeps
#                                are DuckDB's
#   test_folded_constants        the plan holds each folded constant as the
#                                DECIMAL DuckDB computes, a constant DuckDB
#                                cannot fold is refused, and Q6's range bounds
#                                are DECIMAL literals
#
# The checks are in checks.mojo (library code), so each test is its own action.
# Nothing depends on this package.
sql_oracle(
    name = "table",
    srcs = ["oracle/table.sql", "oracle/write.sql"],
    outputs = ["t.parquet"],
)

sql_oracle(
    name = "table_f",
    srcs = ["oracle/table_f.sql", "oracle/write_f.sql"],
    outputs = ["tf.parquet"],
)

sql_oracle(
    name = "table_x",
    srcs = ["oracle/table_x.sql", "oracle/write_x.sql"],
    outputs = ["tx.parquet"],
)

[sql_oracle(
    name = "compare_" + col,
    srcs = ["oracle/table.sql", "oracle/compare_" + col + ".sql"],
    outputs = ["compare_" + col + ".tsv"],
) for col in ["a", "b", "c", "d", "e", "f", "m", "g", "h"]]

[sql_oracle(
    name = "compare_" + col,
    srcs = ["oracle/table_f.sql", "oracle/compare_" + col + ".sql"],
    outputs = ["compare_" + col + ".tsv"],
) for col in ["fb", "fc", "fd", "fe", "ff", "fg", "fh"]]

[sql_oracle(
    name = "compare_" + col,
    srcs = ["oracle/table_x.sql", "oracle/compare_" + col + ".sql"],
    outputs = ["compare_" + col + ".tsv"],
) for col in ["xq", "xr", "xs", "xw"]]

[sql_oracle(
    name = name,
    srcs = ["oracle/table.sql", "oracle/" + name + ".sql"],
    outputs = [name + ".tsv"],
) for name in ["where", "types"]]

sql_oracle(
    name = "double_sweep",
    srcs = ["oracle/double_sweep.sql"],
    outputs = ["double_sweep.tsv"],
)

sql_oracle(
    name = "errors",
    srcs = ["oracle/errors.sql"],
    outputs = ["errors.tsv"],
)

