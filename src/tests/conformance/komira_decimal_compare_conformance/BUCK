load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/sql:defs.bzl", "sql_oracle")

# Test-only: DECIMAL column vs literal comparisons through run_sql (the SQL
# door of komira_sdk_exec) against the answers of the pinned DuckDB. oracle/
# holds the SQL that DuckDB runs: table.sql builds the table `t` (three
# nullable DECIMAL columns of scale 2, with NULLs and extreme rows) and every
# action starts from it; write.sql writes it as t.parquet; compare_a.sql,
# compare_b.sql and compare_c.sql count, for each literal and each of the six
# comparison operators, the rows of one column that the comparison keeps;
# where.sql does the same for whole WHERE texts; types.sql records DuckDB's
# type and value for each constant a comparison folds. The first comment of
# each file says what it holds; each repeats one SELECT per literal or
# predicate. A test reads the literal and the predicate text from DuckDB's own
# answer, so a predicate has one source.
#
#   test_column_a/b/c            for every literal of compare_<col>.tsv and each
#                                operator, the rows `<col> <op> <literal>` and
#                                the reversed spelling keep are DuckDB's
#   test_where_texts             the rows each WHERE text of where.tsv keeps
#                                are DuckDB's
#   test_folded_constants        the plan holds each folded constant as the
#                                DECIMAL DuckDB computes, and Q6's range bounds
#                                as DECIMAL literals
#
# The checks are in checks.mojo (library code), so each test is its own action.
# Nothing depends on this package.
sql_oracle(
    name = "table",
    srcs = ["oracle/table.sql", "oracle/write.sql"],
    outputs = ["t.parquet"],
)

[sql_oracle(
    name = name,
    srcs = ["oracle/table.sql", "oracle/" + name + ".sql"],
    outputs = [name + ".tsv"],
) for name in ["compare_a", "compare_b", "compare_c", "where", "types"]]

