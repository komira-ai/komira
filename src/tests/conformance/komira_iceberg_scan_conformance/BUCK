load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")
load("@komira//tools/build/sql:defs.bzl", "sql_oracle")
load(":iceberg_table.bzl", "iceberg_table")
load(":orders_files.bzl", "CASES", "ORDERS_INPUTS", "ORDERS_OUTPUTS")

# Test-only: `iceberg_scan` through run_sql (the SQL door of sdk_exec) against
# the answers of the pinned DuckDB's Iceberg extension, over a table written
# the way Iceberg Java writes one.
#
#   :orders_writer  the program (runner/main.mojo) that writes the table
#                   `orders` with komira_iceberg_test_tables: six snapshots
#                   (two appends, a position delete, an equality delete older
#                   than a later append that reinserts a deleted key, an
#                   overwrite that marks a data file DELETED), partitioned by
#                   the identity of `region`, recorded under
#                   file:///warehouse/db/orders
#   :orders_table   that program as a build action; each file it writes is a
#                   sub-target (orders_files.bzl)
#   :answers        oracle/cases.sql run by the pinned DuckDB with its avro
#                   and iceberg extensions loaded (`extensions` of sql_oracle)
#                   over the staged table: one TSV per case
#
#   test_iceberg_scan_parity  each case's query through run_sql over the
#                             staged table, compared with DuckDB's rows;
#                             older snapshots; a metadata file as the path;
#                             an unknown snapshot and an unmoved table refused
#
#   //python/tests:iceberg_scan_test  the same cases through Session.sql
#                                     from Python, over the same staged table
#
# The checks are in the test (the library has no code of its own), so the
# test is its own action. No library depends on this package; the Python
# test //python/tests:iceberg_scan_test stages `:orders_table`, `:answers` and
# oracle/cases.sql.
mojo_binary(
    name = "orders_writer",
    srcs = ["runner/main.mojo"],
    main = "runner/main.mojo",
    deps = ["//src/tests/helpers/komira_iceberg_test_tables:komira_iceberg_test_tables"],
)

iceberg_table(
    name = "orders_table",
    outputs = ORDERS_OUTPUTS,
    writer = ":orders_writer",
    visibility = ["komira//python/tests:"],
)

sql_oracle(
    name = "answers",
    srcs = ["oracle/cases.sql"],
    extensions = [
        "komira//third_party/duckdb:avro_extension[avro.duckdb_extension]",
        "komira//third_party/duckdb:iceberg_extension[iceberg.duckdb_extension]",
    ],
    inputs = ORDERS_INPUTS,
    outputs = [c + ".tsv" for c in CASES],
    visibility = ["komira//python/tests:"],
)

# The cases, for python/tests (test_iceberg_scan.py), which runs each through
# Session.sql and compares the rows with `:answers`.
export_file(
    name = "oracle/cases.sql",
    visibility = ["komira//python/tests:"],
)

_PARITY_DATA = {"cases.sql": "oracle/cases.sql"}

_PARITY_DATA.update(ORDERS_INPUTS)

_PARITY_DATA.update({c + ".tsv": ":answers[" + c + ".tsv]" for c in CASES})

