load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Test-only: komira_http_server against h2spec, an external HTTP/2 conformance
# suite (pinned in //third_party/h2spec). The suite supplies every case; this
# package starts a real HttpServer on 127.0.0.1, runs h2spec against it as a
# child process (komira_supervisor), reads h2spec's JUnit report, and gates
# the result on a reviewed allowlist, h2spec_allowlist.txt: every failing case
# must be listed with a reason, and every listed case must still fail.
#
# The tests are welded (test_srcs), not a standalone mojo_test: the suite's
# verdict is then a build action whose result the cache keeps for exactly
# these inputs (the server's closure, the pinned h2spec and the allowlist),
# so it reruns only when one of them changes, and nothing named
# komira_http_conformance exists unless it passed. Nothing depends on this
# package.
#
# test_report_and_gate checks the report reader and the gate alone, on a
# report in h2spec's exact shape. test_h2spec_conformance is the run itself;
# the certificates are komira_http_core's test fixtures, staged at their
# source paths, and h2spec is staged as `h2spec` in the test's share/.

_TLS_FIXTURES = {
    "src/komira_http_core/tests/fixtures/tls/leaf_cert.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_cert.pem",
    "src/komira_http_core/tests/fixtures/tls/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
    "src/komira_http_core/tests/fixtures/tls/root_ca.pem": "//src/komira_http_core:tests/fixtures/tls/root_ca.pem",
}

mojo_library(
    name = "komira_http_conformance",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_clock:komira_clock",
        "//src/komira_fork_join:komira_fork_join",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_http_server:komira_http_server",
        "//src/komira_supervisor:komira_supervisor",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    # h2spec publishes Linux and macOS builds for amd64 only, and the welded
    # test runs it as a child process: no darwin-arm64 build of it exists.
    target_compatible_with = ["prelude//cpu/constraints:x86_64", "prelude//os/constraints:linux"],  # komira-limit:h2spec-linux-x86-64
    test_srcs = [
        "tests/test_report_and_gate.mojo",
        "tests/test_h2spec_conformance.mojo",
    ],
    test_data = {
        "tests/test_h2spec_conformance.mojo": _TLS_FIXTURES | {
            "h2spec": "//third_party/h2spec:h2spec[h2spec]",
            "src/tests/conformance/komira_http_conformance/h2spec_allowlist.txt": "h2spec_allowlist.txt",
        },
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
