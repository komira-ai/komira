load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Read a project's Cloud Monitoring metrics through komira_metrics_reader:
# `CloudMonitoringMetricsReader`, a `MetricsReader` for one project, over
# the generated komira_gcp_monitoring_client's `MetricServiceClient.
# list_time_series`, with a bearer token from a komira_gcp_core token
# source; a non-2xx answer raises through komira_gcp_core's
# `gcp_status_error`. time_series_list.mojo is the adapter (pure): the
# request it builds and refuses, the filter, and the page it reads from the
# generated response.
#
# Welded tests, none of which talks to the service: test_monitoring_protos
# (the host, path, page-size ceiling, minimum alignment, point order,
# interval and aligner and reducer names against the pinned googleapis
# protos, //tools/vendor/googleapis:monitoring_v3), test_monitoring_requests
# (the generated request the adapter builds, field by field, its refusals,
# and the filter), test_monitoring_responses (series, the quoted int64Value,
# NaN, point order, malformed bodies never echoed), test_monitoring_reader
# (the reader against the seam over komira_http_core's ScriptedConnector:
# the request line as it reached the wire, byte for byte, paging and merging
# on the whole series identity, the limits, the error shape) and
# test_no_env_reads (the sources read no environment).
mojo_library(
    name = "komira_gcp_monitoring",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_data = {
        "tests/test_monitoring_protos.mojo": {
            f: "//tools/vendor/googleapis:googleapis[{}]".format(f)
            for f in [
                "google/monitoring/v3/common.proto",
                "google/monitoring/v3/metric_service.proto",
            ]
        },
        "tests/test_no_env_reads.mojo": {
            "src/" + f: f
            for f in glob(["*.mojo"])
        },
    },
    test_srcs = [
        "tests/test_monitoring_protos.mojo",
        "tests/test_monitoring_reader.mojo",
        "tests/test_monitoring_requests.mojo",
        "tests/test_monitoring_responses.mojo",
        "tests/test_no_env_reads.mojo",
    ],
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_gcp_monitoring_client:komira_gcp_monitoring_client",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_metrics_reader:komira_metrics_reader",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
    visibility = ["PUBLIC"],
)
