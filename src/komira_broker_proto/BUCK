load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The multi-node routing types of a broker cluster
# (`komira/broker/v1/broker.proto`, package
# `komira.broker.v1`): BrokerClusterMap, NodeEndpoint, PartitionLeader,
# NodeLoad, ClusterConfig. Generated into the Mojo package
# `komira_broker_proto`:
#
#   from komira_broker_proto.broker import BrokerClusterMap
#
# A leaf: it imports no other `.proto`. `komira_supervisor_proto` imports it,
# naming `:komira_broker_proto_gen` (the generation half, which carries the
# `.proto` files) in its `proto_deps`.
# The `.proto` sits at its import path so the path matches the proto package.
# The generated message structs conform to the `komira_proto_codec` codec runtime,
# the only Mojo dependency. `test_srcs` welds the package to its field-number
# census, and README.md's examples run as one more welded test.
mojo_proto_library(
    name = "komira_broker_proto",
    srcs = ["komira/broker/v1/broker.proto"],
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    test_srcs = ["tests/test_broker_field_numbers.mojo"],
    visibility = ["PUBLIC"],
)
