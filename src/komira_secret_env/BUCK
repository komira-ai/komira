load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A SecretStore whose handle is the NAME of an environment variable: the
# store kci composes for `--secret-store=env`. It depends on
# komira_secret_store (the port), komira_libc (the one getenv
# declaration) and komira_crypto (the buffer wipe).
#
# The welded tests run hermetically: one over the MapEnv double, one over
# the real process environment, with the variables set by `test_env` below
# (the gate runner exports them for the test; the host's environment does not
# reach it).
mojo_library(
    name = "komira_secret_env",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_libc:komira_libc",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_secret_store:komira_secret_store",
    ],
    test_srcs = [
        "tests/test_env_secret_store.mojo",
        "tests/test_process_env.mojo",
    ],
    test_env = {
        "KOMIRA_SECRET_ENV_TEST_EMPTY": "",
        # MAX_SECRET_LEN (4096) bytes, and one byte more.
        "KOMIRA_SECRET_ENV_TEST_LONG": "q" * 4097,
        "KOMIRA_SECRET_ENV_TEST_MAX": "q" * 4096,
        "KOMIRA_SECRET_ENV_TEST_SET": "s3cr3t-value",
        "KOMIRA_SECRET_ENV_TEST_UTF8": "données=1",
    },
    visibility = ["PUBLIC"],
)
