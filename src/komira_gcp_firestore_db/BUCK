load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# komira_gcp_firestore_db: the komira_db `Database` conformer over Google Cloud
# Firestore, and an in-process Firestore double for tests.
#
#   - firestore_database: `FirestoreDatabase[C, S]`, the neutral `Database`
#     operations (get, insert, conditional update, query, delete, the
#     create-if-absent and updateTime CAS) on komira_gcp_firestore's document
#     client, which is the generated Firestore client underneath.
#     `begin`/`commit`/`rollback` journal the creates of a transaction and
#     roll back by deleting them: each write is its own one-write Commit.
#   - firestore_index_guard: every structured query is checked against the
#     composite indexes the caller declared for the database (the
#     `DeclaredIndexSet` passed to `FirestoreDatabase`), and a shape that
#     needs an undeclared one is refused before it is sent (Firestore would
#     answer FAILED_PRECONDITION).
#   - mock_firestore: `MockFirestore`, a stateful in-memory Firestore that
#     answers the client's BatchGetDocuments, Commit and RunQuery at the HTTP
#     boundary (a komira_gcp_firestore `HttpExchange` behind an
#     `ExchangeConnector`), reading each request with the generated messages,
#     so a `FirestoreDatabase` runs the real generated client in a test with
#     no network.
#
# Every test runs on MockFirestore: no network, no credentials, no emulator.
mojo_library(
    name = "komira_gcp_firestore_db",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_db:komira_db",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_gcp_firestore:komira_gcp_firestore",
        "//src/komira_gcp_firestore:komira_gcp_firestore_v1",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
    test_srcs = [
        "tests/test_firestore_conditional_update_multirow.mojo",
        "tests/test_firestore_database_standalone.mojo",
        "tests/test_firestore_db_batch_cap_delete.mojo",
        "tests/test_firestore_db_batch_cap_update.mojo",
        "tests/test_firestore_db_claim.mojo",
        "tests/test_firestore_db_encoding.mojo",
        "tests/test_firestore_db_non_ascii_doc_id.mojo",
        "tests/test_firestore_db_query.mojo",
        "tests/test_firestore_db_tx.mojo",
        "tests/test_firestore_index_guard.mojo",
        "tests/test_firestore_index_guard_shapes.mojo",
        "tests/test_mock_firestore.mojo",
    ],
    visibility = ["PUBLIC"],
)
