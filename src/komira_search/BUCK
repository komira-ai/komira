        "//src/komira_hash:komira_hash",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_scan_source:komira_scan_source",
    ],
    test_srcs = [
        "tests/test_multi_split_merge.mojo",
        "tests/test_search_analyzer.mojo",
        "tests/test_search_analyzer_alloc_perf.mojo",
        "tests/test_search_analyzer_simd_classify.mojo",
        "tests/test_search_bm25.mojo",
        "tests/test_search_cov_analyzer.mojo",
        "tests/test_search_cov_ff_corrupt.mojo",
        "tests/test_search_cov_ff_types.mojo",
        "tests/test_search_cov_index_dict.mojo",
        "tests/test_search_cov_merge.mojo",
        "tests/test_search_cov_sink.mojo",
