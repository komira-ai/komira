        "tests/test_search_cov_split_parse.mojo",
        "tests/test_search_cov_source_e2e.mojo",
        "tests/test_search_cov_source_units.mojo",
        "tests/test_search_cov_source_wand.mojo",
        "tests/test_search_fast_fields.mojo",
        "tests/test_search_ff_preresolve.mojo",
        "tests/test_search_inverted.mojo",
        "tests/test_search_l0_split_refused.mojo",
        "tests/test_search_source_core.mojo",
        "tests/test_search_split.mojo",
        "tests/test_search_term_dict.mojo",
        "tests/test_search_wand_phase0_equivalence.mojo",
    ],
