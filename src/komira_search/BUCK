load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The full-text search engine core: the per-field analyzer, the in-memory
# inverted index builder, the two-stage term dictionary, the immutable split
# file (postings, doc store, fast fields), BM25 scoring, multi-split merge, and
# the read-side search core that answers match queries with top-k hits, sorts
# and aggregations.
mojo_library(
    name = "komira_search",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
