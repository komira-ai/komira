load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The Postgres driver for db: `PgDatabase` conforms to the
# backend-generic `SqlDatabase` trait over the wire client in `wire/`, and
# `PgPool` is the `Pool[PgDatabase]` specialization.
#
# `wire/` is the native Postgres pgwire-v3 client: SCRAM-SHA-256 authentication
# over TLS 1.3 (s2n, through komira_http's TLS layer), the simple and extended
# query protocols with binary-format codecs for a closed OID set, and
# poll-shaped query and transaction operations driven by a async_rt
# reactor.
#
# The tests (under tests/) need no database server: SCRAM and codec
# vectors, hand-built rows, host resolution through /etc/hosts, the
# poll-shaped read frame driven over a local socketpair, and a PgConnection
# reading a canned reply over an in-process TLS session on a socketpair (with
# http_core's throwaway test certificate).

# http_core's throwaway leaf certificate and key, for the tests that run a TLS
# session over a socketpair.
_TLS_FIXTURES = {
    "src/http_core/tests/fixtures/tls/leaf_cert.pem": "//src/http_core:tests/fixtures/tls/leaf_cert.pem",
    "src/http_core/tests/fixtures/tls/leaf_key.pem": "//src/http_core:tests/fixtures/tls/leaf_key.pem",
}

mojo_library(
    name = "db_postgres",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/async_rt:async_rt",
        "//src/crypto:crypto",
        "//src/db:db",
        "//src/encoding:encoding",
        "//src/http_core:http_core",
        "//src/net:net",
    ],
    test_srcs = [
        "tests/test_binary_codec.mojo",
        "tests/test_dns_resolve_pg_host.mojo",
        "tests/test_frame_and_wire_edges.mojo",
        "tests/test_pg_connection_paths.mojo",
        "tests/test_pg_driver_mappers.mojo",
        "tests/test_pg_pool_lease.mojo",
        "tests/test_pg_query_op_poll.mojo",
        "tests/test_pg_tx_op_sequence.mojo",
        "tests/test_pgrow_accumulation.mojo",
        "tests/test_read_frame_guard.mojo",
        "tests/test_scram_and_pgwire.mojo",
        "tests/test_server_free_helpers.mojo",
        "tests/test_truncated_closes_connection.mojo",
        "tests/test_truncated_messages.mojo",
        "tests/test_wire_decode_edges.mojo",
    ],
    test_data = {
        "tests/test_pg_connection_paths.mojo": _TLS_FIXTURES,
        "tests/test_truncated_closes_connection.mojo": _TLS_FIXTURES,
    },
    visibility = ["PUBLIC"],
)
