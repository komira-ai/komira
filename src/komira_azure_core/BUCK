load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Azure-wide credentials, hand-written: the Storage account key and SAS types
# with a static provider for each, the OAuth2 bearer token and the readers of
# a token response, AzureImdsProvider (managed identity, through the Azure
# Instance Metadata Service) and ServicePrincipalProvider (the Entra
# client-credentials grant). Both token providers send through any
# komira_http_client HttpService on a komira_async reactor, and keep their
# token's expiry on komira_clock's wall clock. Every setting is a parameter:
# nothing here reads the environment. Shared Key signing is Storage-specific
# and lives in komira_azure_blob.
#
# The tests are hermetic, no socket: test_azure_credentials (the types, the
# static providers, the token-response readers and their named errors),
# test_azure_token_providers (each provider's request on the wire through a
# capturing HttpService, its cached token and expiry, the refusals that
# cache nothing, and the refresh margin) and test_no_env_reads (the
# package's sources read no environment).
mojo_library(
    name = "komira_azure_core",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
    ],
    test_data = {
        "tests/test_no_env_reads.mojo": {
            "src/" + f: f
            for f in glob(["*.mojo"])
        },
    },
    test_srcs = [
        "tests/test_azure_credentials.mojo",
        "tests/test_azure_token_providers.mojo",
        "tests/test_no_env_reads.mojo",
    ],
    visibility = ["PUBLIC"],
)
