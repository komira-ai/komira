load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The registry's handle layer: FsHandle, the closed sum of the concrete file
# systems a plan's descriptors stand for, with the local arm (komira_fs's
# LocalFs), the S3 arm (komira_objectstore_s3's S3Fs) and the Azure arm
# (komira_azure_blob's AzureFs, with az://, abfs[s]://, https:// and
# emulator http:// URLs parsed here and a Shared Key, SAS token or anonymous
# credential), the S3 and Azure arms over a connector that is plaintext for an http://
# endpoint and komira_http_client's TLS connector otherwise, tags equal to
# komira_plan_expr's FS_SCHEME_* codes. The GCS code is reserved, and a
# descriptor naming it is refused with an error that names the missing arm. The engine's registry,
# which dispatches a plan over handles, imports this package; this package
# does not execute plans.
#
# komira_runtime_paths is a library dep only because mojo_library has no
# test-only deps: test_fs_handle_local_read takes its scratch directory from
# `test_tmpdir()`. Do not drop it as unused. komira_retry is one likewise,
# for test_fs_handle_shared_creds, which builds an S3Config with a retry
# policy. komira_azure_core is one too, for the Azure tests, which build
# AzureSharedKey and AzureSas credentials.
#
# The tests are hermetic, no socket: test_fs_handle_arms (each arm
# constructs and clones with its tag, nothing dialed: the production S3
# arm's connector factory raises if called), test_fs_handle_from_typed_fs
# (the wrap and the arm test, and None for a file system that is not an arm's
# type), test_fs_handle_local_read (a real file read through the local arm),
# test_fs_handle_s3_read (the S3 arm read through komira_http_core's
# ScriptedConnector, a wrapped built store kept, and the production
# connector's TLS form refusing a plaintext http:// endpoint),
# test_fs_handle_s3_scheme (the endpoint's scheme picks the connector: an
# http:// endpoint read over the plaintext side of a split connector, an
# https:// one over the TLS side, any other scheme refused, and the
# production factory's and the production arm's choice),
# test_fs_handle_azure_url (parse_azure_url's accepted forms and its
# refusals by exact message, the encoded forms' paths percent-decoded once,
# a URL merged with the configured account and endpoint (a URL naming any
# other endpoint refused), and an endpoint into komira_azure_blob's
# AzureConfig),
# test_fs_handle_azure_read (the Azure arm read through the handle over a
# scripted connector that keeps the wire: a SAS token in the query, a Shared
# Key signing, anonymous, a clone signing as its source does, the endpoint's
# scheme picking the connector, and the production arm's connector and
# refusals), test_fs_handle_shared_creds (a
# handle and its clone sign with the credential the shared default chain
# holds now, one refresh for both), test_fs_handle_descriptor (a
# descriptor's tag, Azure's included, the named errors for GCS and an
# unknown scheme,
# and a core-package descriptor resolved by its scheme code) and
# test_no_env_reads (the package's sources read no environment).
mojo_library(
    name = "komira_fs_registry",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_azure_blob:komira_azure_blob",
        "//src/komira_azure_core:komira_azure_core",
        "//src/komira_fs:komira_fs",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_objectstore_s3:komira_objectstore_s3",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_retry:komira_retry",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_data = {
        "tests/test_no_env_reads.mojo": {
            "src/" + f: f
            for f in glob(["*.mojo"])
        },
    },
    test_srcs = [
        "tests/test_fs_handle_arms.mojo",
        "tests/test_fs_handle_azure_read.mojo",
        "tests/test_fs_handle_azure_url.mojo",
        "tests/test_fs_handle_descriptor.mojo",
        "tests/test_fs_handle_from_typed_fs.mojo",
        "tests/test_fs_handle_local_read.mojo",
        "tests/test_fs_handle_s3_read.mojo",
        "tests/test_fs_handle_s3_scheme.mojo",
        "tests/test_fs_handle_shared_creds.mojo",
        "tests/test_no_env_reads.mojo",
    ],
    visibility = ["PUBLIC"],
)
