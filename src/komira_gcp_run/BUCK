load("@komira//tools/build/cloud:gcp.bzl", "mojo_gcp_client")

# Cloud Run Admin v2: REST/JSON clients generated at build time from the
# googleapis protos //tools/vendor/googleapis:run_v2 extracts from its
# pinned archive (nothing of them is copied here). Each of
# `ServicesClient`, `RevisionsClient`, `JobsClient`, `ExecutionsClient` and
# `OperationsClient` sends through komira_http_client's `HttpClient` over
# the komira_http_core `Connector` it is given, takes each request's bearer
# token from a komira_gcp_core `GcpTokenSource`, and raises a non-2xx answer
# through komira_gcp_core's `gcp_status_error`. They read no environment.
#
# `methods` is what komira's callers use:
#   * a deployed service: create, read, list (every location, `-`), replace
#     in place, delete (Services.*), and the keep-last-N revision prune
#     (Revisions.ListRevisions, Revisions.DeleteRevision);
#   * a run-to-completion job: create, read, list, replace, delete, run
#     with per-run argument and environment overrides (Jobs.*), and the
#     execution a run started: read its outcome, cancel it
#     (Executions.GetExecution, Executions.CancelExecution);
#   * the long-running operation every mutating method above returns:
#     read it, or wait on it server-side (GetOperation, WaitOperation).
# The services' other methods are not generated. A method joins the list
# with its own rows in the tests below. None of these requests has a
# request-id field.
#
# The operations client. Run serves the google.longrunning.Operations
# mixin at its own paths (`/v2/{name=projects/*/locations/*/operations/*}`),
# which only the API's service configuration states (run_v2.yaml), not a
# .proto; operations.proto's own bindings (`/v1/{name=operations/**}`) and
# host (longrunning.googleapis.com) are not Run's. `service_config` gives the
# generator run_v2.yaml at the pin: its `http.rules` bind GetOperation and
# WaitOperation of google.longrunning.Operations (bundled operations.proto)
# to Run's paths, and its `name`, run.googleapis.com, is the host of every
# service its `apis` lists, the mixin included. test_run_operations_rules
# holds the generated client to a golden and to run_v2.yaml's rules.
#
# `bundle_only` is the part of the run_v2 closure those methods reach.
# `module_names` gives two files their modules: `k8s.min.proto` (its stem
# is not a module name) and Run's own `status.proto`, beside
# google/rpc/status.proto (an operation's error) in the one flat package.
#
# The clients start at run.googleapis.com, the `google.api.default_host`
# of the pinned protos, Run Admin v2's one endpoint; a resource's region is
# part of its name.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Cloud Run Admin v2 REST reference (no upstream test body is
# copied), each sending through a generated client over komira_http_core's
# ScriptedConnector (no socket, no DNS: the wire tests send to localhost):
# test_run_services and test_run_jobs (each method's request line with its
# resource-name captures and query, headers and JSON body byte for byte, an
# Update with no resource refused before the token is asked, and each
# response decoded), test_run_operations (the operation polls on the wire,
# a done operation's response decoded as its type, a failed one's status,
# a name outside Run's binding refused), test_run_errors (one
# google.rpc.Status envelope per method mapped to its code, the body never
# quoted), test_run_endpoint (every client's default host read without
# sending, an override dialled), test_run_operations_rules (the operations
# client is its golden, with run_v2.yaml's bindings) and test_no_env_reads (no generated module
# reads the environment, and only the methods above are generated).
#
# No test here talks to the service.
mojo_gcp_client(
    name = "komira_gcp_run",
    bundle_only = [
        "google/api/launch_stage.proto",
        "google/cloud/run/v2/condition.proto",
        "google/cloud/run/v2/execution.proto",
        "google/cloud/run/v2/execution_template.proto",
        "google/cloud/run/v2/job.proto",
        "google/cloud/run/v2/k8s.min.proto",
        "google/cloud/run/v2/revision.proto",
        "google/cloud/run/v2/revision_template.proto",
        "google/cloud/run/v2/service.proto",
        "google/cloud/run/v2/status.proto",
        "google/cloud/run/v2/task_template.proto",
        "google/cloud/run/v2/traffic_target.proto",
        "google/cloud/run/v2/vendor_settings.proto",
        "google/longrunning/operations.proto",
        "google/rpc/status.proto",
    ],
    bundle_proto_deps = True,
    methods = [
        "Executions.CancelExecution",
        "Executions.GetExecution",
        "Jobs.CreateJob",
        "Jobs.DeleteJob",
        "Jobs.GetJob",
        "Jobs.ListJobs",
        "Jobs.RunJob",
        "Jobs.UpdateJob",
        # Qualified: the mixin, bound by run_v2.yaml's http.rules.
        ".google.longrunning.Operations.GetOperation",
        ".google.longrunning.Operations.WaitOperation",
        "Revisions.DeleteRevision",
        "Revisions.ListRevisions",
        "Services.CreateService",
        "Services.DeleteService",
        "Services.GetService",
        "Services.ListServices",
        "Services.UpdateService",
    ],
    module_names = {
        "google/cloud/run/v2/k8s.min.proto": "k8s_min",
        "google/cloud/run/v2/status.proto": "run_status",
    },
    proto_deps = ["//tools/vendor/googleapis:run_v2"],
    protocol = "rest",
    protos = [],
    service_config = "//tools/vendor/googleapis:googleapis[google/cloud/run/v2/run_v2.yaml]",
    test_data = {
        # The whole generated package, so the scan covers every file the
        # generator writes with no second list of them to drift.
        "tests/test_no_env_reads.mojo": {"gen": ":komira_gcp_run_gen"},
        "tests/test_run_operations_rules.mojo": {
            "gen": ":komira_gcp_run_gen",
            "operations_client.golden": "tests/operations_client.golden",
            "run_v2.yaml": "//tools/vendor/googleapis:googleapis[google/cloud/run/v2/run_v2.yaml]",
        },
    },
    test_srcs = [
        "tests/test_no_env_reads.mojo",
        "tests/test_run_endpoint.mojo",
        "tests/test_run_errors.mojo",
        "tests/test_run_jobs.mojo",
        "tests/test_run_operations.mojo",
        "tests/test_run_operations_rules.mojo",
        "tests/test_run_services.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
)
