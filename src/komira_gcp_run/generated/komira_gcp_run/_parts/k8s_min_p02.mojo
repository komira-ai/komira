            if _pb_field.field_no == 1 or _pb_field.json_name == "bucket":
                bucket = dec.read_string()
            elif _pb_field.field_no == 2 or _pb_field.json_name == "object":
                object = dec.read_string()
            elif _pb_field.field_no == 3 or _pb_field.json_name == "generation":
                generation = dec.read_i64()
            else:
                dec.skip()
        return Self(bucket^, object^, generation)
