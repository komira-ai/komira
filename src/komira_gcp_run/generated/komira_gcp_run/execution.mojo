            if out.byte_length() > 0:
                out += String("/")
            var j = vi
            while j < ve:
                _rest_pct_append(out, vb[j])
                j += 1
            took += 1
            if ve < len(vb):
                vi = ve + 1
            else:
                vleft = False
        if took == 0 and not dstar:
            raise Error(
                String("path variable `") + field
                + String("` does not match `") + pattern + String("`")
            )
        pi = pe + 1
    if vleft:
        raise Error(
            String("path variable `") + field
            + String("` does not match `") + pattern + String("`")
        )
    # A lone `**` takes zero segments of an empty value; the path would then
    # end in the `/` before the variable and name a different resource.
    if out.byte_length() == 0:
        raise Error(
            String("path variable `") + field
            + String("` has an empty, `.` or `..` segment")
        )
    return out^


def _rest_drop_members(json: String, names: List[String]) raises -> String:
    """`json` without its top-level members whose key is in `names`: the
    `body: "*"` of a method whose path binds fields, which
    `google/api/http.proto` defines as every field the path does not bind.
    `json` is an object as `encode_json` writes it, with no whitespace; each
    kept member is copied byte for byte, so no value is rendered again. An
    error never echoes the text."""
    var b = json.as_bytes()
    var n = len(b)
    if n < 2 or b[0] != 0x7B or b[n - 1] != 0x7D:
        raise Error(String("REST body is not a JSON object"))
    var out = List[UInt8](capacity=n)
    out.append(0x7B)  # '{'
    var kept = 0
    var i = 1
    while i < n - 1:
        var start = i
        # The key: a JSON string, its escapes skipped.
        if b[i] != 0x22:
            raise Error(String("REST body member has no key"))
        var k = i + 1
        while k < n - 1 and b[k] != 0x22:
            if b[k] == 0x5C:
                k += 1
            k += 1
        if k + 1 >= n - 1 or b[k] != 0x22 or b[k + 1] != 0x3A:
            raise Error(String("REST body member has no key"))
        var drop = False
        for name in names:
            var nb = name.as_bytes()
            if len(nb) == k - i - 1:
                var same = True
                var t = 0
                while same and t < len(nb):
                    same = nb[t] == b[i + 1 + t]
                    t += 1
                if same:
                    drop = True
        # The value: up to the `,` at this depth, or the closing `}`.
        var depth = 0
        var in_str = False
        var j = k + 2
        while j < n - 1:
            var c = b[j]
            if in_str:
                if c == 0x5C:
                    j += 1
                elif c == 0x22:
                    in_str = False
            elif c == 0x22:
                in_str = True
            elif c == 0x7B or c == 0x5B:
                depth += 1
            elif c == 0x7D or c == 0x5D:
                depth -= 1
            elif c == 0x2C and depth == 0:
                break
            j += 1
        if in_str or depth != 0 or j > n - 1:
            raise Error(String("REST body member has an unterminated value"))
        if not drop:
            if kept > 0:
                out.append(0x2C)  # ','
            var x = start
            while x < j:
                out.append(b[x])
                x += 1
            kept += 1
        i = j + 1
    out.append(0x7D)  # '}'
    return String(unsafe_from_utf8=Span(out))


def _rest_hex_upper(nibble: UInt8) -> String:
    """One uppercase hex digit for a 4-bit nibble."""
    if nibble < 10:
        return chr(Int(0x30 + nibble))
    return chr(Int(0x41 + (nibble - 10)))


def _rest_to_str[T: Writable](v: T) -> String:
    """Stringify a scalar path/query field value. `T: Writable` (NOT
    `Stringable`, which is not available unqualified in a generated module
    in Mojo 1.0.0b1) — `String(v)` is the canonical conversion and every
    scalar (String / Int* / Float* / Bool) conforms to `Writable`."""
    return String(v)


def _rest_bool_str(b: Bool) -> String:
    """Stringify a proto `bool` for the URL as proto3-JSON lowercase
    `true`/`false`. Mojo's `String(Bool)` yields `True`/`False`, which is
    wrong on the wire — proto3 JSON mandates lowercase."""
    if b:
        return String("true")
    return String("false")


# ---- end of REST URL helpers ----

# REST/JSON client for `google.cloud.run.v2.Executions`.
struct ExecutionsClient[C: Connector, T: GcpTokenSource](Movable, Deinitable):
    """The generated REST/JSON client for `Executions`, parametric over the HTTP
        connector `C` and the access-token source `T`.

        Every request carries `Authorization: Bearer <token>` from `T` (a
        `komira_gcp_core.GcpTokenSource`): the client reads no environment
        and holds no credential of its own.

        The connector has one role: the `HttpClient[C]` passed to `__init__`
        owns it, and every method sends through that client's
        `send_buffered`, which checks the URL scheme against the connector,
        sets the dial host (SNI) per request and goes through the client's
        connection pool.
        No method takes a connector of its own.

        The caller owns the time budget: build the `HttpClient[C]` with the
        `HttpClientConfig` that fits the process. A process serving requests
        under a platform deadline (Cloud Run, Lambda) builds it from
        `HttpClientConfig.for_serving_ceiling(ceiling)`, not
        `HttpClient.with_defaults`, whose 600s budget can outlive the
        container. This client applies no ceiling of its own."""

    var _client: HttpClient[Self.C]
    """The HTTP transport."""

    var _token_source: Self.T
    """Where each request's bearer token comes from."""

    var _default_headers: HeaderMap
    """Headers merged into every request. Empty unless given."""

    var _rest_host: String
    """The host the request URLs target: it drives BOTH the dial DNS
        target and the `Host:` header. Starts at the service's
        `google.api.default_host`, `run.googleapis.com`; `set_rest_host` replaces it."""

    var _rest_port: UInt16
    """The port the request URLs name; 0, the default, is the scheme's."""

    var _rest_plaintext: Bool
    """Whether the request URLs are `http` rather than `https`. False
        unless `set_rest_endpoint` says otherwise."""

    def __init__(out self, var client: HttpClient[Self.C], var token_source: Self.T):
        """Construct with no default headers."""
        self._client = client^
        self._token_source = token_source^
        self._default_headers = HeaderMap()
        self._rest_host = String("run.googleapis.com")
        self._rest_port = UInt16(0)
        self._rest_plaintext = False

    def __init__(
        out self,
        var client: HttpClient[Self.C],
        var token_source: Self.T,
        var default_headers: HeaderMap,
    ):
        """Construct with default headers merged into every request."""
        self._client = client^
        self._token_source = token_source^
        self._default_headers = default_headers^
        self._rest_host = String("run.googleapis.com")
        self._rest_port = UInt16(0)
        self._rest_plaintext = False

    def set_rest_host(mut self, var host: String):
        """Point the request URLs at `host` (a regional or private endpoint,
            or a test server). The URL host feeds BOTH the dial-target DNS
            resolution and the injected `Host:` header. An empty host makes
            every method refuse to send."""
        self._rest_host = host^

    def set_rest_endpoint(mut self, var host: String, port: UInt16, plaintext: Bool):
        """Point the request URLs at an endpoint other than the service's
            public one: `host`, `port` (0 for the scheme's own) and, with
            `plaintext`, `http` instead of `https`, which is how an emulator
            serves. The connector must match the scheme: the `HttpClient`
            refuses an `http` URL over a TLS connector and an `https` one over
            a plaintext connector. The bearer token is sent either way."""
        self._rest_host = host^
        self._rest_port = port
        self._rest_plaintext = plaintext

    def _rest_require_host(self, method: String) raises:
        """Raise, naming the method, when no host is set."""
        if self._rest_host.byte_length() == 0:
            raise Error(String("ExecutionsClient.") + method + String(": no REST host: the host was set empty (the service's google.api.default_host is run.googleapis.com); call set_rest_host(host) with a host before sending"))

    def _rest_apply_default_headers(self, mut headers: HeaderMap) raises:
        """Merge the per-client default headers into `headers`."""
        var _rest_i = 0
        while _rest_i < self._default_headers.len():
            var _rest_e = self._default_headers.entry_at(_rest_i)
            headers.append(_rest_e.name, _rest_e.value)
            _rest_i += 1

    def get_execution[RT: Runtime](mut self, req: GetExecutionRequest, mut reactor: Reactor[RT.Sink]) raises -> Execution:
        """GET `/v2/{name=projects/*/locations/*/jobs/*/executions/*}` — REST/JSON."""
        self._rest_require_host(String("get_execution"))
        var path = String("")
        path += String("/v2")
        path += String("/")
        path += _rest_path_var(_rest_to_str(req.name), String("projects/*/locations/*/jobs/*/executions/*"), String("name"))
        var url: Url
        if self._rest_plaintext:
            url = Url.http(self._rest_host.copy(), self._rest_port, path^)
        else:
            url = Url.https(self._rest_host.copy(), self._rest_port, path^)
        var headers = HeaderMap()
        self._rest_apply_default_headers(headers)
        headers.append(String("Authorization"), String("Bearer ") + self._token_source.access_token())
        var req_http = build_get_request(url^, headers^)
        var resp = self._client.send_buffered[RT, EmptyBody](req_http^, reactor)
        var status_int = Int(resp.status)
        var resp_bytes = resp.body.take_bytes()
        if status_int < 200 or status_int >= 300:
            raise gcp_status_error(String("GET"), String("GetExecution"), status_int, resp_bytes)
        var resp_text = String(unsafe_from_utf8=Span(resp_bytes))
        if resp_text.byte_length() == 0:
            resp_text = String("{}")
        return decode_json_lenient[Execution](resp_text)

    def cancel_execution[RT: Runtime](mut self, req: CancelExecutionRequest, mut reactor: Reactor[RT.Sink]) raises -> Operation:
        """POST `/v2/{name=projects/*/locations/*/jobs/*/executions/*}:cancel` — REST/JSON."""
        self._rest_require_host(String("cancel_execution"))
        var path = String("")
        path += String("/v2")
        path += String("/")
        path += _rest_path_var(_rest_to_str(req.name), String("projects/*/locations/*/jobs/*/executions/*"), String("name"))
        path += String(":cancel")
        var url: Url
        if self._rest_plaintext:
            url = Url.http(self._rest_host.copy(), self._rest_port, path^)
        else:
            url = Url.https(self._rest_host.copy(), self._rest_port, path^)
        var headers = HeaderMap()
        self._rest_apply_default_headers(headers)
        headers.append(String("Authorization"), String("Bearer ") + self._token_source.access_token())
        headers.append(String("Content-Type"), String("application/json"))
        var _rest_path_members: List[String] = [String("name")]
        var body_text = _rest_drop_members(encode_json(req), _rest_path_members)
        var body = BytesBody.from_str(body_text)
        var req_http = build_request_with_body[BytesBody](
            HttpMethod.post(), url^, headers^, body^,
        )
        var resp = self._client.send_buffered[RT, BytesBody](req_http^, reactor)
        var status_int = Int(resp.status)
        var resp_bytes = resp.body.take_bytes()
        if status_int < 200 or status_int >= 300:
            raise gcp_status_error(String("POST"), String("CancelExecution"), status_int, resp_bytes)
        var resp_text = String(unsafe_from_utf8=Span(resp_bytes))
        if resp_text.byte_length() == 0:
            resp_text = String("{}")
        return decode_json_lenient[Operation](resp_text)

