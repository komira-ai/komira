load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The span tracer: per-worker span-packet rings, the Tracer, the name registry
# lookups it shares with the exporter, and the JSONL span exporter, including
# the one span-line formatter other packages call instead of copying.
#
# It depends on komira_collections (`Slab[T]`), komira_spsc_ring (`SpscRing[T]`),
# komira_name_registry (`NameRegistry`), komira_clock and komira_atomic_alias (the
# atomic id counters). komira_fork_join (its tests fork real threads) and
# komira_runtime_paths (tests/test_jsonl_exporter.mojo takes its scratch directory
# from `test_tmpdir()`) are dev-dependencies. It must NOT depend on engine
# packages, on komira_log or on komira_metrics: the engine takes a borrowed ref on
# a `Tracer` the embedder constructed.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the tests of tests/ have passed. The tests run in the installed
# layout (`test_layout = "installed"`): test_jsonl_exporter.mojo writes under `test_tmpdir()`
# (`$TEST_TMPDIR`), and only that layout gives the branch coverage run a private one too.
mojo_package(path = ".", test_layout = "installed")

# `:komira_trace`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once
# the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages (the dev-dependencies are not part of what `:lib` is built from): the rule refuses a
# list that is not the closure `:lib` was built from. It carries the README gate too
# (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_trace",
    deps = [
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_name_registry:komira_name_registry",
        "//src/komira_spsc_ring:komira_spsc_ring",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_trace/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_trace-0.1.0-mojo1.0.0_0.conda`), which records the five direct dependencies
# (`mojo-komira_atomic_alias`, `mojo-komira_clock`, `mojo-komira_collections`,
# `mojo-komira_name_registry`, `mojo-komira_spsc_ring`, each `>=0.1,<0.2`) and holds none of their
# files. `members` is the manifests of the path dependencies of the closure, staged at their
# repository paths, because `mopm pack` reads the manifest of each beside the one it is given.
# `:lib` exists only once the tests passed, so this file exists only then. Publishing it
# (`mopm publish`) uploads, which is not a build action: it is a step of a CI job that takes this
# target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_trace",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_atomic_alias": "//src/komira_atomic_alias:mopm.toml",
        "../komira_clock": "//src/komira_clock:mopm.toml",
        "../komira_collections": "//src/komira_collections:mopm.toml",
        "../komira_hash": "//src/komira_hash:mopm.toml",
        "../komira_name_registry": "//src/komira_name_registry:mopm.toml",
        "../komira_spsc_ring": "//src/komira_spsc_ring:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_trace",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/`, and exactly the dependencies of `[dependencies]`
# (the dev-dependencies are left out by `mopm pack`). Red when the manifest drops one, names
# another range, or the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_atomic_alias >=0.1,<0.2",
        "mojo-komira_clock >=0.1,<0.2",
        "mojo-komira_collections >=0.1,<0.2",
        "mojo-komira_name_registry >=0.1,<0.2",
        "mojo-komira_spsc_ring >=0.1,<0.2",
    ],
    package = "komira_trace",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_trace`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_trace_conda",
    lib = ":komira_trace",
    summary = "The `komira_trace` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
