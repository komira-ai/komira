load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The provider-agnostic CDC change-stream seam: `ChangeRecord`, `ChangeBatch`
# and the `ChangeStreamListener` / `MultiShardChangeStreamListener` traits.
# It depends on exactly one library, the zero-dep `komira_rowcell` leaf, for
# the cell model a record carries. It names none of the provider clients (they
# depend on this seam) and not `komira_iceberg` (a consumer of the seam, whose
# closure is the whole query engine); do not add either edge.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# komira_rowcell, a sibling package (`[dependencies]` of mopm.toml): its `:lib` is built from that
# package's `:lib`.
mojo_package(path = ".")

# `:komira_snapshotter`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of
# those packages: the rule refuses a list that is not the closure `:lib` was built from. It carries
# the README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_snapshotter",
    deps = ["//src/komira_rowcell:komira_rowcell"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_snapshotter/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_snapshotter-0.1.0-mojo1.0.0_0.conda`), which records komira_rowcell as a dependency
# (`mojo-komira_rowcell >=0.1,<0.2`) and holds that package's files nowhere. `members` is the manifest of
# the path dependency, staged at its repository path, because `mopm pack` reads it beside the one it is
# given. `:lib` exists only once the tests passed, so this file exists only then. Publishing it
# (`mopm publish`) uploads, which is not a build action: it is a step of a CI job that takes this
# target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_snapshotter",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../komira_rowcell": "//src/komira_rowcell:mopm.toml"},
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_snapshotter",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/` (komira_rowcell is not in it), and exactly one dependency,
# `mojo-komira_rowcell >=0.1,<0.2`, which is what installing the package pulls in.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_rowcell >=0.1,<0.2"],
    package = "komira_snapshotter",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_snapshotter`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_snapshotter_conda",
    lib = ":komira_snapshotter",
    summary = "The `komira_snapshotter` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
