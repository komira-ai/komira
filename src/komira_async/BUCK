load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The async runtime: the per-core reactor (epoll on Linux, kqueue on macOS),
# the worker pool and fork-join dispatcher, channels, timers, cancellation,
# and async sync primitives. It
# depends on the core packages (collections, Arrow types, the POSIX wrappers),
# komira_atomic_alias and komira_log (the worker loop drains its per-core log
# ring). komira_runtime_paths is declared because several tests take their
# scratch directory from `test_tmpdir()`.

# The reactor's C side: signal handling, socket and filesystem wrappers with
# fixed arity, and the scheduler-trace counters.
staged_files(
    name = "posix_shim_files",
    srcs = [
        "reactor/_posix_shim.c",
        "reactor/_sched_labels.inc",
    ],
)

cxx_library(
    name = "komira_async_posix",
    srcs = [":posix_shim_files[reactor/_posix_shim.c]"],
    headers = {"_sched_labels.inc": ":posix_shim_files[reactor/_sched_labels.inc]"},
    header_namespace = "",
    compiler_flags = ["-O2", "-Wall", "-Werror"],
    visibility = ["PUBLIC"],
)

