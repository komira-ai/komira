load("@buildrules//rules/mojo:pack.bzl", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/native:shared.bzl", "native_shared_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Byte-stream codec trait and the eight codec implementations.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"). `:lib` is the library
# file and exists only once every test of tests/ has passed. Its one native library is snappy
# (`[native.snappy]` of mopm.toml): `natives` names the `native_library` target that builds it,
# //third_party/snappy:snappy_native (`libsnappy.a`, C++17, its C API renamed komira_snappy_*), instead of the
# package compiling a source of its own. `mojo_package` links the archive into every test of the package and of
# the packages that depend on it, and packs it into `:conda`. The codec libraries opened at run time (bzip2,
# xz, zstd; libz and liblz4 are komira_zlib's and komira_lz4's) are `[native-dependencies]` with
# `mode = "load"`.
mojo_package(
    path = ".",
    natives = {"libsnappy.a": "//third_party/snappy:snappy_native"},
    test_data = {
        "tests/test_gzip_lz4_frame_conformers.mojo": {
            "golden/gettysburg.txt": "//third_party/pierrec-lz4:gettysburg.txt",
            "golden/gettysburg.txt.lz4": "//third_party/pierrec-lz4:gettysburg.txt.lz4",
        },
    },
)

# `:komira_compression`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the tests
# have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those packages. `dlopen` is
# the sonames the library opens at run time (OwnedDLHandle, codec_libraries.mojo): the conda package
# `komira_compression_conda` requires the conda-forge package tools/build/package/system_libs.bzl names for
# each, and `[native-dependencies]` of mopm.toml says the same for `:conda`. `c_deps` and `native` are the
# older packaging of the same snappy (below): the shared library of the release set.
mojo_adopted_library(
    name = "komira_compression",
    c_deps = ["//third_party/snappy:snappy"],
    deps = [
        "//src/komira_lz4:komira_lz4",
        "//src/komira_zlib:komira_zlib",
    ],
    dlopen = [
        "libbz2.so.1.0",
        "liblzma.so.5",
        "libzstd.so.1",
    ],
    lib = ":lib",
    # snappy is C++: its runtime, once, after the archive (the package's own tests get it from the rules).
    link_runtime = "komira//tools/build/toolchains:libcxx",
    native = ":komira_compression_native",
    readme = "README.md",
    srcs = glob(["src/komira_compression/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/`, the archive that was built and tested (`lib/libsnappy.a` is
# exactly the bytes of the `snappy_native` target), and the direct dependencies: the Mojo packages, then the
# conda packages of the three libraries it opens at run time.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_lz4 >=0.1,<0.2",
        "mojo-komira_zlib >=0.1,<0.2",
        "bzip2 >=1.0.8,<2",
        "liblzma >=5.2.5,<6",
        "zstd >=1.5.2,<2",
    ],
    natives = {"libsnappy.a": "//third_party/snappy:snappy_native"},
    package = "komira_compression",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/artifacts.textproto): komira's conda packer
# over `:komira_compression`. It goes when the release machine takes `:conda`, which is this library's mopm
# package.
conda_package(
    name = "komira_compression_conda",
    lib = ":komira_compression",
    native = ":komira_compression_native",
    summary = "The `komira_compression` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

# libkomira_compression_native.so.1: the C this library owns, as its own
# shared library exporting the names its callers call
# (tools/build/native/README.md, "Each library's shared library"). Built and
# checked here, and packed into the library's conda package (`native`).
native_shared_library(
    name = "komira_compression_native",
    archives = [
        "//third_party/snappy:snappy",
    ],
    callers = [
        ":komira_compression",
    ],
    # snappy is C++: zig's libc++ and libc++abi, static and local.
    cxx_runtime = True,
    library = "komira_compression",
    # Every weak undefined symbol of the library, recorded from its first
    # green link (checks 3 and 7 hold it to exactly this list):
    weak_undefined = [
        # zig's C runtime (crti.o): the profiling hook, absent unless -pg.
        "__gmon_start__",
    ],
    visibility = ["PUBLIC"],
)
