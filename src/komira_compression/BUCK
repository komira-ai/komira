load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load("//src/tests/helpers/komira_udf_spike_node_worker:defs.bzl", "udf_bench")
load(":buildrules.mojo.bzl", "mojo_package")

# Byte-stream codec trait and the codec implementations. Every codec library is a system library
# opened at run time with dlopen (OwnedDLHandle, codec_libraries.mojo): libsnappy, libzstd, libbz2
# and liblzma here, and libz and liblz4 in komira_zlib and komira_lz4. The package links no C: it
# ships no shared library of its own, and `[native-dependencies]` of mopm.toml names each library so
# that installing the package installs the conda package that has it (and so that `mopm lock` pins
# those packages for the tests, mopm.lock "system_libs").
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The welded tests:
# - test_codec_block_api: the block API other packages call (snappy, zstd, bzip2, xz and the
#   too-small and corrupt cases of each).
# - test_codec_libraries: each library this package opens, the snappy entry points in the opened
#   library, and the message of a library that is absent.
# - test_codec_conformers: the Snappy, Zstd, Uncompressed, Lzo, Brotli and Zlib conformers, the nine
#   constructors and the per-worker decompression context handle (Zstd and Lz4Frame), with the
#   too-small and corrupt cases.
# - test_gzip_lz4_frame_conformers: the Gzip and Lz4Frame conformers, the LZ4 frame decoded from
#   //third_party/pierrec-lz4's golden file (pinned by sha256, staged at golden/).
# - test_lz4_raw_conformer_roundtrip: the Lz4Raw conformer's round trip.
mojo_package(
    path = ".",
    test_data = {
        "tests/test_gzip_lz4_frame_conformers.mojo": {
            "golden/gettysburg.txt": "//third_party/pierrec-lz4:gettysburg.txt",
            "golden/gettysburg.txt.lz4": "//third_party/pierrec-lz4:gettysburg.txt.lz4",
        },
    },
)

# `:komira_compression`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. `dlopen`
# is the sonames the library opens at run time: the conda package `komira_compression_conda`
# requires the conda-forge package tools/build/package/system_libs.bzl names for each. It carries
# the README gate too (`[tests][readme]`): the examples run against `:lib`; the test is not run again.
mojo_adopted_library(
    name = "komira_compression",
    deps = [
        "//src/komira_lz4:komira_lz4",
        "//src/komira_zlib:komira_zlib",
    ],
    dlopen = [
        "libbz2.so.1.0",
        "liblzma.so.5",
        "libsnappy.so.1",
        "libzstd.so.1",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_compression/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_compression-0.1.0-mojo1.0.0_0.conda`), which records komira_lz4 and komira_zlib as
# dependencies and the conda packages of the four libraries it opens (`[native-dependencies]`,
# `mode = "load"`). `members` is the manifests of the path dependencies, staged at their repository
# paths, because `mopm pack` reads the manifest of each beside the one it is given. `:lib` exists
# only once the tests passed, so this file exists only then. Publishing it (`mopm publish`) uploads,
# which is not a build action: it is a step of a CI job that takes this target's output. `mopm` is
# the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_compression",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_lz4": "//src/komira_lz4:mopm.toml",
        "../komira_zlib": "//src/komira_zlib:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_compression",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/`, and exactly the dependencies listed, in manifest
# order after the compiler: the two Mojo packages and the four conda packages of the libraries
# opened at run time. Red when the manifest drops one, names another range, or the file carries a
# sibling's files.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_lz4 >=0.1,<0.2",
        "mojo-komira_zlib >=0.1,<0.2",
        "bzip2 >=1.0.8,<2",
        "liblzma >=5.2.5,<6",
        "snappy >=1.1.9,<2",
        "zstd >=1.5.2,<2",
    ],
    package = "komira_compression",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_compression`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_compression_conda",
    lib = ":komira_compression",
    summary = "The `komira_compression` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

# The snappy throughput, on the farm (not a gated test; tests/bench_snappy.mojo says what is
# timed). `:snappy_bench` is the library's snappy block API over the system libsnappy, as every
# caller uses it; `:snappy_bench_static` is the same program over the statically linked
# //third_party/snappy that the library called before it opened the system library. Each keeps the
# one JSON line the program prints; bump tests/bench_run_id to run again:
#   ./buck2 build komira//src/komira_compression:snappy_bench --show-output
mojo_binary(
    name = "snappy_bench_program",
    srcs = ["tests/bench_snappy.mojo"],
    deps = [":komira_compression"],
)

mojo_binary(
    name = "snappy_bench_static_program",
    srcs = ["tests/bench_snappy_static.mojo"],
    deps = [
        "//third_party/snappy:snappy",
    ],
)

udf_bench(
    name = "snappy_bench",
    binary = ":snappy_bench_program",
    exec_compatible_with = LINUX_X86_64,
    libs = [":komira_compression"],
    run_id = "tests/bench_run_id",
)

udf_bench(
    name = "snappy_bench_static",
    binary = ":snappy_bench_static_program",
    exec_compatible_with = LINUX_X86_64,
    run_id = "tests/bench_run_id",
)
