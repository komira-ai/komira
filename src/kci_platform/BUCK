load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The platform seam of the kci deploy side: the catalog's types as data, the
# AdapterSet trait a platform implements, the registry of linked platforms
# (every platform declares every catalog type), the validate phase (graph,
# coverage and limit findings, one pass, one refusal text), plan / apply /
# destroy that validate before lowering, and the conformance kit. Names no
# platform; the in-memory reference platforms are kci_platform_mem.
#
# komira_proto_codec is here for the welded tests, which read graphs in the
# proto3 JSON form an author writes.
mojo_library(
    name = "kci_platform",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_iac:kci_iac",
        "//src/kci_resource_proto:kci_resource_proto",
        "//src/komira_proto_codec:komira_proto_codec",
    ],
    test_srcs = [
        "tests/test_platform_catalog_and_registry.mojo",
        "tests/test_platform_validate_and_deploy.mojo",
    ],
    visibility = ["PUBLIC"],
)
