load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The fake clouds: "fake" (complete) and "fake-limited" (deliberately
# partial: no container job, no worker, no public ingress). Fakes, not mocks: working,
# lightweight in-memory clouds that really deploy. The executable
# specification of a cloud, the offline test double, and the offline proof that a graph a
# cloud cannot host is refused before anything is created. They honour the
# ownership labels, and a faulty variant (failure at call k, read lag, a
# pre-existing foreign object, a raced create) runs offline. "fake" can be
# built with a provider shape (aws, gcp, azure, onprem): the per-cloud fixed roles
# and provider kinds each catalog type lowers to. Every node's create path
# calls kci_cloud's create_labels, so an object created in a scope with a
# validation run id carries the `kci-run-id` label, and every object carries
# the `kci-retention` mark, on every shape and both clouds.
#
# komira_validation_run is in the closure through kci_cloud's label rule
# (create_labels); the welded run-tag test also imports it directly.
#
# komira_proto_codec is here for the welded tests, which read graphs in the
# proto3 JSON form an author writes, and kci_composites for the goldens of
# the definitions kci ships (test_fake_kci_job, test_fake_kci_app).
_KCI_DEFINITIONS = {
    "src/kci_composites/definitions/{}.json".format(d): "//src/kci_composites:{}.json".format(d)
    for d in ["kci.app", "kci.job"]
}

mojo_library(
    name = "kci_cloud_fake",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_cloud:kci_cloud",
        "//src/kci_composites:kci_composites",
        "//src/kci_reconciler:kci_reconciler",
        "//src/kci_resource_proto:kci_resource_proto",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_validation_run:komira_validation_run",
    ],
    test_srcs = [
        "tests/test_deploy_lifecycle_e2e.mojo",
        "tests/test_fake_body_arm.mojo",
        "tests/test_fake_bucket_retention.mojo",
        "tests/test_fake_conformance.mojo",
        "tests/test_fake_faulty_variant.mojo",
        "tests/test_fake_label_budget.mojo",
        "tests/test_fake_limited_refuses_offline.mojo",
        "tests/test_fake_messaging.mojo",
        "tests/test_fake_provider_shapes.mojo",
        "tests/test_fake_secret.mojo",
        "tests/test_fake_dns.mojo",
        "tests/test_fake_compute.mojo",
        "tests/test_fake_triggers.mojo",
        "tests/test_fake_network.mojo",
        "tests/test_fake_registry.mojo",
        # every fake's ArtifactNeed is the one image word, OCI
        "tests/test_fake_required_artifact.mojo",
        "tests/test_fake_metadata.mojo",
        "tests/test_fake_adoption.mojo",
        "tests/test_fake_adoption_release.mojo",
        "tests/test_fake_table.mojo",
        "tests/test_fake_validation_run_tag.mojo",
        "tests/test_fake_composite.mojo",
        "tests/test_fake_kci_job.mojo",
        "tests/test_fake_kci_app.mojo",
    ],
    test_data = {
        # The authored graph the lifecycle test reads, as an author writes it.
        "tests/test_deploy_lifecycle_e2e.mojo": ["tests/test_data/deploy_lifecycle_graph.json"],
        # The definitions kci ships, at the resource names kci_composites
        # reads them by.
        "tests/test_fake_kci_app.mojo": _KCI_DEFINITIONS,
        "tests/test_fake_kci_job.mojo": _KCI_DEFINITIONS,
    },
    visibility = ["PUBLIC"],
)
