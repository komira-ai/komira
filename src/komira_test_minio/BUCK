load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_test")

# An embedded MinIO server the test starts itself: the binary is checked
# against a sha256 pin, the data and a random root credential live in a
# private (0700) temporary directory in 0600 files, both ports are random and
# loopback-only, and the child dies with the test. `start_embedded_minio`
# hands back the endpoint, region and the PATH of an AWS shared-credentials
# file; `stop()` stops the server, removes the directory and returns a
# `Verdict`. No bucket and no object-store client: komira_test_bucket builds
# on top of this, never the other way round.
#
# Deps: komira_test_verdict (the stop verdict), komira_test_run_id (the run
# id that names the temporary directory, and the entropy seam),
# komira_validation_run (the run-id rule, checked before any filesystem
# call), komira_crypto (the binary's sha256) and komira_libc (`_read_env`,
# for the welded tests' TEST_TMPDIR only). chmod(2) is this package's own
# private `_sys` module.
#
# The welded tests are hermetic: a scripted process runner and the test's own
# TEST_TMPDIR; no network and no process is started.
mojo_library(
    name = "komira_test_minio",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_crypto:komira_crypto",
        "//src/komira_libc:komira_libc",
        "//src/komira_test_run_id:komira_test_run_id",
        "//src/komira_test_verdict:komira_test_verdict",
        "//src/komira_validation_run:komira_validation_run",
    ],
    test_srcs = [
        "tests/test_chmod.mojo",
        "tests/test_embedded_minio.mojo",
    ],
    visibility = ["PUBLIC"],
)

# What a test action can do where `buck2 test` runs it: spawn and reap a
# child, loopback TCP, setpriv --pdeathsig and 1 GiB under TEST_TMPDIR are
# required; the uid drop, egress to the conda host and whether TEST_TMPDIR is
# outside any checkout are reported. One `FARM-CAPABILITY ...` line per capability
# (see the file header). Standalone, not in `test_srcs`: it starts processes
# and touches the network, which a library gate must not. Observed results:
# docs/ci.md, "What a farm test action can do".
mojo_test(
    name = "farm_capability_probe",
    srcs = ["tests/farm_capability_probe.mojo"],
    # setpriv, PR_SET_PDEATHSIG and /proc are Linux's; a macOS pool needs a
    # probe of its own (a kqueue parent watcher in place of the death signal).
    target_compatible_with = ["prelude//os/constraints:linux"],  # komira-limit:farm-probe-linux
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_libc:komira_libc",
        "//src/komira_supervisor:komira_supervisor",
    ],
)
