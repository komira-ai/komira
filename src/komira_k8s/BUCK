load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A narrow native Kubernetes pod client: in-cluster (or explicit out-of-cluster)
# config, pod create / get / liveness / delete / list / logs over komira_http's
# HttpClient with a CA-pinned s2n TLS connector, and the typed JSON wire
# mapping. The apiserver host and port are parameters supplied by the caller.
#
# The welded test is the offline parse gate: no cluster and no TLS, it runs the
# loader, the manifest serializer and the PodPhase / deletion-evidence
# derivation over captured apiserver response fixtures under tests/fixtures.

mojo_library(
    name = "komira_k8s",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_http:komira_http",
        "//src/komira_json:komira_json",
    ],
    test_srcs = [
        "tests/test_k8s_config_json.mojo",
    ],
    test_data = {
        "tests/test_k8s_config_json.mojo": glob(["tests/fixtures/**"]),
    },
    visibility = ["PUBLIC"],
)
