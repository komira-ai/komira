load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The artifacts: the reviewed list of what kci builds and
# publishes. A file declares build systems (a program and the args it always
# gets; kci names no build tool) and artifacts (a name, the build system and
# the args appended for it). Reads an artifacts file (textproto) into the
# generated `kci.release.v1.Artifacts`, validates it, and renders
# the argv that builds one artifact into an output
# directory (the seven placeholders substituted in one pass: `{out_dir}`,
# `{release_dir}`, `{platform}` and the git-derived stamp `{revision_id}`,
# `{source_commit}`, `{build_number}`, `{timestamp_ms}`; artifacts build in
# file order, so a metapackage declared last reads its members' manifests
# under `{release_dir}`). One artifact per entry: it also
# holds the two refusals over what a build left (exactly one `manifest.json`
# at the top of the directory; its `name` equal to the artifact's,
# exactly). Pure: it runs no process and reads no directory; the BUILD step
# does.
#
# The welded tests parse and refuse synthetic files in memory, assert each
# refusal by its message, round-trip the parsed value on the proto binary
# wire with every field number pinned as bytes, and render argvs exactly,
# including from `example.textproto`, staged as test data. One more reads the
# repository's own release/artifacts.textproto through the same reader, so a
# release file kci would refuse fails this library's build, holds its
# declared checks to buck2 target patterns, no package in two checks, and
# its buck2 build system to deriving the rest of the checks from the graph,
# and tools/build/package/release_set.txt (the release set the stamped
# release check builds) to the file's metapackage.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on kci_api,
# kci_artifact_proto and komira_textproto, sibling packages (`[dependencies]` of mopm.toml): its
# `:lib` is built from those packages' `:lib`.
mojo_package(
    path = ".",
    test_data = {
        "tests/test_artifact_render.mojo": {"src/kci_artifact/example.textproto": "example.textproto"},
        # The repository's own release artifacts (release/BUCK).
        "tests/test_release_artifacts_file.mojo": {
            "artifacts.textproto": "//release:artifacts.textproto",
            # The release set the stamped release check builds
            # (tools/build/package/release_set.bzl).
            "release_set.txt": "//tools/build/package:release_set.txt",
        },
    },
)

# `:kci_artifact`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once
# the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages: the rule refuses a list that is not the closure `:lib` was built from. It carries the
# README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "kci_artifact",
    deps = [
        "//src/kci_api:kci_api",
        "//src/kci_artifact_proto:kci_artifact_proto",
        "//src/komira_textproto:komira_textproto",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_artifact/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_artifact-0.1.0-mojo1.0.0_0.conda`), which records kci_api, kci_artifact_proto and
# komira_textproto as dependencies (`mojo-kci_api >=0.1,<0.2`, `mojo-kci_artifact_proto >=0.1,<0.2`
# and `mojo-komira_textproto >=0.1,<0.2`) and holds those packages' files nowhere. `members` is the
# manifests of the path dependencies, staged at their repository paths, because `mopm pack` reads
# the manifest of each beside the one it is given. `:lib` exists only once the tests passed, so this
# file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is
# a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/kci_artifact",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../kci_api": "//src/kci_api:mopm.toml",
        "../kci_artifact_proto": "//src/kci_artifact_proto:mopm.toml",
        "../komira_encoding": "//src/komira_encoding:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_proto_codec": "//src/komira_proto_codec:mopm.toml",
        "../komira_protobuf": "//src/komira_protobuf:mopm.toml",
        "../komira_textproto": "//src/komira_textproto:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_artifact",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/` (kci_api, kci_artifact_proto and komira_textproto
# are not in it), and exactly 3 dependencies, `mojo-kci_api >=0.1,<0.2`, `mojo-kci_artifact_proto
# >=0.1,<0.2` and `mojo-komira_textproto >=0.1,<0.2`, which is what installing the package pulls in.
# Red when the manifest drops a dependency, names another range, or the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-kci_api >=0.1,<0.2",
        "mojo-kci_artifact_proto >=0.1,<0.2",
        "mojo-komira_textproto >=0.1,<0.2",
    ],
    package = "kci_artifact",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_artifact`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_artifact_conda",
    lib = ":kci_artifact",
    summary = "The `kci_artifact` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

# The example artifacts file, for tests in other packages that render from
# it (kci_build's flow test stages it as test data).
export_file(name = "example.textproto", visibility = ["PUBLIC"])
