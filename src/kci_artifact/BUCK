load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The artifacts: the reviewed list of what kci builds and
# publishes. A file declares build systems (a program and the args it always
# gets; kci names no build tool) and artifacts (a name, the build system and
# the args appended for it). Reads an artifacts file (textproto) into the
# generated `kci.release.v1.Artifacts`, validates it, and renders
# the argv that builds one artifact into an output
# directory (the seven placeholders substituted in one pass: `{out_dir}`,
# `{release_dir}`, `{platform}` and the git-derived stamp `{revision_id}`,
# `{source_commit}`, `{build_number}`, `{timestamp_ms}`; artifacts build in
# file order, so a metapackage declared last reads its members' manifests
# under `{release_dir}`). One artifact per entry: it also
# holds the two refusals over what a build left (exactly one `manifest.json`
# at the top of the directory; its `name` equal to the artifact's,
# exactly). Pure: it runs no process and reads no directory; the BUILD step
# does.
#
# The welded tests parse and refuse synthetic files in memory, assert each
# refusal by its message, round-trip the parsed value on the proto binary
# wire with every field number pinned as bytes, and render argvs exactly,
# including from `example.textproto`, staged as test data. One more reads the
# repository's own release/artifacts.textproto through the same reader, so a
# release file kci would refuse fails this library's build, holds its
# declared checks to buck2 target patterns, no package in two checks, and
# its buck2 build system to deriving the rest of the checks from the graph,
# and tools/build/package/release_set.txt (the release set the stamped
# release check builds) to the file's metapackage.
mojo_library(
    name = "kci_artifact",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_artifact_proto:kci_artifact_proto",
        "//src/kci_api:kci_api",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_textproto:komira_textproto",
    ],
    test_srcs = [
        "tests/test_artifact_parse.mojo",
        "tests/test_artifact_render.mojo",
        # the per-change check: targets, checks, the two commands, the units,
        # both argvs and the affected tool's answer grammar
        "tests/test_artifact_units.mojo",
        # the derived checks: the derive_checks command, its answer grammar,
        # the checks joining the file under its rules
        "tests/test_artifact_derive.mojo",
        "tests/test_artifact_validate.mojo",
        "tests/test_release_artifacts_file.mojo",
    ],
    test_data = {
        "tests/test_artifact_render.mojo": ["example.textproto"],
        # The repository's own release artifacts (release/BUCK).
        "tests/test_release_artifacts_file.mojo": {
            "artifacts.textproto": "//release:artifacts.textproto",
            # The release set the stamped release check builds
            # (tools/build/package/release_set.bzl).
            "release_set.txt": "//tools/build/package:release_set.txt",
        },
    },
    visibility = ["PUBLIC"],
)

# The example artifacts file, for tests in other packages that render from
# it (kci_build's flow test stages it as test data).
export_file(name = "example.textproto", visibility = ["PUBLIC"])
