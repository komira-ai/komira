load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")

# The aggregation state of the engine: the accumulators (the dynamic accumulator
# and accumulator set, the columnar typed, extra and UTF-8 accumulators, the
# statistical and percentile ones, the adapter that runs a user-defined aggregate
# function), the aggregator and kernel traits with their built-in and struct-state
# implementations, the slab of per-group aggregate states, and the hash tables and
# hash sets that group keys map into (byte-keyed, composite-keyed, dense,
# parametric, growable). Anything that holds or updates a running aggregate lives
# here; the sinks and kernels that drive it are in the packages above.
mojo_library(
    name = "komira_op_agg_state",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_agg:komira_agg",
        "//src/komira_agg_api:komira_agg_api",
        "//src/komira_arrow:komira_arrow",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_expr:komira_expr",
        "//src/komira_kernels:komira_kernels",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_udf:komira_udf",
    ],
    test_srcs = [
        "tests/test_acc_dispatch_tags.mojo",
        "tests/test_acc_extra_edges.mojo",
        "tests/test_acc_factory_readback.mojo",
        "tests/test_acc_new_variants.mojo",
        "tests/test_acc_typed_edges.mojo",
        "tests/test_acc_utf8_agg_edges.mojo",
        "tests/test_acc_variant_trait_conformance.mojo",
        "tests/test_accumulator_set.mojo",
        "tests/test_accumulator_trait.mojo",
        "tests/test_agg_fn_acc_arity34.mojo",
        "tests/test_agg_fn_acc_null_partition_laws.mojo",
        "tests/test_agg_fn_kernel_fanout.mojo",
        "tests/test_agg_fn_podstate_gate.mojo",
        "tests/test_agg_fn_simd_bridge.mojo",
        "tests/test_agg_fn_simplified.mojo",
        "tests/test_aggregator_trait.mojo",
        "tests/test_aos_kernel_sum_count_f64.mojo",
        "tests/test_byte_hash_agg_single_group.mojo",
        "tests/test_byte_hash_agg_table.mojo",
        "tests/test_byte_hashset.mojo",
        "tests/test_cd_presize_oracle.mojo",
        "tests/test_columnar_acc_typed.mojo",
        "tests/test_columnar_agg_accumulator.mojo",
        "tests/test_columnar_agg_sink_combine_simd.mojo",
        "tests/test_composite_hash_table_grow.mojo",
        "tests/test_composite_hash_table_int64_keys.mojo",
        "tests/test_dense_hash_agg_table.mojo",
        "tests/test_growable_hash_set_i64.mojo",
        "tests/test_hashset_parametric.mojo",
        "tests/test_int_sum_overflow.mojo",
        "tests/test_largestk_aggregator.mojo",
        "tests/test_legacy_aggregators.mojo",
        "tests/test_make_single_dyn_acc_new_tags.mojo",
        "tests/test_median_aggregator.mojo",
        "tests/test_median_nan_total_order.mojo",
        "tests/test_misc_edges.mojo",
        "tests/test_ndjson_corr.mojo",
        "tests/test_pack_byte_spans.mojo",
        "tests/test_percentile_accumulator_nan_total_order.mojo",
        "tests/test_row_map_projects.mojo",
        "tests/test_secondary_api.mojo",
        "tests/test_tables_edges.mojo",
        "tests/test_tpch_q1_features.mojo",
        "tests/test_udf_agg_acc.mojo",
    ],
    visibility = ["PUBLIC"],
)

# Microbenchmark of the accumulator update path (not a gated test); see the
# header of the file. Run it on demand with
# `buck2 run //src/komira_op_agg_state:agg_state_bench`.
