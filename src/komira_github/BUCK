    name = "komira_github",
    srcs = glob(["*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_datetime:komira_datetime",
