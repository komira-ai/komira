load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/native:defs.bzl", "native_archive")

# Structured logging: the five-level facade (`log.info[fmt, module](*args)`),
# the typed argument model, the per-module level filter, the synchronous P1
# stderr path, and the P2 engine behind the same call sites (per-core binary
# record rings, decode-at-flush drain, file/stderr/metric sinks, spans). It
# depends on the core packages (`Slab[T]`, raw fd writes), komira_spsc_ring (`SpscRing[T]`),
# komira_clock, komira_hash (the FNV-1a constants),
# komira_atomic_alias (the atomic level gate), komira_trace (the span-line
# formatter the drain renders with) and komira_metrics (the metric point types
# the engine feeds). It also owns the one-line JSON structured logger and the
# bounded write(2) loop every rendered line goes through (`structured_log`,
# `log_write`). komira_runtime_paths is declared
# because several tests take their scratch directory from `test_tmpdir()`.

# The process-global holders: the immortal engine's address, the P1 config's
# address, and the selected line layout. Three one-word C cells, no logic.
staged_files(
    name = "log_holder_files",
    srcs = ["engine/_log_holder_shim.c"],
)

cxx_library(
    name = "komira_log_holder",
    srcs = [":log_holder_files[engine/_log_holder_shim.c]"],
    visibility = ["PUBLIC"],
)

# Its declaration for libkomira_native.so.1 (tools/build/native/README.md):
# kept out of it, linked into each Mojo library that calls it.
native_archive(
    name = "komira_log_holder_native",
    kind = "per_library",
    lib = ":komira_log_holder",
    reason = "Holds the addresses of Mojo structs (the logging engine, its config) that only the library that elaborated them may read: one cell per library, hidden by design (engine/_log_holder_shim.c).",
    visibility = ["PUBLIC"],
)

mojo_library(
    name = "komira_log",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        ":komira_log_holder_native",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_hash:komira_hash",
        "//src/komira_libc:komira_libc",
        "//src/komira_metrics:komira_metrics",
        "//src/komira_spsc_ring:komira_spsc_ring",
        "//src/komira_trace:komira_trace",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
