load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon ECR: an awsJson 1.1 client generated at build time from botocore's
# ecr model (//third_party/botocore, pinned by sha256; nothing of it is
# copied here), in client mode: each operation's request builder and
# response parser, its endpoint resolved through the service's published
# endpoint ruleset and partition table, embedded in the module, and
# `ECRClient`, which resolves each call's endpoint and sends through
# komira_aws_core's send_sigv4_signed_request (signing name `ecr`) over the
# komira_http_core Connector it is given, retrying as botocore's standard
# mode does (komira_aws_core's aws_retry.mojo).
#
# `operations` is what a deployer calls on a registry: a repository looked
# up, created and its tag mutability set, and a registry login token asked
# for. An operation joins the list with its own rows in the tests below.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Amazon ECR API reference (no upstream test body is copied):
# test_ecr_requests (the request each operation builds, exactly, and the
# model's bounds), test_ecr_responses (each result decoded, and the error
# forms read through komira_aws_core and the modeled error shapes),
# test_ecr_endpoints (botocore's endpoint cases for ecr through every
# operation's resolver, and the regional, FIPS, dual-stack and custom
# endpoints), _no_env_reads (written by mojo_aws_client: the package reads
# no environment) and test_ecr_client (the generated client over a scripted
# connector: a call answered, a missing repository raised under its code,
# and a request as it reached the wire, through komira_aws_core's
# AwsEchoConnector).
#
# No test here talks to the service.

_ECR = botocore_model("ecr")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("ecr")

mojo_aws_client(
    name = "komira_aws_ecr",
    endpoint_rules = _ECR.endpoint_rules,
    mode = "client",
    model = _ECR.model,
    model_sha256 = _ECR.sha256,
    operations = [
        "CreateRepository",
        "DescribeRepositories",
        "GetAuthorizationToken",
        "PutImageTagMutability",
    ],
    partitions = _ECR.partitions,
    test_data = {
        "tests/test_ecr_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_ecr_client.mojo",
        "tests/test_ecr_endpoints.mojo",
        "tests/test_ecr_requests.mojo",
        "tests/test_ecr_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` takes a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
