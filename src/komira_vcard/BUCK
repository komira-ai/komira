load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# vCard (RFC 6350): raw cards from a .vcf stream (4.0, 3.0 and 2.1, with
# quoted-printable values and input, line and card-count limits), the RFC
# 9555-guided contact subset with unknown properties kept, and a vCard 4.0
# writer. The content-line layer is komira_content_line.
mojo_library(
    name = "komira_vcard",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = ["//src/komira_content_line:komira_content_line"],
    test_srcs = [
        "tests/test_cards.mojo",
        "tests/test_contacts.mojo",
        "tests/test_round_trip.mojo",
    ],
    visibility = ["PUBLIC"],
)
