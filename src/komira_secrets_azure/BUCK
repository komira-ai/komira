load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A SecretStore over Azure Key Vault's data plane (one GET per resolve), and
# the Entra token sources it reads through (a service principal or a managed
# identity, over komira_azure_core's providers with the audience set to Key
# Vault). It depends on komira_secret_store (the port), komira_azure_core (the
# providers), komira_http_client and komira_http_core (the REST client, the
# Connector seam and the scripted connector the tests use) and komira_async
# (the blocking runtime that drives one request per call). The welded test runs
# over ScriptedConnector: no socket, no DNS, no vault.
mojo_library(
    name = "komira_secrets_azure",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_azure_core:komira_azure_core",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_retry:komira_retry",
        "//src/komira_secret_store:komira_secret_store",
    ],
    test_srcs = ["tests/test_azure_key_vault_store.mojo"],
    visibility = ["PUBLIC"],
)
