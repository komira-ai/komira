load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The shared LZ4 codecs over lz4 1.10.0: the raw block (compress, decompress and
# the compress bound) and the frame (LZ4F_*, the Arrow IPC LZ4_FRAME
# framing). The C library is linked statically (//third_party/lz4, every
# symbol renamed komira_lz4_*), so nothing is opened at run time, and there
# are no first-party deps: the Parquet page codecs, the document store's
# `_source` compression and compression's codecs depend on this leaf and on
# nothing of each other.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. Its one native library is lz4
# (`[native.komira_lz4]` of mopm.toml): `natives` names the `native_library` target that builds it,
# //third_party/lz4:lz4_native (`libkomira_lz4.a`), and `mojo_package` links it into every test of the
# package and of the packages that depend on it, and packs it into `:conda`. The welded tests:
# - test_codec: the List API (`lz4_compress` / `lz4_decompress`) round trips.
# - test_codec_into: the into-buffer API (`lz4_compress_into` /
#   `lz4_decompress_into`): a known-answer block from //third_party/pierrec-lz4
#   (pinned by sha256, staged at golden/), round trips, the empty block, the
#   too-small destination and corrupt blocks.
# - test_frame: the frame API (`lz4_frame_*`, `Lz4FrameDecoder`): the same
#   golden file decoded as the whole frame it is, round trips, a reused
#   decoder, the too-small destination, corrupt and doubled frames.
# - test_static_codec: an LZ4 block and frame round trip leaves no liblz4
#   loaded in the process.
# - test_codec_edges: the refusals the round trips do not reach (negative
#   sizes, an empty or mis-sized block, an empty destination, a moved
#   decoder) and the looping decode of concatenated and skippable frames.
#
# `:conda` (made by `mojo_package`, since the package has a native library of its own) is the mopm
# package, `mopm pack` over `:lib`: the `.conda` a mopm registry serves
# (`mojo-komira-ai.lz4-0.1.0-mojo1.1.0_0.conda`), holding `lib/libkomira_lz4.a`.
mojo_package(
    path = ".",
    natives = {"libkomira_lz4.a": "//third_party/lz4:lz4_native"},
    test_data = {
        "tests/test_codec_into.mojo": {
            "golden/gettysburg.txt": "//third_party/pierrec-lz4:gettysburg.txt",
            "golden/gettysburg.txt.lz4": "//third_party/pierrec-lz4:gettysburg.txt.lz4",
        },
        "tests/test_frame.mojo": {
            "golden/gettysburg.txt": "//third_party/pierrec-lz4:gettysburg.txt",
            "golden/gettysburg.txt.lz4": "//third_party/pierrec-lz4:gettysburg.txt.lz4",
        },
    },
)

# `:lz4`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It hands the archive of `:lib` to a dependent's link. `c_deps` is the older
# packaging of the same lz4 (//third_party/lz4:lz4, the same sources and renaming), and the archive
# ships in this library's conda package (`native_static`) rather than in a shared library of its
# own.
mojo_adopted_library(
    name = "lz4",
    c_deps = ["//third_party/lz4:lz4"],
    native_static = True,
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/lz4/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/artifacts.textproto): komira's conda
# packer over `:lz4`. It goes when the release machine takes `:conda`, which is this
# library's mopm package.
conda_package(
    name = "lz4_conda",
    lib = ":lz4",
    summary = "The `lz4` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
