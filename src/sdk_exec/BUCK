    outputs = [t + ".parquet" for t in _JOIN_KINDS_TABLES] + [c + ".tsv" for c in _JOIN_KINDS_CASES],
)

_JOIN_KINDS_TEST_DATA = {"cases.sql": "tests/join_kinds/cases.sql"}

