        "//src/expr:expr",
        "//src/fork_join:fork_join",
        "//src/fs:fs",
        "//src/hashing:hashing",
        "//src/host_probe:host_probe",
        "//src/host_profile:host_profile",
        "//src/join_assembly:join_assembly",
        "//src/json:json",
        "//src/json_index:json_index",
        "//src/jsonl:jsonl",
        "//src/kernels:kernels",
        "//src/libc:libc",
        "//src/log:log",
        "//src/lowering:lowering",
        "//src/lz4:lz4",
