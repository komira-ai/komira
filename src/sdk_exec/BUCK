        "tests/test_resolved_cache_pin_count.mojo",
        "tests/test_run_sql_copy_parquet.mojo",
        "tests/test_run_sql_csv.mojo",
        "tests/test_run_sql_distinct.mojo",
        "tests/test_run_sql_float_sum_workers.mojo",
        "tests/test_run_sql_group_keys.mojo",
        "tests/test_run_sql_group_keys_mixed.mojo",
        "tests/test_run_sql_int_sum.mojo",
        "tests/test_run_sql_joins.mojo",
        "tests/test_run_sql_multifile.mojo",
        "tests/test_run_sql_no_from.mojo",
        "tests/test_run_sql_q6.mojo",
        "tests/test_run_sql_timers_off.mojo",
        "tests/test_run_sql_union_all.mojo",
        "tests/test_secret_capability_reveal.mojo",
    ],
    test_deps = [
        "//src/bench_corpus:bench_corpus",
        "//src/tests/helpers/komira_plan_harness:komira_plan_harness",
    ],
    test_data = {
