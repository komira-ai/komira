# Test-only: the pinned DuckDB reading back the files run_sql's COPY writes
# (copy_readback/__init__.mojo says why this is a library of its own: its
# test data is built by copy_runner, which depends on sdk_exec, so as test data
# of sdk_exec it would be a cycle). Nothing depends on it.
# - test_copy_readback_duckdb: the pinned DuckDB reads every Parquet, CSV and
#   JSON file run_sql's COPY wrote for tests/copy/cases.sql
#   (:copy_readback_oracle above) and finds the same rows, column names and
#   types as in the file DuckDB writes for the same line, and as many rows as
#   the COPY's `Count`; an uncompressed CSV or JSON file holds the same bytes
#   as DuckDB's; every case of cases.sql is checked.
mojo_library(
    name = "copy_readback",
    srcs = glob(["copy_readback/**/*.mojo"]),
    deps = ["//tools/build/mojo/runtime_paths:runtime_paths"],
    conda = False,
    # The package's README is sdk_exec's: its examples run as sdk_exec's.
    readme = False,
    test_srcs = ["tests/test_copy_readback_duckdb.mojo"],
    test_data = {"tests/test_copy_readback_duckdb.mojo": _COPY_TEST_DATA},
    visibility = ["PUBLIC"],
)
