# DuckDB reading back the Parquet, CSV and JSON files COPY writes, for
# test_copy_readback_duckdb (the `copy_readback` library at the end of this
# file). Each line of tests/copy/cases.sql is one case, named by its file up
# to the first `.`: `:copy_komira` runs every line through run_sql
# (copy_runner below) and `:copy_readback_oracle` runs the same lines in the
# pinned DuckDB, then tests/copy/readback.sql compares the two files of each
# case.
_COPY_FILES = [
    "typed_default.parquet",
    "typed_zstd.parquet",
    "nulls_gzip.parquet",
    "nulls_lz4.parquet",
    "quoted_uncompressed.parquet",
    "grouped_snappy.parquet",
    "empty.parquet",
    "typed_csv.csv",
    "quoted_csv.csv",
    "nulls_csv.csv",
    "empty_string_csv.csv",
    "empty_csv.csv",
    "grouped_csv.csv.gz",
    "typed_zstd_csv.csv.zst",
    "typed_json.json",
    "quoted_json.json",
    "nulls_json.json",
    "grouped_json.json.gz",
    "typed_zstd_json.json.zst",
]

_COPY_CASES = [f.split(".")[0] for f in _COPY_FILES]

_COPY_INPUTS = {f + ".csv": "tests/csv/" + f + ".csv" for f in ["typed", "nulls", "quoted"]}

# The program that runs each COPY line of a cases file through run_sql
# (copy_runner/main.mojo says how).
mojo_binary(
    name = "copy_runner",
    srcs = ["copy_runner/main.mojo"],
    main = "copy_runner/main.mojo",
    deps = [":sdk_exec"],
)

copy_cases(
    name = "copy_komira",
    cases = "tests/copy/cases.sql",
    inputs = _COPY_INPUTS,
    outputs = _COPY_FILES + ["counts.tsv"],
    runner = ":copy_runner",
)

_COPY_READBACK_INPUTS = dict(_COPY_INPUTS)

_COPY_READBACK_INPUTS.update({"komira/" + f: ":copy_komira[" + f + "]" for f in _COPY_FILES})

sql_oracle(
    name = "copy_readback_oracle",
    srcs = ["tests/copy/cases.sql", "tests/copy/readback.sql"],
    inputs = _COPY_READBACK_INPUTS,
    outputs = _COPY_FILES + [c + ".check.tsv" for c in _COPY_CASES],
)

_COPY_TEST_DATA = {"cases.sql": "tests/copy/cases.sql", "counts.tsv": ":copy_komira[counts.tsv]"}

_COPY_TEST_DATA.update({c + ".check.tsv": ":copy_readback_oracle[" + c + ".check.tsv]" for c in _COPY_CASES})

