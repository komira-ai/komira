        "//src/udf:udf",
        "//src/zlib:zlib",
        "//tools/build/mojo/runtime_paths:runtime_paths",
    ],
    test_srcs = [
        "tests/test_plan_cache_full_sink_hash.mojo",
        "tests/test_plan_validation_gate_direct.mojo",
        "tests/test_plan_validation_routes_ledger.mojo",
