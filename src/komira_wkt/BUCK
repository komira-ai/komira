load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The protobuf well-known types (`google.protobuf.Timestamp`, `Duration`,
# `Empty`, the scalar wrappers, `FieldMask`, `Struct` / `Value` /
# `ListValue`) as `Serializable` Mojo structs, each with its proto3
# canonical-JSON special form. Generated clients import these; the first-party
# dependencies are `komira_serde`, `komira_json` and `komira_encoding`.
mojo_library(
    name = "komira_wkt",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_serde:komira_serde",
        "//src/komira_json:komira_json",
        "//src/komira_encoding:komira_encoding",
    ],
    test_srcs = [
        "tests/test_wkt_runtime.mojo",
    ],
    visibility = ["PUBLIC"],
)
