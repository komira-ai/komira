            pe += 1
        var plen = pe - pi
        var dstar = plen == 2 and pb[pi] == 0x2A and pb[pi + 1] == 0x2A
        var star = plen == 1 and pb[pi] == 0x2A
        var took = 0
        while vleft and (dstar or took == 0):
