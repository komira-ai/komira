load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The resources of a simple calendar service's JSON API
# (`komira/calendar/v1/calendar.proto`, package `komira.calendar.v1`):
# Calendar, Event, Recurrence, Reminder, OccurrenceOverride and the error
# envelope. Generated into the Mojo package `komira_calendar_proto`:
#
#   from komira_calendar_proto.calendar import Event
#
# The `.proto` sits at its import path so the path matches the proto package.
# It imports `google/protobuf/timestamp.proto`, whose Mojo type comes from
# `komira_wkt`. The generated message structs conform to the
# `komira_proto_codec` codec runtime. `test_srcs` welds the package to its
# field-number census, and README.md's examples run as one more welded test.
# `komira_calendar` validates these messages.
mojo_proto_library(
    name = "komira_calendar_proto",
    srcs = ["komira/calendar/v1/calendar.proto"],
    deps = [
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
    test_srcs = ["tests/test_calendar_field_numbers.mojo"],
    visibility = ["PUBLIC"],
)
