load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon API Gateway v2: a restJson1 client generated at build time from
# botocore's apigatewayv2 model (//third_party/botocore, pinned by sha256;
# nothing of it is copied here), in client mode: each operation's request
# builder and response parser, its endpoint resolved through the service's
# published endpoint ruleset and partition table, embedded in the module,
# and `ApiGatewayV2Client`, which resolves each call's endpoint
# and sends through komira_aws_core's send_sigv4_signed_request over the
# komira_http_core Connector it is given.
#
# The v2 API is served and signed under the v1 names: the host is
# `apigateway.<region>` and the signing name `apigateway`, both from the
# ruleset and the model; only botocore's directory is `apigatewayv2`. Every
# member travels under its lowerCamel wire name (`protocolType`), which the
# generated shapes take from the model's `locationName`.
#
# `operations` is an HTTP API front door's lifecycle: the API created,
# found by listing, read, updated and deleted; its stage, its integration
# with a Lambda function, its routes and its custom REQUEST authorizer
# created and listed, and the authorizer updated. An operation joins the
# list with its own rows in the tests below.
#
# The library is gated by its layout probe and these tests, hand-written
# against the API Gateway v2 API reference (no upstream test body is
# copied): test_apigatewayv2_requests (each operation's method, path, query
# and body, exactly, and the model's bounds refused before the wire),
# test_apigatewayv2_responses (each result decoded, and the restJson1 error
# forms), test_apigatewayv2_endpoints (botocore's endpoint cases for
# apigatewayv2 through every operation's resolver, the regional, FIPS,
# dual-stack and LocalStack endpoints, and two requests signed end to end
# against independently computed signatures), test_apigatewayv2_client (the
# generated client over a scripted connector: two calls answered, one error
# per verb raised under its code, and each verb's request as it reached the
# wire, through komira_aws_core's AwsEchoConnector) and _no_env_reads
# (written by mojo_aws_client: the package reads no environment).
#
# No test here talks to the service.

_M = botocore_model("apigatewayv2")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("apigatewayv2")

mojo_aws_client(
    name = "komira_aws_apigatewayv2",
    endpoint_rules = _M.endpoint_rules,
    mode = "client",
    model = _M.model,
    model_sha256 = _M.sha256,
    operations = [
        "CreateApi",
        "CreateAuthorizer",
        "CreateIntegration",
        "CreateRoute",
        "CreateStage",
        "DeleteApi",
        "GetApi",
        "GetApis",
        "GetAuthorizers",
        "GetIntegrations",
        "GetRoutes",
        "GetStages",
        "UpdateApi",
        "UpdateAuthorizer",
    ],
    partitions = _M.partitions,
    test_data = {
        "tests/test_apigatewayv2_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_apigatewayv2_client.mojo",
        "tests/test_apigatewayv2_endpoints.mojo",
        "tests/test_apigatewayv2_requests.mojo",
        "tests/test_apigatewayv2_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` and `<op>_with` take a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
