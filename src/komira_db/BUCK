load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Backend-generic, schema-driven database abstraction: the `Database` /
# `SqlDatabase` traits that generated DbStorable code compiles against, the
# backend-neutral structured ops and their shared SQL rendering, the migration
# runner, and a generic connection pool. The drivers live in
# komira_db_postgres and komira_db_sqlite.
#
# The tests need no database server: the pool tests drive a mock resource and
# a scripted HTTP/1.1 keep-alive transport through the generic `Pool[T]`, and
# the SQL tests drive the shared neutral-op SQL and the migration runner
# through a recording `SqlDatabase`.

mojo_library(
    name = "komira_db",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        # Imported only by tests/test_h1_keepalive_pooled_conn.mojo. mojo_library
        # has no test-only dependency attribute, so these stay in `deps` for now.
        "//src/komira_collections:komira_collections",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        "//src/komira_uuid:komira_uuid",
    ],
    test_srcs = [
        "tests/test_generic_pool_non_pg.mojo",
        "tests/test_h1_keepalive_pooled_conn.mojo",
        "tests/test_migration.mojo",
        "tests/test_sql_ops.mojo",
        "tests/test_sql_ops_split.mojo",
        "tests/test_sql_render.mojo",
        # the SQL renderer's refusals and edge shapes: an OR filter over
        # query_rows' client-side split, a SET term of an unknown kind, an
        # empty IN list, a JSON-key predicate outside query_rows on pgstore
        "tests/test_sql_split_and_binds.mojo",
        # the single-shot blocking helpers and the typed Store surface over a
        # recording SqlDatabase and a hand-written DbStorable
        "tests/test_store_blocking.mojo",
        # the value carriers' edges: logical-type names, DbRow / DbRows bounds
        # and NULL refusals, integer-text refusals, INT4 and BYTES reads, the
        # RAW_EXPR literal shapes
        "tests/test_db_row_value.mojo",
        # the generic Pool[T]'s refusals (every lease method at -1 and size,
        # exhaustion, double return / take / vacate, size <= 0) and close()
        "tests/test_pool_refusals.mojo",
    ],
    visibility = ["PUBLIC"],
)
