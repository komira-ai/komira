load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The resources of a simple CRM's JSON API (`komira/crm/v1/crm.proto`,
# package `komira.crm.v1`): Account, AccountContact, Pipeline and Stage,
# Deal, Activity, CustomFieldDef, the change feed, the erasure summary and
# the error envelope. Generated into the Mojo package `komira_crm_proto`:
#
#   from komira_crm_proto.crm import Deal
#
# The `.proto` sits at its import path so the path matches the proto package.
# It imports `google/protobuf/timestamp.proto`, whose Mojo type comes from
# `komira_wkt`. The generated message structs conform to the
# `komira_proto_codec` codec runtime. `test_srcs` welds the package to its
# field-number census, and README.md's examples run as one more welded test.
# `komira_crm` stores these messages.
mojo_proto_library(
    name = "komira_crm_proto",
    srcs = ["komira/crm/v1/crm.proto"],
    deps = [
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_wkt:komira_wkt",
    ],
    test_srcs = ["tests/test_crm_field_numbers.mojo"],
    visibility = ["PUBLIC"],
)
