load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The `Serializable` / `WireFormat` codec runtime every generated protobuf
# message conforms to: one message description, serialized as protobuf-binary
# or proto3-canonical-JSON with the format chosen at compile time. Its only
# first-party dependency is `komira_protobuf`, so every generated client can
# import it cheaply.
mojo_library(
    name = "komira_serde",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = ["//src/komira_protobuf:komira_protobuf"],
    test_srcs = [
        "tests/test_serde_json_nonascii_roundtrip.mojo",
        "tests/test_serde_proto3_json_conformance.mojo",
        "tests/test_serde_proto3_json_strictness.mojo",
        "tests/test_serde_roundtrip.mojo",
    ],
    visibility = ["PUBLIC"],
)
