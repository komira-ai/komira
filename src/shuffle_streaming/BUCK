load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The object-store shuffle as a streaming segment cut: `ShuffleWriteSink` (a
# `morsel` StreamingMorselSink that writes and seals one epoch per step
# through `shuffle`) and `ShuffleReadSource` (a StreamingMorselSource
# that polls a reducer's partition of each sealed epoch, Idle while unsealed),
# with the Int64 key/value codec both sides share. runtime_paths is
# declared because the tests take their scratch directory from `test_tmpdir()`.

mojo_library(
    name = "shuffle_streaming",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/byte_buffer:byte_buffer",
        "//src/morsel:morsel",
        "//src/objectstore:objectstore",
        "//src/shuffle:shuffle",
        "//tools/build/mojo/runtime_paths:runtime_paths",
    ],
    test_srcs = [
        "tests/test_shuffle_streaming_conformers.mojo",
        "tests/test_shuffle_streaming_direct.mojo",
    ],
    visibility = ["PUBLIC"],
)
