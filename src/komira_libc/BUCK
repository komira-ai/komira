load("@buildrules//rules/mojo:pack.bzl", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/native:shared.bzl", "native_shared_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The libc and POSIX layer every package shares: one getenv, the access probes and pthread_self, file and
# memory-map syscall wrappers with the C shim symbols they call, chunked large writes, RAII file descriptor.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"). `:lib` is the library
# file and exists only once every test of tests/ has passed. The C it owns, native/komira_libc_posix.c
# (fixed-arity wrappers over the POSIX file and memory-map calls: 19 symbols, the only definition of each, and
# the two memory-map counters), is `[native.komira_libc_posix]` of mopm.toml: `mojo_package` compiles it
# into `:native_komira_libc_posix` (`libkomira_libc_posix.a`), links it into every test of the package and
# of the packages that depend on it, and packs it into `:conda` (`lib/libkomira_libc_posix.a`).
mojo_package(path = ".")

# `:komira_libc`, the target the packages that depend on this library name, is `:lib` as komira's Mojo
# rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the tests have
# passed. It also hands the native archive of `:lib` to a dependent's link (`MojoInfo.c_link`), so a
# test or binary built with komira's rules links `libkomira_libc_posix.a` with no line of its own.
# `c_deps` and `native` carry the older packaging below as the facts `mojo_library` gave it.
mojo_adopted_library(
    name = "komira_libc",
    c_deps = [":komira_libc_posix"],
    lib = ":lib",
    native = ":komira_libc_native",
    readme = "README.md",
    srcs = glob(["src/komira_libc/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# `:conda`, the mopm package, holds the archive that was built and tested: unpacked,
# `lib/libkomira_libc_posix.a` is exactly the bytes of `:native_komira_libc_posix` (a `.conda` that lost
# the archive, or held another, is red).
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    natives = {"libkomira_libc_posix.a": ":native_komira_libc_posix"},
    package = "komira_libc",
    visibility = ["PUBLIC"],
)

# The release machine builds `komira_libc_conda` (release/artifacts.textproto): komira's conda packer over
# `:komira_libc`, with the library's own shared library below. It goes when the release machine takes
# `:conda`, which is this library's mopm package.
conda_package(
    name = "komira_libc_conda",
    lib = ":komira_libc",
    native = ":komira_libc_native",
    summary = "The `komira_libc` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

# The older packaging of the same C, kept while the release set ships it
# (tools/build/package/BUCK, `native`) and the one-definition gate links it
# (tools/build/one_definition/libraries.bzl): the C file as a `cxx_library`, and
# `komira_libc_native` below, its shared library. No test or program links this
# archive: the Mojo side links `:native_komira_libc_posix`, built from the same file.
staged_files(
    name = "posix_files",
    srcs = ["native/komira_libc_posix.c"],
)

cxx_library(
    name = "komira_libc_posix",
    srcs = [":posix_files[native/komira_libc_posix.c]"],
    visibility = ["PUBLIC"],
)

# libkomira_libc_native.so.1: the C this library owns, as its own
# shared library exporting the names its callers call
# (tools/build/native/README.md, "Each library's shared library"). Built and
# checked here, and packed into the library's conda package (`native`).
native_shared_library(
    name = "komira_libc_native",
    archives = [
        ":komira_libc_posix",
    ],
    callers = [
        ":komira_libc",
        "//src/komira_async:komira_async",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_http_server:komira_http_server",
        "//src/komira_log:komira_log",
    ],
    library = "komira_libc",
    # Every weak undefined symbol of the library, recorded from its first
    # green link (checks 3 and 7 hold it to exactly this list):
    weak_undefined = [
        # zig's C runtime (crti.o): the profiling hook, absent unless -pg.
        "__gmon_start__",
    ],
    visibility = ["PUBLIC"],
)
