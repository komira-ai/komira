load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The validation-run correlator's tag key and retention mark. It has no deps,
# and that is load-bearing: kci_cloud's label rule and the test-resource
# packages import it, so anything named here is placed upstream of all of
# them. Do not add deps.
#
# Why one key serves both clouds, and why it is spelled the way it is, is in
# `validation_run_tag.mojo`'s header.
mojo_library(
    name = "komira_validation_run",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = ["tests/test_validation_run_tag.mojo"],
    visibility = ["PUBLIC"],
)
