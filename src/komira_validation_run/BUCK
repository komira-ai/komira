load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The validation-run correlator's tag key and retention mark. It has no deps,
# and that is load-bearing: kci_cloud's label rule and the test-resource
# packages import it, so anything named here is placed upstream of all of
# them. Do not add deps (mopm.toml has no [dependencies] table).
#
# Why one key serves both clouds, and why it is spelled the way it is, is in
# `validation_run_tag.mojo`'s header.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_validation_run`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only
# once the tests have passed. It carries the README gate too (`[tests][readme]`): the examples run
# against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_validation_run",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_validation_run/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_validation_run-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so
# this file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is
# a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_42",
    package = "komira_validation_run",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_validation_run`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_validation_run_conda",
    lib = ":komira_validation_run",
    summary = "The `komira_validation_run` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
