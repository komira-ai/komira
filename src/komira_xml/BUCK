load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A general XML codec: escaping, a forward-only pull parser, a streaming
# writer, and an owned tree with a namespace-aware canonical form. It has no
# deps. A rest-xml binding (flattened lists, xmlAttribute, xmlNamespace) is
# not part of this package; it lives in its consumers, which depend on this
# package, never the other way round. test_xml_strict checks well-formedness,
# namespaces and the DTD refusal row by row against XML 1.0 and Namespaces in
# XML 1.0; test_xml_accessors the position-based child lookup (`child_index`,
# `children_named`) and the text accessors; test_xml_copy checks that a node
# copied as a list element, or with its children, shares no buffer with the
# original; test_xml_edges the edges the others leave unexercised (lenient
# unescape bounds, declaration and tag shapes cut short, the reserved
# namespace names, canonical_node, the writer's small accessors).
mojo_library(
    name = "komira_xml",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_xml_accessors.mojo",
        "tests/test_xml_codec.mojo",
        "tests/test_xml_copy.mojo",
        "tests/test_xml_edges.mojo",
        "tests/test_xml_strict.mojo",
    ],
    visibility = ["PUBLIC"],
)
