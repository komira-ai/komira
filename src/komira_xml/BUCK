load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A general XML codec: escaping, a forward-only pull parser, a streaming
# writer, and an owned tree with a namespace-aware canonical form. It has no
# deps. The rest-xml binding (flattened lists, xmlAttribute, xmlNamespace)
# belongs to `komira_aws_core`, which depends on this package, never the
# other way round. test_xml_strict checks well-formedness, namespaces and the
# DTD refusal row by row against XML 1.0 and Namespaces in XML 1.0;
# test_xml_accessors the borrowed child lookup and the text accessors.
mojo_library(
    name = "komira_xml",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_xml_accessors.mojo",
        "tests/test_xml_codec.mojo",
        "tests/test_xml_strict.mojo",
    ],
    visibility = ["PUBLIC"],
)
