load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# A general XML codec: escaping, a forward-only pull parser, a streaming
# writer, and an owned tree with a namespace-aware canonical form. It has no
# deps. A rest-xml binding (flattened lists, xmlAttribute, xmlNamespace) is
# not part of this package; it lives in its consumers, which depend on this
# package, never the other way round. test_xml_strict checks well-formedness,
# namespaces and the DTD refusal row by row against XML 1.0 and Namespaces in
# XML 1.0; test_xml_accessors the position-based child lookup (`child_index`,
# `children_named`) and the text accessors; test_xml_copy checks that a node
# copied as a list element, or with its children, shares no buffer with the
# original; test_xml_edges the edges the others leave unexercised (lenient
# unescape bounds, declaration and tag shapes cut short, the reserved
# namespace names, canonical_node, the writer's small accessors).
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_xml`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`): the examples run against
# `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_xml",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_xml/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_xml-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step
# of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_48",
    package = "komira_xml",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/artifacts.textproto): komira's conda
# packer over `:komira_xml`. It goes when the release machine takes the mopm package. This
# library's mopm package is `:conda` above.
conda_package(
    name = "komira_xml_conda",
    lib = ":komira_xml",
    summary = "The `komira_xml` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
