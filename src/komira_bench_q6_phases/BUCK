load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")
load(":q6_probe.bzl", "q6_phase_probe")

# A profiling probe of TPC-H Q6 on the komira engine: where the time of one
# run goes, per phase, at several thread counts. README.md says what it
# measures, how to run it and how far to trust it.
#
# The probe is a library (`run_probe` and the phase aggregation, the plan
# render, the statistics, the command line) and two programs: the probe
# (`komira_bench_q6_phases_main`) and the staging of TPC-H scale factor 1
# (`komira_bench_q6_stage_main`). `q6_phase_probe` below runs both on the
# build farm. The phase timers it reads (komira_phase_timers) are compiled in
# only by -D KOMIRA_PHASE_TIMERS=1, which the probe program and this
# library's tests are built with; no other target has them.
#
# The welded tests are built with the timers on (each file's header says what
# it proves):
# - test_stats: median and quartiles of a few samples, and when the warm-up's
#   page-fault counts have settled.
# - test_cli: the defaults (five thread counts, both modes), the mode flag, the
#   staged-file path, the expected answer, and every refusal of the command
#   line.
# - test_probe_phases: every stage of a Q6 run is timed on the right threads
#   and the nested phases agree; the JSON is valid and complete; the plan text
#   holds the three plans; a wrong expected answer is reported; the decode-only
#   query decodes without evaluating a predicate; the per-thread usage nests
#   like the phases; each mode can be run alone.
mojo_library(
    name = "komira_bench_q6_phases",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo", "main/**/*.mojo"]),
    deps = [
        "//src/komira_bench_corpus:komira_bench_corpus",
        "//src/komira_engine_runtime:komira_engine_runtime",
        "//src/komira_lowering:komira_lowering",
        "//src/komira_optimizer:komira_optimizer",
        "//src/komira_parquet:komira_parquet",
        "//src/komira_parquet_footers:komira_parquet_footers",
        "//src/komira_phase_timers:komira_phase_timers",
        "//src/komira_plan_ir:komira_plan_ir",
        "//src/komira_scalar_arithmetic:komira_scalar_arithmetic",
        "//src/komira_sdk_exec:komira_sdk_exec",
        "//src/komira_sql:komira_sql",
    ],
    test_deps = [
        "//src/komira_json:komira_json",
        "//src/komira_parquet_writer:komira_parquet_writer",
        "//src/komira_pipeline_exec:komira_pipeline_exec",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_defines = ["KOMIRA_PHASE_TIMERS=1"],
    test_srcs = [
        "tests/test_cli.mojo",
        "tests/test_probe_phases.mojo",
        "tests/test_stats.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The probe program, with the phase timers compiled in.
mojo_binary(
    name = "komira_bench_q6_phases_main",
    srcs = ["main/probe_main.mojo"],
    main = "main/probe_main.mojo",
    deps = [":komira_bench_q6_phases"],
    defines = ["KOMIRA_PHASE_TIMERS=1"],
    visibility = ["PUBLIC"],
)

# Stages TPC-H scale factor 1 through komira_bench_data (the same staging as
# komira-bench-stage), into a directory the build gives it.
mojo_binary(
    name = "komira_bench_q6_stage_main",
    srcs = ["main/stage_main.mojo"],
    main = "main/stage_main.mojo",
    deps = ["//src/komira_bench_data:komira_bench_data"],
    visibility = ["PUBLIC"],
)

# The probe on the build farm: stages TPC-H scale factor 1 (one action, its
# output cached for the next run), then runs the probe program on it (a second
# action). Its output directory holds phases.json and plan.txt:
#
#   ./buck2 build komira//src/komira_bench_q6_phases:q6_phase_probe
#   ./buck2 build komira//src/komira_bench_q6_phases:q6_phase_probe[phases.json] --show-output
q6_phase_probe(
    name = "q6_phase_probe",
    stage = ":komira_bench_q6_stage_main",
    probe = ":komira_bench_q6_phases_main",
    tpch_extension = "//third_party/duckdb:tpch.duckdb_extension.gz",
)
