load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The `komira.search.index` scan kind: a search index read as a relation of
# hit rows. Its binding builder, identity corpus, in-memory catalog and the
# tier-2 resolver an engine executes, plus the split reader and fast-field
# pushdown gate the kind uses. It sits above search and implements the
# scan_resolver contract, so neither the search core nor this package
# depends on an engine.
#
# The welded tests are executor-free: they build splits in memory and drive
# the kind through core's `resolve_for_execution`, its split plan and readers,
# and `drain_scan`; the pushdown-gate and position tests call the gate and the
# position codec directly.
mojo_library(
    name = "search_scan",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/byte_buffer:byte_buffer",
        "//src/plan_expr:plan_expr",
        "//src/plan_ir:plan_ir",
        "//src/scan_resolver:scan_resolver",
        "//src/scan_source:scan_source",
        "//src/search:search",
    ],
    test_srcs = [
        "tests/test_search_scan_catalog.mojo",
        "tests/test_search_scan_field_routing.mojo",
        "tests/test_search_scan_kind.mojo",
        "tests/test_search_scan_positions.mojo",
        "tests/test_search_scan_pushdown_gate.mojo",
        "tests/test_search_scan_resolver_edges.mojo",
        "tests/test_search_source_conformance.mojo",
    ],
    visibility = ["PUBLIC"],
)
