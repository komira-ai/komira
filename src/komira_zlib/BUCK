load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

# The libz FFI shim: one-shot inflate / deflate / deflateBound and a bounded
# stream skipper, over libz loaded at RUNTIME via dlopen (`libz.so.1` /
# `libz.dylib`), so there is no static archive to link and no link deps for
# consumers.
#
# No `deps`, on purpose: this is a foundational FFI leaf. Whatever is added
# here lands in the build closure of every zlib consumer, including ones that
# must not depend on the query engine. It welds no test of its own.
mojo_library(
    name = "komira_zlib",
    srcs = glob(["**/*.mojo"]),
    visibility = ["PUBLIC"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["komira//:docs"],
)
