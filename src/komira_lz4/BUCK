load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

# The shared LZ4 raw-block codec: compress, decompress and the compress bound,
# over liblz4. liblz4 is loaded at run time with dlopen and kept in one
# process-lifetime `_Global` slot, so there is no link dep, and there are no
# first-party deps: the Parquet page codecs and the document store's `_source`
# compression both depend on this leaf and on nothing of each other.
mojo_library(
    name = "komira_lz4",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = ["tests/test_codec.mojo"],
    visibility = ["PUBLIC"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["komira//:docs"],
)
