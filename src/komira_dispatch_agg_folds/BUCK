load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Aggregate folds over resident batches: the grouped and scalar COUNT(DISTINCT) folds, the grouped string MIN/MAX fold, the mixed fold that serves COUNT(DISTINCT) or a string MIN/MAX beside fixed-cell aggregates, the ordered MIN/MAX reader and emitter of the scalar fold, the resolution of an aggregate's parquet leaf, and the process-global witnesses of which aggregate driver ran.
mojo_library(
    name = "komira_dispatch_agg_folds",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_agg_api:komira_agg_api",
        "//src/komira_arrow:komira_arrow",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_column_kernels:komira_column_kernels",
        "//src/komira_physical_plan:komira_physical_plan",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_ir:komira_plan_ir",
        "//src/komira_udf:komira_udf",
    ],
    test_srcs = [
        # a grouped string MIN/MAX beside COUNT(*) and COUNT(DISTINCT), the
        # empty string as a value, and the split gate
        "tests/test_grouped_string_min_beside_another_agg.mojo",
        # the mixed fold's row ceiling is one derived number, over enough
        # groups to rehash the group table
        "tests/test_mixed_cd_fold_row_ceiling_is_derived.mojo",
        # a string MIN/MAX costs nothing per row (peak RSS), and the byte
        # order of the in-place compare
        "tests/test_mixed_fold_string_minmax_is_flat_in_rows.mojo",
        # the spill-envelope verdict vocabulary, the driver and route
        # witness slots, the string MIN/MAX arming slots and the 0-key stream
        # pass counter: every name, every slot, every reset
        "tests/test_agg_witness_counters.mojo",
        # the ordered 0-key MIN/MAX: which reader each type gets, both int
        # widths and both string widths folded, and the one emitter
        "tests/test_agg_minmax_ordered.mojo",
        # the aggregate leaf binding, the file-derived scan projection and
        # both agreement checks, each refusal and each admit
        "tests/test_agg_leaf_resolution.mojo",
        # the grouped COUNT(DISTINCT) folds: the native-hash fold against the
        # string-key oracle, a forced hash collision, two rehashes, every
        # decline of the grouped and 0-key folds, and the key extractors
        "tests/test_cd_grouped_fold.mojo",
        # the grouped string MIN/MAX fold: values over STRING and
        # LARGE_STRING, NULL keys in three key types, both witnesses, and
        # every decline
        "tests/test_cd_grouped_string_minmax.mojo",
        # the mixed fold's gates, its ceiling and lowering, its helpers,
        # and every decline of the per-batch extraction
        "tests/test_mixed_fold_gates.mojo",
        # the mixed fold's values: every accumulator kind against a hand
        # oracle, key types, the 0-key identity row, the batch list, two
        # rehashes, a forced composite-hash collision and the null-key guard
        "tests/test_mixed_fold_values.mojo",
    ],
    visibility = ["PUBLIC"],
)
