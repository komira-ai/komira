load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# SpinMutex, a mutual-exclusion lock for plain code, over one atomic word. Its
# test forks real threads (komira_fork_join) and checks that no two are inside
# the critical section at once, that a held lock is not taken, and that
# `unlock` lets a waiter in. The package's one dependency is
# komira_atomic_alias, the one place `Atomic` is spelled; komira_fork_join is
# a dev-dependency, for that test only.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the test of tests/ has passed. komira_fork_join, a sibling
# package named under `[dev-dependencies]` of mopm.toml, reaches the test only, never `:lib` or a
# consumer of the lock.
mojo_package(path = ".")

# `:komira_sync`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once
# the test has passed. Its `deps` are what `:lib` is built from: komira_atomic_alias. The
# dev-dependency is not part of it. It carries the README gate too (`[tests][readme]`): the
# examples run against `:lib`; the test is not run again.
mojo_adopted_library(
    name = "komira_sync",
    deps = ["//src/komira_atomic_alias:komira_atomic_alias"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_sync/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_sync-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the test passed, so this
# file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is
# a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_sync",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../komira_atomic_alias": "//src/komira_atomic_alias:mopm.toml"},
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_73",
    package = "komira_sync",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/`, and one dependency beyond the compiler,
# komira_atomic_alias. komira_fork_join is a dev-dependency, which `mopm pack` leaves out.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_atomic_alias >=0.1,<0.2"],
    package = "komira_sync",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_sync`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_sync_conda",
    lib = ":komira_sync",
    summary = "The `komira_sync` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
