load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The PhysicalPlan IR (segment descriptors: a source, a chain of morsel operators and a sink, as inert data), its IR version door, and the purity gate that refuses a physical plan still holding a LogicalPlan. A package of its own so that a package outside the closure of this target (komira_optimizer) cannot import it: the import does not resolve.
mojo_library(
    name = "komira_physical_plan",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_libc:komira_libc",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_ir:komira_plan_ir",
        "//src/komira_plan_stats:komira_plan_stats",
        "//src/komira_scan_source:komira_scan_source",
    ],
    test_srcs = [
        "tests/test_physical_plan_ir_version_door.mojo",
        "tests/test_physical_plan_purity_gate.mojo",
    ],
    visibility = ["PUBLIC"],
)
