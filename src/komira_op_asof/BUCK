load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The ASOF join: the two-cursor merge walker over sorted sides, its search
# kernels and equi-key comparison, the AsofJoinSink over two materialised
# sides, and the stage pipelines' ASOF build table with its ASOF_JOIN_BUILD
# and ASOF_JOIN breaker states. NULL keys and NULL ASOF values match nothing;
# float keys compare in the sort's DuckDB order (NaN above +inf).
mojo_library(
    name = "komira_op_asof",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
