load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The ASOF join: the two-cursor merge walker over sorted sides with its search
# kernels and equi-key comparison. NULL keys and NULL ASOF values match
# nothing; float keys compare in the sort's DuckDB order (NaN above +inf).
