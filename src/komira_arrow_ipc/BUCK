# Writes of more than 2 GiB through the chunked and per-call-clamped write
# paths. Built with the library but not one of its gated tests: it needs
# several GiB of free disk and minutes of I/O. Run it on demand with
# `buck2 run //src/komira_arrow_ipc:large_writes_check`.
mojo_binary(
    name = "large_writes_check",
    srcs = ["tests/test_large_writes.mojo"],
    deps = [
        ":komira_arrow_ipc",
        "//src/komira_libc:komira_libc",
    ],
)

# The Arrow C Stream Interface across a real dynamic-library boundary. The
# library exports a stream of six column types (int64, float64, nullable utf8,
# large utf8, dictionary, decimal128) and imports a caller's stream; its gate,
# tests/c_abi/arrow_c_abi_driver.mojo, has no dependency and shares no type
# with this package: it dlopens the library, reads the exported chunks after
# releasing their stream, checks every buffer against values written out by
# hand, and counts the release calls on a stream it produces itself. A second
# gate, tests/c_abi/arrow_c_abi_error_driver.mojo, drives the error paths:
# get_schema/get_next failing in each direction, with the error text read
# through get_last_error.
mojo_shared_lib(
    name = "arrow_c_abi_probe",
    srcs = ["tests/c_abi/arrow_c_abi_probe.mojo"],
    exports = [
        "probe_export_failing_stream",
        "probe_export_stream",
        "probe_import_stream",
    ],
    exports_exact = True,
    gate_srcs = [
        "tests/c_abi/arrow_c_abi_driver.mojo",
        "tests/c_abi/arrow_c_abi_error_driver.mojo",
    ],
    deps = [
        ":komira_arrow_ipc",
        "//src/komira_arrow:komira_arrow",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_compression:komira_compression",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_counters:komira_counters",
        "//src/komira_libc:komira_libc",
    ],
)
