# Writes of more than 2 GiB through the chunked and per-call-clamped write
# paths. Built with the library but not one of its gated tests: it needs
# several GiB of free disk and minutes of I/O. Run it on demand with
# `buck2 run //src/komira_arrow_ipc:large_writes_check`.
mojo_binary(
    name = "large_writes_check",
    srcs = ["tests/test_large_writes.mojo"],
    deps = [
        ":komira_arrow_ipc",
        "//src/komira_libc:komira_libc",
    ],
)
