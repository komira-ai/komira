load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The native process supervisor: spawn a child with two capture pipes,
# drain its output byte-for-byte, observe its exit through the reactor
# (kqueue EVFILT_PROC on macOS, pidfd + epoll on Linux) and stop it with
# SIGTERM -> grace -> SIGKILL. It depends on komira_async for the reactor's
# kqueue / epoll subsystems.

# The C side: posix_spawnp with two pipes (optionally a new process group and
# default signal dispositions), the environment reader, the waitpid decode,
# the non-reaping waitid child probe, the process-group signal, the
# SIGTERM/SIGINT stop latch, orphan adoption and reaping, and the
# per-platform exit-wait primitives.
staged_files(
    name = "proc_shim_files",
    srcs = ["_proc_shim.c"],
)

cxx_library(
    name = "komira_supervisor_proc",
    srcs = [":proc_shim_files[_proc_shim.c]"],
    compiler_flags = ["-O2", "-Wall", "-Werror"],
    visibility = ["PUBLIC"],
)

mojo_library(
    name = "komira_supervisor",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        ":komira_supervisor_proc",
        "//src/komira_async:komira_async",
    ],
    test_srcs = [
        "tests/test_child_probe.mojo",
        "tests/test_process_group.mojo",
        "tests/test_supervisor_scenarios.mojo",
    ],
    visibility = ["PUBLIC"],
)
