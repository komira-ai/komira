load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")
load("@komira//tools/build/toolchains:mojo_versions.bzl", "mojo_version")

# vCard (RFC 6350): raw cards from a .vcf stream (4.0, 3.0 and 2.1, with
# quoted-printable values and input, line and card-count limits), the RFC
# 9555-guided contact subset with unknown properties kept, and a vCard 4.0
# writer. The content-line layer is content_line.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# content_line, a sibling package (`[dependencies]` of mopm.toml): its `:lib` is built from
# that package's `:lib`.
mojo_package(path = ".")

# `:vcard`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once
# the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages: the rule refuses a list that is not the closure `:lib` was built from. It carries the
# README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "vcard",
    deps = ["//src/content_line:content_line"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/vcard/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira-ai.vcard-0.1.0-mojo1.1.0_0.conda`), which records content_line as a dependency
# (`mojo-komira-ai.content_line >=0.1,<0.2`) and holds that package's files nowhere. `members` is the
# manifests of the path dependencies, staged at their repository paths, because `mopm pack` reads
# the manifest of each beside the one it is given. `:lib` exists only once the tests passed, so this
# file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is
# a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/vcard",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../content_line": "//src/content_line:mopm.toml"},
    mojo = mojo_version(),
    mopm = "toolchains//:mopm_0_0_138",
    package = "komira-ai/vcard",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/` (content_line is not in it), and exactly
# one dependency, `mojo-komira-ai.content_line >=0.1,<0.2`, which is what installing the package pulls
# in. Red when the manifest drops the dependency, names another range, or the file carries the sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira-ai.content_line >=0.1,<0.2"],
    package = "vcard",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:vcard`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "vcard_conda",
    lib = ":vcard",
    summary = "The `vcard` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
