load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The row-mode expression executor over komira_core: the expression executor,
# its typed conformers to the komira_expr traits, the adaptive filter state and
# the sum-of-expression aggregand. Everything else the old evaluation layer held
# lives in komira_row_format, komira_kernels, komira_udf, komira_expr and
# komira_agg, which this package builds on.
mojo_library(
    name = "komira_eval",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        # Imported only by tests/test_adaptive_filter_convergence.mojo;
        # mojo_library has no test-only dep attribute, so it is listed here.
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_agg:komira_agg",
        "//src/komira_core:komira_core",
        "//src/komira_expr:komira_expr",
        "//src/komira_kernels:komira_kernels",
        "//src/komira_row_format:komira_row_format",
        "//src/komira_udf:komira_udf",
    ],
    test_srcs = [
        "tests/test_adaptive_filter.mojo",
        "tests/test_adaptive_filter_convergence.mojo",
        "tests/test_cell_source_row_walker.mojo",
        "tests/test_div_f64_single_row_tail.mojo",
        "tests/test_eval_scalar_arithmetic_at_scale.mojo",
        "tests/test_expr_leaf_bind.mojo",
        "tests/test_expr_sqrt_f64.mojo",
        "tests/test_expression_executor_adaptive.mojo",
        "tests/test_expression_executor_from_view.mojo",
        "tests/test_expression_executor_skeleton.mojo",
        "tests/test_expression_executor_walker.mojo",
        "tests/test_exprx_operator_overloads.mojo",
        "tests/test_exprx_to_expr.mojo",
        "tests/test_like_underscore_is_one_character.mojo",
        "tests/test_q6_untyped_mvp.mojo",
        "tests/test_row_date_trunc_kerneldirect.mojo",
        "tests/test_row_decimal_filter_kerneldirect.mojo",
        "tests/test_row_decimal_mixedscale_filter_kerneldirect.mojo",
        "tests/test_row_filter_nullable_3vl_skip.mojo",
        "tests/test_row_filter_regexp_kerneldirect.mojo",
