load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The per-execution secret registry: a `node_id -> secret_ref` side table that
# owns a `SecretStore` by value, and the `CredentialConsumer` seam a connector
# receives the revealed bytes through. Its closure is the store trait and the
# value type (`secret_store`) plus `Slab` and the plan's flat bindings
# table (the core packages); nothing from the engine or the file formats.
#
# The gate test runs over the in-memory `StaticSecretStore`: no sockets, no
# files, no cloud.
mojo_library(
    name = "secret_registry",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/containers:containers",
        "//src/crypto:crypto",
        "//src/secret_store:secret_store",
    ],
    test_srcs = ["tests/test_secret_registry.mojo"],
    visibility = ["PUBLIC"],
)
