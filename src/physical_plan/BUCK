load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The PhysicalPlan IR (segment descriptors: a source, a chain of morsel operators and a sink, as inert data), its IR version door, and the purity gate that refuses a physical plan still holding a LogicalPlan. A package of its own so that a package outside the closure of this target (optimizer) cannot import it: the import does not resolve.
mojo_library(
    name = "physical_plan",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/byte_buffer:byte_buffer",
        "//src/containers:containers",
        "//src/libc:libc",
        "//src/plan_expr:plan_expr",
        "//src/plan_ir:plan_ir",
        "//src/plan_stats:plan_stats",
        "//src/scan_source:scan_source",
    ],
    test_srcs = [
        "tests/test_physical_plan_avro_spec.mojo",
        "tests/test_physical_plan_ir_version_door.mojo",
        "tests/test_physical_plan_jsonl_spec.mojo",
        "tests/test_physical_plan_purity_gate.mojo",
        "tests/test_source_spec_csv.mojo",
        "tests/test_source_spec_iceberg.mojo",
        "tests/test_source_spec_parquet_files.mojo",
        "tests/test_source_spec_parquet_fs.mojo",
        "tests/test_udf_call_spec.mojo",
    ],
    visibility = ["PUBLIC"],
)
