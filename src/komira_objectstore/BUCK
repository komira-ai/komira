load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The vendor-neutral object-storage layer: the Path / URI types, the
# ObjectStore trait family (metadata, conditional writes, ranged and parkable
# CAS verbs), the CAS-manifest substrate shared by the broker and the search
# engine, the in-memory / local-filesystem conformers, the coalescing and
# compaction windows, the sub-lineage shard kernel and the presigned-URL
# signing seam. (The distributed shuffle lives in `komira_shuffle`, which depends
# on this package.) It depends on komira_core, komira_async
# (the reactor and its C shim, which also carries the CAS-manifest gate lock),
# komira_atomic_alias and komira_metrics (the escalation metrics sink).
# komira_runtime_paths is declared because several tests take their scratch
# directory from `test_tmpdir()`.

mojo_library(
    name = "komira_objectstore",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_fs:komira_fs_posix",
        "//src/komira_libc:komira_libc",
        "//src/komira_metrics:komira_metrics",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_cas_manifest_absence_is_anchored.mojo",
        "tests/test_cas_manifest_concurrent_offline.mojo",
        "tests/test_cas_manifest_property.mojo",
        "tests/test_cas_recovery_log_start_aware_offline.mojo",
        "tests/test_cas_stale_head_forward_progress_offline.mojo",
        "tests/test_coalesce.mojo",
        "tests/test_coalescing_window.mojo",
        "tests/test_compact_window.mojo",
        "tests/test_delimiter_listing_byte_faithful.mojo",
        "tests/test_local_fs_conditional_store.mojo",
        "tests/test_local_fs_store_list_bytes_non_ascii.mojo",
        "tests/test_objectstore_bytes_non_ascii.mojo",
        "tests/test_path_uri.mojo",
        "tests/test_sharded_lineage_kernel.mojo",
        "tests/test_slow_cas_store_start_412_abi.mojo",
        "tests/test_sublineage_base_fold.mojo",
    ],
    visibility = ["PUBLIC"],
)
