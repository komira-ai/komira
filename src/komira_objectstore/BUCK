load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The vendor-neutral object-storage layer: the Path / URI types, the
# ObjectStore trait family (metadata, conditional writes, ranged and parkable
# CAS verbs), the CAS-manifest substrate shared by the broker and the search
# engine, the in-memory / local-filesystem conformers, the coalescing and
# compaction windows, the sub-lineage shard kernel and the presigned-URL
# signing seam. (The distributed shuffle lives in `komira_shuffle`, which depends
# on this package.) It depends on the core packages, komira_async
# (the reactor and its C shim, which also carries the CAS-manifest gate lock),
# komira_atomic_alias, komira_metrics (the escalation metrics sink) and
# komira_counters (cas_backoff_probe: the CAS append's backoff draws, counted
# so a contention test can check them).
# komira_runtime_paths is declared because several tests take their scratch
# directory from `test_tmpdir()`.

# The errno-surfacing file primitives behind LocalFsConditionalStore's reads
# (`local_fs_file_read.mojo`), delete and create-if-absent (temp write +
# link(2)): errno is read in C right after the failing call, and the errno
# constants and names stay out of Mojo.
staged_files(
    name = "objectstore_shim_files",
    srcs = ["_objectstore_shim.c"],
)

cxx_library(
    name = "komira_objectstore_posix",
    srcs = [":objectstore_shim_files[_objectstore_shim.c]"],
    compiler_flags = ["-O2", "-Wall", "-Werror"],
    visibility = ["PUBLIC"],
)

mojo_library(
    name = "komira_objectstore",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        ":komira_objectstore_posix",
