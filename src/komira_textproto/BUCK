load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# A small text-format protobuf (textproto) lexer: structural `{` `}` `:`
# tokens, quoted strings with escapes, numbers, barewords, and `#` comments.
# Every token carries its kind and line, so a reader can tell a quoted "{"
# from a brace and name the line it refuses. Zero deps by design: any reader
# of a textproto file can share it without pulling a schema along.
#
# The welded tests cover each token kind, every supported escape, comments,
# line tracking, the cursor helpers, and each refusal by its message; the
# describe test pins how refusals name every token kind and an empty input.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_textproto`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`): the examples run against
# `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_textproto",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_textproto/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_textproto-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step
# of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_48",
    package = "komira_textproto",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/artifacts.textproto): komira's conda
# packer over `:komira_textproto`. It goes when the release machine takes the mopm package. This
# library's mopm package is `:conda` above.
conda_package(
    name = "komira_textproto_conda",
    lib = ":komira_textproto",
    summary = "The `komira_textproto` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
