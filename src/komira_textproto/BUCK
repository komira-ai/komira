load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A small text-format protobuf (textproto) lexer: structural `{` `}` `:`
# tokens, quoted strings with escapes, numbers, barewords, and `#` comments.
# Every token carries its kind and line, so a reader can tell a quoted "{"
# from a brace and name the line it refuses. Zero deps by design: any reader
# of a textproto file can share it without pulling a schema along.
#
# The welded tests cover each token kind, every supported escape, comments,
# line tracking, the cursor helpers, and each refusal by its message; the
# describe test pins how refusals name every token kind and an empty input.
mojo_library(
    name = "komira_textproto",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_textproto_describe.mojo",
        "tests/test_textproto_lexer.mojo",
    ],
    visibility = ["PUBLIC"],
)
