    var params = config.endpoint_params()
    var outcome = rules.resolve(params)
    if outcome.is_error:
        raise Error(
            String("komira_aws_secretsmanager: the endpoint ruleset chose no endpoint for PutSecretValue: ") + outcome.error
        )
    return outcome.endpoint.copy()
