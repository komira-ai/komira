        "//src/komira_telemetry_store:komira_telemetry_store",
        "//src/komira_zlib:komira_zlib",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_telemetry_log_search.mojo",
        "tests/test_telemetry_read_keys.mojo",
        "tests/test_telemetry_scan_backends.mojo",
        "tests/test_telemetry_scan_plan.mojo",
        "tests/test_telemetry_scan_replay.mojo",
        "tests/test_telemetry_segment_read.mojo",
    ],
    visibility = ["PUBLIC"],
)
