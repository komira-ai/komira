load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The direct query path over the at-rest telemetry format of
# komira_telemetry_store: a time range in, object keys out. The scan planner
# computes the UTC day partitions, enumerates writer shards with the one LIST
# per day, replays each shard's manifest by exact GETs (a forward probe past a
# lagging `_HEAD`, tombstones stepped over, reaped gaps walked over) and prunes
# on the catalog entries alone. The segment reader GETs exactly the planned keys
# and prunes row groups on the Parquet footer. `TelemetryLogSearch` answers the
# komira_log_query search seam from that path. Keys and the catalog entry come
# from komira_telemetry_store; there is no second copy here. The store is a trait
# parameter; the tests run on the in-memory, local-filesystem and
# delimiter-faithful conditional-write stores.
#
# The welded tests (each file's header says which defect it catches):
# - test_telemetry_read_keys: the writer-side derivations the planner relies on:
#   the day partitions a range touches (leap day, pre-epoch floor, closed
#   bounds, refused inverted and over-wide ranges), the catalog entry's
#   round-trip and refusals, and the sidecar key derived from the data key.
# - test_telemetry_scan_plan: the prune itself (day partition and entry-level
#   time prune), LISTs measured as O(partitions), the merge-input skip, the
#   series filter and its inert default, and the object-key tie-break.
# - test_telemetry_scan_replay: a lagging durable `_HEAD` does not hide the
#   newest segments, a tombstone above the head and a reaped gap below it are
#   walked over, and a denied error on a key containing 404 is not "absent".
# - test_telemetry_scan_backends: the same plan on a local-filesystem store
#   (no `common_prefixes`) and a delimiter-faithful one (rollups).
# - test_telemetry_segment_read: real Parquet written by the store's log
#   writer, read back by exact key with row-group pruning measured, an
#   inclusive time predicate, corrupt objects refused, an empty plan fetching
#   nothing.
# - test_telemetry_log_search: newest-first hits, the row-level window check,
#   substring term matching with a true total, global ordering across objects
#   and days, a stable sort, and a schema mismatch refused.
#
# komira_runtime_paths is declared because the local-filesystem backend test
# takes its scratch directory from the build's private test temp directory.
mojo_library(
    name = "komira_telemetry_read",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    # The full transitive closure of the Mojo libraries this package builds on.
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_column_kernels:komira_column_kernels",
        "//src/komira_compression:komira_compression",
        "//src/komira_counters:komira_counters",
        "//src/komira_dynamic_filter:komira_dynamic_filter",
        "//src/komira_fs:komira_fs",
        "//src/komira_host:komira_host",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_libc:komira_libc",
        "//src/komira_log_query:komira_log_query",
        "//src/komira_metrics:komira_metrics",
        "//src/komira_objectstore:komira_objectstore",
        "//src/komira_objectstore:komira_objectstore_posix",
        "//src/komira_parquet:komira_parquet",
        "//src/komira_parquet_api:komira_parquet_api",
