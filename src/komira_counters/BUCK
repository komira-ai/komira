load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Process-global census and falsifier counters plus the build-gated runtime introspection probe.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the tests of tests/ have passed. The package depends on
# komira_atomic_alias (`[dependencies]`); its tests also use komira_runtime_paths
# (`[dev-dependencies]`: test_runtime_introspection reads the private test directory), which
# reaches the tests only.
#
# The tests are compiled with every runtime_introspection hook ON, so test_runtime_introspection
# checks the lines they emit. No other test reads these defines.
mojo_package(
    path = ".",
    test_defines = {
        "KOMIRA_TRACE_ARC": True,
        "KOMIRA_TRACE_TCMALLOC": True,
        "KOMIRA_TRACE_TRAMPOLINE": True,
    },
    # test_runtime_introspection writes to the test's private directory (`test_tmpdir`,
    # TEST_TMPDIR). Only the installed layout gives the branch-coverage run one.
    test_layout = "installed",
)

# `:komira_counters`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are
# not run again.
mojo_adopted_library(
    name = "komira_counters",
    deps = ["//src/komira_atomic_alias:komira_atomic_alias"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_counters/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_counters-0.1.0-mojo1.0.0_0.conda`), which records komira_atomic_alias as a
# dependency (`mojo-komira_atomic_alias >=0.1,<0.2`) and holds that package's files nowhere.
# `members` is the manifest of the path dependency, staged at its repository path, because
# `mopm pack` reads the manifest of each beside the one it is given. `:lib` exists only once the
# tests passed, so this file exists only then. Publishing it (`mopm publish`) uploads, which is not
# a build action: it is a step of a CI job that takes this target's output. `mopm` is the one
# `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_counters",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../komira_atomic_alias": "//src/komira_atomic_alias:mopm.toml"},
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_73",
    package = "komira_counters",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/`, and exactly one dependency,
# `mojo-komira_atomic_alias >=0.1,<0.2`, which is what installing the package pulls in. The
# dev-dependency is not in it. Red when the manifest drops the dependency, names another range,
# lists the dev-dependency, or the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_atomic_alias >=0.1,<0.2"],
    package = "komira_counters",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_counters`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_counters_conda",
    lib = ":komira_counters",
    summary = "The `komira_counters` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
