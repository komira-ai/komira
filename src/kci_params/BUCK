load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Generic app parameter declarations: an app declares the
# parameters it takes, the deploy renders them onto argv, the app parses them
# at one site at startup, and the deployment store stores the map opaquely. Zero
# deps by design: three sides that must not depend on each other consume it.
#
# The welded test hands what the renderers emit to the parser unchanged and
# reads the same values back, and asserts each refusal by its message: a
# missing required parameter, an unknown one at either end, a literal for a
# secret parameter, and an empty value. test_param_decl_refusals walks every
# other refusal (names at each byte-range edge, codes, duplicates, kind
# mismatches, a flag with no value, an unbound read); test_param_config_wire
# covers the store's config encoding, its sort, and the map render.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:kci_params`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once
# the tests have passed. It carries the README gate too (`[tests][readme]`): the examples run
# against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "kci_params",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_params/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_params-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this
# file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is
# a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_params",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_params`. It goes when the release machine takes the mopm package.
# This library's mopm package is `:conda` above.
conda_package(
    name = "kci_params_conda",
    lib = ":kci_params",
    summary = "The `kci_params` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
