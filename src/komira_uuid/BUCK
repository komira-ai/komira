load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# UUIDv7 (RFC 9562): the `Uuid` value type, a stateless generator and a
# monotonic one, with its CSPRNG declaration; the wall clock is komira_clock's.
# `entropy.mojo` calls AWS-LC's `RAND_bytes`, which komira_crypto ships, so
# komira_crypto is a dep (tools/build/mojo/README.md, "Native reach").
mojo_library(
    name = "komira_uuid",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_clock:komira_clock",
        "//src/komira_crypto:komira_crypto",
    ],
    test_srcs = ["tests/test_uuid_v7.mojo"],
    visibility = ["PUBLIC"],
)
