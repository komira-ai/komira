load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/lint:defs.bzl", "doc_tree")

# UUIDv7 (RFC 9562): the `Uuid` value type, a stateless generator and a
# monotonic one, with the package's own wall clock and CSPRNG declaration.
# `entropy.mojo` declares AWS-LC's `RAND_bytes` itself (so the package does not
# depend on `komira_crypto`), which is why aws-lc's libcrypto is a dep.
mojo_library(
    name = "komira_uuid",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//third_party/aws-lc:crypto",
    ],
    test_srcs = ["tests/test_uuid_v7.mojo"],
    visibility = ["PUBLIC"],
)

# This package's files, for the link check of the repository's Markdown
# (//:docs). The glob stops at a subpackage, which names its own.
doc_tree(
    name = "doc_tree",
    srcs = glob(["**"]),
    visibility = ["komira//:docs"],
)
