load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")
load("@komira//tools/build/toolchains:mojo_versions.bzl", "mojo_version")

# A general-purpose Protocol Buffers wire codec: wire-type constants and
# zigzag transforms, a bounds-checked decoder with a tag-driven field cursor,
# and the symmetric encoder. It has no deps and no native code; the ORC
# metadata codec and the protobuf-binary serde backend depend on it.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:protobuf`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`): the examples run against
# `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "protobuf",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/protobuf/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira-ai.protobuf-0.1.0-mojo1.1.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step
# of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = mojo_version(),
    mopm = "toolchains//:mopm_0_0_138",
    package = "komira-ai/protobuf",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the packages whose own conda packages require this one and for the release machine, which
# still builds it (release/artifacts.textproto): komira's conda packer over `:protobuf`. It goes
# when those packages move to mopm. This library's mopm package is `:conda` above.
conda_package(
    name = "protobuf_conda",
    lib = ":protobuf",
    summary = "The `protobuf` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
