load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Interned-name registry: comptime FNV-1a name ids plus a fixed-capacity
# open-addressing table that maps an id back to its name. Depends only on the
# shared hash package.
mojo_library(
    name = "komira_name_registry",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_name_registry.mojo",
        "tests/test_name_registry_full.mojo",
    ],
    deps = ["//src/komira_hash:komira_hash"],
    visibility = ["PUBLIC"],
)
