# =============================================================================
# test_name_registry_full.mojo -- a table filled to MAX_REGISTERED_NAMES
# =============================================================================
#
# Registers 256 distinct names ("n000".."n255"; all 256 ids differ, and only
# 178 distinct low bytes among them, so many share a home slot and probe on),
# then one more ("n256"). Verifies:
#   1. Every one of the 256 registrations succeeds, including names whose
#      home slot is taken (the probe moves to the next slot and wraps).
#   2. Every name reads back by id, from `lookup` and `contains`, however far
#      it was displaced from its home slot.
#   3. On the full table a 257th name is refused: `try_register` returns
#      False after probing every slot, and the count stays at 256.
#   4. An id absent from the full table is absent to `lookup` and `contains`,
#      which also probe every slot and then stop.
# =============================================================================

from std.testing import assert_equal, assert_true, assert_false

from komira_name_registry import (
    MAX_REGISTERED_NAMES,
    NameRegistry,
    name_id,
    name_id_of,
)


def _expected_name(i: Int) -> String:
    var digits = String(i)
    while digits.byte_length() < 3:
        digits = "0" + digits
    return "n" + digits


def _fill(mut reg: NameRegistry, mut ids: List[UInt32]) -> Int:
    """Registers n000..n255 (one `try_register` instantiation per name, the
    only way to register a literal) and returns how many succeeded; `ids`
    gets each name's id, computed at run time from the same text."""
    for i in range(MAX_REGISTERED_NAMES):
        ids.append(name_id_of(_expected_name(i)))
    var oks = 0
    oks += Int(reg.try_register["n000"]())
    oks += Int(reg.try_register["n001"]())
