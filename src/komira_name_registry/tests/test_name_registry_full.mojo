def test_full_table_every_name_registers_and_reads_back() raises:
    """All 256 names register and read back by id, displaced or not."""
    var reg = NameRegistry()
    var ids = List[UInt32]()
    var oks = _fill(reg, ids)
    assert_equal(len(ids), MAX_REGISTERED_NAMES)
    # The run-time ids agree with the comptime ids the table was keyed by.
    assert_equal(ids[0], name_id["n000"]())
    assert_equal(ids[137], name_id["n137"]())
    assert_equal(ids[255], name_id["n255"]())
    assert_equal(oks, MAX_REGISTERED_NAMES, "every registration succeeds")
    assert_equal(reg.count(), MAX_REGISTERED_NAMES, "count is the capacity")
    var homes = List[Bool](length=MAX_REGISTERED_NAMES, fill=False)
    var shared = 0
    for i in range(len(ids)):
        var want = _expected_name(i)
        var home = Int(ids[i]) & (MAX_REGISTERED_NAMES - 1)
        if homes[home]:
            shared += 1
        homes[home] = True
        assert_true(reg.contains(ids[i]), String("contains ", want))
        var got = reg.lookup(ids[i])
        assert_true(Bool(got), String("lookup finds ", want))
        assert_equal(got.value(), want, "lookup returns its own name")
    # The fixture is only a probing test if names share home slots.
    assert_true(shared > 0, "some names share a home slot")


def test_full_table_refuses_another_name() raises:
    """The 257th name is refused once every slot is taken."""
    var reg = NameRegistry()
    var ids = List[UInt32]()
    _ = _fill(reg, ids)
    var extra = name_id["n256"]()
    assert_equal(extra, name_id_of(String("n256")))
    for i in range(len(ids)):
        assert_true(ids[i] != extra, "n256 is a new id")
    assert_false(reg.try_register["n256"](), "full table refuses")
    assert_equal(reg.count(), MAX_REGISTERED_NAMES, "count unchanged")
    # An already-registered name is still a no-op on the full table.
    assert_false(reg.try_register["n000"](), "re-registration is a no-op")
    assert_equal(reg.count(), MAX_REGISTERED_NAMES, "count unchanged")


def test_full_table_absent_id_is_absent() raises:
    """lookup and contains of an unregistered id on the full table probe
    every slot and report absent."""
    var reg = NameRegistry()
    var ids = List[UInt32]()
    _ = _fill(reg, ids)
    var absent = List[UInt32]()
    absent.append(name_id["n256"]())
    absent.append(UInt32(0xDEADBEEF))
    for k in range(len(absent)):
        assert_false(reg.contains(absent[k]), "absent id not contained")
        assert_false(Bool(reg.lookup(absent[k])), "absent id has no name")


def main() raises:
    print("test_name_registry_full")
    print("=======================")
    test_full_table_every_name_registers_and_reads_back()
    test_full_table_refuses_another_name()
    test_full_table_absent_id_is_absent()
    print()
    print("ALL TESTS PASS")
