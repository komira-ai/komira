    name = "expr",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/byte_buffer:byte_buffer",
        "//src/kernels:kernels",
        "//src/plan_expr:plan_expr",
        "//src/udf:udf",
    ],
    test_srcs = [
        "tests/test_composite_key.mojo",
        "tests/test_expr_sortable_key.mojo",
        "tests/test_runtime_expr_bool.mojo",
        "tests/test_runtime_expr_bool_child_bounds.mojo",
        "tests/test_runtime_expr_bool_shapes.mojo",
        "tests/test_stage_program.mojo",
        "tests/test_trait_conformance_across_mojoc.mojo",
        "tests/test_typed_projects.mojo",
        "tests/test_typed_udf_sugar.mojo",
        "tests/test_typed_udf_sugar_string.mojo",
        "tests/test_unified_trait_surface.mojo",
    ],
    visibility = ["PUBLIC"],
)
