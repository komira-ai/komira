load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The typed expression vocabulary: the ExprX trait family, the Stage[Program]
# IR, runtime_expr_bool, composite and sortable keys, typed projects and the
# typed UDF sugar. Sits above udf and kernels; the row-mode
# executor that implements these traits lives in eval.
