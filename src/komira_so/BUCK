load("@komira//tools/build/mojo:defs.bzl", "mojo_library", "mojo_shared_lib")

# The C ABI of komira's one shared library, libkomira: the status codes, the
# ABI version, the session behind a context handle, and the source and render
# operations (`sources.mojo`) the C calls are made of. The library is plain
# Mojo with no pointer in it; `_c_abi.mojo`, the one file that holds pointers,
# is not part of it but the source of the `libkomira` target below.
#
# test_status holds the six codes, the input-length bound, the version scheme (major * 1000 + minor)
# and buffer_status, the two-call protocol's capacity test; test_session holds
# the last-error text of a Session (fresh, set, replaced, cleared, moved);
# test_sources holds the operations on values: a Parquet file registered and
# its schema bytes, the CSV and JSON bindings, and a plan rendered.
mojo_library(
    name = "komira_so",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo", "_c_abi.mojo"]),
    deps = [
        "//src/komira_agg:komira_agg",
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_avro:komira_avro",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_column_kernels:komira_column_kernels",
