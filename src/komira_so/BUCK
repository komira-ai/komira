# libkomira.so (libkomira.dylib on macOS arm64): nine exports, and nothing else
# in the dynamic symbol table (`exports_exact`). It is published only if every
# gate driver passes, each of which dlopens it with RTLD_NOW and calls it as a
# foreign host would:
#   gate_version       the version is 1001 (1.1);
#   gate_new_free      handles are non-NULL, distinct and hold separate sessions,
#                      freeing NULL is a no-op;
#   gate_no_extra_exports  the linker's section markers and the Mojo helpers
#                      are not in the symbol table;
#   gate_fresh_error   a fresh session's error is empty, with or without a buffer;
#   gate_two_call      capacity 0 and one byte short give -4 and the length, an
#                      exact and a larger buffer give the text, nothing past it;
#   gate_null_ctx      a NULL context is -1 and writes nothing;
#   gate_null_out_len  a NULL out_len is -2 and writes nothing;
#   gate_register_parquet  a Parquet file is registered by name; NULL ctx -1,
#                      NULL name or path -2, a missing or non-Parquet file -3
#                      with the reader's message as the last error;
#   gate_native_owners the library's DT_NEEDED entries (ELF dynamic section)
#                      name each native_owners SONAME; an owner dropped from
#                      the list is embedded silently and fails here;
#   gate_parquet_schema, gate_csv_binding, gate_json_binding, gate_plan_render
#                      a good input through the two-call protocol, NULL ctx -1,
#                      NULL input or out_len -2, a bad file or plan -3 with a
#                      last error, and a good call afterwards leaves no error.
#   gate_plan_render also: plan_len 64 MiB plus one and UINT64_MAX are -5 with
#                      nothing written and no read of the plan; exactly 64 MiB
#                      is read (garbage, so -3). gate_parquet_schema also: a
#                      path that is not UTF-8 is -3 with a last error.
mojo_shared_lib(
    name = "libkomira",
    srcs = ["_c_abi.mojo"],
    out_name = "libkomira",
    exports = [
        "komira_abi_version",
        "komira_ctx_new",
        "komira_ctx_free",
        "komira_last_error",
        "komira_register_parquet",
        "komira_parquet_schema",
        "komira_csv_binding",
        "komira_json_binding",
        "komira_plan_render",
    ],
    exports_exact = True,
    gate_srcs = [
        "tests/gate/gate_fresh_error.mojo",
        "tests/gate/gate_new_free.mojo",
        "tests/gate/gate_no_extra_exports.mojo",
        "tests/gate/gate_native_owners.mojo",
        "tests/gate/gate_null_ctx.mojo",
        "tests/gate/gate_null_out_len.mojo",
        "tests/gate/gate_csv_binding.mojo",
        "tests/gate/gate_json_binding.mojo",
        "tests/gate/gate_parquet_schema.mojo",
        "tests/gate/gate_plan_render.mojo",
        "tests/gate/gate_register_parquet.mojo",
        "tests/gate/gate_two_call.mojo",
        "tests/gate/gate_version.mojo",
    ],
    deps = [":komira_so"],
    native_owners = [
        "//src/komira_async:komira_async_native",
        "//src/komira_async_api:komira_async_api_native",
        "//src/komira_compression:komira_compression_native",
        "//src/komira_fs:komira_fs_native",
        "//src/komira_libc:komira_libc_native",
        "//src/komira_metrics:komira_metrics_native",
        "//src/komira_scan_source:komira_scan_source_native",
    ],
    visibility = ["//node:"],
)

# The Parquet file the C-ABI gates and the Node binding's tests read.
export_file(
    name = "tests/fixtures/two_columns.parquet",
    src = "tests/fixtures/two_columns.parquet",
    visibility = ["//node:"],
)
