load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The artifact declarations: the reviewed list of what kci builds and
# publishes. A file declares build systems (a program and the args it always
# gets; kci names no build tool) and artifacts (a name, the build system and
# the args appended for it). Reads a declarations file (textproto) into the
# generated `kci.release.v1.ArtifactDeclarations`, validates it, and renders
# the argv that builds one artifact into an output
# directory (the six placeholders substituted in one pass: `{out_dir}`,
# `{release_dir}` and the git-derived stamp `{revision_id}`,
# `{source_commit}`, `{build_number}`, `{timestamp_ms}`; artifacts build in
# file order, so a metapackage declared last reads its members' manifests
# under `{release_dir}`). One artifact per declaration: it also
# holds the two refusals over what a build left (exactly one `manifest.json`
# at the top of the directory; its `name` equal to the declaration's,
# exactly). Pure: it runs no process and reads no directory; `kci build`
# does.
#
# The welded tests parse and refuse synthetic files in memory, assert each
# refusal by its message, round-trip the parsed value on the proto binary
# wire with every field number pinned as bytes, and render argvs exactly,
# including from `example.textproto`, staged as test data. One more reads the
# repository's own release/artifacts.textproto through the same reader, so a
# release file kci would refuse fails this library's build.
mojo_library(
    name = "kci_artifact_declaration",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_artifact_declaration_proto:kci_artifact_declaration_proto",
        "//src/kci_contract:kci_contract",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_textproto:komira_textproto",
    ],
    test_srcs = [
        "tests/test_declaration_parse.mojo",
        "tests/test_declaration_render.mojo",
        "tests/test_declaration_validate.mojo",
        "tests/test_release_artifacts_file.mojo",
    ],
    test_data = {
        "tests/test_declaration_render.mojo": ["example.textproto"],
        # The repository's own release declarations (release/BUCK).
        "tests/test_release_artifacts_file.mojo": {
            "artifacts.textproto": "//release:artifacts.textproto",
        },
    },
    visibility = ["PUBLIC"],
)

# The example declarations file, for tests in other packages that render from
# it (kci_build's flow test stages it as test data).
export_file(name = "example.textproto", visibility = ["PUBLIC"])
