load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon SNS: an awsQuery client generated at build time from botocore's sns
# model (//third_party/botocore, pinned by sha256; nothing of it is copied
# here), in client mode: each operation's request builder (a form body) and
# response parser (its <OpResult> element), its endpoint resolved through
# SNS's published endpoint ruleset and partition table, embedded in the
# module, and `SNSClient`, which resolves each call's endpoint and sends
# through komira_aws_core's send_sigv4_signed_request (signing name `sns`)
# over the komira_http_core Connector it is given. Every SNS operation is a
# POST, and a call is retried as botocore's standard mode retries it
# (komira_aws_core's aws_retry.mojo).
#
# `operations` covers a topic's and a subscription's lifecycle: a topic
# created, its attributes read and set, and deleted; an endpoint
# subscribed, the topic's subscriptions listed, a subscription's attributes
# read and set, and the subscription removed. The generator refuses none of
# them. An operation joins the list with its own rows in the tests below.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Amazon SNS API reference (no upstream test body is copied):
# test_sns_requests (the form body each operation builds, exactly, maps and
# lists of structures included), test_sns_responses (each result read from
# its wrapper, and the <ErrorResponse> read through komira_aws_core),
# test_sns_endpoints (botocore's endpoint cases for sns through every
# operation's resolver, the regional, FIPS, dual-stack and LocalStack
# endpoints, and two requests signed end to end against independently
# computed signatures), _no_env_reads (written by mojo_aws_client: the
# package reads no environment) and test_sns_client (the generated client
# over a scripted connector, a missing topic raised under its code, and the
# CreateTopic request as it reached the wire, through komira_aws_core's
# AwsEchoConnector).
#
# No test here talks to the service.

_SNS = botocore_model("sns")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("sns")

mojo_aws_client(
    name = "komira_aws_sns",
    endpoint_rules = _SNS.endpoint_rules,
    mode = "client",
    model = _SNS.model,
    model_sha256 = _SNS.sha256,
    operations = [
        "CreateTopic",
        "DeleteTopic",
        "GetSubscriptionAttributes",
        "GetTopicAttributes",
        "ListSubscriptionsByTopic",
        "SetSubscriptionAttributes",
        "SetTopicAttributes",
        "Subscribe",
        "Unsubscribe",
    ],
    partitions = _SNS.partitions,
    test_data = {
        "tests/test_sns_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_sns_client.mojo",
        "tests/test_sns_endpoints.mojo",
        "tests/test_sns_requests.mojo",
        "tests/test_sns_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        # test_sns_endpoints reads botocore's endpoint cases with it.
        "//src/komira_json:komira_json",
        # The client's `send_with` takes a komira_retry loop.
        "//src/komira_retry:komira_retry",
        "//src/komira_xml:komira_xml",
    ],
)
