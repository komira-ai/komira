    """`CreateTopic` — the endpoint the ruleset chooses for this call: its URL,
        headers and properties (`authSchemes` says how to sign). An `error`
        rule's answer is raised with the ruleset's message."""
    var params = config.endpoint_params()
    var outcome = rules.resolve(params)
    if outcome.is_error:
        raise Error(
            String("komira_aws_sns: the endpoint ruleset chose no endpoint for CreateTopic: ") + outcome.error
        )
    return outcome.endpoint.copy()

