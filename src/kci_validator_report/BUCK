load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The one report library every validator shares, and its falsifier.
#
# It produces EVIDENCE, not authorization: the record it renders is written by
# the party being gated, into a bucket that party can write. The gate stays the
# EXIT CODE (`report_exit_code`) and the build graph (a test's pass marker is an
# input to the package).
#
# The one dep is `kci_validator_rows`, and that is the whole design. A report
# model that lives in a package linking an HTTP client and an async runtime is
# never adopted, because copying forty lines is cheaper; `kci_validator_rows` is
# dep-free, so this closure is pure `String`/`List` work: no HTTP, no async, no
# clock, no store, no FFI, no cloud SDK. A dep added here is a dep every
# validator pays. Do not add deps.
#
# A consumer gets both packages on its compile closure through `deps`; the
# re-exports in `__init__.mojo` buy it one import line.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# kci_validator_rows, a sibling package (`[dependencies]` of mopm.toml): its `:lib` is built from
# that package's `:lib`.
mojo_package(path = ".")

# `:kci_validator_report`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are
# not run again.
mojo_adopted_library(
    name = "kci_validator_report",
    deps = ["//src/kci_validator_rows:kci_validator_rows"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_validator_report/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_validator_report-0.1.0-mojo1.0.0_0.conda`), which records kci_validator_rows as a
# dependency (`mojo-kci_validator_rows >=0.1,<0.2`) and holds that package's files nowhere.
# `members` is the manifests of the path dependencies, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given. `:lib` exists only once the
# tests passed, so this file exists only then. Publishing it (`mopm publish`) uploads, which is not
# a build action: it is a step of a CI job that takes this target's output. `mopm` is the one
# `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/kci_validator_report",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../kci_validator_rows": "//src/kci_validator_rows:mopm.toml"},
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_validator_report",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/` (kci_validator_rows is not in it), and exactly one
# dependency, `mojo-kci_validator_rows >=0.1,<0.2`, which is what installing the package pulls in.
# Red when the manifest drops the dependency, names another range, or the file carries the sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-kci_validator_rows >=0.1,<0.2"],
    package = "kci_validator_report",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_validator_report`. It goes when the release machine takes the
# mopm package. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_validator_report_conda",
    lib = ":kci_validator_report",
    summary = "The `kci_validator_report` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
