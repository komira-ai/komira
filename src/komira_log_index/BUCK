load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The native log index: log records are transposed to a typed columnar batch
# (the frozen log-index schema), an L0 index is built over them (an unsorted
# term-hash posting beside the doc store and fast-field region of an ordinary
# split), and L0 splits are read and searched. The idle hook drains a worker's
# log ring when the worker is idle, builds an L0 split and publishes it: the
# split object is written to the store first and its summary is appended to the
# metastore (komira_search_catalog) second. The store is a type parameter over
# komira_objectstore's conditional-write traits; no cloud client is named here.
#
# The welded tests (each file's header says which defect it catches):
# - test_log_native_indexing_idle_hook_e2e: the idle hook installed on a real
#   per-core runtime drains a real engine's ring when its worker fires the hook,
#   publishes L0 splits that an immediate query finds (against an oracle), drains
#   at most DRAIN_CAP records per fire, and loses nothing on a graceful final
#   flush.
# - test_log_native_indexing_l05: the off-core flush pipeline (handoff, consumer,
#   in-flight gate) end to end: drained logs are searchable after the publish,
#   the byte and time flush ceilings fire, an un-flushed window is the only loss
#   on a crash, and the in-flight cap bounds memory under a stalled consumer.
# - test_log_index_offcore_failure_paths: the consumer writes the split object
#   before it publishes, a failed put or publish publishes nothing and releases
#   the gate, a transient put failure is retried under the same key, a restarted
#   consumer does not reuse split keys, the handoff rejects (never blocks) at
#   its depth and byte bounds, and the flush thread's shutdown publishes the
#   last partial segment.
# - test_log_native_indexing_l0: the log seam and the transpose (message bytes
#   identical to the text drain, scalars survive the seam, the frozen eight
#   column schema with unsigned columns widened to Int64, schema invariance
#   across windows), the shard role axis, and drained logs searched end to end
#   (full text, a numeric filter, a date sort, the metastore publish).
# - test_log_native_indexing_l1: the L0 split parses as a SPLIT_VERSION=1
#   container, the posting query equals a brute-force oracle, the fast-field and
#   doc-store regions are byte-identical to the optimized writer's for one
#   batch, and the build task publishes a queryable split.
# - test_log_native_indexing_lread: reading an L0 split against an oracle, the
#   per-split format dispatch, a mixed L0 and optimized merge with no lost or
#   duplicated documents, and paging with the true total.
# - test_telemetry_log_base_artifact: the batch the real transpose produces
#   publishes through komira_telemetry_store as time-partitioned Parquet, and a
#   time-range read resolves to it.
mojo_library(
    name = "komira_log_index",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    # The full transitive closure of the Mojo libraries this package builds on.
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_clock:komira_clock",
        "//src/komira_collections:komira_collections",
        "//src/komira_column_kernels:komira_column_kernels",
        "//src/komira_compression:komira_compression",
        "//src/komira_counters:komira_counters",
        "//src/komira_dynamic_filter:komira_dynamic_filter",
        "//src/komira_fork_join:komira_fork_join",
        "//src/komira_fs:komira_fs",
        "//src/komira_hash:komira_hash",
        "//src/komira_host:komira_host",
        "//src/komira_join_assembly:komira_join_assembly",
        "//src/komira_libc:komira_libc",
        "//src/komira_log:komira_log",
        "//src/komira_lz4:komira_lz4",
        "//src/komira_metrics:komira_metrics",
        "//src/komira_name_registry:komira_name_registry",
        "//src/komira_objectstore:komira_objectstore",
        "//src/komira_objectstore:komira_objectstore_posix",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_ir:komira_plan_ir",
        "//src/komira_plan_stats:komira_plan_stats",
        "//src/komira_scalar_arithmetic:komira_scalar_arithmetic",
        "//src/komira_scan_source:komira_scan_source",
        "//src/komira_search:komira_search",
        "//src/komira_search_catalog:komira_search_catalog",
        "//src/komira_simd:komira_simd",
        "//src/komira_spsc_ring:komira_spsc_ring",
        "//src/komira_trace:komira_trace",
        "//src/komira_zlib:komira_zlib",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    # The telemetry store is a test-only dependency: the test that drives the
    # real transpose into its segment writer lives on this side of the edge,
    # because komira_telemetry_store does not depend on this package. The
    # Parquet reader is not needed here: the test checks the Parquet magic.
    test_deps = [
        "//src/komira_telemetry_store:komira_telemetry_store",
    ],
    test_srcs = [
        "tests/test_log_index_failure_paths.mojo",
        "tests/test_log_index_offcore_failure_paths.mojo",
        "tests/test_log_native_indexing_idle_hook_e2e.mojo",
        "tests/test_log_native_indexing_l0.mojo",
        "tests/test_log_native_indexing_l05.mojo",
        "tests/test_log_native_indexing_l1.mojo",
        "tests/test_log_native_indexing_lread.mojo",
        "tests/test_telemetry_log_base_artifact.mojo",
    ],
    visibility = ["PUBLIC"],
)
