load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The validations of a stage's steps (`kci run --stage S`; the machine file
# declares them on a step, kci_release_machine parses them). One kind today,
# CONDA_INSTALL_SMOKE: after a PUBLISH step, read the step's channel
# ANONYMOUSLY (the index lists each pinned file with the build's sha256 and
# serves those bytes; the absence of a file is waited for, then it fails),
# then `docker run` a digest-pinned image that installs the release with pixi
# from that channel and runs a program against it. kci reads back what was
# installed (version, build, sha256 and channel of every record, the
# compiler's pin, nothing from an undeclared channel), each library's
# installed payload, and the program's `N of N checks passed`. Every failure
# is VALIDATION_FAILED (exit 7); there is no skip. Under --plan it runs
# nothing and reports WOULD_VALIDATE.
#
# The welded tests drive kci_build's ScriptedRunner as a fake docker (it
# writes what the container would leave in the mount, and the exact argv is
# pinned as a golden), kci_pkg_upload's ScriptedPkgTransport as the channel,
# and kci_publish's NoWaitSleeper, over release directories kci_publish's
# ExampleRelease writes under TEST_TMPDIR: no docker, no network.
mojo_library(
    name = "kci_validate",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_artifact:kci_artifact",
        "//src/kci_build:kci_build_lib",
        "//src/kci_api:kci_api",
        "//src/kci_pkg_upload:kci_pkg_upload",
        "//src/kci_publish:kci_publish_lib",
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_release_set:kci_release_set",
        "//src/kci_release_machine:kci_release_machine",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_json:komira_json",
        "//src/komira_retry:komira_retry",
    ],
    test_srcs = [
        # the pass; every row of checks 0 to 4 failing on its own, each
        # VALIDATION_FAILED; the wait (absent then listed, 404 then budget
        # spent, 401 at once, another sha256 at once); --plan runs nothing
        "tests/test_conda_install_smoke.mojo",
        # the exact docker argv, the script, pixi.toml and the docker CLI's
        # environment, golden
        "tests/test_install_smoke_container_golden.mojo",
    ],
    visibility = ["PUBLIC"],
)
