load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The validations of a stage's steps (`kci run --stage S`; the machine file
# declares them on a step, kci_release_machine parses them). Two kinds. The
# ENV kind, CONDA_INSTALL_ENV, installs on the machine that runs kci with no
# container (a pinned pixi linked into a scratch directory outside the
# checkout, a cleared environment) and runs each installed library's README
# examples, made into programs by the README examples tool
# (//tools/build/readme_examples:tool, which kci ships beside its executable:
# bin/kci/BUCK `helpers`) exactly as the welded `[tests][readme]` test makes
# them; no network at all is INDETERMINATE
# (exit 5) with a skip_reason, never a pass. The CONTAINER kind,
# CONDA_INSTALL_SMOKE: after a PUBLISH step, read the step's channel
# ANONYMOUSLY (the index lists each pinned file with the build's sha256 and
# serves those bytes; the absence of a file is waited for, then it fails),
# then `docker run` a digest-pinned image that installs the release with pixi
# from that channel and runs a program against it. kci reads back what was
# installed (version, build, sha256 and channel of every record, the
# compiler's pin, nothing from an undeclared channel), each library's
# installed payload, and the program's `N of N checks passed`. Every failure
# is VALIDATION_FAILED (exit 7). Under --plan either kind runs nothing and
# reports WOULD_VALIDATE. Before publishing, an ENV validation can read and
# install from a LOCAL channel instead (`file:///<dir>`, what `komira_pack
# conda-index` writes; kci run --channel), through FileChannelTransport.
#
# The welded tests drive kci_build's ScriptedRunner as a fake docker (it
# writes what the container would leave in the mount, and the exact argv is
# pinned as a golden), kci_pkg_upload's ScriptedPkgTransport as the channel,
# and kci_publish's NoWaitSleeper, over release directories kci_publish's
# ExampleRelease writes under TEST_TMPDIR: no docker, no network.
mojo_library(
    name = "kci_validate",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_artifact:kci_artifact",
        "//src/kci_build:kci_build_lib",
        "//src/kci_api:kci_api",
        "//src/kci_pkg_upload:kci_pkg_upload",
        "//src/kci_publish:kci_publish_lib",
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_release_set:kci_release_set",
        "//src/kci_release_machine:kci_release_machine",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        "//src/komira_retry:komira_retry",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        # the pass; every row of checks 0 to 4 failing on its own, each
        # VALIDATION_FAILED; the wait (absent then listed, 404 then budget
        # spent, 401 at once, another sha256 at once); --plan runs nothing
        "tests/test_conda_install_smoke.mojo",
        # check 1 alone over a prefix.dev-shaped location: the index URL
        # (golden), 404 for N polls then listed (the wait and the poll count
        # reported), 404 past the budget, a 303 followed, the poll log
        "tests/test_channel_index_wait.mojo",
        # the exact docker argv, the script, pixi.toml and the docker CLI's
        # environment, golden
        "tests/test_install_smoke_container_golden.mojo",
        # CONDA_INSTALL_ENV over a fake pixi: the pass; each channel,
        # install and program failure (no network is INDETERMINATE with a
        # skip_reason, a 401 is a FAIL); RunSpec.cwd is the scratch work dir;
        # the checkout, system-config and README refusals; a LOCAL file:///
        # channel read from its directory, and the file transport's refusals
        "tests/test_conda_install_env.mojo",
        # the child's whole environment, the pixi argv, the manifest, and
        # the installed README's program byte-equal to SOURCE mode's, golden
        "tests/test_install_env_golden.mojo",
        # the README examples tool: where kci looks for it, and a missing,
        # empty or unrunnable tool refused by name; a failed map refused
        # naming the report, and the program row it fails
        "tests/test_readme_tool.mojo",
        # the native install checks (#1363's lib_files rows, `__glibc`):
        # a sha256 mismatch, a missing file, a mode 644 .so, a dangling
        # link, an extra .so, a __glibc of 2.38, NEEDED outside the
        # environment, no DF_SYMBOLIC, the loaded-from record, the ELF reader
        "tests/test_native_install.mojo",
        # the link commands of an installed README (slice 10): the closure's
        # arguments (every shared library dependents first, the static
        # archive on the build line), the real tool reading the block, and
        # the `readme` row refusing a README without an owner's -l, a
        # missing or unwanted block, and the same words in another order
        "tests/test_readme_link.mojo",
    ],
    # The README examples tool kci ships, for the tests that make an
    # installed README into programs (the same target bin/kci/BUCK ships).
    test_data = {
        "tests/test_conda_install_env.mojo": {"readme_examples": "//tools/build/readme_examples:tool"},
        # and the README and programs of komira_encoding's welded README
        # test, to compare kci's programs with
        "tests/test_install_env_golden.mojo": {
            "readme_examples": "//tools/build/readme_examples:tool",
            "encoding_readme": "//src/komira_encoding:komira_encoding[tests][readme][file]",
            "encoding_generated": "//src/komira_encoding:komira_encoding[tests][readme][generated]",
        },
        "tests/test_readme_tool.mojo": {"readme_examples": "//tools/build/readme_examples:tool"},
        "tests/test_readme_link.mojo": {"readme_examples": "//tools/build/readme_examples:tool"},
    },
    visibility = ["PUBLIC"],
)
