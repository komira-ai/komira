load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The window operator over one batch (`partition_scan_sink`): the window sort and
# partition / peer boundaries (`partition_keys`, NULLs last and floats by
# `sort_key_lt`, as DuckDB orders them), the ranking functions and running
# aggregates, the value functions, the frame resolver and the framed and
# whole-partition aggregates.
mojo_library(
    name = "komira_op_window",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_column_kernels:komira_column_kernels",
        "//src/komira_counters:komira_counters",
        "//src/komira_op_sort:komira_op_sort",
        "//src/komira_operator_api:komira_operator_api",
        "//src/komira_physical_plan:komira_physical_plan",
        "//src/komira_plan_expr:komira_plan_expr",
    ],
    test_srcs = [
        "tests/test_window_partition_keys.mojo",
        "tests/test_window_ranking_aggregates.mojo",
        "tests/test_window_value_fns.mojo",
    ],
    visibility = ["PUBLIC"],
)
