load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The build side of the engine's joins. So far: the untyped hash-join table
# (`JoinBuildTable_Untyped`) with its packed `HashDirectory`, its per-column
# cell kernels and the key hashes the untyped tables share.
