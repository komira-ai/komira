    name = "komira_op_join_build",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_column_format:komira_column_format",
        "//src/komira_counters:komira_counters",
        "//src/komira_udf:komira_udf",
    ],
    test_srcs = [
        "tests/test_hash_directory.mojo",
        "tests/test_join_build_table_untyped.mojo",
        "tests/test_join_composite_f64_key_kerneldirect.mojo",
        "tests/test_join_hash_store_grow.mojo",
        "tests/test_join_untyped_float_key_model.mojo",
        "tests/test_strkey_bulk_join_byte_equiv.mojo",
    ],
    visibility = ["PUBLIC"],
)
