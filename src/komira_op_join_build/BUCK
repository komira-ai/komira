load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The build side of the engine's joins, and the kernels that need no join
# operator: the single-INT64-key hash join (`HashJoinBuilder`, its serial
# builds and its INNER / SEMI / ANTI / outer probes), the sort-merge join and
# the perfect-hash join; the untyped hash-join table (`JoinBuildTable_Untyped`)
# with its packed `HashDirectory` and per-column cell kernels; the CROSS-join
# kernel, the blocking functions of non-equi joins, the probe NULL mask, and
# the settings, predicates and witnesses of the build's levers.
