load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The wire translators of an OpenSearch/Elasticsearch compatible search shim:
# the `_bulk` NDJSON parser (`ndjson_bulk_to_docbatch`: a document batch with
# dynamic field mapping and a per-item outcome list), the `_search` request
# translator (`search_json_to_queryir`: match, term and range filters, sort,
# from/size and aggregations into a QueryIR) with the gates that check a parsed
# request against a split's fast-field meta, the response envelopes, and the
# JSON `HttpResponse` builders. They depend on `komira_search` (the engine's
# batch, query and result types) and on `komira_json`; the engine itself sees
# no wire byte.
#
# The welded tests run in memory, with no network. They build splits with the
# search sink and read them with `SearchCore`. The aggregation, filter,
# keyword-alias and sort suites drive request JSON through the translator and
# the gates against those splits; the two bulk suites check dynamic mapping,
# type conflicts and per-item partial success and index the committed batch;
# the multi-split suites merge several splits and check the rendered envelope;
# the last feeds the parsers hostile bodies (an overflowing from/size, a long
# bool clause list, nested bool and aggregation queries, a field named twice,
# numbers out of range, too many fields, ill-formed UTF-8).
mojo_library(
    name = "komira_search_http",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
