load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Parquet page compression: the codec dispatch a page reader and writer call
# (UNCOMPRESSED, SNAPPY, GZIP, ZSTD, LZ4_RAW, the deprecated LZ4, BROTLI), the
# snappy codec (the snappy C API, statically linked, and a Mojo decoder), the
# LZ4 frame codec and a CRC-32C helper. Every public entry takes Spans.
# text_decompress reads a whole `.csv/.jsonl[.gz|.zst|.lz4]` file, decompressed
# by those codecs; it needs komira_arrow_ipc's read_chunked, which is why it is
# here and not in komira_compression (komira_arrow_ipc depends on that).
#
# snappy, zstd, zlib and LZ4 (raw block and frame) come from komira_compression,
# the owner of the snappy C API (linked from //third_party/snappy through its
# deps) and of every codec soname (opened at first use); this package
# declares no codec FFI of its own but the Brotli decoder's, linked from
# //third_party/brotli.
#
# The welded tests:
# - test_codec_owner_equivalence: `compress` (SNAPPY, ZSTD, LZ4_RAW, GZIP) and
#   `compress_lz4_frame` byte-equal to komira_compression called directly,
#   the round trips, and the refusal texts callers match on.
# - test_compression_gzip, test_compression_zstd_lz4: the dispatch, codec by
#   codec: round trips, a known gzip stream and a known zstd frame, too-small
#   outputs, refusals.
# - test_compression_brotli: google/brotli's decoder test vectors
#   (//third_party/brotli:testdata, out of the pinned brotli archive, staged
#   at brotli/).
# - test_compression_lz4_framings: LZ4 frames and the three layouts of the
#   deprecated LZ4 codec, from the reference liblz4's golden frame
#   (//third_party/pierrec-lz4, pinned by sha256, staged at golden/).
# - test_snappy_corpus: google/snappy's correctness corpus and its three
#   corrupt blobs (//third_party/snappy:testdata, out of the pinned snappy
#   archive, staged at corpus/), through both snappy decoders.
# - test_snappy_mojo_oracle, test_snappy_short_offset: the Mojo snappy decoder
#   against the C library's, and hand-built short-offset blobs.
# - test_snappy_exact_dst: both snappy decoders into a destination with less
#   than kSlopBytes of room past the decoded length, sentinel-guarded, and a
#   blob declaring more than the destination holds; hand-built blobs that
#   put each of the Mojo decoder's four single 16-byte stores at every
#   distance from the end of an exact-size destination.
# - test_snappy_fuzz: a seeded differential fuzz of both snappy decoders
#   (structured tag streams, random bytes, every prefix and single-byte
#   corruptions of a valid stream), sentinel-guarded on both sides of the
#   destination and with the input surrounded by two different fills.
# - test_codecs_adversarial: every codec through the dispatch with
#   truncations, single-byte corruptions, short and empty destinations and
#   hostile size fields, sentinel-guarded on both sides of the destination.
# - test_crc32c: published CRC-32C check values.
# - test_lz4_text_framing_detection: `.lz4` text files as LZ4 frames and as
#   raw blocks through text_decompress: the framing selector, both round
#   trips, a frame that needs a grow step, and a corrupt frame refused as not
#   a capacity failure.
# - test_text_decompress_direct: every branch of text_decompress: the twelve
#   suffixes, the codec map, the size guess and the gzip ISIZE hint, a
#   compressed CSV read back for each codec, and the cap-and-grow loop driven
#   with a lowered cap (the ISIZE and LZ4 Content Size hints, growth, the
#   inclusive cap, the refusal's message).
# - test_parquet_file_pages_e2e: every page of Parquet files pyarrow wrote
#   (tests/fixtures/parquet, staged at parquet/; gen_pyarrow_fixtures.py is
#   their provenance and SHA256SUMS pins them): the footer walked by a
#   compact-Thrift reader in the test, each page body decompressed through
#   the dispatch (GZIP, SNAPPY, ZSTD, UNCOMPRESSED; DATA_PAGE and
#   DATA_PAGE_V2) against its header's sizes, each page CRC-32 checked, and
#   decoded values against the data the generator wrote.
# - test_no_env_reads: the package's sources read no environment, import no
#   komira package outside the deps below, hold no raw pointer in a public
#   signature and rebuild no address from an integer. It is staged every
#   source `srcs` compiles, subdirectories included, so a module the scan does
#   not read fails it.
_SRCS = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"])

_PARQUET_FIXTURES = [
    "lineitem_pyarrow_500.parquet",
    "lineitem_pyarrow_500_uncompressed.parquet",
    "pyarrow_gzip_plain.parquet",
    "pyarrow_int96_ts.parquet",
    "pyarrow_multi_dict_page.parquet",
    "pyarrow_page_crc_zstd_v2.parquet",
    "pyarrow_zero_row.parquet",
]

mojo_library(
    name = "komira_parquet_codec",
    srcs = _SRCS,
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_compression:komira_compression",
        "//src/komira_counters:komira_counters",
        "//src/komira_host:komira_host",
        "//src/komira_libc:komira_libc",
        "//src/komira_parquet_api:komira_parquet_api",
        "//src/komira_simd:komira_simd",
        "//third_party/brotli:brotlidec",
    ],
    test_data = {
        "tests/test_codecs_adversarial.mojo": {
            "brotli": "//third_party/brotli:testdata",
        },
        "tests/test_compression_brotli.mojo": {
            "brotli": "//third_party/brotli:testdata",
        },
        "tests/test_compression_lz4_framings.mojo": {
            "golden/gettysburg.txt": "//third_party/pierrec-lz4:gettysburg.txt",
            "golden/gettysburg.txt.lz4": "//third_party/pierrec-lz4:gettysburg.txt.lz4",
        },
        "tests/test_parquet_file_pages_e2e.mojo": {
            "parquet/" + f: "tests/fixtures/parquet/" + f
            for f in _PARQUET_FIXTURES
        },
        "tests/test_no_env_reads.mojo": {
            "src/" + f: f
            for f in _SRCS
        },
        "tests/test_snappy_corpus.mojo": {
            "corpus": "//third_party/snappy:testdata",
        },
    },
    test_srcs = [
        "tests/test_codec_owner_equivalence.mojo",
        "tests/test_codecs_adversarial.mojo",
        "tests/test_compression_brotli.mojo",
        "tests/test_compression_gzip.mojo",
        "tests/test_compression_lz4_framings.mojo",
        "tests/test_compression_zstd_lz4.mojo",
        "tests/test_crc32c.mojo",
        "tests/test_lz4_text_framing_detection.mojo",
        "tests/test_no_env_reads.mojo",
        "tests/test_parquet_file_pages_e2e.mojo",
        "tests/test_snappy_corpus.mojo",
        "tests/test_snappy_exact_dst.mojo",
        "tests/test_snappy_fuzz.mojo",
        "tests/test_snappy_mojo_oracle.mojo",
        "tests/test_snappy_short_offset.mojo",
        "tests/test_text_decompress_direct.mojo",
    ],
    visibility = ["PUBLIC"],
)
