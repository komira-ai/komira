load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The civil calendar, the timestamp text formats and IANA time zones: days
# <-> (year, month, day) in the proleptic Gregorian calendar, epoch seconds
# <-> UTC fields, ISO 8601 / RFC 3339 read and write, the HTTP-date
# (IMF-fixdate); TZif (RFC 9636) files read into zones, the POSIX TZ string
# of their footers, UTC to local, and local to UTC with gap and fold policies
# the caller names. Pure Mojo over the standard library; the wall clock is
# komira_clock's. No zone data is bundled: a caller passes TZif bytes or
# names a zoneinfo directory. The conformance goldens against the pinned tz
# release (third_party/tzdata) are in
# //src/tests/conformance/komira_datetime_conformance, so that data is a
# test input there and never in this library's closure.
#
# test_civil checks both directions on every day of years -1000..3000 against a
# calendar WALKED day by day from 1970-01-01 (no formula in common with the
# code), plus the leap-year centuries and the 10^9-year boundary. test_timestamp
# and test_http_date pin each place the copies of this arithmetic that grew up
# in other packages disagree (see the comment above each such test).
#
# test_tzif feeds files built byte by byte (each refusal by its exact text;
# a version 1 block that disagrees with the version 2 one); test_posix_tz
# checks the grammar and the rule dates against a printed calendar;
# test_resolve checks gaps, folds and each policy on zones from POSIX TZ
# strings; test_zone_name checks the name check that keeps a zone name inside
# the zoneinfo directory.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_datetime`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`): the examples run against
# `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_datetime",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_datetime/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_datetime-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step
# of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_datetime",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/artifacts.textproto): komira's conda
# packer over `:komira_datetime`. It goes when the release machine takes the mopm package. This
# library's mopm package is `:conda` above.
conda_package(
    name = "komira_datetime_conda",
    lib = ":komira_datetime",
    summary = "The `komira_datetime` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
