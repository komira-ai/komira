load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The execution-time half of a scan kind: the `ScanSourceResolver` trait (plan
# the splits, open a reader per split), the type-erased resolver and reader
# facades, the per-context resolver set keyed by kind id, and `drain_scan`, the
# bounded read over any conformer. It sits on komira_core's scan substrate
# (bindings, params, kind descriptors, the tier-1 `ScanResolver`) and nothing
# else, so a package that implements a kind does not depend on the engine that
# executes it.
#
# The welded tests drive stub kinds with no executor: erasing and dropping a
# conformer or a reader destroys it exactly once, a duplicate or unregistered
# kind and a facade from another ABI are refused by name, a foreign binding or
# position is refused, the drain reads splits in `after` order and refuses a
# split with no stop, a resumed split reads exactly the rest, and a split that
# follows its source goes IDLE, then ROWS, then END once it has a stop.
mojo_library(
    name = "komira_scan_resolver",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = ["//src/komira_core:komira_core"],
    test_srcs = [
        "tests/test_scan_source_resolver.mojo",
        "tests/test_split_reader.mojo",
    ],
    visibility = ["PUBLIC"],
)
