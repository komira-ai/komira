load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The search source edge: the `Searcher` SourceLike plan-spec and the
# `SearchMorselSource` MorselSourceImpl reader over a search split. Kept above
# komira_search so the search core does not depend on the morsel layer.
mojo_library(
    name = "komira_search_runtime",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_core:komira_core",
        "//src/komira_morsel:komira_morsel",
        "//src/komira_search:komira_search",
    ],
    test_srcs = [
        "tests/test_search_source_conformance.mojo",
    ],
    visibility = ["PUBLIC"],
)
