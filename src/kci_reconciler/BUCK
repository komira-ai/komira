load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The provider-neutral resource-graph deploy engine core. It reconciles a
# ResourceGraph of erased Resource nodes against LIVE actual state with the
# verbs plan / apply / rollback / destroy, over a StateStore (write-ahead
# intent) and per-call Creds. A per-provider conformer is a separate package
# that imports this and implements Resource; this core names no provider.
#
# Deps: komira_core (Slab, the node storage of the graph) and komira_log (the
# WARN breadcrumb a swallowed best-effort prune fault emits).
#
# The welded tests drive the real engine over in-memory conformers: topo
# order, create / adopt / update, rollback and destroy with every retention
# code, the confirmed-gone reap gate, the destroy scope, crash-then-adopt
# recovery, the best-effort prune, fault attribution defaulting to ours, and
# the owned scope: the store keyed (machine, cell, resource), the stamp born
# with the object, foreign and conflict refused before any change, the closed
# world of turned-off roles, and unmanaged differences planned, never touched.
mojo_library(
    name = "kci_reconciler",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_core:komira_core",
        "//src/komira_log:komira_log",
    ],
    test_srcs = [
        "tests/test_erased_resource_public_api.mojo",
        "tests/test_fault_domain_defaults_to_ours.mojo",
        "tests/test_ownership_and_cell_keys.mojo",
        "tests/test_resource_graph_engine.mojo",
        "tests/test_resource_outputs.mojo",
        "tests/test_resource_outputs_after_mutation.mojo",
    ],
    # The public-API test reads the facade's own source to check its shape.
    test_data = {
        "tests/test_erased_resource_public_api.mojo": ["erased_resource.mojo"],
    },
    visibility = ["PUBLIC"],
)
