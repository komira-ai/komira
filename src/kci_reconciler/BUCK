load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The provider-neutral resource-graph deploy engine core. It reconciles a
# ResourceGraph of erased Resource nodes against LIVE actual state with the
# verbs plan / apply / rollback / destroy, over a StateStore (write-ahead
# intent) and per-call Creds. A per-provider conformer is a separate package
# that imports this and implements Resource; this core names no provider.
#
# Deps: komira_collections (Slab, the node storage of the graph) and komira_log (the
# WARN breadcrumb a swallowed best-effort prune fault emits).
#
# The welded tests drive the real engine over in-memory conformers: topo
# order, create / adopt / update, rollback and destroy with every retention
# code, the confirmed-gone reap gate, the destroy scope, crash-then-adopt
# recovery, the best-effort prune, fault attribution defaulting to ours, the
# permanent and in-flight fault marks surviving the engine's re-raise, and
# the owned scope: the store keyed (machine, cell, resource), the stamp born
# with the object, foreign and conflict refused before any change, the closed
# world of turned-off roles, and unmanaged differences planned, never touched.
# The unpinned-plan test checks that an image whose build step has not run
# yet plans as a placeholder that cannot pass for a digest, only when the
# caller passes a record of it, and is listed by kind, node and step output.
# The failure-path tests drive scripted nodes whose reads can change between
# the owned pre-flight and the node's own read: each failed verb is named with
# its fault domain, ownership that changes mid-run stops the verb, a
# converging phase is refused, and the owned destroy reads only its targets.
# The descriptor tests pin the read and delete envelopes (a not-found is
# absent, anything else propagates) and every forward; the value-type tests
# pin the graph's refusals, the Kahn primitive, labels and trait defaults.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# komira_collections and komira_log, sibling packages (`[dependencies]` of mopm.toml): its `:lib` is
# built from their `:lib`. `test_data` stages the library's two sources the public-API test reads,
# at lib/ in the test's working directory (buildrules docs/contract.md, 12.9).
mojo_package(
    path = ".",
    test_data = {
        "tests/test_erased_resource_public_api.mojo": {
            "lib/__init__.mojo": "src/kci_reconciler/__init__.mojo",
            "lib/erased_resource.mojo": "src/kci_reconciler/erased_resource.mojo",
        },
    },
)

# `:kci_reconciler`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages: the rule refuses a list that is not the closure `:lib` was built from. It carries the
# README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "kci_reconciler",
    deps = [
        "//src/komira_collections:komira_collections",
        "//src/komira_log:komira_log",
    ],
    # komira_libc and komira_log link C (the posix shim, the log holder), so `lib`'s closure carries
    # those archives and a dependent's link takes them from here. This package owns no C, so it names
    # no `c_deps`: it takes the C toolchain's link facts directly.
    cxx_toolchain = "komira//tools/build/mojo:adopt_cxx_link_facts",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_reconciler/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_reconciler-0.1.0-mojo1.0.0_0.conda`), which records komira_collections and komira_log as
# dependencies (`mojo-<name> >=0.1,<0.2`) and holds none of their files. `members` is the manifests
# of the path dependencies of the closure, staged at their repository paths, because `mopm pack`
# reads the manifest of each beside the one it is given. `:lib` exists only once the tests passed,
# so this file exists only then. Publishing it (`mopm publish`) uploads, which is not a build
# action: it is a step of a CI job that takes this target's output. `mopm` is the one `mojo_package`
# pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/kci_reconciler",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_atomic_alias": "//src/komira_atomic_alias:mopm.toml",
        "../komira_clock": "//src/komira_clock:mopm.toml",
        "../komira_collections": "//src/komira_collections:mopm.toml",
        "../komira_hash": "//src/komira_hash:mopm.toml",
        "../komira_libc": "//src/komira_libc:mopm.toml",
        "../komira_log": "//src/komira_log:mopm.toml",
        "../komira_metrics": "//src/komira_metrics:mopm.toml",
        "../komira_name_registry": "//src/komira_name_registry:mopm.toml",
        "../komira_spsc_ring": "//src/komira_spsc_ring:mopm.toml",
        "../komira_trace": "//src/komira_trace:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_reconciler",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/`, and exactly two dependencies, which is what
# installing the package pulls in. Red when the manifest drops a dependency, names another range, or
# the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_collections >=0.1,<0.2",
        "mojo-komira_log >=0.1,<0.2",
    ],
    package = "kci_reconciler",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_reconciler`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_reconciler_conda",
    lib = ":kci_reconciler",
    summary = "The `kci_reconciler` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
