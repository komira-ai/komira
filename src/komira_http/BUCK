load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# HTTP/1.1 and HTTP/2 for Mojo, client and server, over the komira_async
# reactor: the transport layer (plain TCP and a scripted fake), TLS over
# s2n-tls, the h1 and h2 codecs (HPACK included), the middleware chain, a
# router, the pooled client with its retry, redirect and timeout layers, and a
# serverless entry point. s2n-tls (which carries aws-lc's libcrypto) is a dep
# because the TLS layer declares its functions itself. komira_runtime_paths is
# declared because two tests take their scratch directory from `test_tmpdir()`.
#
# The TLS tests read the throwaway certificates under tests/fixtures; the h2
# corpus test reads tests/fuzz_corpus; three source-census tests read the
# library files whose shape they pin.

mojo_library(
