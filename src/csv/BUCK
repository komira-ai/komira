load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The CSV reader and writer: RFC 4180 / Excel / POSIX quote styles, the
# SIMD structural scanner (byte-class masks and carry-less-multiply quote
# regions), quote-safe chunk splitting, typed cell parsers and column
# builders, schema sampling and type inference, the parallel reader on the
# async_rt dispatcher, the CSV sink, and the CSV options of a COPY with the
# DuckDB DATEFORMAT / TIMESTAMPFORMAT writer (csv_write_dialect,
# csv_temporal_format). It depends on the core packages
# (Arrow types, record batches, SIMD byte classes), row_format (the row
# format the sink drains) and async_rt (the dispatcher, cancellation
# and the local filesystem). runtime_paths is declared because two
# tests take their scratch directory from `test_tmpdir()`.
mojo_library(
    name = "csv",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/arrow_ipc:arrow_ipc",
        "//src/async_rt:async_rt",
        "//src/async_api:async_api",
        "//src/byte_buffer:byte_buffer",
        "//src/containers:containers",
        "//src/fs:fs",
        "//src/row_format:row_format",
        "//src/scan_source:scan_source",
        "//src/simd_ops:simd_ops",
        "//tools/build/mojo/runtime_paths:runtime_paths",
    ],
    test_srcs = [
        "tests/test_byte_span_numeric_parsers.mojo",
        "tests/test_csv_blank_lines.mojo",
        "tests/test_csv_cell_parsers.mojo",
        "tests/test_csv_cell_parsers_wire_to_builders.mojo",
        "tests/test_csv_dtype_completion.mojo",
        "tests/test_csv_header_non_ascii.mojo",
        "tests/test_csv_header_only.mojo",
        "tests/test_csv_parallel_reader_default_workers.mojo",
        "tests/test_csv_parallel_reader_dispatcher_arm.mojo",
        "tests/test_csv_parallel_reader_header.mojo",
        "tests/test_csv_parallel_reader_multi_worker.mojo",
        "tests/test_csv_parallel_reader_one_worker.mojo",
        "tests/test_csv_parallel_reader_quote_carry.mojo",
        "tests/test_csv_parallel_reader_quoted_rows.mojo",
        "tests/test_csv_phase_4_column_parallel_concat_bool.mojo",
        "tests/test_csv_phase_4_column_parallel_concat_fixed_width.mojo",
        "tests/test_csv_phase_4_column_parallel_concat_many_workers.mojo",
        "tests/test_csv_phase_4_column_parallel_concat_strings.mojo",
        "tests/test_csv_phase_4_column_parallel_concat_wide_schema.mojo",
        "tests/test_csv_phase_b.mojo",
        "tests/test_csv_q_chassis_wiring.mojo",
        "tests/test_csv_quote_safe_chunk_split.mojo",
        "tests/test_csv_reader_e2e.mojo",
        "tests/test_csv_record_shape.mojo",
        "tests/test_csv_record_shape_edges.mojo",
        "tests/test_csv_record_shape_parallel.mojo",
        "tests/test_csv_scanner_flat_cells.mojo",
        "tests/test_csv_scanner_phase1.mojo",
        "tests/test_csv_scanner_phase2_movemask.mojo",
        "tests/test_csv_scanner_phase3_pclmulqdq.mojo",
        "tests/test_csv_scanner_rows_quote_violation.mojo",
        "tests/test_csv_schema_sample_inference.mojo",
        "tests/test_csv_simd_cell_parsers.mojo",
        "tests/test_csv_simd_int_column.mojo",
        "tests/test_csv_simd_string_column.mojo",
        "tests/test_csv_simd_temporal_parsers.mojo",
        "tests/test_csv_sink_quoting.mojo",
        "tests/test_csv_temporal_format.mojo",
        "tests/test_csv_temporal_range.mojo",
        "tests/test_csv_typed_column_builders.mojo",
        "tests/test_csv_write_dialect.mojo",
        "tests/test_phase_4_stage_breakdown_default_off.mojo",
        "tests/test_phase_4_stage_breakdown_mixed_parity.mojo",
        "tests/test_phase_4_stage_breakdown_string_parity.mojo",
        "tests/test_phase_4_stage_breakdown_timed_parity.mojo",
        "tests/test_simd_row_boundary_scan.mojo",
    ],
    visibility = ["PUBLIC"],
)
