load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The artifact manifest: one JSON object per package file, saying what the
# file is (artifact type, name, version, platform subdir) and its sha256.
# The build that makes a package writes it; the BUILD step checks it and copies
# it next to the package; the PUBLISH step reads it to decide what to upload.
# One format, parsed and written here, so the two steps cannot drift apart.
#
# The welded tests parse and render synthetic manifests in memory and assert
# each refusal by its message; test_read_artifact_manifest also reads files
# it writes under the run's TEST_TMPDIR. No network.
mojo_library(
    name = "kci_artifact_manifest",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_api:kci_api",
        "//src/kci_release_channel:kci_release_channel",
        "//src/komira_json:komira_json",
    ],
    test_srcs = [
        "tests/test_artifact_manifest.mojo",
        "tests/test_read_artifact_manifest.mojo",
    ],
    visibility = ["PUBLIC"],
)
