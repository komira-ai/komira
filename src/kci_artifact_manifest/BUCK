load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The artifact manifest: one JSON object per package file, saying what the
# file is (artifact type, name, version, platform subdir) and its sha256.
# The build that makes a package writes it; the BUILD step checks it and copies
# it next to the package; the PUBLISH step reads it to decide what to upload.
# One format, parsed and written here, so the two steps cannot drift apart.
#
# The welded tests parse and render synthetic manifests in memory and assert
# each refusal by its message; test_read_artifact_manifest also reads files
# it writes under the run's TEST_TMPDIR. No network.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on kci_api,
# kci_release_channel and komira_json, sibling packages (`[dependencies]` of mopm.toml): its `:lib`
# is built from those packages' `:lib`.
# test_read_artifact_manifest writes under the test's private directory (`test_tmpdir`,
# TEST_TMPDIR). Only the installed layout gives the branch-coverage run one.
mojo_package(
    path = ".",
    test_layout = "installed",
)

# `:kci_artifact_manifest`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are
# not run again.
mojo_adopted_library(
    name = "kci_artifact_manifest",
    deps = [
        "//src/kci_api:kci_api",
        "//src/kci_release_channel:kci_release_channel",
        "//src/komira_json:komira_json",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_artifact_manifest/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_artifact_manifest-0.1.0-mojo1.0.0_0.conda`), which records kci_api, kci_release_channel
# and komira_json as dependencies (`mojo-kci_api >=0.1,<0.2`, `mojo-kci_release_channel >=0.1,<0.2`
# and `mojo-komira_json >=0.1,<0.2`) and holds those packages' files nowhere. `members` is the
# manifests of the path dependencies, staged at their repository paths, because `mopm pack` reads
# the manifest of each beside the one it is given. `:lib` exists only once the tests passed, so this
# file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is
# a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/kci_artifact_manifest",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../kci_api": "//src/kci_api:mopm.toml",
        "../kci_release_channel": "//src/kci_release_channel:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_textproto": "//src/komira_textproto:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_artifact_manifest",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/` (kci_api, kci_release_channel and komira_json are
# not in it), and exactly 3 dependencies, `mojo-kci_api >=0.1,<0.2`, `mojo-kci_release_channel
# >=0.1,<0.2` and `mojo-komira_json >=0.1,<0.2`, which is what installing the package pulls in. Red
# when the manifest drops a dependency, names another range, or the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-kci_api >=0.1,<0.2",
        "mojo-kci_release_channel >=0.1,<0.2",
        "mojo-komira_json >=0.1,<0.2",
    ],
    package = "kci_artifact_manifest",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_artifact_manifest`. It goes when the release machine takes the
# mopm package. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_artifact_manifest_conda",
    lib = ":kci_artifact_manifest",
    summary = "The `kci_artifact_manifest` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
