load("@komira//third_party/botocore:models.bzl", "botocore_model")
load("@komira//tools/build/cloud:aws.bzl", "aws_client")

# Amazon S3: a restXml client generated at build time from botocore's S3
# model (//third_party/botocore, pinned by sha256; nothing of it is copied
# here), in pure mode: each operation's request builder and response
# parser, and its endpoint resolved through S3's published endpoint ruleset
# and partition table, embedded in the module. No transport; a caller signs
# a built request with komira_aws_core's build_sigv4_signed_request.
#
# The `s3` customization applies what botocore does to S3 beyond the model:
# a 200 whose body is an <Error> is raised as an HTTP 500 is, an `Expires`
# header that is not a date is left unset, and the bucket is left to the
# endpoint ruleset, which puts it in the host or in the endpoint's path.
# Addressing follows the ruleset: virtual host unless the bucket cannot be a
# host name or `S3EndpointConfig.force_path_style` is set, which a caller
# of a custom endpoint (LocalStack, MinIO) sets.
#
# `operations` is every S3 operation the generator emits. The others are
# refused by the generator, by name, and are not listed: the operations
# that require a request checksum (`checksum-required`: DeleteObjects,
# PutBucket*, PutObjectAcl, PutObjectTagging and the like; the client sends
# no checksum), those reading `Grantee`'s XML attribute (`xml-attribute`:
# GetBucketAcl, GetBucketLogging, GetObjectAcl, RestoreObject),
# SelectObjectContent (`eventstream`) and WriteGetObjectResponse
# (`host-prefix`).
#
# The library is gated by its layout probe and these tests, hand-written
# against the S3 API reference (no upstream test body is copied):
# test_s3_requests (the requests the engine's operations build, exactly),
# test_s3_responses (their responses, the 200-with-<Error> case and the
# error forms), test_s3_endpoints (virtual-host and path-style addressing,
# a custom endpoint, and the signed request, against the signatures AWS
# publishes for its SigV4 examples) and test_no_env_reads (the generated
# module reads no environment).

_S3 = botocore_model("s3")

aws_client(
    name = "komira_aws_s3",
    customizations = ["s3"],
    endpoint_rules = _S3.endpoint_rules,
    mode = "pure",
    model = _S3.model,
    model_sha256 = _S3.sha256,
    operations = [
        "AbortMultipartUpload",
        "CompleteMultipartUpload",
        "CopyObject",
        "CreateBucket",
        "CreateMultipartUpload",
        "CreateSession",
        "DeleteBucket",
        "DeleteBucketAnalyticsConfiguration",
        "DeleteBucketCors",
        "DeleteBucketEncryption",
        "DeleteBucketIntelligentTieringConfiguration",
        "DeleteBucketInventoryConfiguration",
        "DeleteBucketLifecycle",
        "DeleteBucketMetadataConfiguration",
        "DeleteBucketMetadataTableConfiguration",
        "DeleteBucketMetricsConfiguration",
        "DeleteBucketOwnershipControls",
        "DeleteBucketPolicy",
        "DeleteBucketReplication",
        "DeleteBucketTagging",
        "DeleteBucketWebsite",
        "DeleteObject",
        "DeleteObjectAnnotation",
        "DeleteObjectTagging",
        "DeletePublicAccessBlock",
        "GetBucketAbac",
        "GetBucketAccelerateConfiguration",
        "GetBucketAnalyticsConfiguration",
        "GetBucketCors",
        "GetBucketEncryption",
        "GetBucketIntelligentTieringConfiguration",
        "GetBucketInventoryConfiguration",
        "GetBucketLifecycle",
        "GetBucketLifecycleConfiguration",
        "GetBucketLocation",
        "GetBucketMetadataConfiguration",
        "GetBucketMetadataTableConfiguration",
        "GetBucketMetricsConfiguration",
        "GetBucketNotification",
        "GetBucketNotificationConfiguration",
        "GetBucketOwnershipControls",
        "GetBucketPolicy",
        "GetBucketPolicyStatus",
        "GetBucketReplication",
        "GetBucketRequestPayment",
        "GetBucketTagging",
        "GetBucketVersioning",
        "GetBucketWebsite",
        "GetObject",
        "GetObjectAnnotation",
        "GetObjectAttributes",
        "GetObjectLegalHold",
        "GetObjectLockConfiguration",
        "GetObjectRetention",
        "GetObjectTagging",
        "GetObjectTorrent",
        "GetPublicAccessBlock",
        "HeadBucket",
        "HeadObject",
        "ListBucketAnalyticsConfigurations",
        "ListBucketIntelligentTieringConfigurations",
        "ListBucketInventoryConfigurations",
        "ListBucketMetricsConfigurations",
        "ListBuckets",
        "ListDirectoryBuckets",
        "ListMultipartUploads",
        "ListObjectAnnotations",
        "ListObjectVersions",
        "ListObjects",
        "ListObjectsV2",
        "ListParts",
        "PutBucketAbac",
        "PutBucketAccelerateConfiguration",
        "PutBucketAnalyticsConfiguration",
        "PutBucketIntelligentTieringConfiguration",
        "PutBucketInventoryConfiguration",
        "PutBucketMetricsConfiguration",
        "PutBucketNotificationConfiguration",
        "PutObject",
        "PutObjectAnnotation",
        "RenameObject",
        "UploadPart",
        "UploadPartCopy",
    ],
    partitions = _S3.partitions,
    test_data = {
        "tests/test_no_env_reads.mojo": {
            "gen/" + f: ":komira_aws_s3_gen[{}]".format(f)
            for f in ["__init__.mojo", "_layout_probe.mojo", "komira_aws_s3.mojo"]
        },
    },
    test_srcs = [
        "tests/test_no_env_reads.mojo",
        "tests/test_s3_endpoints.mojo",
        "tests/test_s3_requests.mojo",
        "tests/test_s3_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_xml:komira_xml",
    ],
)
