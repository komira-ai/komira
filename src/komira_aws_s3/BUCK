load("@komira//third_party/botocore:models.bzl", "botocore_model")
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon S3: a restXml client generated at build time from botocore's S3
# model (//third_party/botocore, pinned by sha256; nothing of it is copied
# here), in client mode: each operation's request builder and response
# parser, its endpoint resolved through S3's published endpoint ruleset
# and partition table, embedded in the module, and `S3Client`, whose
# verbs resolve that endpoint per call and send through komira_aws_core's
# send_sigv4_signed_request (signed per attempt, retried as the AWS SDKs'
# standard mode does) over the komira_http_core Connector it is given. The
# builders, parsers and resolvers stay exported for a caller with its own
# transport.
#
# The `s3` customization applies what botocore does to S3 beyond the model:
# a 200 whose body is an <Error> is raised as an HTTP 500, an `Expires`
# header that is not a date is left unset, an operation whose model names a
# checksum algorithm member sends the CRC32 request checksum current AWS
# SDKs send there (by default on PutObject and UploadPart, and always on
# DeleteObjects, which requires one), and the bucket is left to the
# endpoint ruleset, which puts it in the host or in the endpoint's path.
# Addressing follows the ruleset: virtual host unless the bucket cannot be a
# host name or `S3EndpointConfig.force_path_style` is set, which a caller
# of a custom endpoint (LocalStack, MinIO) sets.
#
# `operations` is the operations an object store needs, each with its own
# rows in the tests below; an operation joins the list with its tests. Of
# S3's other operations, the generator refuses by name those reading
# `Grantee`'s XML attribute (`xml-attribute`: GetBucketAcl,
# GetBucketLogging, GetObjectAcl, RestoreObject) and SelectObjectContent
# (`eventstream`).
#
# Left to the caller, which botocore does for S3 in handlers beyond the
# model: SSE-C (`SSECustomerKey` is sent as given, so a caller passes it
# base64-encoded and sets `SSECustomerKeyMD5`; botocore's `sse_md5` does
# both), and `x-amz-meta-*` values, which must be ASCII (botocore's
# `validate_ascii_metadata` refuses others; here only CR and LF are).
#
# The library is gated by its layout probe and these tests, hand-written
# against the S3 API reference (no upstream test body is copied):
# test_s3_requests (the requests the engine's operations build, exactly),
# test_s3_responses (their responses, the 200-with-<Error> case and the
# error forms), test_s3_endpoints (virtual-host and path-style addressing, a
# custom endpoint, and the signed request of each HTTP method, against the
# signatures AWS publishes for its SigV4 examples where one exists) and
# _no_env_reads (written by mojo_aws_client: the package reads no
# environment). Two more send through komira_http_client over a scripted
# connector (no socket): test_s3_client drives the generated client verb by
# verb (a 412 race, a 206 range read, two list pages, a multipart upload, an
# abort 404, a HEAD 404, and each verb's request as it reached the wire,
# through komira_aws_core's AwsEchoConnector, and the verbs over injected
# seams, `<op>_with`), and test_s3_retry drives the same send with a
# recording sleeper and a stepping clock (a 503 retried and signed again at
# a later date, the attempt limit, a 200-with-<Error> retried, and the POSTs
# resent as botocore resends them).

_S3 = botocore_model("s3")

mojo_aws_client(
    name = "komira_aws_s3",
    customizations = ["s3"],
    endpoint_rules = _S3.endpoint_rules,
    mode = "client",
    model = _S3.model,
    model_sha256 = _S3.sha256,
    operations = [
        "AbortMultipartUpload",
        "CompleteMultipartUpload",
        "CopyObject",
        "CreateMultipartUpload",
        "DeleteObject",
        "DeleteObjects",
        "GetObject",
        "HeadObject",
        "ListBuckets",
        "ListObjects",
        "ListObjectsV2",
        "PutObject",
        "UploadPart",
    ],
    partitions = _S3.partitions,
    test_srcs = [
        "tests/test_s3_client.mojo",
        "tests/test_s3_endpoints.mojo",
        "tests/test_s3_requests.mojo",
        "tests/test_s3_responses.mojo",
        "tests/test_s3_retry.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        # The client's `send_with` and `<op>_with` take a komira_retry loop.
        "//src/komira_retry:komira_retry",
        "//src/komira_xml:komira_xml",
    ],
)
