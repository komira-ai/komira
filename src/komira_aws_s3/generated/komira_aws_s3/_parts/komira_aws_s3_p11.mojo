def komira_aws_s3_endpoint_rules() raises -> EndpointRuleSet:
    """The service's endpoint ruleset over the partition table, loaded and
        checked. Loading parses both documents: load once, resolve many."""
    return EndpointRuleSet(
        String(S3_ENDPOINT_RULESET), AwsPartitionSet(String(S3_PARTITIONS))
    )


struct S3EndpointConfig(Copyable, Movable):
    """The endpoint ruleset's client-level parameters: its built-ins and the
        model's clientContextParams. Every field is unset until a caller sets it,
        and an unset one takes the ruleset's default. Nothing here reads the
        environment.

        A custom `endpoint` keeps the ruleset's addressing: with `force_path_style`
        unset, a bucket that can be a host name is addressed by virtual host on
        the custom endpoint too, as the AWS SDKs for Rust and Java v2 do. A
        caller that needs path-style addressing sets `force_path_style = True`.
        """

    # `Region` (built-in AWS::Region)
    var region: Optional[String]
    # `UseFIPS` (built-in AWS::UseFIPS)
    var use_fips: Optional[Bool]
    # `UseDualStack` (built-in AWS::UseDualStack)
    var use_dual_stack: Optional[Bool]
    # `Endpoint` (built-in SDK::Endpoint)
    var endpoint: Optional[String]
    # `ForcePathStyle` (built-in AWS::S3::ForcePathStyle; clientContextParams)
    var force_path_style: Optional[Bool]
    # `Accelerate` (built-in AWS::S3::Accelerate; clientContextParams)
    var accelerate: Optional[Bool]
    # `UseGlobalEndpoint` (built-in AWS::S3::UseGlobalEndpoint)
    var use_global_endpoint: Optional[Bool]
    # `DisableMultiRegionAccessPoints` (built-in AWS::S3::DisableMultiRegionAccessPoints; clientContextParams)
    var disable_multi_region_access_points: Optional[Bool]
    # `UseArnRegion` (built-in AWS::S3::UseArnRegion; clientContextParams)
    var use_arn_region: Optional[Bool]
    # `DisableS3ExpressSessionAuth` (clientContextParams)
    var disable_s3_express_session_auth: Optional[Bool]

    def __init__(out self):
        """Every parameter unset."""
        self.region = Optional[String]()
        self.use_fips = Optional[Bool]()
        self.use_dual_stack = Optional[Bool]()
        self.endpoint = Optional[String]()
        self.force_path_style = Optional[Bool]()
        self.accelerate = Optional[Bool]()
        self.use_global_endpoint = Optional[Bool]()
        self.disable_multi_region_access_points = Optional[Bool]()
        self.use_arn_region = Optional[Bool]()
        self.disable_s3_express_session_auth = Optional[Bool]()

    def __init__(out self, region: String):
        """Every parameter unset but `region`, which "" leaves unset too."""
        self = Self()
        if region.byte_length() > 0:
            self.region = Optional[String](region)

    def endpoint_params(self) -> EndpointParams:
        """The ruleset parameters this configuration sets."""
        var params = EndpointParams()
        if self.region:
            params.set_string(String("Region"), self.region.value())
        if self.use_fips:
            params.set_bool(String("UseFIPS"), self.use_fips.value())
        if self.use_dual_stack:
            params.set_bool(String("UseDualStack"), self.use_dual_stack.value())
        if self.endpoint:
            params.set_string(String("Endpoint"), self.endpoint.value())
        if self.force_path_style:
            params.set_bool(String("ForcePathStyle"), self.force_path_style.value())
        if self.accelerate:
            params.set_bool(String("Accelerate"), self.accelerate.value())
        if self.use_global_endpoint:
            params.set_bool(String("UseGlobalEndpoint"), self.use_global_endpoint.value())
        if self.disable_multi_region_access_points:
            params.set_bool(String("DisableMultiRegionAccessPoints"), self.disable_multi_region_access_points.value())
        if self.use_arn_region:
            params.set_bool(String("UseArnRegion"), self.use_arn_region.value())
        if self.disable_s3_express_session_auth:
            params.set_bool(String("DisableS3ExpressSessionAuth"), self.disable_s3_express_session_auth.value())
        return params^


def resolve_abort_multipart_upload_endpoint(rules: EndpointRuleSet, config: S3EndpointConfig, input: S3AbortMultipartUploadRequest) raises -> ResolvedEndpoint:
    """`AbortMultipartUpload` — the endpoint the ruleset chooses for this call: its URL,
        headers and properties (`authSchemes` says how to sign). An `error`
        rule's answer is raised with the ruleset's message."""
    var params = config.endpoint_params()
    params.set_string(String("Bucket"), input.bucket)
    params.set_string(String("Key"), input.key)
    var outcome = rules.resolve(params)
    if outcome.is_error:
        raise Error(
            String("komira_aws_s3: the endpoint ruleset chose no endpoint for AbortMultipartUpload: ") + outcome.error
        )
    return outcome.endpoint.copy()

