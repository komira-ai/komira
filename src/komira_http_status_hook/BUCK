load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The one MetricsSink that POSTs usage with HttpClient: the only piece that
# needs both the client and the server. Its test reads the server's
# middleware/metrics.mojo (exported there) and its own file, whose shape it pins.

mojo_library(
    name = "komira_http_status_hook",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_http_server:komira_http_server",
    ],
    test_srcs = [
        "tests/test_L3_metrics_sink_and_status_hook.mojo",
    ],
    test_data = {
        "tests/test_L3_metrics_sink_and_status_hook.mojo": {
            "src/komira_http_server/middleware/metrics.mojo": "//src/komira_http_server:middleware/metrics.mojo",
            "src/komira_http_status_hook/status_hook.mojo": "status_hook.mojo",
        },
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps), so a missing dep fails here, in review, and
# not only in the compile.
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
)
