load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The artifact declarations schema (`kci.release.v1`): the reviewed list of
# what kci builds and publishes. Each artifact is a name, the channels it may
# go to, and one typed kind arm (conda package, conda metapackage, Python
# wheel, OCI image) holding that kind's build rule and fields. Standalone:
# the .proto imports no other proto.
#
#   from kci_artifact_declaration_proto.artifact_declaration import (
#       ArtifactDeclarations, ArtifactDeclaration, BuildRule, Buck2Target,
#       CondaPackage, CondaMetapackage, PythonWheel, OciImage)
#
# Reading and validating a declarations file is `//src/kci_artifact_declaration`,
# whose welded tests also round-trip this schema on the proto binary wire.
# Other `.proto` files import it as `kci/release/v1/artifact_declaration.proto`.
mojo_proto_library(
    name = "kci_artifact_declaration_proto",
    srcs = ["artifact_declaration.proto"],
    import_prefix = "kci/release/v1",
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    visibility = ["PUBLIC"],
)
