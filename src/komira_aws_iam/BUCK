load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# AWS Identity and Access Management: an awsQuery client generated at build
# time from botocore's iam model (//third_party/botocore, pinned by sha256;
# nothing of it is copied here), in client mode: each operation's request
# builder (a form body) and response parser (its <OpResult> element), its
# endpoint resolved through IAM's published endpoint ruleset and partition
# table, embedded in the module, and `IAMClient`, which resolves each
# call's endpoint and sends through komira_aws_core's
# send_sigv4_signed_request (signing name `iam`) over the komira_http_core
# Connector it is given. Every IAM operation is a POST, and a call is
# retried as botocore's standard mode retries it (komira_aws_core's
# aws_retry.mojo).
#
# IAM is a global service. In the aws partition every region resolves to
# https://iam.amazonaws.com, and the ruleset's `authSchemes` signs it for
# us-east-1 whatever region the client is in; the client signs for the
# region the ruleset states (aws_signing_target), so a client built for
# eu-west-1 needs nothing set to reach IAM (test_iam_endpoints,
# test_iam_client).
#
# A policy document in a response (GetRolePolicy, a role's
# AssumeRolePolicyDocument) is returned as IAM sends it, percent-encoded:
# botocore decodes it in a handler of its own, not in its parser.
#
# `operations` covers users, roles and OIDC providers: a user given an
# access key and an inline policy; a role created, read, retrusted, given,
# listed and relieved of inline policies, tagged and deleted; an OIDC
# provider read and its client ids added and removed. The generator refuses
# none of them. An operation joins the list with its own rows in the tests
# below.
#
# The library is gated by its layout probe and these tests, hand-written
# against the IAM API reference (no upstream test body is copied):
# test_iam_requests (the form body each operation builds, exactly),
# test_iam_responses (each result read from its wrapper, and the
# <ErrorResponse> read through komira_aws_core), test_iam_endpoints
# (botocore's endpoint cases for iam through every operation's resolver,
# each case's signing region checked; a regional caller sent to the global
# endpoint and signing for us-east-1; FIPS, dual-stack and LocalStack; and
# two requests signed end to end against independently computed
# signatures), _no_env_reads (written by mojo_aws_client: the package reads
# no environment) and test_iam_client (the generated client over a scripted
# connector, a missing role raised under its code, the request as it
# reached the wire through komira_aws_core's AwsEchoConnector, and a
# eu-west-1 client's CreateUser sent to the global endpoint and signed for
# us-east-1).
#
# No test here talks to the service.

_IAM = botocore_model("iam")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("iam")

mojo_aws_client(
    name = "komira_aws_iam",
    endpoint_rules = _IAM.endpoint_rules,
    mode = "client",
    model = _IAM.model,
    model_sha256 = _IAM.sha256,
    operations = [
        "AddClientIDToOpenIDConnectProvider",
        "CreateAccessKey",
        "CreateRole",
        "CreateUser",
        "DeleteRole",
        "DeleteRolePolicy",
        "GetOpenIDConnectProvider",
        "GetRole",
        "GetRolePolicy",
        "ListRolePolicies",
        "PutRolePolicy",
        "PutUserPolicy",
        "RemoveClientIDFromOpenIDConnectProvider",
        "TagRole",
        "UpdateAssumeRolePolicy",
    ],
    partitions = _IAM.partitions,
    test_data = {
        "tests/test_iam_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_iam_client.mojo",
        "tests/test_iam_endpoints.mojo",
        "tests/test_iam_requests.mojo",
        "tests/test_iam_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        # test_iam_endpoints reads botocore's endpoint cases with it.
        "//src/komira_json:komira_json",
        # The client's `send_with` takes a komira_retry loop.
        "//src/komira_retry:komira_retry",
        "//src/komira_xml:komira_xml",
    ],
)
