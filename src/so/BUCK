# The shared libraries of the C code the library owns; libkomira links each as
# NEEDED, and the C driver below stages the same ones beside it.
NATIVE_OWNERS = [
    "//src/async_rt:komira_async_native",
    "//src/async_api:komira_async_api_native",
    "//src/compression:komira_compression_native",
    "//src/crypto:komira_crypto_native",
