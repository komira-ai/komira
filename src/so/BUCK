# libkomira.so (libkomira.dylib on macOS arm64): fifteen exports, and nothing else
# in the dynamic symbol table (`exports_exact`). Every context it creates owns
# an engine (sdk_exec's EngineContext) whose workers start in komira_ctx_new.
# komira_sql_stream runs SQL on that engine and answers an Arrow C stream; the
# C driver below (c_abi_check) reads those streams through komira.h.
# It is published only if every gate driver passes, each of which dlopens it
# with RTLD_NOW and calls it as a foreign host would:
#   gate_version       the version is 1004 (1.4);
#   gate_new_free      handles are non-NULL, distinct and hold separate sessions,
#                      freeing NULL is a no-op, and a context (with its
#                      engine's workers) is created and freed again;
#   gate_no_extra_exports  the linker's section markers and the Mojo helpers
#                      are not in the symbol table;
#   gate_fresh_error   a fresh session's error is empty, with or without a buffer;
#   gate_two_call      capacity 0 and one byte short give -4 and the length, an
#                      exact and a larger buffer give the text, nothing past it;
#   gate_null_ctx      a NULL context is -1 and writes nothing;
#   gate_null_out_len  a NULL out_len is -2 and writes nothing;
#   gate_register_parquet  a Parquet file is registered by name; NULL ctx -1,
#                      NULL name or path -2, a missing or non-Parquet file -3
#                      with the reader's message as the last error;
#   gate_native_owners (Linux) the library's DT_NEEDED entries (ELF dynamic
#                      section) name each native_owners SONAME; an owner
#                      dropped from the list is embedded silently and fails
#                      here;
#   gate_parquet_schema, gate_csv_binding, gate_json_binding, gate_plan_render
#                      a good input through the two-call protocol, NULL ctx -1,
#                      NULL input or out_len -2, a bad file or plan -3 with a
#                      last error, and a good call afterwards leaves no error.
#   gate_plan_render also: plan_len 64 MiB plus one and UINT64_MAX are -5 with
#                      nothing written and no read of the plan; exactly 64 MiB
#                      is read (garbage, so -3). gate_parquet_schema also: a
#                      path that is not UTF-8 is -3 with a last error.
#   gate_register_csv, gate_register_json  a file is registered by name (CSV:
#                      for each dialect argument); a name already taken, in
#                      any case and by either call, is -3 with
#                      TABLE_ALREADY_REGISTERED and an empty one -3 with
#                      TABLE_NAME_EMPTY, word for word; NULL ctx -1, NULL name
#                      or path -2 with the named last error; a missing or
#                      empty file and a path that is not UTF-8 -3; a refused
#                      name stays free and a good call afterwards leaves no
#                      error.
#   gate_credentials  a credential added, set and sealed is 0 at each step;
#                      one sealed without its secret, a field of another
#                      kind, an empty value, a 4097-byte value, an unknown
#                      kind, `ambient`, a malformed name, a name that is not
#                      UTF-8 and a scope other than the session are
#                      -3 with the named error word for word; NULL ctx -1,
#                      NULL name, out_id or value (length non-zero) -2 with
#                      the id slot untouched; value_len 64 MiB plus one -5.
_LIBKOMIRA = dict(
    srcs = ["_c_abi.mojo"],
    out_name = "libkomira",
    exports = [
        "komira_abi_version",
        "komira_ctx_new",
        "komira_ctx_free",
        "komira_last_error",
        "komira_register_parquet",
        "komira_parquet_schema",
        "komira_csv_binding",
        "komira_json_binding",
        "komira_plan_render",
        "komira_credential_add",
        "komira_credential_set",
        "komira_credential_seal",
        "komira_sql_stream",
        "komira_register_csv",
        "komira_register_json",
    ],
    exports_exact = True,
    gate_srcs = [
        "tests/gate/gate_credentials.mojo",
        "tests/gate/gate_fresh_error.mojo",
        "tests/gate/gate_new_free.mojo",
        "tests/gate/gate_no_extra_exports.mojo",
        "tests/gate/gate_null_ctx.mojo",
        "tests/gate/gate_null_out_len.mojo",
        "tests/gate/gate_csv_binding.mojo",
        "tests/gate/gate_json_binding.mojo",
        "tests/gate/gate_parquet_schema.mojo",
        "tests/gate/gate_plan_render.mojo",
        "tests/gate/gate_register_csv.mojo",
        "tests/gate/gate_register_json.mojo",
        "tests/gate/gate_register_parquet.mojo",
        "tests/gate/gate_two_call.mojo",
        "tests/gate/gate_version.mojo",
    ] + select({
        "DEFAULT": ["tests/gate/gate_native_owners.mojo"],
        "prelude//os/constraints:macos": [],
    }),
    deps = [":so"],
    # macOS arm64: no owner libraries. A native owner is an ELF shared
    # library (tools/build/native/shared.bzl); on macOS the C archives of the
    # closure are linked into libkomira.dylib, whose exported symbols list
    # keeps them out of its ABI, and gate_native_owners, which reads the ELF
    # dynamic section, is not one of its gates.
    native_owners = select({
        "DEFAULT": NATIVE_OWNERS,
        "prelude//os/constraints:macos": [],
    }),
)

mojo_shared_lib(
    name = "libkomira",
    visibility = ["komira//ci:", "komira//tools/build/package/libkomira:", "//node:", "//python:", "//python/tests:"],
    **_LIBKOMIRA
)

# One more link of the same library per CPU level linux x86_64 ships it at
# (`isa_variants` of the platform row, tools/build/platforms/isa_variants.bzl):
# `:libkomira_x86_64_v2` and `:libkomira_x86_64_v3`, each behind the same gate
# as `:libkomira`, its drivers built for that level. Each names its toolchain,
# whose CPU is the level's; the `.mojoc` of `:so` and its closure are the ones
# every other target reads (a `.mojoc` holds no machine code). The floor is
# installed at the plain path of the native directory and keeps the run path of
# `:libkomira`; every other level is installed at `variants/<level>/` and also
# looks in `$ORIGIN/../../lib`, the directory's one lib/
# (//tools/build/package/libkomira:libkomira_variants).
[
    mojo_shared_lib(
        name = "libkomira_" + variant_label_name(v),
        toolchain = variant_toolchain(v),
        extra_runpath = [] if v == floor_variant(row("linux-x86_64")) else ["$ORIGIN/../../lib"],
        visibility = ["komira//tools/build/package/libkomira:"],
        **_LIBKOMIRA
    )
    for v in row("linux-x86_64")["isa_variants"]
]

# The Parquet file the C-ABI gates and the Node and Python bindings' tests read.
export_file(
    name = "tests/fixtures/two_columns.parquet",
    src = "tests/fixtures/two_columns.parquet",
    visibility = ["komira//ci:", "//node:", "//python:", "//python/tests:"],
)

# The ABI golden, read by the Python package's install test (python/BUCK,
# wheel_install_test), which holds komira.abi_version() of the installed
# library to its `version` line, and by the install page's check
# (python/smoke/BUCK, install_page_shows_quickstart), which holds the
# output the page shows to it.
export_file(
    name = "abi/komira.tsv",
    src = "abi/komira.tsv",
    visibility = ["//python:", "//python/smoke:"],
)

# The C header of libkomira, komira.h, made from abi/komira.tsv (the golden:
# every export with its return and argument types and the version that added
# it, and every status code and limit). It builds only while the golden is
# exactly the `@export abi("C")` functions of _c_abi.mojo with the same types,
# and the constants of status.mojo with the same values. Adding an export, or
# changing a type or a constant, without the golden is a red build here.
komira_abi_golden(
    name = "komira_abi",
    src = "_c_abi.mojo",
    constants_src = "status.mojo",
    golden = "abi/komira.tsv",
    header_name = "komira.h",
    visibility = ["PUBLIC"],
)

staged_files(
    name = "c_driver_files",
    srcs = ["tests/c/abi_driver.c"],
)

# A C host of libkomira that includes komira.h and nothing else of ours.
cxx_binary(
    name = "abi_driver",
    srcs = [":c_driver_files[tests/c/abi_driver.c]"],
    headers = {"komira.h": ":komira_abi"},
    header_namespace = "",
)

# Runs abi_driver against libkomira: it dlopens the library, binds each function
# the header declares with the header's type, and checks the version, the
# status codes and the input bound the header names, and the two-call error
# round trip. A header that disagrees with the binary fails here. It also runs
# SQL through komira_sql_stream and reads the answers through the header's
# struct ArrowArrayStream: count(*) over two_columns.parquet (staged beside it),
# that file's columns with no row, and a file of three rows it writes with
# COPY into $TEST_TMPDIR, registers and queries; each refusal (NULL ctx, sql or
# out, a parse and a bind error, a text one byte over the bound) leaves *out as
# the driver wrote it, and a good query follows each on the same context; a
# stream outlives komira_ctx_free. And it registers files it writes into
# $TEST_TMPDIR with komira_register_csv (a `|` file, one with all_varchar)
# and komira_register_json and queries each by name: the rows are the files'
# own, and a file registered with no header is refused at lower when queried; a taken name, an empty one and a missing file are
# refused with the named last error, and the first table keeps answering.
komira_c_abi_check(
    name = "c_abi_check",
    driver = ":abi_driver",
    lib = ":libkomira",
    native_owners = NATIVE_OWNERS,
    data = {"two_columns.parquet": "tests/fixtures/two_columns.parquet"},
)
