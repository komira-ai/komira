# The shared libraries of the C code the library owns; libkomira links each as
# NEEDED, and the C driver below stages the same ones beside it.
NATIVE_OWNERS = [
    "//src/async_rt:komira_async_native",
    "//src/async_api:komira_async_api_native",
    "//src/compression:komira_compression_native",
    "//src/fs:komira_fs_native",
    "//src/libc:komira_libc_native",
    "//src/metrics:komira_metrics_native",
    "//src/parquet_codec:komira_parquet_codec_native",
    "//src/scan_source:komira_scan_source_native",
]

# The C ABI of komira's one shared library, libkomira: the status codes, the
# ABI version, the session behind a context handle, and the source and render
# operations (`sources.mojo`) the C calls are made of. The library is plain
# Mojo with no pointer in it; `_c_abi.mojo`, the one file that holds pointers,
# is not part of it but the source of the `libkomira` target below.
#
# test_status holds the six codes, the input-length bound, the version scheme (major * 1000 + minor)
# and buffer_status, the two-call protocol's capacity test; test_session holds
# the last-error text of a Session (fresh, set, replaced, cleared, moved);
# test_sources holds the operations on values: a Parquet file registered and
# its schema bytes, the CSV and JSON bindings, and a plan rendered.
mojo_library(
    name = "so",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo", "_c_abi.mojo"]),
    deps = [
        "//src/agg:agg",
        "//src/arrow:arrow",
        "//src/arrow_ipc:arrow_ipc",
        "//src/async_rt:async_rt",
        "//src/async_api:async_api",
        "//src/atomic_alias:atomic_alias",
        "//src/avro:avro",
        "//src/byte_buffer:byte_buffer",
        "//src/clock:clock",
        "//src/containers:containers",
        "//src/column_kernels:column_kernels",
        "//src/compression:compression",
        "//src/counters:counters",
        "//src/csv:csv",
        "//src/dynamic_filter:dynamic_filter",
        "//src/expr:expr",
        "//src/fork_join:fork_join",
        "//src/fs:fs",
        "//src/hashing:hashing",
        "//src/host_probe:host_probe",
        "//src/join_assembly:join_assembly",
        "//src/json_index:json_index",
        "//src/jsonl:jsonl",
        "//src/kernels:kernels",
        "//src/libc:libc",
        "//src/log:log",
        "//src/lz4:lz4",
        "//src/metrics:metrics",
        "//src/name_registry:name_registry",
        "//src/op_agg_state:op_agg_state",
        "//src/parquet:parquet",
        "//src/parquet_api:parquet_api",
        "//src/parquet_codec:parquet_codec",
        "//src/plan_expr:plan_expr",
        "//src/plan_ir:plan_ir",
        "//src/plan_proto:plan_proto",
        "//src/plan_stats:plan_stats",
        "//src/plan_wire:plan_wire",
        "//src/proto_codec:proto_codec",
        "//src/row_format:row_format",
        "//src/scalar_arithmetic:scalar_arithmetic",
        "//src/scan_source:scan_source",
        "//src/sdk:sdk",
        "//src/simd_ops:simd_ops",
        "//src/spsc_ring:spsc_ring",
        "//src/sql:sql",
        "//src/sync:sync",
        "//src/trace:trace",
        "//src/udf:udf",
        "//src/zlib:zlib",
        "//tools/build/mojo/runtime_paths:runtime_paths",
    ],
    test_srcs = [
        "tests/test_session.mojo",
        "tests/test_sources.mojo",
        "tests/test_status.mojo",
    ],
    test_data = {
        "tests/test_sources.mojo": ["tests/fixtures/two_columns.parquet"],
    },
    visibility = ["PUBLIC"],
)

# libkomira.so (libkomira.dylib on macOS arm64): nine exports, and nothing else
# in the dynamic symbol table (`exports_exact`). It is published only if every
# gate driver passes, each of which dlopens it with RTLD_NOW and calls it as a
# foreign host would:
#   gate_version       the version is 1001 (1.1);
#   gate_new_free      handles are non-NULL, distinct and hold separate sessions,
#                      freeing NULL is a no-op;
#   gate_no_extra_exports  the linker's section markers and the Mojo helpers
#                      are not in the symbol table;
#   gate_fresh_error   a fresh session's error is empty, with or without a buffer;
#   gate_two_call      capacity 0 and one byte short give -4 and the length, an
#                      exact and a larger buffer give the text, nothing past it;
#   gate_null_ctx      a NULL context is -1 and writes nothing;
#   gate_null_out_len  a NULL out_len is -2 and writes nothing;
#   gate_register_parquet  a Parquet file is registered by name; NULL ctx -1,
#                      NULL name or path -2, a missing or non-Parquet file -3
#                      with the reader's message as the last error;
#   gate_native_owners the library's DT_NEEDED entries (ELF dynamic section)
#                      name each native_owners SONAME; an owner dropped from
#                      the list is embedded silently and fails here;
#   gate_parquet_schema, gate_csv_binding, gate_json_binding, gate_plan_render
#                      a good input through the two-call protocol, NULL ctx -1,
#                      NULL input or out_len -2, a bad file or plan -3 with a
#                      last error, and a good call afterwards leaves no error.
#   gate_plan_render also: plan_len 64 MiB plus one and UINT64_MAX are -5 with
#                      nothing written and no read of the plan; exactly 64 MiB
#                      is read (garbage, so -3). gate_parquet_schema also: a
#                      path that is not UTF-8 is -3 with a last error.
mojo_shared_lib(
    name = "libkomira",
    srcs = ["_c_abi.mojo"],
    out_name = "libkomira",
    exports = [
        "komira_abi_version",
        "komira_ctx_new",
        "komira_ctx_free",
        "komira_last_error",
        "komira_register_parquet",
        "komira_parquet_schema",
        "komira_csv_binding",
        "komira_json_binding",
        "komira_plan_render",
    ],
    exports_exact = True,
    gate_srcs = [
        "tests/gate/gate_fresh_error.mojo",
        "tests/gate/gate_new_free.mojo",
        "tests/gate/gate_no_extra_exports.mojo",
        "tests/gate/gate_native_owners.mojo",
        "tests/gate/gate_null_ctx.mojo",
        "tests/gate/gate_null_out_len.mojo",
        "tests/gate/gate_csv_binding.mojo",
        "tests/gate/gate_json_binding.mojo",
        "tests/gate/gate_parquet_schema.mojo",
        "tests/gate/gate_plan_render.mojo",
        "tests/gate/gate_register_parquet.mojo",
        "tests/gate/gate_two_call.mojo",
        "tests/gate/gate_version.mojo",
    ],
    deps = [":so"],
    native_owners = NATIVE_OWNERS,
    visibility = ["komira//ci:", "komira//tools/build/package/libkomira:", "//node:", "//python/tests:"],
)

# The Parquet file the C-ABI gates and the Node and Python bindings' tests read.
export_file(
    name = "tests/fixtures/two_columns.parquet",
    src = "tests/fixtures/two_columns.parquet",
    visibility = ["komira//ci:", "//node:", "//python/tests:"],
)

# The C header of libkomira, komira.h, made from abi/komira.tsv (the golden:
# every export with its return and argument types and the version that added
# it, and every status code and limit). It builds only while the golden is
# exactly the `@export abi("C")` functions of _c_abi.mojo with the same types,
# and the constants of status.mojo with the same values. Adding an export, or
# changing a type or a constant, without the golden is a red build here.
komira_abi_golden(
    name = "komira_abi",
    src = "_c_abi.mojo",
    constants_src = "status.mojo",
    golden = "abi/komira.tsv",
    header_name = "komira.h",
    visibility = ["PUBLIC"],
)

staged_files(
    name = "c_driver_files",
    srcs = ["tests/c/abi_driver.c"],
)

# A C host of libkomira that includes komira.h and nothing else of ours.
cxx_binary(
    name = "abi_driver",
    srcs = [":c_driver_files[tests/c/abi_driver.c]"],
    headers = {"komira.h": ":komira_abi"},
    header_namespace = "",
)

# Runs abi_driver against libkomira: it dlopens the library, binds each function
# the header declares with the header's type, and checks the version, the
# status codes and the input bound the header names, and the two-call error
# round trip. A header that disagrees with the binary fails here.
komira_c_abi_check(
    name = "c_abi_check",
    driver = ":abi_driver",
    lib = ":libkomira",
    native_owners = NATIVE_OWNERS,
)
