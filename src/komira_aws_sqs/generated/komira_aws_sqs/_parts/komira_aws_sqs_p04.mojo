# ===========================================================================
# §5 — SQSClient.
# ===========================================================================
struct SQSClient[C: Connector, T: AwsCredsSource](Movable, Deinitable):
    """The generated Amazon Simple Queue Service client, parametric over the HTTP connector `C`
        and the credential source `T`.

        The connector factory is a `def () raises thin -> C` function
        pointer (a code pointer, no heap); the credential source is moved
        in. No field is an `UnsafePointer`.

        `http_config` is the caller's and has no default: the HTTP client is
        built inside `send_sigv4_signed_request`, so this argument is the only
        way to bound it. A process serving requests under a platform deadline
        passes `HttpClientConfig.for_serving_ceiling(ceiling_us)`, the ceiling
        in microseconds; a process with no containing deadline (a job, a CLI,
        a test) passes `HttpClientConfig.defaults()`."""

    var _mk_connector: def () raises thin -> Self.C
    # Handed to `send_sigv4_signed_request` on every send, unchanged.
    var _http_config: HttpClientConfig
    var _creds_source: Self.T
    var _region: String
    # The retry quota this client's calls share (botocore's standard mode
    # keeps one per client): every retry spends from it, and a call that
    # succeeds refills it.
    var _retry_quota: AwsRetryQuota
    # WHERE this client sends: the service's endpoint ruleset, resolved per
    # call over this configuration (`endpoint` for a local emulator,
    # `force_path_style`, FIPS, dual-stack). A VALUE, never an ambient env
    # var. The ruleset is loaded once, here.
    var _endpoint_config: SQSEndpointConfig
    var _rules: EndpointRuleSet

    def __init__(
        out self,
        mk_connector: def () raises thin -> Self.C,
        http_config: HttpClientConfig,
        var creds_source: Self.T,
        region: String,
        var endpoint_config: SQSEndpointConfig = SQSEndpointConfig(),
    ) raises:
        """`endpoint_config`'s region, when unset, is `region`."""
        var rules = komira_aws_sqs_endpoint_rules()
        self._mk_connector = mk_connector
        self._http_config = http_config.copy()
        self._creds_source = creds_source^
        self._region = region
        self._retry_quota = AwsRetryQuota()
        if not endpoint_config.region and region.byte_length() > 0:
            endpoint_config.region = Optional[String](region)
        self._endpoint_config = endpoint_config^
        self._rules = rules^

    def into_creds_source(deinit self) -> Self.T:
        """Consume the client, handing the moved-in credential source back
            out — so ONE Movable-but-not-Copyable source threads through
            several clients in a bootstrap."""
        return self._creds_source^

    def region(self) -> String:
        return self._region.copy()

    def send(mut self, var req: AwsRequest, target: AwsSigningTarget) raises -> HttpResult:
        """Sign and send `req`. THE SIGNER IS NOT GENERATED — this is a call
            into the hand-written `komira_aws_core.send_sigv4_signed_request`, which is
            tested against the AWS SigV4 test vectors.

            ⛔ `X-Amz-Target` MUST RIDE IN THE **SIGNED** SET, not merely on the
            wire: an awsJson service includes it in the canonical request, so an
            unsigned one comes back `SignatureDoesNotMatch` and sends every
            reader to the credential. It is passed as an extra SIGNED header for
            exactly that reason.

            `target` is where the endpoint ruleset sent this call and how it
            is signed (`aws_signing_target`): its endpoint, signing name and
            region, and the headers the endpoint adds."""
        var cred = self._creds_source.credentials()
        var extra = List[Header]()
        for _i in range(len(target.header_names)):
            extra.append(Header(target.header_names[_i].copy(), target.header_values[_i].copy()))
        var content_type = String(String(
            SQS_CONTENT_TYPE
        ))
        for _i in range(len(req.header_names)):
            var n = req.header_names[_i].copy()
            if n.lower() == String("content-type"):
                # Header names are case-insensitive, and the substrate refuses an
                # `extra` Content-Type in any case.
                # The substrate takes the content type as its own argument and
                # puts it in BOTH the signed set and the wire headers. Passing it
                # again here would emit it twice and break the signature.
                content_type = req.header_values[_i].copy()
            else:
                extra.append(Header(n^, req.header_values[_i].copy()))
        return send_sigv4_signed_request[Self.C](
            self._mk_connector,
            self._http_config.copy(),
            self._retry_quota,
            req.method.copy(),
            cred,
            target.signing_region.copy(),
            target.signing_name.copy(),
            target.endpoint.with_host_prefix(req.host_prefix),
            req.uri.copy(),
            content_type^,
            req.body.copy(),
            extra^,
        )

    def send_with[X: AwsHttpTransport, K: AwsClock, L: MonotonicClock, S: Sleeper, R: RetryRng, B: RetryBudget](mut self, var req: AwsRequest, target: AwsSigningTarget, mut transport: X, mut clock: K, mut retry: RetryLoop[L, S, R], mut budget: B) raises -> HttpResult:
        """`send`, over the transport, signing clock, retry loop and budget
            given (`komira_aws_core.send_sigv4_signed_request_with`) instead of a
            connector from this client's factory, the wall clock and the
            standard retry loop. It returns the response, successful or not.

            The transport carries the HTTP config: `AwsConnectorTransport(
            http_config, connector)` is built from the caller's
            `HttpClientConfig`, as `send` builds its own from this client's. The
            budget is the retry quota: an `AwsRetryQuota` the caller keeps, one
            for all the calls it makes over this client, as botocore keeps one
            per client. `send` spends this client's own quota instead.

            A request carrying `If-Match` or `If-None-Match` is resent only
            when the service cannot have acted on it (`aws_request_is_conditional`)."""
        var cred = self._creds_source.credentials()
        var extra = List[Header]()
        for _i in range(len(target.header_names)):
            extra.append(Header(target.header_names[_i].copy(), target.header_values[_i].copy()))
        var content_type = String(String(
            SQS_CONTENT_TYPE
        ))
        for _i in range(len(req.header_names)):
            var n = req.header_names[_i].copy()
            if n.lower() == String("content-type"):
                # Header names are case-insensitive, and the substrate refuses an
                # `extra` Content-Type in any case.
                # The substrate takes the content type as its own argument and
                # puts it in BOTH the signed set and the wire headers. Passing it
                # again here would emit it twice and break the signature.
                content_type = req.header_values[_i].copy()
            else:
                extra.append(Header(n^, req.header_values[_i].copy()))
        return send_sigv4_signed_request_with(
            transport,
            clock,
            retry,
            budget,
            req.method.copy(),
            cred,
            target.signing_region.copy(),
            target.signing_name.copy(),
            target.endpoint.with_host_prefix(req.host_prefix),
            req.uri.copy(),
            content_type^,
            req.body.copy(),
            extra^,
        )

    def create_queue(mut self, input: SQSCreateQueueRequest) raises -> SQSCreateQueueResult:
        """`CreateQueue` — POST /"""
        var req = build_create_queue_request(input)
        var target = aws_signing_target(
            resolve_create_queue_endpoint(self._rules, self._endpoint_config, input),
            self._region.copy(),
            String(SQS_SERVICE),
        )
        var res = self.send(req^, target)
        if not aws_is_error_status(res.status):
            return parse_create_queue_response(res^.into_response())
        raise _komira_aws_sqs_error(String("CreateQueue"), res)

    def create_queue_with[X: AwsHttpTransport, K: AwsClock, L: MonotonicClock, S: Sleeper, R: RetryRng, B: RetryBudget](mut self, input: SQSCreateQueueRequest, mut transport: X, mut clock: K, mut retry: RetryLoop[L, S, R], mut budget: B) raises -> HttpResult:
        """`CreateQueue` over the given seams (`send_with`): the response, successful
            or not. `parse_create_queue_response` reads a successful one."""
        var req = build_create_queue_request(input)
        var target = aws_signing_target(
            resolve_create_queue_endpoint(self._rules, self._endpoint_config, input),
