load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon SQS: an awsJson 1.0 client generated at build time from botocore's
# sqs model (//third_party/botocore, pinned by sha256; nothing of it is
# copied here), in client mode: each operation's request builder and
# response parser, its endpoint resolved through the service's published
# endpoint ruleset and partition table, embedded in the module, and
# `SQSClient`, which resolves each call's endpoint and sends through
# komira_aws_core's send_sigv4_signed_request (signing name `sqs`) over the
# komira_http_core Connector it is given. Every SQS operation is a POST,
# and a call is retried as botocore's standard mode retries it: after a
# throttle, a 5xx or a failed send, whether or not SQS may have acted on it
# (komira_aws_core's aws_retry.mojo).
#
# SQS's model is awsQueryCompatible: every request carries
# `x-amzn-query-mode: true`, and the service names an error's legacy query
# code in an `x-amzn-query-error` header beside the shape name in `__type`.
# Two of those codes differ from the shape name on the operations below
# (QueueDoesNotExist arrives as AWS.SimpleQueueService.NonExistentQueue,
# QueueNameExists as QueueAlreadyExists), but the pinned model omits them:
# no error shape carries an `error.code`. The generator's refusal of an
# operation with a custom query code therefore has nothing to fire on here,
# and the codes are read from the response instead: komira_aws_core's
# `aws_json_error_info` takes its code from that header, as botocore and the
# Go v2 SDK do, and the client's error builder reads its code there
# (test_sqs_client).
#
# `operations` is a work queue's lifecycle: a queue created, looked up,
# its attributes read and set, and deleted; messages received and deleted.
# An operation joins the list with its own rows in the tests below.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Amazon SQS API reference (no upstream test body is copied):
# test_sqs_requests (the request each operation builds, exactly),
# test_sqs_responses (each result decoded, and the error forms read through
# komira_aws_core), test_sqs_endpoints (botocore's endpoint cases for sqs
# through every operation's resolver, the regional, FIPS, dual-stack and
# LocalStack endpoints, and two requests signed end to end against
# independently computed signatures), _no_env_reads (written by
# mojo_aws_client: the package reads no environment) and test_sqs_client
# (the generated client over a scripted connector: a call answered, a
# missing queue raised under its query code, and the GetQueueUrl request as
# it reached the wire, through komira_aws_core's AwsEchoConnector).
#
# No test here talks to the service.

_SQS = botocore_model("sqs")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("sqs")

mojo_aws_client(
    name = "komira_aws_sqs",
    endpoint_rules = _SQS.endpoint_rules,
    mode = "client",
    model = _SQS.model,
    model_sha256 = _SQS.sha256,
    operations = [
        "CreateQueue",
        "DeleteMessage",
        "DeleteQueue",
        "GetQueueAttributes",
        "GetQueueUrl",
        "ReceiveMessage",
        "SetQueueAttributes",
    ],
    partitions = _SQS.partitions,
    test_data = {
        "tests/test_sqs_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_sqs_client.mojo",
        "tests/test_sqs_endpoints.mojo",
        "tests/test_sqs_requests.mojo",
        "tests/test_sqs_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` takes a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
