load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The `kci` command line: ONE command, `kci run --stage S`. It reads the
# machine file (kci_release_machine; --machine, default release/machine.textproto),
# resolves stage S and runs each of its steps in order through kci_build
# (BUILD) or kci_publish (PUBLISH). Under GitHub Actions it first holds the
# workflow it runs under (read at its commit) to the machine file
# (kci_workflow_check, library code: a mismatch is exit 3, unreadable exit 5), then
# the ref it runs on (a stage without break_glass runs only on main; a
# break-glass run needs a reason) and the release set it was handed
# (--release-set-hash). It
# reports the NEW NAMES of the stages after it, and appends a markdown summary
# to --summary-file. A step's validations run after it (kci_validate: the
# release installed from the step's channel in a digest-pinned container);
# `--only validation:<v>` runs one against what is already published, and
# `--only step:<s>` runs the step without them. There is no other verb and
# no alias. Every run writes kci_api's result document to --result-file
# (temp-and-rename, RUNNING before the first effect, FINISHED on every exit
# path) and exits with kci_api's numbers. bin/kci is its `main`.
#
# A DEPLOY step (deploy_step.mojo) plans or applies a resource list into a
# cell (kci_cell) through kci_cloud, generic over the cloud adapter and the
# state store; kci_composites is the definitions kci ships. The binary is
# built with no cloud adapter, so it refuses every DEPLOY step. The welded
# deploy tests drive kci_cloud_fake's FakeCloud, a test dependency only
# (`test_deps`), never shipped in the binary.
#
# The welded tests: the one parser and every usage refusal; the stage run over
# a recording fake (order, stop at the first failure, worst outcome, PARTIAL
# after a publish, the result records, the workflow check, validations after
# their step and on their own, VALIDATION_FAILED and NOT_REACHED, the
# lookahead, the summary); the result file; the real libraries
# reached through a machine file; and a scan that no kci source but
# kci_api spells an exit number.
mojo_library(
    name = "kci_cli",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_artifact:kci_artifact",
        "//src/kci_build:kci_build_lib",
        "//src/kci_cell:kci_cell",
        "//src/kci_cloud:kci_cloud",
        "//src/kci_composites:kci_composites",
        "//src/kci_reconciler:kci_reconciler",
        "//src/kci_resource_proto:kci_resource_proto",
        "//src/kci_workflow_check:kci_workflow_check",
        "//src/kci_api:kci_api",
        "//src/kci_pkg_upload:kci_pkg_upload",
        "//src/kci_publish:kci_publish_lib",
        "//src/kci_release_set:kci_release_set",
        "//src/kci_release_machine:kci_release_machine",
        "//src/kci_validate:kci_validate",
        "//src/komira_clock:komira_clock",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        "//src/komira_libc:komira_libc",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_secret_env:komira_secret_env",
        "//src/komira_secret_store:komira_secret_store",
    ],
    # the working fake cloud the deploy tests run on; never in the binary
    test_deps = ["//src/kci_cloud_fake:kci_cloud_fake"],
    test_srcs = [
        # the one parser: verbs, flags, the stage's flags, every usage refusal
        "tests/test_kci_args.mojo",
        # kci run over a recording fake: the steps, where the run stops, --only, --plan, --affected-by
        "tests/test_kci_dispatch.mojo",
        # the same fake at start-up: the workflow check; a local --channel and its refusals, exactly
        "tests/test_kci_dispatch_workflow.mojo",
        # the same fake: validations, NEW NAMES, the summary
        "tests/test_kci_dispatch_validations.mojo",
        # the start-up check accepts a pull request's check (and refuses a
        # drifted one); a dry run outside CI says its credential probe did
        # not run, next to the outcome
        "tests/test_kci_pr_stage_and_probe.mojo",
        # the result file: RUNNING then FINISHED, temp-and-rename, usage errors recorded
        "tests/test_kci_result_file.mojo",
        # continuous auto-promotion at start-up: the ref (main only, break-glass
        # with a reason), the set hash handed on, never backward, the prod line
        "tests/test_kci_ref_check.mojo",
        # the real libraries through a machine file; the secret store by name
        "tests/test_kci_library_wiring.mojo",
        # no exit number is spelled outside kci_api
        "tests/test_exit_numbers_in_one_place.mojo",
        # a DEPLOY step end to end on FakeCloud + InMemoryStateStore: --plan,
        # apply then NOOP, the scope's machine, foreign, partial, first-node
        # partial, kci.app's plan, the set hash, the binary's refusal, trust
        "tests/test_kci_deploy_step.mojo",
        # the same on a faulty FakeCloud: trust_check, a presence read,
        # a broken lowering contract and realize, each raising
        "tests/test_kci_deploy_faults.mojo",
    ],
    test_env = {
        # resolved by name through --secret-store=env's store
        "KCI_CLI_TEST_SECRET": "kci-cli-test-value",
    },
    test_data = {
        "tests/test_exit_numbers_in_one_place.mojo": {
            "kci_cli_args.mojo": "//src/kci_cli:args.mojo",
            "kci_cli_deploy_step.mojo": "//src/kci_cli:deploy_step.mojo",
            "kci_cli_dispatch.mojo": "//src/kci_cli:dispatch.mojo",
            "kci_cli_library_verbs.mojo": "//src/kci_cli:library_verbs.mojo",
            "kci_cli_recorder.mojo": "//src/kci_cli:recorder.mojo",
            "kci_cli_seam.mojo": "//src/kci_cli:seam.mojo",
            "kci_cli_start_checks.mojo": "//src/kci_cli:start_checks.mojo",
            "kci_cli_summary.mojo": "//src/kci_cli:summary.mojo",
            "bin_kci_main.mojo": "//bin/kci:main.mojo",
        },
        # the definitions kci ships, at the resource names kci_composites
        # reads them by
        "tests/test_kci_deploy_step.mojo": {
            "src/kci_composites/definitions/{}.json".format(d): "//src/kci_composites:{}.json".format(d)
            for d in ["kci.app", "kci.job"]
        },
        "tests/test_kci_deploy_faults.mojo": {
            "src/kci_composites/definitions/{}.json".format(d): "//src/kci_composites:{}.json".format(d)
            for d in ["kci.app", "kci.job"]
        },
    },
    visibility = ["PUBLIC"],
)

export_file(name = "args.mojo", visibility = ["//src/kci_cli:"])
export_file(name = "deploy_step.mojo", visibility = ["//src/kci_cli:"])
export_file(name = "dispatch.mojo", visibility = ["//src/kci_cli:"])
export_file(name = "library_verbs.mojo", visibility = ["//src/kci_cli:"])
export_file(name = "recorder.mojo", visibility = ["//src/kci_cli:"])
export_file(name = "seam.mojo", visibility = ["//src/kci_cli:"])
export_file(name = "start_checks.mojo", visibility = ["//src/kci_cli:"])
export_file(name = "summary.mojo", visibility = ["//src/kci_cli:"])
