load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# What the BUILD step and the PUBLISH step both know about a release set, in one
# place so the two steps cannot drift apart: `verify_member` (the checks over
# one artifact's directory: one manifest, its name, bare file names, nothing
# else in the directory, the sha256, the conda metadata agreeing and
# stamped), the `metadata.json` reader, `release.json` and the set hash a
# release is approved under. Runs no process and opens no socket.
#
# The welded tests: every metadata refusal by its message, over the real
# shapes komira_pack writes (a library's and a metapackage's metadata.json,
# and one real metapackage directory, staged as test data); every
# verify_member refusal over directories written under TEST_TMPDIR;
# release.json (major 2: revision, platform, produced_by) rendered
# byte-exact, round-tripped and refused; the set hash against a golden vector.
mojo_library(
    name = "kci_release_set",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_artifact:kci_artifact",
        "//src/kci_artifact_manifest:kci_artifact_manifest",
        "//src/kci_api:kci_api",
        "//src/kci_release_channel:kci_release_channel",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_json:komira_json",
    ],
    test_srcs = [
        # every metadata.json refusal by its message; the real library and metapackage shapes
        "tests/test_conda_metadata.mojo",
        # every verify_member refusal, one changed thing per case
        "tests/test_verify_member.mojo",
        # release.json: byte-exact render, parse(render(x)) == x, every refusal
        "tests/test_release_manifest.mojo",
        # the set hash: a golden vector, order-free, every field counts
        "tests/test_set_hash.mojo",
        # requirement closure by name: what is open, what is skipped, member order;
        # a library's conda-forge system-library requirement, byte-exact only
        "tests/test_closure.mojo",
        # the system-library copy equals tools/build/package/system_libs.bzl, both ways
        "tests/test_system_libs.mojo",
    ],
    test_data = {
        "tests/test_conda_metadata.mojo": glob(["tests/data/*.json", "tests/data/komira/metadata.json"]),
        "tests/test_verify_member.mojo": glob(["tests/data/komira/*"]) + ["tests/data/library.metadata.json"],
        # the table as the build evaluates it (system_libs_record.bzl)
        "tests/test_system_libs.mojo": {"system_libs.txt": "//tools/build/package:system_libs"},
    },
    visibility = ["PUBLIC"],
)
