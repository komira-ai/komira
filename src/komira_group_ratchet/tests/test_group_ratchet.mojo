# =============================================================================
# tests/komira_group_ratchet/test_group_ratchet.mojo
#   The E2E group ratchet test suite.
# =============================================================================
#
# TWO TIERS of rigor (per the deliverable brief):
#
# A. KNOWN-ANSWER VECTORS — pin the HMAC-tree advance + the HKDF key schedule
#    against deterministic vectors. These are OUR vectors (NOT the published
#    Megolm KATs): we cannot reproduce Megolm's exact per-message KATs because
#    (1) we SUBSTITUTE ChaCha20-Poly1305 for Megolm's AES-256-CBC+HMAC and (2)
#    our HKDF `info` string is "komira-grp-aead-v1" (vs Megolm's "MEGOLM_KEYS").
#    The ratchet ADVANCE algorithm (HMAC-SHA-256 tree, H_j = HMAC(R, byte(j)),
#    reseed at 2^8/2^16/2^24) is byte-identical to Megolm (the Megolm specification); the
#    KEY-SCHEDULE MECHANISM (HKDF-SHA-256 over the full 128-byte ratchet) is
#    identical. So the vectors below are generated by an INDEPENDENT Python
#    reference of the SAME algorithm (scripts comment in the test body) and
#    pinned here — they catch any drift in the advance/derive code AND confirm
#    komira_crypto's HKDF empty-salt handling matches RFC 5869 / our reference.
#    The DEVIATIONS from Megolm are documented precisely in ratchet.mojo /
#    session.mojo. KAT structure assertions also verify the per-step / boundary
#    reseed PATTERN (which parts change at index 1 vs index 256).
#
# B. PROPERTY TESTS:
#    1. encrypt -> decrypt round-trip across many indices (incl. boundary 256).
#    2. forward-ratchet: an inbound session imported at index N CANNOT decrypt a
#       message at index < N.
#    3. PCS (the headline security win): after rotate_on_membership_change, a
#       holder of the OLD session CANNOT decrypt new-session traffic.
#    4. tamper rejection: a bit-flip in ciphertext / tag / sig -> decrypt FAILS.
#    5. cross-session keys don't decrypt (wrong inbound session fails).
#    6. X25519-sealed key-share round-trip (seal -> open -> decrypt works; a
#       wrong recipient key fails).
#    7. out-of-order delivery within the skip bound; far-future index rejected.
#
# Implementation path: the ratchet builds on komira_crypto (HMAC/HKDF/AEAD/
# Ed25519/X25519 — all AWS-LC-backed via FFI), so the AEAD/sig primitives are
# already validated; this suite validates the PROTOCOL + state machine + the
# security properties layered on top.
# =============================================================================

from std.testing import assert_equal, assert_true, assert_false

from komira_group_ratchet import (
    GroupRatchet,
    DerivedMessageKeys,
    RATCHET_SIZE,
    AEAD_KEY_SIZE,
    NONCE_SEED_SIZE,
    OutboundGroupSession,
    InboundGroupSession,
    SessionKeyShare,
    SealedKeyShare,
    MessageEnvelope,
    encode_envelope,
    decode_envelope,
    rotate_on_membership_change,
    seal_session_key,
    open_session_key,
    x25519_prekey_generate,
    X25519_KEY_SIZE,
)


# -----------------------------------------------------------------------------
# Hex + byte helpers.
# -----------------------------------------------------------------------------


def _hex_nibble(c: UInt8) -> UInt8:
    if c >= UInt8(0x30) and c <= UInt8(0x39):
        return c - UInt8(0x30)
    if c >= UInt8(0x61) and c <= UInt8(0x66):
        return c - UInt8(0x61) + UInt8(10)
    if c >= UInt8(0x41) and c <= UInt8(0x46):
        return c - UInt8(0x41) + UInt8(10)
    return UInt8(0xFF)


def _hex_to_list(s: String) -> List[UInt8]:
    var bs = s.as_bytes()
    var n = len(bs) // 2
    var out = List[UInt8]()
    out.reserve(n)
    for i in range(n):
        out.append((_hex_nibble(bs[2 * i]) << UInt8(4)) | _hex_nibble(bs[2 * i + 1]))
    return out^


def _seed_0_to_127() -> InlineArray[UInt8, RATCHET_SIZE]:
    """The KAT seed: bytes 0x00, 0x01, ..., 0x7F (the Python reference seed)."""
    var seed = InlineArray[UInt8, RATCHET_SIZE](fill=UInt8(0))
    for i in range(RATCHET_SIZE):
        seed[i] = UInt8(i)
    return seed^


def _ascii(s: String) -> List[UInt8]:
    var out = List[UInt8]()
    var bs = s.as_bytes()
    out.reserve(len(bs))
    for i in range(len(bs)):
        out.append(bs[i])
    return out^


def _bytes_eq(a: List[UInt8], b: List[UInt8]) -> Bool:
    if len(a) != len(b):
        return False
    for i in range(len(a)):
        if a[i] != b[i]:
            return False
    return True


def _assert_aead_key_eq(
    keys: DerivedMessageKeys, expected_hex: String, label: String
) raises:
    var exp = _hex_to_list(expected_hex)
    for i in range(AEAD_KEY_SIZE):
        if keys.aead_key[i] != exp[i]:
            print("AEAD KEY MISMATCH at byte", i, "for", label)
            print("  got:", Int(keys.aead_key[i]), " expected:", Int(exp[i]))
            assert_equal(Int(keys.aead_key[i]), Int(exp[i]), label)


def _assert_nonce_seed_eq(
    keys: DerivedMessageKeys, expected_hex: String, label: String
) raises:
    var exp = _hex_to_list(expected_hex)
    for i in range(NONCE_SEED_SIZE):
        if keys.nonce_seed[i] != exp[i]:
            print("NONCE SEED MISMATCH at byte", i, "for", label)
            assert_equal(Int(keys.nonce_seed[i]), Int(exp[i]), label)


# =============================================================================
# TIER A — KNOWN-ANSWER VECTORS (HMAC-tree advance + HKDF key schedule).
#
# Vectors generated by an independent Python reference of the SAME algorithm:
#   seed = bytes(range(128))
#   H_j(A) = HMAC-SHA256(key=A, data=[j]);  advance reseeds R[j..3] at the
#            2^8/2^16/2^24 boundary; derive = HKDF-SHA256(salt=0, IKM=R,
#            info="komira-grp-aead-v1", L=44).
# These pin the derive/advance code AND confirm AWS-LC's HKDF empty-salt path
# matches the RFC 5869 zero-salt substitution our reference uses.
#
# ⚠️ THE DERIVED VECTORS ARE INFO-STRING-BOUND. `KEY_SCHEDULE_INFO` is the HKDF
# domain separator, so EVERY aead_key / nonce_seed vector below changes if it
# changes — while the STATE vectors (index-1 part3, index-256 part2) do NOT,
# because the HMAC advance tree never sees `info`. That asymmetry is exactly what
# a stale-vector failure looks like: state assertions keep passing while every
# derived-key assertion flips, against a correct implementation.
#
# TO REGENERATE (after any KEY_SCHEDULE_INFO change), in Python:
#   import hmac, hashlib
#   H = lambda j, A: hmac.new(A, bytes([j]), hashlib.sha256).digest()
#   def advance(R, i):
#       j = 0 if i % (1<<24) == 0 else 1 if i % (1<<16) == 0 else \
#           2 if i % (1<<8) == 0 else 3
#       R = list(R); R[j] = H(j, R[j])
#       for k in range(j+1, 4): R[k] = H(k, R[j])
#       return R
#   def hkdf(ikm, info, L=44):          # RFC 5869, salt absent -> 32 zero bytes
#       prk = hmac.new(b"\x00"*32, ikm, hashlib.sha256).digest()
#       okm = b""; t = b""; i = 1
#       while len(okm) < L:
#           t = hmac.new(prk, t+info+bytes([i]), hashlib.sha256).digest()
#           okm += t; i += 1
#       return okm[:L]                  # [0:32] = aead_key, [32:44] = nonce_seed
#   seed = bytes(range(128)); R = [seed[i:i+32] for i in (0,32,64,96)]
# Validate the reference FIRST against the two info-independent state vectors
# (index-1 part3, index-256 part2) — if those reproduce, the derived values are
# trustworthy ground truth.
# =============================================================================


def test_kat_index0_key_schedule() raises:
    """KAT: HKDF key schedule at index 0 (the fresh seed, no advance).

    aead_key || nonce_seed = HKDF-SHA256(0, seed[0..127], "komira-grp-aead-v1").
    Confirms (a) the derive code wiring and (b) komira_crypto's HKDF
    empty-salt handling == RFC 5869 HashLen-zero substitution."""
    var seed = _seed_0_to_127()
    var r = GroupRatchet(Span[UInt8, origin_of(seed)](seed), UInt32(0))
    var keys = r.derive_message_keys()
    _assert_aead_key_eq(
        keys,
        "5c4add57cd808b3b32459480fc162ba4e9c7be31a184a7a4f70e17ccf72857dc",
        "KAT index 0 aead_key",
    )
    _assert_nonce_seed_eq(
        keys, "f5813de81d47e61b9c392265", "KAT index 0 nonce_seed"
    )


def test_kat_index1_advance_per_step() raises:
    """KAT: ONE advance (index 0 -> 1) reseeds ONLY R[3] = H_3(R[3]).

    Asserts (a) parts 0/1/2 are UNCHANGED from the seed, (b) part 3 == the
    Python reference's H_3 value, and (c) the index-1 aead_key KAT."""
    var seed = _seed_0_to_127()
    var r = GroupRatchet(Span[UInt8, origin_of(seed)](seed), UInt32(0))
    r.advance()
    assert_equal(Int(r.index()), 1, "index after one advance")

    var st = r.export_state()
    # Parts 0/1/2 unchanged (bytes 0..95 still 0x00..0x5F).
    for i in range(96):
        assert_equal(Int(st[i]), i, "index-1 part0/1/2 unchanged at byte " + String(i))
    # Part 3 == the reference H_3 value.
    var exp_part3 = _hex_to_list(
        "550744e334115fa1fd73d3b71176d4157288631cb37045a49fd62cd0608c8f5d"
    )
    for i in range(32):
        assert_equal(
            Int(st[96 + i]), Int(exp_part3[i]), "index-1 part3 byte " + String(i)
        )

    var keys = r.derive_message_keys()
    _assert_aead_key_eq(
        keys,
        "0a420b721c91fbea5007439cff9031cf069ad4865f278d12e07d81d5805204c3",
        "KAT index 1 aead_key",
    )


def test_kat_index256_boundary_reseed() raises:
    """KAT: advancing across the 2^8 boundary (to index 256) reseeds R[2] AND
    R[3] (R[0]/R[1] still the seed). Pins the boundary-carry advance + the
    index-256 key schedule KAT."""
    var seed = _seed_0_to_127()
    var r = GroupRatchet(Span[UInt8, origin_of(seed)](seed), UInt32(0))
    r.advance_to(UInt32(256))
    assert_equal(Int(r.index()), 256, "index after advance_to(256)")

    var st = r.export_state()
    # Parts 0/1 unchanged (bytes 0..63 still 0x00..0x3F).
    for i in range(64):
        assert_equal(Int(st[i]), i, "index-256 part0/1 unchanged at byte " + String(i))
    # Part 2 reseeded to the reference value.
    var exp_part2 = _hex_to_list(
        "f0bdefbbad3cf097dccb03f2c87159f7608e2480543eef7741c8f2e7f226e78f"
    )
    for i in range(32):
        assert_equal(
            Int(st[64 + i]), Int(exp_part2[i]), "index-256 part2 byte " + String(i)
        )
    var keys = r.derive_message_keys()
    _assert_aead_key_eq(
        keys,
        "88d1e4eee3a623ada4028f0eecc5c98023471d7914567cfc6ffeec172fbb7109",
        "KAT index 256 aead_key",
    )
    _assert_nonce_seed_eq(
        keys, "859903057ed8396dfb3a87d2", "KAT index 256 nonce_seed"
    )


def test_advance_is_deterministic() raises:
    """Two independent ratchets from the same seed advance to the same state at
    the same index (the ratchet is a pure deterministic function)."""
    var seed = _seed_0_to_127()
    var a = GroupRatchet(Span[UInt8, origin_of(seed)](seed), UInt32(0))
    var b = GroupRatchet(Span[UInt8, origin_of(seed)](seed), UInt32(0))
    a.advance_to(UInt32(300))
    b.advance_to(UInt32(300))
    var sa = a.export_state()
    var sb = b.export_state()
    for i in range(RATCHET_SIZE):
        assert_equal(Int(sa[i]), Int(sb[i]), "deterministic state byte " + String(i))


def test_advance_to_backward_raises() raises:
    """advance_to a LOWER index raises (the forward-ratchet enforcement)."""
    var seed = _seed_0_to_127()
    var r = GroupRatchet(Span[UInt8, origin_of(seed)](seed), UInt32(100))
    var raised = False
    try:
        r.advance_to(UInt32(50))
    except:
        raised = True
    assert_true(raised, "advance_to(backward) must raise")


# =============================================================================
# TIER B — PROPERTY TESTS.
# =============================================================================


def _room() -> List[UInt8]:
    return _ascii("!room0:example.test")


def _build_inbound_from(
    mut out_sess: OutboundGroupSession, room: List[UInt8]
) raises -> InboundGroupSession:
    """Helper: export the outbound session's current key + build a matching
    inbound session (the in-process stand-in for the X25519-sealed delivery)."""
    var share = out_sess.export_session_key()
    return InboundGroupSession(share, room)


def test_roundtrip_many_indices() raises:
    """PROPERTY 1: encrypt -> decrypt round-trip across many indices, including
    across the 2^8 boundary. The inbound session is imported at index 0 and
    decrypts every subsequent message in order."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)
    var inb = _build_inbound_from(out_sess, room)

    # 260 messages (crosses index 256 boundary).
    for i in range(260):
        var pt = _ascii("msg-" + String(i) + "-hello-group")
        var env = out_sess.encrypt(pt)
        # Round-trip through the wire codec too (encode -> decode).
        var wire = encode_envelope(env)
        var env2 = decode_envelope(wire)
        var dec = inb.decrypt(env2)
        assert_true(
            _bytes_eq(dec, pt), "round-trip plaintext mismatch at index " + String(i)
        )


def test_roundtrip_empty_and_large() raises:
    """PROPERTY 1b: edge plaintext sizes — empty message + a 4KB message."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)
    var inb = _build_inbound_from(out_sess, room)

    var empty = List[UInt8]()
    var env0 = out_sess.encrypt(empty)
    var dec0 = inb.decrypt(env0)
    assert_equal(len(dec0), 0, "empty plaintext round-trip")

    var big = List[UInt8]()
    for i in range(4096):
        big.append(UInt8(i & 0xFF))
    var env1 = out_sess.encrypt(big)
    var dec1 = inb.decrypt(env1)
    assert_true(_bytes_eq(dec1, big), "4KB plaintext round-trip")


def test_forward_ratchet_cannot_decrypt_earlier() raises:
    """PROPERTY 2: an inbound session imported at index N CANNOT decrypt a
    message at index < N (the forward-ratchet property)."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)

    # Encrypt + capture an EARLY message (index 0).
    var early = out_sess.encrypt(_ascii("secret-history"))
    assert_equal(Int(early.index), 0, "early message at index 0")

    # Advance the sender a few messages, THEN export the session key (now at a
    # later index) and build an inbound session imported "late".
    for i in range(5):
        _ = out_sess.encrypt(_ascii("filler-" + String(i)))
    assert_true(Int(out_sess.index()) >= 6, "sender advanced past the early msg")
    var late_inb = _build_inbound_from(out_sess, room)
    assert_true(Int(late_inb.base_index()) >= 6, "inbound imported late")

    # The late inbound session must REFUSE to decrypt the index-0 message.
    var raised = False
    try:
        _ = late_inb.decrypt(early)
    except:
        raised = True
    assert_true(
        raised, "late inbound session must not decrypt an earlier-index message"
    )


def test_pcs_rotation_old_session_cannot_decrypt_new() raises:
    """PROPERTY 3 (the headline PCS win): after
    rotate_on_membership_change, a holder of the OLD inbound session CANNOT
    decrypt traffic from the NEW (post-rotation) session.

    This is the post-compromise-security property Megolm lacks: a removed member
    holding the old session is cryptographically locked out of new traffic."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)

    # A member (later "removed") builds an inbound session for the OLD session.
    var removed_member_inb = _build_inbound_from(out_sess, room)
    var old_session_id = out_sess.session_id()

    # Sanity: the old inbound session works on OLD-session traffic.
    var old_env = out_sess.encrypt(_ascii("before-removal"))
    var dec_old = removed_member_inb.decrypt(old_env)
    assert_true(_bytes_eq(dec_old, _ascii("before-removal")), "old session decrypts old traffic")

    # MEMBERSHIP CHANGE: rotate. The new session has a fresh seed + session_id;
    # its key is delivered ONLY to current members (NOT the removed member).
    rotate_on_membership_change(out_sess)
    var new_session_id = out_sess.session_id()

    # The session_id MUST have changed (a genuinely fresh session).
    var same_id = True
    for i in range(32):
        if old_session_id[i] != new_session_id[i]:
            same_id = False
            break
    assert_false(same_id, "rotation must produce a NEW session_id")

    # The removed member (still holding ONLY the old inbound session) cannot
    # decrypt a NEW-session message — it fails the session_id check (and would
    # fail the AEAD tag even if it didn't): PCS holds.
    var new_env = out_sess.encrypt(_ascii("after-removal-secret"))
    var raised = False
    try:
        _ = removed_member_inb.decrypt(new_env)
    except:
        raised = True
    assert_true(
        raised,
        "PCS: removed member's OLD session must NOT decrypt NEW-session traffic",
    )

    # A CURRENT member (who got the new key) CAN decrypt the new traffic.
    var current_inb = _build_inbound_from(out_sess, room)
    var new_env2 = out_sess.encrypt(_ascii("current-member-can-read"))
    var dec_new = current_inb.decrypt(new_env2)
    assert_true(
        _bytes_eq(dec_new, _ascii("current-member-can-read")),
        "current member decrypts new-session traffic",
    )


def test_tamper_ciphertext_rejected() raises:
    """PROPERTY 4a: a bit-flip in the ciphertext makes decrypt FAIL (AEAD tag)."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)
    var inb = _build_inbound_from(out_sess, room)

    var env = out_sess.encrypt(_ascii("authentic-message"))
    # Flip a bit in the first ciphertext byte.
    var tampered_ct = List[UInt8]()
    for i in range(len(env.ciphertext_then_tag)):
        tampered_ct.append(env.ciphertext_then_tag[i])
    tampered_ct[0] = tampered_ct[0] ^ UInt8(0x01)
    # Re-sign the tampered ciphertext so we isolate the AEAD failure (otherwise
    # the signature check would fail first). We can't re-sign without the
    # sender's seed, so instead flip a byte and rely on EITHER the sig OR the
    # AEAD to reject — both are integrity guards. Build a tampered envelope.
    var tampered = MessageEnvelope(env.session_id, env.index, tampered_ct^, env.sig)
    var raised = False
    try:
        _ = inb.decrypt(tampered)
    except:
        raised = True
    assert_true(raised, "tampered ciphertext must be rejected")


def test_tamper_tag_rejected() raises:
    """PROPERTY 4b: a bit-flip in the AEAD tag (last 16 bytes) makes decrypt
    FAIL."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)
    var inb = _build_inbound_from(out_sess, room)

    var env = out_sess.encrypt(_ascii("authentic-message"))
    var tampered_ct = List[UInt8]()
    for i in range(len(env.ciphertext_then_tag)):
        tampered_ct.append(env.ciphertext_then_tag[i])
    # Flip a bit in the LAST byte (inside the 16-byte tag).
    var last = len(tampered_ct) - 1
    tampered_ct[last] = tampered_ct[last] ^ UInt8(0x80)
    var tampered = MessageEnvelope(env.session_id, env.index, tampered_ct^, env.sig)
    var raised = False
    try:
        _ = inb.decrypt(tampered)
    except:
        raised = True
    assert_true(raised, "tampered AEAD tag must be rejected")


def test_tamper_signature_rejected() raises:
    """PROPERTY 4c: a bit-flip in the Ed25519 signature makes decrypt FAIL
    (signature check, before the AEAD even runs)."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)
    var inb = _build_inbound_from(out_sess, room)

    var env = out_sess.encrypt(_ascii("authentic-message"))
    var tampered_sig = env.sig.copy()
    tampered_sig[10] = tampered_sig[10] ^ UInt8(0x01)
    var ct = List[UInt8]()
    for i in range(len(env.ciphertext_then_tag)):
        ct.append(env.ciphertext_then_tag[i])
    var tampered = MessageEnvelope(env.session_id, env.index, ct^, tampered_sig)
    var raised = False
    try:
        _ = inb.decrypt(tampered)
    except:
        raised = True
    assert_true(raised, "tampered Ed25519 signature must be rejected")


def test_cross_session_key_does_not_decrypt() raises:
    """PROPERTY 5: an inbound session for session A cannot decrypt a message
    from session B (cross-session isolation)."""
    var room = _room()
    var sess_a = OutboundGroupSession(room)
    var sess_b = OutboundGroupSession(room)
    var inb_a = _build_inbound_from(sess_a, room)

    var env_b = sess_b.encrypt(_ascii("from-session-b"))
    var raised = False
    try:
        _ = inb_a.decrypt(env_b)
    except:
        raised = True
    assert_true(raised, "session-A inbound must not decrypt session-B traffic")


def test_wrong_room_rejected() raises:
    """PROPERTY 5b: an inbound session built with the WRONG room_id fails the
    AEAD tag (room_id is bound into the AAD)."""
    var room_a = _ascii("!roomA:example.test")
    var room_b = _ascii("!roomB:example.test")
    var out_sess = OutboundGroupSession(room_a)
    # Build an inbound session that THINKS it is room B (AAD mismatch).
    var share = out_sess.export_session_key()
    var inb_wrong_room = InboundGroupSession(share, room_b)

    var env = out_sess.encrypt(_ascii("room-a-message"))
    var raised = False
    try:
        _ = inb_wrong_room.decrypt(env)
    except:
        raised = True
    assert_true(raised, "wrong room_id must fail the AEAD AAD binding")


def test_x25519_sealed_keyshare_roundtrip() raises:
    """PROPERTY 6: the X25519-sealed key-share delivery round-trips: seal a
    session key to a recipient's prekey, open it, build an inbound session, and
    decrypt real traffic. A WRONG recipient private key fails to open."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)

    # Recipient device prekey pair.
    var recipient = x25519_prekey_generate()
    var recipient_priv = recipient[0].copy()
    var recipient_pub = recipient[1].copy()

    # Seal the session key to the recipient's prekey.
    var share = out_sess.export_session_key()
    var sealed = seal_session_key(share, recipient_pub)

    # Round-trip the sealed bytes through serialize/deserialize (the to-device
    # wire form) — the server only ever holds these opaque bytes.
    var wire = sealed.serialize()
    var sealed2 = SealedKeyShare.deserialize(wire)

    # Open with the recipient's private key -> a usable SessionKeyShare.
    var opened = open_session_key(sealed2, recipient_priv)
    var inb = InboundGroupSession(opened, room)

    # Decrypt real traffic with the delivered session.
    var env = out_sess.encrypt(_ascii("delivered-via-x25519"))
    var dec = inb.decrypt(env)
    assert_true(
        _bytes_eq(dec, _ascii("delivered-via-x25519")),
        "x25519-delivered session decrypts traffic",
    )

    # A WRONG recipient key must fail to open the sealed share.
    var attacker = x25519_prekey_generate()
    var attacker_priv = attacker[0].copy()
    var share2 = out_sess.export_session_key()
    var sealed3 = seal_session_key(share2, recipient_pub)
    var raised = False
    try:
        _ = open_session_key(sealed3, attacker_priv)
    except:
        raised = True
    assert_true(raised, "wrong recipient key must fail to open the sealed share")


def test_out_of_order_within_skip_bound() raises:
    """PROPERTY 7a: out-of-order delivery within the skip bound works — a
    receiver can decrypt index 5 before index 2 (each decrypt fast-forwards a
    working ratchet copy from the base)."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)
    var inb = _build_inbound_from(out_sess, room)

    # Encrypt 6 messages, capture them all.
    var envs = List[MessageEnvelope]()
    for i in range(6):
        envs.append(out_sess.encrypt(_ascii("ooo-" + String(i))))

    # Decrypt out of order: 5, 0, 3, 1, 4, 2.
    var order = List[Int]()
    order.append(5)
    order.append(0)
    order.append(3)
    order.append(1)
    order.append(4)
    order.append(2)
    for oi in range(6):
        var idx = order[oi]
        var dec = inb.decrypt(envs[idx])
        assert_true(
            _bytes_eq(dec, _ascii("ooo-" + String(idx))),
            "out-of-order decrypt at logical index " + String(idx),
        )


def test_far_future_index_rejected() raises:
    """PROPERTY 7b: a message at an index FAR beyond the inbound base (past the
    skip bound) is rejected (DoS guard / re-share signal). We forge an envelope
    claiming a huge index; even though the signature/AEAD would also fail, the
    skip-bound check rejects it cheaply first."""
    var room = _room()
    var out_sess = OutboundGroupSession(room)
    var inb = _build_inbound_from(out_sess, room)

    var env = out_sess.encrypt(_ascii("real-message"))
    # Forge a far-future index on the captured envelope.
    var ct = List[UInt8]()
    for i in range(len(env.ciphertext_then_tag)):
        ct.append(env.ciphertext_then_tag[i])
    var forged = MessageEnvelope(env.session_id, UInt32(1000000), ct^, env.sig)
    var raised = False
    try:
        _ = inb.decrypt(forged)
    except:
        raised = True
    assert_true(raised, "far-future index must be rejected (skip bound)")


