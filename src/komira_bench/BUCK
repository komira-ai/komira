load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_test")
load(":buildrules.mojo.bzl", "mojo_package")

# The benchmarks of komira libraries as programs, and the harness they share (the RESULT line and the
# command line: src/komira_bench/harness.mojo). The package is published as source; a user builds a
# program on their own machine with `mopm run --bin komira_bench:spsc_ring`.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file, and exists only once the tests of tests/ have passed; `:bin_spsc_ring` is the
# program `[targets] bins` declares, which `:build` and `:ci` build. The package depends on
# komira_atomic_alias and komira_spsc_ring, sibling packages (`[dependencies]` of mopm.toml);
# komira_spsc_ring depends on komira_collections, which depends on komira_atomic_alias in turn, so the
# closure `:lib` is built from holds all three, and the lock (mopm.lock) names them.
mojo_package(path = ".")

# `:komira_bench`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages: the rule refuses a list that is not the closure `:lib` was built from. It carries the
# README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_bench",
    deps = [
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_spsc_ring:komira_spsc_ring",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_bench/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_bench-0.1.0-mojo1.0.0_0.conda`), which records komira_atomic_alias and
# komira_spsc_ring as dependencies (`mojo-komira_atomic_alias >=0.1,<0.2`,
# `mojo-komira_spsc_ring >=0.1,<0.2`) and holds those packages' files nowhere. `members` is the
# manifests of the path dependencies of the closure, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given. `:lib` exists only once the
# tests passed, so this file exists only then. Publishing it (`mopm publish`) uploads, which is not
# a build action: it is a step of a CI job that takes this target's output. `mopm` is the one
# `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_bench",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_atomic_alias": "//src/komira_atomic_alias:mopm.toml",
        "../komira_collections": "//src/komira_collections:mopm.toml",
        "../komira_spsc_ring": "//src/komira_spsc_ring:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_73",
    package = "komira_bench",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/`, and exactly the dependencies of `[dependencies]`.
# Red when the manifest drops one, names another range, or the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_atomic_alias >=0.1,<0.2",
        "mojo-komira_spsc_ring >=0.1,<0.2",
    ],
    package = "komira_bench",
    sole = True,
    visibility = ["PUBLIC"],
)

# The spsc_ring program as komira's rules build it (the same source as `:bin_spsc_ring`, which is
# mopm's build of it for `mopm run`). `:bins_smoke` runs this one.
mojo_binary(
    name = "spsc_ring_bench",
    srcs = ["bins/spsc_ring.mojo"],
    deps = [
        ":komira_bench",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_spsc_ring:komira_spsc_ring",
    ],
)

# Each program runs once on a few records with its times hidden, and must print its RESULT lines
# (tests/standalone/bins_smoke.mojo; no time is read or asserted). A standalone mojo_test rather than a
# welded test: the program imports `:komira_bench`, which waits for its welded tests, so a welded test
# that ran it would wait for itself.
mojo_test(
    name = "bins_smoke",
    srcs = ["tests/standalone/bins_smoke.mojo"],
    data = {"bench/bin": ":spsc_ring_bench[runnable]"},
)
