        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_stats:komira_plan_stats",
        "//src/komira_scalar_arithmetic:komira_scalar_arithmetic",
        "//src/komira_scan_planning:komira_scan_planning",
        "//src/komira_scan_source:komira_scan_source",
    ],
    test_deps = [
        "//src/komira_parquet_writer:komira_parquet_writer",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_edge_policy_and_ready_set.mojo",
        "tests/test_group_agg_plan.mojo",
        "tests/test_op_filter.mojo",
        "tests/test_op_limit_concurrent.mojo",
        "tests/test_op_project_limit.mojo",
        "tests/test_real_plan.mojo",
        "tests/test_real_plan_concurrent.mojo",
        "tests/test_run_plan.mojo",
        "tests/test_run_segment_concurrent.mojo",
        "tests/test_run_segment.mojo",
        "tests/test_run_segment_failures.mojo",
        "tests/test_segment_pool.mojo",
        "tests/test_sink_agg.mojo",
        "tests/test_sink_agg_partials.mojo",
        "tests/test_sink_collect.mojo",
        "tests/test_sink_group_agg.mojo",
        "tests/test_sink_sort.mojo",
        "tests/test_sink_string_group_agg.mojo",
        "tests/test_sort_keys.mojo",
        "tests/test_sort_plan.mojo",
        "tests/test_sort_plan_concurrent.mojo",
        "tests/test_sources.mojo",
        "tests/test_string_group_memory.mojo",
        "tests/test_string_keys.mojo",
        "tests/test_tpch_q1.mojo",
        "tests/test_tpch_q1_concurrent.mojo",
        "tests/test_tpch_q6.mojo",
        "tests/test_tpch_q6_concurrent.mojo",
        "tests/test_variants.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The dictionary-interning spike of slice 4 (design section 4.3): a standalone
# program that times interned dictionary codes against hashing every row, the
# fragment merge, and the string-table memory per worker, on a synthetic
# workload of growing group count. It checks every layout's counts against a
# direct count and exits non-zero on a difference. CI compiles it and does not
# run it; the numbers come from the farm: `./buck2 build komira//src/komira_pipeline_exec:intern_spike[run_check]`
# runs it remotely and records its stdout; see the header of the file.
mojo_binary(
    name = "intern_spike",
    srcs = ["spike/intern_spike.mojo"],
    deps = [],
)
