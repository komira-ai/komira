load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")

# The driver of a physical plan: the ready-set scheduler over its segments
# (`run_plan`, `plan_check`, `edge_policy`), the run of one segment on a
# `ParallelDispatch` (`run_segment`, `segment_task`), the closed variants of the
# source, operator and sink traits (`source_variant`, `op_variant`,
# `pipeline_sink`, `unused_members`) and the builder seam through which a plan's
# members are constructed (`segment_builder`).
#
# Two sets of members stand behind that seam. The fakes (`fake_support`,
# `fake_members`, `fake_builder`, `fake_dispatch`) drive the scheduler in tests.
# The real members are the sources `source_parquet`, `source_batch` and
# `source_sink_output`, the operators `op_filter`, `op_project` and `op_limit`,
# the sinks `sink_collect`, `sink_agg` (the ungrouped aggregation, over
# `agg_fold` and `agg_output`, drawing memory from `segment_pool`), `sink_group_agg` (the same keyed by
# fixed-width columns, its tables charged as they grow), `sink_string_group_agg` (the same keyed by
# strings, over `string_keys`' intern table; `string_harness` is its test table), `sink_sort`
# (the in-memory sort, over `sort_nulls` and `komira_op_sort`; `sort_harness` is its
# test table and oracle), and
# `real_builder` that constructs them from a segment descriptor; `plan_harness`
# writes descriptors and sample data by hand and `tpch_q6` and `tpch_q1` are Q6 and Q1 as
# such plans with lineitem-shaped tables.
#
# test_edge_policy_and_ready_set  the edge tag and order key policies, the plan
#                                 checks and the ready set.
# test_variants                   each variant slot forwards to its member.
# test_run_segment                every row once, the end of input once per
#                                 worker, the operator chain, combine once
#                                 after every worker, a worker count of one to
#                                 seven.
# test_run_segment_failures       a second error is dropped, cancel stops the other
#                                 workers, a denied memory grow fails the query,
#                                 a caller's cancel, no output after a failure.
# test_run_segment_concurrent     one segment on the runtime's threaded dispatcher.
# test_run_plan                   segments in dependency order, independent
#                                 segments, a published output reaching its
#                                 dependent, a failed segment stopping the rest.
# test_op_filter                  the filter's selection mask, all-true,
#                                 all-false and NULL predicates, a second filter
#                                 over a mask, the refusal of an unscopable
#                                 predicate.
# test_op_project_limit           reordered, dropped and computed columns, a
#                                 projection under a mask; a limit across
#                                 morsels, shared by workers, at zero, under a
#                                 mask.
# test_op_limit_concurrent       the limit's row budget drawn on by several threads at
#                                 once: disjoint ranges, no lost count.
# test_sink_collect               the output ordered by morsel position, masks
#                                 gathered, the output schema of empty input.
# test_sources                    resident and sink-output sources, the Parquet
#                                 source built from a spec: projection, glob,
#                                 pushed filter, morsel size, refusals.
# test_real_plan                  hand-built plans end to end: scan, filter,
#                                 project and limit; a segment reading another's
#                                 output; what the builder refuses.
# test_real_plan_concurrent       the same plans on threads, run after run, on a
#                                 runtime stopped and started again.
# test_segment_pool               the atomic pool and the worker reservations:
#                                 budget, blocks, give-back, exact grants under
#                                 contention.
# test_sink_agg                   SUM, COUNT, COUNT(*), MIN, MAX and AVG over
#                                 resident batches: NULL, empty input, exact
#                                 128-bit decimal sums, refusals by name.
# test_sink_agg_partials          non-empty partials merged: dealing, the merge's
#                                 overflow refusal, pool return on failure.
# test_sink_group_agg             the grouped sink against a dict oracle: one and
#                                 two keys with NULLs, workers and dealing,
#                                 the merge's overflow, float keys, refusals,
#                                 the pool charged as tables grow.
# test_group_agg_plan             scan, filter and grouped sink over Parquet,
#                                 inline and on threads, and a budget refusal.
# test_sink_string_group_agg      the string-keyed grouped sink against a dict oracle:
#                                 one and two keys, flat and dictionary columns in
#                                 both orientations, NULL and the empty string,
#                                 workers numbering strings differently merged by
#                                 value, an entry no row used, overflow at the merge,
#                                 refusals by name.
# test_string_keys                the intern table by itself: equal hashes, growth,
#                                 a denied step, the entry limit, the content hash.
# test_string_group_memory        the pool charged as the string tables grow, refused
#                                 by name over budget in a worker and in the merge,
#                                 returned on success, failure and drop.
# test_tpch_q1                    Q1 over Parquet, end to end, against an oracle and
#                                 a hand-computed answer, from dictionary and plain
#                                 files with both string sinks.
# test_tpch_q1_concurrent         Q1 on threads, run after run.
# test_sink_sort                  SINK_SORT by hand: one and two keys, NULLs first and
#                                 last, ties in input order, four workers' partials,
#                                 refusals by name, the pool's charge and return.
# test_sort_keys                  float NaN/inf/zeros, the empty string, an unsorted
#                                 dictionary, unsortable key types refused by name.
# test_sort_plan                  hand-built plans into SINK_SORT: a resident batch, a
#                                 Parquet scan, a segment's output, no row, a pool
#                                 too small.
# test_sort_plan_concurrent       the same sort on threads, run after run, on a
#                                 runtime stopped and started again.
# test_tpch_q6                    Q6 over Parquet, end to end, against an
#                                 oracle and a hand-computed answer.
# test_tpch_q6_concurrent         Q6 on threads, run after run.
mojo_library(
    name = "komira_pipeline_exec",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo", "spike/**/*.mojo"]),
    deps = [
