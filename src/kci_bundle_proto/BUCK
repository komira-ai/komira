load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The authored intent bundle schema (`kci.bundle.v1`) and its generated
# Mojo. app_bundle.proto imports `kci/deploy/v1/deploy_model.proto` for the
# intent types it reuses, and the generated app_bundle.mojo refers to them as
# `kci_bundle_proto.deploy_model`, so `bundle_proto_deps` generates the
# imported schema into this package too: one flat package holding both.
#
#   from kci_bundle_proto.app_bundle import (
#       AppBundle, AppKind, BuildTarget, ImageRef, ValueFrom, BundleEnvVar,
#       Scaling, AppSpec, HttpCheck, GateOn, RunContainer, ValidateStep, Wave,
#   )
#   from kci_bundle_proto.deploy_model import (
#       ComputeIntent, DatastoreNeed, SecretBinding,
#   )
#
# Struct-only (no RPC client), so `komira_serde` is the only runtime dep. A
# generated package has no tests of its own: it is gated through the tests of
# the libraries that depend on it.
mojo_proto_library(
    name = "kci_bundle_proto",
    srcs = ["app_bundle.proto"],
    import_prefix = "kci/bundle/v1",
    proto_deps = ["//src/kci_deploy_model_proto:kci_deploy_model_proto"],
    bundle_proto_deps = True,
    deps = ["//src/komira_serde:komira_serde"],
    visibility = ["PUBLIC"],
)
