def komira_aws_route53_endpoint_rules() raises -> EndpointRuleSet:
    """The service's endpoint ruleset over the partition table, loaded and
        checked. Loading parses both documents: load once, resolve many."""
    return EndpointRuleSet(
        String(ROUTE53_ENDPOINT_RULESET), AwsPartitionSet(String(ROUTE53_PARTITIONS))
    )


struct Route53EndpointConfig(Copyable, Movable):
    """The endpoint ruleset's client-level parameters: its built-ins and the
        model's clientContextParams. Every field is unset until a caller sets it,
        and an unset one takes the ruleset's default. Nothing here reads the
        environment.
        """

    # `UseDualStack` (built-in AWS::UseDualStack)
    var use_dual_stack: Optional[Bool]
    # `UseFIPS` (built-in AWS::UseFIPS)
    var use_fips: Optional[Bool]
    # `Endpoint` (built-in SDK::Endpoint)
    var endpoint: Optional[String]
    # `Region` (built-in AWS::Region)
    var region: Optional[String]

    def __init__(out self):
        """Every parameter unset."""
        self.use_dual_stack = Optional[Bool]()
        self.use_fips = Optional[Bool]()
        self.endpoint = Optional[String]()
        self.region = Optional[String]()

    def __init__(out self, region: String):
        """Every parameter unset but `region`, which "" leaves unset too."""
        self = Self()
        if region.byte_length() > 0:
            self.region = Optional[String](region)

    def endpoint_params(self) -> EndpointParams:
        """The ruleset parameters this configuration sets."""
        var params = EndpointParams()
        if self.use_dual_stack:
            params.set_bool(String("UseDualStack"), self.use_dual_stack.value())
        if self.use_fips:
            params.set_bool(String("UseFIPS"), self.use_fips.value())
        if self.endpoint:
            params.set_string(String("Endpoint"), self.endpoint.value())
        if self.region:
            params.set_string(String("Region"), self.region.value())
        return params^


def resolve_change_resource_record_sets_endpoint(rules: EndpointRuleSet, config: Route53EndpointConfig, input: Route53ChangeResourceRecordSetsRequest) raises -> ResolvedEndpoint:
    """`ChangeResourceRecordSets` — the endpoint the ruleset chooses for this call: its URL,
        headers and properties (`authSchemes` says how to sign). An `error`
        rule's answer is raised with the ruleset's message."""
    var params = config.endpoint_params()
    var outcome = rules.resolve(params)
    if outcome.is_error:
        raise Error(
            String("komira_aws_route53: the endpoint ruleset chose no endpoint for ChangeResourceRecordSets: ") + outcome.error
        )
    return outcome.endpoint.copy()

def resolve_list_hosted_zones_by_name_endpoint(rules: EndpointRuleSet, config: Route53EndpointConfig, input: Route53ListHostedZonesByNameRequest) raises -> ResolvedEndpoint:
    """`ListHostedZonesByName` — the endpoint the ruleset chooses for this call: its URL,
        headers and properties (`authSchemes` says how to sign). An `error`
        rule's answer is raised with the ruleset's message."""
    var params = config.endpoint_params()
    var outcome = rules.resolve(params)
    if outcome.is_error:
        raise Error(
            String("komira_aws_route53: the endpoint ruleset chose no endpoint for ListHostedZonesByName: ") + outcome.error
        )
    return outcome.endpoint.copy()
