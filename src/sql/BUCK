load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The analytical SQL front end's tokenizer, parser, parsed AST, scalar-function table and catalogs: tokens, the statement parser, expression, relation and statement nodes, one row per SQL function name, the table and UDF catalogs a query resolves names against,
# the bind-time schemas and scan leaves of the read_csv / read_json / read_avro table functions (an iceberg_scan relation is resolved by the caller's reader before binding, like read_parquet),
# and the binder so far: output-column names, operator lowering, parquet facts and name scopes (sql_bind_names, sql_bind_interval, sql_bind_ops, sql_bind_parquet, sql_bind_scope),
# the expression binder (sql_bind_expr, sql_bind_decimal, sql_bind_call, sql_bind_cast, sql_bind_fn_args, sql_bind_fn_nested, sql_bind_timestamp),
# the aggregate, window and ORDER BY binders (sql_bind_agg_expr, sql_bind_aggregate, sql_bind_window_order),
# and the join, subquery and set-operation binders with the statement entry (sql_bind_join, sql_bind_subquery, sql_bind_union, sql_bind_set_op, sql_binder),
# the format and codec a COPY ... TO takes from its destination's extension (sql_copy_format),
# and the text entry over all three (sql_frontend: statement_from_sql, plan_from_sql).
