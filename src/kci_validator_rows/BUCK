load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The one shared positional row-accounting model every app validator
# uses, and its falsifier.
#
# A validator whose verdict is `passed_count() == total() and total() > 0`,
# where `total()` is the length of what the run EMITTED, prints PASS for a
# matrix that emitted a prefix of its rows and returned. This package accounts
# for rows POSITIONALLY, by name, against an authored list.
#
# It has no deps on purpose: pure `String` / `List` work, no runtime library,
# no FFI, no transport, no clock. (`live.mojo` adds one flushed `print` to
# fd 1, and that is all it adds.) That is what lets every validator take this
# dep for one line without dragging a closure in, and what makes the falsifier
# runnable with no process. Do not add deps.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:kci_validator_rows`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. It carries the README gate too (`[tests][readme]`): the examples
# run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "kci_validator_rows",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_validator_rows/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_validator_rows-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so
# this file exists only then. Publishing it (`mopm publish`) uploads, which is not a build action:
# it is a step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_validator_rows",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_validator_rows`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_validator_rows_conda",
    lib = ":kci_validator_rows",
    summary = "The `kci_validator_rows` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
