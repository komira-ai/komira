load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The one shared positional row-accounting model every app validator
# uses, and its falsifier.
#
# A validator whose verdict is `passed_count() == total() and total() > 0`,
# where `total()` is the length of what the run EMITTED, prints PASS for a
# matrix that emitted a prefix of its rows and returned. This package accounts
# for rows POSITIONALLY, by name, against an authored list.
#
# It has no deps on purpose: pure `String` / `List` work, no runtime library,
# no FFI, no transport, no clock. (`live.mojo` adds one flushed `print` to
# fd 1, and that is all it adds.) That is what lets every validator take this
# dep for one line without dragging a closure in, and what makes the falsifier
# runnable with no process. Do not add deps.
mojo_library(
    name = "kci_validator_rows",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_live_row.mojo",
        "tests/test_validator_rows.mojo",
    ],
    visibility = ["PUBLIC"],
)
