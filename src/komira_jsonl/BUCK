load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# JSON for the engine: the line splitter, the typed value parsers, schema
# inference, the columnar JSONL materializer (serial and fork-join parallel
# over komira_async), the streaming JSONL source, and the JSON / JSONL writers
# (columnar batches and the row format from komira_row_format); the structural
# index and the json_extract kernel are in komira_json_index.
# komira_runtime_paths is declared because tests/test_read_json_batch_e2e.mojo takes its scratch
# directory from `test_tmpdir()`.
mojo_library(
    name = "komira_jsonl",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_async:komira_async",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_json_index:komira_json_index",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_row_format:komira_row_format",
        "//src/komira_scan_source:komira_scan_source",
        "//src/komira_simd:komira_simd",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_columnar_materializer.mojo",
        "tests/test_columnar_materializer_branches.mojo",
        "tests/test_dtoa_parity.mojo",
        "tests/test_inference_paths.mojo",
        "tests/test_json_encode_utf8_roundtrip.mojo",
        "tests/test_jsonl_empty_records_and_partitions.mojo",
        "tests/test_jsonl_key_spelling_and_index.mojo",
        "tests/test_jsonl_line_check_branches.mojo",
        "tests/test_jsonl_line_validation.mojo",
        "tests/test_jsonl_nested_nulls.mojo",
        "tests/test_map_struct_parsers.mojo",
        "tests/test_nested_parsers.mojo",
        "tests/test_not_null_nonfinite.mojo",
        "tests/test_parse_float_exponent.mojo",
        "tests/test_read_json_batch_e2e.mojo",
        "tests/test_read_json_end_to_end.mojo",
        "tests/test_read_json_parallel.mojo",
        "tests/test_record_codec.mojo",
        "tests/test_schema_inference.mojo",
        "tests/test_simdjson_corpus.mojo",
        "tests/test_stream_split_helpers.mojo",
        "tests/test_value_parser_refusals.mojo",
        "tests/test_value_parsers.mojo",
        "tests/test_write_json.mojo",
        "tests/test_writer_every_type.mojo",
        "tests/test_writer_scalars_rows.mojo",
    ],
    # The corpus walk opens its fixtures by repository path from its
    # working directory.
    test_data = {
        "tests/test_simdjson_corpus.mojo": [
            "tests/fixtures/jsonl_corpus/array_lines.jsonl",
            "tests/fixtures/jsonl_corpus/array_rows_wide.jsonl",
            "tests/fixtures/jsonl_corpus/mixed_objects.jsonl",
        ],
    },
    visibility = ["PUBLIC"],
)
