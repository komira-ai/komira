load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A Parquet writer's encoders and page builders: the Thrift compact
# serializer for the footer, page headers and page indexes; the PageHeader
# i32 ceiling; column-chunk statistics (integer, FLOAT / DOUBLE, string); the
# string and numeric dictionary encoders; the fixed-width bit packer; the
# page index tracker; page-body compression and the schema builders; and the
# page builders that turn one Arrow column into one column chunk (PLAIN,
# DELTA_BINARY_PACKED, BYTE_STREAM_SPLIT, dictionary, Decimal128). It writes
# no file of its own: the file writer returns the bytes. It does not depend on
# the reader (komira_parquet); the tests do, as test_deps.
#
# The welded tests (each file's header says which defect it catches):
# - test_thrift_writer_direct: the serializer's bytes, read back by a
#   compact-protocol walker in the test: Statistics field 9 is nan_count,
#   the HLL registers are ColumnMetaData key-value metadata, the page index
#   and column_orders fields, the page headers.
# - test_page_size_limit_direct: the i32 ceiling, its error, and the setter
#   that lowers it for both header serialisers.
# - test_stats_direct: integer, DOUBLE and string statistics; null slots and
#   sliced arrays never enter min/max.
# - test_writer_float_stats_direct: parquet.thrift's floating-point rules
#   (no NaN in min/max, nan_count, signed zero).
# - test_writer_page_index_direct: BoundaryOrder in the type-defined order;
#   ColumnIndex and OffsetIndex bytes.
# - test_writer_bitpack_direct: the packer against a bit-at-a-time
#   reference at every width 1..64.
# - test_writer_helpers_direct: page-body compression round trips through
#   komira_parquet_codec, the schema builders, integer statistics bytes.
# - test_dict_encoder_direct: string and numeric dictionaries (first-seen
#   order, lossless float keys, the cardinality cap).
# - test_numeric_dict_preestimate: the numeric cardinality pre-estimate
#   refuses doomed builds and keeps every column the exact build keeps.
# - test_writer_encode_direct: definition levels of sliced arrays, PLAIN
#   fixed-width / BYTE_ARRAY / BOOLEAN pages read back by a page reader in
#   the test, statistics, compression, REQUIRED-with-null refused.
# - test_writer_delta_direct: DELTA_BINARY_PACKED against a decoder in the
#   test; deltas wider than the signed range; INT32 widths <= 32.
# - test_writer_bss_direct: BYTE_STREAM_SPLIT against its definition, and
#   the page of a sliced nullable column.
# - test_writer_dict_direct: the RLE index stream (width 0 is a run), string
#   and numeric dictionary chunks, sliced nullable numeric columns.
# - test_decimal_encode_direct: big-endian FLBA(16) values, signed-order
#   statistics, the schema element, invalid precision/scale refused.
# - test_file_writer_roundtrip: ParquetFileWriter's bytes decoded by
#   komira_parquet's reader (a separate implementation): every type and
#   null, four codecs, the footer's offsets and sizes, schema-order chunks,
#   dictionary-or-PLAIN by cardinality, statistics, a foreign page builder's
#   page.
# - test_file_writer_errors: a closed writer, a bad index, a repeated or
#   missing column, mismatched row counts, a null in a REQUIRED column.
# - test_encoded_column: encode_column_to_buffer's bytes equal the writer's,
#   and the column-parallel assembly decodes.
# - test_multi_batch_direct: two arrays (and n raw-byte arrays) encode to the
#   page the single-array encoder gives for their concatenation, byte for
#   byte, with the same statistics; nulls, slices, codecs.
# - test_multi_batch_stats_direct: chunk statistics folded across batches
#   equal the concatenation's (ints with HLL, floats with NaN and signed
#   zero), all-null and all-NaN publish no bounds.
# - test_advanced_writer_roundtrip: three row groups decoded by komira_parquet's
#   reader; chunks in schema order; the page CRC is the standard CRC-32 the
#   reader checks (and a flipped byte is refused); incomplete row groups and
#   bad chunks refused.
# - test_advanced_writer_index_bloom: ColumnIndex and OffsetIndex blobs decoded
#   by a decoder in the test (the location is the data page, past a dictionary
#   page); a chunk with no range gets no ColumnIndex; a bloom filter's header,
#   bitset and probes read back from the file.
# - test_no_env_reads: the package's sources read no environment, hold no
#   raw pointer in a public signature, and import only these deps. It is
#   staged every source `srcs` compiles.
_SRCS = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"])

mojo_library(
    name = "komira_parquet_writer",
    srcs = _SRCS,
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_dynamic_filter:komira_dynamic_filter",
        "//src/komira_parquet_api:komira_parquet_api",
        "//src/komira_parquet_codec:komira_parquet_codec",
        "//src/komira_simd:komira_simd",
        "//src/komira_zlib:komira_zlib",
    ],
    # The reader decodes the writer's bytes in the file-writer tests. It is
    # not a dependency of the library: a test-only package, never shipped.
    test_deps = ["//src/komira_parquet:komira_parquet"],
    test_data = {
        "tests/test_no_env_reads.mojo": {
            "src/" + f: f
            for f in _SRCS
        },
    },
    test_srcs = [
        "tests/test_advanced_writer_index_bloom.mojo",
        "tests/test_advanced_writer_roundtrip.mojo",
        "tests/test_decimal_encode_direct.mojo",
        "tests/test_dict_encoder_direct.mojo",
        "tests/test_encoded_column.mojo",
        "tests/test_file_writer_errors.mojo",
        "tests/test_file_writer_roundtrip.mojo",
        "tests/test_multi_batch_direct.mojo",
        "tests/test_multi_batch_stats_direct.mojo",
        "tests/test_no_env_reads.mojo",
        "tests/test_numeric_dict_preestimate.mojo",
        "tests/test_page_size_limit_direct.mojo",
        "tests/test_stats_direct.mojo",
        "tests/test_thrift_writer_direct.mojo",
        "tests/test_writer_bitpack_direct.mojo",
        "tests/test_writer_bss_direct.mojo",
        "tests/test_writer_delta_direct.mojo",
        "tests/test_writer_dict_direct.mojo",
        "tests/test_writer_encode_direct.mojo",
        "tests/test_writer_float_stats_direct.mojo",
        "tests/test_writer_helpers_direct.mojo",
        "tests/test_writer_page_index_direct.mojo",
    ],
    visibility = ["PUBLIC"],
)
