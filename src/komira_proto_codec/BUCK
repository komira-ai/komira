load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:defs.bzl", "mojo_test")
load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The `Serializable` / `WireFormat` codec runtime every generated protobuf
# message conforms to: one message description, serialized as protobuf-binary
# or proto3-canonical-JSON with the format chosen at compile time. Its
# dependencies (`komira_protobuf`, `komira_json`, `komira_encoding`) are small
# and dependency-free, so every generated client can import it cheaply.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The three libraries it
# imports are its mopm path dependencies (`[dependencies]` of mopm.toml); buildrules builds `:lib`
# from their own `:lib`, so it too waits for their tests.
mojo_package(path = ".")

# `:komira_proto_codec`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only
# once the tests have passed. `deps` is the Buck side of the `[dependencies]` of mopm.toml: the adopted
# labels of the same three packages. It carries the README gate too (`[tests][readme]`): the examples
# run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_proto_codec",
    lib = ":lib",
    deps = [
        "//src/komira_protobuf:komira_protobuf",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_json:komira_json",
    ],
    readme = "README.md",
    srcs = glob(["src/komira_proto_codec/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_proto_codec-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step
# of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
# It requires komira_encoding, komira_json and komira_protobuf at "0.1" (the version beside each path in
# mopm.toml), which the registry serves once those packages are published.
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_20",
    package = "komira_proto_codec",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/artifacts.textproto): komira's conda
# packer over `:komira_proto_codec`. It goes when the release machine takes the mopm package. This
# library's mopm package is `:conda` above.
conda_package(
    name = "komira_proto_codec_conda",
    lib = ":komira_proto_codec",
    summary = "The `komira_proto_codec` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

# The tests below need a generated message type, which is built from the library, so they
# are not tests of `tests/` (the files `mopm.toml` lists, which `:lib` waits for): they are in
# generated_tests/ and are built by komira's rules over the adopted library.

# A generated message must survive being copied as a list element. Mojo 1.0.0
# treats a struct's synthesized copy constructor as trivial for some layouts
# (three Optional[String] plus an Optional[Bool] or Optional[Int64], in a
# struct with an explicit `__deinit__`), after which `List.copy()` and
# `List.extend` copy the elements with a memcpy and the copy shares its String
# buffers with the original. The messages in `generated_tests/copy_hazard.proto` cover
# those layouts, plain fields, and every other storage shape the generator
# emits (repeated, map, nested message, enum, bytes, oneof arms).
mojo_proto_library(
    name = "copy_hazard_proto",
    srcs = ["generated_tests/copy_hazard.proto"],
    import_prefix = "example",
    deps = [":komira_proto_codec"],
)

# A generated message with one field of every presence kind: its welded test
# checks which fields its generated `encode` writes into proto3 JSON at their
# default value (implicit presence omitted, explicit presence written) and
# that the binary encoding is unchanged.
mojo_proto_library(
    name = "implicit_presence_proto",
    srcs = ["generated_tests/implicit_presence.proto"],
    import_prefix = "example",
    deps = [":komira_proto_codec"],
    test_srcs = ["generated_tests/test_implicit_presence_json.mojo"],
)

mojo_test(
    name = "test_copy_hazard",
    srcs = ["generated_tests/test_copy_hazard.mojo"],
    deps = [
        ":komira_proto_codec",
        ":copy_hazard_proto",
    ],
)

# Exhaustive round trip of the proto3-JSON float32 writer and reader over
# four whole binades (about 34 million values; see the file header). Too slow
# for the welded gate above, which samples every binade instead.
mojo_test(
    name = "test_float32_json_binades",
    srcs = ["generated_tests/test_float32_json_binades.mojo"],
    deps = [":komira_proto_codec"],
    optimization_level = "3",
)
