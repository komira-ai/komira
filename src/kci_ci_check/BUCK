load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The workflow consistency check: a hand-written CI workflow
# (.github/workflows/kci.yml) held to the machine file's stage graph. It is
# library code, not a command: the welded test that holds this repository's
# kci.yml to release/machine.textproto uses it, and `kci run` runs it at
# start-up on the workflow it runs under (`check_running_workflow`). The
# machine file owns the graph; the workflow must agree: one job per stage with
# the stage's name, running in the stage's environment, `needs` = the stage's
# `after`, `id-token: write` exactly on the stages that publish by OIDC
# trusted publishing or are farm-connected, the farm-connect action exactly on
# the farm-connected stages, one literal `kci run --stage <id>` per job with a
# `--summary-file`, no pull_request trigger, a `revision` input on
# workflow_dispatch, every `uses:` pinned to a commit id (the farm-connect
# action excepted), no `--only` on a release job unless the stage is SPLIT
# (the job named after the stage runs its steps, other jobs run its
# validations, and together they run each step and validation exactly once;
# a validations job holds no environment and no id-token and needs the step
# job), and every `kci run` reading the machine file being checked (the
# default, or its `--machine`).
#
# The workflow is read by a RESTRICTED reader of the YAML subset it uses;
# anything else (anchors, aliases, tags, flow mappings, tabs, a second document)
# is "cannot tell", never a pass. actionlint (//:workflow_lint) stays the YAML
# validity gate.
#
# Deps: kci_stage_graph (the graph), kci_release_channel (which channels
# publish by OIDC) and kci_contract (the default machine file). Pure: it
# checks text it is given.
mojo_library(
    name = "kci_ci_check",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_contract:kci_contract",
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_stage_graph:kci_stage_graph",
    ],
    test_srcs = [
        # what the restricted reader reads, and each construct it cannot tell
        "tests/test_workflow_reader.mojo",
        # a fixture that agrees, one mutation per rule R1-R12, the id-token
        # stages, the start-up entry point
        "tests/test_ci_rules.mojo",
        # one stage split over jobs whose --only parts run all of it once
        # (R1 and R9 as amended)
        "tests/test_ci_split_stage.mojo",
    ],
    visibility = ["PUBLIC"],
)
