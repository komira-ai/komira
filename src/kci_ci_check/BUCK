load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# `kci ci check`: a hand-written CI workflow (.github/workflows/kci.yml) held to
# the machine file's stage graph. The machine file owns the graph; the workflow
# must agree: one job per stage with the stage's name and environment, `needs`
# = the stage's `after`, `id-token: write` exactly on the stages that publish by
# OIDC trusted publishing, one literal `kci run --stage <id>` per job, no
# pull_request trigger, a `revision` input on workflow_dispatch, every `uses:`
# pinned to a commit id.
#
# The workflow is read by a RESTRICTED reader of the YAML subset it uses;
# anything else (anchors, aliases, tags, flow mappings, tabs, a second document)
# is "cannot tell", never a pass. actionlint (//:workflow_lint) stays the YAML
# validity gate.
#
# Deps: kci_stage_graph (the graph) and kci_release_channel (which channels
# publish by OIDC). Pure: it checks text it is given.
mojo_library(
    name = "kci_ci_check",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_release_channel:kci_release_channel",
        "//src/kci_stage_graph:kci_stage_graph",
    ],
    test_srcs = [
        # what the restricted reader reads, and each construct it cannot tell
        "tests/test_workflow_reader.mojo",
        # a fixture that agrees, one mutation per rule R1-R8, the id-token stages
        "tests/test_ci_rules.mojo",
        # the repository's own kci.yml held to its own release/machine.textproto
        "tests/test_repo_kci_yml.mojo",
    ],
    # The repository's own release workflow, machine file and channels file
    # (the root BUCK and release/BUCK).
    test_data = {
        "tests/test_repo_kci_yml.mojo": {
            "channels.textproto": "//release:channels.textproto",
            "kci.yml": "//:kci.yml",
            "machine.textproto": "//release:machine.textproto",
        },
    },
    visibility = ["PUBLIC"],
)
