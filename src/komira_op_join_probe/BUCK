load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The probe side of the engine's joins: the composite-key hash join
# (`MultiKeyHashJoinBuilder`, its INNER / LEFT / SEMI / ANTI / RIGHT / FULL
# probes, its parallel build and parallel INNER probe over the engine's
# dispatcher), the extraction of join-key columns into its key slots, the
# composite join probe operator, the deferred-output records of the
# streaming join probe with their deferral rule and lever witnesses, the
# radix-partitioned single-key hash join, the SEMI / ANTI key set, and the
# joins whose condition carries a residual predicate (serial, and the parallel
# SEMI / ANTI mark join), and the join probe over whole batches: every join
# type and single-key strategy, the sort-merge joins, the join output schema;
# and the streaming join probe operators over a morsel: the single-key
# `JoinProbeOp` (resumable INNER, deferred INNER output, LEFT / SEMI / ANTI)
# and the composite-key `MultiKeyJoinProbeOp` (INNER).
