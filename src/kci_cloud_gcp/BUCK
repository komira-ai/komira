load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The GCP cloud adapter's foundations (docs/design/deploy_step.md, row G4):
# the objects' names and the IAM role table, a container job's run node as a
# Cloud Run job, the session over komira's generated GCP clients (IAM service
# accounts and policies, Cloud Resource Manager's project policy, Cloud Run
# jobs) and komira_gcp_core (the token source seam, the status envelope, the
# token-information read), and the reader a deploy's credentials go to (the
# Application Default Credentials chain for a service_account file).
#
# The welded tests touch no network: the role table's injectivity, the
# derived names, the job model (where each field of a run node lands in a
# Cloud Run job), and the credential choice over komira_gcp_core's MapEnv and
# MapFiles.
mojo_library(
    name = "kci_cloud_gcp",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/kci_cloud:kci_cloud",
        "//src/kci_reconciler:kci_reconciler",
        "//src/kci_resource_proto:kci_resource_proto",
        "//src/komira_async:komira_async",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_gcp_cloudresourcemanager:komira_gcp_cloudresourcemanager",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_gcp_iam:komira_gcp_iam",
        "//src/komira_gcp_run:komira_gcp_run",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        "//src/komira_proto_codec:komira_proto_codec",
        "//src/komira_retry:komira_retry",
        "//src/komira_validation_run:komira_validation_run",
        "//src/komira_wkt:komira_wkt",
    ],
    test_srcs = [
        "tests/test_gcp_names_and_roles.mojo",
        "tests/test_gcp_job_model.mojo",
        "tests/test_gcp_credentials.mojo",
    ],
    visibility = ["PUBLIC"],
)
