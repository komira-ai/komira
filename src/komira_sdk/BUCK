load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The plan-building half of the Mojo SDK, first part: aggregate output naming,
# the derived row schema, statement-scoped CTE bindings, Parquet read options,
# the plan validator, table display, select/with_columns aggregate lowering,
# the filter refusals, join helpers, the row UDF chains and the alias, concat,
# drop_nulls, rename and with_columns plan builders; and the plan-time Parquet
# footer reads (row count and Arrow schema, through komira_parquet).
#
# deps is the full transitive closure, the deps of komira_udf (row_udf_chain's
# row UDF types) included; komira_op_agg_state and what it needs
# (komira_agg, komira_expr, komira_hash, komira_kernels) are there for the
# welded test_display_stats only, which tests its statistical accumulators.
# komira_runtime_paths is likewise for tests only (the scratch directory).
mojo_library(
    name = "komira_sdk",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_agg:komira_agg",
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
