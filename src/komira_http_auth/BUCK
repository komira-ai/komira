load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Bearer-JWT authentication for komira_http_server: BearerJwtMiddleware[V] in
# the server's auth slot, and Rs256JwksVerifier, which checks RS256 tokens of
# one issuer against that issuer's JWK Set (fetched over HTTPS, cached) with
# komira_crypto's RS256 verifier. Configured by flags (flags.mojo).
#
# The tests that sign tokens read komira_http_core's RSA test key (exported
# there); the vocabulary test reads the library's own sources.

_KEY = {
    "src/komira_http_core/tests/fixtures/tls/leaf_key.pem": "//src/komira_http_core:tests/fixtures/tls/leaf_key.pem",
}

mojo_library(
    name = "komira_http_auth",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_http_server:komira_http_server",
        "//src/komira_json:komira_json",
    ],
    test_srcs = [
        "tests/test_claims.mojo",
        "tests/test_flags.mojo",
        "tests/test_header_gate.mojo",
        "tests/test_https_fetcher.mojo",
        "tests/test_jwks_cache.mojo",
        "tests/test_middleware.mojo",
        "tests/test_no_product_vocabulary.mojo",
    ],
    test_deps = ["//src/tests/helpers/komira_test_vocabulary:komira_test_vocabulary"],
    test_data = {
        "tests/test_claims.mojo": _KEY,
        "tests/test_flags.mojo": _KEY,
        "tests/test_header_gate.mojo": _KEY,
        "tests/test_jwks_cache.mojo": _KEY,
        "tests/test_middleware.mojo": _KEY,
        "tests/test_no_product_vocabulary.mojo": glob(
            ["**/*.mojo"],
            exclude = ["tests/**/*.mojo"],
        ),
    },
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
