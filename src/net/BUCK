load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Host resolution above the socket layer: the DNS resolver and the IpAddr and
# SockAddr value types. It imports `async_rt.reactor.socket_setup` (the
# loopback helper) and nothing else outside the standard library, so its one
# dependency is async_rt. TCP stays in async_rt.
mojo_library(
    name = "net",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/async_rt:async_rt",
    ],
    test_srcs = [
        "tests/test_dns_addrinfo_offsets.mojo",
        "tests/test_dns_hints.mojo",
        "tests/test_dns_literal.mojo",
        "tests/test_dns_resolve.mojo",
        "tests/test_dns_literal_edges.mojo",
        "tests/test_dns_resolve_errors.mojo",
        "tests/test_dns_transient.mojo",
        "tests/test_dns_targets.mojo",
    ],
    visibility = ["PUBLIC"],
)
