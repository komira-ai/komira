load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Read a pipeline run's stage logs: compose the run-log route's URL, drain its
# `?after=&limit=` cursor over a transport trait, parse each page through a
# field allow-list, and render a bounded, redacted tail for an operator. It has
# no deps and never raises: it is an enrichment on a failure path.
mojo_library(
    name = "komira_run_logs",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_empty_stream_speaks_its_own_stream.mojo",
        "tests/test_run_log_reader.mojo",
    ],
    visibility = ["PUBLIC"],
)
