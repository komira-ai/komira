load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The single home of each shared libc/POSIX `external_call` declaration
# (`getenv`, `access`, `pthread_self`) and the shared LZ4 raw-block codec. It
# has no first-party deps by design: every other package may depend on it.
# liblz4 is loaded at run time with dlopen, so there is no link dep.
mojo_library(
    name = "komira_core_ffi",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = [
        "tests/test_lz4_codec.mojo",
        "tests/test_posix_read_env.mojo",
        "tests/test_thread_self_discriminates.mojo",
    ],
    visibility = ["PUBLIC"],
)
