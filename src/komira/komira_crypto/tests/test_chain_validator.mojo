def _now_2025() -> Tuple[UInt16, UInt8, UInt8, UInt8, UInt8, UInt8]:
    return (UInt16(2025), UInt8(6), UInt8(15), UInt8(12), UInt8(0), UInt8(0))


def _now_2035() -> Tuple[UInt16, UInt8, UInt8, UInt8, UInt8, UInt8]:
    """Past not_after (2034-01-01); used for expired-cert test."""
    return (UInt16(2035), UInt8(6), UInt8(15), UInt8(12), UInt8(0), UInt8(0))


def _now_2023() -> Tuple[UInt16, UInt8, UInt8, UInt8, UInt8, UInt8]:
    """Before not_before (2024-01-01); used for not-yet-valid test."""
    return (UInt16(2023), UInt8(6), UInt8(15), UInt8(12), UInt8(0), UInt8(0))


def _build_chain() raises -> List[X509Certificate]:
    """Build a leaf-first chain [leaf, intermediate] (root is the
    trust anchor, not in the chain itself)."""
    var leaf = x509_parse_certificate(_leaf_cert_der())
    var inter = x509_parse_certificate(_intermediate_cert_der())
    var chain = List[X509Certificate]()
    chain.append(leaf^)
    chain.append(inter^)
    return chain^


def _build_trust_anchors() raises -> List[X509Certificate]:
    var root = x509_parse_certificate(_root_cert_der())
    var anchors = List[X509Certificate]()
    anchors.append(root^)
    return anchors^


def test_valid_chain_verifies() raises:
    """The full 3-cert chain (leaf + intermediate + root anchor) verifies
    successfully at a time inside all validity periods."""
    var chain = _build_chain()
    var anchors = _build_trust_anchors()
    var ok = chain_verify(chain, anchors, _now_2025())
    assert_true(ok, "valid 3-cert ECDSA chain should verify")


def test_chain_rejects_expired_leaf() raises:
    """When `now` is past the leaf's not_after, chain_verify raises."""
    var chain = _build_chain()
    var anchors = _build_trust_anchors()
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2035())
    except:
        caught = True
    assert_true(caught, "chain past not_after must raise")


def test_chain_rejects_not_yet_valid() raises:
    """When `now` is before the leaf's not_before, chain_verify raises."""
    var chain = _build_chain()
    var anchors = _build_trust_anchors()
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2023())
    except:
        caught = True
    assert_true(caught, "chain before not_before must raise")


def test_chain_rejects_tampered_leaf_signature() raises:
    """Flipping a byte in the leaf signature must cause chain_verify to
    reject (signature verification fails at leaf -> intermediate link)."""
    # Build the chain, then tamper a byte in the leaf signature_value.
    var leaf = x509_parse_certificate(_leaf_cert_der())
    var inter = x509_parse_certificate(_intermediate_cert_der())
    # Flip last byte of signature_value
    if len(leaf.signature_value) > 0:
        var last_idx = len(leaf.signature_value) - 1
        leaf.signature_value[last_idx] = leaf.signature_value[last_idx] ^ UInt8(0xFF)
    var chain = List[X509Certificate]()
    chain.append(leaf^)
    chain.append(inter^)
    var anchors = _build_trust_anchors()
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2025())
    except:
        caught = True
    assert_true(caught, "tampered leaf signature must raise")


def test_chain_rejects_tampered_intermediate_signature() raises:
    """Flipping a byte in the intermediate signature must cause
    chain_verify to reject (signature verification fails at the
    intermediate -> root anchor link)."""
    var leaf = x509_parse_certificate(_leaf_cert_der())
    var inter = x509_parse_certificate(_intermediate_cert_der())
    if len(inter.signature_value) > 0:
        var last_idx = len(inter.signature_value) - 1
        inter.signature_value[last_idx] = inter.signature_value[last_idx] ^ UInt8(0xFF)
    var chain = List[X509Certificate]()
    chain.append(leaf^)
    chain.append(inter^)
    var anchors = _build_trust_anchors()
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2025())
    except:
        caught = True
    assert_true(caught, "tampered intermediate signature must raise")


def test_chain_rejects_tampered_tbs() raises:
    """Flipping a byte in the leaf's tbs_raw (the bytes the signature is
    computed over) must cause chain_verify to reject."""
    var leaf = x509_parse_certificate(_leaf_cert_der())
    var inter = x509_parse_certificate(_intermediate_cert_der())
    # Tamper a byte well inside tbs_raw (avoid the outer SEQUENCE header).
    if len(leaf.tbs_raw) > 20:
        leaf.tbs_raw[20] = leaf.tbs_raw[20] ^ UInt8(0xFF)
    var chain = List[X509Certificate]()
    chain.append(leaf^)
    chain.append(inter^)
    var anchors = _build_trust_anchors()
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2025())
    except:
        caught = True
    assert_true(caught, "tampered leaf tbs_raw must raise")


def test_chain_rejects_no_trust_anchor() raises:
    """An empty trust_anchors list must cause chain_verify to raise."""
    var chain = _build_chain()
    var empty = List[X509Certificate]()
    var caught = False
    try:
        var _ok = chain_verify(chain, empty, _now_2025())
    except:
        caught = True
    assert_true(caught, "empty trust_anchors must raise")


def test_chain_rejects_empty_chain() raises:
    """An empty chain list must cause chain_verify to raise."""
    var empty_chain = List[X509Certificate]()
    var anchors = _build_trust_anchors()
    var caught = False
    try:
        var _ok = chain_verify(empty_chain, anchors, _now_2025())
    except:
        caught = True
    assert_true(caught, "empty chain must raise")


def test_chain_terminal_is_self_in_anchors() raises:
    """A chain of just [intermediate] (length 1) where the intermediate's
    subject DN matches a trust anchor's subject DN verifies (since the
    terminal IS itself a trust anchor by subject byte-equal)."""
    # We use the root cert as a 1-cert chain (and root is in trust_anchors).
    # This tests Case A: terminal subject byte-equal to anchor subject.
    var root = x509_parse_certificate(_root_cert_der())
    var chain = List[X509Certificate]()
    chain.append(root^)
    var anchors = _build_trust_anchors()
    # Root cert has cA=true and a self-signed identity. Per validate_leaf,
    # the leaf-position cert must NOT lack digital-sig (CAs typically have
    # KU=keyCertSign only). Our root cert was built with keyCertSign+crlSign
    # only, no digitalSignature/keyEncipherment/keyAgreement — so the
    # validate_leaf check should reject it. This negative-test verifies
    # that the "terminal == anchor" case still goes through leaf-position
    # checks (which is the safe semantic per RFC 5280).
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2025())
    except:
        caught = True
    assert_true(caught, "Root cert as 1-cert chain fails leaf-position checks")


def main() raises:
    test_valid_chain_verifies()
    test_chain_rejects_expired_leaf()
    test_chain_rejects_not_yet_valid()
    test_chain_rejects_tampered_leaf_signature()
    test_chain_rejects_tampered_intermediate_signature()
    test_chain_rejects_tampered_tbs()
    test_chain_rejects_no_trust_anchor()
    test_chain_rejects_empty_chain()
    test_chain_terminal_is_self_in_anchors()
    print("All 9 chain_verify tests PASSED")
