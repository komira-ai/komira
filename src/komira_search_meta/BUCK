load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The search split registry: the `SplitSummary` record and its binary codec,
# `SearchMetastore` over one append-only manifest lineage (publish, list,
# retire, reap), the cross-shard read over per-writer sub-lineages, and the
# reaper for drained writer shards. Generic over komira_objectstore's
# conditional-write stores; it names no cloud client.
#
# The welded tests run against the in-memory stores, with no network. One
# drives the publish race between independent writers (a staged collision and
# real OS threads), the other the per-writer sharded layout: first-attempt
# appends, the cross-shard merge, generation, reads of unsharded indexes, and
# merged splits hiding their inputs across shards. Both import komira_core
# for its slab collection.
mojo_library(
    name = "komira_search_meta",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_core:komira_core",
        "//src/komira_objectstore:komira_objectstore",
    ],
    test_srcs = [
        "tests/test_search_metastore_concurrent.mojo",
        "tests/test_search_sublineage_sharding.mojo",
    ],
    visibility = ["PUBLIC"],
)
