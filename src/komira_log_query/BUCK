load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Query a log a service writes to an object store: format-neutral hit and
# page values, the `ServiceLogSearch` trait with a type-erased facade a service
# holds as one field, the `LogReadAccess` hook the service supplies, and the
# `GET <path>` route. A leaf on `komira_http_core` alone. The welded test drives
# the route over a fake `ServiceLogSearch` and fake access hooks.
mojo_library(
    name = "komira_log_query",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_srcs = ["tests/test_service_log_route.mojo"],
    deps = [
        "//src/komira_http_core:komira_http_core",
    ],
    visibility = ["PUBLIC"],
)
