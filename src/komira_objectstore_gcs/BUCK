load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Google Cloud Storage over the komira_objectstore traits, without a wire
# client: the narrow object-verb seam (`GcsStorageBackend`), an in-memory
# conformer of it for hermetic tests (`FakeGcsStorageBackend`), the
# `ConditionalWriteStore` conformer over the seam (`GcsConditionalStore`), the
# `FileSystem` read conformer over the seam (`GcsFs`), and the StoreError kind
# reader; and the `ObjectUrlSigner` conformer (`GcsV4Signer`) over
# komira_gcp_core's V4 signing, on a caller-supplied clock (the production
# one, `SystemGcsSigningClock`, is komira_clock's wall clock). The
# google.storage.v2 gRPC backend is a separate conformer of the object-verb
# seam and lands with the gRPC client.
#
# test_gcs_presign_portability signs with Google's published inactive dummy
# service account and checks the signer against Google's published V4 URLs,
# both read from the archive //third_party/googleapis_conformance_tests pins
# by sha256 and staged at conformance/. test_system_signing_clock signs with
# the same account at the wall clock. Both parse the account with komira_json
# and load its PEM key with komira_crypto, declared below for those tests
# alone (the library itself imports neither).
# test_env_source_only scans the package's own sources, staged as its data,
# for any environment read; nothing here is exempt.
mojo_library(
    name = "komira_objectstore_gcs",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_clock:komira_clock",
        "//src/komira_core:komira_core",
        # For the tests only: mojo_library has no test-only deps, and they
        # load the dummy account's PEM key with komira_crypto's
        # `rsa_pkcs8_der_from_pem`.
        "//src/komira_crypto:komira_crypto",
        "//src/komira_gcp_core:komira_gcp_core",
        # For the tests only: they parse the conformance JSON with it.
        "//src/komira_json:komira_json",
        "//src/komira_objectstore:komira_objectstore",
    ],
    test_srcs = [
        "tests/test_gcs_conditional_store.mojo",
        "tests/test_gcs_fs_backend.mojo",
        "tests/test_gcs_presign_portability.mojo",
        "tests/test_system_signing_clock.mojo",
        "tests/test_env_source_only.mojo",
    ],
    test_data = {
        "tests/test_env_source_only.mojo": glob(["*.mojo"]),
        "tests/test_gcs_presign_portability.mojo": {
            "conformance": "//third_party/googleapis_conformance_tests:files",
        },
        "tests/test_system_signing_clock.mojo": {
            "conformance": "//third_party/googleapis_conformance_tests:files",
        },
    },
    visibility = ["PUBLIC"],
)
