load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Google Cloud Storage over the komira_objectstore traits, without a wire
# client: the narrow object-verb seam (`GcsStorageBackend`), an in-memory
# conformer of it for hermetic tests (`FakeGcsStorageBackend`), the
# `ConditionalWriteStore` conformer over the seam (`GcsConditionalStore`), the
# `FileSystem` read conformer over the seam (`GcsFs`), and the StoreError kind
# reader; and the `ObjectUrlSigner` conformer (`GcsV4Signer`) over
# komira_gcp_core's V4 signing, on a caller-supplied clock. The
# google.storage.v2 gRPC backend is a separate conformer of the object-verb
# seam and lands with the gRPC client.
#
# test_gcs_presign_portability signs with Google's published inactive dummy
# service account, read from the archive //third_party/googleapis_conformance_tests
# pins by sha256 and staged at conformance/.
mojo_library(
    name = "komira_objectstore_gcs",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_core:komira_core",
        "//src/komira_gcp_core:komira_gcp_core",
        "//src/komira_objectstore:komira_objectstore",
    ],
    test_srcs = [
        "tests/test_gcs_conditional_store.mojo",
        "tests/test_gcs_fs_backend.mojo",
        "tests/test_gcs_presign_portability.mojo",
    ],
    test_data = {
        "tests/test_gcs_presign_portability.mojo": {
            "conformance": "//third_party/googleapis_conformance_tests:files",
        },
    },
    visibility = ["PUBLIC"],
)
