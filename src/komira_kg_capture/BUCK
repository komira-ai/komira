load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The capture server of the knowledge-graph port (docs/design/knowledge_graph_port.md), core
# half: a komira_http_server dispatcher over a snapshot store with a health route, a capture
# route that hands a pushed record to the adapter registered under its surface tag and ingests
# the episodes, a structured-ingest route, and a CaptureRoutes seam for a host's own routes.
# Every route but health needs a bearer token the host passes in, bodies are limited, and the
# server takes its clock as an argument; it reads no environment. The query routes are the
# next part. No kind of record, service or vocabulary is named here.
#
# The welded tests: test_http_util pins the query-string, bearer-token and label checks and the
# JSON writers (multi-byte text and control bytes unchanged); test_structured the structured
# body (required and defaulted fields, a wrong type refused); test_config_clock the
# configuration's refusals and the clocks; test_capture_route the capture route over two
# made-up adapters (the episode a push becomes, the tag choosing the adapter, an unregistered
# tag refused, the clock stamping, folding the chain); test_structured_route the structured
# route; test_auth_limits an unauthenticated request to every route but health refused, the
# body limit and the methods; test_extra_routes a host route reachable only when registered;
# test_loopback the same server on a loopback port.
mojo_library(
    name = "komira_kg_capture",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    # The full transitive closure of the Mojo libraries this package and its tests build on.
