load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")

# The artifacts schema (`kci.release.v1`): the reviewed list of
# what kci builds and publishes. A file declares build systems (a program and
# the flags it always gets) and artifacts (a name, the build system that
# builds it and the args appended for it). kci knows no
# build tool by name; the build rules (an empty `{out_dir}`; one artifact per
# entry, so exactly one kci artifact manifest, `manifest.json`, left at
# its top, whose `name` is the artifact's) are in the .proto. Standalone: the .proto
# imports no other proto.
#
#   from kci_artifact_proto.artifact import (
#       Artifacts, Artifact, BuildSystem)
#
# Reading, validating and rendering a build's argv is
# `//src/kci_artifact`, whose welded tests also round-trip this
# schema on the proto binary wire with every field number pinned as bytes.
# `test_srcs` welds this package to its own wire test: every field of every
# message written out as bytes (tests/test_artifact_wire.mojo).
# Other `.proto` files import it as `kci/release/v1/artifact.proto`.
mojo_proto_library(
    name = "kci_artifact_proto",
    srcs = ["artifact.proto"],
    import_prefix = "kci/release/v1",
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    test_srcs = ["tests/test_artifact_wire.mojo"],
    visibility = ["PUBLIC"],
)
