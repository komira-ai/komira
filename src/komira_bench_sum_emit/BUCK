load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")
load(":sum_bench.bzl", "sum_emit_bench")

# A benchmark of SQL `sum()` over INT32 and INT64 columns through `run_sql`,
# ungrouped and grouped, with a `min()` control. README.md says what it
# measures, how to run it and how far to trust it.
#
# The welded tests (each file's header says what it proves):
# - test_stats: median and quartiles of a few samples.
# - test_cli: the defaults and every refusal of the command line.
# - test_bench: a small table run through every statement: the JSON is
#   complete and every answer matches the generator's totals.
mojo_library(
    name = "komira_bench_sum_emit",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo", "main/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_engine_runtime:komira_engine_runtime",
        "//src/komira_lowering:komira_lowering",
        "//src/komira_optimizer:komira_optimizer",
        "//src/komira_parquet:komira_parquet",
        "//src/komira_parquet_footers:komira_parquet_footers",
        "//src/komira_parquet_writer:komira_parquet_writer",
        "//src/komira_plan_ir:komira_plan_ir",
        "//src/komira_scalar_arithmetic:komira_scalar_arithmetic",
        "//src/komira_sdk_exec:komira_sdk_exec",
        "//src/komira_sql:komira_sql",
    ],
    test_deps = [
        "//src/komira_pipeline_exec:komira_pipeline_exec",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_bench.mojo",
        "tests/test_cli.mojo",
        "tests/test_stats.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The bench program.
mojo_binary(
    name = "komira_bench_sum_emit_main",
    srcs = ["main/bench_main.mojo"],
    main = "main/bench_main.mojo",
    deps = [":komira_bench_sum_emit"],
    visibility = ["PUBLIC"],
)

# The bench on the build farm. Its output directory holds sum_emit.json:
#
#   ./buck2 build komira//src/komira_bench_sum_emit:sum_emit_bench
#   ./buck2 build komira//src/komira_bench_sum_emit:sum_emit_bench[sum_emit.json] --show-output
sum_emit_bench(
    name = "sum_emit_bench",
    bench = ":komira_bench_sum_emit_main",
)
