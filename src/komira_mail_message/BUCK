load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Email messages over bytes: compose and parse RFC 5322 messages with MIME
# (RFC 2045-2049, RFC 2183, RFC 2231) and RFC 2047 encoded words. Addresses
# are komira_mail_address values; base64 is komira_encoding. See
# src/komira_mail_message/__init__.mojo.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# komira_buffer, komira_datetime, komira_encoding and komira_mail_address, sibling packages
# (`[dependencies]` of mopm.toml): its `:lib` is built from their `:lib`.
mojo_package(path = ".")

# `:komira_mail_message`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only
# once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages: the rule refuses a list that is not the closure `:lib` was built from. It carries the
# README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_mail_message",
    deps = [
        "//src/komira_buffer:komira_buffer",
        "//src/komira_datetime:komira_datetime",
        "//src/komira_encoding:komira_encoding",
        "//src/komira_mail_address:komira_mail_address",
    ],
    # komira_libc (through komira_buffer) links C, so `lib`'s closure carries that archive and a
    # dependent's link takes it from here. This package owns no C, so it names no `c_deps`: it takes
    # the C toolchain's link facts directly.
    cxx_toolchain = "komira//tools/build/mojo:adopt_cxx_link_facts",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_mail_message/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_mail_message-0.1.0-mojo1.0.0_0.conda`), which records komira_buffer, komira_datetime,
# komira_encoding and komira_mail_address as dependencies (`mojo-<name> >=0.1,<0.2`) and holds none of
# their files. `members` is the manifests of the path dependencies of the closure, staged at their
# repository paths, because `mopm pack` reads the manifest of each beside the one it is given. `:lib`
# exists only once the tests passed, so this file exists only then. Publishing it (`mopm publish`)
# uploads, which is not a build action: it is a step of a CI job that takes this target's output.
# `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_mail_message",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_buffer": "//src/komira_buffer:mopm.toml",
        "../komira_datetime": "//src/komira_datetime:mopm.toml",
        "../komira_encoding": "//src/komira_encoding:mopm.toml",
        "../komira_host": "//src/komira_host:mopm.toml",
        "../komira_libc": "//src/komira_libc:mopm.toml",
        "../komira_mail_address": "//src/komira_mail_address:mopm.toml",
        "../komira_simd": "//src/komira_simd:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_mail_message",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/`, and exactly four dependencies, which is what installing
# the package pulls in. Red when the manifest drops a dependency, names another range, or the file
# carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_buffer >=0.1,<0.2",
        "mojo-komira_datetime >=0.1,<0.2",
        "mojo-komira_encoding >=0.1,<0.2",
        "mojo-komira_mail_address >=0.1,<0.2",
    ],
    package = "komira_mail_message",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_mail_message`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_mail_message_conda",
    lib = ":komira_mail_message",
    summary = "The `komira_mail_message` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
