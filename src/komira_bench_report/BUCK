load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The result model and report of a benchmark run: every run of a cell with its
# page faults, a cell's first run and steady-state time (the median of each
# sweep's runs after its first, the least of the sweeps), the verdicts of a cell, the environment fingerprint, the result.json writer and strict reader
# (schema komira-bench-result/3; schemas 2 and 1 are still read), the counts and geomean per suite, and the
# human table. Pure data and text: it runs no engine and reads no file.
#
# The tests (each file's header says which behaviour it proves):
# - test_stats: exact medians, the sweep statistic, geomean and ratio on fixed
#   inputs, and the inputs they refuse.
# - test_summary: when a cell has a ratio, the verdict against a threshold that
#   is a parameter, the denominators, the geomean per suite, the PASS line.
# - test_json_schema: the writer and reader round trip, and every way the
#   reader refuses a document that departs from the schema.
# - test_table: the table of a fixed result, byte for byte.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# komira_json, a sibling package (`[dependencies]` of mopm.toml): its `:lib` is built from that
# package's `:lib`.
mojo_package(path = ".")

# `:komira_bench_report`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are
# not run again.
mojo_adopted_library(
    name = "komira_bench_report",
    deps = ["//src/komira_json:komira_json"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_bench_report/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_bench_report-0.1.0-mojo1.0.0_0.conda`), which records komira_json as a dependency
# (`mojo-komira_json >=0.1,<0.2`) and holds that package's files nowhere. `members` is the manifest
# of the path dependency, staged at its repository path, because `mopm pack` reads the manifest of
# each beside the one it is given. `:lib` exists only once the tests passed, so this file exists
# only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step of a
# CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_bench_report",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../komira_json": "//src/komira_json:mopm.toml"},
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_bench_report",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/` (komira_json is not in it), and exactly one
# dependency, `mojo-komira_json >=0.1,<0.2`, which is what installing the package pulls in. Red when
# the manifest drops the dependency, names another range, or the file carries the sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_json >=0.1,<0.2"],
    package = "komira_bench_report",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_bench_report`. It goes when the release machine takes the
# mopm package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_bench_report_conda",
    lib = ":komira_bench_report",
    summary = "The `komira_bench_report` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
