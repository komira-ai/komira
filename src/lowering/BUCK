load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Lowering: a bound LogicalPlan, a HostProfile and the resolved inputs to the
# PhysicalPlan IR (version 21) and the ParamTable its segments index. Pure: the
# entry opens no file, reads no clock and no environment variable and touches
# no global (README.md).
#
# test_lower_csv         a CSV scan as a SOURCE_CSV segment: the path, the
#                        dialect and every bound column in its spec, the
#                        render line, its filter and projection as operators
#                        over the full schema, the positional factory's
#                        default dialect, a string key served COLUMNAR, a
#                        scan with header=false refused by name.
# test_lower_distinct    SELECT DISTINCT cut to a SINK_AGG grouped by every
#                        column with no aggregate: the sink row by column
#                        type and dictionary footer, the group keys in column
#                        order, the sort, limit, filter, distinct and
#                        aggregate it composes with.
# test_lower_iceberg     a scan of an Iceberg table (a binding of kind
#                        komira.iceberg.table) as a SOURCE_ICEBERG segment:
#                        the spec the inputs carry (files, delete files,
#                        bound columns and field ids), its filter and
#                        projection as operators over the full schema, the
#                        render line, the row estimate from the inputs, the
#                        refusal of a scan whose files were not planned, and
#                        a binding of another kind still not cut.
# test_lower_names       the names a render and a refusal print for every
#                        source, edge, order, operator and sink tag and for a
#                        tag with no name, and the two group keys (over an
#                        in-memory scan, an alias of a column) that are never
#                        dictionary encoded.
# test_lower_plans       the rendered physical plan of small plans: one segment
#                        for a filtered aggregate, two for an aggregate and a
#                        sort, the fused operators, the sink row each group key
#                        picks, in-memory scans, the estimates, dense
#                        parameter indices, equal arguments rendering equal
#                        and a different host changing only the morsel size.
# test_lower_join_refusals
#                        every reason a join is refused with
#                        LOWERING_JOIN_UNSERVED (a join type the IR does not
#                        define, a SEMI or ANTI join that builds its left side,
#                        a CROSS join that names a key, keys, residual, hint,
#                        build side, key types, repeated output names), a join
#                        that lowers beside each, the outer, semi, anti and
#                        cross types lowering, and the refusal coming before
#                        any scan is counted.
# test_lower_join_kinds  LEFT, RIGHT, FULL, SEMI, ANTI and CROSS joins: the
#                        build segment, the probe's join type (the plan's when
#                        the right child builds; LEFT and RIGHT exchanged,
#                        with a projection restoring the node's columns and
#                        names, when the left child builds), the keys of each
#                        side, the E3 edge, the columns a SEMI or ANTI join
#                        keeps and a CROSS join's empty key lists.
# test_lower_joins       the rendered physical plan of inner equi-joins: the
#                        build segment and the fused probe for either build
#                        side, the projection that restores the node's columns
#                        after a left build, a three-table chain, a join under
#                        an aggregate, a breaker below the build side, the
#                        estimates and the scan order.
# test_lower_jsonl_scan  a JSON scan is a SOURCE_JSONL segment whose spec reads
#                        the projection at the bound types; a pushed filter
#                        reads the whole file and becomes an operator; a
#                        projection of a column the schema lacks and an
#                        unbounded scan are refused; Avro is still refused.
# test_lower_refusals    every refusal token, raised by the plan that should
#                        raise it with the text that names why, and a plan
#                        beside each that lowers (a distinct over a column
#                        list, a repeated name, no column or a column no sink
#                        row serves included).
# test_lower_gcs_azure_scan
#                        a Parquet scan of GCS objects and of Azure blobs: the
#                        spec carries the bucket or container beside one key
#                        and several, and the render line names the store.
# test_lower_s3_scan     a Parquet scan of S3 objects: the spec carries the
#                        bucket beside the keys for one key, several and Hive
#                        partitioned keys, and the render line names the store
#                        of a remote scan only.
# test_lower_topn        a range of a sort's order cut as one SINK_TOPN segment: a
#                        top-n over a scan, a limit with an offset over a sort,
#                        the projections above it fused onto the reading
#                        pipeline, limits over a sort or a top-n composed into
#                        one range (saturating at Int.MAX), a top-n over an
#                        aggregate, in a union branch and below a filter, and
#                        the shapes that stay an operator or a sort sink.
# test_lower_union       a UNION ALL: one segment per branch (a collect, or the
#                        branch's own breaker segment) and a SOURCE_CONCAT
#                        segment over them in branch order with an E3 edge to
#                        each; operators and breakers above it; nested unions;
#                        and the refusal of a branch of another layout, of a
#                        union with no branch and of a refused node in a branch.
# test_lower_shared      a shared subplan (a PLAN_CSE_REF and its canonical
#                        subtree): one with a breaker or a limit cut once and
#                        read by every reference over E3 edges, a sort's
#                        and a top-n's readers sorted, a limit over an
#                        unshared sort still a range (also when the sort
#                        reads a reference) and over a shared one refused,
#                        a canonical subtree holding a
#                        reference found by its hash before folding, a join's
#                        right child walked first (a self-join, scan facts
#                        kept, a shared join), one of scans, filters, projections
#                        and unions cut again over the same scan facts, a
#                        window read twice cut once, one with a reference
#                        under it or holding one, a window as a join's left
#                        child keeping its scan facts, and
#                        the refusal of a reference with no canonical subtree,
#                        before it or of another layout, and of a view
#                        reference.
# test_lower_sum_fuse    SUM(CAST(<signed integer> AS DECIMAL(38, 0))), the SQL
#                        integer sum, is lowered to SUM(<integer>) with its
#                        declared DECIMAL(38, 0) output kept; every other shape
#                        of cast, argument type and aggregate is left alone.
# test_lower_window      the rendered physical plan of window nodes: a
#                        scan, a filter and projection, a projection above, two
#                        stacked windows, a node of two functions, a window
#                        over a join and over an aggregation; the declared
#                        schema's nullability, which every reader of a shared
#                        window takes, and a column whose frame can be empty
#                        nullable; a limit above a window with keys
#                        refused and one above a window with none cut.
# test_lower_window_refusals
#                        every reason a window is refused with
#                        LOWERING_WINDOW_UNSERVED (the descending list, key
#                        columns and types, function arguments and defaults,
#                        frame shapes SQL refuses, frame units, a RANGE offset
#                        without one INT64, INT32 or FLOAT64 order key, an
#                        unknown function), each by its exact text, the
#                        refusal coming before the child is walked and in a
#                        fixed order, and the windows that lower beside each:
#                        every frame SQL allows, for every function that reads
#                        it.
# test_sink_capability   the capability table's rows, which triples are not
#                        served, and admission of hand-built segments.
# test_lower_udf_nodes   the rendered physical plan of user-function plans: an
#                        ungrouped frame as an OP_UDF_FRAME over its read set,
#                        a step as a SOURCE_UDF_STEP segment, a projection
#                        column that is a call as an OP_UDF_APPLY before the
#                        OP_PROJECT, the UdfRef list carried whole, and a
#                        frame or step under a join, a union, an aggregation
#                        and a shared subplan.
# test_lower_udf_refusals
#                        a read outside a declared read set refused with
#                        LOWERING_UDF_UNDECLARED_READ naming the column (a ROW
#                        call's argument, a frame's group key, a function that
#                        declares no read set), and every LOWERING_UDF_UNSERVED
#                        reason (index, kind, argument and literal counts, read
#                        set columns, a grouped frame, a call inside an
#                        expression, a filter or an aggregation), each beside a
#                        plan that lowers.
#
# NO IMPURE PACKAGE IN THE CLOSURE. A lowering step must not reach a package
# that opens files, talks to an object store, runs a worker pool, measures the
# host or produces a plan. `closure_excludes` is checked at analysis against
# the whole closure of `deps`, direct and transitive, by exact import name
# (`async_api`, a trait surface the closure needs, is not refused).
# tests//negative/closure_excludes plants each of the seven and
# //tools/build/selftest:analysis_refusals_mojo requires the refusal.
mojo_library(
    name = "lowering",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/containers:containers",
        "//src/host_profile:host_profile",
        "//src/physical_plan:physical_plan",
        "//src/plan_expr:plan_expr",
        "//src/plan_ir:plan_ir",
        "//src/plan_stats:plan_stats",
        "//src/scan_source:scan_source",
    ],
    closure_excludes = [
        "async_rt",
        "engine_runtime",
        "fs",
        "objectstore",
        "optimizer",
        "shuffle",
        "sql",
    ],
    test_srcs = [
        "tests/test_lower_join_refusals.mojo",
        "tests/test_lower_join_kinds.mojo",
        "tests/test_lower_joins.mojo",
        "tests/test_lower_csv.mojo",
        "tests/test_lower_distinct.mojo",
        "tests/test_lower_gcs_azure_scan.mojo",
        "tests/test_lower_iceberg.mojo",
        "tests/test_lower_jsonl_scan.mojo",
        "tests/test_lower_names.mojo",
        "tests/test_lower_plans.mojo",
        "tests/test_lower_refusals.mojo",
        "tests/test_lower_s3_scan.mojo",
        "tests/test_lower_shared.mojo",
        "tests/test_lower_sum_fuse.mojo",
        "tests/test_lower_topn.mojo",
        "tests/test_lower_union.mojo",
        "tests/test_lower_unnest.mojo",
        "tests/test_lower_window.mojo",
        "tests/test_lower_window_refusals.mojo",
        "tests/test_lower_udf_nodes.mojo",
        "tests/test_lower_udf_refusals.mojo",
        "tests/test_sink_capability.mojo",
    ],
    visibility = ["PUBLIC"],
)
