load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Lowering: a bound LogicalPlan, a HostProfile and the resolved inputs to the
# PhysicalPlan IR (version 17) and the ParamTable its segments index. Pure: the
# entry opens no file, reads no clock and no environment variable and touches
# no global (README.md).
#
# test_lower_csv         a CSV scan as a SOURCE_CSV segment: the path, the
#                        dialect and every bound column in its spec, the
#                        render line, its filter and projection as operators
#                        over the full schema, the positional factory's
#                        default dialect, a string key served COLUMNAR, a
#                        scan with header=false refused by name.
# test_lower_distinct    SELECT DISTINCT cut to a SINK_AGG grouped by every
#                        column with no aggregate: the sink row by column
#                        type and dictionary footer, the group keys in column
#                        order, the sort, limit, filter, distinct and
#                        aggregate it composes with.
# test_lower_names       the names a render and a refusal print for every
#                        source, edge, order, operator and sink tag and for a
#                        tag with no name, and the two group keys (over an
#                        in-memory scan, an alias of a column) that are never
#                        dictionary encoded.
# test_lower_plans       the rendered physical plan of small plans: one segment
#                        for a filtered aggregate, two for an aggregate and a
#                        sort, the fused operators, the sink row each group key
#                        picks, in-memory scans, the estimates, dense
#                        parameter indices, equal arguments rendering equal
#                        and a different host changing only the morsel size.
# test_lower_refusals    every refusal token, raised by the plan that should
#                        raise it with the text that names why, and a plan
#                        beside each that lowers (a distinct over a column
#                        list, a repeated name, no column or a column no sink
#                        row serves included).
# test_lower_topn        a range of a sort's order cut as one SINK_TOPN segment: a
#                        top-n over a scan, a limit with an offset over a sort,
#                        the projections above it fused onto the reading
#                        pipeline, limits over a sort or a top-n composed into
#                        one range (saturating at Int.MAX), a top-n over an
#                        aggregate, in a union branch and below a filter, and
#                        the shapes that stay an operator or a sort sink.
# test_lower_union       a UNION ALL: one segment per branch (a collect, or the
#                        branch's own breaker segment) and a SOURCE_CONCAT
#                        segment over them in branch order with an E3 edge to
#                        each; operators and breakers above it; nested unions;
#                        and the refusal of a branch of another layout, of a
#                        union with no branch and of a refused node in a branch.
# test_lower_sum_fuse    SUM(CAST(<signed integer> AS DECIMAL(38, 0))), the SQL
#                        integer sum, is lowered to SUM(<integer>) with its
#                        declared DECIMAL(38, 0) output kept; every other shape
#                        of cast, argument type and aggregate is left alone.
# test_sink_capability   the capability table's rows, which triples are not
#                        served, and admission of hand-built segments.
#
# NO IMPURE PACKAGE IN THE CLOSURE. A lowering step must not reach a package
# that opens files, talks to an object store, runs a worker pool, measures the
# host or produces a plan. `closure_excludes` is checked at analysis against
# the whole closure of `deps`, direct and transitive, by exact import name
# (`async_api`, a trait surface the closure needs, is not refused).
# tests//negative/closure_excludes plants each of the seven and
# //tools/build/selftest:analysis_refusals_mojo requires the refusal.
mojo_library(
    name = "lowering",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/arrow:arrow",
        "//src/containers:containers",
        "//src/host_profile:host_profile",
        "//src/physical_plan:physical_plan",
        "//src/plan_expr:plan_expr",
        "//src/plan_ir:plan_ir",
        "//src/plan_stats:plan_stats",
        "//src/scan_source:scan_source",
    ],
    closure_excludes = [
        "async_rt",
        "engine_runtime",
        "fs",
        "objectstore",
        "optimizer",
        "shuffle",
        "sql",
    ],
    test_srcs = [
        "tests/test_lower_csv.mojo",
        "tests/test_lower_distinct.mojo",
        "tests/test_lower_names.mojo",
        "tests/test_lower_plans.mojo",
        "tests/test_lower_refusals.mojo",
        "tests/test_lower_sum_fuse.mojo",
        "tests/test_lower_topn.mojo",
        "tests/test_lower_union.mojo",
        "tests/test_sink_capability.mojo",
    ],
    visibility = ["PUBLIC"],
)
