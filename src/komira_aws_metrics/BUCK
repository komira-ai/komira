load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Read a workload's CloudWatch metrics through komira_metrics_reader:
# GetMetricData's request body, response parse and error (pure), and
# `CloudWatchMetricsReader`, a `MetricsReader` for one namespace and a fixed
# set of dimensions that signs and sends each call through komira_aws_core
# over the transport it is given.
#
# Hand-written, not generated: the pinned botocore CloudWatch model
# (//third_party/botocore) declares the smithy-rpc-v2-cbor protocol, which
# the AWS generator refuses by name; the request is the awsJson 1.0 form the
# service also serves.
#
# Welded tests, none of which talks to the service: test_cloudwatch_requests
# (the body byte for byte and the builder's refusals), test_cloudwatch_responses
# (pages, parallel arrays, malformed bodies never echoed, the error shape),
# test_cloudwatch_reader (the reader against the seam over a scripted
# transport and over komira_http_core's ScriptedConnector, the request as it
# reached the wire) and test_no_env_reads (the sources read no environment).
mojo_library(
    name = "komira_aws_metrics",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    test_data = {
        "tests/test_no_env_reads.mojo": {
            "src/" + f: f
            for f in glob(["*.mojo"])
        },
    },
    test_srcs = [
        "tests/test_cloudwatch_reader.mojo",
        "tests/test_cloudwatch_requests.mojo",
        "tests/test_cloudwatch_responses.mojo",
        "tests/test_no_env_reads.mojo",
    ],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        "//src/komira_metrics_reader:komira_metrics_reader",
        "//src/komira_retry:komira_retry",
    ],
    visibility = ["PUBLIC"],
)
