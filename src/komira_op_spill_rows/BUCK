load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The spill of the engine's two row-format breakers: a hash aggregate's partial
# tables written to disk over a memory budget and folded back by key (with a
# hash repartition when the fold itself would pass the budget), and a sort's
# sorted runs written to disk and k-way merged back in the run sort's order.
mojo_library(
    name = "komira_op_spill_rows",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_async:komira_async",
