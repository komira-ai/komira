load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The durable split catalog of a search index, the store behind the
# `SearchIndexCatalog` seam of komira_search_scan: the `SplitSummary` record
# and its binary codec, `SearchMetastore` over one append-only manifest
# lineage (publish, list, retire, reap), the cross-shard read over per-writer
# sub-lineages, the reaper that retires drained writer shards, and the
# records that keep the generation from going down. Generic over komira_objectstore's
# conditional-write stores; it names no cloud client.
#
# The welded tests run against the in-memory stores, with no network. One
# drives the publish race between independent writers (a staged collision and
# real OS threads), one the per-writer sharded layout: first-attempt appends,
# the cross-shard merge, generation, reads of unsharded indexes, and merged
# splits hiding their inputs across shards. Those two import komira_core for
# its slab collection. The third covers the retire and reap end of a split's
# life: a store error that only names "404" is raised, not taken for a
# reaped chunk, the generation never goes down while chunks and drained
# shards are reaped, a publish that lands in a shard after the reaper found
# it drained survives the reap, a publish into a retired shard is refused
# and its re-publish into a fresh shard is the only copy, and reaping
# chunks in any order never leaves a lineage a cold reader refuses. The
# fourth shows that every catalog change (publish, retire, reap) moves the
# generation, that a scan straddling a retire or a reap sees it move, and
# that retire and reap move it both before and after their change.
mojo_library(
    name = "komira_search_catalog",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_core:komira_core",
        "//src/komira_objectstore:komira_objectstore",
    ],
    test_srcs = [
        "tests/test_search_catalog_lifecycle.mojo",
        "tests/test_search_generation_moves.mojo",
        "tests/test_search_metastore_concurrent.mojo",
        "tests/test_search_sublineage_sharding.mojo",
    ],
    visibility = ["PUBLIC"],
)
