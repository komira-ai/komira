load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/native:shared.bzl", "native_shared_library")

# The pool-depth counter: three C functions over one process-global static.
staged_files(
    name = "pool_depth_files",
    srcs = ["native/komira_concurrency_pool_depth.c"],
)

cxx_library(
    name = "komira_concurrency_pool_depth",
    srcs = [":pool_depth_files[native/komira_concurrency_pool_depth.c]"],
    visibility = ["PUBLIC"],
)

# Cancellation token, detached-drop spawn, the dispatcher / worker-pool / fork-join / scale-signal trait contracts, and the pool-depth counter.
mojo_library(
    name = "komira_async_api",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        ":komira_concurrency_pool_depth",
        "//src/komira_atomic_alias:komira_atomic_alias",
    ],
    test_srcs = [
        "tests/test_spawn_drop.mojo",
    ],
    visibility = ["PUBLIC"],
)

# libkomira_async_api_native.so.1: the C this library owns, as its own
# shared library exporting the names its callers call
# (tools/build/native/README.md, "Each library's shared library"). Built and
# checked here; no package ships it yet.
native_shared_library(
    name = "komira_async_api_native",
    archives = [
        ":komira_concurrency_pool_depth",
    ],
    callers = [
        ":komira_async_api",
        "//src/komira_async:komira_async",
        "//src/komira_column_kernels:komira_column_kernels",
    ],
    library = "komira_async_api",
    # Every weak undefined symbol of the library, recorded from its first
    # green link (checks 3 and 7 hold it to exactly this list):
    weak_undefined = [
        # zig's C runtime (crti.o): the profiling hook, absent unless -pg.
        "__gmon_start__",
    ],
    visibility = ["PUBLIC"],
)
