load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/native:defs.bzl", "native_archive")

# The pool-depth counter: three C functions over one process-global static.
staged_files(
    name = "pool_depth_files",
    srcs = ["native/komira_concurrency_pool_depth.c"],
)

cxx_library(
    name = "komira_concurrency_pool_depth",
    srcs = [":pool_depth_files[native/komira_concurrency_pool_depth.c]"],
    visibility = ["PUBLIC"],
)

# Its declaration for libkomira_native.so.1 (tools/build/native/README.md):
# in the shared library.
native_archive(
    name = "komira_concurrency_pool_depth_native",
    kind = "shared",
    lib = ":komira_concurrency_pool_depth",
    reason = "The pool-depth counter: a pool entered from any library must see the depth of the whole process.",
    visibility = ["PUBLIC"],
)

# Cancellation token, detached-drop spawn, the dispatcher / worker-pool / fork-join / scale-signal trait contracts, and the pool-depth counter.
mojo_library(
    name = "komira_async_api",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        ":komira_concurrency_pool_depth_native",
        "//src/komira_atomic_alias:komira_atomic_alias",
    ],
    test_srcs = [
        "tests/test_spawn_drop.mojo",
    ],
    visibility = ["PUBLIC"],
)
