load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# kci_api: the ONE place that states every exit number, outcome
# word, error id, document format name and schema major, produced file name,
# release-directory layout rule and platform row that kci owns. Every other
# kci package imports these constants and spells none of them itself, so a
# rename (the v1.1 design revision may rename files, formats and exit
# numbers) is one change here plus its golden tests.
#
# Deps: the JSON library (produced documents) and the textproto lexer
# (authored files' schema_version). Pure: no file I/O, no clock, no environment, no process. Writing the result
# document to a file is the CLI's job; this package renders and parses it.
#
# The welded tests pin each table by value (a renumbering is a deliberate,
# visible edit of a golden test) and every refusal by its message.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed. The package depends on
# komira_json and komira_textproto, sibling packages (`[dependencies]` of mopm.toml): its `:lib` is
# built from those packages' `:lib`.
mojo_package(path = ".")

# `:kci_api`, the target the packages that depend on this library name, is `:lib` as komira's Mojo
# rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those
# packages: the rule refuses a list that is not the closure `:lib` was built from. It carries the
# README gate too (`[tests][readme]`): the examples run against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "kci_api",
    deps = [
        "//src/komira_json:komira_json",
        "//src/komira_textproto:komira_textproto",
    ],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/kci_api/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-kci_api-0.1.0-mojo1.0.0_0.conda`), which records komira_json and komira_textproto as
# dependencies (`mojo-komira_json >=0.1,<0.2` and `mojo-komira_textproto >=0.1,<0.2`) and holds
# those packages' files nowhere. `members` is the manifests of the path dependencies, staged at
# their repository paths, because `mopm pack` reads the manifest of each beside the one it is given.
# `:lib` exists only once the tests passed, so this file exists only then. Publishing it (`mopm
# publish`) uploads, which is not a build action: it is a step of a CI job that takes this target's
# output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/kci_api",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_textproto": "//src/komira_textproto:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_api",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's
# own `.mojoc` and nothing else under `lib/mojo/` (komira_json and komira_textproto are not in it),
# and exactly 2 dependencies, `mojo-komira_json >=0.1,<0.2` and `mojo-komira_textproto >=0.1,<0.2`,
# which is what installing the package pulls in. Red when the manifest drops a dependency, names
# another range, or the file carries a sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_json >=0.1,<0.2",
        "mojo-komira_textproto >=0.1,<0.2",
    ],
    package = "kci_api",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_api`. It goes when the release machine takes the mopm package.
# This library's mopm package is `:conda` above.
conda_package(
    name = "kci_api_conda",
    lib = ":kci_api",
    summary = "The `kci_api` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
