load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# kci_api: the ONE place that states every exit number, outcome
# word, error id, document format name and schema major, produced file name,
# release-directory layout rule and platform row that kci owns. Every other
# kci package imports these constants and spells none of them itself, so a
# rename (the v1.1 design revision may rename files, formats and exit
# numbers) is one change here plus its golden tests.
#
# Deps: the JSON library (produced documents) and the textproto lexer
# (authored files' schema_version). Pure: no file I/O, no clock, no environment, no process. Writing the result
# document to a file is the CLI's job; this package renders and parses it.
#
# The welded tests pin each table by value (a renumbering is a deliberate,
# visible edit of a golden test) and every refusal by its message.
mojo_library(
    name = "kci_api",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_json:komira_json",
        "//src/komira_textproto:komira_textproto",
    ],
    test_srcs = [
        # the exit table: every outcome has one number, NOOP is 0, no two names share a number
        "tests/test_exit_table.mojo",
        # error ids: unique, well-formed, every one stated with a meaning
        "tests/test_error_ids.mojo",
        # the verb table is exactly run; the step kinds and validation kinds
        "tests/test_verbs.mojo",
        # the --only selector grammar, the scope words, the evidence line
        "tests/test_selector.mojo",
        # the format table and the version checks of authored and produced files
        "tests/test_formats.mojo",
        # schema_version of an authored textproto file, read before its parser runs
        "tests/test_authored_version.mojo",
        # --run-id / --attempt / --context grammar, each limit at its edge
        "tests/test_run_identity.mojo",
        # full commit ids and artifact references
        "tests/test_revision.mojo",
        # the platform table (and its OCI spelling), the release layout, the default machine file
        "tests/test_platform_layout.mojo",
        # the result document: byte-exact render, parse(render(x)) == x, refusals
        "tests/test_result_document.mojo",
        # the deploy keys of a step row: every key round-trips, a landed node
        # under FAILED or REFUSED and a top-level deploy key are refused
        "tests/test_result_deploy_keys.mojo",
        # the result document's remaining refusals: a value of the wrong
        # JSON type inside an array or object, a nameless step, validation
        # or check, an unselected step that probes, a context key twice
        "tests/test_result_refusals.mojo",
    ],
    visibility = ["PUBLIC"],
)
