load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon SES API v2: a restJson1 client generated at build time from
# botocore's sesv2 model (//third_party/botocore, pinned by sha256; nothing
# of it is copied here), in client mode: each operation's request builder
# and response parser, its endpoint resolved through the service's
# published endpoint ruleset and partition table, embedded in the module,
# and `SESv2Client`, which resolves each call's endpoint and sends
# through komira_aws_core's send_sigv4_signed_request over the
# komira_http_core Connector it is given. The host is `email.<region>` and
# the signing name `ses`, both from the ruleset and the model.
#
# `operations` is a sending domain's onboarding, its sends and its
# removal: an identity created (Easy DKIM), read back for its DKIM tokens
# and verification status, given a custom MAIL FROM domain, bound to a
# configuration set, and deleted; a configuration set created, given an
# event destination (bounces and complaints to an SNS topic), and deleted;
# a message sent. An operation joins the list with its own rows in the
# tests below.
#
# SendEmail with `EndpointId` goes to a multi-region endpoint, which the
# ruleset signs with SigV4a. komira_aws_core signs SigV4 only, so such a
# call is refused before it is sent (test_sesv2_client), never signed as
# SigV4.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Amazon SES API v2 reference (no upstream test body is
# copied): test_sesv2_requests (each operation's method, path and body,
# exactly, and the model's bounds refused before the wire),
# test_sesv2_responses (each result decoded, and the restJson1 error
# forms), test_sesv2_endpoints (botocore's endpoint cases for sesv2,
# through every operation's resolver or, with `EndpointId`, through
# SendEmail's; the regional, FIPS, dual-stack and LocalStack endpoints; and
# two requests signed end to end against independently computed
# signatures), test_sesv2_client (the generated client over a scripted
# connector: two calls answered, one error per verb raised under its code,
# and each verb's request as it reached the wire, through komira_aws_core's
# AwsEchoConnector) and _no_env_reads (written by mojo_aws_client: the
# package reads no environment).
#
# No test here talks to the service.

_M = botocore_model("sesv2")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("sesv2")

mojo_aws_client(
    name = "komira_aws_sesv2",
    endpoint_rules = _M.endpoint_rules,
    mode = "client",
    model = _M.model,
    model_sha256 = _M.sha256,
    operations = [
        "CreateConfigurationSet",
        "CreateConfigurationSetEventDestination",
        "CreateEmailIdentity",
        "DeleteConfigurationSet",
        "DeleteEmailIdentity",
        "GetEmailIdentity",
        "PutEmailIdentityConfigurationSetAttributes",
        "PutEmailIdentityMailFromAttributes",
        "SendEmail",
    ],
    partitions = _M.partitions,
    test_data = {
        "tests/test_sesv2_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_sesv2_client.mojo",
        "tests/test_sesv2_endpoints.mojo",
        "tests/test_sesv2_requests.mojo",
        "tests/test_sesv2_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` and `<op>_with` take a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
