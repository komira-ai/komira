load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon EventBridge Scheduler: a restJson1 client generated at build time
# from botocore's scheduler model (//third_party/botocore, pinned by sha256;
# nothing of it is copied here), in client mode: each operation's request
# builder and response parser, its endpoint resolved through the service's
# published endpoint ruleset and partition table, embedded in the module,
# and `SchedulerClient`, which resolves each call's endpoint and
# sends through komira_aws_core's send_sigv4_signed_request (signing name
# `scheduler`, signed per attempt, retried as the AWS SDKs' standard mode
# does) over the komira_http_core Connector it is given.
#
# `operations` is a scheduled call's lifecycle: a schedule created, read,
# replaced and deleted. UpdateSchedule replaces the whole schedule (the
# service resets every field the request leaves out), so a caller sends
# the same shape it created with. An operation joins the list with its own
# rows in the tests below.
#
# The model marks `ClientToken` on CreateSchedule, UpdateSchedule and
# DeleteSchedule as an idempotency token (in the body on the first two, in
# the `clientToken` query on DeleteSchedule). Each verb fills an unset one,
# as botocore does, with one version 4 UUID per call (komira_aws_core's
# aws_idempotency_token), before the request is built, so the client's
# resend of a 5xx carries the same token and the service recognises it as
# the same call rather than a second create. A token the caller set is
# sent as given. test_scheduler_client pins both on the wire, across a 500
# and its resend, for all three verbs.
#
# The library is gated by its layout probe and these tests, hand-written
# against the EventBridge Scheduler API reference (no upstream test body is
# copied): test_scheduler_requests (each operation's method, path, query and
# body, exactly, and the model's bounds refused before the wire),
# test_scheduler_responses (each result decoded, and the restJson1 error
# forms), test_scheduler_endpoints (botocore's endpoint cases for scheduler
# through every operation's resolver, the regional, FIPS, dual-stack and
# LocalStack endpoints, and two requests signed end to end against
# independently computed signatures), test_scheduler_client (the generated
# client over a scripted connector: two calls answered, one error per verb
# raised under its code, each verb's request as it reached the wire, through
# komira_aws_core's AwsEchoConnector, and the token rows above) and
# _no_env_reads (written by mojo_aws_client: the package reads no
# environment).
#
# No test here talks to the service.

_M = botocore_model("scheduler")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("scheduler")

mojo_aws_client(
    name = "komira_aws_scheduler",
    endpoint_rules = _M.endpoint_rules,
    mode = "client",
    model = _M.model,
    model_sha256 = _M.sha256,
    operations = [
        "CreateSchedule",
        "DeleteSchedule",
        "GetSchedule",
        "UpdateSchedule",
    ],
    partitions = _M.partitions,
    test_data = {
        "tests/test_scheduler_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_scheduler_client.mojo",
        "tests/test_scheduler_endpoints.mojo",
        "tests/test_scheduler_requests.mojo",
        "tests/test_scheduler_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` and `<op>_with` take a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
