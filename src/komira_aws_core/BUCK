load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The ONE hand-written AWS core under the generated komira_aws_<svc> clients:
# the AwsCredential value; SigV4 header and query signing over komira_crypto;
# and the AWS SDK default credential provider chain and region resolution.
#
# The chain reads only the STANDARD AWS SDK environment variables and shared
# files, through the EnvSource / FileSource / AwsClock seams of sources.mojo,
# and reaches STS, the container endpoint and instance metadata only through
# the CredentialTransport trait: this package opens no socket.
#
# test_sigv4_test_suite runs every case of the official AWS SigV4 signing test
# suite (//tools/vendor/aws_sigv4_test_suite, staged at aws_sigv4_test_suite/)
# byte for byte, after checking each staged file against the suite's PIN.
# test_credential_wire checks each credential request builder byte for byte
# against tests/fixtures/*.request. test_env_source_only scans the package's
# own sources, staged as its data, for any environment read outside
# sources.mojo.
_FIXTURES = glob(["tests/fixtures/*"])

mojo_library(
    name = "komira_aws_core",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_core_ffi:komira_core_ffi",
        "//src/komira_crypto:komira_crypto",
        "//src/komira_xml:komira_xml",
    ],
    test_srcs = [
        "tests/test_credential_chain.mojo",
        "tests/test_credential_wire.mojo",
        "tests/test_env_source_only.mojo",
        "tests/test_shared_config.mojo",
        "tests/test_sigv4_refusals.mojo",
        "tests/test_sigv4_test_suite.mojo",
    ],
    test_data = {
        "tests/test_credential_chain.mojo": _FIXTURES,
        "tests/test_credential_wire.mojo": _FIXTURES,
        "tests/test_env_source_only.mojo": glob(["*.mojo"]),
        "tests/test_sigv4_test_suite.mojo": {
            "aws_sigv4_test_suite": "//tools/vendor/aws_sigv4_test_suite:suite",
        },
    },
    visibility = ["PUBLIC"],
)
