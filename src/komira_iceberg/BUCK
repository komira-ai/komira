load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A file-based Apache Iceberg v2 table writer and reader: the table model, the
# partition transforms, the metadata.json emitter, the manifest list and
# manifest Avro encoders, and the table reader and writer.
_SRCS = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"])

mojo_library(
    name = "komira_iceberg",
    srcs = _SRCS,
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_avro:komira_avro",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_rowcell:komira_rowcell",
    ],
    test_data = {
        "tests/test_iceberg_sources_scan.mojo": {
            "src/" + f: f
            for f in _SRCS
        },
    },
    test_srcs = [
        "tests/test_iceberg_bounds.mojo",
        "tests/test_iceberg_partition_key.mojo",
        "tests/test_iceberg_row_value.mojo",
        "tests/test_iceberg_sources_scan.mojo",
        "tests/test_iceberg_types.mojo",
    ],
    visibility = ["PUBLIC"],
)
