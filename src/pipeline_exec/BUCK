load("@komira//tools/build/mojo:defs.bzl", "mojo_binary", "mojo_library")

# The driver of a physical plan: the ready-set scheduler over its segments
# (`run_plan`, `plan_check`, `edge_policy`), the run of one segment on a
# `ParallelDispatch` (`run_segment`, `segment_task`), the closed variants of the
# source, operator and sink traits (`source_variant`, `op_variant`,
# `pipeline_sink`, `unused_members`) and the builder seam through which a plan's
# members are constructed (`segment_builder`).
#
# Two sets of members stand behind that seam. The fakes (`fake_support`,
# `fake_members`, `fake_builder`, `fake_dispatch`) drive the scheduler in tests.
# The real members are the sources `source_parquet`, `source_batch`,
# `source_sink_output`, `source_csv` (a CSV file decoded at its bound column
# types, served as a resident batch), `source_iceberg` (the planned files of
# an Iceberg snapshot, with their deletes applied, served as a resident batch)
# and `source_jsonl` (a JSONL file read at the plan's schema, served as a batch
# source), the operators `op_filter`, `op_project`,
# `op_limit` and `op_hash_probe` (the INNER, LEFT, RIGHT, FULL, SEMI, ANTI and
# CROSS join probe over an index of the build rows; RIGHT and FULL owe their
# unmatched build rows as a tail that `run_segment` pushes after the workers),
# the sinks `sink_collect`, `sink_agg` (the ungrouped aggregation, over
# `agg_fold` and `agg_output`, drawing memory from `segment_pool`; COUNT(DISTINCT) in
# every aggregation sink is `count_distinct`), `sink_group_agg` (the same keyed by
# fixed-width columns, its tables charged as they grow and, given a spill directory,
# written to disk by hash partition when the pool refuses them: `group_spill`),
# `sink_string_group_agg` (the same keyed by
# strings, over `string_keys`' intern table; `string_harness` is its test table), `sink_sort`
# (the in-memory sort and the top-N's range of its order, over `sort_nulls`,
# `sort_range` and `op_sort`; `sort_harness` is its test table and oracle),
# `sink_window` (window functions: the rows sorted by the partition and order keys
# with one column per expression, over `op_window`'s kernel) and
# `real_builder` that constructs them from a segment descriptor; the join is two
# segments, a build side ending in `sink_collect` as SINK_HASH_BUILD and a probe
# side whose chain carries `op_hash_probe` (`join_harness` writes join plans by
# hand and is the oracle's nested-loop join); `plan_harness`
# writes descriptors and sample data by hand and `tpch_q6` and `tpch_q1` are Q6 and Q1 as
# such plans with lineitem-shaped tables.
#
# test_count_distinct_state       the COUNT(DISTINCT) state by itself: value cells of
#                                 every type, entries per aggregate, group and value,
#                                 the merge, the table limits and a denied pool.
# test_edge_policy_and_ready_set  the edge tag and order key policies, the plan
#                                 checks and the ready set.
# test_float_sum_workers_concurrent
#                                 a float SUM and AVG in ORDER_ROW_RANGE on real
#                                 runtimes of 1, 2, 4 and 7 workers: the same bits
#                                 as the position-order fold over Parquet and a
#                                 resident batch, 1e16, 1, -1e16, 1 exactly 1.0,
#                                 the cursor-grain route's refusal.
# test_variants                   each variant slot forwards to its member, the
#                                 fourth operator and sink slots included.
# test_run_segment                every row once, the end of input once per
#                                 worker, the operator chain, combine once
#                                 after every worker, a worker count of one to
#                                 seven.
# test_run_segment_failures       a second error is dropped, cancel stops the other
#                                 workers, a denied memory grow fails the query,
#                                 a caller's cancel, no output after a failure.
# test_run_segment_concurrent     one segment on the runtime's threaded dispatcher.
# test_run_plan                   segments in dependency order, independent
#                                 segments, a published output reaching its
#                                 dependent, a failed segment stopping the rest.
# test_op_filter                  the filter's selection mask, all-true,
#                                 all-false and NULL predicates, a second filter
#                                 over a mask, the refusal of an unscopable
#                                 predicate.
# test_op_project_limit           reordered, dropped and computed columns, a
#                                 projection under a mask; a limit across
#                                 morsels, shared by workers, at zero, under a
#                                 mask.
# test_op_limit_concurrent       the limit's row budget drawn on by several threads at
#                                 once: disjoint ranges, no lost count.
# test_sink_collect               the output ordered by morsel position, masks
#                                 gathered, the output schema of empty input.
# test_remote_parquet_source      a Parquet spec on a remote store read through
#                                 the builder's opener (one served by the local
#                                 file system here): the local answer for one
#                                 key, every row of listed keys, SCAN_FS_UNSERVED
#                                 with no opener, from the local entry point and
#                                 from the default opener, the opener's refusal
#                                 of a bucket as the run's error.
# test_sources                    resident and sink-output sources, the Parquet
#                                 source built from a spec: projection, glob,
#                                 pushed filter, morsel size, refusals, a spec
#                                 that lists its files and their partition
#                                 constants.
# test_real_concat                SOURCE_CONCAT: the producers' rows in the spec's
#                                 order, on several workers, producers with no
#                                 rows, operators on the concatenation, the
#                                 nullability of any producer kept, and a
#                                 producer outside the dependencies refused.
# test_real_shared_output         one producer read by several segments (a
#                                 shared subplan): two readers, a concatenation
#                                 naming it twice, a reader beside a
#                                 concatenation; the published outputs' copy for
#                                 every reader but the last.
# test_source_csv                 the CSV source built from a spec: typed, quoted
#                                 and NULL cells, gzip by extension, a dialect,
#                                 the declared types over inference, a header
#                                 with no row; a plan over it end to end;
#                                 refusals of a spec with no file, a file whose
#                                 columns are not the bound ones, a missing file.
# test_source_iceberg             the Iceberg source built from a spec: the rows of
#                                 several data files in spec order at the bound
#                                 columns, NULL cells, a file with no row, a spec
#                                 with no file; a plan over it end to end through
#                                 a filter and a projection on several workers;
#                                 a spec the reader refuses, as the run's error.
# test_source_jsonl               the JSONL source built from a spec: every row
#                                 at the spec's schema and order, a missing key
#                                 NULL, an unread key skipped, a file of
#                                 several chunks, an empty file, a compressed
#                                 file, no trailing newline, keys of no column;
#                                 a bad line, a value of another type, a
#                                 missing file and no path refused naming the
#                                 file; through run_plan with a filter and a
#                                 projection, on one worker and on three.
# test_real_plan                  hand-built plans end to end: scan, filter,
#                                 project and limit; a segment reading another's
#                                 output; what the builder refuses.
# test_real_plan_concurrent       the same plans on threads, run after run, on a
#                                 runtime stopped and started again.
# test_hash_probe                 the join probe by itself against a nested-loop
#                                 oracle: refusals by message, the reserved INT64
#                                 key, NULL keys, duplicates, masks, output
#                                 names, key types, a changed morsel schema.
# test_join_plan                  inner joins as hand-built plans: resident and
#                                 Parquet probe sides, 1 to 7 workers, filter
#                                 and projection around the probe, two probes in
#                                 a chain, a probe over a sort's output, no row
#                                 with the joined schema, a build segment that is
#                                 not a dependency, an unserved join type, a plan
#                                 run twice.
# test_join_plan_concurrent       the same joins on threads, run after run, on a
#                                 runtime stopped and started again.
# test_join_kinds_plan            LEFT, RIGHT, FULL, SEMI, ANTI and CROSS joins as
#                                 hand-built plans against a nested-loop oracle:
#                                 1 to 7 workers, NULL-key and empty build sides,
#                                 the tail of RIGHT and FULL (once per build row,
#                                 no probe row, a projection or filter, an
#                                 aggregation or a limit after the probe, a
#                                 second probe), a CROSS join that names a key.
# test_join_kinds_plan_concurrent RIGHT, FULL, LEFT and SEMI joins on threads
#                                 over a Parquet probe side, run after run.
# test_segment_pool               the atomic pool and the worker reservations:
#                                 budget, blocks, give-back, exact grants under
#                                 contention.
# test_sink_agg                   SUM, COUNT, COUNT(*), MIN, MAX and AVG over
#                                 resident batches: NULL, empty input, exact
#                                 128-bit decimal sums, refusals by name.
# test_sink_agg_partials          non-empty partials merged: dealing, the merge's
#                                 overflow refusal, pool return on failure.
# test_sink_count_distinct        COUNT(DISTINCT x) in the ungrouped sink: every value
#                                 type, NaN and zero, dictionaries read by value, NULL
#                                 and empty input, several workers, refusals by exact
#                                 message, a pool too small.
# test_sink_count_distinct_grouped
#                                 COUNT(DISTINCT x) per group and SELECT DISTINCT (keys
#                                 and no aggregate) in the fixed-width and string-keyed
#                                 sinks against an oracle.
# test_sink_count_distinct_grouped_limits
#                                 the grouped sinks' COUNT(DISTINCT) refusals by exact
#                                 message and the pool charged and refused in a worker
#                                 and in the merge.
# test_sink_float_agg             SUM, AVG, MIN, MAX and the counts of FLOAT64 and
#                                 FLOAT32 columns against a plain loop: the fold
#                                 order (rows, then workers) bit for bit, NaN above
#                                 every value on every cut, infinities and
#                                 overflow, -0.0, NULL and no row, declared types
#                                 and refusals.
# test_sink_float_agg_duckdb      the same aggregates held to the pinned DuckDB's
#                                 answers (the agg_float_ungrouped corpus) by the
#                                 README's tolerance rule, through run_plan and
#                                 dealt to workers; the comparison's own refusals.
# test_sink_float_agg_positions   the sink folding by source position
#                                 (ORDER_ROW_RANGE): one SUM and AVG, bit for bit,
#                                 on 1 to 7 workers and every dealing; chunks of
#                                 one morsel, two morsels at one position refused,
#                                 no row, the pool charged per position.
# test_sink_group_float_agg       the grouped sinks over FLOAT64 and FLOAT32
#                                 arguments folded by source position: each group's
#                                 SUM, AVG, MIN and MAX bit for bit on 1, 4 and 16
#                                 workers and every dealing, int and string keys;
#                                 all-NULL, NaN, infinities, -0.0, a computed
#                                 argument, 50,000 groups, the refusals by name.
# test_sink_group_float_agg_edges the same sinks: chunks of one morsel, origin
#                                 hints, exact aggregates beside a float one, MIN
#                                 and MAX folded by worker, a type change and the
#                                 string sink's denied position entry refused.
# test_sink_composite_group_agg   the COMPOSITE row: keys of mixed types (INT32,
#                                 STRING, DATE32; DECIMAL128, BOOL, FLOAT64 beside
#                                 a STRING) against a dict oracle, NULL per column,
#                                 workers numbering strings differently, a mask,
#                                 RealBuilder, and the refusals by name.
# test_sink_group_agg_keys        the grouped sink over DATE32, BOOL and DECIMAL128
#                                 keys against a dict oracle, empty input, the
#                                 refusals by name, decimal scale and precision.
# test_sink_int_sum_decimal       SUM over an integer column declared DECIMAL(38, 0):
#                                 exact past INT64 in both signs, equal to the
#                                 DECIMAL fold of the cast form, NULL and empty,
#                                 grouped, another declared scale refused.
# test_sink_group_agg             the grouped sink against a dict oracle: one and
#                                 two keys with NULLs, workers and dealing,
#                                 the merge's overflow, float keys, refusals,
#                                 the pool charged as tables grow.
# test_sink_group_agg_spill       the grouped sink with a spill directory: spilled
#                                 tables give the oracle's groups on 1 to 4 workers,
#                                 the same budget refused without one, no spill
#                                 when the pool has room, the merge's refusals,
#                                 COUNT(DISTINCT) and the group limit, the chunk
#                                 format round trip, files deleted.
# test_group_agg_plan             scan, filter and grouped sink over Parquet,
#                                 inline and on threads, a budget refusal, and the
#                                 same budget spilled with a spill directory.
# test_sink_string_group_agg      the string-keyed grouped sink against a dict oracle:
#                                 one and two keys, flat and dictionary columns in
#                                 both orientations, NULL and the empty string,
#                                 workers numbering strings differently merged by
#                                 value, an entry no row used, overflow at the merge,
#                                 refusals by name.
# test_string_keys                the intern table by itself: equal hashes, growth,
#                                 a denied step, the entry limit, the content hash.
# test_string_group_memory        the pool charged as the string tables grow, refused
#                                 by name over budget in a worker and in the merge,
#                                 returned on success, failure and drop.
# test_sum_avg_over_cast_bool     SUM and AVG over CAST(<boolean> AS <integer or
#                                 float>): the count and the share of trues over
#                                 workers, only false, only NULL and no rows, grouped.
# test_tpch_q1                    Q1 over Parquet, end to end, against an oracle and
#                                 a hand-computed answer, from dictionary and plain
#                                 files with both string sinks.
# test_tpch_q1_concurrent         Q1 on threads, run after run.
# test_sink_sort                  SINK_SORT by hand: one and two keys, NULLs first and
#                                 last, ties in input order, four workers' partials,
#                                 refusals by name, the pool's charge and return.
# test_sort_keys                  float NaN/inf/zeros, the empty string, an unsorted
#                                 dictionary, unsortable key types refused by name.
# test_sort_plan                  hand-built plans into SINK_SORT: a resident batch, a
#                                 Parquet scan, a segment's output, no row, a pool
#                                 too small.
# test_sort_plan_concurrent       the same sort on threads, run after run, on a
#                                 runtime stopped and started again.
# test_sink_topn                  SINK_TOPN by hand: a range of the sort's order cut
#                                 through ties and NULLs, one to three keys, every
#                                 worker count and dealing equal to one worker, a
#                                 large input cut many times in bounded memory,
#                                 masks, columns named like the hidden ones,
#                                 refusals by name, the pool's charge and return.
# test_topn_plan                  hand-built plans into SINK_TOPN: a resident batch,
#                                 a Parquet scan, a segment's output, no row, a pool
#                                 too small, data refused by name.
# test_sink_window                SINK_PARTITION_BY by hand: ROW_NUMBER, RANK, LAG and
#                                 LEAD, running and whole-partition aggregates against
#                                 a plain-loop oracle with NULL keys and values, one
#                                 worker and four dealt in reverse equal bit for bit
#                                 (rows tied on every key numbered in source order), no
#                                 input, refusals by exact message, the pool charged,
#                                 returned and refused by name.
# test_window_plan                hand-built plans into SINK_PARTITION_BY: a resident
#                                 batch, a window read by a filtered collect segment on
#                                 1 to 4 workers, two chained windows, a param the
#                                 builder does not hold, a plan run twice.
# test_tpch_q6                    Q6 over Parquet, end to end, against an
#                                 oracle and a hand-computed answer.
# test_tpch_q6_concurrent         Q6 on threads, run after run.

# The cases of komira_sql_conformance's agg_float_ungrouped corpus.
_FLOAT_AGG_CASES = [
    "c01_v_double",
    "c02_v_float",
    "c03_nan_mixed_double",
    "c04_nan_mixed_float",
    "c05_nan_first_double",
    "c06_nan_first_float",
    "c07_nan_only_double",
    "c08_nan_only_float",
    "c09_pos_inf_double",
    "c10_pos_inf_float",
    "c11_neg_inf_double",
    "c12_neg_inf_float",
    "c13_both_inf_double",
    "c14_both_inf_float",
    "c15_overflow_double",
    "c16_overflow_float",
    "c17_all_null_double",
    "c18_all_null_float",
    "c19_none_double",
    "c20_none_float",
    "c21_neg_zero_double",
    "c22_neg_zero_float",
]

