        "//src/containers:containers",
        "//src/column_kernels:column_kernels",
        "//src/csv:csv",
        "//src/exec_types:exec_types",
        "//src/fs:fs",
        "//src/metrics:metrics",
        "//src/morsel:morsel",
        "//src/op_sort:op_sort",
        "//src/op_sources:op_sources",
        "//src/operator_api:operator_api",
        "//src/parquet:parquet",
        "//src/parquet_codec:parquet_codec",
        "//src/parquet_scan:parquet_scan",
        "//src/phase_timers:phase_timers",
        "//src/physical_plan:physical_plan",
        "//src/plan_expr:plan_expr",
        "//src/plan_stats:plan_stats",
        "//src/scalar_arithmetic:scalar_arithmetic",
        "//src/scan_planning:scan_planning",
        "//src/scan_source:scan_source",
    ],
    test_deps = [
        "//src/compression:compression",
        "//src/parquet_writer:parquet_writer",
        "//tools/build/mojo/runtime_paths:runtime_paths",
    ],
    test_srcs = [
        "tests/test_count_distinct_state.mojo",
        "tests/test_edge_policy_and_ready_set.mojo",
        "tests/test_float_sum_workers_concurrent.mojo",
        "tests/test_group_agg_plan.mojo",
        "tests/test_op_filter.mojo",
        "tests/test_op_limit_concurrent.mojo",
        "tests/test_op_project_limit.mojo",
        "tests/test_real_plan.mojo",
        "tests/test_real_plan_concurrent.mojo",
        "tests/test_run_plan.mojo",
        "tests/test_run_segment_concurrent.mojo",
        "tests/test_run_segment.mojo",
        "tests/test_run_segment_failures.mojo",
        "tests/test_segment_pool.mojo",
        "tests/test_sink_agg.mojo",
        "tests/test_sink_agg_partials.mojo",
        "tests/test_sink_collect.mojo",
        "tests/test_sink_count_distinct.mojo",
        "tests/test_sink_count_distinct_grouped.mojo",
        "tests/test_sink_count_distinct_grouped_limits.mojo",
        "tests/test_sink_float_agg.mojo",
        "tests/test_sink_float_agg_duckdb.mojo",
        "tests/test_sink_float_agg_positions.mojo",
        "tests/test_sink_group_agg.mojo",
        "tests/test_sink_group_agg_keys.mojo",
        "tests/test_sink_int_sum_decimal.mojo",
        "tests/test_sink_sort.mojo",
        "tests/test_sink_string_group_agg.mojo",
        "tests/test_sort_keys.mojo",
        "tests/test_sort_plan.mojo",
        "tests/test_sort_plan_concurrent.mojo",
        "tests/test_source_csv.mojo",
        "tests/test_sources.mojo",
        "tests/test_string_group_memory.mojo",
        "tests/test_string_keys.mojo",
        "tests/test_tpch_q1.mojo",
        "tests/test_tpch_q1_concurrent.mojo",
        "tests/test_tpch_q6.mojo",
        "tests/test_tpch_q6_concurrent.mojo",
        "tests/test_variants.mojo",
    ],
    # Declared data is staged at the path given, and the test opens it by that
    # path: DuckDB's answer to each case of the agg_float_ungrouped corpus.
    test_data = {
        "tests/test_sink_float_agg_duckdb.mojo": {
            "duckdb/" + c + ".tsv": "//src/tests/conformance/komira_sql_conformance:agg_float_ungrouped/" + c
            for c in _FLOAT_AGG_CASES
        },
    },
    visibility = ["PUBLIC"],
)

# The dictionary-interning spike of slice 4 (design section 4.3): a standalone
# program that times interned dictionary codes against hashing every row, the
# fragment merge, and the string-table memory per worker, on a synthetic
# workload of growing group count. It checks every layout's counts against a
# direct count and exits non-zero on a difference. CI compiles it and does not
# run it; the numbers come from the farm: `./buck2 build komira//src/pipeline_exec:intern_spike[run_check]`
# runs it remotely and records its stdout; see the header of the file.
mojo_binary(
    name = "intern_spike",
    srcs = ["spike/intern_spike.mojo"],
    deps = [],
)
