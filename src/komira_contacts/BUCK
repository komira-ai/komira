load("@komira//tools/build/lint:defs.bzl", "mojo_deps")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A simple contacts service's address books and cards: `ContactsStore[DB]`
# over the backend-neutral komira_db `Database` (books, cards with a per-book
# unique uid, version CAS, a per-book change number and the change feed), the
# per-object access rules every store call applies, and validation. The
# messages are komira_contacts_proto's.
#
# The welded tests need no database: the access rules and the validation are
# pure. The store runs against SQLite and Firestore (MockFirestore) in
# //src/tests/conformance/komira_contacts_store_conformance, which imports
# both drivers; putting them here would ship them to every consumer.
mojo_library(
    name = "komira_contacts",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_contacts_proto:komira_contacts_proto",
        "//src/komira_db:komira_db",
        "//src/komira_proto_codec:komira_proto_codec",
    ],
    test_srcs = [
        "tests/test_access.mojo",
        "tests/test_validate.mojo",
    ],
    visibility = ["PUBLIC"],
)

# The deps above name every komira_* module the library and its tests import
# (tools/build/lint: mojo_deps).
mojo_deps(
    name = "deps_lint",
    buck = "BUCK",
    srcs = glob(["**/*.mojo"]),
    visibility = ["komira//:tests_lints"],
)
