load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A SecretStore over Azure Key Vault's data plane (one GET per resolve), and
# the Entra token sources it reads through (a service principal or a managed
# identity, over azure_core's providers with the audience set to Key
# Vault). It depends on secret_store (the port), azure_core (the
# providers), http_client and http_core (the REST client, the
# Connector seam and the scripted connector the tests use) and async_rt
# (the blocking runtime that drives one request per call). The welded test runs
# over ScriptedConnector: no socket, no DNS, no vault.
mojo_library(
    name = "secrets_azure",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/async_rt:async_rt",
        "//src/azure_core:azure_core",
        "//src/crypto:crypto",
        "//src/http_client:http_client",
        "//src/http_core:http_core",
        "//src/retry:retry",
        "//src/secret_store:secret_store",
    ],
    test_srcs = ["tests/test_azure_key_vault_store.mojo"],
    visibility = ["PUBLIC"],
)
