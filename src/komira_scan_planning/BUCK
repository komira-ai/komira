load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# Scan planning contracts: the reader-factory trait, the partition/data
# predicate split and the source capability bundle. They are format and
# optimizer contracts parked here until the optimizer and parquet packages
# move.
#
# Deps: komira_fs for the filesystem types and partition discovery, and
# the core packages for the Arrow and plan-expression types (`plan.expr` lives in
# the core packages until the core split is cut over).
mojo_library(
    name = "komira_scan_planning",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_fs:komira_fs",
        "//src/komira_plan_expr:komira_plan_expr",
    ],
    test_srcs = [
        "tests/test_partition_pred_bridge_fields.mojo",
        "tests/test_partition_pred_bridge_roundtrip.mojo",
        "tests/test_partition_predicate_split.mojo",
        "tests/test_partition_predicate_split_literals.mojo",
        "tests/test_partition_predicate_split_ops.mojo",
        "tests/test_partition_predicate_split_shapes.mojo",
    ],
    visibility = ["PUBLIC"],
)
