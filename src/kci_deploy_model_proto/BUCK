load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The deploy model's `DeploymentSpec` and the intent types other deploy protos
# reuse (`ComputeIntent`, `DatastoreNeed`, `SecretBinding`, `InboundNeed`,
# `BundleIndexTable`, ...): plain proto3 messages, generated with proto3-JSON
# and binary serde. Reach the surface via
#   from kci_deploy_model_proto.deploy_model import DeploymentSpec, ContainerSpec, ...
#
# The `.proto` is imported by other protos as
# `kci/deploy/v1/deploy_model.proto` (package `kci.deploy.v1`); a proto
# that imports it names this target in `proto_deps`. It imports no other
# proto, so the generated code's only runtime is `komira_proto_codec`.
#
# The package's tests (`tests/test_*.mojo`) weld it to its wire test: every field of every
# message written out as bytes, and every value of every enum by name and
# number (tests/test_deploy_model_wire.mojo).

# The generator's half: `kci_deploy_model_proto_generated_gen` writes the Mojo of the `.proto` files, `kci_deploy_model_proto_generated_fresh` holds the
# committed directory `generated/kci_deploy_model_proto_generated/` to it, byte for byte, and fails with the command that regenerates
# (tools/build/gen/README.md). That directory is the library of mopm.toml (`[targets] lib`), compiled as the module
# `kci_deploy_model_proto`: `import_name` is that module's name, and the rule names the directory after the target, which
# `:kci_deploy_model_proto` below cannot be. The library this call declares itself (`:kci_deploy_model_proto_generated`, the same files without the
# tests) is not what dependents use. Regenerate with
#   ./buck2 run komira//tools/build/gen:regen -- komira//src/kci_deploy_model_proto:kci_deploy_model_proto_generated
mojo_proto_library(
    name = "kci_deploy_model_proto_generated",
    srcs = ["deploy_model.proto"],
    import_name = "kci_deploy_model_proto",
    import_prefix = "kci/deploy/v1",
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    visibility = ["PUBLIC"],
)

# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file, compiled from the committed directory, and exists only once the tests of tests/
# have passed.
mojo_package(path = ".")

# `:kci_deploy_model_proto`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`.
mojo_adopted_library(
    name = "kci_deploy_model_proto",
    deps = ["//src/komira_proto_codec:komira_proto_codec"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["generated/kci_deploy_model_proto_generated/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves. `members` is the
# manifests of the path dependencies of the closure, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given.
mojo_conda(
    name = "conda",
    dir = "generated/kci_deploy_model_proto_generated",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../komira_encoding": "//src/komira_encoding:mopm.toml",
        "../komira_json": "//src/komira_json:mopm.toml",
        "../komira_proto_codec": "//src/komira_proto_codec:mopm.toml",
        "../komira_protobuf": "//src/komira_protobuf:mopm.toml",
    },
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "kci_deploy_model_proto",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file: this package's own `.mojoc` and nothing else
# under `lib/mojo/`, and exactly the direct dependencies of mopm.toml.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_proto_codec >=0.1,<0.2"],
    package = "kci_deploy_model_proto",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:kci_deploy_model_proto`. This library's mopm package is `:conda` above.
conda_package(
    name = "kci_deploy_model_proto_conda",
    lib = ":kci_deploy_model_proto",
    summary = "The `kci_deploy_model_proto` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

