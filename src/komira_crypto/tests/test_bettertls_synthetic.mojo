def synthetic_cases() -> List[SyntheticCase]:
    """Build the synthetic test case list."""
    var out = List[SyntheticCase]()
    out.append(SyntheticCase(
        String("tc-001-valid-2cert-chain"),
        String("ACCEPT"),
        String("example.com"),
        String("Valid 2-cert chain: leaf -> intermediate -> root anchor"),
        _case_tc_001_valid_2cert_chain_chain_bytes(),
        _case_tc_001_valid_2cert_chain_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-002-leaf-signed-by-root"),
        String("ACCEPT"),
        String("example.com"),
        String("Valid 1-cert chain: leaf signed directly by root anchor"),
        _case_tc_002_leaf_signed_by_root_chain_bytes(),
        _case_tc_002_leaf_signed_by_root_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-101-expired-leaf"),
        String("REJECT"),
        String("example.com"),
        String("Leaf cert is expired"),
        _case_tc_101_expired_leaf_chain_bytes(),
        _case_tc_101_expired_leaf_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-102-not-yet-valid-leaf"),
        String("REJECT"),
        String("example.com"),
        String("Leaf cert not yet valid"),
        _case_tc_102_not_yet_valid_leaf_chain_bytes(),
        _case_tc_102_not_yet_valid_leaf_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-103-expired-intermediate"),
        String("REJECT"),
        String("example.com"),
        String("Intermediate cert is expired"),
        _case_tc_103_expired_intermediate_chain_bytes(),
        _case_tc_103_expired_intermediate_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-104-tampered-leaf-sig"),
        String("REJECT"),
        String("example.com"),
        String("Leaf signature tampered"),
        _case_tc_104_tampered_leaf_sig_chain_bytes(),
        _case_tc_104_tampered_leaf_sig_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-105-tampered-int-sig"),
        String("REJECT"),
        String("example.com"),
        String("Intermediate signature tampered"),
        _case_tc_105_tampered_int_sig_chain_bytes(),
        _case_tc_105_tampered_int_sig_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-106-non-ca-intermediate"),
        String("REJECT"),
        String("example.com"),
        String("Intermediate basicConstraints cA=False"),
        _case_tc_106_non_ca_intermediate_chain_bytes(),
        _case_tc_106_non_ca_intermediate_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-107-int-without-keyCertSign"),
        String("REJECT"),
        String("example.com"),
        String("Intermediate keyUsage lacks keyCertSign"),
        _case_tc_107_int_without_keyCertSign_chain_bytes(),
        _case_tc_107_int_without_keyCertSign_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-108-empty-chain"),
        String("REJECT"),
        String("example.com"),
        String("Empty cert chain"),
        _case_tc_108_empty_chain_chain_bytes(),
        _case_tc_108_empty_chain_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-109-leaf-only-no-anchor"),
        String("REJECT"),
        String("example.com"),
        String("Leaf-only chain does not terminate at any trust anchor"),
        _case_tc_109_leaf_only_no_anchor_chain_bytes(),
        _case_tc_109_leaf_only_no_anchor_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-110-dn-mismatch"),
        String("REJECT"),
        String("example.com"),
        String("Leaf issuer DN does not match intermediate subject DN"),
        _case_tc_110_dn_mismatch_chain_bytes(),
        _case_tc_110_dn_mismatch_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-111-leaf-without-serverAuth"),
        String("REJECT"),
        String("example.com"),
        String("Leaf extKeyUsage lacks serverAuth"),
        _case_tc_111_leaf_without_serverAuth_chain_bytes(),
        _case_tc_111_leaf_without_serverAuth_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-112-leaf-without-digitalSig"),
        String("REJECT"),
        String("example.com"),
        String("Leaf keyUsage lacks digitalSig/keyAgree/keyEnc"),
        _case_tc_112_leaf_without_digitalSig_chain_bytes(),
        _case_tc_112_leaf_without_digitalSig_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-113-no-matching-anchor"),
        String("REJECT"),
        String("example.com"),
        String("Chain's terminal cert does not chain to the provided trust anchor"),
        _case_tc_113_no_matching_anchor_chain_bytes(),
        _case_tc_113_no_matching_anchor_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-201-hostname-exact-match"),
        String("ACCEPT"),
        String("example.com"),
        String("SAN dNSName exact match"),
        _case_tc_201_hostname_exact_match_chain_bytes(),
        _case_tc_201_hostname_exact_match_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-202-hostname-wildcard-match"),
        String("ACCEPT"),
        String("foo.example.com"),
        String("SAN dNSName wildcard match"),
        _case_tc_202_hostname_wildcard_match_chain_bytes(),
        _case_tc_202_hostname_wildcard_match_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-203-hostname-mismatch"),
        String("ACCEPT_BUT_HOSTNAME_MISMATCH"),
        String("evil.com"),
        String("Chain valid but hostname not in any SAN entry"),
        _case_tc_203_hostname_mismatch_chain_bytes(),
        _case_tc_203_hostname_mismatch_anchor_bytes(),
    ))
    out.append(SyntheticCase(
        String("tc-204-hostname-case-insensitive"),
        String("ACCEPT"),
        String("EXAMPLE.COM"),
        String("Case-insensitive hostname match"),
        _case_tc_204_hostname_case_insensitive_chain_bytes(),
        _case_tc_204_hostname_case_insensitive_anchor_bytes(),
    ))
    return out^


# -----------------------------------------------------------------------------
# Helper: parse length-prefixed (4-byte BE) chain.der into List[X509Certificate]
# -----------------------------------------------------------------------------


def _parse_chain_records(chain_bytes: List[UInt8]) raises -> List[X509Certificate]:
    var chain = List[X509Certificate]()
    var pos = 0
    var total = len(chain_bytes)
    while pos < total:
        if pos + 4 > total:
            raise Error("chain.der: truncated length prefix at " + String(pos))
        var n = (
            Int(chain_bytes[pos]) << 24
            | Int(chain_bytes[pos + 1]) << 16
            | Int(chain_bytes[pos + 2]) << 8
            | Int(chain_bytes[pos + 3])
        )
        pos += 4
        if pos + n > total:
            raise Error("chain.der: truncated record body")
        var cert_bytes = List[UInt8]()
        for i in range(n):
            cert_bytes.append(chain_bytes[pos + i])
        chain.append(x509_parse_certificate(Span(cert_bytes)))
        pos += n
    return chain^


# -----------------------------------------------------------------------------
# Drive one synthetic case -> Bool match-vs-expected
# -----------------------------------------------------------------------------


def _run_case(tc: SyntheticCase) -> Bool:
    var now = (UInt16(2026), UInt8(5), UInt8(23), UInt8(12), UInt8(0), UInt8(0))

    # Parse trust anchor
    var anchor: X509Certificate
    try:
        anchor = x509_parse_certificate(Span(tc.anchor_bytes))
    except _:
        return False
    var anchors = List[X509Certificate]()
    anchors.append(anchor^)

    # Parse chain (empty chain is a legitimate REJECT input)
    var chain: List[X509Certificate]
    try:
        chain = _parse_chain_records(tc.chain_bytes)
    except _:
        return tc.expected == String("REJECT")

    # Run chain_verify
    var chain_ok = False
    var chain_raised = False
    try:
        chain_ok = chain_verify(chain, anchors, now)
    except _:
        chain_raised = True

    if tc.expected == String("REJECT"):
        return chain_raised or not chain_ok

    if chain_raised or not chain_ok:
        return False

    # Check hostname binding
    var hostname_ok = False
    try:
        hostname_ok = match_hostname(chain[0], tc.hostname)
    except _:
        hostname_ok = False

    if tc.expected == String("ACCEPT"):
        return hostname_ok
    if tc.expected == String("ACCEPT_BUT_HOSTNAME_MISMATCH"):
        return not hostname_ok
    return False


def test_synthetic_corpus_pass_rate() raises:
    var cases = synthetic_cases()
    var n = len(cases)
    var passed = 0
    var failed_ids = String("")
    for i in range(n):
        if _run_case(cases[i]):
            passed += 1
        else:
            if failed_ids.byte_length() > 0:
                failed_ids = failed_ids + String(", ")
            failed_ids = failed_ids + cases[i].id

    print("synthetic corpus:", passed, "/", n, "passed")
    if passed < n:
        print("  failures:", failed_ids)

    # Acceptance gate: >=80% pass rate.
    var threshold = (n * 80) // 100
    assert_true(
        passed >= threshold,
        "Synthetic corpus pass rate " + String(passed) + "/" + String(n)
        + " below 80% threshold " + String(threshold)
        + ". Failures: " + failed_ids,
    )


def test_synthetic_corpus_all_pass() raises:
    """Stricter gate: all 19 cases pass (no SKIPs in this corpus)."""
    var cases = synthetic_cases()
    var n = len(cases)
    for i in range(n):
        var ok = _run_case(cases[i])
        assert_true(
            ok,
            "Synthetic case " + cases[i].id + " did not match expected "
            + cases[i].expected + " (reason: " + cases[i].reason + ")",
        )


def test_synthetic_tc_001_valid_chain_accepts() raises:
    var cases = synthetic_cases()
    var idx = -1
    for i in range(len(cases)):
        if cases[i].id == String("tc-001-valid-2cert-chain"):
            idx = i
            break
    assert_true(idx >= 0, "tc-001 not found")
    assert_true(_run_case(cases[idx]), "tc-001 (valid chain) must accept")


def test_synthetic_tc_101_expired_rejects() raises:
    var cases = synthetic_cases()
    var idx = -1
    for i in range(len(cases)):
        if cases[i].id == String("tc-101-expired-leaf"):
            idx = i
            break
    assert_true(idx >= 0, "tc-101 not found")
    assert_true(_run_case(cases[idx]), "tc-101 (expired) must reject")


def main() raises:
    test_synthetic_tc_001_valid_chain_accepts()
    test_synthetic_tc_101_expired_rejects()
    test_synthetic_corpus_pass_rate()
    test_synthetic_corpus_all_pass()
    print("test_bettertls_synthetic.mojo: 4/4 GREEN")
