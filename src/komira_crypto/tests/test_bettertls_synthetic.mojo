    def __init__(out self, var id: String, var expected: String,
                var hostname: String, var reason: String,
                var chain_bytes: List[UInt8], var anchor_bytes: List[UInt8]):
        self.id = id^
        self.expected = expected^
        self.hostname = hostname^
        self.reason = reason^
        self.chain_bytes = chain_bytes^
        self.anchor_bytes = anchor_bytes^


