# =============================================================================
# komira_crypto/tests/test_chain_validator_p384.mojo
# ECDSA-P384 chain dispatch end-to-end test.
# =============================================================================
#
# A 3-cert ECDSA-P384 chain generated with Python cryptography's
# ec.SECP384R1 + hashes.SHA384. The DER bytes of each cert are inlined
# below; regenerating uses random keys and ECDSA random-k, so it yields
# new bytes (replace all three `_XXX_p384_cert_der` functions together).
#
# All three certs use:
#   - validity period 2026-10-01T00:00:00Z to 2034-01-01T00:00:00Z
#   - "now" timestamp in tests = 2025-06-15T12:00:00Z (well inside)
#   - ECDSA-with-SHA384 signatures (OID 1.2.840.10045.4.3.3)
#   - P-384 (secp384r1) curve pubkeys (SPKI bit-string = 0x04 || 48 + 48 = 97 bytes)
#
# Acceptance: end-to-end chain_verify on the P-384 chain succeeds. This
# exercises BOTH chain links via the new ecdsa-with-SHA384 dispatch arm
# wired in cert/chain.mojo (along with _extract_ec384_pubkey +
# _ecdsa_der_to_raw_p384). Tamper-rejection sub-test confirms the verify
# path returns False on signature corruption.
# =============================================================================

from std.testing import assert_equal, assert_true, assert_false

from komira_crypto.cert.x509 import (
    X509Certificate,
    Extension,
    DnAttribute,
    x509_parse_certificate,
)
from komira_crypto.cert.chain import chain_verify


