# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------


def _now_2025_p384() -> Tuple[UInt16, UInt8, UInt8, UInt8, UInt8, UInt8]:
    """Inside validity (NOT_BEFORE=2024 / NOT_AFTER=2034)."""
    return (UInt16(2025), UInt8(6), UInt8(15), UInt8(12), UInt8(0), UInt8(0))


def _build_chain_p384() raises -> List[X509Certificate]:
    """Build a leaf-first P-384 chain [leaf, intermediate] (root is the
    trust anchor, not in the chain itself)."""
    var leaf = x509_parse_certificate(_leaf_p384_cert_der())
    var inter = x509_parse_certificate(_intermediate_p384_cert_der())
    var chain = List[X509Certificate]()
    chain.append(leaf^)
    chain.append(inter^)
    return chain^


def _build_trust_anchors_p384() raises -> List[X509Certificate]:
    var root = x509_parse_certificate(_root_p384_cert_der())
    var anchors = List[X509Certificate]()
    anchors.append(root^)
    return anchors^


# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------


def test_valid_p384_chain_verifies() raises:
    """The full ECDSA-P-384 3-cert chain verifies through chain_verify.

    Exercises:
      - leaf → intermediate sig verify via _verify_signature dispatch arm
        on ecdsa-with-SHA384 OID (1.2.840.10045.4.3.3)
      - intermediate → root sig verify via the same arm
      - _extract_ec384_pubkey (97-byte SPKI parse) for both issuers
      - _ecdsa_der_to_raw_p384 (48-byte component zero-pad) for both sigs
      - ecdsa_p384_verify(pubkey, tbs_raw, sig) for both links
    """
    var chain = _build_chain_p384()
    var anchors = _build_trust_anchors_p384()
    var ok = chain_verify(chain, anchors, _now_2025_p384())
    assert_true(ok, "valid ECDSA-P-384 3-cert chain should verify")


def test_p384_chain_rejects_tampered_leaf_sig() raises:
    """Flipping a byte in the P-384 leaf signature must cause chain_verify
    to reject (dispatch arm correctly returns False on bad signature)."""
    var leaf = x509_parse_certificate(_leaf_p384_cert_der())
    var inter = x509_parse_certificate(_intermediate_p384_cert_der())
    if len(leaf.signature_value) > 0:
        var last_idx = len(leaf.signature_value) - 1
        leaf.signature_value[last_idx] = leaf.signature_value[last_idx] ^ UInt8(0xFF)
    var chain = List[X509Certificate]()
    chain.append(leaf^)
    chain.append(inter^)
    var anchors = _build_trust_anchors_p384()
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2025_p384())
    except:
        caught = True
    assert_true(caught, "tampered P-384 leaf signature must raise")


def test_p384_chain_rejects_tampered_intermediate_sig() raises:
    """Flipping a byte in the P-384 intermediate signature must cause
    chain_verify to reject (intermediate → root link fails)."""
    var leaf = x509_parse_certificate(_leaf_p384_cert_der())
    var inter = x509_parse_certificate(_intermediate_p384_cert_der())
    if len(inter.signature_value) > 0:
        var last_idx = len(inter.signature_value) - 1
        inter.signature_value[last_idx] = inter.signature_value[last_idx] ^ UInt8(0xFF)
    var chain = List[X509Certificate]()
    chain.append(leaf^)
    chain.append(inter^)
    var anchors = _build_trust_anchors_p384()
    var caught = False
    try:
        var _ok = chain_verify(chain, anchors, _now_2025_p384())
    except:
        caught = True
    assert_true(caught, "tampered P-384 intermediate signature must raise")


def main() raises:
    print("== test_chain_validator_p384 ==")
    test_valid_p384_chain_verifies()
    print("  valid P-384 chain verifies PASS")
    test_p384_chain_rejects_tampered_leaf_sig()
    print("  tampered P-384 leaf sig rejected PASS")
    test_p384_chain_rejects_tampered_intermediate_sig()
    print("  tampered P-384 intermediate sig rejected PASS")
    print("ALL 3 P-384 chain dispatch tests PASS")
