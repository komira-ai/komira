load("@buildrules//rules/mojo:pack.bzl", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/native:shared.bzl", "native_shared_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The exported names of aws-lc's SHA-256 block functions (the SHA-extension
# body behind a CPUID check, and the portable body), which aws-lc's assembly
# declares hidden (native/komira_crypto_sha256_hw.c).
staged_files(
    name = "sha256_hw_files",
    srcs = ["native/komira_crypto_sha256_hw.c"],
)

cxx_library(
    name = "komira_crypto_sha256_hw",
    srcs = [":sha256_hw_files[native/komira_crypto_sha256_hw.c]"],
    deps = ["//third_party/aws-lc:crypto"],
    visibility = ["PUBLIC"],
)

# Cryptographic primitives: SHA-1 / SHA-2 / BLAKE2b-256, HMAC, HKDF, PBKDF2,
# AES-GCM and ChaCha20-Poly1305, X25519, Ed25519, ECDSA P-256 / P-384, RSA
# (PKCS#1 v1.5 and PSS verify, RS256 sign from a PKCS#8 DER or PEM key), a
# health-tested system entropy source and a ChaCha20 DRBG, hex encoding, and
# X.509 chain validation with an embedded root store. The heavy primitives call
# AWS-LC's libcrypto, which is komira_awslc's archive; base64, base64url,
# base32 and PEM armor come from komira_encoding.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"). `:lib` is the library
# file and exists only once every test of tests/ has passed. The C it owns, native/komira_crypto_sha256_hw.c
# (the entries to aws-lc's SHA-256 block functions), is `[native.komira_crypto_sha256_hw]` of mopm.toml:
# `mojo_package` compiles it into `:native_komira_crypto_sha256_hw`, links it, and the archive of the
# dependency komira_awslc (`libawslc.a`), into every test of the package and of the packages that depend on
# it, and packs the wrapper into `:conda`.
mojo_package(path = ".")

# `:komira_crypto`, the target the packages that depend on this library name, is `:lib` as komira's Mojo
# rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the tests have
# passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of those packages; the rule refuses
# a list that is not the closure `:lib` was built from. It hands the native archives of `:lib` to a dependent's
# link, and carries the README gate (`[tests][readme]`). `c_deps` and `native` carry the older packaging below
# as the facts `mojo_library` gave it.
mojo_adopted_library(
    name = "komira_crypto",
    c_deps = [
        ":komira_crypto_sha256_hw",
        "//third_party/aws-lc:crypto",
    ],
    deps = [
        "//src/komira_awslc:komira_awslc",
        "//src/komira_encoding:komira_encoding",
    ],
    lib = ":lib",
    native = ":komira_crypto_native",
    readme = "README.md",
    srcs = glob(["src/komira_crypto/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file: this package's own `.mojoc`, the wrapper archive that was
# built and tested (`lib/libkomira_crypto_sha256_hw.a` is exactly the bytes of `:native_komira_crypto_sha256_hw`),
# and the direct dependencies only.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = [
        "mojo-komira_awslc >=0.1,<0.2",
        "mojo-komira_encoding >=0.1,<0.2",
    ],
    natives = {"libkomira_crypto_sha256_hw.a": ":native_komira_crypto_sha256_hw"},
    package = "komira_crypto",
    sole = True,
    visibility = ["PUBLIC"],
)

# The release machine builds `komira_crypto_conda` (release/artifacts.textproto): komira's conda packer over
# `:komira_crypto`, with the library's own shared library below. It goes when the release machine takes
# `:conda`, which is this library's mopm package.
conda_package(
    name = "komira_crypto_conda",
    lib = ":komira_crypto",
    native = ":komira_crypto_native",
    summary = "The `komira_crypto` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

# libkomira_crypto_native.so.1: the C this library owns (prefixed aws-lc and
# the SHA-256 wrapper) as its own shared library, exporting the names its
# sources call (tools/build/native/README.md, "Each library's shared
# library"). Built and checked here, and packed into the library's conda
# package (`native`).
native_shared_library(
    name = "komira_crypto_native",
    archives = [
        ":komira_crypto_sha256_hw",
        "//third_party/aws-lc:crypto",
    ],
    # s2n-tls's archive (komira_http_core's) calls aws-lc functions no Mojo
    # library calls; the library exports them to it.
    caller_archives = ["//third_party/s2n-tls:s2n"],
    callers = [":komira_crypto"],
    library = "komira_crypto",
    # Every weak undefined symbol of the library, recorded from its first
    # green link (checks 3 and 7 hold it to exactly this list):
    weak_undefined = [
        # zig's C runtime (crti.o): the profiling hook, absent unless -pg.
        "__gmon_start__",
        # aws-lc's allocator hooks, prefixed, which a program may define
        # to take over aws-lc's allocator; -Bsymbolic does not bind an
        # undefined symbol, so they stay unbound (third_party/aws-lc/BUCK).
        "komira_awslc_OPENSSL_memory_alloc",
        "komira_awslc_OPENSSL_memory_free",
        "komira_awslc_OPENSSL_memory_get_size",
        "komira_awslc_OPENSSL_memory_realloc",
        # jemalloc's sized free, which aws-lc calls only when the process's
        # malloc defines it (third_party/aws-lc/BUCK, :crypto_symbols).
        "sdallocx",
    ],
    visibility = ["PUBLIC"],
)
