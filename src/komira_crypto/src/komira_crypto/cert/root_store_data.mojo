# =============================================================================
# komira_crypto/cert/root_store_data.mojo
# =============================================================================
#
# Mozilla CA root DER bytes for the hand-selected 10 widely-used roots,
# taken from curl's `cacert.pem` (Mozilla source). The file is data: do not
# edit a root's bytes by hand — replace the whole root, and its SHA-256.
#
# Each `def _root_<slug>_der()` returns the DER-encoded X.509 certificate as
# `List[UInt8]`. They are consumed by `root_store.mojo:mozilla_root_store()`,
# which parses them into `X509Certificate` PODs at call time.
#
# # Why the bytes are spelled as hex literals
#
# The Mojo front end pays per statement. One `out.append(UInt8(0x..))`
# statement per byte (about 11,000 statements for these 10 roots) compiles
# this module roughly 20x slower, and yields a `.mojoc` roughly 5x larger,
# than one hex literal per root decoded by `_der_from_hex`. That cost would
# be paid by every build of `komira_crypto` and of everything downstream of
# it. The DER bytes are identical either way; only the spelling differs.
#
# The per-root SHA-256 in each comment below is the digest of that root's DER,
# and `tests/test_root_store_data_bytes.mojo` asserts every one of them at run
# time, plus a whole-store digest over all 10 concatenated — a byte comparison,
# not a length check.
# =============================================================================



# -----------------------------------------------------------------------------
# `_der_from_hex` — decode an ASCII hex literal into DER bytes.
#
# STRICT by construction: ASCII whitespace (the line wrapping below) is skipped,
# and ANY other non-hex character raises. An odd number of hex digits raises.
# A silent skip would shift every subsequent byte and produce a plausible-looking
# but wrong certificate, so there is deliberately no lenient path.
# -----------------------------------------------------------------------------


@always_inline
def _hex_nibble(c: UInt8) raises -> UInt8:
    """One hex digit -> its 0..15 value. Raises on anything else."""
    var v = Int(c)
    if v >= 0x30 and v <= 0x39:  # '0'..'9'
        return UInt8(v - 0x30)
    if v >= 0x61 and v <= 0x66:  # 'a'..'f'
        return UInt8(v - 0x61 + 10)
    if v >= 0x41 and v <= 0x46:  # 'A'..'F'
        return UInt8(v - 0x41 + 10)
    raise Error("root_store_data: non-hex byte in DER literal")


def _der_from_hex(hex_text: StringSlice[_]) raises -> List[UInt8]:
    """Decode a whitespace-wrapped ASCII hex literal into its DER bytes.

    Takes `StringSlice[_]`, not `StaticString`, so the byte-identity test can
    feed it a runtime `hex_lower(...)` result and assert the decode is a true
    round-trip. A `StaticString`-only signature would leave the decoder able to
    be checked only against itself.
    """
    var src = hex_text.as_bytes()

    # Pass 1: collect the hex digits, dropping ASCII whitespace only.
    var digits = List[UInt8](capacity=len(src))
    for i in range(len(src)):
        var c = src[i]
        if c == UInt8(0x20) or c == UInt8(0x0A) or c == UInt8(0x0D) or c == UInt8(0x09):
            continue
        digits.append(c)

    if len(digits) % 2 != 0:
        raise Error("root_store_data: odd hex-digit count in DER literal")

    # Pass 2: fold digit pairs into bytes.
    var out = List[UInt8](capacity=len(digits) // 2)
    for i in range(0, len(digits), 2):
        var hi = _hex_nibble(digits[i])
        var lo = _hex_nibble(digits[i + 1])
        out.append((hi << UInt8(4)) | lo)
    return out^


