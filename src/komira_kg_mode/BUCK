load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The extraction-mode vocabulary the graph spec and the extractor selection
# share (docs/design/knowledge_graph_port.md): two modes, rules (the default) and
# model, a parse of a name that falls back to rules, and a normalisation of a
# stored integer that never yields model unless the integer is model. It has no
# dependencies and reads no clock and no environment.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the test of tests/ has passed. The welded test,
# test_extract_mode_vocab, pins the ordinal values, the name round trip, the fallback of the parse
# and of the normalisation.
mojo_package(path = ".")

# `:komira_kg_mode`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`): the examples run
# against `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_kg_mode",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_kg_mode/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_kg_mode-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a
# step of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins
# (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_86",
    package = "komira_kg_mode",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Komira's conda packer over `:komira_kg_mode`: the target `ci/targets.bzl` builds and the one the release
# machine takes, if it takes this library. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_kg_mode_conda",
    lib = ":komira_kg_mode",
    summary = "The `komira_kg_mode` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
