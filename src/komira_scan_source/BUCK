load("@komira//tools/build/mojo:cxx.bzl", "staged_files")
load("@komira//tools/build/mojo:defs.bzl", "mojo_library")
load("@komira//tools/build/native:shared.bzl", "native_shared_library")

# The in-memory source id counter: one C function over one process-global static.
staged_files(
    name = "inmem_id_files",
    srcs = ["native/komira_scan_source_inmem_id.c"],
)

cxx_library(
    name = "komira_scan_source_inmem_id",
    srcs = [":inmem_id_files[native/komira_scan_source_inmem_id.c]"],
    visibility = ["PUBLIC"],
)

# What a scan is: SourceLike, ScanBinding identity, scan params, per-format source descriptors, pushdown gate, Sink trait, in-memory registry.
mojo_library(
    name = "komira_scan_source",
    # Its C ships in its package as komira_scan_source_native below (lib/libkomira_scan_source_native.so.1).
    native = ":komira_scan_source_native",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        ":komira_scan_source_inmem_id",
        "//src/komira_arrow:komira_arrow",
        "//src/komira_arrow_ipc:komira_arrow_ipc",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_dynamic_filter:komira_dynamic_filter",
        "//src/komira_libc:komira_libc",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_plan_stats:komira_plan_stats",
    ],
    test_srcs = [
        "tests/test_arrow_c_stream_table_export.mojo",
        "tests/test_column_stats.mojo",
        "tests/test_column_stats_large_string_offsets.mojo",
        "tests/test_column_stats_scan.mojo",
        "tests/test_csv_read_csv_e2e.mojo",
        "tests/test_in_memory_source.mojo",
        "tests/test_inmem_structural_id_memo_oracle.mojo",
        "tests/test_parquet_source.mojo",
        "tests/test_scan_identity_audit.mojo",
        "tests/test_source_trait_conformance.mojo",
        "tests/test_source_variant.mojo",
        "tests/test_supports_filter_pushdown.mojo",
    ],
    visibility = ["PUBLIC"],
)

# libkomira_scan_source_native.so.1: the C this library owns, as its own
# shared library exporting the names its callers call
# (tools/build/native/README.md, "Each library's shared library"). Built and
# checked here, and packed into the library's conda package (`native`).
native_shared_library(
    name = "komira_scan_source_native",
    archives = [
        ":komira_scan_source_inmem_id",
    ],
    callers = [
        ":komira_scan_source",
    ],
    library = "komira_scan_source",
    # Every weak undefined symbol of the library, recorded from its first
    # green link (checks 3 and 7 hold it to exactly this list):
    weak_undefined = [
        # zig's C runtime (crti.o): the profiling hook, absent unless -pg.
        "__gmon_start__",
    ],
    visibility = ["PUBLIC"],
)
