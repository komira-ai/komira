load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# A test-only package: one nullable dataset written through the ORC, Avro OCF,
# JSONL and CSV (CsvSink) writers into a Hive tree with a non-ASCII partition
# value (`city=Zürich`), discovered over the real LocalFs and read back with
# projections. The sources are the shared fixture (the dataset and the tree
# writer); the tests are the point. Nothing ships, so `conda = False`.
#
# The tests, each run as a build action:
#   test_formats_hive_discovery -- EagerGlobDiscovery (directory and glob,
#     including a glob whose static prefix is the non-ASCII directory) and
#     PrunedHiveDiscovery (inferred partition schema, byte-exact partition
#     values, a prune to Zürich by the fold past near-miss siblings, an
#     escaped directory decoded, a prune to Oslo by the list prefix) return
#     exactly the files on disk.
#   test_formats_projected_roundtrip -- every discovered file, read with
#     column subsets in a different order, matches the source values, NULLs
#     and partition value (a writer/reader self-round-trip).
#   test_formats_golden_bytes -- the writer-side oracle: exact CSV and JSONL
#     bytes, Avro OCF framing and writer schema, ORC stripe stats and stream
#     sizes, and hand-written JSONL the writer never produces.
#
# `deps` lists the Mojo packages of the full transitive closure of the five
# format/storage packages the fixture and tests use (each package's C helper
# libraries come with it).
mojo_library(
    name = "komira_formats_e2e",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    conda = False,
    deps = [
        "//src/komira_async:komira_async",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_avro:komira_avro",
        "//src/komira_clock:komira_clock",
        "//src/komira_core:komira_core",
        "//src/komira_core_ffi:komira_core_ffi",
        "//src/komira_csv:komira_csv",
        "//src/komira_fork_join:komira_fork_join",
        "//src/komira_fs:komira_fs",
        "//src/komira_hash:komira_hash",
        "//src/komira_json_index:komira_json_index",
        "//src/komira_jsonl:komira_jsonl",
        "//src/komira_log:komira_log",
        "//src/komira_metrics:komira_metrics",
        "//src/komira_name_registry:komira_name_registry",
        "//src/komira_orc:komira_orc",
        "//src/komira_protobuf:komira_protobuf",
        "//src/komira_row_format:komira_row_format",
        "//src/komira_spsc_ring:komira_spsc_ring",
        "//src/komira_trace:komira_trace",
        "//src/komira_udf:komira_udf",
        "//tools/build/mojo/runtime_paths:komira_runtime_paths",
    ],
    test_srcs = [
        "tests/test_formats_golden_bytes.mojo",
        "tests/test_formats_hive_discovery.mojo",
        "tests/test_formats_projected_roundtrip.mojo",
    ],
    visibility = ["PUBLIC"],
)
