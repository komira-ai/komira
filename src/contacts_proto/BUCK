load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/mojo:proto.bzl", "mojo_proto_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")
load("@komira//tools/build/toolchains:mojo_versions.bzl", "mojo_version")

# The resources of a simple contacts service's JSON API
# (`komira/contacts/v1/contacts.proto`, package `komira.contacts.v1`):
# AddressBook, Card and its parts, the change feed, the vCard import summary
# and the error envelope. Generated into the Mojo package
# `contacts_proto`:
#
#   from contacts_proto.contacts import Card
#
# The `.proto` sits at its import path so the path matches the proto package.
# The generated message structs conform to the `proto_codec` codec
# runtime. The package's tests (`tests/test_*.mojo`) weld it to its field-number census, and
# README.md's examples run as one more welded test. `contacts` stores
# these messages.

# The generator's half: `komira_contacts_proto_generated_gen` writes the Mojo of the `.proto` files, `komira_contacts_proto_generated_fresh` holds the
# committed directory `generated/contacts_proto/` to it, byte for byte, and fails with the command that regenerates
# (tools/build/gen/README.md). That directory is the library of mopm.toml (`[targets] lib`), compiled as the module
# `contacts_proto`: `import_name` is that module's name, and `dir_is_import_name` names the directory after it, as mopm
# requires of a library (the target cannot have that name: `:contacts_proto` below has it). The library this call declares itself (`:komira_contacts_proto_generated`, the same files without the
# tests) is not what dependents use. Regenerate with
#   ./buck2 run komira//tools/build/gen:regen -- komira//src/contacts_proto:komira_contacts_proto_generated
mojo_proto_library(
    name = "komira_contacts_proto_generated",
    srcs = ["komira/contacts/v1/contacts.proto"],
    import_name = "contacts_proto",
    dir_is_import_name = True,
    deps = ["//src/proto_codec:proto_codec"],
    visibility = ["PUBLIC"],
)

# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file, compiled from the committed directory, and exists only once the tests of tests/
# have passed.
mojo_package(path = ".")

# `:contacts_proto`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the tests have passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets
# of those packages: the rule refuses a list that is not the closure `:lib` was built from. It
# carries the README gate too (`[tests][readme]`): the examples run against `:lib`.
mojo_adopted_library(
    name = "contacts_proto",
    deps = ["//src/proto_codec:proto_codec"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["generated/contacts_proto/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves. `members` is the
# manifests of the path dependencies of the closure, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given.
mojo_conda(
    name = "conda",
    dir = "generated/contacts_proto",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {
        "../encoding": "//src/encoding:mopm.toml",
        "../json": "//src/json:mopm.toml",
        "../proto_codec": "//src/proto_codec:mopm.toml",
        "../protobuf": "//src/protobuf:mopm.toml",
    },
    mojo = mojo_version(),
    mopm = "toolchains//:mopm_0_0_138",
    package = "komira-ai/contacts_proto",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file: this package's own `.mojoc` and nothing else
# under `lib/mojo/`, and exactly the direct dependencies of mopm.toml.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira-ai.proto_codec >=0.1,<0.2"],
    package = "contacts_proto",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:contacts_proto`. This library's mopm package is `:conda` above.
conda_package(
    name = "contacts_proto_conda",
    lib = ":contacts_proto",
    summary = "The `contacts_proto` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)

