load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The hash aggregation tables of the engine: the split-index
# FlatHashAggregator (a compact tag array to probe, a slot directory, and an
# insertion-order entry buffer of hashes, keys and aggregate slots) with its
# hash, probe, accumulator and resize helpers; the perfect-hash aggregator
# for small dense integer key domains; the radix-partitioned aggregator;
# the partition flush buffers of the abandon cycle; and AggCommitPlan, which
# folds a record batch's value columns into the aggregate slots of any of
# them, per row or loop-transposed per batch. The sinks that drive these
# tables are in the packages above.
mojo_library(
    name = "komira_op_agg_hash",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_agg_api:komira_agg_api",
        "//src/komira_arrow:komira_arrow",
        "//src/komira_collections:komira_collections",
        "//src/komira_column_kernels:komira_column_kernels",
        "//src/komira_counters:komira_counters",
        "//src/komira_op_agg_state:komira_op_agg_state",
        "//src/komira_physical_plan:komira_physical_plan",
        "//src/komira_plan_expr:komira_plan_expr",
        "//src/komira_udf:komira_udf",
    ],
    test_srcs = [
        "tests/test_agg_commit_batch_devirt.mojo",
        "tests/test_agg_commit_cross_realloc.mojo",
        "tests/test_agg_commit_double_free.mojo",
        "tests/test_agg_commit_lifetime.mojo",
        "tests/test_agg_commit_minmax_float_order.mojo",
        "tests/test_agg_commit_partitioned.mojo",
        "tests/test_agg_commit_view_bounds.mojo",
        "tests/test_flat_hash_agg.mojo",
        "tests/test_flat_hash_partition_flush.mojo",
        "tests/test_max_perfect_hash_domain.mojo",
        "tests/test_minmax_float_order.mojo",
        "tests/test_partitioned_and_perfect.mojo",
    ],
    visibility = ["PUBLIC"],
)
