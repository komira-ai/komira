            self._mk_connector,
            self._http_config.copy(),
            self._retry_quota,
            req.method.copy(),
            cred,
            target.signing_region.copy(),
            target.signing_name.copy(),
            target.endpoint.with_host_prefix(req.host_prefix),
            req.uri.copy(),
            content_type^,
            req.body.copy(),
            extra^,
        )

