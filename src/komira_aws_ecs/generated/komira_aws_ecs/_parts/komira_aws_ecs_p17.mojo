            into the hand-written `komira_aws_core.send_sigv4_signed_request`, which is
            tested against the AWS SigV4 test vectors.

            ⛔ `X-Amz-Target` MUST RIDE IN THE **SIGNED** SET, not merely on the
            wire: an awsJson service includes it in the canonical request, so an
            unsigned one comes back `SignatureDoesNotMatch` and sends every
            reader to the credential. It is passed as an extra SIGNED header for
            exactly that reason.

            `target` is where the endpoint ruleset sent this call and how it
            is signed (`aws_signing_target`): its endpoint, signing name and
            region, and the headers the endpoint adds."""
        var cred = self._creds_source.credentials()
        var extra = List[Header]()
        for _i in range(len(target.header_names)):
            extra.append(Header(target.header_names[_i].copy(), target.header_values[_i].copy()))
        var content_type = String(String(
            ECS_CONTENT_TYPE
        ))
        for _i in range(len(req.header_names)):
            var n = req.header_names[_i].copy()
            if n.lower() == String("content-type"):
                # Header names are case-insensitive, and the substrate refuses an
                # `extra` Content-Type in any case.
                # The substrate takes the content type as its own argument and
                # puts it in BOTH the signed set and the wire headers. Passing it
                # again here would emit it twice and break the signature.
                content_type = req.header_values[_i].copy()
            else:
                extra.append(Header(n^, req.header_values[_i].copy()))
