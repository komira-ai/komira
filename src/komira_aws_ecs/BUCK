load(
    "@komira//third_party/botocore:models.bzl",
    "botocore_endpoint_file",
    "botocore_endpoint_tests_path",
    "botocore_model",
)
load("@komira//tools/build/cloud:aws.bzl", "mojo_aws_client")

# Amazon ECS: an awsJson 1.1 client generated at build time from botocore's
# ecs model (//third_party/botocore, pinned by sha256; nothing of it is
# copied here), in client mode: each operation's request builder and
# response parser, its endpoint resolved through the service's published
# endpoint ruleset and partition table, embedded in the module, and
# `ECSClient`, which resolves each call's endpoint and sends through
# komira_aws_core's send_sigv4_signed_request (signing name `ecs`) over the
# komira_http_core Connector it is given, retrying as botocore's standard
# mode does (komira_aws_core's aws_retry.mojo).
#
# `operations` is what a deployer and a job runner call on Fargate: a
# cluster created, given its capacity providers and described; task
# definitions registered, described, deregistered and listed by family and
# revision; tasks run, listed, described and stopped; and clusters and
# their services listed for cleanup. An operation joins the list with its
# own rows in the tests below. RunTask's clientToken is an idempotency
# token in the model: a token the caller sets is sent as set, and one left
# unset is filled by the client verb with a fresh version 4 UUID
# (komira_aws_core's aws_idempotency_token) before the send, so a retry
# after a lost answer carries the same token and does not start a second
# task, as botocore fills it.
#
# The service operations CreateService, UpdateService, DescribeServices and
# DeleteService are not here: their shapes reach `HookDetails`, a document
# type (untyped JSON, through a deployment lifecycle hook), and the
# generator refuses a model shape it has no type for. They join the list
# when the generator types a document.
#
# The library is gated by its layout probe and these tests, hand-written
# against the Amazon ECS API reference (no upstream test body is copied):
# test_ecs_requests (the request each operation builds, exactly, and the
# model's bounds), test_ecs_responses (each result decoded, a 200 that
# names failures, and the error forms read through komira_aws_core and the
# modeled error shapes), test_ecs_endpoints (botocore's endpoint cases for
# ecs through every operation's resolver, and the regional, FIPS,
# dual-stack and custom endpoints), _no_env_reads (written by
# mojo_aws_client: the package reads no environment) and test_ecs_client
# (the generated client over a scripted connector: a call answered, a
# missing cluster raised under its code, and a request as it reached the
# wire, through komira_aws_core's AwsEchoConnector; and over a transport
# that records each attempt, a RunTask retried after a 500 under one
# clientToken).
#
# No test here talks to the service.

_ECS = botocore_model("ecs")

_ENDPOINT_TESTS = botocore_endpoint_tests_path("ecs")

mojo_aws_client(
    name = "komira_aws_ecs",
    endpoint_rules = _ECS.endpoint_rules,
    mode = "client",
    model = _ECS.model,
    model_sha256 = _ECS.sha256,
    operations = [
        "CreateCluster",
        "DeregisterTaskDefinition",
        "DescribeClusters",
        "DescribeTaskDefinition",
        "DescribeTasks",
        "ListClusters",
        "ListServices",
        "ListTaskDefinitionFamilies",
        "ListTaskDefinitions",
        "ListTasks",
        "PutClusterCapacityProviders",
        "RegisterTaskDefinition",
        "RunTask",
        "StopTask",
    ],
    partitions = _ECS.partitions,
    test_data = {
        "tests/test_ecs_endpoints.mojo": {
            _ENDPOINT_TESTS: botocore_endpoint_file(_ENDPOINT_TESTS),
        },
    },
    test_srcs = [
        "tests/test_ecs_client.mojo",
        "tests/test_ecs_endpoints.mojo",
        "tests/test_ecs_requests.mojo",
        "tests/test_ecs_responses.mojo",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "//src/komira_aws_core:komira_aws_core",
        "//src/komira_http_client:komira_http_client",
        "//src/komira_http_core:komira_http_core",
        "//src/komira_json:komira_json",
        # The client's `send_with` takes a komira_retry loop.
        "//src/komira_retry:komira_retry",
    ],
)
