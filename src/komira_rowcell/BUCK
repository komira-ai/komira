load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# The typed table-cell value model (`RowCell`, its six type tags, typed
# constructors, value equality). A zero-dependency leaf: the empty dependency
# list is load-bearing, because every CDC provider client and the Iceberg writer
# depend on this library, and anything added here lands in all of their closures.
# Its own tests (constructor round trips, NULL and cross-type equality,
# rows_equal) run before `:lib` exists; they import nothing outside this library.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once every test of tests/ has passed.
mojo_package(path = ".")

# `:komira_rowcell`, the target the packages that depend on this library name, is `:lib` as komira's
# Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds only once the
# tests have passed. It carries the README gate too (`[tests][readme]`): the examples run against
# `:lib`; the tests are not run again.
mojo_adopted_library(
    name = "komira_rowcell",
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_rowcell/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_rowcell-0.1.0-mojo1.0.0_0.conda`). `:lib` exists only once the tests passed, so this file
# exists only then. Publishing it (`mopm publish`) uploads, which is not a build action: it is a step
# of a CI job that takes this target's output. `mopm` is the one `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    lib = ":lib",
    manifest = "mopm.toml",
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_20",
    package = "komira_rowcell",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/artifacts.textproto): komira's conda
# packer over `:komira_rowcell`. It goes when the release machine takes the mopm package. This
# library's mopm package is `:conda` above.
conda_package(
    name = "komira_rowcell_conda",
    lib = ":komira_rowcell",
    summary = "The `komira_rowcell` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
