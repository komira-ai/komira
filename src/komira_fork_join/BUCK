load("@buildrules//rules/mojo:pack.bzl", "mojo_conda", "mojo_conda_holds")
load("@komira//tools/build/mojo:adopt.bzl", "mojo_adopted_library")
load("@komira//tools/build/package:conda.bzl", "conda_package")
load(":buildrules.mojo.bzl", "mojo_package")

# Fork-join over real threads: one body, n threads, all joined before return.
# The only pthread binding in the package is _pthread.mojo.
#
# Built with buildrules' `mojo_package` from mopm.toml (README.md, "Build files"): `:lib` is the
# library file and exists only once the test of tests/ has passed. The package depends on
# komira_atomic_alias, a sibling package (`[dependencies]` of mopm.toml): the test and the README
# examples use AtomicI64, and `:lib` is built from that package's `:lib`.
mojo_package(path = ".")

# `:komira_fork_join`, the target the packages that depend on this library name, is `:lib` as
# komira's Mojo rules take it (tools/build/mojo/adopt.bzl): the same file, so a dependent builds
# only once the test has passed. `deps` is `[dependencies]` of mopm.toml, as the adopted targets of
# those packages: the rule refuses a list that is not the closure `:lib` was built from. It carries
# the README gate too (`[tests][readme]`): the examples run against `:lib`; the test is not run again.
mojo_adopted_library(
    name = "komira_fork_join",
    deps = ["//src/komira_atomic_alias:komira_atomic_alias"],
    lib = ":lib",
    readme = "README.md",
    srcs = glob(["src/komira_fork_join/**/*.mojo"]),
    test_srcs = glob(["tests/test_*.mojo"]),
    test_runs = ":test",
    visibility = ["PUBLIC"],
)

# The mopm package: `mopm pack` over `:lib`, the `.conda` a mopm registry serves
# (`mojo-komira_fork_join-0.1.0-mojo1.0.0_0.conda`), which records komira_atomic_alias as a
# dependency (`mojo-komira_atomic_alias >=0.1,<0.2`) and holds that package's files nowhere.
# `members` is the manifests of the path dependencies, staged at their repository paths, because
# `mopm pack` reads the manifest of each beside the one it is given. `:lib` exists only once the
# test passed, so this file exists only then. Publishing it (`mopm publish`) uploads, which is not
# a build action: it is a step of a CI job that takes this target's output. `mopm` is the one
# `mojo_package` pins (mopm-toolchain.toml).
mojo_conda(
    name = "conda",
    dir = "src/komira_fork_join",
    lib = ":lib",
    manifest = "mopm.toml",
    members = {"../komira_atomic_alias": "//src/komira_atomic_alias:mopm.toml"},
    mojo = "1.0.0",
    mopm = "toolchains//:mopm_0_0_83",
    package = "komira_fork_join",
    version = "0.1.0",
    visibility = ["PUBLIC"],
)

# What `:conda` holds, read back from the built file (buildrules' `prebuilt_unpack`): this package's own
# `.mojoc` and nothing else under `lib/mojo/` (komira_atomic_alias is not in it), and exactly one
# dependency, `mojo-komira_atomic_alias >=0.1,<0.2`, which is what installing the package pulls in.
# Red when the manifest drops the dependency, names another range, or the file carries the sibling.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    depends = ["mojo-komira_atomic_alias >=0.1,<0.2"],
    package = "komira_fork_join",
    sole = True,
    visibility = ["PUBLIC"],
)

# Kept for the release machine, which still builds it (release/BUCK, release/artifacts.textproto):
# komira's conda packer over `:komira_fork_join`. It goes when the release machine takes the mopm
# package. This library's mopm package is `:conda` above.
conda_package(
    name = "komira_fork_join_conda",
    lib = ":komira_fork_join",
    summary = "The `komira_fork_join` Mojo library of komira, as a conda package.",
    visibility = ["PUBLIC"],
)
