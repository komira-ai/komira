load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The packed-row representation the engine's sinks and spill write through:
# row blocks and their directory, row sort, the `RowOutput` / `RowSink`
# contract, Arrow row conversion, xxh3 hashing, and the `cell_source` row
# walker. It depends on the core packages and, for the float ordering model, komira_udf.
mojo_library(
    name = "komira_row_format",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_counters:komira_counters",
        "//src/komira_scan_source:komira_scan_source",
        "//src/komira_simd:komira_simd",
        "//src/komira_udf:komira_udf",
    ],
    test_srcs = [
        "tests/test_arrow_row.mojo",
        "tests/test_arrow_row_composite.mojo",
        "tests/test_cell_source.mojo",
        "tests/test_row_block_fixed_dt_kernels.mojo",
        "tests/test_row_block_incremental_regrow.mojo",
        "tests/test_row_block_layout_guards.mojo",
        "tests/test_row_block_nested.mojo",
        "tests/test_row_block_var_offset_ceiling.mojo",
        "tests/test_row_block_var_string_copy.mojo",
        "tests/test_row_directory.mojo",
        "tests/test_row_evaluator.mojo",
        "tests/test_row_output.mojo",
        "tests/test_row_sort_buffer_refuses_nulls.mojo",
        "tests/test_row_sort_buffer_wire_in.mojo",
        "tests/test_xxh3.mojo",
    ],
    visibility = ["PUBLIC"],
)
