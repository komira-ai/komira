load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The engine's execution primitives, with no algorithm logic: the host profile
# (measured once per host), hardware and topology detection and the async
# runtime built from them, morsel sizing as a pure function of the host profile
# and the segment (recorded in the physical plan), the dispatch-time fan-out
# grain, the run and segment execution context, the parallel RecordBatch concat,
# wake primitives, counters, and the small shared row and column helpers. It
# depends on no engine package above it.
mojo_library(
    name = "komira_engine_runtime",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_async:komira_async",
        "//src/komira_async_api:komira_async_api",
        "//src/komira_atomic_alias:komira_atomic_alias",
        "//src/komira_buffer:komira_buffer",
        "//src/komira_collections:komira_collections",
        "//src/komira_dynamic_filter:komira_dynamic_filter",
        "//src/komira_host:komira_host",
        "//src/komira_morsel:komira_morsel",
        "//src/komira_physical_plan:komira_physical_plan",
    ],
    test_srcs = [
        "tests/test_cb20_morsel_count_mechanism.mojo",
        "tests/test_concat_dict_unify.mojo",
        "tests/test_concat_one_column_parallel.mojo",
        "tests/test_concat_release_state.mojo",
        "tests/test_counters.mojo",
        "tests/test_fnv1a_and_wake.mojo",
        "tests/test_hardware_profile.mojo",
        "tests/test_hardware_profile_detect.mojo",
        "tests/test_hardware_topology.mojo",
        "tests/test_host_profile.mojo",
        "tests/test_hw_ecore_l2_morsel_sizing.mojo",
        "tests/test_join_probe_grain_seam.mojo",
        "tests/test_l1_chunk_sizing.mojo",
        "tests/test_machine_topology.mojo",
        "tests/test_morsel_sizing_policy.mojo",
        "tests/test_row_group_ref_borrow.mojo",
        "tests/test_segment_execution.mojo",
        "tests/test_streaming_microbench.mojo",
        "tests/test_wave_uaf_batch_shape.mojo",
        "tests/test_wave_uaf_candidate_c.mojo",
    ],
    visibility = ["PUBLIC"],
)
