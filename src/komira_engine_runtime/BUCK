load("@komira//tools/build/mojo:defs.bzl", "mojo_library")

# The engine's execution primitives, with no algorithm logic. So far: the host
# profile (measured once per host), hardware detection, and morsel sizing as a
# pure function of the host profile and the segment, recorded in the physical
# plan. It depends on no engine package above it.
mojo_library(
    name = "komira_engine_runtime",
    srcs = glob(["**/*.mojo"], exclude = ["tests/**/*.mojo"]),
    deps = [
        "//src/komira_arrow:komira_arrow",
        "//src/komira_collections:komira_collections",
        "//src/komira_host:komira_host",
        "//src/komira_physical_plan:komira_physical_plan",
    ],
    test_srcs = [
        "tests/test_hardware_profile.mojo",
        "tests/test_hardware_profile_detect.mojo",
        "tests/test_host_profile.mojo",
        "tests/test_hw_ecore_l2_morsel_sizing.mojo",
        "tests/test_join_probe_grain_seam.mojo",
        "tests/test_l1_chunk_sizing.mojo",
    ],
    visibility = ["PUBLIC"],
)
