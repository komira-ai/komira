# release/ci: the programs of the workflows. main_red is the alert of
# .github/workflows/main_red.yml (docs/ci.md, "The main red alert"): a Zig
# program, built behind its cases (//release/ci/tests:test_main_red), and run
# by the workflow as the binary this target builds. check_release_ref,
# release_json and mopm_publish are the release workflow's (.github/workflows/release.yml,
# docs/ci.md, "release.yml"), built behind //release/ci/tests:test_release the
# same way.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_module")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# Built with zig 0.15.2 (`:zig_next`); the executable is built behind the check
# that the pin is that release.
_ZIG = "komira//tools/build/toolchains:zig_next"
_ZIG_VERSION = "komira//tools/build/toolchains:zig_next_version"

# What the alert does, as a module the program and its cases both import.
zig_module(
    name = "main_red_lib",
    src = "main_red/lib.zig",
    imports = [
        "main_red/args.zig",
        "main_red/gh.zig",
        "main_red/issue.zig",
        "main_red/logs.zig",
        "main_red/range.zig",
        "main_red/run.zig",
    ],
    visibility = ["//release/ci/tests:"],
)

zig_exe(
    name = "main_red",
    exec_compatible_with = LINUX_X86_64,
    src = "main_red.zig",
    deps = [":main_red_lib"],
    unit_tests = ["//release/ci/tests:test_main_red", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The release workflow's tools (.github/workflows/release.yml, docs/ci.md,
# "release.yml"): what they do, as a module the programs and their cases both
# import. Built behind the cases (//release/ci/tests:test_release).
zig_module(
    name = "release_lib",
    src = "release_lib/lib.zig",
    imports = [
        "release_lib/artifacts.zig",
        "release_lib/mopm_publish.zig",
        "release_lib/ref_guard.zig",
        "release_lib/set_json.zig",
        "release_lib/stamp.zig",
        "release_lib/util.zig",
    ],
    visibility = ["//release/ci/tests:"],
)

# The guard: whether a run builds a release (a push to main, or a manual run
# with a reason), checked before anything is built.
zig_exe(
    name = "check_release_ref",
    exec_compatible_with = LINUX_X86_64,
    src = "check_release_ref.zig",
    deps = [":release_lib"],
    unit_tests = ["//release/ci/tests:test_release", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The release set's tool: the stamp from git, the check of the set against
# release/artifacts.textproto (a build action of //release:release_set), and
# release.json and the set hash.
zig_exe(
    name = "release_json",
    exec_compatible_with = LINUX_X86_64,
    src = "release_json.zig",
    deps = [":release_lib"],
    unit_tests = ["//release/ci/tests:test_release", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The mopm publish (.github/workflows/release.yml, jobs `mopm-dry-run` and
# `mopm-publish`): runs the pinned `mopm publish` over //release:mopm_set,
# the dry run on every push to main and the publish only when enabled.
zig_exe(
    name = "mopm_publish",
    exec_compatible_with = LINUX_X86_64,
    src = "mopm_publish.zig",
    deps = [":release_lib"],
    unit_tests = ["//release/ci/tests:test_release", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)
