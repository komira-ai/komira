# release/ci: the programs of the workflows. main_red is the alert of
# .github/workflows/main_red.yml (docs/ci.md, "The main red alert"): a Zig
# program, built behind its cases (//release/ci/tests:test_main_red), and run
# by the workflow as the binary this target builds. check_release_ref and
# release_json are the release workflow's (.github/workflows/release.yml,
# docs/ci.md, "release.yml"), built behind //release/ci/tests:test_release the
# same way. buck2_failure is release-macos.yml's: it reads a failed buck2
# step's log and says what buck2 said. npm_smoke is the npm release's
# (//release:npm_packages and .github/workflows/npm.yml, docs/ci.md, "npm.yml:
# publishing the npm packages"), built behind //release/ci/tests:test_npm_smoke.
load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_module", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")

# Built with zig 0.15.2 (`:zig_next`); the executable is built behind the check
# that the pin is that release.
_ZIG = "komira//tools/build/toolchains:zig_next"
_ZIG_VERSION = "komira//tools/build/toolchains:zig_next_version"

# What the alert does, as a module the program and its cases both import.
zig_module(
    name = "main_red_lib",
    src = "main_red/lib.zig",
    imports = [
        "main_red/args.zig",
        "main_red/gh.zig",
        "main_red/issue.zig",
        "main_red/logs.zig",
        "main_red/range.zig",
        "main_red/run.zig",
    ],
    visibility = ["//release/ci/tests:"],
)

zig_exe(
    name = "main_red",
    exec_compatible_with = LINUX_X86_64,
    src = "main_red.zig",
    deps = [":main_red_lib"],
    unit_tests = ["//release/ci/tests:test_main_red", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The release workflow's tools (.github/workflows/release.yml, docs/ci.md,
# "release.yml"): what they do, as a module the programs and their cases both
# import. Built behind the cases (//release/ci/tests:test_release).
zig_module(
    name = "release_lib",
    src = "release_lib/lib.zig",
    imports = [
        "release_lib/artifacts.zig",
        "release_lib/ref_guard.zig",
        "release_lib/set_json.zig",
        "release_lib/stamp.zig",
        "release_lib/util.zig",
    ],
    visibility = ["//release/ci/tests:"],
)

# The guard: whether a run builds a release (a push to main, or a manual run
# with a reason), checked before anything is built.
zig_exe(
    name = "check_release_ref",
    exec_compatible_with = LINUX_X86_64,
    src = "check_release_ref.zig",
    deps = [":release_lib"],
    unit_tests = ["//release/ci/tests:test_release", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The release set's tool: the stamp from git, the check of the set against
# release/artifacts.textproto (a build action of //release:release_set), and
# release.json and the set hash.
zig_exe(
    name = "release_json",
    exec_compatible_with = LINUX_X86_64,
    src = "release_json.zig",
    deps = [":release_lib"],
    unit_tests = ["//release/ci/tests:test_release", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# What buck2_failure does, as a module the program and its cases both import.
zig_module(
    name = "buck2_failure_lib",
    src = "buck2_failure/lib.zig",
    deps = [":main_red_lib"],
    visibility = ["//release/ci/tests:"],
)

zig_exe(
    name = "buck2_failure",
    exec_compatible_with = LINUX_X86_64,
    src = "buck2_failure.zig",
    deps = [":buck2_failure_lib"],
    unit_tests = ["//release/ci/tests:test_buck2_failure", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The command line of buck2_failure, run as the built program (BUCK2_FAILURE) the way
# release-macos.yml runs it: exit status, stderr and the files it appends to, compared whole
# (buck2_failure/cli_test.zig says what each case holds). A zig_test of its own, not one of the
# program's unit_tests, because it runs the program those gate; in this package rather than in
# release/ci/tests, whose package the aggregate leaves out (EXCLUDED of tools/build/ci/rules.bzl),
# so that the pull request check builds it.
zig_test(
    name = "test_buck2_failure_cli",
    exec_compatible_with = LINUX_X86_64,
    src = "buck2_failure/cli_test.zig",
    data = {"analysis_failed.log": "//release/ci/tests:buck2_failure_analysis_log"},
    exec_tools = {"BUCK2_FAILURE": ":buck2_failure"},
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
)

# The npm release's tool (npm_smoke/cli.zig says what each command does): `set` writes npm_set.json, the record
# of //release:npm_packages (a build action of that target); `gate` reads the publish gate,
# release/npm_publish.txt; `verify`, `publish` and `smoke` are the steps of .github/workflows/npm.yml that
# hold the downloaded tarballs to the set, publish them with the pinned npm, and install the published version
# from the registry and query it. What it does, as a module the program and its cases both import.
zig_module(
    name = "npm_smoke_lib",
    src = "npm_smoke/lib.zig",
    imports = [
        "npm_smoke/cli.zig",
        "npm_smoke/common.zig",
        "npm_smoke/gate.zig",
        "npm_smoke/npm.zig",
        "npm_smoke/publish.zig",
        "npm_smoke/set.zig",
        "npm_smoke/smoke.zig",
    ],
    visibility = ["//release/ci/tests:", "//release:"],
)

# Built behind its cases (//release/ci/tests:test_npm_smoke): npm and node in memory, no network, no clock.
zig_exe(
    name = "npm_smoke",
    exec_compatible_with = LINUX_X86_64,
    src = "npm_smoke.zig",
    deps = [":npm_smoke_lib"],
    unit_tests = ["//release/ci/tests:test_npm_smoke", _ZIG_VERSION],
    busybox = "komira//tools/build/toolchains:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)
