load("@komira//tools/build/python:defs.bzl", "py_test")

# The tests of release/ci's scripts, each a py_test: its cases run with the
# hermetic Python (tools/build/python) as a build action, so building the
# target is running them. Test-only: nothing here is shipped.

# release/ci/main_red.py, the main-red alert of .github/workflows/main_red.yml
# (docs/ci.md, "main_red.yml"): what each case proves is in the test's header.
# fixtures/ holds excerpts of real job logs of kci runs.
py_test(
    name = "test_main_red",
    src = "test_main_red.py",
    srcs = ["//release:main_red.py"] + glob(["fixtures/*.log"]),
)

# release/ci/derive_checks.py, the derive_checks command of the per-change
# check: any failure of its universe query answers one BROKEN line (kci
# fails the check), never an exit kci reads as "cannot tell". Its header
# says what each case proves.
py_test(
    name = "test_derive_checks",
    src = "test_derive_checks.py",
    srcs = ["//release:derive_checks.py"],
)
