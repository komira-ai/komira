# The release artifacts: what a release of komira builds, in this file's
# order, and the set a publish step would ship. The release workflow
# (.github/workflows/release.yml) builds the Buck2 target //release:release_set,
# which a build action holds to this file (the names, their order and the
# metapackage's arguments), and the workflow tests the file's existence. The
# textproto's own build-system fields below are the retired kci build step's;
# nothing reads them to build. Changing it changes what is released: CODEOWNERS
# requires the release approver's review for everything under release/.
#
# The release is the libraries below and their metapackage, in THIS ORDER (each
# library after the libraries it depends on), each built into its own empty
# directory under the release directory R (`{release_dir}`: the platform's
# directory, <--release-dir>/<platform>), with the git-derived stamp S:
#
#   buck2 build -c komira.package_stamp=<N> -c komira.package_commit=<C> \
#     -c komira.package_timestamp_ms=<T> \
#     //src/encoding:komira_encoding_conda[release] --out R/encoding
#   buck2 run //tools/build/package:komira_pack -- conda-meta --name komira_all \
#     --member-manifest R/encoding/manifest.json ... --out-dir R/komira_all
#
# THE STAMP is never typed here: `{build_number}`, `{source_commit}` and
# `{timestamp_ms}` are placeholders filled from git. A library built
# without them has no `[release]` sub-target, so an artifact that forgets
# the stamp fails at build rather than shipping.
#
# THE METAPACKAGE `komira_all` is the LAST artifact: `{release_dir}` holds
# every artifact above it, already built and verified. Its members are every
# library of this file, one `--member-manifest` each; adding a library is
# two edits here: its entry above the metapackage, and its manifest in
# the metapackage's args.
#
# THE NAMES A RELEASE PUBLISHES are the ones this file declares, and this file
# is reviewed through CODEOWNERS; there is no per-run claim.
#
# Which farm buck2 builds on is the build job's machine configuration, written
# by the farm-connect action (docs/ci.md), not this file's.
#
# THE PULL REQUEST'S CHECK is no part of this file: .github/workflows/pr.yml
# selects the targets a change affects with the BXL selector
# tools/build/ci/affected.bxl and builds and tests them through buck2
# (docs/ci.md).
#
# The file format's major is the `schema_version` below.

schema_version: 1

build_systems {
  name: "buck2"
  executable: "buck2"
  args: "build"
  args: "-c"
  args: "komira.package_stamp={build_number}"
  args: "-c"
  args: "komira.package_commit={source_commit}"
  args: "-c"
  args: "komira.package_timestamp_ms={timestamp_ms}"
}

build_systems {
  name: "komira_pack"
  executable: "buck2"
  args: "run"
  args: "//tools/build/package:komira_pack"
  args: "--"
}

artifacts {
  name: "encoding"
  build_system: "buck2"
  args: "//src/encoding:komira_encoding_conda[release]"
  args: "--out"
  args: "{out_dir}"
  targets: "//src/encoding:komira_encoding_conda"
}

