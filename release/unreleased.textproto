# The release ledger: every library under src/ that release/artifacts.textproto
# does not declare, with the reason it is not released. Every library
# directory under src/ (not src/tests/) is in exactly one of the two files;
# //release:release_ledger_check fails the build when one is in neither or in
# both, when a row names a directory that holds no library, or when a row's
# reason disagrees with what the build knows of the library
# (tools/build/package/release_ledger.sh). Declaring a library removes its
# row in the same change. Changes need the release approver's review
# (.github/CODEOWNERS), as for everything under release/.
#
# One row per line, sorted by name:
#
#   libraries { name: "<dir>" reason: <REASON> }
#   libraries { name: "<dir>" reason: PENDING_DECLARE pr: <N> }
#
# The reasons, a closed set (docs/design/continuous_publish.md, "What blocks
# every package?"); the first three take precedence in this order:
#
#   NATIVE           its closure links native code (a vendored C/C++ library
#                    or a C shim): a .mojoc holds none, so the build refuses
#                    its conda package (_conda_facts, tools/build/mojo/defs.bzl).
#                    Computed by the build: the check holds the row to it.
#   DLOPEN           its own source opens a shared library at run time
#                    (OwnedDLHandle), which the packer refuses
#                    (tools/build/package/pack/conda.zig). Not computed.
#   NO_README        no README: gamma refuses a package without runnable
#                    examples (src/kci_validate/readme_installed.mojo).
#                    Computed by the build: the check holds the row to it.
#   UNDECLARED_DEP   it depends on a library that is not declared. The check
#                    requires one such dependency.
#   NO_CLOUD_CHECK   a cloud library with no release check (the design's S3a).
#   TEST_SUPPORT     a library that exists for tests only.
#   PENDING_DECLARE  buildable and declared by the open pull request `pr`.

libraries { name: "kci_artifact" reason: UNDECLARED_DEP }
libraries { name: "kci_artifact_proto" reason: NO_README }
libraries { name: "kci_build" reason: NATIVE }
libraries { name: "kci_cell" reason: PENDING_DECLARE pr: 1136 }
libraries { name: "kci_cli" reason: NATIVE }
