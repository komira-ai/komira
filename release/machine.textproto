# The release machine (src/kci_release_machine, format kci.machine): the stages of a
# komira release, in order, and the steps of each. `kci run --stage <S>` runs one
# stage, every step of it in order (`--only step:<name>` runs a selection, which
# is reported as SELECTIVE, never as a full run). kci reads THIS path by
# convention (release/machine.textproto); `--machine <path>` overrides it.
# .github/workflows/kci.yml runs each stage as the job of the same name,
# in the stage's GitHub environment. The pull request's check is no stage of
# this file: .github/workflows/pr.yml selects and builds with buck2 and runs no
# kci (docs/ci.md). kci holds the workflow it runs under to this
# file at start-up under GitHub Actions, and the welded test
# src/kci_workflow_check/tests/test_repo_kci_yml.mojo does the same on every build, so
# a drift fails `./buck2 build //...`. This file owns the stages: edit both
# together.
#
# komira publishes to NO channel for now: the stages that published to a
# channel, and the validations that installed from it, were removed, and
# publishing will move to mopm (docs/releases.md). release/channels.textproto
# is kept (kci's channels parser refuses a file with no channel) but no stage
# names it.
#
#   build  builds every artifact release/artifacts.textproto declares, for
#          linux-x86_64, into a release directory with release.json. It is
#          FARM-CONNECTED: its job joins the tailnet to reach the build farm,
#          and so it may never publish.
#
# There is no pull request stage: the required check `pr / check` is pr.yml's
# one job, which runs the BXL selector tools/build/ci/affected.bxl and builds
# and tests what it names through the farm action, with no kci.
#
# BREAK-GLASS: build is `break_glass: true`, so a manual run (of any branch,
# main included; with a required reason) builds its revision on the farm. The
# break-glass stages are a prefix of the chain (the machine file refuses a
# break_glass stage after one that is not).
#
# Relative paths are relative to the directory kci is started in (the
# repository's root in kci.yml). Changes need the release approver's review
# (.github/CODEOWNERS).

# The file format's major (kci_api's format table): kci refuses a file
# without it, and one written for a newer kci.
schema_version: 1

stage {
  name: "build"
  farm_connected: true
  break_glass: true
  step {
    name: "build"
    kind: BUILD
    platform: "linux-x86_64"
    artifacts: "release/artifacts.textproto"
  }
}
