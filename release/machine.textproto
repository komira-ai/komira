# The release machine (src/kci_release_machine, format kci.machine): the stages of a
# komira release, in order, and the steps of each. `kci run --stage <S>` runs one
# stage, every step of it in order (`--only step:<name>` runs a selection, which
# is reported as SELECTIVE, never as a full run). kci reads THIS path by
# convention (release/machine.textproto); `--machine <path>` overrides it.
# .github/workflows/kci.yml runs each stage as the job of the same name, in the
# stage's GitHub environment (the pr stage in none). kci holds that workflow to this file at start-up
# under GitHub Actions, and the welded test
# src/kci_ci_check/tests/test_repo_kci_yml.mojo does the same on every build, so
# a drift fails `./buck2 build //...`. This file owns the stages: edit both
# together.
#
#   build  builds every artifact release/artifacts.textproto declares, for
#          linux-x86_64, into a release directory with release.json. It is
#          FARM-CONNECTED: its job joins the tailnet to reach the build farm,
#          and so it may never publish.
#   gamma  publishes that release set to the channel `gamma` (prefix.dev
#          komira-ai/gamma, release/channels.textproto), in the GitHub
#          environment `gamma` that the channel's trusted publisher names.
#          Its validation `install` then installs what was published the way
#          a consumer gets it: the channel's index is read anonymously (it
#          must list every file with the build's sha256 and serve those
#          bytes), and in a container of the pinned image pixi installs
#          komira_encoding and komira_all at this release's version and build
#          from the channel, with mojo-compiler from Modular's channel, and
#          runs release/smoke/smoke_komira_encoding.mojo against them.
#          kci.yml runs the stage as two jobs: `gamma` (`--only
#          step:publish`) and `validate` (`--only validation:install`, no
#          environment, no identity token), and prod waits for both.
#   prod   publishes the SAME release set (never rebuilt) to the channel
#          `prod` (prefix.dev komira-ai/prod), in the GitHub environment
#          `prod`, after gamma's publish and validation, on every push to main
#          (continuous auto-promotion). It is the one stage that is not
#          break_glass: it runs only on main, for a commit on main's history,
#          and never publishes a build number lower than its channel holds.
#          The gamma job's summary lists the names new to prod (NEW NAMES).
#   pr     the per-change check of a pull request (trigger PULL_REQUEST):
#          `kci run --stage pr --affected-by <the pull request's base commit>`
#          builds, with each build system's `build_targets` command, exactly
#          the units of release/artifacts.textproto (its artifacts and
#          checks) that the change reaches, as each build system's
#          `affected` command says, and ships nothing. It is the only job of
#          kci.yml that runs on a pull request, and only for a pull request
#          from a branch of this repository (a fork's runs nothing). No
#          environment, no publishing step; FARM-CONNECTED, like build, so its
#          identity token is the farm connection's only. It runs after no
#          stage and no stage runs after it.
#
# BREAK-GLASS: build and gamma are `break_glass: true`, so a manual run of a
# branch other than main (with a required reason) builds and publishes that
# branch to gamma, and stops there; prod is not, so no run off main reaches it.
# The break-glass stages are a prefix of the chain (the machine file refuses
# a break_glass stage after one that is not).
#
# A stage's `environment` is the GitHub environment its job runs in, and the
# one its channel's trusted publisher names (push_identity
# `...:environment:<env>`); kci refuses a trusted publish from any other.
#
# Publishing and deploying are separate stages in separate GitHub environments:
# a deploy stage, when there is one, is added here as a stage of its own.
# Relative paths are relative to the directory kci is started in (the
# repository's root in kci.yml). Changes need the release approver's review
# (.github/CODEOWNERS).

# The file format's major (kci_api's format table): kci refuses a file
# without it, and one written for a newer kci.
schema_version: 1

stage {
  name: "build"
  farm_connected: true
  break_glass: true
  step {
    name: "build"
    kind: BUILD
    platform: "linux-x86_64"
    artifacts: "release/artifacts.textproto"
  }
}

stage {
  name: "gamma"
  environment: "gamma"
  after: "build"
  break_glass: true
  step {
    name: "publish"
    kind: PUBLISH
    platform: "linux-x86_64"
    artifacts: "release/artifacts.textproto"
    channels: "release/channels.textproto"
    channel: "gamma"
    validation {
      name: "install"
      kind: CONDA_INSTALL_SMOKE
      # The consumer: pixi and a C++ runtime, nothing of ours. Pinned by the
      # digest of its linux/amd64 manifest; the tag is only a label.
      image: "ghcr.io/prefix-dev/pixi:0.67.2-bookworm-slim@sha256:f9a0835bdb9c2ec11d8c3ef926f4712a90b27993cb59ff2bbf9cbaaffa1e2337"
      install: "komira_encoding"
      install: "komira_all"
      # mojo-compiler, pinned to the libraries' mojo_pin, comes from here.
      compiler_channel: "https://conda.modular.com/max"
      # mojo-compiler's own dependencies (python for mojo-python).
      extra_channel: "conda-forge"
      program: "release/smoke/smoke_komira_encoding.mojo"
      # Only the ABSENCE of a file in the channel's index is waited for (the
      # registry indexes an upload shortly after it lands); then it fails.
      wait_for_index_seconds: 600
    }
  }
}

stage {
  name: "prod"
  environment: "prod"
  after: "gamma"
  step {
    name: "publish"
    kind: PUBLISH
    platform: "linux-x86_64"
    artifacts: "release/artifacts.textproto"
    channels: "release/channels.textproto"
    channel: "prod"
  }
}

stage {
  name: "pr"
  trigger: PULL_REQUEST
  farm_connected: true
  step {
    name: "check"
    kind: BUILD
    platform: "linux-x86_64"
    artifacts: "release/artifacts.textproto"
  }
}
