load("@komira//tools/build/mojo:defs.bzl", "mojo_test")

# The programs a release machine's validations run against a published
# package (release/machine.textproto, `program`). kci copies one into the
# consumer's container; here each is also built against the in-repository
# library and run by `./buck2 test //...`, so an API change of the library
# fails this repository before it can fail a release. A `mojo_test` of its
# own package: no library's build waits on it.
mojo_test(
    name = "smoke_komira_encoding",
    srcs = ["smoke_komira_encoding.mojo"],
    deps = ["//src/komira_encoding:komira_encoding"],
)

# The machine file names this path; kci_ci_check's test_repo_kci_yml stages it
# and fails when the program the validation names is not there.
export_file(
    name = "smoke_komira_encoding.mojo",
    visibility = ["//src/kci_ci_check:"],
)
