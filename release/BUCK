# Every release member is claimed on the prod registry. release.yml publishes the members
# (the packages of README_E2E_PACKAGES) to prod on every push to main, and the registry
# creates a name only for its claimed owner, so an unclaimed member fails `prod-stage` and
# turns main red. The pull request check cannot write to the live registry, so the claimed
# names are committed (prod_claimed_names.txt: a maintainer adds one only after claiming it)
# and this build action refuses a member the file lacks, naming it
# (prod_claimed_names_test.zig says what each case catches).
zig_test(
    name = "prod_claimed_names_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "prod_claimed_names_test.zig",
    data = {
        "packages.bzl": "//release/readme_e2e:packages.bzl",
        "prod_claimed_names.txt": "prod_claimed_names.txt",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# Every Mojo library under src/ is published (a member of README_E2E_PACKAGES) or has a row in
# UNPUBLISHED.md with the reason it is not, so that table cannot go stale: a new library, a
# published one whose row stays, a row for a deleted directory, or a row that says it waits on a
# library that has since been published fails this build action, naming the library
# (unpublished_test.zig says what each case catches). The libraries are read from the paths of the
# cell's root doc_tree (unpublished.bzl), which only komira's own checkout declares.
[
    (
        src_library_paths(
            name = "src_library_paths",
            tree = "//:doc_tree",
        ),
        zig_test(
            name = "unpublished_cases",
            exec_compatible_with = LINUX_X86_64,
            src = "unpublished_test.zig",
            data = {
                "UNPUBLISHED.md": "UNPUBLISHED.md",
                "packages.bzl": "//release/readme_e2e:packages.bzl",
                "src_library_paths.txt": ":src_library_paths",
            },
            busybox = "komira//tools/build/toolchains:busybox",
            zig = "komira//tools/build/toolchains:zig_next",
            visibility = ["PUBLIC"],
        ),
    )
    for _ in [1]
    if docs_checked()
]

# The native ids the release reads from each package's unit graph (mopm_native_ids.bzl) are the
# `[native.<id>]` tables of that package's mopm.toml, for every member, with nothing more or less
# (native_ids_test.zig says what each case catches). A unit's id is `native:<package>/<id>`, and in a
# graph of mopm 0.0.113 `<package>` is a full name `<namespace>/<name>`.
native_ids_json(name = "native_ids_json")

zig_test(
    name = "native_ids_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "native_ids_test.zig",
    data = {"native_ids.json": ":native_ids_json"} | {
        "manifests/{}/mopm.toml".format(p): "//src/{}:mopm.toml".format(p)
        for p in README_E2E_PACKAGES
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# The directories `mopm stage --artifacts` reads are in mopm's layout, `<subdir>/<namespace>/<name>.mojoc`
# (artifacts_layout_test.zig says what each case catches): the files of the built :mopm_artifacts, and
# the paths :mopm_darwin_libs lists in `[layout]` (written at analysis: nothing is built for macOS
# here), are held to packages.bzl and to the declared natives.
zig_test(
    name = "artifacts_layout_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "artifacts_layout_test.zig",
    data = {
        "darwin_layout.json": ":mopm_darwin_libs[layout]",
        "darwin_libs.bzl": ":darwin_libs.bzl",
        "linux_artifacts": ":mopm_artifacts",
        "native_ids.json": ":native_ids_json",
        "packages.bzl": "//release/readme_e2e:packages.bzl",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# Two rules that protect the release, held on the real files and on fixtures with the rule broken
# (release_checks_test.zig says what each case catches): release/artifacts.textproto and
# tools/build/package/release_set.txt are the same release (metapackage, members in order,
# --license, --summary and --home), and a release does not name both so packages.
zig_test(
    name = "release_checks_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "release_checks_test.zig",
    data = {
        "artifacts.textproto": "artifacts.textproto",
        "release_set.txt": "//tools/build/package:release_set.txt",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# The macOS arm64 build set (darwin_libs.bzl): the library of every mopm package that builds for
# macOS, and each declared native's archive, built with `--target-platforms
# komira//tools/build/platforms:darwin-arm64` by release-macos.yml's `release-macos` job on the farm's
# macOS workers, once per release, and as the osx-arm64 half of :mopm_release_artifacts by release.yml's
# `mopm-stage`, which publishes it. //ci:pr builds for the client's
# platform only; pr.yml's macOS part builds this set (or the libraries of it the change reaches,
# tools/build/ci/darwin.bxl) for darwin-arm64, and its last step configures and analyses it, running
# no action (darwin_analysis.bxl). The zig case //:release_macos_cases holds that no other line of a
# workflow that runs on a pull request names it or a macOS platform.
# The set's definition and this file, for the zig cases that hold the set to one list
# (//:release_macos_cases).
export_file(
    name = "darwin_libs.bzl",
    visibility = ["//:"],
)

export_file(
    name = "release_buck",
    src = "BUCK",
    visibility = ["//:"],
)

mopm_darwin_libs(
    name = "mopm_darwin_libs",
    natives = RELEASE_NATIVES,
    packages = DARWIN_PACKAGES,
    visibility = ["PUBLIC"],
)

# The gate of :mopm_release_artifacts: it is compatible only under `-c komira_release.mac_tree=true`, which the two
# places that register the macOS execution platform pass (release.yml's step `build the packages`, and
# darwin_analysis.buckconfig for pr.yml's analysis). Anywhere else (a Linux graph query of `//...`, the pull request
# check) it is incompatible and skipped, since its macOS half cannot be configured without that platform.
config_setting(
    name = "mac_tree",
    values = {"komira_release.mac_tree": "true"},
)

constraint_setting(name = "mac_tree_setting")

# No platform has it: a target that requires it is incompatible everywhere.
constraint_value(
    name = "mac_tree_off",
    constraint_setting = ":mac_tree_setting",
)

# The directory release.yml's `mopm-stage` stages and publishes (mopm_artifacts.bzl, `mopm_release_artifacts`):
# :mopm_artifacts (linux-64) and :mopm_darwin_libs (osx-arm64, configured for darwin-arm64 by the rule's
# transition, so it is built on the farm's macOS workers), merged into one `mopm stage --artifacts` directory. Built
# only with the macOS execution platform registered (`mopm-stage` names the file of the macOS keys for this one
# step), so //ci:pr leaves it out (EXCLUDED of tools/build/ci/rules.bzl); pr.yml's last step configures and
# analyses it (darwin_analysis.bxl), running no action.
mopm_release_artifacts(
    name = "mopm_release_artifacts",
    linux = ":mopm_artifacts",
    mac = ":mopm_darwin_libs",
    target_compatible_with = select({":mac_tree": [], "DEFAULT": [":mac_tree_off"]}),  # komira-limit:release-mac-tree
    visibility = ["PUBLIC"],
)
