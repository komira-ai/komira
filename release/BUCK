# The release files: what a release of komira builds (artifacts.textproto), the
# set that builds it (release_set, below). .github/workflows/release.yml builds the set on every
# push to main. release_set below holds the set to artifacts.textproto (a build
# action).
# release/ci (a package of its own) holds the programs of the workflows
# (main_red, check_release_ref, release_json), built behind their cases.
# Changes need the release approver's review (.github/CODEOWNERS).

load("@komira//tools/build/lint:doc_tree.bzl", "docs_checked")
load("@komira//tools/build/mojo:toolchain.bzl", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":darwin_libs.bzl", "DARWIN_PACKAGES", "mopm_darwin_libs")
load(":exec_tools.bzl", "exec_tool_cases")
load(":mopm_artifacts.bzl", "merge_tree_cases", "mopm_artifacts", "mopm_release_artifacts", "native_ids_json", "release_packages_json")
load(":plan_expectation.bzl", "mopm_plan_expectation", "plan_expectation_cases")
load(":release_set.bzl", "release_set")
load(":unpublished.bzl", "src_library_paths")
load("//release/readme_e2e:packages.bzl", README_E2E_NAMESPACE = "NAMESPACE", README_E2E_PACKAGES = "PACKAGES")

# Fails loading this package if `exec_tool_refusal` (exec_tools.bzl, the check of
# darwin_analysis.bxl that every Zig tool an action runs is built for the platform the action
# runs on) gets any of its cases wrong.
exec_tool_cases()

# Fails loading this package if `merge_trees` (mopm_artifacts.bzl: the two platforms' trees of the directory the
# release stages, one per subdir, each path under its own) gets any of its cases wrong.
merge_tree_cases()

# Fails loading this package if `plan_expectation_members` (plan_expectation.bzl: the packages and subdirs a
# release's plan.json must stage) gets any of its cases wrong.
plan_expectation_cases()

# The `[native.<id>]` archive of each package that declares one, `{package: {id: archive target}}`: the target its
# `mojo_conda` passes to `--native`, so the archive staged is the one linked into its tests. One table for both
# platforms: //release:mopm_artifacts takes it for linux-64 and //release:mopm_darwin_libs for osx-arm64, and each
# holds it to the packages' manifests (mopm_artifacts.bzl's `check_natives`).
RELEASE_NATIVES = {
    "async_api": {"komira_concurrency_pool_depth": "//src/async_api:native_komira_concurrency_pool_depth"},
    "awslc": {"awslc": "//src/awslc:awslc_native"},
    "compression": {"snappy": "//third_party/snappy:snappy_native"},
    "crypto": {"komira_crypto_sha256_hw": "//src/crypto:native_komira_crypto_sha256_hw"},
    "libc": {"komira_libc_posix": "//src/libc:native_komira_libc_posix"},
    "log": {"komira_log_holder": "//src/log:native_komira_log_holder"},
    "metrics": {"komira_metrics_ea_flag": "//src/metrics:native_komira_metrics_ea_flag"},
}

# The packages of the release and those of them that ship a native archive (the keys of RELEASE_NATIVES), as
# JSON: //tools/build/ci:prod_add_set_cases fails when a native package is not one `release_staged_verify add`
# installs from prod, or when it installs a name that is no package of the release.
release_packages_json(
    name = "release_packages_json",
    namespace = README_E2E_NAMESPACE,
    natives = sorted(RELEASE_NATIVES.keys()),
    packages = sorted(README_E2E_PACKAGES.keys()),
    visibility = ["//tools/build/ci:"],
)

# The build artifacts of the libraries moved to mopm (mopm_artifacts.bzl): each
# package's `:lib`, as `linux-64/komira-ai/<name>.mojoc`, and each package's native archive as
# `linux-64/komira-ai/<name>.native/lib<id>.a`, the directory `mopm stage
# --artifacts` packs. The list is //release/readme_e2e:packages.bzl's, which
# //:readme_e2e_complete holds to the src/ packages that have a mopm.toml.
# release.yml's `mopm-stage` job builds it, as the linux-64 half of
# :mopm_release_artifacts (below), stages it, tries the README examples against the
# staged set and dry-runs the publish on every push to main; the `prod-*` jobs publish
# the set (docs/ci.md).
mopm_artifacts(
    name = "mopm_artifacts",
    natives = RELEASE_NATIVES,
    packages = sorted(README_E2E_PACKAGES.keys()),
    visibility = ["PUBLIC"],
)

# The set the plan `mopm stage` writes must be (plan_expectation.bzl): every package of packages.bzl with a
# file for linux-64, and a file for osx-arm64 exactly when it is one of DARWIN_PACKAGES, written from those
# lists as JSON. release.yml's `mopm-stage` builds it and runs `release_staged_verify expect` with it on the
# staged set's plan.json right after `mopm stage`, before anything reaches the registry (docs/ci.md).
mopm_plan_expectation(
    name = "mopm_plan_expectation",
    darwin = DARWIN_PACKAGES,
    namespace = README_E2E_NAMESPACE,
    packages = sorted(README_E2E_PACKAGES.keys()),
    visibility = ["PUBLIC"],
)

# The release set: every package release/artifacts.textproto declares, in its
# order, and the metapackage `komira_all` over them (release_set.bzl). The
# list is the file's: `release_json names` fails the build when the two
# disagree. Adding a library to a release is its entry in the file, above the
# metapackage, its entry in the metapackage's --member-manifest arguments there,
# and its `_conda` target here. The release is built stamped
# (.github/workflows/release.yml); built without a stamp (the pull request's
# check) the set is still checked.
