# Every release member is claimed on the prod registry. release.yml publishes the members
# (the packages of README_E2E_PACKAGES) to prod on every push to main, and the registry
# creates a name only for its claimed owner, so an unclaimed member fails `prod-stage` and
# turns main red. The pull request check cannot write to the live registry, so the claimed
# names are committed (prod_claimed_names.txt: a maintainer adds one only after claiming it)
# and this build action refuses a member the file lacks, naming it
# (prod_claimed_names_test.zig says what each case catches).
zig_test(
    name = "prod_claimed_names_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "prod_claimed_names_test.zig",
    data = {
        "packages.bzl": "//release/readme_e2e:packages.bzl",
        "prod_claimed_names.txt": "prod_claimed_names.txt",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# Two rules that protect the release, held on the real files and on fixtures with the rule broken
# (release_checks_test.zig says what each case catches): release/artifacts.textproto and
# tools/build/package/release_set.txt are the same release (metapackage, members in order,
# --license, --summary and --home), and a release does not name both so packages.
zig_test(
    name = "release_checks_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "release_checks_test.zig",
    data = {
        "artifacts.textproto": "artifacts.textproto",
        "release_set.txt": "//tools/build/package:release_set.txt",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)

# The macOS arm64 build set (darwin_libs.bzl): the library of every mopm package that builds for
# macOS, built with `--target-platforms komira//tools/build/platforms:darwin-arm64` by release-macos.yml's
# `release-macos` job on the farm's macOS workers, once per release. It is in no pull request's
# check: //ci:pr builds for the client's platform only, and the zig case
# //:release_workflow_cases holds that no workflow that runs on a pull request names it or a
# macOS platform.
# The set's definition and this file, for the zig cases that hold the set to one list
# (//:release_macos_cases).
export_file(
    name = "darwin_libs.bzl",
    visibility = ["//:"],
)

export_file(
    name = "release_buck",
    src = "BUCK",
    visibility = ["//:"],
)

mopm_darwin_libs(
    name = "mopm_darwin_libs",
    packages = DARWIN_PACKAGES,
    visibility = ["PUBLIC"],
)
