# Every release member is claimed on the prod registry. release.yml publishes the members
# (the packages of README_E2E_PACKAGES) to prod on every push to main, and the registry
# creates a name only for its claimed owner, so an unclaimed member fails `prod-stage` and
# turns main red. The pull request check cannot write to the live registry, so the claimed
# names are committed (prod_claimed_names.txt: a maintainer adds one only after claiming it)
# and this build action refuses a member the file lacks, naming it
# (prod_claimed_names_test.zig says what each case catches).
zig_test(
    name = "prod_claimed_names_cases",
    exec_compatible_with = LINUX_X86_64,
    src = "prod_claimed_names_test.zig",
    data = {
        "packages.bzl": "//release/readme_e2e:packages.bzl",
        "prod_claimed_names.txt": "prod_claimed_names.txt",
    },
    busybox = "komira//tools/build/toolchains:busybox",
    zig = "komira//tools/build/toolchains:zig_next",
    visibility = ["PUBLIC"],
)
