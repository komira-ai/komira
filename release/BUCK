# The release files: what a release of komira builds (artifacts.textproto), the
# set that builds it (release_set, below) and where it would be published
# (channels.textproto). .github/workflows/release.yml builds the set on every
# push to main. The release machine file (machine.textproto) is the retired
# release tool's: no workflow runs it any more, and kci's own tests still read
# it. Each file is welded to the test of the parser that reads it, so a file
# kci would refuse fails `./buck2 build //...`:
#   machine.textproto    src/kci_release_machine (the machine file)
#   artifacts.textproto  src/kci_artifact (test_release_artifacts_file), and
#                        release_set below holds the set to it (a build action)
#   channels.textproto   src/kci_release_channel (test_release_channels_file);
#                        no stage names it (komira publishes to no channel for
#                        now)
# release/ci (a package of its own) holds the programs of the workflows
# (main_red, check_release_ref, release_json), built behind their cases.
# Changes need the release approver's review (.github/CODEOWNERS).

load("@komira//tools/build/mojo:toolchain.bzl", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "LINUX_X86_64")
load(":mopm_artifacts.bzl", "mopm_artifacts")
load(":release_set.bzl", "release_set")
load("//release/readme_e2e:packages.bzl", README_E2E_PACKAGES = "PACKAGES")

export_file(
    name = "artifacts.textproto",
    visibility = ["//src/kci_artifact:"],
)

export_file(
    name = "channels.textproto",
    visibility = ["//src/kci_release_channel:"],
)

# By reference: a validation target passes kci its path in the checkout.
export_file(
    name = "machine.textproto",
    mode = "reference",
    visibility = ["//release/validations:", "//src/kci_release_machine:"],
)

# The build artifacts of the libraries moved to mopm (mopm_artifacts.bzl): each
# package's `:lib`, as `linux-64/<name>.mojoc`, and each package's native archive as
# `linux-64/<name>.native/lib<id>.a`, the directory `mopm stage
# --artifacts` packs. The list is //release/readme_e2e:packages.bzl's, which
# //:readme_e2e_complete holds to the src/ packages that have a mopm.toml.
# release.yml's `mopm-stage` job builds it, stages it, tries the README
# examples against the staged set and dry-runs the publish on every push to
# main; the `prod-*` jobs publish the set, only when enabled (docs/ci.md).
mopm_artifacts(
    name = "mopm_artifacts",
    natives = {"komira_libc": {"komira_libc_posix": "//src/komira_libc:native_komira_libc_posix"}},
    packages = sorted(README_E2E_PACKAGES.keys()),
    visibility = ["PUBLIC"],
)

# The release set: every package release/artifacts.textproto declares, in its
# order, and the metapackage `komira_all` over them (release_set.bzl). The
# list is the file's: `release_json names` fails the build when the two
# disagree. Adding a library to a release is its entry in the file, above the
# metapackage, its entry in the metapackage's --member-manifest arguments there,
# and its `_conda` target here. The release is built stamped
# (.github/workflows/release.yml); built without a stamp (the pull request's
# check) the set is still checked.
release_set(
