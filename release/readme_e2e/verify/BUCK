# The README e2e of the release: one target per package moved to mopm, and `:all`.
# Each installs the package from //release/readme_e2e:staged into a fresh project and
# runs its README examples against the installed copy (tools/build/readme_e2e/README.md).
# The release workflow builds `:all`.
load("@komira//tools/build/readme_e2e:defs.bzl", "readme_e2e", "readme_e2e_all")
load("//release/readme_e2e:packages.bzl", "MOJO", "MOPM", "PACKAGES")

[
    readme_e2e(
        name = name,
        mojo = MOJO,
        mopm = MOPM,
        package = name,
        staged = "//release/readme_e2e:staged",
        version = version,
        visibility = ["PUBLIC"],
    )
    for name, version in PACKAGES.items()
]

readme_e2e_all(
    name = "all",
    packages = [":" + name for name in sorted(PACKAGES.keys())],
    visibility = ["PUBLIC"],
)
