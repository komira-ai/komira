# The set the beta registry serves, as a build input: every file of this directory but this
# one. The job `mopm-e2e-beta` of .github/workflows/release.yml writes it here with
# `release_beta_fetch --out release/beta_set` (tools/build/ci/release_beta_fetch): `plan.json` and
# the READMEs of the staged set `mopm-stage-beta` made, and each `<subdir>/<file>.conda` as it
# was DOWNLOADED from the beta channel, after its sha256 and size were checked against the plan.
# It then builds //release/readme_e2e/verify:all with `-c komira_release.staged=beta`, which
# installs from this target. The files are not in the repository (.gitignore), so the target is
# empty in a checkout and the e2e against it fails on the missing plan.json.
#
# Downloading asks the registry for each file, so it cannot run as a build action (an action is
# offline): the farm gets the downloaded set as an input, and the README e2e runs on the farm
# against the published bytes.
filegroup(
    name = "set",
    srcs = glob(["**"], exclude = ["BUCK"]),
    visibility = ["//release/readme_e2e/verify:"],
)
