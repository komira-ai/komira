load("@komira//python:install_test.bzl", "picked_files", "wheel_install_test")
load("@komira//tools/build/package:wheel.bzl", "wheel_file", "wheel_version")
load("@komira//tools/build/platforms:table.bzl", "asset")
load("@komira//tools/build/python:defs.bzl", "python_proto", "python_source_package")

# The import package `komira` (README.md): its files at their paths, as the site
# directory the package's tests import it from (tests/BUCK). The wheel rule
# will read the same files.
python_source_package(
    name = "komira",
    srcs = glob(["komira/**/*.py"]) + ["komira/py.typed"],
    visibility = ["//python/tests:"],
)

# The Python modules of the plan wire, `komira.plan.v1.plan_pb2` (the messages
# of src/plan_proto/plan.proto, `WirePlanEnvelope` among them) and
# `komira.plan.v1.plan_vocabulary_pb2` (its enums), generated by the pinned
# protoc (29.1, gencode 5.29.1) at the paths their proto package gives them:
# plan_pb2 imports `from komira.plan.v1 import plan_vocabulary_pb2`. Each is the
# sub-target `[<stem>_pb2]`. The protobuf runtime they load under is
# `PROTOBUF_REQUIREMENT` (dependencies.bzl); python/tests holds both to the
# plan wire's goldens under each edge of that range.
python_proto(
    name = "plan_pb2",
    srcs = [
        "//src/plan_proto:plan.proto",
        "//src/plan_proto:plan_vocabulary.proto",
    ],
    import_prefix = "komira/plan/v1",
    visibility = ["komira//python/tests:"],
)

# ---- The wheel ----------------------------------------------------------------
#
# `pip install komira`: the import package, libkomira at komira/_lib/libkomira.so
# (where _native.load opens it with no directory given) and its native owner
# libraries at komira/_lib/lib/ (libkomira's run path, `$ORIGIN/lib`), with
# README.md as the description and LICENSE and NOTICE in
# `.dist-info/licenses/` (the rule's default). Written by `wheel_file`
# (tools/build/package/README.md, "The Python wheel"), which refuses a library
# that needs a newer glibc than the tag's 2.34, any GLIBCXX_ or CXXABI_
# version (none is allowed: libkomira and its owners need none, src/so/README.md),
# a run path not under `$ORIGIN`, a NEEDED library nobody provides, or one of
# the Mojo runtime libraries in the wheel: those come from Modular's
# `mojo-compiler` (docs/design/python_package.md, decision 6), the one
# Requires-Dist. The C++ runtime libraries of `[runnable]` are left out too:
# only the Mojo runtime needs them, and a manylinux host provides them.
# Release 1 returns no Arrow and encodes no plan, so neither pyarrow nor
# protobuf is required, and the generated plan modules are not in the wheel.
# Unstamped the version is 0.0.0; the release set's stamp gives 0.1.<N>.

# The libraries //src/so:libkomira links as NEEDED besides the Mojo runtime
# (src/so/BUCK, NATIVE_OWNERS; their file names are the table of
# src/so/README.md). One left out of the wheel fails the wheel's `needed` check.
_OWNERS = [
    "libkomira_async_api_native.so.1",
    "libkomira_async_rt_native.so.1",
    "libkomira_compression_native.so.1",
    "libkomira_fs_native.so.1",
    "libkomira_libc_native.so.1",
    "libkomira_metrics_native.so.1",
    "libkomira_parquet_codec_native.so.1",
    "libkomira_scan_source_native.so.1",
]

picked_files(
    name = "libkomira_files",
    dir = "//src/so:libkomira[runnable]",
    paths = ["libkomira.so"] + ["lib/" + o for o in _OWNERS],
)

_PY_FILES = {f: f for f in glob(["komira/**/*.py"]) + ["komira/py.typed"]}

_LIBKOMIRA = {"komira/_lib/libkomira.so": ":libkomira_files[libkomira.so]"}

_NATIVE_FILES = _LIBKOMIRA | {"komira/_lib/lib/" + o: ":libkomira_files[" + o + "]" for o in _OWNERS}

# The Mojo of the toolchain: the version of its conda pin
# (`mojo_compiler_<version>_linux-64.conda`).
_TOOLCHAIN_MOJO = asset("linux-x86_64", "mojo_compiler")["name"].split("_")[2]

_MOJO_PIN = "1.0.0"

_WHEEL = {
    "classifiers": ["Development Status :: 2 - Pre-Alpha"],
    "distribution": "komira",
    "external_needed": [
        "libAsyncRTRuntimeGlobals.so",
        "libKGENCompilerRTShared.so",
        "libMSupportGlobals.so",
    ],
    "license_expression": "Apache-2.0",
    "platform": "linux-x86_64",
    "project_urls": {
        "Issues": "https://github.com/komira-ai/komira/issues",
        "Source": "https://github.com/komira-ai/komira",
    },
    "readme": "README.md",
    "requires_dist": ["mojo-compiler==" + _MOJO_PIN],
    "requires_python": ">=3.13",
    "summary": "SQL over local files, with the komira query engine in process",
}

wheel_file(
    name = "komira_wheel",
    files = _PY_FILES | _NATIVE_FILES,
    executable = sorted(_NATIVE_FILES.keys()),
    **_WHEEL
)

# ---- The clean-environment install test --------------------------------------
#
# The wheel and Modular's two (third_party/modular) installed into an empty
# virtual environment of the hermetic interpreter, with no pip, no network and
# no library path, and python/tests/test_installed.py run there in isolated
# mode from an empty directory (python/install_test.bzl): the package imports
# from the prefix at the wheel's version with its licences, its one
# requirement pins the Mojo that komira._runtime loads and the toolchain
# builds with, libkomira loads at the ABI version of src/so/abi/komira.tsv, a
# Parquet file registers and a missing one raises KomiraError, a serialized
# plan renders, and the Mojo runtime libraries are mapped from
# <site-packages>/modular/lib, put there by mojo-compiler, through the
# runtime preload of komira/_runtime.py. On CPython 3.13 and 3.14, the edges
# of Requires-Python that are pinned (third_party/python).
_MODULAR = [
    "komira//third_party/modular:mojo_compiler-1.0.0-py3-none-manylinux_2_34_x86_64.whl",
    "komira//third_party/modular:mojo_compiler_mojo_libs-1.0.0-py3-none-any.whl",
]

_TEST_FILES = {
    "--abi-table": "komira//src/so:abi/komira.tsv",
    "--license": "komira//:LICENSE",
    "--notice": "komira//:NOTICE",
    "--parquet": "komira//src/so:tests/fixtures/two_columns.parquet",
    "--plan-hex": "komira//python/tests:fixtures/scan_plan.hex",
}

# The version the wheel is stamped with: the stamp wheel_file reads.
_VERSION = wheel_version(read_config("komira", "package_stamp", "0"))

[wheel_install_test(
    name = name,
    python = python,
    wheels = [":komira_wheel"] + _MODULAR,
    script = "komira//python/tests:test_installed.py",
    args = [
        "--version",
        _VERSION,
        "--toolchain-mojo-version",
        _TOOLCHAIN_MOJO,
    ],
    files = _TEST_FILES,
) for name, python in [
    ("wheel_install_test", "komira//third_party/python:cpython"),
    ("wheel_install_test_py314", "komira//third_party/python:cpython314"),
]]

# The same test on installs that must fail, each with the line it fails with
# (on CPython 3.13). Each wheel below is the package's wheel with one thing
# wrong that the wheel rule does not refuse.
wheel_file(
    name = "komira_wheel_without_libkomira",
    files = _PY_FILES,
    **_WHEEL
)

# The owner libraries beside libkomira's run path instead of on it: every
# NEEDED name is a member of the wheel, so the rule writes it, and the loader
# finds none of them.
_MISPLACED = _LIBKOMIRA | {"komira/_lib/misplaced/" + o: ":libkomira_files[" + o + "]" for o in _OWNERS}

wheel_file(
    name = "komira_wheel_misplaced_owners",
    files = _PY_FILES | _MISPLACED,
    executable = sorted(_MISPLACED.keys()),
    **_WHEEL
)

wheel_file(
    name = "komira_wheel_arm64_tag",
    files = _PY_FILES,
    **(_WHEEL | {"platform": "linux-arm64"})
)

wheel_file(
    name = "komira_wheel_requires_python_315",
    files = _PY_FILES,
    **(_WHEEL | {"requires_python": ">=3.15"})
)

_LOAD_ERROR = "komira._errors.LibraryLoadError: cannot load libkomira from <site>/komira/_lib/libkomira.so: "

[wheel_install_test(
    name = name,
    python = "komira//third_party/python:cpython",
    wheels = wheels,
    script = "komira//python/tests:test_installed.py",
    args = [
        "--version",
        _VERSION,
        "--toolchain-mojo-version",
        toolchain_mojo,
    ],
    files = _TEST_FILES,
    skip_requirements = skip,
    expect_failure = expect,
) for name, wheels, toolchain_mojo, skip, expect in [
    # The wheel without libkomira.so.
    (
        "refuses_missing_libkomira",
        [":komira_wheel_without_libkomira"] + _MODULAR,
        _TOOLCHAIN_MOJO,
        False,
        _LOAD_ERROR + "<site>/komira/_lib/libkomira.so: cannot open shared object file: No such file or directory",
    ),
    # A wheel whose owner libraries libkomira's run path does not reach: the
    # first NEEDED one after the preloaded runtime is the loader's error.
    (
        "refuses_owners_off_run_path",
        [":komira_wheel_misplaced_owners"] + _MODULAR,
        _TOOLCHAIN_MOJO,
        False,
        _LOAD_ERROR + "libkomira_async_rt_native.so.1: cannot open shared object file: No such file or directory",
    ),
    # No mojo-compiler, so no modular/lib (installed as with --no-deps): the
    # runtime preload's named error, every directory of sys.path searched.
    (
        "refuses_missing_mojo_runtime",
        [":komira_wheel"],
        _TOOLCHAIN_MOJO,
        True,
        "komira._errors.RuntimeNotFoundError: the Mojo runtime 1.0.0 is not installed: " +
        "libMSupportGlobals.so, libAsyncRTRuntimeGlobals.so, libKGENCompilerRTShared.so not found (searched " +
        "<python>/lib/python313.zip/modular/lib, <python>/lib/python3.13/modular/lib, " +
        "<python>/lib/python3.13/lib-dynload/modular/lib, <site>/modular/lib); " +
        "install it with: pip install mojo-compiler==1.0.0",
    ),
    # A wheel tagged for another platform is not installed.
    (
        "refuses_wheel_of_another_platform",
        [":komira_wheel_arm64_tag"] + _MODULAR,
        _TOOLCHAIN_MOJO,
        False,
        "install: the wheel of komira is tagged py3-none-manylinux_2_34_aarch64, which this interpreter (CPython 3.13 on x86_64) does not install",
    ),
    # mojo-compiler without the wheel it requires.
    (
        "refuses_unmet_requirement",
        [":komira_wheel", _MODULAR[0]],
        _TOOLCHAIN_MOJO,
        False,
        "install: mojo-compiler 1.0.0 requires mojo-compiler-mojo-libs==1.0.0, which is not installed",
    ),
    # A Requires-Python the interpreter is outside of.
    (
        "refuses_python_outside_requires_python",
        [":komira_wheel_requires_python_315"] + _MODULAR,
        _TOOLCHAIN_MOJO,
        False,
        "install: komira requires Python >=3.15; this interpreter is 3.13.16",
    ),
    # A toolchain Mojo other than the wheel's pin and komira._runtime's.
    (
        "refuses_mojo_pin_unlike_toolchain",
        [":komira_wheel"] + _MODULAR,
        "0.0.1",
        False,
        "AssertionError: the Mojo runtime versions differ: 1.0.0 (the wheel's Requires-Dist), 1.0.0 (komira._runtime) and 0.0.1 (the toolchain's pin)",
    ),
]]
