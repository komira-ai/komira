load("@komira//python:install_test.bzl", "picked_files", "wheel_install_test")
load("@komira//tools/build/package:wheel.bzl", "wheel_file", "wheel_libs_check", "wheel_version")
load("@komira//tools/build/platforms:table.bzl", "asset")
load("@komira//tools/build/python:defs.bzl", "python_proto", "python_source_package")

# The import package `komira` (README.md): its files at their paths, as the site
# directory the package's tests import it from (tests/BUCK). The wheel rule
# will read the same files.
python_source_package(
    name = "komira",
    srcs = glob(["komira/**/*.py"]) + ["komira/py.typed"],
    visibility = ["//python/tests:"],
)

# The Python modules of the plan wire, `komira.plan.v1.plan_pb2` (the messages
# of src/plan_proto/plan.proto, `WirePlanEnvelope` among them) and
# `komira.plan.v1.plan_vocabulary_pb2` (its enums), generated by the pinned
# protoc (29.1, gencode 5.29.1) at the paths their proto package gives them:
# plan_pb2 imports `from komira.plan.v1 import plan_vocabulary_pb2`. Each is the
# sub-target `[<stem>_pb2]`. The protobuf runtime they load under is
# `PROTOBUF_REQUIREMENT` (dependencies.bzl); python/tests holds both to the
# plan wire's goldens under each edge of that range.
python_proto(
    name = "plan_pb2",
    srcs = [
        "//src/plan_proto:plan.proto",
        "//src/plan_proto:plan_vocabulary.proto",
    ],
    import_prefix = "komira/plan/v1",
    visibility = ["komira//python/tests:"],
)

# ---- The wheel ----------------------------------------------------------------
#
# `pip install komira`: the import package, and `//src/so:libkomira[dist]` as it
# is at komira/_lib/: libkomira.so (where _native.load opens it with no
# directory given), and in komira/_lib/lib/ (its run path, `$ORIGIN/lib`) its
# native owner libraries and the three Mojo runtime libraries of the pinned
# compiler that built it (tools/build/mojo/README.md, `[dist]`). The wheel
# stages no native file of its own: another language package copies the same
# directory. It requires no other distribution: nothing of Modular's is
# installed with it (docs/design/python_package.md, decisions 6 and 7).
#
# Written by `wheel_file` (tools/build/package/README.md, "The Python wheel"),
# which refuses a library that needs a newer glibc than the tag's, a GLIBCXX_
# or CXXABI_ version above the bounds below, a run path not under `$ORIGIN`, or
# a NEEDED library that is neither in the wheel nor a manylinux system library
# (the C++ runtime, libstdc++ and libgcc_s, is one: the host provides it). The
# description is README.md; `.dist-info/licenses/` holds LICENSE and NOTICE,
# and the licence texts of the Mojo runtime libraries as their pinned package
# carries them (third_party/modular/BUCK; NOTICE says which files each
# covers). Release 1 returns no Arrow and encodes no plan, so neither pyarrow
# nor protobuf is required, and the generated plan modules are not in the
# wheel. Unstamped the version is 0.0.0; the release set's stamp gives
# 0.1.<N>.

_PLATFORM = "linux-x86_64"

# What the Mojo runtime libraries the wheel carries need, per platform, above
# what komira's own files need (the platform row's `os_floor` is the floor of
# what the repository links): libAsyncRTRuntimeGlobals.so needs GLIBC_2.35,
# libKGENCompilerRTShared.so GLIBCXX_3.4.30 and CXXABI_1.3.11 (src/so/README.md,
# the table of libkomira_elf_report), within what manylinux_2_35 lets a wheel
# need from the host. A platform that joins names its own row here; the wheel
# rule refuses a wheel whose files need more.
_NATIVE_NEEDS = {
    "linux-x86_64": {
        "max_cxxabi": "1.3.11",
        "max_glibcxx": "3.4.30",
        "os_floor": "glibc-2.35",
    },
}

_PY_FILES = {f: f for f in glob(["komira/**/*.py"]) + ["komira/py.typed"]}

_DIST = "//src/so:libkomira[dist]"

_NATIVE_FILES = {"komira/_lib": _DIST}

# komira's licence, and the licence texts of the pinned Mojo compiler package
# the runtime libraries come from, unmodified (third_party/modular/BUCK).
_LICENSE_FILES = {
    "LICENSE": "komira//:LICENSE",
    "NOTICE": "komira//:NOTICE",
    "MODULAR_LICENSE": "komira//third_party/modular:mojo_compiler_licenses[info/licenses/LICENSE]",
    "MODULAR_THIRD_PARTY_NOTICES": "komira//third_party/modular:mojo_compiler_licenses[info/licenses/Third-Party-Notices]",
}

# komira's own files are Apache-2.0; the Mojo runtime libraries are Modular's,
# under the licence their package declares (`LicenseRef-Modular-Proprietary`,
# the Modular Community License Terms in MODULAR_LICENSE).
_LICENSE_EXPRESSION = "Apache-2.0 AND LicenseRef-Modular-Proprietary"

_WHEEL = {
    "classifiers": ["Development Status :: 2 - Pre-Alpha"],
    "distribution": "komira",
    "license_expression": _LICENSE_EXPRESSION,
    "license_files": _LICENSE_FILES,
    "platform": _PLATFORM,
    "project_urls": {
        "Issues": "https://github.com/komira-ai/komira/issues",
        "Source": "https://github.com/komira-ai/komira",
    },
    "readme": "README.md",
    "requires_python": ">=3.13",
    "summary": "SQL over local files, with the komira query engine in process",
} | _NATIVE_NEEDS[_PLATFORM]

wheel_file(
    name = "komira_wheel",
    files = _PY_FILES | _NATIVE_FILES,
    executable = sorted(_NATIVE_FILES.keys()),
    **_WHEEL
)

# ---- The clean-environment install test --------------------------------------
#
# The wheel alone installed into an empty virtual environment of the hermetic
# interpreter, with no pip, no index, no network and no library path, and
# python/tests/test_installed.py run there in isolated mode from an empty
# directory (python/install_test.bzl): the environment holds komira and
# nothing else, no `modular/` directory and no distribution of Modular's; the
# package imports from the prefix at the wheel's version, with its licences
# and the runtime's licence texts and no Requires-Dist; libkomira loads at the
# ABI version of src/so/abi/komira.tsv, a Parquet file registers and a missing
# one raises KomiraError, a serialized plan renders, and libkomira, its native
# owners and the three Mojo runtime libraries are mapped from
# <site>/komira/_lib and nothing else of theirs is. On CPython 3.13 and 3.14,
# the edges of Requires-Python that are pinned (third_party/python).

_TEST_FILES = {
    "--abi-table": "komira//src/so:abi/komira.tsv",
    "--license": "komira//:LICENSE",
    "--modular-license": _LICENSE_FILES["MODULAR_LICENSE"],
    "--modular-notices": _LICENSE_FILES["MODULAR_THIRD_PARTY_NOTICES"],
    "--notice": "komira//:NOTICE",
    "--parquet": "komira//src/so:tests/fixtures/two_columns.parquet",
    "--plan-hex": "komira//python/tests:fixtures/scan_plan.hex",
}

# The version the wheel is stamped with: the stamp wheel_file reads.
_VERSION = wheel_version(read_config("komira", "package_stamp", "0"))

_INSTALLED_ARGS = [
    "--version",
    _VERSION,
    "--license-expression",
    _LICENSE_EXPRESSION,
]

[wheel_install_test(
    name = name,
    python = python,
    wheels = [":komira_wheel"],
    script = "komira//python/tests:test_installed.py",
    args = _INSTALLED_ARGS,
    files = _TEST_FILES,
) for name, python in [
    ("wheel_install_test", "komira//third_party/python:cpython"),
    ("wheel_install_test_py314", "komira//third_party/python:cpython314"),
]]

# The same test on installs that must fail, each with the line it fails with
# (on CPython 3.13). Each wheel below is the package's wheel with one thing
# wrong that the wheel rule does not refuse: its native files are picked one
# by one out of the same `[dist]` directory.
_RUNTIME = [
    "libAsyncRTRuntimeGlobals.so",
    "libKGENCompilerRTShared.so",
    "libMSupportGlobals.so",
]

# The native owners of //src/so:libkomira (src/so/BUCK, NATIVE_OWNERS; their
# file names are the table of src/so/README.md).
_OWNERS = [
    "libkomira_async_api_native.so.1",
    "libkomira_async_rt_native.so.1",
    "libkomira_compression_native.so.1",
    "libkomira_fs_native.so.1",
    "libkomira_libc_native.so.1",
    "libkomira_metrics_native.so.1",
    "libkomira_parquet_codec_native.so.1",
    "libkomira_scan_source_native.so.1",
]

picked_files(
    name = "dist_files",
    dir = _DIST,
    paths = ["libkomira.so"] + ["lib/" + n for n in _OWNERS + _RUNTIME],
)

_LIBKOMIRA = {"komira/_lib/libkomira.so": ":dist_files[libkomira.so]"}

wheel_file(
    name = "komira_wheel_without_libkomira",
    files = _PY_FILES,
    **_WHEEL
)

# The owner libraries beside libkomira's run path instead of on it: every
# NEEDED name is a member of the wheel, so the rule writes it, and the loader
# finds none of the owners.
_MISPLACED = _LIBKOMIRA | {"komira/_lib/lib/" + n: ":dist_files[" + n + "]" for n in _RUNTIME} | {
    "komira/_lib/misplaced/" + n: ":dist_files[" + n + "]"
    for n in _OWNERS
}

wheel_file(
    name = "komira_wheel_misplaced_owners",
    files = _PY_FILES | _MISPLACED,
    executable = sorted(_MISPLACED.keys()),
    **_WHEEL
)

# A damaged install: one of the three Mojo runtime libraries left out. The
# rule writes it only because `external_needed` says another package provides
# the file; nothing does, and the loader's error names it.
_WITHOUT_MSUPPORT = _LIBKOMIRA | {
    "komira/_lib/lib/" + n: ":dist_files[" + n + "]"
    for n in _OWNERS + _RUNTIME
    if n != "libMSupportGlobals.so"
}

wheel_file(
    name = "komira_wheel_without_runtime_library",
    files = _PY_FILES | _WITHOUT_MSUPPORT,
    executable = sorted(_WITHOUT_MSUPPORT.keys()),
    **(_WHEEL | {"external_needed": ["libMSupportGlobals.so"]})
)

wheel_file(
    name = "komira_wheel_arm64_tag",
    files = _PY_FILES,
    **(_WHEEL | {"platform": "linux-arm64"})
)

wheel_file(
    name = "komira_wheel_requires_python_315",
    files = _PY_FILES,
    **(_WHEEL | {"requires_python": ">=3.15"})
)

_LOAD_ERROR = "komira._errors.LibraryLoadError: cannot load libkomira from <site>/komira/_lib/libkomira.so: "

# Modular's wheels of the Mojo compiler (third_party/modular/BUCK): 1.0.0, the
# toolchain's version, with the wheel it requires, and 1.2.0.
_MODULAR = [
    "komira//third_party/modular:mojo_compiler-1.0.0-py3-none-manylinux_2_34_x86_64.whl",
    "komira//third_party/modular:mojo_compiler_mojo_libs-1.0.0-py3-none-any.whl",
]

_MODULAR_OTHER = ["komira//third_party/modular:mojo_compiler-1.2.0-py3-none-manylinux_2_34_x86_64.whl"]

[wheel_install_test(
    name = name,
    python = "komira//third_party/python:cpython",
    wheels = wheels,
    script = "komira//python/tests:test_installed.py",
    args = _INSTALLED_ARGS,
    files = _TEST_FILES,
    expect_failure = expect,
) for name, wheels, expect in [
    # The wheel without libkomira.so.
    (
        "refuses_missing_libkomira",
        [":komira_wheel_without_libkomira"],
        _LOAD_ERROR + "<site>/komira/_lib/libkomira.so: cannot open shared object file: No such file or directory",
    ),
    # A wheel whose owner libraries libkomira's run path does not reach: the
    # first NEEDED one after the Mojo runtime (found in lib/) is the loader's
    # error.
    (
        "refuses_owners_off_run_path",
        [":komira_wheel_misplaced_owners"],
        _LOAD_ERROR + "libkomira_async_rt_native.so.1: cannot open shared object file: No such file or directory",
    ),
    # A wheel without libMSupportGlobals.so: libKGENCompilerRTShared.so, found
    # in lib/, needs it, and the error names the missing file.
    (
        "refuses_missing_runtime_library",
        [":komira_wheel_without_runtime_library"],
        _LOAD_ERROR + "libMSupportGlobals.so: cannot open shared object file: No such file or directory",
    ),
    # A wheel tagged for another platform is not installed.
    (
        "refuses_wheel_of_another_platform",
        [":komira_wheel_arm64_tag"],
        "install: the wheel of komira is tagged py3-none-manylinux_2_35_aarch64, which this interpreter (CPython 3.13 on x86_64) does not install",
    ),
    # Another distribution beside komira is refused by the test: the
    # environment of `pip install komira` holds komira and nothing else.
    (
        "refuses_other_distribution",
        [":komira_wheel"] + _MODULAR,
        "AssertionError: the environment holds komira and also mojo-compiler, mojo-compiler-mojo-libs",
    ),
    # mojo-compiler without the wheel it requires: the installer's own check.
    (
        "refuses_unmet_requirement",
        [":komira_wheel", _MODULAR[0]],
        "install: mojo-compiler 1.0.0 requires mojo-compiler-mojo-libs==1.0.0, which is not installed",
    ),
    # A Requires-Python the interpreter is outside of.
    (
        "refuses_python_outside_requires_python",
        [":komira_wheel_requires_python_315"],
        "install: komira requires Python >=3.15; this interpreter is 3.13.16",
    ),
]]

# ---- The libraries of the finished wheel -------------------------------------
#
# The wheel read back from its bytes alone, by a second reader that knows none
# of the rule's inputs (`wheel_libs_check`, tools/build/package/README.md, "The
# Python wheel"): from komira/_lib/libkomira.so, the library _native.load
# opens, every DT_NEEDED is a manylinux system library or a member its run path
# reaches, every run path entry stays under `$ORIGIN` inside komira/, every
# shared library in the wheel is one libkomira loads, the three Mojo runtime
# libraries are carried once each with the bytes of the toolchain's runtime and
# with their licence texts, and no Requires-Dist names a distribution of
# Modular's that carries the runtime. The output lists the libraries in the
# loader's order. It reads nothing else of the rule's inputs, so the same
# command can read the bytes an index serves after an upload.
_LIBS_CHECK = {
    "entry": "komira/_lib/libkomira.so",
    "runtime_dists": ["mojo", "mojo-compiler", "mojo-compiler-mojo-libs"],
    "runtime_libs": _RUNTIME,
    "runtime_licenses": ["MODULAR_LICENSE", "MODULAR_THIRD_PARTY_NOTICES"],
}

wheel_libs_check(
    name = "wheel_libs",
    wheel = ":komira_wheel",
    **_LIBS_CHECK
)

# A second libKGENCompilerRTShared.so beside libkomira, the copy of the same
# runtime library that a bundling step would leave: every NEEDED name is a
# member, so the wheel rule writes it.
_SECOND_RUNTIME = {"komira/_lib/libKGENCompilerRTShared.so": ":dist_files[libKGENCompilerRTShared.so]"}

wheel_file(
    name = "komira_wheel_second_runtime",
    files = _PY_FILES | _NATIVE_FILES | _SECOND_RUNTIME,
    executable = sorted(_NATIVE_FILES.keys() + _SECOND_RUNTIME.keys()),
    **_WHEEL
)

# Each wheel the check refuses, with its exact line.
[wheel_libs_check(
    name = name,
    wheel = wheel,
    expect_refusal = line,
    **_LIBS_CHECK
) for name, wheel, line in [
    (
        "wheel_libs_refuses_second_runtime",
        ":komira_wheel_second_runtime",
        "runtime: the wheel carries libKGENCompilerRTShared.so 2 times (komira/_lib/lib/libKGENCompilerRTShared.so, " +
        "komira/_lib/libKGENCompilerRTShared.so), and a process holds one Mojo runtime",
    ),
    # libkomira's run path does not reach the owners where this wheel puts them.
    (
        "wheel_libs_refuses_owners_off_run_path",
        ":komira_wheel_misplaced_owners",
        "needed: komira/_lib/libkomira.so needs libkomira_async_rt_native.so.1, which its run path `$ORIGIN/lib:$ORIGIN` " +
        "does not reach in the wheel (the wheel has it at komira/_lib/misplaced/libkomira_async_rt_native.so.1)",
    ),
    (
        "wheel_libs_refuses_missing_runtime_library",
        ":komira_wheel_without_runtime_library",
        "runtime: the wheel carries no libMSupportGlobals.so",
    ),
    (
        "wheel_libs_refuses_missing_libkomira",
        ":komira_wheel_without_libkomira",
        "entry: the wheel has no komira/_lib/libkomira.so",
    ),
]]

# ---- Beside Modular's own runtime ------------------------------------------
#
# The wheel installed with Modular's mojo-compiler in the same environment,
# and Modular's runtime (<site>/modular/lib/libKGENCompilerRTShared.so, opened
# by path with ctypes, as a Mojo extension module's NEEDED entry opens it)
# loaded in the same process before or after komira's library
# (python/tests/test_beside_modular.py; docs/design/python_package.md,
# decision 6, says why each order does what it does):
#
# - the toolchain's version, Modular's first: libkomira binds to Modular's
#   runtime (the loader matches NEEDED names against what is loaded), which
#   the runtime check accepts (the same build ids), and komira's copy is not
#   mapped;
# - the toolchain's version, komira's first: Modular's libKGENCompilerRTShared.so
#   is a second copy, bound to komira's two other libraries; both work;
# - 1.2.0, Modular's first: the runtime check refuses it by name;
# - 1.2.0, komira's first: Modular's library fails to load, with the loader's
#   `undefined symbol` (its 1.2.0 code needs symbols komira's 1.0.0
#   libraries lack), and komira keeps working.
#
# 1.2.0's mojo-compiler-mojo-libs is not installed (`skip_requirements`, pip's
# --no-deps): the compiler wheel's runtime is all the test loads.
_BESIDE_FILES = {"--parquet": "komira//src/so:tests/fixtures/two_columns.parquet"}

# The Mojo of the toolchain: the version of its conda pin
# (`mojo_compiler_<version>_linux-64.conda`).
_TOOLCHAIN_MOJO = asset("linux-x86_64", "mojo_compiler")["name"].split("_")[2]

[wheel_install_test(
    name = name,
    python = "komira//third_party/python:cpython",
    wheels = [":komira_wheel"] + modular,
    script = "komira//python/tests:test_beside_modular.py",
    args = [
        "--order",
        order,
        "--runtime",
        runtime,
        "--modular-version",
        version,
        "--toolchain-mojo-version",
        toolchain,
    ],
    files = _BESIDE_FILES,
    skip_requirements = modular == _MODULAR_OTHER,
    expect_failure = expect,
) for name, modular, order, runtime, version, toolchain, expect in [
    ("beside_modular_loaded_first", _MODULAR, "modular-first", "same", "1.0.0", _TOOLCHAIN_MOJO, None),
    ("beside_modular_loaded_after", _MODULAR, "komira-first", "same", "1.0.0", _TOOLCHAIN_MOJO, None),
    (
        "beside_other_mojo_loaded_first",
        _MODULAR_OTHER,
        "modular-first",
        "other",
        "1.2.0",
        _TOOLCHAIN_MOJO,
        "komira._errors.LibraryLoadError: the Mojo runtime library libKGENCompilerRTShared.so is already loaded " +
        "from <site>/modular/lib, and it is another build than komira's " +
        "(<site>/komira/_lib/lib/libKGENCompilerRTShared.so): a process holds one Mojo runtime, so komira " +
        "cannot be loaded beside Mojo code built with another Mojo version",
    ),
    ("beside_other_mojo_loaded_after", _MODULAR_OTHER, "komira-first", "other", "1.2.0", _TOOLCHAIN_MOJO, None),
    # The same-version cases hold the installed mojo-compiler to the
    # toolchain's Mojo: a toolchain pin moved without third_party/modular
    # fails here.
    (
        "refuses_modular_unlike_toolchain",
        _MODULAR,
        "modular-first",
        "same",
        "1.0.0",
        "0.0.1",
        "AssertionError: the same-version cases need Modular's runtime at the toolchain's Mojo: mojo-compiler 1.0.0 is installed, the toolchain's is 0.0.1",
    ),
]]

# The files the smoke driver's `readme_shows_quickstart` test reads
