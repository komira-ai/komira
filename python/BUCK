# ---- The libraries of the finished wheel -------------------------------------
#
# The wheel read back from its bytes alone, by a second reader that knows none
# of the rule's inputs but these names and the toolchain's runtime libraries
# (`wheel_libs_check`, tools/build/package/README.md, "The Python wheel"): from
# komira/_lib/libkomira.so, the library _native.load opens, every DT_NEEDED is
# a manylinux system library or a member its run path reaches, every run path
# entry stays under `$ORIGIN` inside komira/, and every shared library in the
# wheel is one libkomira loads. The wheel carries the three Mojo runtime
# libraries once each, with the bytes of the toolchain's runtime and with
# their licence texts, and requires no distribution of Modular's. The output
# lists the libraries in the loader's order.
_LIBS_CHECK = {
    "entry": "komira/_lib/libkomira.so",
    "runtime_dists": ["mojo", "mojo-compiler", "mojo-compiler-mojo-libs"],
    "runtime_libs": _RUNTIME,
    "runtime_licenses": sorted(_MODULAR_LICENSE_FILES.keys()),
}

wheel_libs_check(
    name = "wheel_libs",
    wheel = ":komira_wheel",
    **_LIBS_CHECK
)

# A second libKGENCompilerRTShared.so beside libkomira in the wheel, the copy a
# bundling step would leave: every NEEDED name is a member, so the wheel rule
# writes it.
_SECOND_RUNTIME = {"komira/_lib": _DIST, "komira/_lib/libKGENCompilerRTShared.so": ":dist_files[libKGENCompilerRTShared.so]"}

wheel_file(
    name = "komira_wheel_second_runtime",
    files = _PY_FILES | _SECOND_RUNTIME,
    executable = sorted(_SECOND_RUNTIME.keys()),
    **_WHEEL
)

# Each wheel the check refuses, with its exact line.
[wheel_libs_check(
    name = name,
    wheel = wheel,
    expect_refusal = line,
    **_LIBS_CHECK
) for name, wheel, line in [
    (
        "wheel_libs_refuses_second_runtime",
        ":komira_wheel_second_runtime",
        "runtime: the wheel carries libKGENCompilerRTShared.so 2 times (komira/_lib/lib/libKGENCompilerRTShared.so, " +
        "komira/_lib/libKGENCompilerRTShared.so), and a process holds one Mojo runtime",
    ),
    # libkomira's run path does not reach the owners where this wheel puts them.
    (
        "wheel_libs_refuses_owners_off_run_path",
        ":komira_wheel_misplaced_owners",
        "needed: komira/_lib/libkomira.so needs libkomira_async_rt_native.so.1, which its run path `$ORIGIN/lib:$ORIGIN` " +
        "does not reach in the wheel (the wheel has it at komira/_lib/misplaced/libkomira_async_rt_native.so.1)",
    ),
    (
        "wheel_libs_refuses_missing_runtime_library",
        ":komira_wheel_without_runtime_library",
        "runtime: the wheel carries no libMSupportGlobals.so",
    ),
    (
        "wheel_libs_refuses_missing_libkomira",
        ":komira_wheel_without_libkomira",
        "entry: the wheel has no komira/_lib/libkomira.so",
    ),
]]

# ---- The macOS wheel, read back ----------------------------------------------
#
# What the macOS arm64 wheel holds, each held by a check that reads the
# finished wheel; built by pypi.yml's job build-macos-arm64 beside the
# wheel, never in a pull request (tools/build/ci/rules.bzl, EXCLUDED). The
# wheel rule itself already refuses, on every member: an ELF file (a Linux
# library), a Mach-O file for a CPU other than arm64 or a universal one, a
# minimum macOS above the tag's, an install name that is not @rpath/<file>, a
# run path that is not @loader_path-relative, a load that is neither a member,
# nor under /usr/lib or /System/Library, and a code signature that is missing
# or does not match the file's pages (wheel/policy.zig, wheel/codesign.zig).
#
# `:wheel_libs_macos_arm64`: from komira/_lib/libkomira.dylib, the library
# _native.load opens on macOS, every load command resolves to a member through
# the loading library's own run path, or to a macOS system library, and every
# Mach-O member is one libkomira loads; the three Mojo runtime dylibs are in
# the wheel once each with the bytes of the toolchain's runtime, with their
# licence texts (wheel/libs.zig).
#
# `:wheel_same_macos_arm64`: the macOS wheel and the Linux wheel of the same
# build are the same package: every Python file, METADATA and the licence
# files are in both with the same bytes and modes, WHEEL differs only in the
# platform part of its Tag (both `py3-none`, so the same Pythons), and the
# files only one of them has are its native libraries, listed here
# (wheel/compare.zig).

_RUNTIME_MACOS = [
    "libKGENCompilerRTShared.dylib",
    "libAsyncRTRuntimeGlobals.dylib",
    "libMSupportGlobals.dylib",
]

wheel_libs_check(
    name = "wheel_libs_macos_arm64",
    wheel = ":komira_wheel_macos_arm64",
    entry = "komira/_lib/libkomira.dylib",
    # The darwin toolchain's runtime directory itself: that toolchain executes
    # on macOS and this check on Linux, so it is not reached through it.
    runtime = "komira//tools/build/toolchains/darwin:mojo_runtime",
    runtime_dists = _LIBS_CHECK["runtime_dists"],
    runtime_libs = _RUNTIME_MACOS,
    runtime_licenses = _LIBS_CHECK["runtime_licenses"],
    target_compatible_with = DARWIN_ARM64,  # komira-limit:pypi-wheel-macos-arm64
)

# The Linux wheel of the same build, configured for linux-x86_64 whatever the
# platform of the target that reads it.
configured_alias(
    name = "komira_wheel_linux_x86_64",
    actual = ":komira_wheel",
    platform = "komira//tools/build/platforms:linux-x86_64",
)

wheel_same_check(
    name = "wheel_same_macos_arm64",
    wheel = ":komira_wheel_macos_arm64",
    like = ":komira_wheel_linux_x86_64",
    only_in_wheel = ["komira/_lib/libkomira.dylib"] + ["komira/_lib/lib/" + n for n in _RUNTIME_MACOS],
    only_in_like = ["komira/_lib/libkomira.so"] + ["komira/_lib/lib/" + n for n in _OWNERS + _RUNTIME],
    target_compatible_with = DARWIN_ARM64,  # komira-limit:pypi-wheel-macos-arm64
)

# ---- Upgrading from the previous release ----------------------------------
#
# `pip install --upgrade komira`: two releases of the wheel, the previous
# (build number 999999998) and the current (999999999), installed in that order
# into one empty environment after their requirement, pyarrow, the first
# uninstalled before the second as pip does (wheel_install_test `upgrade`),
# and python/tests/test_upgrade.py run there: the environment holds the
# current release's dist-info and no other komira one,
# every file only the previous release had is gone, and everything the
# clean-environment test holds of a fresh install holds. The previous release
# is the package's files plus two it dropped since: a module and a file in
# `_lib/lib/`, where a Mojo pin bump drops and renames libraries. The current
# release is the package's files as they are. Fixed build numbers, so the
# versions do not depend on the build's stamp.
#
# A Mojo runtime of another build is not part of an upgrade: the wheel carries
# the runtime libkomira was built with, both from one directory. A runtime of
# another build that is already in the process is refused by name:
# `beside_other_mojo_loaded_first`.

_PREVIOUS_ONLY = {
    "komira/_lib/lib/previous_release_only.txt": "komira//python/tests:fixtures/previous_release_only.txt",
    "komira/_previous_release_only.txt": "komira//python/tests:fixtures/previous_release_only.txt",
}

[wheel_file_at_stamp(
    name = "komira_wheel_" + release,
    files = _PY_FILES | _NATIVE_FILES | (_PREVIOUS_ONLY if release == "previous" else {}),
    executable = sorted(_NATIVE_FILES.keys()),
    stamp = stamp,
    **_WHEEL
) for release, stamp in [("previous", "999999998"), ("current", "999999999")]]

_UPGRADE_VERSION = wheel_version("999999999")

_UPGRADE_FILES = _TEST_FILES | {"--installed-script": "komira//python/tests:test_installed.py"}

_UPGRADE_ARGS = [
    "--version",
    _UPGRADE_VERSION,
    "--license-expression",
    _LICENSE_EXPRESSION,
    "--requires-dist",
    PYARROW_REQUIREMENT,
    "--requires-dist",
    PROTOBUF_REQUIREMENT,
] + _PYTHON_METADATA_ARGS + [a for p in sorted(_PREVIOUS_ONLY.keys()) for a in ["--expect-removed", p]]

# The releases in the order given.
_RELEASES = {
    order: [":komira_wheel_" + r for r in order.split(",")]
    for order in ["previous,current", "current,previous", "current"]
}

[wheel_install_test(
    name = "upgrade_test" + p["suffix"],
    python = p["python"],
    wheels = [_PYARROW_WHL[p["suffix"]], _PROTOBUF_WHL] + _RELEASES["previous,current"],
    script = "komira//python/tests:test_upgrade.py",
    args = _UPGRADE_ARGS,
    files = _UPGRADE_FILES,
    upgrade = True,
) for p in PYTHONS]

[wheel_install_test(
    name = name,
    python = "komira//third_party/python:cpython",
    wheels = _REQUIRED_313 + wheels,
    script = "komira//python/tests:test_upgrade.py",
    args = _UPGRADE_ARGS,
    files = _UPGRADE_FILES,
    upgrade = upgrade,
    expect_failure = expect,
) for name, wheels, upgrade, expect in [
    # The releases in the other order: the environment ends on the older one.
    (
        "refuses_downgrade",
        _RELEASES["current,previous"],
        True,
        "AssertionError: the site holds komira-0.1.999999998.dist-info, the upgrade should leave only komira-0.1.999999999.dist-info",
    ),
    # Nothing to upgrade from: the previous release's files are not there to be
    # removed, which the test names, so an upgrade that removes nothing is not
    # a pass.
    (
        "refuses_upgrade_from_nothing",
        _RELEASES["current"],
        True,
        "AssertionError: the upgrade did not remove komira/_lib/lib/previous_release_only.txt, " +
        "komira/_previous_release_only.txt: the previous release does not carry it",
    ),
    # A second release of an installed distribution is not an upgrade unless
    # the installer uninstalls the first: without it, the files of both would
    # be mixed.
    (
        "refuses_second_release_without_uninstall",
        _RELEASES["previous,current"],
        False,
        "install: komira is already installed, and a second wheel of it is installed only with --upgrade",
    ),
]]

# ---- Beside Modular's own runtime ------------------------------------------
#
# The wheel installed with Modular's mojo-compiler in the same environment,
# and Modular's runtime (<site>/modular/lib/libKGENCompilerRTShared.so, opened
# by path with ctypes, as a Mojo extension module's NEEDED entry opens it)
# loaded in the same process before or after komira's library
# (python/tests/test_beside_modular.py; docs/design/python_package.md,
# decision 6, says why each order does what it does):
#
# - the toolchain's version, Modular's first: libkomira binds to Modular's
#   runtime (the loader matches NEEDED names against what is loaded), which
#   the runtime check accepts (the same build ids), and komira's copy is not
#   mapped;
# - the toolchain's version, komira's first: Modular's libKGENCompilerRTShared.so
#   is a second copy, bound to komira's two other libraries; both work;
# - another version (`_OTHER_MOJO`), Modular's first: the runtime check
#   refuses it by name;
# - another version, komira's first: a newer Modular library fails to load,
#   with the loader's `undefined symbol` (its code needs symbols komira's
#   older libraries lack), and komira keeps working; an older one (inferred
#   from its `M::` symbols; first run at a 1.1.0 or 1.2.0 toolchain) loads as a
#   second copy bound to komira's two other libraries (komira's newer ones
#   define every `M::` symbol it needs), and komira keeps working.
#
# The toolchain's version picks both (third_party/modular/pins.bzl), so a
# toolchain pin moves these tests with it. The other version's
# mojo-compiler-mojo-libs is not installed (`skip_requirements`, pip's
# --no-deps): the compiler wheel's runtime is all the test loads.
_BESIDE_FILES = {"--parquet": "komira//src/so:tests/fixtures/two_columns.parquet"}

[wheel_install_test(
    name = name,
    python = "komira//third_party/python:cpython",
    wheels = [":komira_wheel"] + _REQUIRED_313 + modular,
    script = "komira//python/tests:test_beside_modular.py",
    args = [
        "--order",
        order,
        "--runtime",
        runtime,
        "--modular-version",
        version,
        "--toolchain-mojo-version",
        toolchain,
    ],
    files = _BESIDE_FILES,
    skip_requirements = modular == _MODULAR_OTHER,
    expect_failure = expect,
) for name, modular, order, runtime, version, toolchain, expect in [
    ("beside_modular_loaded_first", _MODULAR, "modular-first", "same", _TOOLCHAIN_MOJO, _TOOLCHAIN_MOJO, None),
    ("beside_modular_loaded_after", _MODULAR, "komira-first", "same", _TOOLCHAIN_MOJO, _TOOLCHAIN_MOJO, None),
    (
        "beside_other_mojo_loaded_first",
        _MODULAR_OTHER,
        "modular-first",
        _OTHER_RUNTIME,
        _OTHER_MOJO,
        _TOOLCHAIN_MOJO,
        "komira._errors.LibraryLoadError: the Mojo runtime library libKGENCompilerRTShared.so is already loaded " +
        "from <site>/modular/lib, and it is another build than komira's " +
        "(<site>/komira/_lib/lib/libKGENCompilerRTShared.so): a process holds one Mojo runtime, so komira " +
        "cannot be loaded beside Mojo code built with another Mojo version",
    ),
    ("beside_other_mojo_loaded_after", _MODULAR_OTHER, "komira-first", _OTHER_RUNTIME, _OTHER_MOJO, _TOOLCHAIN_MOJO, None),
    # The same-version cases hold the installed mojo-compiler to the
    # toolchain's Mojo: a pins.bzl row whose wheels are another version's
    # fails there, as this case does.
    (
        "refuses_modular_unlike_toolchain",
        _MODULAR,
        "modular-first",
        "same",
        _TOOLCHAIN_MOJO,
        "0.0.1",
        "AssertionError: the same-version cases need Modular's runtime at the toolchain's Mojo: " +
        "mojo-compiler {} is installed, the toolchain's is 0.0.1".format(_TOOLCHAIN_MOJO),
    ),
    # The other-version cases hold the installed mojo-compiler to another
    # Mojo than the toolchain's: the toolchain's own wheel given as the other
    # version is refused.
    (
        "refuses_other_mojo_at_toolchain",
        _MODULAR,
        "komira-first",
        _OTHER_RUNTIME,
        _TOOLCHAIN_MOJO,
        _TOOLCHAIN_MOJO,
        "AssertionError: the other-version cases need Modular's runtime at another Mojo than the toolchain's: " +
        "mojo-compiler {v} is installed, the toolchain's is {v}".format(v = _TOOLCHAIN_MOJO),
    ),
]]

