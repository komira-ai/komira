load("@komira//python:dependencies.bzl", "DUCKDB_WHEEL", "PROTOBUF_MACOS", "PROTOBUF_REQUIREMENT", "PROTOBUF_WHEEL", "PYARROW_MACOS", "PYARROW_REQUIREMENT", "PYARROW_WHEELS")
load("@komira//python:install_test.bzl", "picked_files", "python_versions", "wheel_install_test")
load("@komira//python:pythons.bzl", "CLASSIFIERS", "HOSTED", "PYTHONS", "REQUIRES_PYTHON")
load("@komira//third_party/modular:pins.bzl", "OTHER_MOJO", "TOOLCHAIN_MOJO", "is_newer", "modular_wheel")
load("@komira//tools/build/package:wheel.bzl", "wheel_file", "wheel_file_at_stamp", "wheel_libs_check", "wheel_same_check", "wheel_version")
load("@komira//tools/build/platforms:defs.bzl", "DARWIN_ARM64", "LINUX_X86_64")
load("@komira//tools/build/python:defs.bzl", "python_proto", "python_source_package")

# The import package `komira` (README.md): its files at their paths, as the site
# directory the package's tests import it from (tests/BUCK). The wheel rule
# will read the same files.
python_source_package(
    name = "komira",
    srcs = glob(["komira/**/*.py"]) + ["komira/py.typed"],
    visibility = ["//python/tests:"],
)

# The Python modules of the plan wire, `komira.plan.v1.plan_pb2` (the messages
# of src/plan_proto/plan.proto, `WirePlanEnvelope` among them) and
# `komira.plan.v1.plan_vocabulary_pb2` (its enums), generated by the pinned
# protoc (29.1, gencode 5.29.1) at the paths their proto package gives them:
# plan_pb2 imports `from komira.plan.v1 import plan_vocabulary_pb2`. Each is the
# sub-target `[<stem>_pb2]`. The protobuf runtime they load under is
# `PROTOBUF_REQUIREMENT` (dependencies.bzl); python/tests holds both to the
# plan wire's goldens under each edge of that range.
python_proto(
    name = "plan_pb2",
    srcs = [
        "//src/plan_proto:plan.proto",
        "//src/plan_proto:plan_vocabulary.proto",
    ],
    import_prefix = "komira/plan/v1",
    visibility = ["komira//python/tests:"],
)

# The import package with the plan modules beside it at `komira/plan/v1/`,
# where the plan encoder (komira/_plan) imports them from: the site directory
# of the tests that encode or run a plan (tests/BUCK), and the package the
# wheel ships. `:komira` stays without them, for the tests that never make a
# frame: `import komira` does not import them.
python_source_package(
    name = "komira_with_plan_modules",
    srcs = glob(["komira/**/*.py"]) + [
        "komira/py.typed",
        ":plan_pb2[plan_pb2]",
        ":plan_pb2[plan_vocabulary_pb2]",
    ],
    visibility = ["komira//python/tests:"],
)

# ---- The supported Pythons ---------------------------------------------------
#
# The exact versions the hosted-runner jobs of the workflows install with
# `actions/setup-python`, one job per version: `[linux-x86_64]` and
# `[macos-arm64]`, each a JSON list, oldest first, from pythons.bzl (HOSTED),
# the one list of the supported minors. A workflow builds the sub-target and
# hands its text to a job matrix (`fromJSON`).
python_versions(
    name = "supported_pythons",
    versions = HOSTED,
    # its test reads it (smoke/BUCK, supported_pythons_lists)
    visibility = ["komira//python/smoke:"],
)

# ---- The wheel ---------------------------------------------------------------
#
# `pip install komira`: the import package, and `//src/so:libkomira[dist]` as it
# is at komira/_lib/: libkomira.so (where _native.load opens it with no
# directory given), and in komira/_lib/lib/ (its run path, `$ORIGIN/lib`) its
# native owner libraries and the three Mojo runtime libraries of the pinned
# compiler that built it, with the licence texts of their package
# (third_party/modular/BUCK; NOTICE says which files each covers). The wheel
# requires no distribution of Modular's. Written by `wheel_file`
# (tools/build/package/README.md, "The Python wheel"), which refuses a library
# that needs a newer glibc than the tag's, a GLIBCXX_ or CXXABI_ version above
# the bounds below, a run path not under `$ORIGIN`, or a NEEDED library that is
# neither in the wheel nor a manylinux system library (the C++ runtime,
# libstdc++ and libgcc_s, is one: the host provides it). The description is
# README.md. Its requirements are pyarrow (`PYARROW_REQUIREMENT`,
# dependencies.bzl), which a `Result` reads as, and protobuf
# (`PROTOBUF_REQUIREMENT`), which loads the generated plan modules a DataFrame
# encodes its plan with; the wheel ships those at komira/plan/v1/. Unstamped the version is 0.0.0; the release set's stamp gives
# 0.1.<N>.
#
# The macOS arm64 wheel (`:komira_wheel_macos_arm64`, darwin-arm64,
# py3-none-macosx_11_0_arm64) is the same package: its `[dist]` is
# libkomira.dylib and lib/ with the three runtime .dylib, and it holds no
# native owner library (they are linked into libkomira.dylib). It is built and
# tested only by the macOS jobs of pypi.yml, on the farm's macOS workers, never in a
# pull request (tools/build/ci/rules.bzl, EXCLUDED); its targets name
# `--target-platforms komira//tools/build/platforms:darwin-arm64`. On macOS the
# wheel rule refuses a Mach-O member that needs a newer macOS than the tag's,
# and one whose code signature is missing or does not match it; "The macOS
# wheel, read back" below holds the finished file. `:komira_wheel`, the wheels
# derived from it, and the tests that install or read them are linux-x86_64
# only (limit manylinux-wheel-linux-x86-64): a darwin-arm64 build skips them.

_PLATFORM = "linux-x86_64"

# What the Mojo runtime libraries need, per platform, above what komira's own
# files need (the platform row's `os_floor` is the floor of what the
# repository links): libAsyncRTRuntimeGlobals.so needs GLIBC_2.35,
# libKGENCompilerRTShared.so GLIBCXX_3.4.30 and CXXABI_1.3.11 (src/so/README.md,
# the table of libkomira_elf_report), within what manylinux_2_35 lets a wheel
# need from the host. A platform that joins names its own row here; the wheel
# rule refuses a wheel whose files need more.
_NATIVE_NEEDS = {
    "linux-x86_64": {
        "max_cxxabi": "1.3.11",
        "max_glibcxx": "3.4.30",
        "os_floor": "glibc-2.35",
    },
    # No bounds of its own: the tag is the row's macOS floor, 11.0, and the
    # wheel rule refuses a Mach-O member that needs a newer macOS.
    "darwin-arm64": {},
}

_PY_FILES = {f: f for f in glob(["komira/**/*.py"]) + ["komira/py.typed"]} | {
    "komira/plan/v1/plan_pb2.py": ":plan_pb2[plan_pb2]",
    "komira/plan/v1/plan_vocabulary_pb2.py": ":plan_pb2[plan_vocabulary_pb2]",
}

# libkomira, its native owners and the Mojo runtime, as the wheel lays them out.
_DIST = "komira//src/so:libkomira[dist]"

_NATIVE_FILES = {"komira/_lib": _DIST}

# The Mojo runtime libraries, as libkomira's NEEDED entries and their own name
# them: libkomira needs the first, which needs the other two (the order of
# komira/_runtime.py's RUNTIME_LIBRARIES).
_RUNTIME = [
    "libKGENCompilerRTShared.so",
    "libAsyncRTRuntimeGlobals.so",
    "libMSupportGlobals.so",
]

# The native owners of //src/so:libkomira (src/so/BUCK, NATIVE_OWNERS; their
# file names are the table of src/so/README.md).
_OWNERS = [
    "libkomira_async_api_native.so.1",
    "libkomira_async_rt_native.so.1",
    "libkomira_compression_native.so.1",
    "libkomira_crypto_native.so.1",
    "libkomira_fs_native.so.1",
    "libkomira_http_core_native.so.1",
    "libkomira_libc_native.so.1",
    "libkomira_metrics_native.so.1",
    "libkomira_objectstore_native.so.1",
    "libkomira_parquet_codec_native.so.1",
    "libkomira_scan_source_native.so.1",
]

# The files of `[dist]` one by one, by file name: the files the refusing cases
# below put somewhere else or leave out. A path the directory does not hold
# fails the action that reads it.
picked_files(
    name = "dist_files",
    dir = _DIST,
    paths = ["libkomira.so"] + ["lib/" + n for n in _OWNERS + _RUNTIME],
    # The Linux [dist]'s ELF file names: the macOS [dist] holds .dylib files.
    target_compatible_with = LINUX_X86_64,  # komira-limit:libkomira-elf-linux-x86-64
)

# komira's licence, and the licence texts of the pinned Mojo compiler package
# the runtime libraries come from, unmodified (third_party/modular/BUCK).
_MODULAR_LICENSE_FILES = {
    "MODULAR_LICENSE": "komira//third_party/modular:mojo_compiler_licenses[info/licenses/LICENSE]",
    "MODULAR_THIRD_PARTY_NOTICES": "komira//third_party/modular:mojo_compiler_licenses[info/licenses/Third-Party-Notices]",
}

# The licence texts of the third-party code compiled into the native owner
# libraries libkomira links (NOTICE, "Third-party code inside the native
# files"), extracted unmodified from the pinned source archives.
_THIRD_PARTY_LICENSE_FILES = {
    "AWS_LC_LICENSE": "komira//third_party/aws-lc:src[LICENSE]",
    "S2N_TLS_LICENSE": "komira//third_party/s2n-tls:src[LICENSE]",
}

_LICENSE_FILES = {
    "LICENSE": "komira//:LICENSE",
    "NOTICE": "komira//:NOTICE",
} | _THIRD_PARTY_LICENSE_FILES | _MODULAR_LICENSE_FILES

# komira's own files are Apache-2.0; the Mojo runtime libraries are Modular's,
# under the licence their package declares (`LicenseRef-Modular-Proprietary`,
# the Modular Community License Terms in MODULAR_LICENSE).
_LICENSE_EXPRESSION = "Apache-2.0 AND LicenseRef-Modular-Proprietary"

# Every field of the wheel on every platform; each platform adds its row of
# _NATIVE_NEEDS.
_SHARED_METADATA = {
    "classifiers": ["Development Status :: 2 - Pre-Alpha"] + CLASSIFIERS,
    "distribution": "komira",
    "license_expression": _LICENSE_EXPRESSION,
    "license_files": _LICENSE_FILES,
    "project_urls": {
        "Changelog": "https://github.com/komira-ai/komira/blob/main/python/CHANGELOG.md",
        "Documentation": "https://github.com/komira-ai/komira/blob/main/docs/install.md",
        "Issues": "https://github.com/komira-ai/komira/issues",
        "Source": "https://github.com/komira-ai/komira",
    },
    "readme": "README.md",
    "requires_dist": [PYARROW_REQUIREMENT, PROTOBUF_REQUIREMENT],
    "requires_python": REQUIRES_PYTHON,
    "summary": "SQL over local files, with the komira query engine in process",
}

# The metadata of each platform's wheel: the shared fields, its platform row
# and its native needs.
_METADATA = {p: _SHARED_METADATA | {"platform": p} | needs for p, needs in _NATIVE_NEEDS.items()}

# The manylinux wheel holds ELF libraries and the wheel rule refuses a Mach-O
# member in one, so every wheel built from `_WHEEL` is linux x86_64 only: a
# darwin-arm64 build skips it, and the tests that install or read it (the rule
# and the macros below mark those too). The macOS wheel is
# `:komira_wheel_macos_arm64`.
_WHEEL = _METADATA[_PLATFORM] | {
    "target_compatible_with": LINUX_X86_64,  # komira-limit:manylinux-wheel-linux-x86-64
}

wheel_file(
    name = "komira_wheel",
    files = _PY_FILES | _NATIVE_FILES,
    executable = sorted(_NATIVE_FILES.keys()),
    **_WHEEL
)

# The macOS arm64 wheel: the same files and metadata as `:komira_wheel` apart
# from the tag. Its `[dist]` is configured for darwin-arm64.
wheel_file(
    name = "komira_wheel_macos_arm64",
    files = _PY_FILES | _NATIVE_FILES,
    executable = sorted(_NATIVE_FILES.keys()),
    target_compatible_with = DARWIN_ARM64,  # komira-limit:pypi-wheel-macos-arm64
    **_METADATA["darwin-arm64"]
)

# ---- The clean-environment install tests -------------------------------------
#
# The wheel installed into an empty virtual environment of the hermetic
# interpreter, with no pip, no index, no network and no library path, and
# python/tests/test_installed.py run there in isolated mode from an empty
# directory (python/install_test.bzl), with the pinned pyarrow wheel of the
# interpreter's minor beside it (tests/BUCK), which the installer holds to the
# wheel's Requires-Dist: the environment holds komira and its requirement and
# nothing else, no `modular/` directory and no distribution of Modular's; the
# package imports from the prefix at the wheel's version, with its licences
# and the runtime's licence texts and the Requires-Dist `--requires-dist`;
# libkomira loads at the ABI version of src/so/abi/komira.tsv, a Parquet file
# registers and a missing one raises KomiraError, `SELECT 1 AS n` and an
# aggregate over tests/fixtures/readings.parquet answer their rows as pyarrow,
# the quickstart (examples/quickstart.py) runs from the installed package in a
# new empty directory and prints what examples/quickstart.expected holds, and
# leaves weather.parquet there and nothing else, the METADATA description is
# README.md byte for byte (the wheel rule writes the README as the body of
# METADATA), a serialized plan renders, and libkomira, its native
# owners and the three Mojo runtime libraries are mapped from
# <site>/komira/_lib and nothing else of theirs is. One test per supported
# minor (pythons.bzl), on its pinned interpreter: `:wheel_install_test` on
# CPython 3.13, `:wheel_install_test_py311`, `_py312` and `_py314` on the
# others; 3.11 is the lower edge of Requires-Python, and 3.10, below it, is
# refused (`refuses_python_outside_requires_python`). pypi.yml's build
# runs the 3.13 test, `:wheel_install_test`. On macOS there are no native
# owners to map.

_TEST_FILES = {
    "--abi-table": "komira//src/so:abi/komira.tsv",
    "--aws-lc-license": _THIRD_PARTY_LICENSE_FILES["AWS_LC_LICENSE"],
    "--license": "komira//:LICENSE",
    "--modular-license": _MODULAR_LICENSE_FILES["MODULAR_LICENSE"],
    "--modular-notices": _MODULAR_LICENSE_FILES["MODULAR_THIRD_PARTY_NOTICES"],
    "--notice": "komira//:NOTICE",
    "--parquet": "komira//src/so:tests/fixtures/two_columns.parquet",
    "--plan-hex": "komira//python/tests:fixtures/scan_plan.hex",
    "--quickstart": ":examples/quickstart.py",
    "--quickstart-expected": ":examples/quickstart.expected",
    "--readings": "komira//python/tests:fixtures/readings.parquet",
    "--readme": ":README.md",
    "--s2n-tls-license": _THIRD_PARTY_LICENSE_FILES["S2N_TLS_LICENSE"],
}

# The version the wheel is stamped with: the stamp wheel_file reads.
_VERSION = wheel_version(read_config("komira", "package_stamp", "0"))

# The Mojo of the toolchain: the version of its conda pin
# (`mojo_compiler_<version>_<subdir>.conda`; third_party/modular/pins.bzl).
_TOOLCHAIN_MOJO = TOOLCHAIN_MOJO

# What the wheel's metadata says of the Pythons it installs on, written out
# here rather than read from pythons.bzl: test_installed.py holds the installed
# metadata to exactly these lines, so a change to the supported list changes
# this too.
_PYTHON_METADATA = {
    "classifiers": [
        "Development Status :: 2 - Pre-Alpha",
        "Programming Language :: Python :: 3 :: Only",
        "Programming Language :: Python :: 3.11",
        "Programming Language :: Python :: 3.12",
        "Programming Language :: Python :: 3.13",
        "Programming Language :: Python :: 3.14",
    ],
    "requires_python": ">=3.11",
}

_PYTHON_METADATA_ARGS = ["--requires-python", _PYTHON_METADATA["requires_python"]] + [
    a
    for c in _PYTHON_METADATA["classifiers"]
    for a in ["--classifier", c]
]

# The pinned pyarrow wheel file of each minor (tests/BUCK), installed beside
# komira's wheel: `pip install komira` installs it with komira.
_PYARROW_WHL = {suffix: "komira//python/tests:" + w["file"] for suffix, w in PYARROW_WHEELS.items()}

_PYARROW_WHL_MACOS = "komira//python/tests:" + PYARROW_MACOS["file"]

# The pinned protobuf wheel (tests/BUCK), installed beside komira's wheel and
# its pyarrow: `pip install komira` installs it with komira. One `abi3` file
# serves every minor.
_PROTOBUF_WHL = "komira//python/tests:" + PROTOBUF_WHEEL["file"]

_PROTOBUF_WHL_MACOS = "komira//python/tests:" + PROTOBUF_MACOS["file"]

_INSTALLED_ARGS = [
    "--version",
    _VERSION,
    "--license-expression",
    _LICENSE_EXPRESSION,
    "--requires-dist",
    PYARROW_REQUIREMENT,
    "--requires-dist",
    PROTOBUF_REQUIREMENT,
] + _PYTHON_METADATA_ARGS

# Modular's wheels of the Mojo compiler (third_party/modular/pins.bzl): the
# toolchain's version, with the wheel it requires, and the compiler wheel of
# the newest other version of the table.
_MODULAR = [modular_wheel(_TOOLCHAIN_MOJO, "compiler"), modular_wheel(_TOOLCHAIN_MOJO, "libs")]

_OTHER_MOJO = OTHER_MOJO

_MODULAR_OTHER = [modular_wheel(_OTHER_MOJO, "compiler")]

# How the other version's runtime relates to the toolchain's: `newer` or
# `older` (test_beside_modular.py says what each order does with each).
_OTHER_RUNTIME = "newer" if is_newer(_OTHER_MOJO, _TOOLCHAIN_MOJO) else "older"

[wheel_install_test(
    name = "wheel_install_test" + p["suffix"],
    python = p["python"],
    wheels = [":komira_wheel", _PYARROW_WHL[p["suffix"]], _PROTOBUF_WHL],
    script = "komira//python/tests:test_installed.py",
    args = _INSTALLED_ARGS,
    files = _TEST_FILES,
) for p in PYTHONS]

# TPC-H q1 .. q22 at scale factor 1 through the installed wheel, against
# DuckDB's answers (python/tests/test_tpch_installed.py): the wheel and its
# pyarrow in an empty prefix as above, the staged data, the recorded answers and
# the query texts of `//src/tpch_answers:tpch_sf1`, and the answer check of
# python/tests/tpch_compare.py. Each query is accepted and answered, its
# signature equals DuckDB's (exact for integers, decimals and texts, within 1e-9
# for doubles, the declared type of each column the same) and its rows are in
# the order of its ORDER BY; the per-query table is the test's output and a
# failing query is named with its refusal token. On CPython 3.13 only. A validation run, built on request and not in the pull request's check
# set (tools/build/ci/rules.bzl, EXCLUDED); the answer check it uses is held
# in the pull request by `//python/tests:tpch_compare_test`.
# Derived from TPC-H; not comparable to published TPC-H results.
wheel_install_test(
    name = "tpch_via_wheel_test",
    python = "komira//third_party/python:cpython",
    wheels = [":komira_wheel", _PYARROW_WHL[""], _PROTOBUF_WHL],
    script = "komira//python/tests:test_tpch_installed.py",
    files = {
        "--answers": "komira//src/tpch_answers:tpch_sf1[answers.txt]",
        "--compare": "komira//python/tests:tpch_compare.py",
        "--data": "komira//src/tpch_answers:tpch_sf1[data]",
        "--queries": "komira//src/tpch_answers:tpch_sf1[queries]",
    },
)

# The same test on the macOS wheel, on the farm's macOS workers: run from
# pypi.yml's job build-macos-arm64 only, never in a pull request
# (tools/build/ci/rules.bzl, EXCLUDED). CPython 3.13 is the one macOS
# interpreter pinned (third_party/python, cpython_macos).
wheel_install_test(
    name = "wheel_install_test_macos_arm64",
    python = "komira//third_party/python:cpython_macos",
    wheels = [":komira_wheel_macos_arm64", _PYARROW_WHL_MACOS, _PROTOBUF_WHL_MACOS],
    script = "komira//python/tests:test_installed.py",
    args = _INSTALLED_ARGS,
    files = _TEST_FILES,
    exec_compatible_with = DARWIN_ARM64,
    target_compatible_with = DARWIN_ARM64,  # komira-limit:pypi-wheel-macos-arm64
)

# The analysis job (examples/analysis_job.py) run from the installed wheel on
# CPython 3.13, the one minor with a pinned DuckDB: it reads a Parquet file and
# a CSV file, joins, groups, ranks with window functions, takes the top
# customers and writes Parquet, and each answer, with the file it wrote, is
# held to DuckDB's for the same SQL over the same files. The same query with the
# join on the wrong key must differ from DuckDB's answer
# (tests/test_analysis_job.py).
wheel_install_test(
    name = "analysis_job_test",
    python = "komira//third_party/python:cpython",
    wheels = [":komira_wheel", _PYARROW_WHL[""], _PROTOBUF_WHL, "komira//python/tests:" + DUCKDB_WHEEL["file"]],
    script = "komira//python/tests:test_analysis_job.py",
    files = {"--example": "examples/analysis_job.py"},
)

# The same test on installs that must fail, each with the line it fails with
# (on CPython 3.13, beside its pyarrow unless the case says otherwise; `refuses_python_outside_requires_python`, after them, on
# CPython 3.10). The first wheels below are the wheel with one thing wrong
# that the wheel rule does not refuse: its native files are picked one by one
# out of the same `[dist]` directory.

_LIBKOMIRA = {"komira/_lib/libkomira.so": ":dist_files[libkomira.so]"}

wheel_file(
    name = "komira_wheel_without_libkomira",
    files = _PY_FILES,
    **_WHEEL
)

# The owner libraries beside libkomira's run path instead of on it: every
# NEEDED name is a member of the wheel, so the rule writes it, and the loader
# finds none of the owners.
_MISPLACED = _LIBKOMIRA | {"komira/_lib/lib/" + n: ":dist_files[" + n + "]" for n in _RUNTIME} | {
    "komira/_lib/misplaced/" + n: ":dist_files[" + n + "]"
    for n in _OWNERS
}

wheel_file(
    name = "komira_wheel_misplaced_owners",
    files = _PY_FILES | _MISPLACED,
    executable = sorted(_MISPLACED.keys()),
    **_WHEEL
)

# A damaged install: one of the three Mojo runtime libraries left out. The
# rule writes it only because `external_needed` says another package provides
# the file; nothing does, and the loader's error names it.
_WITHOUT_MSUPPORT = _LIBKOMIRA | {
    "komira/_lib/lib/" + n: ":dist_files[" + n + "]"
    for n in _OWNERS + _RUNTIME
    if n != "libMSupportGlobals.so"
}

wheel_file(
    name = "komira_wheel_without_runtime_library",
    files = _PY_FILES | _WITHOUT_MSUPPORT,
    executable = sorted(_WITHOUT_MSUPPORT.keys()),
    **(_WHEEL | {"external_needed": ["libMSupportGlobals.so"]})
)

# The wheel with metadata that does not say what the supported list says: one
# that leaves out a supported minor's classifier, and one whose Requires-Python
# starts a minor later. Each installs, and the test refuses it.
wheel_file(
    name = "komira_wheel_without_py311_classifier",
    files = _PY_FILES | _NATIVE_FILES,
    executable = sorted(_NATIVE_FILES.keys()),
    **(_WHEEL | {"classifiers": [c for c in _WHEEL["classifiers"] if c != "Programming Language :: Python :: 3.11"]})
)

wheel_file(
    name = "komira_wheel_requires_python_312",
    files = _PY_FILES | _NATIVE_FILES,
    executable = sorted(_NATIVE_FILES.keys()),
    **(_WHEEL | {"requires_python": ">=3.12"})
)

# The wheel with another pyarrow range than PYARROW_REQUIREMENT: it installs
# beside pyarrow 25.0.1, and the test refuses its metadata.
wheel_file(
    name = "komira_wheel_other_pyarrow_range",
    files = _PY_FILES | _NATIVE_FILES,
    executable = sorted(_NATIVE_FILES.keys()),
    **(_WHEEL | {"requires_dist": ["pyarrow>=24", PROTOBUF_REQUIREMENT]})
)

wheel_file(
    name = "komira_wheel_arm64_tag",
    files = _PY_FILES,
    **(_WHEEL | {"platform": "linux-arm64"})
)


# The classifiers, and those without 3.11, as Python's repr writes a list of
# strings (`['a', 'b']`): the two sides of the refusal below.
_CLASSIFIERS_REPR = "[" + ", ".join(["'" + c + "'" for c in _PYTHON_METADATA["classifiers"]]) + "]"

_CLASSIFIERS_WITHOUT_311_REPR = "[" + ", ".join([
    "'" + c + "'"
    for c in _PYTHON_METADATA["classifiers"]
    if c != "Programming Language :: Python :: 3.11"
]) + "]"

_LOAD_ERROR = "komira._errors.LibraryLoadError: cannot load libkomira from <site>/komira/_lib/libkomira.so: "

# The pyarrow wheel of CPython 3.13, which these cases run on, and the
# protobuf wheel beside it.
_PYARROW_313 = _PYARROW_WHL[""]

_REQUIRED_313 = [_PYARROW_313, _PROTOBUF_WHL]

[wheel_install_test(
    name = name,
    python = "komira//third_party/python:cpython",
    wheels = wheels,
    script = "komira//python/tests:test_installed.py",
    args = _INSTALLED_ARGS,
    files = _TEST_FILES,
    expect_failure = expect,
) for name, wheels, expect in [
    # The wheel without libkomira.so.
    (
        "refuses_missing_libkomira",
        [":komira_wheel_without_libkomira"] + _REQUIRED_313,
        _LOAD_ERROR + "<site>/komira/_lib/libkomira.so: cannot open shared object file: No such file or directory",
    ),
    # A wheel whose owner libraries libkomira's run path does not reach: the
    # first NEEDED one after the Mojo runtime (found in lib/) is the loader's
    # error.
    (
        "refuses_owners_off_run_path",
        [":komira_wheel_misplaced_owners"] + _REQUIRED_313,
        _LOAD_ERROR + "libkomira_async_rt_native.so.1: cannot open shared object file: No such file or directory",
    ),
    # A wheel without libMSupportGlobals.so: libKGENCompilerRTShared.so, found
    # in lib/, needs it. The error says the package is incomplete, names the
    # missing file in lib/, and ends with the loader's own text.
    (
        "refuses_missing_runtime_library",
        [":komira_wheel_without_runtime_library"] + _REQUIRED_313,
        _LOAD_ERROR + "the package is incomplete (reinstall komira), this file is missing: " +
        "<site>/komira/_lib/lib/libMSupportGlobals.so; the loader says: " +
        "libMSupportGlobals.so: cannot open shared object file: No such file or directory",
    ),
    # A wheel tagged for another platform is not installed.
    (
        "refuses_wheel_of_another_platform",
        [":komira_wheel_arm64_tag"],
        "install: the wheel of komira is tagged py3-none-manylinux_2_35_aarch64, which this interpreter (CPython 3.13 on x86_64) does not install",
    ),
    # Another distribution beside the wheel is refused by the test: the
    # environment of `pip install komira` holds komira, its requirement and
    # nothing else.
    (
        "refuses_other_distribution",
        [":komira_wheel"] + _REQUIRED_313 + _MODULAR,
        "AssertionError: the environment holds komira and also mojo-compiler, mojo-compiler-mojo-libs",
    ),
    # The wheel without pyarrow, and the wheel beside pyarrow without
    # protobuf: the installer refuses the unmet requirement, as pip would
    # install it.
    (
        "refuses_missing_requirement",
        [":komira_wheel"],
        "install: komira {} requires {}, which is not installed".format(_VERSION, PYARROW_REQUIREMENT),
    ),
    (
        "refuses_missing_protobuf",
        [":komira_wheel", _PYARROW_313],
        "install: komira {} requires {}, which is not installed".format(_VERSION, PROTOBUF_REQUIREMENT),
    ),
    # A pyarrow wheel of another CPython minor (cp312 on 3.13) is not
    # installed: a cp ABI tag names the one minor it runs on.
    (
        "refuses_requirement_of_another_minor",
        [":komira_wheel", _PYARROW_WHL["_py312"]],
        "install: the wheel of pyarrow is tagged cp312-cp312-manylinux_2_28_x86_64, which this interpreter (CPython 3.13 on x86_64) does not install",
    ),
    # The installed Requires-Dist, held to PYARROW_REQUIREMENT.
    (
        "refuses_requires_dist_not_the_declared_range",
        [":komira_wheel_other_pyarrow_range"] + _REQUIRED_313,
        "AssertionError: the wheel's Requires-Dist is ['pyarrow>=24', '{p}'], not ['{a}', '{p}']".format(a = PYARROW_REQUIREMENT, p = PROTOBUF_REQUIREMENT),
    ),
    # The metadata of the Pythons, held to the supported list: a classifier
    # left out, and a Requires-Python that starts a minor later.
    (
        "refuses_classifiers_not_the_supported_pythons",
        [":komira_wheel_without_py311_classifier"] + _REQUIRED_313,
        "AssertionError: the wheel's Classifier lines are {}, not {}".format(_CLASSIFIERS_WITHOUT_311_REPR, _CLASSIFIERS_REPR),
    ),
    (
        "refuses_requires_python_not_the_oldest_supported",
        [":komira_wheel_requires_python_312"] + _REQUIRED_313,
        "AssertionError: the wheel's Requires-Python is >=3.12, not >=3.11",
    ),
    # mojo-compiler without the wheel it requires: the installer's own check.
    (
        "refuses_unmet_requirement",
        [":komira_wheel"] + _REQUIRED_313 + [_MODULAR[0]],
        "install: mojo-compiler {v} requires mojo-compiler-mojo-libs=={v}, which is not installed".format(v = _TOOLCHAIN_MOJO),
    ),
]]

