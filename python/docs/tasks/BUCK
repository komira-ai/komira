load("@komira//python:dependencies.bzl", "PROTOBUF_MACOS", "PROTOBUF_WHEEL", "PYARROW_MACOS", "PYARROW_WHEELS")
load("@komira//python:install_test.bzl", "wheel_install_test")
load("@komira//python:task_examples.bzl", "task_dirs", "task_examples", "task_pages_check", "task_probes")
load("@komira//tools/build/platforms:defs.bzl", "DARWIN_ARM64")

# The Python examples of the common tasks (docs/tasks/README.md): one
# directory per task, `<rank>-<slug>/`, after an entry of
# docs/tasks/catalogue.json, each holding example.py, expected_output.txt
# and page.md.

# Every file of every task directory, at its path below this package: the
# directory the checks below read.
_FILES = glob(["*/**"])

_TASKS = task_dirs(_FILES)

# The probes, `<task>/probe_<name>.py`: programs that show what komira cannot
# do yet, each failing with the line of its `probe_<name>.error.txt`.
_PROBES = task_probes(_FILES)

filegroup(
    name = "tree",
    srcs = _FILES,
)

# The catalogue against the directories (python/task_examples.bzl): each
# directory is a task that is not a gap, holds exactly its three files, and
# its page shows example.py and expected_output.txt byte for byte; every gap
# names its issues. `:pages[check]` is the same commands' freshness check of
# the pages that a package README has, `:pages[fill]` the patch that mends a
# stale page (git apply it from the repository root).
task_pages_check(
    name = "pages",
    catalogue = "komira//docs/tasks:catalogue.json",
    catalogue_display = "docs/tasks/catalogue.json",
    srcs = _FILES,
    tree = ":tree",
    display = "python/docs/tasks",
)

_WHEELS = [
    "komira//python:komira_wheel",
    "komira//python/tests:" + PYARROW_WHEELS[""]["file"],
    "komira//python/tests:" + PROTOBUF_WHEEL["file"],
]

_DRIVER = "komira//python/tests:run_task_example.py"

# Each task's example, one target per directory, named as the directory:
# the wheel installed into an empty environment of the hermetic CPython 3.13
# with its pyarrow and protobuf and nothing else, no network, and example.py
# run there from a new empty directory, what it prints held to
# expected_output.txt byte for byte (python/tests/run_task_example.py). And
# each probe, `<task>__probe_<name>`: it must raise exactly its recorded line.
# A probe that runs to the end is red: the feature exists, and the page, its
# catalogue status and the probe change with it.
#
# `:examples` is the aggregate of all of them (python/task_examples.bzl): the
# one root of the check set (its file, ci/roots/komira/python/docs/tasks:examples) for them, so a
# task directory added or removed changes no file outside its own. Building
# it, on linux-x86_64 in the pull request's check, builds every example and
# probe, and one that fails is named by its own label.
task_examples(
    name = "examples",
    files = _FILES,
    tree = ":tree",
    python = "komira//third_party/python:cpython",
    wheels = _WHEELS,
    script = _DRIVER,
)

# The same run on rank 1's example held to an expected output that differs in
# its second line: it must fail, naming the task and that line.
filegroup(
    name = "tree_wrong_expected_output",
    srcs = {
        "1-read-csv-file/example.py": "1-read-csv-file/example.py",
        "1-read-csv-file/expected_output.txt": "komira//python/tests:fixtures/task_wrong_expected_output.txt",
    },
)

wheel_install_test(
    name = "refuses_wrong_expected_output",
    python = "komira//third_party/python:cpython",
    wheels = _WHEELS,
    script = _DRIVER,
    args = ["--task", "1-read-csv-file"],
    files = {"--tasks-dir": ":tree_wrong_expected_output"},
    expect_failure = "AssertionError: python/docs/tasks/1-read-csv-file/expected_output.txt:2: expected " +
                     "\"{'id': 2, 'name': 'Bo', 'city': 'Lima', 'score': 7.5}\", printed \"{'id': 2, 'name': 'Bo', 'city': 'Lima', 'score': 7.0}\"",
)

# An example that raises: the run must fail naming the task and the error.
filegroup(
    name = "tree_example_raises",
    srcs = {
        "1-read-csv-file/example.py": "komira//python/tests:fixtures/task_example_raises.py",
        "1-read-csv-file/expected_output.txt": "1-read-csv-file/expected_output.txt",
    },
)

wheel_install_test(
    name = "refuses_example_that_raises",
    python = "komira//third_party/python:cpython",
    wheels = _WHEELS,
    script = _DRIVER,
    args = ["--task", "1-read-csv-file"],
    files = {"--tasks-dir": ":tree_example_raises"},
    expect_failure = "AssertionError: python/docs/tasks/1-read-csv-file/example.py:4: raised ValueError: the input has no column amount",
)

# A probe that runs to the end, and a probe that raises another line than its
# recorded one: each run must fail, naming the probe's file.
filegroup(
    name = "tree_probes",
    srcs = {
        "22-read-json-file-write-records-database/probe_other.error.txt": "komira//python/tests:fixtures/task_probe_other_error.txt",
        "22-read-json-file-write-records-database/probe_other.py": "komira//python/tests:fixtures/task_probe_raises.py",
        "22-read-json-file-write-records-database/probe_runs.error.txt": "komira//python/tests:fixtures/task_probe_other_error.txt",
        "22-read-json-file-write-records-database/probe_runs.py": "komira//python/tests:fixtures/task_probe_runs.py",
    },
)

wheel_install_test(
    name = "refuses_probe_that_runs",
    python = "komira//third_party/python:cpython",
    wheels = _WHEELS,
    script = _DRIVER,
    args = ["--probe", "22-read-json-file-write-records-database/runs"],
    files = {"--tasks-dir": ":tree_probes"},
    expect_failure = "AssertionError: python/docs/tasks/22-read-json-file-write-records-database/probe_runs.py: ran to the end, " +
                     "but probe_runs.error.txt says it fails with 'ValueError: another refusal': " +
                     "if komira does this now, update the page, its catalogue status and the probe",
)

wheel_install_test(
    name = "refuses_probe_with_another_error",
    python = "komira//third_party/python:cpython",
    wheels = _WHEELS,
    script = _DRIVER,
    args = ["--probe", "22-read-json-file-write-records-database/other"],
    files = {"--tasks-dir": ":tree_probes"},
    expect_failure = "AssertionError: python/docs/tasks/22-read-json-file-write-records-database/probe_other.error.txt:1: " +
                     "expected 'ValueError: another refusal', raised 'ValueError: komira cannot do this yet'",
)

# Every example on the macOS arm64 wheel, one run on the farm's macOS
# workers: built by release-macos.yml's step `build the macOS Python harness
# tests` (DARWIN_PYTHON_HARNESS, release/darwin_libs.bzl), never by a pull
# request (tools/build/ci/rules.bzl, EXCLUDED). CPython 3.13 is the one macOS
# interpreter pinned.
wheel_install_test(
    name = "examples_macos_arm64",
    python = "komira//third_party/python:cpython_macos",
    wheels = [
        "komira//python:komira_wheel_macos_arm64",
        "komira//python/tests:" + PYARROW_MACOS["file"],
        "komira//python/tests:" + PROTOBUF_MACOS["file"],
    ],
    script = _DRIVER,
    args = [a for t in _TASKS for a in ["--task", t]] + [a for p in _PROBES for a in ["--probe", p]],
    files = {"--tasks-dir": ":tree"},
    exec_compatible_with = DARWIN_ARM64,
    target_compatible_with = DARWIN_ARM64,  # komira-limit:pypi-wheel-macos-arm64
)
