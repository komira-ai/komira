load("@komira//tools/build/mojo:toolchain.bzl", "zig_exe", "zig_module", "zig_test")
load("@komira//tools/build/platforms:defs.bzl", "DARWIN_ARM64", "LINUX_X86_64")

# pypi_smoke: the driver of .github/workflows/pypi.yml (docs/ci.md, "pypi.yml: publishing the Python
# package"): its push run (the user test of the wheel file, the upload to TestPyPI and the smoke of what
# TestPyPI serves, on every merge that changes code) and its promotion run (the file that passed, from
# TestPyPI to PyPI). It names the wheel the build made as an index will and writes the record of its bytes
# (`dist`), says whether TestPyPI or PyPI
# already holds it (`state`), says before anything is built whether a release lists a file of a given name
# (`present`), and after an upload checks what the index serves (`verify`) and what
# `pip install` makes of it in an empty environment (`install`), from an index or, before any upload, from
# the dist directory itself (`install --index dist`); `matrix` turns the list of supported Pythons
# the build writes for a platform (//python:supported_pythons[<platform>], from python/pythons.bzl) into the
# jobs of a workflow that installs the wheel once per Python; `storage` sums what a project's files take on an
# index against its per-project limit; `promote` holds a record to both indexes and downloads the recorded
# file from TestPyPI. src/cli.zig says what each command does;
# src/main.zig only forwards to the library (pypi_smoke_lib).
#
# Each scenario of its cases is its own test, on wheels made in memory, an index and a file host in memory
# and a command runner in memory (src/testing.zig), and the tool is built only behind all of them:
#   meta_unit      the name file of the present step (one wheel file name with a three-part tag; two lines, no
#                  .whl suffix, a build tag, a missing part or a character a file name cannot hold refused) and
#                  the dist step: a wheel with one dist-info, one Name, one Version and one Tag is named as the
#                  index names it (a name normalised, a requirement list kept in order), and a wheel with two
#                  dist-info directories, no or two Tag lines, a dist-info directory its metadata does not
#                  make, a version or tag a file name cannot hold, or bytes that are no zip is refused by
#                  defect; the dist directory holds that one file alone, a non-empty --out is refused, and --record holds
#                  one line, the file name, sha256 and size (an unwritable record path refused, nothing appended);
#   index_unit     the state step: absent (no release, or other files only), the same bytes, other bytes, and
#                  an HTTP 500, a transport error or an answer that is no release's JSON refused; the present
#                  step: a file name is absent on a 404 and when the release lists another platform's file
#                  only, present when the release lists it, and the same index errors are refused; the verify
#                  step: served bytes that are not the built ones (sha256 and size), a listed sha256 or size
#                  that differs, a file host that is not the index's, METADATA Name, Version,
#                  Requires-Python and the ordered Requires-Dist that differ, all reported together, an index
#                  that lags (passes on the second attempt, the log says so) and one that never has the file
#                  (refused after the last attempt);
#   install_unit   the install step: the exact commands for TestPyPI (requirements from PyPI first, then
#                  komira alone with --no-deps), for PyPI and for a dist directory (requirements from PyPI,
#                  then komira with --no-deps, --no-index and --find-links), each failing step named with its command, status
#                  and stderr, only the komira install tried again, `pip check` and the installed version held, `pip freeze`
#                  held to komira once plus only the wheel's requirements (names normalised, any version) and a `modular` package refused (also when the probe or freeze fails),
#                  only the example copied into the run directory (the data it needs it writes itself), the example's
#                  output held to the expected file with the version, the ABI version and the run directory's real path
#                  (`<cwd>`) put in (a name of another directory refused, both texts shown),
#                  a malformed ABI table or a work directory that is not empty refused before any command;
#   storage_unit   the storage step: an unknown project holds zero; the sum over every file of every release with
#                  the exact bullet and outputs; a release that lists no file is not a version; exactly at the
#                  threshold is not over and one byte more is (the error line, the bullet's ending and
#                  over=true, still exit 0); an HTTP 500, a transport error, a too-long answer and a body that
#                  is no project JSON with an integer size on each file refused with nothing appended; each
#                  flag error exit 2 before any request;
#   promote_unit   the promote step: the record (one line, name, 64 lowercase hex, size above 0; a malformed one
#                  refused naming the file before any request), the download held to TestPyPI's listing (sha256,
#                  size, the file host), to the record's bytes and to a wheel of the recorded name, the newer
#                  TestPyPI versions of the same tag named as skipped oldest first (numeric order; another
#                  tag's and a non-numeric version left out, the latter with its log line), PyPI's newer
#                  version of the same tag refused (equal, older, none and another tag's accepted), a
#                  non-empty --out, a TestPyPI without the project and an HTTP 500 on each request refused,
#                  each with nothing appended and nothing written to --out;
#   cli_unit       the command line: exit 0, 1 and 2, the output file appended to (`present` appends one line,
#                  and none when the name file or the index is refused), the failure line and the
#                  one-line error annotation, and each flag refused by name (unknown, the removed `--data` among them,
#                  valueless, repeated, out of range, --attempts or --delay with --index dist, an index or platform not known) without
#                  reaching the index or a command; `install --index dist` with the directory's resolved path
#                  and one attempt; `matrix` appending one line, and none when the list is refused;
#   readme_unit    the README check: a python block equal to the example passes; one that differs by a line,
#                  CRLF line ends, added or missing lines, no block, or a block that is not closed is refused
#                  naming the line.
#                  the same check holds the README's and the install page's ```text blocks to the expected output
#                  (`<cwd>` left as written; a line that differs there refused), and the
#                  changelog's newest release is its first `## <version>` heading after any `## Unreleased`,
#                  a heading that is no version refused;
#   matrix_unit    the list of supported Pythons as `matrix` reads it: a JSON list of exact versions gives the
#                  job matrix of a platform as one line of JSON, with its runner; text that is not a JSON list of
#                  strings, a version that is not `3.<minor>.<micro>`, a minor twice or out of order, and an empty
#                  list refused, each naming the file and the entry.
# readme_shows_quickstart runs that check on the real files: the "What works" block of python/README.md is
# python/examples/quickstart.py byte for byte, and its text block is what the quickstart prints at the changelog's
# newest release and the ABI version. install_page_shows_quickstart does the same for docs/install.md:
# its python block is the quickstart, and its text block is what the quickstart prints at the changelog's newest
# release and the ABI version of src/so/abi/komira.tsv. supported_pythons_lists reads the two lists of
# //python:supported_pythons.
_ZIG = "komira//tools/build/toolchains:zig_next"
_BUSYBOX = "komira//tools/build/toolchains:busybox"

_SRCS = [
    "src/cli.zig",
    "src/common.zig",
    "src/index.zig",
    "src/install.zig",
    "src/matrix.zig",
    "src/meta.zig",
    "src/project.zig",
    "src/promote.zig",
    "src/readme.zig",
    "src/storage.zig",
]

# What the driver does, as a module its command and its cases import. It reads the same client as
# release_staged_verify and the wheel zip of komira_wheel, through their modules.
zig_module(
    name = "pypi_smoke_lib",
    src = "src/lib.zig",
    imports = _SRCS,
    deps = [
        "//tools/build/ci:release_beta_fetch",
        "//tools/build/package:wheel_zip",
    ],
)

_SCENARIOS = ["meta", "index", "install", "cli", "readme", "matrix", "storage", "promote"]

[
    zig_test(
        name = "{}_unit".format(scenario),
        exec_compatible_with = LINUX_X86_64,
        src = "src/{}_test.zig".format(scenario),
        imports = [] if scenario in ("readme", "matrix") else ["src/testing.zig"],
        deps = [":pypi_smoke_lib"],
        busybox = _BUSYBOX,
        zig = _ZIG,
    )
    for scenario in _SCENARIOS
]

# The README's two blocks, read from the files themselves: the python block is the quickstart, and the text block is
# the quickstart's expected output at the newest release of the changelog and the ABI version of the table, with
# `<cwd>` left as written.
zig_test(
    name = "readme_shows_quickstart",
    exec_compatible_with = LINUX_X86_64,
    src = "src/readme_shows_quickstart_test.zig",
    data = {
        "CHANGELOG.md": "//python:CHANGELOG.md",
        "README.md": "//python:README.md",
        "komira.tsv": "//src/so:abi/komira.tsv",
        "quickstart.expected": "//python:examples/quickstart.expected",
        "quickstart.py": "//python:examples/quickstart.py",
    },
    deps = [":pypi_smoke_lib"],
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# The install page's two blocks, read from the files themselves: the python block is the quickstart, and the
# text block is the quickstart's expected output at the newest release of the changelog and the ABI version of
# the table, with `<cwd>` left as written (the install step puts the run directory's real path in its place).
zig_test(
    name = "install_page_shows_quickstart",
    exec_compatible_with = LINUX_X86_64,
    src = "src/install_page_shows_quickstart_test.zig",
    data = {
        "CHANGELOG.md": "//python:CHANGELOG.md",
        "install.md": "//:docs/install.md",
        "komira.tsv": "//src/so:abi/komira.tsv",
        "quickstart.expected": "//python:examples/quickstart.expected",
        "quickstart.py": "//python:examples/quickstart.py",
    },
    deps = [":pypi_smoke_lib"],
    busybox = _BUSYBOX,
    zig = _ZIG,
)

# The supported Pythons as the workflows' jobs read them: the two JSON lists of //python:supported_pythons are
# each exactly the versions src/supported_pythons_test.zig writes out, naming the same minors once each, oldest
# first, and `matrix` (matrix.zig) takes each for its platform; each defect of a list, written into a copy, is
# refused with its message.
zig_test(
    name = "supported_pythons_lists",
    exec_compatible_with = LINUX_X86_64,
    src = "src/supported_pythons_test.zig",
    data = {
        "linux-x86_64.json": "//python:supported_pythons[linux-x86_64]",
        "macos-arm64.json": "//python:supported_pythons[macos-arm64]",
    },
    deps = [":pypi_smoke_lib"],
    busybox = _BUSYBOX,
    zig = _ZIG,
)

zig_exe(
    name = "pypi_smoke",
    exec_compatible_with = LINUX_X86_64,
    src = "src/main.zig",
    deps = [":pypi_smoke_lib"],
    unit_tests = [":{}_unit".format(s) for s in _SCENARIOS] + [
        ":install_page_shows_quickstart",
        ":readme_shows_quickstart",
        ":supported_pythons_lists",
        "komira//tools/build/toolchains:zig_next_version",
    ],
    busybox = _BUSYBOX,
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The same driver for the hosted macOS runner of pypi.yml's smoke jobs (`verify` and `install`
# run on the Apple silicon runner, where the macOS wheel can be installed), cross-built by the Linux zig.
# pypi.yml's job build-macos-arm64 builds it with --target-platforms darwin-arm64; no pull request builds it
# (tools/build/ci/rules.bzl EXCLUDED).
zig_exe(
    name = "pypi_smoke_macos_arm64",
    exec_compatible_with = LINUX_X86_64,
    target_compatible_with = DARWIN_ARM64,  # komira-limit:pypi-wheel-macos-arm64
    src = "src/main.zig",
    target = "aarch64-macos",
    deps = [":pypi_smoke_lib"],
    unit_tests = [":{}_unit".format(s) for s in _SCENARIOS] + [
        ":install_page_shows_quickstart",
        ":readme_shows_quickstart",
        ":supported_pythons_lists",
        "komira//tools/build/toolchains:zig_next_version",
    ],
    busybox = _BUSYBOX,
    zig = _ZIG,
    visibility = ["PUBLIC"],
)
