load("@komira//python:dependencies.bzl", "PROTOBUF_REQUIREMENT")
load("@komira//third_party/python:pins.bzl", "PROTOBUF_EDGES")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/python:defs.bzl", "py_test", "python_wheel")

# The protobuf runtimes the tests below load the generated plan modules under,
# other than third_party/python's `:protobuf` (7.36.2, the range's upper edge):
# `:protobuf-5.29.1`, the lower edge, and `:protobuf-5.28.3`, the release below
# the range (third_party/python/pins.bzl, PROTOBUF_EDGES).
[pinned_file(
    name = w["file"],
    url = w["url"],
    sha256 = w["sha256"],
    size_bytes = w["size"],
) for w in PROTOBUF_EDGES]

[python_wheel(
    name = "protobuf-" + w["version"],
    distribution = w["name"],
    version = w["version"],
    wheel = ":" + w["file"],
    python = "komira//third_party/python:cpython",
) for w in PROTOBUF_EDGES]

# One test per case: the target, the runtime it installs and the version
# that runtime must report, which edge of the range it is, and, for a case of
# the script's own checks, the requirement it is given instead of
# PROTOBUF_REQUIREMENT and the error it must raise.
_CASES = [
    # The generated modules at each edge of the declared range: every plan
    # wire golden decodes (from plan_wire's own bytes and from protoc's),
    # parses from its text, and encodes to exactly protoc's bytes, which
    # plan_wire's golden test decodes; a plan built through the Python API
    # encodes to the same bytes.
    ("plan_pb2_lower_edge", ":protobuf-5.29.1", "5.29.1", "lower", PROTOBUF_REQUIREMENT, None),
    ("plan_pb2_upper_edge", "komira//third_party/python:protobuf", "7.36.2", "upper", PROTOBUF_REQUIREMENT, None),
    # The release below the range refuses the gencode when it is imported.
    ("plan_pb2_below_range_refused", ":protobuf-5.28.3", "5.28.3", "below", PROTOBUF_REQUIREMENT, None),
    # The script's checks of the range: a requirement the runtime is outside
    # of, one whose lower bound is not the gencode's version, and a target
    # naming another runtime than the one it installs.
    (
        "refuses_runtime_outside_range",
        "komira//third_party/python:protobuf",
        "7.36.2",
        "upper",
        "protobuf>=5.29.1,<7",
        "AssertionError: protobuf 7.36.2 is not in protobuf>=5.29.1,<7",
    ),
    (
        "refuses_lower_bound_not_gencode",
        "komira//third_party/python:protobuf",
        "7.36.2",
        "upper",
        "protobuf>=5.28.0,<8",
        "AssertionError: protobuf>=5.28.0,<8 starts at 5.28.0, not at 5.29.1, the version of the gencode",
    ),
    (
        "refuses_other_runtime",
        ":protobuf-5.29.1",
        "7.36.2",
        "upper",
        PROTOBUF_REQUIREMENT,
        "AssertionError: the runtime is protobuf 5.29.1, the target names 7.36.2",
    ),
]

[py_test(
    name = name,
    src = "test_plan_pb2.py",
    srcs = [
        "komira//python:plan_pb2[plan_pb2]",
        "komira//python:plan_pb2[plan_vocabulary_pb2]",
    ],
    deps = [protobuf],
    args = [
        "--golden",
        "$(location komira//src/plan_wire:golden_fixtures)",
        "--requirement",
        requirement,
        "--runtime",
        version,
        "--edge",
        edge,
    ],
    expect_error = expect_error,
) for name, protobuf, version, edge, requirement, expect_error in _CASES]
