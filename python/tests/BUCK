# Capture of a user function (komira._capture), with no library: the `@udf`
# decorator, return types, the read set (columns=, annotations and the
# bytecode scan), the package or bundle code form, the deterministic bundle
# and the code root. The fixture functions are real modules, because capture
# reads a function's source file.
[py_test(
    name = "capture_test" + p["suffix"],
    src = "test_capture.py",
    srcs = [
        "fixtures/udfs/__init__.py",
        "fixtures/udfs/future.py",
        "fixtures/udfs/rows.py",
        "fixtures/udfs/scalars.py",
    ],
    deps = ["//python:komira"],
    **_ON[p["suffix"]]
) for p in PYTHONS]

# The plan encoder's expressions (komira/_plan), on each supported minor under
# the newest protobuf the range admits, and on CPython 3.13 under the oldest:
#
# - plan_expr_test: each literal kind at its boundaries, column sides, the
#   argument counts of the many-argument string functions, the arithmetic and
#   cast result types, the CASE literal promotion, and every refusal with its
#   full message.
# - plan_expr_goldens_test: the projections of plan_wire's `expr_*` goldens,
#   which the engine built (src/plan_wire/tests/test_plan_wire_expr_goldens*),
#   encode to exactly each golden's `.canonical.hex`, which plan_wire's test
#   decodes back to the engine's plan; and the check fails for an expression or
#   a field that differs.
_PLAN_EXPR_RUNTIMES = [
    (p["suffix"], p, "7.36.2")
    for p in PYTHONS
] + [("_protobuf_lower_edge", [p for p in PYTHONS if not p["suffix"]][0], "5.29.1")]

[py_test(
    name = "plan_expr{}_test{}".format(area, suffix),
    src = "test_plan_expr{}.py".format(area),
    deps = [
        "//python:komira_with_plan_modules",
        _PROTOBUF[p["suffix"]][runtime],
    ],
    args = ["--golden", "$(location komira//src/plan_wire:golden_fixtures)"] if area else [],
    **_ON[p["suffix"]]
) for suffix, p, runtime in _PLAN_EXPR_RUNTIMES for area in ["", "_goldens"]]

# The plan encoder's relational nodes (komira/_plan), on the same runtimes:
#
# - plan_rel_test: the scan sources and the checks of a scan's declared
#   columns, the field each aggregate and window function derives over each
#   input type that changes it, join nullability and renaming, a residual typed
#   by side, the window stacking and its shadow names, and every refusal with
#   its full message.
# - plan_rel_goldens_test: the plans of plan_wire's `rel_*` goldens, which the
#   engine built (src/plan_wire/tests/test_plan_wire_rel_goldens*), encode to
#   exactly each golden's `.canonical.hex`; and the check fails, at the node
#   that differs, for a sort key, an aggregate's type, a join kind or a window
#   frame that differs.
# - plan_no_sql_test: the encoder imports nothing that reaches libkomira or SQL,
#   and names and holds no SQL text.
# - plan_udf_test: the UdfRef of each kind of user function, the table that
#   indexes them, the komira/python descriptor bytes, the output schema of a
#   call and of a MapBatches node, and the refusal of an argument or read-set
#   column type the runtime does not carry.
# - plan_udf_goldens_test: the plans of plan_wire's `udf_*` goldens, which the
#   engine built (src/plan_wire/tests/test_plan_wire_udf_goldens), encode to
#   exactly each golden's `.canonical.hex`, UdfRefs included; and the check
#   fails, at the node or the UdfRef that differs, for a read set, a stability, a
#   null mode or a return type that differs.
[py_test(
    name = "plan_{}_test{}".format(area, suffix),
    src = "test_plan_{}.py".format(area),
    deps = [
        "//python:komira_with_plan_modules",
        _PROTOBUF[p["suffix"]][runtime],
    ],
    args = ["--golden", "$(location komira//src/plan_wire:golden_fixtures)"] if area in ["rel_goldens", "udf_goldens"] else [],
    **_ON[p["suffix"]]
) for suffix, p, runtime in _PLAN_EXPR_RUNTIMES for area in ["rel", "rel_goldens", "no_sql", "udf", "udf_goldens"]]

# The clean-environment install tests of the wheel (python/BUCK,
# wheel_install_test): the driver that installs the wheels into an empty
# prefix and runs a test there, the three tests the installed interpreter runs
# (the wheel alone, the wheel beside Modular's runtime, and the wheel after an
# upgrade from the previous release), and the serialized plan the first renders
# (the scan plan of src/so/tests/gate/gate_plan_render.mojo, as hex).
[export_file(
    name = f,
    visibility = ["komira//python:"],
) for f in [
    "wheel_install_run.py",
    "test_installed.py",
    "test_beside_modular.py",
    "test_upgrade.py",
    "fixtures/scan_plan.hex",
    "fixtures/previous_release_only.txt",
]]

# The komira/python UDF runtime (src/udf_python) behind a ctypes host of its C
# ABI (udf_host.py), on the two minors that have a pinned pyarrow: CPython 3.13
# and 3.14. The library is staged as `libkomira_udf_python.so` in --lib-dir.
_UDF_PYARROW = {
    "": "komira//third_party/python:pyarrow",
    "_py314": "komira//third_party/python:pyarrow-cp314",
}

[python_binding_test(
    name = test[5:] + "_test" + p["suffix"],
    src = test + ".py",
    srcs = ["udf_host.py"],
    data = {"libkomira_udf_python.so": "komira//src/udf_python:komira_udf_python"},
    deps = ["//python:komira", _UDF_PYARROW[p["suffix"]]],
    **_ON[p["suffix"]]
) for test in [
    "test_udf_contract",
    "test_udf_process",
    "test_udf_calls",
    "test_udf_lifecycle",
    "test_udf_cancel",
    "test_udf_generations",
    "test_udf_supervision",
    "test_udf_engine_child",
    "test_udf_types",
    "test_udf_ipc",
] for p in PYTHONS if p["suffix"] in _UDF_PYARROW]

