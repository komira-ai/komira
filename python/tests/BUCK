# The protobuf runtimes the tests below load the generated plan modules under:
# 7.36.2, the range's upper edge (third_party/python's `:protobuf`), 5.29.1,
# the lower edge, and 5.28.3, the release below the range
# (third_party/python/pins.bzl, PROTOBUF_EDGES). For CPython 3.13 the edges
# are installed here as `:protobuf-5.29.1` and `:protobuf-5.28.3`, and 7.36.2
# is third_party/python's; for each other minor all three are installed here,
# as `:protobuf-<version><suffix>` (`:protobuf-7.36.2_py311`). Each wheel is
# `abi3`, one file for every minor.
_PROTOBUF_UPPER = [w for w in WHEELS if w["name"] == "protobuf"]

[pinned_file(
    name = w["file"],
    url = w["url"],
    sha256 = w["sha256"],
    size_bytes = w["size"],
) for w in PROTOBUF_EDGES + _PROTOBUF_UPPER]

[python_wheel(
    name = "protobuf-" + w["version"] + p["suffix"],
    distribution = w["name"],
    version = w["version"],
    wheel = ":" + w["file"],
    python = p["python"],
) for p in PYTHONS for w in PROTOBUF_EDGES + (_PROTOBUF_UPPER if p["suffix"] else [])]

# {suffix: {version: the target of that protobuf runtime for that minor}}
_PROTOBUF = {
    p["suffix"]: {
        w["version"]: (":protobuf-" + w["version"] + p["suffix"]) if p["suffix"] or w in PROTOBUF_EDGES else "komira//third_party/python:protobuf"
        for w in PROTOBUF_EDGES + _PROTOBUF_UPPER
    }
    for p in PYTHONS
}

# One test per case and minor: the target, the version of the runtime it
# installs and the version that runtime must report, which edge of the range
# it is, and, for a case of the script's own checks, the requirement it is
# given instead of PROTOBUF_REQUIREMENT and the error it must raise.
_CASES = [
    # The generated modules at each edge of the declared range: every plan
    # wire golden decodes (from plan_wire's own bytes and from protoc's),
    # parses from its text, and encodes to exactly protoc's bytes, which
    # plan_wire's golden test decodes; a plan built through the Python API
    # encodes to the same bytes.
    ("plan_pb2_lower_edge", "5.29.1", "5.29.1", "lower", PROTOBUF_REQUIREMENT, None),
    ("plan_pb2_upper_edge", "7.36.2", "7.36.2", "upper", PROTOBUF_REQUIREMENT, None),
    # The release below the range refuses the gencode when it is imported.
    ("plan_pb2_below_range_refused", "5.28.3", "5.28.3", "below", PROTOBUF_REQUIREMENT, None),
    # The script's checks of the range: a requirement the runtime is outside
    # of, one whose lower bound is not the gencode's version, and a target
    # naming another runtime than the one it installs.
    (
        "refuses_runtime_outside_range",
        "7.36.2",
        "7.36.2",
        "upper",
        "protobuf>=5.29.1,<7",
        "AssertionError: protobuf 7.36.2 is not in protobuf>=5.29.1,<7",
    ),
    (
        "refuses_lower_bound_not_gencode",
        "7.36.2",
        "7.36.2",
        "upper",
        "protobuf>=5.28.0,<8",
        "AssertionError: protobuf>=5.28.0,<8 starts at 5.28.0, not at 5.29.1, the version of the gencode",
    ),
    (
        "refuses_other_runtime",
        "5.29.1",
        "7.36.2",
        "upper",
        PROTOBUF_REQUIREMENT,
        "AssertionError: the runtime is protobuf 5.29.1, the target names 7.36.2",
    ),
]

[py_test(
    name = name + p["suffix"],
    src = "test_plan_pb2.py",
    srcs = [
        "komira//python:plan_pb2[plan_pb2]",
        "komira//python:plan_pb2[plan_vocabulary_pb2]",
    ],
    deps = [_PROTOBUF[p["suffix"]][runtime]],
    args = [
        "--golden",
        "$(location komira//src/plan_wire:golden_fixtures)",
        "--requirement",
        requirement,
        "--runtime",
        version,
        "--edge",
        edge,
    ],
    expect_error = expect_error,
    **_ON[p["suffix"]]
) for p in PYTHONS for name, runtime, version, edge, requirement, expect_error in _CASES]

# The private plan node tree both DataFrame skins build (komira._ops), with no
# library: each verb's tree equals a hand-written one, and each refusal raises
# its class with its full message.
#
# - ops_expr_test: the expression nodes, their vocabularies and refusals, and
#   the and/or chains, is_in and between they are built from.
# - ops_walk_test: the walkers over expressions (children, column references,
#   substitution, the leftmost column).
# - ops_rel_test: the support types and the single-input relational nodes, and
#   the columns each one outputs.
# - ops_rel_join_test: the join, union and write nodes, the join output names,
#   and the columns of whole plans.
# - ops_verbs_test: the verbs the skins call, one per verb, including the
#   cases that add no node.
# - ops_no_sql_test: no node, verb or module of komira._ops renders SQL text,
#   with cases that show each check fails when one does.
# - ops_udf_test: the user-function nodes (UdfSpec, UdfCall, MapBatches), their
#   refusals, the walkers over a call and the map_batches verb.
# - ops_dtype_test: the dtype spellings of a user function's return type, their
#   canonical forms, and every refusal with its full message.
[py_test(
    name = "ops_{}_test{}".format(area, p["suffix"]),
    src = "test_ops_{}.py".format(area),
    deps = ["//python:komira"],
    **_ON[p["suffix"]]
) for p in PYTHONS for area in [
    "expr",
    "walk",
    "rel",
    "rel_join",
    "verbs",
    "no_sql",
    "udf",
    "dtype",
]]

