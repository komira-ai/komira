# ---- pyarrow, which a Result reads as -------------------------------------
#
# The pinned pyarrow 25.0.1 wheel of each supported minor
# (python/dependencies.bzl, PYARROW_WHEELS) and the macOS arm64 one of CPython
# 3.13, downloaded here for the wheel's install tests (python/BUCK), which
# install the file beside komira's wheel; and the installed target of each
# minor for the tests below: third_party/python's `:pyarrow` (3.13) and
# `:pyarrow-cp314`, and `:pyarrow-cp311` and `:pyarrow-cp312` here.
[pinned_file(
    name = w["file"],
    url = w["url"],
    sha256 = w["sha256"],
    size_bytes = w["size"],
    visibility = ["komira//python:"],
) for w in PYARROW_WHEELS.values()]

# Read only by the macOS wheel's install test, which runs from
# pypi-macos-arm64.yml alone, never in a pull request.
pinned_file(
    name = PYARROW_MACOS["file"],
    url = PYARROW_MACOS["url"],
    sha256 = PYARROW_MACOS["sha256"],
    size_bytes = PYARROW_MACOS["size"],
    target_compatible_with = DARWIN_ARM64,  # komira-limit:pypi-wheel-macos-arm64
    visibility = ["komira//python:"],
)

[python_wheel(
    name = "pyarrow-" + PYARROW_WHEELS[p["suffix"]]["file"].split("-")[2],
    distribution = "pyarrow",
    version = PYARROW_WHEELS[p["suffix"]]["version"],
    wheel = ":" + PYARROW_WHEELS[p["suffix"]]["file"],
    python = p["python"],
) for p in PYTHONS if p["suffix"] in ("_py311", "_py312")]

# {suffix: the installed pyarrow of that minor}
_PYARROW = {
    "": "komira//third_party/python:pyarrow",
    "_py311": ":pyarrow-cp311",
    "_py312": ":pyarrow-cp312",
    "_py314": "komira//third_party/python:pyarrow-cp314",
}

# Session.sql on the stand-in's stream (fake_libkomira.c, ABI 1.3): a Result
# reads once, by to_arrow, to_reader or __arrow_c_stream__; a result never
# read, a capsule never consumed and a stream pyarrow consumed are each
# released exactly once, and every batch too; a requested schema is refused
# with UnsupportedOperation and leaves the result unread; an engine refusal (-3)
# and a text too long (-5) raise KomiraError with the library's message and
# make no stream; a failing get_schema raises KomiraError from sql and a
# failing get_next from to_arrow (pyarrow's OSError from a reader); the
# argument checks and a closed session make no call; results left unread at
# interpreter exit are released without a crash.
[python_binding_test(
    name = "sql_fake_test" + p["suffix"],
    src = "test_sql_fake.py",
    data = {"fake_v1_3/libkomira.so": ":fake_v1_3"},
    deps = ["//python:komira", _PYARROW[p["suffix"]]],
    **_ON[p["suffix"]]
) for p in PYTHONS]

# Ctrl-C during Session.sql, on the stand-in's stream (fake_libkomira.c, whose
# komira_sql_stream raises SIGINT for a text starting "interrupted:"): sql
# raises KeyboardInterrupt once the call returns and the stream it filled is
# released exactly once; the session answers the next query, also after a
# refusal SIGINT came during; a handler that does not raise runs once and sql
# returns the answer; an ignored SIGINT changes nothing.
[python_binding_test(
    name = "sql_interrupt_test" + p["suffix"],
    src = "test_sql_interrupt.py",
    data = {"fake_v1_3/libkomira.so": ":fake_v1_3"},
    deps = ["//python:komira", _PYARROW[p["suffix"]]],
    **_ON[p["suffix"]]
) for p in PYTHONS]

