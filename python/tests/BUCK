# Every `py_test` and `python_binding_test` below is declared through these two,
# which record its name and its file in `_SUITE` ({name: src}) before they
# declare it: `:all` (the end of this file) depends on all of them, and a name
# declared twice fails the load naming both files (families.bzl).
_SUITE = {}
py_test = register(_py_test, _SUITE)
python_binding_test = register(_python_binding_test, _SUITE)

# libkomira with the Mojo runtime and its native owners in lib/ beside it: the
# directory the loader is given.
LIBKOMIRA = "komira//src/so:libkomira[runnable]"

PARQUET = "komira//src/so:tests/fixtures/two_columns.parquet"

# Every test below runs once per supported minor (python/pythons.bzl), on its
# pinned interpreter: `<name>` on CPython 3.13 (the rules' default interpreter,
# CPython 3.13 on macOS too), `<name>_py311`, `<name>_py312` and
# `<name>_py314` on the others. `_ON[suffix]` is the `python` argument of a
# minor's tests: none for 3.13.
_ON = {p["suffix"]: ({"python": p["python"]} if p["suffix"] else {}) for p in PYTHONS}

# Stand-ins for libkomira (fake_libkomira.c). The loader must refuse a library
# of ABI major 2, of major 0 (version 0.999), one reporting -1, one without
# komira_abi_version and a 1.1 one without komira_register_parquet; it must
# load a 1.0 one (without the calls 1.1 and 1.2 added), a 1.3 one and a 1.7 one
# (which also answers the last error's code and step). `fake_modes`
# (version 1.1) answers each call by the mode its register_parquet name set,
# for the error path, the two-call protocol and the output calls. `fake_store`
# (version 1.2) records every credential call in its fake store.
c_shared_lib(
    name = "fake_v2",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=2000"],
    out = "libkomira_fake_v2.so",
)

c_shared_lib(
    name = "fake_v0",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=999"],
    out = "libkomira_fake_v0.so",
)

c_shared_lib(
    name = "fake_negative",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=-1"],
    out = "libkomira_fake_negative.so",
)

c_shared_lib(
    name = "fake_no_abi_version",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_OMIT_ABI_VERSION"],
    out = "libkomira_fake_no_abi_version.so",
)

c_shared_lib(
    name = "fake_no_register",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_OMIT_REGISTER"],
    out = "libkomira_fake_no_register.so",
)

c_shared_lib(
    name = "fake_v1_0",
    srcs = ["fake_libkomira.c"],
    copts = [
        "-DFAKE_VERSION=1000",
        "-DFAKE_ABI_1_0",
    ],
    out = "libkomira_fake_v1_0.so",
)

c_shared_lib(
    name = "fake_v1_3",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=1003"],
    out = "libkomira_fake_v1_3.so",
)

c_shared_lib(
    name = "fake_v1_7",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=1007"],
    out = "libkomira_fake_v1_7.so",
)

c_shared_lib(
    name = "fake_modes",
    srcs = ["fake_libkomira.c"],
    out = "libkomira_fake_modes.so",
)

c_shared_lib(
    name = "fake_store",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=1002"],
    out = "libkomira_fake_store.so",
)

# Stand-ins for a Mojo runtime library (fake_runtime_lib.c), for the check of
# a runtime already in the process (komira/_runtime.py): each case's copies at
# `<case>/ours/` (komira's `_lib/lib`) and `<case>/other/` (someone else's),
# with the SONAME `libfake_rt_<case>.so` and the build id bytes given here
# (fake_runtime_lib.c writes the note), None for no build id note.
_FAKE_RUNTIME = [
    # (case, where, build id)
    ("a", "ours", "0x0a,0x0a,0x0a,0x0a"),
    ("b", "ours", "0x0b,0x0b,0x0b,0x0b"),
    ("b", "other", "0x0b,0x0b,0x0b,0x0b"),
    ("c", "ours", "0x0c,0x0c,0x0c,0x0c"),
    ("c", "other", "0x0d,0x0d,0x0d,0x0d"),
    ("d", "ours", "0x0e,0x0e,0x0e,0x0e"),
    ("d", "other", None),
    ("e", "other", "0x0f,0x0f,0x0f,0x0f"),
]

[c_shared_lib(
    name = "fake_rt_{}_{}".format(case, where),
    srcs = ["fake_runtime_lib.c"],
    copts = [
        "-DFAKE_MARKER={}".format(i),
        "-Wl,-soname,libfake_rt_{}.so".format(case),
        "-Wl,--build-id=none",
    ] + (["-DFAKE_BUILD_ID={}".format(build_id)] if build_id else []),
    out = "libfake_rt_{}.so".format(case),
) for i, (case, where, build_id) in enumerate(_FAKE_RUNTIME)]

# The runtime check on the stand-ins: nothing loaded by a name, komira's own
# copy loaded, another copy of the same build (accepted), another build and a
# copy without a build id (refused, naming the library and both files),
# komira's copy missing while another is loaded (refused, naming the missing
# file), a loaded copy that cannot be read back, and nothing checked off
# Linux; and the build id reader on the stand-ins and on hand-written ELF
# headers (no note, other notes, a cut program header table, not ELF64).
[python_binding_test(
    name = "runtime_test" + p["suffix"],
    src = "test_runtime.py",
    data = {
        "{}/{}/libfake_rt_{}.so".format(case, where, case): ":fake_rt_{}_{}".format(case, where)
        for case, where, _ in _FAKE_RUNTIME
    },
    deps = ["//python:komira"],
    **_ON[p["suffix"]]
) for p in PYTHONS]

# Importing loads nothing; the hooks run before the library is opened; the
# refusals of load (no library, another ABI major, a missing symbol, another
# file once loaded); then the real library: its version and each of its nine
# calls, with an engine refusal and its last error.
[python_binding_test(
    name = "load_test" + p["suffix"],
    src = "test_load.py",
    data = {
        "fake_negative/libkomira.so": ":fake_negative",
        "fake_no_abi_version/libkomira.so": ":fake_no_abi_version",
        "fake_no_register/libkomira.so": ":fake_no_register",
        "fake_v0/libkomira.so": ":fake_v0",
        "fake_v2/libkomira.so": ":fake_v2",
        "libkomira": LIBKOMIRA,
        "two_columns.parquet": PARQUET,
    },
    deps = ["//python:komira"],
    **_ON[p["suffix"]]
) for p in PYTHONS]

# The exception table (komira/_errors.py) on the stand-ins of ABI 1.7 and 1.3:
