# The komira/python UDF runtime (src/udf_python) behind a ctypes host of its C
# ABI (udf_host.py), on the two minors that have a pinned pyarrow: CPython 3.13
# and 3.14. The library is staged in --lib-dir as `libkomira_udf_python.so`
# (`libkomira_udf_python.dylib` on macOS, the name udf_host.LIB_FILE opens).
_UDF_LIB = select({
    "DEFAULT": {"libkomira_udf_python.so": "komira//src/udf_python:komira_udf_python"},
    "prelude//os/constraints:macos": {"libkomira_udf_python.dylib": "komira//src/udf_python:komira_udf_python"},
})

_UDF_PYARROW = {
    "": "komira//third_party/python:pyarrow",
    "_py314": "komira//third_party/python:pyarrow-cp314",
}

[python_binding_test(
    name = test[5:] + "_test" + p["suffix"],
    src = test + ".py",
    srcs = ["udf_host.py"],
    data = _UDF_LIB,
    deps = ["//python:komira", _UDF_PYARROW[p["suffix"]]],
    **_ON[p["suffix"]]
) for test in [
    "test_udf_contract",
    "test_udf_process",
    "test_udf_calls",
    "test_udf_lifecycle",
    "test_udf_cancel",
    "test_udf_generations",
    "test_udf_supervision",
    "test_udf_engine_child",
    "test_udf_types",
    "test_udf_ipc",
] for p in PYTHONS if p["suffix"] in _UDF_PYARROW]

# A function the SDK captured and the plan encoder wrote, run in the same
# runtime from nothing but the plan's UdfRef (test_udf_plan_run.py): the values
# it gives, the refusal of a changed descriptor or code object, and of a row
# function's descriptor. It reads the plan modules, so it takes the protobuf
# runtime of each minor.
[python_binding_test(
    name = "udf_plan_run_test" + p["suffix"],
    src = "test_udf_plan_run.py",
    srcs = [
        "udf_host.py",
        "fixtures/udfs/__init__.py",
        "fixtures/udfs/runtime.py",
    ],
    data = _UDF_LIB,
    deps = [
        "//python:komira_with_plan_modules",
        _PROTOBUF[p["suffix"]]["7.36.2"],
        _UDF_PYARROW[p["suffix"]],
    ],
    **_ON[p["suffix"]]
) for p in PYTHONS if p["suffix"] in _UDF_PYARROW]

# ---- the suite --------------------------------------------------------------
#
# Every test file is run by a target: the `src` of one of the targets above (a
# family's, found by its glob, or a stanza's) or an `export_file` of the wheel's
# install tests (//python's BUCK file runs those); any other `test_*.py` fails the
# load, naming the file. This part comes after every test is declared.
_TEST_FILES = glob(["**/test_*.py"])

require_all_run(
    _TEST_FILES,
    _SUITE.values(),
    [f for f in _TEST_FILES if rule_exists(f)],
    _FAMILIES,
)

# `:all` builds, and so runs, every test of the package, and is the one row of
# this package in the check set (ci/targets.bzl): a test added as a file of a
# family, or as a stanza, joins it without touching a generated list.
ci_aggregate(
    name = "all",
    deps = [":" + name for name in sorted(_SUITE.keys())],
)
