# ---- the test families ----------------------------------------------------------
#
# A test of one of these shapes is a file `<dir>/test_<name>.py` and no stanza:
# the globs below declare its targets, `<name>_test` with the suffix the family
# gives (`_py311`, ..., `_protobuf_lower_edge`), so adding a test of the shape
# is adding the file, and its docstring says what it covers. The name is the
# file stem without `test_`, then `_test` (families.bzl, `test_target_name`):
# two files that give one name fail the load, naming both. The directories
# are in package python/tests (no BUCK file in them). What a family runs with
# is its stanza here, the same for every test in it; a test that needs other
# inputs gets a stanza of its own anywhere in this file, with its `src`. A
# `test_*.py` that no stanza names and no family directory holds fails the
# load (the end of this file).
_FAMILIES = ["plan", "run", "duckdb", "pl", "pl_oracle"]

_FAMILY_FILES = {d: glob([d + "/test_*.py"]) for d in _FAMILIES}

# plan/: tests of the plan side with no library, on the plan tests'
# runtimes (_PLAN_EXPR_RUNTIMES): the plan modules and a protobuf runtime, and
# nothing else: each minor under 7.36.2, and CPython 3.13 under 5.29.1 too
# (`<name>_test_protobuf_lower_edge`).
[py_test(
    name = test_target_name(f, suffix),
    src = f,
    deps = [
        "//python:komira_with_plan_modules",
        _PROTOBUF[p["suffix"]][runtime],
    ],
    **_ON[p["suffix"]]
) for suffix, p, runtime in _PLAN_EXPR_RUNTIMES for f in _FAMILY_FILES["plan"]]

# run/: tests on the real libkomira (`libkomira`, and `fake_v1_7/libkomira.so`,
# the ABI 1.7 stand-in that refuses the plan door), per minor, with the plan
# modules, protobuf 7.36.2 and pyarrow.
[python_binding_test(
    name = test_target_name(f, p["suffix"]),
    src = f,
    data = {
        "fake_v1_7/libkomira.so": ":fake_v1_7",
