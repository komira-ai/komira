load("@komira//python:dependencies.bzl", "PROTOBUF_REQUIREMENT")
load("@komira//third_party/python:pins.bzl", "PROTOBUF_EDGES")
load("@komira//tools/build/mojo:download.bzl", "pinned_file")
load("@komira//tools/build/node:defs.bzl", "c_shared_lib")
load("@komira//tools/build/python:defs.bzl", "py_test", "python_binding_test", "python_wheel")

# libkomira with the Mojo runtime and its native owners in lib/ beside it: the
# directory the loader is given.
LIBKOMIRA = "komira//src/so:libkomira[runnable]"

PARQUET = "komira//src/so:tests/fixtures/two_columns.parquet"

# Stand-ins for libkomira (fake_libkomira.c). The loader must refuse a library
# of ABI major 2, of major 0 (version 0.999), one reporting -1, one without
# komira_abi_version and a 1.1 one without komira_register_parquet; it must
# load a 1.0 one (without the calls 1.1 added) and a 1.3 one. `fake_modes`
# (version 1.1) answers each call by the mode its register_parquet name set,
# for the error path, the two-call protocol and the output calls.
c_shared_lib(
    name = "fake_v2",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=2000"],
    out = "libkomira_fake_v2.so",
)

c_shared_lib(
    name = "fake_v0",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=999"],
    out = "libkomira_fake_v0.so",
)

c_shared_lib(
    name = "fake_negative",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=-1"],
    out = "libkomira_fake_negative.so",
)

c_shared_lib(
    name = "fake_no_abi_version",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_OMIT_ABI_VERSION"],
    out = "libkomira_fake_no_abi_version.so",
)

c_shared_lib(
    name = "fake_no_register",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_OMIT_REGISTER"],
    out = "libkomira_fake_no_register.so",
)

c_shared_lib(
    name = "fake_v1_0",
    srcs = ["fake_libkomira.c"],
    copts = [
        "-DFAKE_VERSION=1000",
        "-DFAKE_ABI_1_0",
    ],
    out = "libkomira_fake_v1_0.so",
)

c_shared_lib(
    name = "fake_v1_3",
    srcs = ["fake_libkomira.c"],
    copts = ["-DFAKE_VERSION=1003"],
    out = "libkomira_fake_v1_3.so",
)

c_shared_lib(
    name = "fake_modes",
    srcs = ["fake_libkomira.c"],
    out = "libkomira_fake_modes.so",
)

# Stand-ins for the three Mojo runtime libraries and for a library that needs
# them (fake_mojo_runtime.c): each needs a symbol of the ones before it, so
# they open only in dependency order with RTLD_GLOBAL.
[c_shared_lib(
    name = "fake_runtime_" + name,
    srcs = ["fake_mojo_runtime.c"],
    copts = ["-DFAKE_LIB={}".format(n)],
    out = "libfake_runtime_{}.so".format(name),
) for name, n in [("msupport", 1), ("asyncrt", 2), ("kgen", 3), ("consumer", 4)]]

# The runtime preload on stand-in directories: a library missing (none, two
# of three, the .dylib names on macOS, sys.path when no search path is given),
# another mojo-compiler version, a library that is not one (the first, and
# the third after two opened, then retried), and the three present, opened in
# order so a library needing them loads; then the same
# directory again, and another one refused. A plain py_test: no
# LD_LIBRARY_PATH, so only the preload makes the stand-ins' symbols visible.
py_test(
    name = "runtime_test",
    src = "test_runtime.py",
    args = [
        "--msupport",
        "$(location :fake_runtime_msupport)",
        "--asyncrt",
        "$(location :fake_runtime_asyncrt)",
        "--kgen",
        "$(location :fake_runtime_kgen)",
        "--consumer",
        "$(location :fake_runtime_consumer)",
    ],
    deps = ["//python:komira"],
)

# Importing loads nothing; the hooks run before the library is opened; the
# refusals of load (no library, another ABI major, a missing symbol, another
# file once loaded); then the real library: its version and each of its nine
# calls, with an engine refusal and its last error.
python_binding_test(
    name = "load_test",
    src = "test_load.py",
    srcs = ["runtime_site.py"],
    data = {
        "fake_negative/libkomira.so": ":fake_negative",
        "fake_no_abi_version/libkomira.so": ":fake_no_abi_version",
        "fake_no_register/libkomira.so": ":fake_no_register",
        "fake_v0/libkomira.so": ":fake_v0",
        "fake_v2/libkomira.so": ":fake_v2",
        "libkomira": LIBKOMIRA,
        "two_columns.parquet": PARQUET,
    },
    deps = ["//python:komira"],
)

# The CPU check before the library opens: on Linux x86_64 a cpuinfo of an
# x86-64-v3 CPU passes, one lacking any of its flags (avx2 among them, on one
# processor or all, or with no flags line) raises UnsupportedCpuError naming
# them and the library is not opened, an unreadable one is a LibraryLoadError,
# and aarch64 Linux and macOS read nothing.
python_binding_test(
    name = "cpu_test",
    src = "test_cpu.py",
    srcs = ["runtime_site.py"],
    data = {
        "cpuinfo_x86_64_v3.txt": "fixtures/cpuinfo_x86_64_v3.txt",
        "fake_v1_3/libkomira.so": ":fake_v1_3",
    },
    deps = ["//python:komira"],
)

# The public surface on the real library: abi_version(), Session,
# register_parquet and a session's close.
python_binding_test(
    name = "session_test",
    src = "test_session.py",
    srcs = ["runtime_site.py"],
    data = {
        "libkomira": LIBKOMIRA,
        "two_columns.parquet": PARQUET,
    },
    deps = ["//python:komira"],
)

# Any minor of ABI 1 loads: 1.0, whose 1.1 calls raise when used, and 1.3.
python_binding_test(
    name = "minor0_test",
    src = "test_minor.py",
    srcs = ["runtime_site.py"],
    args = [
        "--fake",
        "fake_v1_0",
        "--version",
        "1000",
    ],
    data = {"fake_v1_0/libkomira.so": ":fake_v1_0"},
    deps = ["//python:komira"],
)

python_binding_test(
    name = "minor3_test",
    src = "test_minor.py",
    srcs = ["runtime_site.py"],
    args = [
        "--fake",
        "fake_v1_3",
        "--version",
        "1003",
    ],
    data = {"fake_v1_3/libkomira.so": ":fake_v1_3"},
    deps = ["//python:komira"],
)

# The stand-in's calls: the second call's capacity is the first call's
# length, a length that grows or shrinks between the calls, a second call
# that fails, a last error that cannot be read or is empty or not UTF-8, the
# call's own status, the arguments and answers of the four output calls, the
# argument checks, and a komira_ctx_new that returns NULL.
python_binding_test(
    name = "two_call_test",
    src = "test_two_call.py",
    srcs = ["runtime_site.py"],
    data = {"fake_modes/libkomira.so": ":fake_modes"},
    deps = ["//python:komira"],
)

# The protobuf runtimes the tests below load the generated plan modules under,
# other than third_party/python's `:protobuf` (7.36.2, the range's upper edge):
# `:protobuf-5.29.1`, the lower edge, and `:protobuf-5.28.3`, the release below
# the range (third_party/python/pins.bzl, PROTOBUF_EDGES).
[pinned_file(
    name = w["file"],
    url = w["url"],
    sha256 = w["sha256"],
    size_bytes = w["size"],
) for w in PROTOBUF_EDGES]

[python_wheel(
    name = "protobuf-" + w["version"],
    distribution = w["name"],
    version = w["version"],
    wheel = ":" + w["file"],
    python = "komira//third_party/python:cpython",
) for w in PROTOBUF_EDGES]

# One test per case: the target, the runtime it installs and the version
# that runtime must report, which edge of the range it is, and, for a case of
# the script's own checks, the requirement it is given instead of
# PROTOBUF_REQUIREMENT and the error it must raise.
_CASES = [
    # The generated modules at each edge of the declared range: every plan
    # wire golden decodes (from plan_wire's own bytes and from protoc's),
    # parses from its text, and encodes to exactly protoc's bytes, which
    # plan_wire's golden test decodes; a plan built through the Python API
    # encodes to the same bytes.
    ("plan_pb2_lower_edge", ":protobuf-5.29.1", "5.29.1", "lower", PROTOBUF_REQUIREMENT, None),
    ("plan_pb2_upper_edge", "komira//third_party/python:protobuf", "7.36.2", "upper", PROTOBUF_REQUIREMENT, None),
    # The release below the range refuses the gencode when it is imported.
    ("plan_pb2_below_range_refused", ":protobuf-5.28.3", "5.28.3", "below", PROTOBUF_REQUIREMENT, None),
    # The script's checks of the range: a requirement the runtime is outside
    # of, one whose lower bound is not the gencode's version, and a target
    # naming another runtime than the one it installs.
    (
        "refuses_runtime_outside_range",
        "komira//third_party/python:protobuf",
        "7.36.2",
        "upper",
        "protobuf>=5.29.1,<7",
        "AssertionError: protobuf 7.36.2 is not in protobuf>=5.29.1,<7",
    ),
    (
        "refuses_lower_bound_not_gencode",
        "komira//third_party/python:protobuf",
        "7.36.2",
        "upper",
        "protobuf>=5.28.0,<8",
        "AssertionError: protobuf>=5.28.0,<8 starts at 5.28.0, not at 5.29.1, the version of the gencode",
    ),
    (
        "refuses_other_runtime",
        ":protobuf-5.29.1",
        "7.36.2",
        "upper",
        PROTOBUF_REQUIREMENT,
        "AssertionError: the runtime is protobuf 5.29.1, the target names 7.36.2",
    ),
]

[py_test(
    name = name,
    src = "test_plan_pb2.py",
    srcs = [
        "komira//python:plan_pb2[plan_pb2]",
        "komira//python:plan_pb2[plan_vocabulary_pb2]",
    ],
    deps = [protobuf],
    args = [
        "--golden",
        "$(location komira//src/plan_wire:golden_fixtures)",
        "--requirement",
        requirement,
        "--runtime",
        version,
        "--edge",
        edge,
    ],
    expect_error = expect_error,
) for name, protobuf, version, edge, requirement, expect_error in _CASES]

# The private plan node tree both DataFrame skins build (komira._ops), with no
# library: each verb's tree equals a hand-written one, and each refusal raises
# its class with its full message.
#
# - ops_expr_test: the expression nodes, their vocabularies and refusals, and
#   the and/or chains, is_in and between they are built from.
# - ops_walk_test: the walkers over expressions (children, column references,
#   substitution, the leftmost column).
# - ops_rel_test: the support types and the single-input relational nodes, and
#   the columns each one outputs.
# - ops_rel_join_test: the join, union and write nodes, the join output names,
#   and the columns of whole plans.
# - ops_verbs_test: the verbs the skins call, one per verb, including the
#   cases that add no node.
# - ops_no_sql_test: no node, verb or module of komira._ops renders SQL text,
#   with cases that show each check fails when one does.
[py_test(
    name = "ops_{}_test".format(area),
    src = "test_ops_{}.py".format(area),
    deps = ["//python:komira"],
) for area in [
    "expr",
    "walk",
    "rel",
    "rel_join",
    "verbs",
    "no_sql",
]]

# The clean-environment install test of the wheel (python/BUCK,
# wheel_install_test): the driver that installs the wheels into an empty
# prefix and runs the test there, the test the installed interpreter runs, and
# the serialized plan it renders (the scan plan of
# src/so/tests/gate/gate_plan_render.mojo, as hex).
[export_file(
    name = f,
    visibility = ["komira//python:"],
) for f in [
    "wheel_install_run.py",
    "test_installed.py",
    "fixtures/scan_plan.hex",
]]
