# Session.register_csv and register_json on the real library, over the
# fixtures: the names, types and rows the engine infers, NULL where a file has
# no value, the same schema and rows as read_csv and read_json; the delimiter,
# all_varchar and header arguments; a pathlib.Path, a relative path and `~`
# resolved when the call is made; a missing and an empty file refused with the
# engine's message naming the absolute path; a taken name refused word for
# word; the argument checks and a closed session.
[python_binding_test(
    name = "register_text_test" + p["suffix"],
    src = "test_register_text.py",
