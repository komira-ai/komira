    },
    deps = [
        "//python:komira_with_plan_modules",
        _PROTOBUF[p["suffix"]]["7.36.2"],
        _PYARROW[p["suffix"]],
    ],
    **_ON[p["suffix"]]
) for p in PYTHONS for f in _FAMILY_FILES["run"]]

