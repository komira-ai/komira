# Buck2 project configuration. Every action runs on this machine unless
# `.buckconfig.local` (gitignored) names a remote-execution service and its
# worker property sets; see `.buckconfig.local.example`.

[cells]
  komira = .
  prelude = prelude
  # The prelude's toolchains cell belongs to the root repository. Standalone,
  # that is komira; it holds the Mojo toolchain the rules default to
  # (toolchains//:mojo).
  toolchains = tools/build/cells/toolchains
  # The tests of this repository, a cell of their own so that `komira//...`
  # holds no target that fails by design. Not needed by a consuming repository.
  tests = tools/build/tests
  # `none` has no directory: it is the target of the prelude's unused aliases below.
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled

[buildfile]
  name = BUCK
  # Globals of every BUCK file of this cell: the prelude rules the BUCK files
  # call, each declaring its package's files for the Markdown link check
  # (tools/build/lint/includes.bzl). The tests cell's .buckconfig names it too.
  includes = komira//tools/build/lint/includes.bzl

[parser]
  target_platform_detector_spec = target:komira//...->komira//tools/build/platforms:host target:toolchains//...->komira//tools/build/platforms:host target:tests//...->komira//tools/build/platforms:host

[build]
  # Local unless .buckconfig.local names a remote-execution service; see
  # tools/build/platforms/default/BUCK.
  execution_platforms = komira//tools/build/platforms/default:default

[buck2_re_client]
  # Upper bound, in bytes, on the blobs buck2 packs into one BatchReadBlobs
  # or BatchUpdateBlobs request; a blob at least this large goes through
  # ByteStream instead. Buck2 uses the smaller of this and the limit the
  # server advertises, and 4000000 when the server advertises none, which
  # is larger than the gRPC message limit many servers are configured with.
  # 1 MiB keeps each request well under a 2 MiB server limit. It changes no
  # action digest. Endpoints stay in `.buckconfig.local`.
  max_total_batch_size = 1048576

[buck2]
  materializations = deferred
  sqlite_materializer_state = true
  defer_write_actions = true

[project]
  # .zig-cache: written by local C/C++ compiles, which run in the checkout root.
  ignore = buck-out, .git, .zig-cache

[http]
  # Downloads of pinned files (busybox, compiler tarballs). Every pin states
  # its sha256 and size, so buck2 sends no HEAD request and fetches a pin
  # only when the remote CAS lacks it or it is written to local disk; these
  # timeouts bound that GET. The default is 5 s, and a slow mirror (busybox
  # serves its 1.1 MiB binary in 10-15 s) failed builds that had to download
  # it. Allow a slow server; a dead one still fails.
  connect_timeout_ms = 30000
  read_timeout_ms = 120000
