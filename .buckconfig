# Buck2 project configuration. Every action runs on this machine unless
# `.buckconfig.local` (gitignored) names a remote-execution service and its
# worker property sets; see `.buckconfig.local.example`.

[cells]
  komira = .
  prelude = prelude
  # The prelude's toolchains cell belongs to the root repository. Standalone,
  # that is komira; it holds the Mojo toolchain the rules default to
  # (toolchains//:mojo).
  toolchains = tools/build/cells/toolchains
  # The tests of this repository, a cell of their own so that `komira//...`
  # holds no target that fails by design. Not needed by a consuming repository.
  tests = tools/build/tests
  # `none` has no directory: it is the target of the prelude's unused aliases below.
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled

[buildfile]
  name = BUCK
  # Globals of every BUCK file of this cell: the prelude rules the BUCK files
  # call, each declaring its package's files for the Markdown link check
  # (tools/build/lint/includes.bzl). The tests cell's .buckconfig names it too.
  includes = komira//tools/build/lint/includes.bzl

[parser]
  target_platform_detector_spec = target:komira//...->komira//tools/build/platforms:host target:toolchains//...->komira//tools/build/platforms:host target:tests//...->komira//tools/build/platforms:host

[build]
  # Local unless .buckconfig.local names a remote-execution service; see
  # tools/build/platforms/default/BUCK.
  execution_platforms = komira//tools/build/platforms/default:default

[buck2_re_client]
  # Upper bound, in bytes, on the blobs buck2 packs into one BatchReadBlobs
  # or BatchUpdateBlobs request; a blob at least this large goes through
  # ByteStream instead. Buck2 uses the smaller of this and the limit the
  # server advertises, and 4000000 when the server advertises none, which
  # is larger than the gRPC message limit many servers are configured with.
  # 1 MiB keeps each request well under a 2 MiB server limit. It changes no
  # action digest. Endpoints stay in `.buckconfig.local`.
  max_total_batch_size = 1048576

[buck2]
  materializations = deferred
  sqlite_materializer_state = true
  defer_write_actions = true

[project]
  # .zig-cache: written by local C/C++ compiles, which run in the checkout root.
  ignore = buck-out, .git, .zig-cache

[komira]
  # The timeout, in seconds, buck2's test runner gives each test `buck2 test`
  # runs (a mojo_test, a rust_test): it is the runner's `--timeout`, 600 by
  # default, set only on the command line (`buck2 test <targets> -- --timeout
  # <s>`), and buck2 sends it to the executor as the action's timeout. (buck2's
  # `[test] timeout_default_s` does not reach these tests: it is the timeout of
  # the other kind of test provider, which komira's rules do not give.) A test
  # an executor stops there is reported as a bare `Fail` (`Timeout 0`, a
  # mojo_test's output lost), so a mojo_test reads this key and stops itself
  # 60 s earlier, saying so (`TEST TIME LIMIT: ...`;
  # tools/build/mojo/test_limit.bzl). Keep it equal to the runner's timeout:
  # with `-- --timeout <s>`, pass `-c komira.test_timeout_s=<s>` too. 600 is
  # buck2's default, set here so the limit is written down. A library's
  # `test_srcs` are build actions, which carry no timeout: the executor's
  # default applies to them (tools/build/mojo/README.md, "Time limits").
  test_timeout_s = 600

[http]
  # Downloads of pinned files (busybox, zig, compiler and runtime packages).
  # Every pin states its sha256 and size, so buck2 sends no HEAD request and
  # fetches a pin only when the remote CAS lacks it or it is written to local
  # disk. buck2's defaults are 5 s to connect and 10 s per read, and a slow
  # upstream (busybox's host, answering a hosted runner) exceeded the 5 s
  # connect default on every retry.
  # Neither value caps a whole download: connect_timeout_ms bounds opening the
  # connection, and read_timeout_ms bounds one wait for the next bytes,
  # restarting whenever bytes arrive. So a cold CAS miss on a pin of any size
  # (the largest are around 100 MiB) succeeds at any rate that never stalls for
  # 120 s, and a dead host still fails, after buck2's four fixed attempts.
  # There is no write timeout: a download sends only its request line and
  # headers.
  connect_timeout_ms = 30000
  read_timeout_ms = 120000
