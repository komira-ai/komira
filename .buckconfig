# Buck2 project configuration. Remote-execution endpoints and the worker
# property set are machine-specific and live in `.buckconfig.local`
# (gitignored); see `.buckconfig.local.example`.

[cells]
  komira = .
  prelude = prelude
  mojo = mojo
  toolchains = toolchains
  checks = checks
  # `none` has no directory: it is the target of the prelude's unused aliases below.
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled

[buildfile]
  name = BUCK

[parser]
  target_platform_detector_spec = target:komira//...->komira//platforms:linux-x86_64 target:mojo//...->komira//platforms:linux-x86_64 target:toolchains//...->komira//platforms:linux-x86_64 target:checks//...->komira//platforms:linux-x86_64

[build]
  execution_platforms = komira//platforms/remote:remote

[buck2_re_client]
  # Upper bound, in bytes, on the blobs buck2 packs into one BatchReadBlobs
  # or BatchUpdateBlobs request; a blob at least this large goes through
  # ByteStream instead. Buck2 uses the smaller of this and the limit the
  # server advertises, and 4000000 when the server advertises none, which
  # is larger than the gRPC message limit many servers are configured with.
  # 1 MiB keeps each request well under a 2 MiB server limit. It changes no
  # action digest. Endpoints stay in `.buckconfig.local`.
  max_total_batch_size = 1048576

[buck2]
  materializations = deferred
  sqlite_materializer_state = true
  defer_write_actions = true

[project]
  ignore = buck-out, .git
