load("@mojo//:download.bzl", "pinned_file")
load("@mojo//:toolchain.bzl", "conda_closure", "mojo_runtime", "mojo_toolchain", "zig_dist", "zig_exe")

# ---- Pinned inputs (linux x86_64 execution platform) -----------------------

# Static busybox: `sh` and the file utilities every action uses.
pinned_file(
    name = "busybox",
    url = "https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox",
    sha256 = "6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348",
    executable = True,
    visibility = ["PUBLIC"],
)

# zig: the C link driver for `mojo build`, and the compiler for conda_unpack.
pinned_file(
    name = "zig_linux_x86_64.tar.xz",
    url = "https://ziglang.org/download/0.12.0/zig-linux-x86_64-0.12.0.tar.xz",
    sha256 = "c7ae866b8a76a568e2d5cfd31fe89cdb629bdd161fdd5018b29a4a0a17045cad",
)

# The Mojo compiler package.
pinned_file(
    name = "mojo_compiler_1.0.0_linux-64.conda",
    url = "https://conda.modular.com/max-nightly/linux-64/mojo-compiler-1.0.0-release.conda",
    sha256 = "4394c6146d47ec7794a9a3ed5775ae158f59f83f8e1aed59408b17c4909821b3",
)

# The C++ runtime the compiler links against (NEEDED libstdc++.so.6 and
# libgcc_s.so.1; newest symbol versions GLIBCXX_3.4.30, CXXABI_1.3.13,
# GCC_3.3, i.e. GCC 12 or newer). conda-forge, one matched pair: this
# libstdcxx build depends on exactly this libgcc build.
pinned_file(
    name = "libstdcxx_15.3.0_linux-64.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/libstdcxx-15.3.0-h934c35e_7.conda",
    sha256 = "0c3dc08bf43357a77297b4449abd0ce1d40a140989f004071e69c04ed13e36bb",
)

pinned_file(
    name = "libgcc_15.3.0_linux-64.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/libgcc-15.3.0-h3363355_7.conda",
    sha256 = "0bb57ee8557aad33317eeb881e3957b6fab776dd75473311c25789fa3a29f792",
)

# ---- Unpacked by remote actions ---------------------------------------------

# Unpacking and copying run on `light` workers. The Mojo toolchains below
# state `mojo_compile` + a NUMA constraint; a toolchain's
# `exec_compatible_with` binds every target that uses it, so each Mojo target
# builds on an execution platform providing both.

zig_dist(
    name = "zig",
    exec_compatible_with = ["komira//platforms:light"],
    archive = ":zig_linux_x86_64.tar.xz",
    busybox = ":busybox",
    strip_prefix = "zig-linux-x86_64-0.12.0",
    visibility = ["PUBLIC"],
)

zig_exe(
    name = "conda_unpack",
    exec_compatible_with = ["komira//platforms:light"],
    src = "mojo//:conda_unpack.zig",
    busybox = ":busybox",
    zig = ":zig",
)

conda_closure(
    name = "mojo_compiler",
    exec_compatible_with = ["komira//platforms:light"],
    libs = {
        "lib/libgcc_s.so.1": ":libgcc_15.3.0_linux-64.conda",
        "lib/libstdc++.so.6": ":libstdcxx_15.3.0_linux-64.conda",
    },
    package = ":mojo_compiler_1.0.0_linux-64.conda",
    unpacker = ":conda_unpack",
    visibility = ["PUBLIC"],
)

# What a built binary loads, read from the loader's own record of a run
# (checks//runtime_libs:loader_trace, `run init <toolchain>/lib/...` lines).
# checks/run_checks.sh fails if this list and that record disagree.
mojo_runtime(
    name = "mojo_runtime",
    exec_compatible_with = ["komira//platforms:light"],
    busybox = ":busybox",
    compiler = ":mojo_compiler",
    libs = [
        "libAsyncRTRuntimeGlobals.so",
        "libKGENCompilerRTShared.so",
        "libMSupportGlobals.so",
        "libgcc_s.so.1",
        "libstdc++.so.6",
    ],
    visibility = ["PUBLIC"],
)

_MOJO_TOOLCHAIN = dict(
    busybox = ":busybox",
    cc_target = "x86_64-linux-gnu.2.34",
    compiler = ":mojo_compiler",
    runtime = ":mojo_runtime",
    # Every compile targets this CPU, whatever worker runs it. x86-64-v3
    # (AVX2, BMI2, FMA): built binaries and gated tests need a worker, and a
    # deployment host, that implements it.
    target_cpu = "x86-64-v3",
    zig = ":zig",
    visibility = ["PUBLIC"],
)

# The toolchain of mojo_library, mojo_binary and mojo_test: compiles, gated
# tests and run checks on one NUMA node.
mojo_toolchain(
    name = "mojo",
    exec_compatible_with = [
        "komira//platforms:mojo_compile",
        "komira//platforms:numa_single",
    ],
    **_MOJO_TOOLCHAIN
)

# The toolchain of mojo_multi_numa_test: runs a built binary on a worker
# spanning more than one NUMA node. Only an execution platform realizing
# `komira//platforms:exec-mojo-multi-numa` satisfies it; with none
# registered, its users fail to configure.
mojo_toolchain(
    name = "mojo_multi_numa",
    exec_compatible_with = [
        "komira//platforms:mojo_compile",
        "komira//platforms:numa_multi",
    ],
    **_MOJO_TOOLCHAIN
)
