load("@komira//package:defs.bzl", "oci_base")
load("@mojo//:download.bzl", "pinned_file")
load("@mojo//:toolchain.bzl", "conda_closure", "mojo_runtime", "mojo_toolchain", "zig_dist", "zig_exe")

# ---- Pinned inputs (linux x86_64 execution platform) -----------------------

# Static busybox: `sh` and the file utilities every action uses.
pinned_file(
    name = "busybox",
    url = "https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox",
    sha256 = "6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348",
    executable = True,
    visibility = ["PUBLIC"],
)

# zig: the C link driver for `mojo build`, and the compiler for conda_unpack.
pinned_file(
    name = "zig_linux_x86_64.tar.xz",
    url = "https://ziglang.org/download/0.12.0/zig-linux-x86_64-0.12.0.tar.xz",
    sha256 = "c7ae866b8a76a568e2d5cfd31fe89cdb629bdd161fdd5018b29a4a0a17045cad",
)

# The Mojo compiler package.
pinned_file(
    name = "mojo_compiler_1.0.0_linux-64.conda",
    url = "https://conda.modular.com/max-nightly/linux-64/mojo-compiler-1.0.0-release.conda",
    sha256 = "4394c6146d47ec7794a9a3ed5775ae158f59f83f8e1aed59408b17c4909821b3",
)

# The C++ runtime the compiler links against (NEEDED libstdc++.so.6 and
# libgcc_s.so.1; newest symbol versions GLIBCXX_3.4.30, CXXABI_1.3.13,
# GCC_3.3, i.e. GCC 12 or newer). conda-forge, one matched pair: this
# libstdcxx build depends on exactly this libgcc build.
pinned_file(
    name = "libstdcxx_15.3.0_linux-64.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/libstdcxx-15.3.0-h934c35e_7.conda",
    sha256 = "0c3dc08bf43357a77297b4449abd0ce1d40a140989f004071e69c04ed13e36bb",
)

pinned_file(
    name = "libgcc_15.3.0_linux-64.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/libgcc-15.3.0-h3363355_7.conda",
    sha256 = "0bb57ee8557aad33317eeb881e3957b6fab776dd75473311c25789fa3a29f792",
)

# The base of oci_image: distroless base-debian12 (glibc, CA certificates,
# tzdata, a nonroot user, no shell), tag `nonroot`, its linux/amd64 image
# manifest. The manifest is checked in (a registry serves one only to a
# client sending an Accept header); every blob is one pinned download. The
# digests are the pin.
oci_base(
    name = "distroless_base",
