load("@mojo//:defs.bzl", "mojo_binary", "mojo_multi_numa_test")

# Requires an execution platform providing komira//platforms:numa_multi. A
# standalone checkout registers none unless `[komira_re]
# mojo_compile_multi_numa_properties` is set, so building this must fail to
# configure (checks/run_checks.sh, check 10); it must never run on a
# single-NUMA worker.
mojo_binary(
    name = "hello",
    srcs = ["hello.mojo"],
)

mojo_multi_numa_test(
    name = "hello_multi_numa",
    binary = ":hello",
    expected_stdout = "hello from mojo\n",
)
