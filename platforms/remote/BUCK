load("//platforms:defs.bzl", "re_properties", "remote_execution_platforms")

# The remote execution platform for a standalone checkout: every action runs
# remotely, on workers with the property set named in `.buckconfig.local`.
# It lives apart from `//platforms`, which holds only abstract constraints, so
# that a repository mounting komira as a cell can load the target platform
# without configuring this one (see "Mounting komira in another repository"
# in README.md).

remote_execution_platforms(
    name = "remote",
    names = ["linux-x86_64"],
    constraints = ["//platforms:linux-x86_64"],
    properties = [re_properties("linux_x86_64_properties")],
    visibility = ["PUBLIC"],
)
