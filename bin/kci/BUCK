load("@komira//tools/build/mojo:defs.bzl", "mojo_binary")

# kci: ONE binary with ONE command. `kci run --stage S` runs a stage of the
# machine file (under GitHub Actions it first holds the workflow it runs under
# to that file). A thin shell: argv goes to kci_cli.kci_main. All logic and every test live in the libraries.
mojo_binary(
    name = "kci",
    srcs = ["main.mojo"],
    deps = ["//src/kci_cli:kci_cli"],
    visibility = ["PUBLIC"],
)

# Read by kci_cli's test that no kci source but kci_api spells an exit
# number.
export_file(name = "main.mojo", visibility = ["//src/kci_cli:"])
